//! IR Diff CLI entry point
//!
//! Usage:
//!   ir-diff <file_a.ll> <file_b.ll> [--summary] [--function <name>]
//!
//! Reads two LLVM IR files, parses them, diffs function-by-function, and
//! prints results to stdout.
//!
//! Exit codes:
//!   0 = files are semantically identical
//!   1 = files differ
//!   2 = usage error or file read failure
//!
//! NOTE: Uses @extern("c") for I/O and args to avoid pulling in std modules
//! that transitively include NeverError (a struct with a Never field which
//! generates `{ void }` — invalid LLVM IR, a known codegen bug).

use ir_diff::parser::parse
use ir_diff::differ::{diff, is_identical,
    only_in_a_count, only_in_a_name,
    only_in_b_count, only_in_b_name,
    diffs_count, diff_func_name, diff_a_line, diff_b_line}
use core::str::search::starts_with

// --- C FFI declarations ---

@extern("strlen")
func c_strlen(s: Str) -> I64

@extern("puts")
func c_puts(s: Str) -> I32

@extern("printf")
func c_printf(fmt: Str) -> I32

// C runtime: argc/argv access (defined in compiler/runtime/os/os.c)
@extern("c")
func tml_os_args_count() -> I32

@extern("c")
func tml_os_args_get(index: I32) -> Str

// C stdio: file reading
@extern("c")
func fopen(path: Str, mode: Str) -> I64

@extern("c")
func fclose(fp: I64) -> I32

@extern("c")
func fseek(fp: I64, offset: I64, whence: I32) -> I32

@extern("c")
func ftell(fp: I64) -> I64

@extern("c")
func fread(buf: I64, size: I64, count: I64, fp: I64) -> I64

@extern("c")
func malloc(size: I64) -> I64

@extern("c")
func memset(dest: I64, val: I32, count: I64) -> I64

/// Read an entire file into a Str. Returns "" on failure.
/// Uses raw I64 handles to avoid RawPtr codegen bug.
func read_file(path: Str) -> Str {
    let fp: I64 = fopen(path, "rb")
    if fp == 0 {
        return ""
    }
    fseek(fp, 0, 2)  // SEEK_END = 2
    let size: I64 = ftell(fp)
    fseek(fp, 0, 0)  // SEEK_SET = 0
    if size <= 0 {
        fclose(fp)
        return ""
    }
    let buf: I64 = malloc(size + 1)
    if buf == 0 {
        fclose(fp)
        return ""
    }
    let read_count: I64 = fread(buf, 1, size, fp)
    fclose(fp)
    // Null-terminate: write 0 byte at buf + read_count
    memset(buf + read_count, 0, 1)
    // buf is an I64 holding a pointer; Str is also i64 (ptr) at LLVM level.
    // Cast via I64-to-Str identity (both are i64 in the calling convention).
    return buf as Str
}

/// Print a string to stdout (no newline).
func print_str(s: Str) {
    c_printf(s)
}

/// Print a string followed by newline.
func println(s: Str) {
    c_puts(s)
}

func print_usage() {
    println("Usage: ir-diff <file_a.ll> <file_b.ll> [--summary] [--function <name>]")
    println("")
    println("Compare two LLVM IR files and report semantic differences.")
    println("")
    println("Options:")
    println("  --summary        Print only summary (number of differences)")
    println("  --function <n>   Compare only the named function")
    println("")
    println("Exit codes:")
    println("  0  Files are semantically identical")
    println("  1  Files differ")
    println("  2  Usage error or file read failure")
}

pub func main() -> I32 {
    let argc: I32 = tml_os_args_count()

    // Parse arguments. The first arg is the program name, the rest are
    // user-provided. We need at least 2 positional args (file paths).
    var file_a: Str = ""
    var file_b: Str = ""
    var summary_only: Bool = false
    var filter_func: Str = ""
    var positional_count: I32 = 0
    var expect_func_name: Bool = false
    var show_help: Bool = false

    var i: I32 = 1
    loop (i < argc) {
        let arg: Str = tml_os_args_get(i)
        if expect_func_name {
            filter_func = arg
            expect_func_name = false
            i = i + 1
            continue
        }
        if starts_with(arg, "--") {
            if c_strlen(arg) == 6 and starts_with(arg, "--help") {
                show_help = true
            }
            if starts_with(arg, "--summary") {
                summary_only = true
            }
            if starts_with(arg, "--function") {
                expect_func_name = true
            }
        } else {
            if positional_count == 0 {
                file_a = arg
            }
            if positional_count == 1 {
                file_b = arg
            }
            positional_count = positional_count + 1
        }
        i = i + 1
    }

    if show_help {
        print_usage()
        return 0
    }

    if positional_count < 2 {
        print_usage()
        return 2
    }

    // Read files
    let content_a: Str = read_file(file_a)
    let content_b: Str = read_file(file_b)

    if c_strlen(content_a) == 0 {
        print_str("error: could not read file: ")
        println(file_a)
        return 2
    }
    if c_strlen(content_b) == 0 {
        print_str("error: could not read file: ")
        println(file_b)
        return 2
    }

    // Parse
    let res_a = parse(content_a)
    if res_a.is_err() {
        print_str("error: failed to parse ")
        println(file_a)
        return 2
    }
    let mod_a = res_a.unwrap()

    let res_b = parse(content_b)
    if res_b.is_err() {
        print_str("error: failed to parse ")
        println(file_b)
        return 2
    }
    let mod_b = res_b.unwrap()

    // NOTE: Normalization is skipped due to a codegen bug in the TML compiler
    // (HashMap in tools/ packages causes "Unknown method: len" at link time,
    // and Maybe[Str] field access causes ACCESS_VIOLATION).
    // When the bug is fixed, add: let norm_a = normalize(mod_a) etc.

    // Diff
    let diff_result = diff(mod_a, mod_b)
    if diff_result.is_err() {
        println("error: diff failed")
        return 2
    }
    let d = diff_result.unwrap()

    if is_identical(d) {
        if not summary_only {
            println("IR files are semantically identical.")
        }
        return 0
    }

    // Print results using cross-module accessor functions
    // (direct field access on DiffResult returns () cross-module)
    let a_only: I64 = only_in_a_count(d)
    let b_only: I64 = only_in_b_count(d)
    let ndiffs: I64 = diffs_count(d)

    if summary_only {
        var j: I64 = 0
        if a_only > 0 {
            println("Functions only in A:")
            loop (j < a_only) {
                print_str("  ")
                println(only_in_a_name(d, j))
                j = j + 1
            }
        }
        j = 0
        if b_only > 0 {
            println("Functions only in B:")
            loop (j < b_only) {
                print_str("  ")
                println(only_in_b_name(d, j))
                j = j + 1
            }
        }
        j = 0
        if ndiffs > 0 {
            println("Functions with differences:")
            loop (j < ndiffs) {
                print_str("  ")
                println(diff_func_name(d, j))
                j = j + 1
            }
        }
    } else {
        // Detailed mode: unified diff style
        var j: I64 = 0

        // Functions only in A
        loop (j < a_only) {
            print_str("--- a: ")
            println(only_in_a_name(d, j))
            println("  (function exists only in first file)")
            j = j + 1
        }

        // Functions only in B
        j = 0
        loop (j < b_only) {
            print_str("+++ b: ")
            println(only_in_b_name(d, j))
            println("  (function exists only in second file)")
            j = j + 1
        }

        // Function diffs
        j = 0
        loop (j < ndiffs) {
            print_str("@@@ ")
            print_str(diff_func_name(d, j))
            println(" @@@")
            print_str("- ")
            println(diff_a_line(d, j))
            print_str("+ ")
            println(diff_b_line(d, j))
            j = j + 1
        }
    }

    return 1
}
