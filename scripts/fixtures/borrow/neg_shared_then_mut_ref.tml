// NEGATIVE: a live shared interior ref (`get_ref`) plus a `mut ref` (`get_mut`)
// of the same container → conflict (cannot take a mut ref while a shared ref is
// outstanding).
use std::collections::list::List
func use_i(x: I64) -> I64 { return x }
func main() -> I32 {
    var arr: List[I64] = List::new(4)
    arr.push(1 as I64)
    arr.push(2 as I64)
    let r1: ref I64 = arr.get_ref(0)
    let r2: mut ref I64 = arr.get_mut(1)
    let z: I64 = use_i(*r1) + use_i(*r2)
    return z as I32
}
