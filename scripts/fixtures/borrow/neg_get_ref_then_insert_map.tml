// NEGATIVE (HashMap): a shared interior ref held across a map mutation.
// `m.get_ref(k)` borrows the map (via Maybe[ref V]); `m.set(...)` (now mut this)
// needs a unique borrow while `r` is still live → B009-class conflict.
use std::collections::hashmap::HashMap
func use_i(x: I64) -> I64 { return x }
func main() -> I32 {
    var m: HashMap[I64, I64] = HashMap::new(8)
    m.set(1 as I64, 10 as I64)
    when m.get_ref(1 as I64) {
        Just(r) => {
            m.set(2 as I64, 20 as I64)
            let z: I64 = use_i(*r)
            return z as I32
        },
        Nothing => { return 0 }
    }
}
