// String SIMD Benchmark — Tests transparent SIMD dispatch in public API
//
// The public contains(), find() functions in core::str::search now
// auto-dispatch to SSE2 SIMD for strings >= 32 bytes.
// This benchmark measures the public API directly (no simd:: prefix needed).
//
// Also compares simd::contains_fast vs simd::contains_scalar directly
// and the new simd_load_ptr-based SIMD vs the scalar fallback.

use core::str::search::{contains, find}
use core::str::simd

@extern("c") func time_ns() -> I64

// ============================================================================
// String builders
// ============================================================================

func make_string(n: I64) -> Str {
    var s: Str = ""
    var i: I64 = 0
    loop (i < n / 16) {
        s = s + "abcdefghijklmnop"
        i = i + 1
    }
    return s
}

func make_repeated(n: I64) -> Str {
    var s: Str = ""
    var i: I64 = 0
    loop (i < n / 16) {
        s = s + "aaaaaaaaaaaaaaaa"
        i = i + 1
    }
    return s
}

// ============================================================================
// Benchmark helpers
// ============================================================================

func bench_contains_public(s: Str, pat: Str, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        if contains(s, pat) { acc = acc + 1 }
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

func bench_find_public(s: Str, pat: Str, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        let r: Maybe[I64] = find(s, pat)
        if r.is_just() { acc = acc + 1 }
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

func bench_contains_simd(s: Str, pat: Str, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        if simd::contains_fast(s, pat) { acc = acc + 1 }
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

func bench_contains_scalar(s: Str, pat: Str, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        if simd::contains_scalar(s, pat) { acc = acc + 1 }
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

func bench_find_byte_simd(s: Str, byte: U8, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        acc = acc + simd::find_byte(s, byte)
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

func bench_find_byte_scalar(s: Str, byte: U8, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        acc = acc + simd::find_byte_scalar(s, byte)
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

func bench_is_ascii_simd(s: Str, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        if simd::is_ascii_fast(s) { acc = acc + 1 }
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

func bench_is_ascii_scalar(s: Str, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        if simd::is_ascii_scalar(s) { acc = acc + 1 }
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

func bench_count_byte_simd(s: Str, byte: U8, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        acc = acc + simd::count_byte(s, byte)
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

func bench_count_byte_scalar(s: Str, byte: U8, iters: I64) -> I64 {
    var acc: I64 = 0
    let start: I64 = time_ns()
    var i: I64 = 0
    loop (i < iters) {
        acc = acc + simd::count_byte_scalar(s, byte)
        i = i + 1
    }
    let elapsed: I64 = time_ns() - start
    if acc == -9999999 { println("x") }
    return elapsed
}

// ============================================================================
// Report
// ============================================================================

func report(name: Str, simd_ns: I64, scalar_ns: I64, iters: I64) {
    let simd_per: I64 = simd_ns / iters
    let scalar_per: I64 = scalar_ns / iters
    println("  " + name)
    println("    SIMD:   " + simd_per.to_string() + " ns/op")
    println("    Scalar: " + scalar_per.to_string() + " ns/op")
    if simd_per > 0 {
        let speedup: I64 = scalar_per / simd_per
        let remainder: I64 = ((scalar_per * 10) / simd_per) % 10
        println("    Speedup: " + speedup.to_string() + "." + remainder.to_string() + "x")
    } else {
        println("    Speedup: (SIMD too fast to measure)")
    }
    println("")
}

func report_single(name: Str, ns: I64, iters: I64, size: I64) {
    let per: I64 = ns / iters
    println("  " + name + ": " + per.to_string() + " ns/op")
    if per > 0 {
        let throughput: I64 = (size * 1000) / per
        println("    Throughput: " + throughput.to_string() + " MB/s")
    }
}

// ============================================================================
// Main
// ============================================================================

pub func main() -> I32 {
    println("")
    println("=== TML String SIMD Benchmark (simd_load_ptr, transparent dispatch) ===")
    println("")

    let s256: Str = make_string(256)
    let s1k: Str = make_string(1024)
    let s4k: Str = make_string(4096)
    let s16k: Str = make_string(16384)

    let iters: I64 = 100000
    let iters_short: I64 = 50000

    // ── Section 1: Public API (transparent SIMD dispatch) ──
    println("--- Public API: contains() (transparent SIMD for >= 32 bytes) ---")
    println("")

    report_single("contains 256B (not found)", bench_contains_public(s256, "ZZZZZ", iters), iters, 256)
    report_single("contains  1KB (not found)", bench_contains_public(s1k, "ZZZZZ", iters), iters, 1024)
    report_single("contains  4KB (not found)", bench_contains_public(s4k, "ZZZZZ", iters_short), iters_short, 4096)
    println("")

    println("--- Public API: find() (transparent SIMD for >= 32 bytes) ---")
    println("")

    report_single("find 256B (not found)", bench_find_public(s256, "ZZZZZ", iters), iters, 256)
    report_single("find  1KB (not found)", bench_find_public(s1k, "ZZZZZ", iters), iters, 1024)
    report_single("find  4KB (not found)", bench_find_public(s4k, "ZZZZZ", iters_short), iters_short, 4096)
    println("")

    // ── Section 2: SIMD vs Scalar direct comparison ──
    println("--- Direct: SIMD (simd_load_ptr) vs Scalar ---")
    println("")

    println("  find_byte (byte not found, worst case scan):")
    println("")
    report("  256 bytes",
        bench_find_byte_simd(s256, 90 as U8, iters),
        bench_find_byte_scalar(s256, 90 as U8, iters), iters)
    report("  1 KB",
        bench_find_byte_simd(s1k, 90 as U8, iters),
        bench_find_byte_scalar(s1k, 90 as U8, iters), iters)
    report("  4 KB",
        bench_find_byte_simd(s4k, 90 as U8, iters_short),
        bench_find_byte_scalar(s4k, 90 as U8, iters_short), iters_short)

    println("  contains (pattern not found, worst case):")
    println("")
    report("  256 bytes",
        bench_contains_simd(s256, "ZZZZZ", iters),
        bench_contains_scalar(s256, "ZZZZZ", iters), iters)
    report("  1 KB",
        bench_contains_simd(s1k, "ZZZZZ", iters),
        bench_contains_scalar(s1k, "ZZZZZ", iters), iters)
    report("  4 KB",
        bench_contains_simd(s4k, "ZZZZZ", iters_short),
        bench_contains_scalar(s4k, "ZZZZZ", iters_short), iters_short)

    println("  count_byte (all matching, 1KB):")
    println("")
    let all_a_1k: Str = make_repeated(1024)
    report("  1 KB (all match)",
        bench_count_byte_simd(all_a_1k, 97 as U8, iters),
        bench_count_byte_scalar(all_a_1k, 97 as U8, iters), iters)

    println("  is_ascii (all ASCII):")
    println("")
    report("  1 KB",
        bench_is_ascii_simd(s1k, iters),
        bench_is_ascii_scalar(s1k, iters), iters)
    report("  16 KB",
        bench_is_ascii_simd(s16k, iters_short),
        bench_is_ascii_scalar(s16k, iters_short), iters_short)

    println("=== Benchmark Complete ===")
    return 0
}
