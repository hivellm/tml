// PostgreSQL Full Integration Test Suite (v2)
//
// Standalone program (NOT test harness — uses main() to avoid 100ms timeout).
// Covers: connection, DDL, INSERT, SELECT, UPDATE, DELETE, NULL, types,
//         transactions, column metadata, prepared statements, error handling,
//         and pure-TML dialect/OID utilities.
//
// Build:  tml build lib/postgresql/tests/pg_integration.tml --legacy
// Run:    ./build/debug/pg_integration.exe
//
// PostgreSQL must be running at:
//   host=localhost port=5433 dbname=projectv user=projectv password=projectv_dev

// ============================================================================
// libpq FFI declarations
// ============================================================================

@link("lib/postgresql/native/win-x64/libpq.lib")
@extern("c") func PQconnectdb(conninfo: Str) -> *Unit
@extern("c") func PQstatus(conn: *Unit) -> I32
@extern("c") func PQfinish(conn: *Unit)
@extern("c") func PQerrorMessage(conn: *Unit) -> Str
@extern("c") func PQexec(conn: *Unit, query: Str) -> *Unit
@extern("c") func PQresultStatus(result: *Unit) -> I32
@extern("c") func PQntuples(result: *Unit) -> I32
@extern("c") func PQnfields(result: *Unit) -> I32
@extern("c") func PQgetvalue(result: *Unit, row: I32, col: I32) -> Str
@extern("c") func PQgetisnull(result: *Unit, row: I32, col: I32) -> I32
@extern("c") func PQfname(result: *Unit, col: I32) -> Str
@extern("c") func PQftype(result: *Unit, col: I32) -> I32
@extern("c") func PQclear(result: *Unit)
@extern("c") func PQcmdTuples(result: *Unit) -> Str
@extern("c") func PQresultErrorMessage(result: *Unit) -> Str
@extern("c") func PQprepare(conn: *Unit, stmtName: Str, query: Str, nParams: I32, paramTypes: *Unit) -> *Unit
@extern("c") func PQexecPrepared(conn: *Unit, stmtName: Str, nParams: I32, paramValues: *Unit, paramLengths: *Unit, paramFormats: *Unit, resultFormat: I32) -> *Unit
@extern("c") func PQtransactionStatus(conn: *Unit) -> I32
// strcmp returns 0 if equal, non-zero if different
@extern("c") func strcmp(a: Str, b: Str) -> I32

// ============================================================================
// Test counters (module-level mutable state via local tracking)
// ============================================================================

// We track pass/fail counts by printing and grepping.
// Each test prints "  OK: <msg>" or "  FAIL: <msg>".

// ============================================================================
// Helper functions
// ============================================================================

/// Connection string for the test database.
func ci() -> Str {
    return "host=localhost port=5433 dbname=projectv user=projectv password=projectv_dev"
}

/// Returns a null pointer as *Unit (for paramTypes / no-op params).
func pg_null() -> *Unit {
    return 0 as *Unit
}

/// Returns true if the string is non-empty (using strcmp to avoid Str == codegen bug).
func pg_str_nonempty(s: Str) -> Bool {
    return strcmp(s, "") != 0
}

/// Asserts a boolean condition, printing OK or FAIL.
func ok(cond: Bool, msg: Str) {
    if cond {
        println("  OK: " + msg)
    } else {
        println("  FAIL: " + msg)
    }
}

/// Asserts two strings are equal, printing OK or FAIL with the mismatch.
/// Uses strcmp to avoid the Str == Str codegen bug in legacy standalone mode.
func eq(a: Str, b: Str, msg: Str) {
    if strcmp(a, b) == 0 {
        println("  OK: " + msg)
    } else {
        println("  FAIL: " + msg + " (got '" + a + "', want '" + b + "')")
    }
}

/// Asserts two I32 values are equal, printing OK or FAIL.
func eq_i32(a: I32, b: I32, msg: Str) {
    if a == b {
        println("  OK: " + msg)
    } else {
        println("  FAIL: " + msg + " (values differ)")
    }
}

/// Executes SQL and returns the result. Asserts the status is COMMAND_OK or TUPLES_OK.
func pg_exec_ok(conn: *Unit, sql: Str) -> *Unit {
    let result = PQexec(conn, sql)
    let status = PQresultStatus(result)
    if status != 1 and status != 2 {
        println("  FAIL: pg_exec_ok '" + sql + "' err=" + PQresultErrorMessage(result))
    }
    return result
}


// ============================================================================
// 1. Connection tests
// ============================================================================

func test_connection() {
    println("\n[1] Connection")

    // 1a. Successful connection
    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "connect to valid host succeeds (status==0)")
    PQfinish(conn)

    // 1b. Bad host — short connect_timeout so the test doesn't hang
    let bad = PQconnectdb("host=nonexistent.invalid port=9999 dbname=x user=x password=x connect_timeout=1")
    ok(PQstatus(bad) != 0, "connect to bad host fails (status!=0)")
    let errmsg = PQerrorMessage(bad)
    ok(pg_str_nonempty(errmsg), "error message is non-empty on bad host")
    PQfinish(bad)

    // 1c. Bad credentials
    let cred = PQconnectdb("host=localhost port=5433 dbname=projectv user=wronguser password=wrongpassword connect_timeout=2")
    ok(PQstatus(cred) != 0, "connect with bad credentials fails")
    PQfinish(cred)
}

// ============================================================================
// 2. DDL tests
// ============================================================================

func test_ddl() {
    println("\n[2] DDL")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "ddl: connect ok")

    // Drop if exists first
    let r0 = pg_exec_ok(conn, "DROP TABLE IF EXISTS tml_int_ddl")
    PQclear(r0)

    // CREATE TABLE with rich types
    let r1 = PQexec(conn, "CREATE TABLE tml_int_ddl (id SERIAL PRIMARY KEY, name TEXT NOT NULL, score INTEGER, active BOOLEAN, created_at TIMESTAMPTZ, data BYTEA)")
    eq_i32(PQresultStatus(r1), 1, "CREATE TABLE returns COMMAND_OK (1)")
    PQclear(r1)

    // Second CREATE TABLE (different name)
    let r2 = PQexec(conn, "CREATE TABLE tml_int_ddl2 (id SERIAL PRIMARY KEY, val TEXT)")
    eq_i32(PQresultStatus(r2), 1, "CREATE TABLE 2 returns COMMAND_OK (1)")
    PQclear(r2)

    // DROP TABLE
    let r3 = PQexec(conn, "DROP TABLE tml_int_ddl")
    eq_i32(PQresultStatus(r3), 1, "DROP TABLE returns COMMAND_OK (1)")
    PQclear(r3)

    let r4 = PQexec(conn, "DROP TABLE tml_int_ddl2")
    PQclear(r4)

    PQfinish(conn)
}

// ============================================================================
// 3. INSERT tests
// ============================================================================

func test_insert() {
    println("\n[3] INSERT")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "insert: connect ok")

    let r0 = pg_exec_ok(conn, "DROP TABLE IF EXISTS tml_int_insert")
    PQclear(r0)
    let rc = pg_exec_ok(conn, "CREATE TABLE tml_int_insert (id SERIAL PRIMARY KEY, name TEXT, score INTEGER)")
    PQclear(rc)

    // 3a. Single row INSERT — cmdTuples == "1"
    let r1 = PQexec(conn, "INSERT INTO tml_int_insert (name, score) VALUES ('Alice', 100)")
    eq_i32(PQresultStatus(r1), 1, "single INSERT returns COMMAND_OK")
    eq(PQcmdTuples(r1), "1", "single INSERT cmdTuples == '1'")
    PQclear(r1)

    // 3b. Multi-row INSERT — cmdTuples == "3"
    let r2 = PQexec(conn, "INSERT INTO tml_int_insert (name, score) VALUES ('Bob', 80), ('Carol', 90), ('Dave', 70)")
    eq(PQcmdTuples(r2), "3", "multi INSERT cmdTuples == '3'")
    PQclear(r2)

    // 3c. INSERT RETURNING — status == TUPLES_OK (2), returns generated id
    let r3 = PQexec(conn, "INSERT INTO tml_int_insert (name, score) VALUES ('Eve', 95) RETURNING id")
    eq_i32(PQresultStatus(r3), 2, "INSERT RETURNING status == TUPLES_OK (2)")
    ok(PQntuples(r3) == 1, "INSERT RETURNING returns 1 row")
    let returned_id = PQgetvalue(r3, 0, 0)
    ok(pg_str_nonempty(returned_id), "INSERT RETURNING gives non-empty id")
    PQclear(r3)

    let rd = pg_exec_ok(conn, "DROP TABLE tml_int_insert")
    PQclear(rd)
    PQfinish(conn)
}

// ============================================================================
// 4. SELECT tests
// ============================================================================

func test_select() {
    println("\n[4] SELECT")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "select: connect ok")

    let r0 = pg_exec_ok(conn, "DROP TABLE IF EXISTS tml_int_select")
    PQclear(r0)
    let rc = pg_exec_ok(conn, "CREATE TABLE tml_int_select (id INTEGER PRIMARY KEY, name TEXT, score INTEGER)")
    PQclear(rc)
    let ri = pg_exec_ok(conn, "INSERT INTO tml_int_select VALUES (1, 'Alice', 100), (2, 'Bob', 80), (3, 'Carol', 90)")
    PQclear(ri)

    // 4a. Basic SELECT
    let r1 = PQexec(conn, "SELECT id, name, score FROM tml_int_select ORDER BY id")
    eq_i32(PQresultStatus(r1), 2, "SELECT status == TUPLES_OK (2)")

    // 4b. Row count
    ok(PQntuples(r1) == 3, "SELECT returns 3 rows")

    // 4c. Column count
    ok(PQnfields(r1) == 3, "SELECT returns 3 columns")

    // 4d. Column names
    eq(PQfname(r1, 0), "id", "col 0 name == 'id'")
    eq(PQfname(r1, 1), "name", "col 1 name == 'name'")
    eq(PQfname(r1, 2), "score", "col 2 name == 'score'")

    // 4e. Values for each row
    eq(PQgetvalue(r1, 0, 0), "1", "row 0 id == '1'")
    eq(PQgetvalue(r1, 0, 1), "Alice", "row 0 name == 'Alice'")
    eq(PQgetvalue(r1, 0, 2), "100", "row 0 score == '100'")
    eq(PQgetvalue(r1, 1, 1), "Bob", "row 1 name == 'Bob'")
    eq(PQgetvalue(r1, 2, 1), "Carol", "row 2 name == 'Carol'")
    PQclear(r1)

    let rd = pg_exec_ok(conn, "DROP TABLE tml_int_select")
    PQclear(rd)
    PQfinish(conn)
}

// ============================================================================
// 5. UPDATE + DELETE tests
// ============================================================================

func test_update_delete() {
    println("\n[5] UPDATE + DELETE")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "upddel: connect ok")

    let r0 = pg_exec_ok(conn, "DROP TABLE IF EXISTS tml_int_upd")
    PQclear(r0)
    let rc = pg_exec_ok(conn, "CREATE TABLE tml_int_upd (id INTEGER PRIMARY KEY, name TEXT)")
    PQclear(rc)
    let ri = pg_exec_ok(conn, "INSERT INTO tml_int_upd VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Carol')")
    PQclear(ri)

    // 5a. UPDATE 1 row
    let r1 = PQexec(conn, "UPDATE tml_int_upd SET name = 'Updated' WHERE id = 2")
    eq(PQcmdTuples(r1), "1", "UPDATE 1 row: cmdTuples == '1'")
    PQclear(r1)

    // 5b. Verify UPDATE
    let r2 = PQexec(conn, "SELECT name FROM tml_int_upd WHERE id = 2")
    eq(PQgetvalue(r2, 0, 0), "Updated", "UPDATE persisted: name == 'Updated'")
    PQclear(r2)

    // 5c. DELETE 1 row
    let r3 = PQexec(conn, "DELETE FROM tml_int_upd WHERE id = 3")
    eq(PQcmdTuples(r3), "1", "DELETE 1 row: cmdTuples == '1'")
    PQclear(r3)

    // Verify row count after delete
    let r4 = PQexec(conn, "SELECT COUNT(*) FROM tml_int_upd")
    eq(PQgetvalue(r4, 0, 0), "2", "after DELETE, 2 rows remain")
    PQclear(r4)

    let rd = pg_exec_ok(conn, "DROP TABLE tml_int_upd")
    PQclear(rd)
    PQfinish(conn)
}

// ============================================================================
// 6. NULL handling tests
// ============================================================================

func test_null_handling() {
    println("\n[6] NULL handling")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "null: connect ok")

    let r0 = pg_exec_ok(conn, "DROP TABLE IF EXISTS tml_int_null")
    PQclear(r0)
    let rc = pg_exec_ok(conn, "CREATE TABLE tml_int_null (id INTEGER, val TEXT)")
    PQclear(rc)
    let ri = pg_exec_ok(conn, "INSERT INTO tml_int_null VALUES (1, NULL), (2, 'hello')")
    PQclear(ri)

    let r1 = PQexec(conn, "SELECT id, val FROM tml_int_null ORDER BY id")
    eq_i32(PQresultStatus(r1), 2, "null select: status == TUPLES_OK")

    // 6a. NULL field: PQgetisnull == 1
    ok(PQgetisnull(r1, 0, 1) == 1, "row 0 val is NULL (getisnull==1)")

    // 6b. Non-NULL field: PQgetisnull == 0
    ok(PQgetisnull(r1, 1, 1) == 0, "row 1 val is not NULL (getisnull==0)")
    eq(PQgetvalue(r1, 1, 1), "hello", "row 1 val == 'hello'")
    PQclear(r1)

    let rd = pg_exec_ok(conn, "DROP TABLE tml_int_null")
    PQclear(rd)
    PQfinish(conn)
}

// ============================================================================
// 7. Data type tests
// ============================================================================

func test_data_types() {
    println("\n[7] Data types")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "types: connect ok")

    let r0 = pg_exec_ok(conn, "DROP TABLE IF EXISTS tml_int_types")
    PQclear(r0)
    let rc = pg_exec_ok(conn, "CREATE TABLE tml_int_types (i BIGINT, f DOUBLE PRECISION, t TEXT, b BOOLEAN)")
    PQclear(rc)
    let ri = pg_exec_ok(conn, "INSERT INTO tml_int_types VALUES (9876543210, 3.14159, 'hello ''world''', true)")
    PQclear(ri)

    let r1 = PQexec(conn, "SELECT i, f, t, b FROM tml_int_types")
    eq_i32(PQresultStatus(r1), 2, "types select: status == TUPLES_OK")

    // 7a. BIGINT
    eq(PQgetvalue(r1, 0, 0), "9876543210", "BIGINT value correct")

    // 7b. BOOLEAN returns 't' for true
    eq(PQgetvalue(r1, 0, 3), "t", "BOOLEAN true returns 't'")

    // 7c. TEXT with embedded single quote (escaped in SQL as '')
    eq(PQgetvalue(r1, 0, 2), "hello 'world'", "TEXT with embedded quote")
    PQclear(r1)

    // 7d. Insert false bool
    let rf = pg_exec_ok(conn, "INSERT INTO tml_int_types VALUES (0, 0.0, '', false)")
    PQclear(rf)
    let r2 = PQexec(conn, "SELECT b FROM tml_int_types WHERE i = 0")
    eq(PQgetvalue(r2, 0, 0), "f", "BOOLEAN false returns 'f'")
    PQclear(r2)

    let rd = pg_exec_ok(conn, "DROP TABLE tml_int_types")
    PQclear(rd)
    PQfinish(conn)
}

// ============================================================================
// 8. Transaction tests
// ============================================================================

func test_transactions() {
    println("\n[8] Transactions")

    // 8a. BEGIN + INSERT + COMMIT → data persists
    let conn1 = PQconnectdb(ci())
    ok(PQstatus(conn1) == 0, "tx: connect ok for commit test")

    let r0 = pg_exec_ok(conn1, "DROP TABLE IF EXISTS tml_int_tx")
    PQclear(r0)
    let rc = pg_exec_ok(conn1, "CREATE TABLE tml_int_tx (id INTEGER PRIMARY KEY)")
    PQclear(rc)

    let rb = pg_exec_ok(conn1, "BEGIN")
    PQclear(rb)
    let ri = pg_exec_ok(conn1, "INSERT INTO tml_int_tx VALUES (1)")
    PQclear(ri)
    let rco = pg_exec_ok(conn1, "COMMIT")
    PQclear(rco)

    let rq = PQexec(conn1, "SELECT COUNT(*) FROM tml_int_tx")
    eq(PQgetvalue(rq, 0, 0), "1", "after COMMIT, row count == 1")
    PQclear(rq)
    PQfinish(conn1)

    // 8b. BEGIN + INSERT + ROLLBACK → data gone
    let conn2 = PQconnectdb(ci())
    ok(PQstatus(conn2) == 0, "tx: connect ok for rollback test")

    let rb2 = pg_exec_ok(conn2, "BEGIN")
    PQclear(rb2)
    let ri2 = pg_exec_ok(conn2, "INSERT INTO tml_int_tx VALUES (99)")
    PQclear(ri2)
    let rr = pg_exec_ok(conn2, "ROLLBACK")
    PQclear(rr)

    let rq2 = PQexec(conn2, "SELECT COUNT(*) FROM tml_int_tx")
    eq(PQgetvalue(rq2, 0, 0), "1", "after ROLLBACK, still only 1 committed row")
    PQclear(rq2)
    PQfinish(conn2)

    // 8c. PQtransactionStatus: idle outside tx, in-tx after BEGIN
    let conn3 = PQconnectdb(ci())
    ok(PQstatus(conn3) == 0, "tx: connect ok for status test")

    // Idle before BEGIN
    ok(PQtransactionStatus(conn3) == 0, "transaction status is IDLE (0) before BEGIN")

    let rb3 = pg_exec_ok(conn3, "BEGIN")
    PQclear(rb3)

    // In transaction after BEGIN (status == 2 = PQTRANS_INTRANS)
    ok(PQtransactionStatus(conn3) == 2, "transaction status is INTRANS (2) after BEGIN")

    let rro = pg_exec_ok(conn3, "ROLLBACK")
    PQclear(rro)

    // Back to idle
    ok(PQtransactionStatus(conn3) == 0, "transaction status is IDLE (0) after ROLLBACK")

    let rclean = pg_exec_ok(conn3, "DROP TABLE tml_int_tx")
    PQclear(rclean)
    PQfinish(conn3)
}

// ============================================================================
// 9. Column metadata tests
// ============================================================================

func test_column_metadata() {
    println("\n[9] Column metadata")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "meta: connect ok")

    let r0 = pg_exec_ok(conn, "DROP TABLE IF EXISTS tml_int_meta")
    PQclear(r0)
    let rc = pg_exec_ok(conn, "CREATE TABLE tml_int_meta (myid INTEGER, mytext TEXT, myflag BOOLEAN)")
    PQclear(rc)
    let ri = pg_exec_ok(conn, "INSERT INTO tml_int_meta VALUES (42, 'hello', true)")
    PQclear(ri)

    let r1 = PQexec(conn, "SELECT myid, mytext, myflag FROM tml_int_meta")
    eq_i32(PQresultStatus(r1), 2, "meta select: status == TUPLES_OK")

    // 9a. PQfname returns correct column names
    eq(PQfname(r1, 0), "myid", "col 0 name == 'myid'")
    eq(PQfname(r1, 1), "mytext", "col 1 name == 'mytext'")
    eq(PQfname(r1, 2), "myflag", "col 2 name == 'myflag'")

    // 9b. PQftype returns correct OIDs
    // int4 = 23, text = 25, bool = 16
    ok(PQftype(r1, 0) == 23, "col 0 OID == 23 (int4)")
    ok(PQftype(r1, 1) == 25, "col 1 OID == 25 (text)")
    ok(PQftype(r1, 2) == 16, "col 2 OID == 16 (bool)")
    PQclear(r1)

    let rd = pg_exec_ok(conn, "DROP TABLE tml_int_meta")
    PQclear(rd)
    PQfinish(conn)
}

// ============================================================================
// 10. Prepared statement tests (PQprepare — paramValues via PQexec)
// ============================================================================

func test_prepared_statements() {
    println("\n[10] Prepared statements")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "prep: connect ok")

    let r0 = pg_exec_ok(conn, "DROP TABLE IF EXISTS tml_int_prep")
    PQclear(r0)
    let rc = pg_exec_ok(conn, "CREATE TABLE tml_int_prep (id INTEGER, name TEXT)")
    PQclear(rc)

    // Insert rows to query
    let ri = pg_exec_ok(conn, "INSERT INTO tml_int_prep VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Carol')")
    PQclear(ri)

    // 10a. PQprepare with 1 TEXT parameter → COMMAND_OK
    // Note: paramTypes passed as null (0 as *Unit) — PG infers types
    let rp = PQprepare(conn, "find_by_name", "SELECT id FROM tml_int_prep WHERE name = $1", 1, pg_null())
    eq_i32(PQresultStatus(rp), 1, "PQprepare returns COMMAND_OK (1)")
    PQclear(rp)

    // 10b. Verify the prepared statement exists by querying pg_prepared_statements
    let rcheck = PQexec(conn, "SELECT name FROM pg_prepared_statements WHERE name = 'find_by_name'")
    eq_i32(PQresultStatus(rcheck), 2, "pg_prepared_statements query: TUPLES_OK")
    ok(PQntuples(rcheck) == 1, "prepared statement 'find_by_name' exists in pg_prepared_statements")
    eq(PQgetvalue(rcheck, 0, 0), "find_by_name", "statement name matches in catalog")
    PQclear(rcheck)

    // 10c. Execute a second prepare (different name) and confirm both exist
    let rp2 = PQprepare(conn, "count_all", "SELECT COUNT(*) FROM tml_int_prep", 0, pg_null())
    eq_i32(PQresultStatus(rp2), 1, "PQprepare count_all returns COMMAND_OK (1)")
    PQclear(rp2)

    let rcheck2 = PQexec(conn, "SELECT COUNT(*) FROM pg_prepared_statements")
    eq_i32(PQresultStatus(rcheck2), 2, "count prepared statements: TUPLES_OK")
    // At least 2 prepared statements exist now
    ok(PQgetvalue(rcheck2, 0, 0) != "0", "at least 1 prepared statement in catalog")
    PQclear(rcheck2)

    // 10d. PQexecPrepared with no params (count_all uses 0 params)
    // paramValues = null is safe when nParams == 0
    let re = PQexecPrepared(conn, "count_all", 0, pg_null(), pg_null(), pg_null(), 0)
    eq_i32(PQresultStatus(re), 2, "PQexecPrepared count_all: TUPLES_OK (2)")
    eq(PQgetvalue(re, 0, 0), "3", "PQexecPrepared count_all: 3 rows")
    PQclear(re)

    let rd = pg_exec_ok(conn, "DROP TABLE tml_int_prep")
    PQclear(rd)
    PQfinish(conn)
}

// ============================================================================
// 11. Error handling tests
// ============================================================================

func test_error_handling() {
    println("\n[11] Error handling")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "err: connect ok")

    // 11a. Execute invalid SQL → FATAL_ERROR (7)
    let r1 = PQexec(conn, "SELECT * FROM nonexistent_table_xyz_abc")
    ok(PQresultStatus(r1) == 7, "invalid SQL: status == FATAL_ERROR (7)")

    // 11b. PQresultErrorMessage returns non-empty string
    let errmsg = PQresultErrorMessage(r1)
    ok(pg_str_nonempty(errmsg), "invalid SQL: error message is non-empty")
    PQclear(r1)

    // 11c. Syntax error
    let r2 = PQexec(conn, "SELEKT garbage FROM nowhere")
    ok(PQresultStatus(r2) == 7, "syntax error: status == FATAL_ERROR (7)")
    let errmsg2 = PQresultErrorMessage(r2)
    ok(pg_str_nonempty(errmsg2), "syntax error: error message is non-empty")
    PQclear(r2)

    PQfinish(conn)
}

// ============================================================================
// 12. PostgresDialect tests (pure TML, no DB needed)
// ============================================================================

func dialect_placeholder(index: I32) -> Str {
    if index == 1 { return "$1" }
    if index == 2 { return "$2" }
    if index == 3 { return "$3" }
    if index == 4 { return "$4" }
    if index == 5 { return "$5" }
    if index == 6 { return "$6" }
    if index == 7 { return "$7" }
    if index == 8 { return "$8" }
    if index == 9 { return "$9" }
    if index == 10 { return "$10" }
    return "$N"
}

func dialect_quote_identifier(name: Str) -> Str {
    return "\"" + name + "\""
}

func test_dialect() {
    println("\n[12] PostgresDialect (pure TML)")

    // 12a. placeholder(1) == "$1", placeholder(2) == "$2"
    eq(dialect_placeholder(1), "$1", "placeholder(1) == '$1'")
    eq(dialect_placeholder(2), "$2", "placeholder(2) == '$2'")
    eq(dialect_placeholder(10), "$10", "placeholder(10) == '$10'")

    // 12b. quote_identifier("table") == '"table"'
    eq(dialect_quote_identifier("table"), "\"table\"", "quote_identifier('table') == '\"table\"'")
    eq(dialect_quote_identifier("my_schema"), "\"my_schema\"", "quote_identifier('my_schema') correct")
}

// ============================================================================
// 13. OID type mapping tests (pure TML, no DB needed)
// ============================================================================

// Inline the OID constants and logic to avoid cross-module import issues
func oid_to_type_name(oid: I32) -> Str {
    // Integer types: int2=21, int4=23, int8=20, oid=26
    if oid == 21 or oid == 23 or oid == 20 or oid == 26 {
        return "Integer"
    }
    // Float types: float4=700, float8=701, numeric=1700
    if oid == 700 or oid == 701 or oid == 1700 {
        return "Float"
    }
    // Boolean: 16
    if oid == 16 {
        return "Boolean"
    }
    // Bytea: 17
    if oid == 17 {
        return "Blob"
    }
    // Date/time: date=1082, time=1083, timestamp=1114, timestamptz=1184, interval=1186
    if oid == 1082 or oid == 1083 or oid == 1114 or oid == 1184 or oid == 1186 {
        return "Timestamp"
    }
    // UUID: 2950
    if oid == 2950 {
        return "Uuid"
    }
    // Text: 25, varchar=1043, bpchar=1042, json=114, jsonb=3802
    return "Text"
}

func col_type_to_pg(col_type: Str) -> Str {
    if col_type == "Integer" { return "BIGINT" }
    if col_type == "Float"   { return "DOUBLE PRECISION" }
    if col_type == "Text"    { return "TEXT" }
    if col_type == "Blob"    { return "BYTEA" }
    if col_type == "Boolean" { return "BOOLEAN" }
    if col_type == "Timestamp" { return "TIMESTAMPTZ" }
    if col_type == "Uuid"    { return "UUID" }
    return "TEXT"
}

func test_oid_mapping() {
    println("\n[13] OID type mapping (pure TML)")

    // 13a. from_pg_oid(23) == Integer, from_pg_oid(25) == Text
    eq(oid_to_type_name(23), "Integer", "OID 23 (int4) -> Integer")
    eq(oid_to_type_name(25), "Text", "OID 25 (text) -> Text")
    eq(oid_to_type_name(16), "Boolean", "OID 16 (bool) -> Boolean")
    eq(oid_to_type_name(20), "Integer", "OID 20 (int8) -> Integer")
    eq(oid_to_type_name(701), "Float", "OID 701 (float8) -> Float")
    eq(oid_to_type_name(1184), "Timestamp", "OID 1184 (timestamptz) -> Timestamp")
    eq(oid_to_type_name(17), "Blob", "OID 17 (bytea) -> Blob")
    eq(oid_to_type_name(2950), "Uuid", "OID 2950 (uuid) -> Uuid")

    // 13b. to_pg_type mappings
    eq(col_type_to_pg("Integer"), "BIGINT", "Integer -> BIGINT")
    eq(col_type_to_pg("Float"), "DOUBLE PRECISION", "Float -> DOUBLE PRECISION")
    eq(col_type_to_pg("Text"), "TEXT", "Text -> TEXT")
    eq(col_type_to_pg("Blob"), "BYTEA", "Blob -> BYTEA")
    eq(col_type_to_pg("Boolean"), "BOOLEAN", "Boolean -> BOOLEAN")
    eq(col_type_to_pg("Timestamp"), "TIMESTAMPTZ", "Timestamp -> TIMESTAMPTZ")
    eq(col_type_to_pg("Uuid"), "UUID", "Uuid -> UUID")
}

// ============================================================================
// 14. Advanced query tests (subquery, aggregate, ORDER BY + LIMIT)
// ============================================================================

func test_advanced_queries() {
    println("\n[14] Advanced queries")

    let conn = PQconnectdb(ci())
    ok(PQstatus(conn) == 0, "adv: connect ok")

    let r0 = pg_exec_ok(conn, "DROP TABLE IF EXISTS tml_int_adv")
    PQclear(r0)
    let rc = pg_exec_ok(conn, "CREATE TABLE tml_int_adv (id INTEGER, score INTEGER, cat TEXT)")
    PQclear(rc)
    let ri = pg_exec_ok(conn, "INSERT INTO tml_int_adv VALUES (1,90,'A'),(2,80,'B'),(3,95,'A'),(4,70,'B'),(5,85,'A')")
    PQclear(ri)

    // 14a. ORDER BY + LIMIT
    let r1 = PQexec(conn, "SELECT id, score FROM tml_int_adv ORDER BY score DESC LIMIT 2")
    eq_i32(PQresultStatus(r1), 2, "ORDER BY LIMIT: TUPLES_OK")
    ok(PQntuples(r1) == 2, "ORDER BY LIMIT 2: returns 2 rows")
    eq(PQgetvalue(r1, 0, 1), "95", "top score is 95")
    eq(PQgetvalue(r1, 1, 1), "90", "second score is 90")
    PQclear(r1)

    // 14b. Aggregate: GROUP BY + COUNT
    let r2 = PQexec(conn, "SELECT cat, COUNT(*) as cnt FROM tml_int_adv GROUP BY cat ORDER BY cat")
    eq_i32(PQresultStatus(r2), 2, "GROUP BY: TUPLES_OK")
    ok(PQntuples(r2) == 2, "GROUP BY cat: 2 groups")
    eq(PQgetvalue(r2, 0, 0), "A", "group A")
    eq(PQgetvalue(r2, 0, 1), "3", "group A count = 3")
    eq(PQgetvalue(r2, 1, 0), "B", "group B")
    eq(PQgetvalue(r2, 1, 1), "2", "group B count = 2")
    PQclear(r2)

    // 14c. Subquery: SELECT WHERE id IN (subquery)
    let r3 = PQexec(conn, "SELECT score FROM tml_int_adv WHERE id IN (SELECT id FROM tml_int_adv WHERE score > 88) ORDER BY score")
    eq_i32(PQresultStatus(r3), 2, "subquery: TUPLES_OK")
    ok(PQntuples(r3) == 2, "subquery returns 2 rows with score > 88")
    eq(PQgetvalue(r3, 0, 0), "90", "subquery row 0 score == 90")
    eq(PQgetvalue(r3, 1, 0), "95", "subquery row 1 score == 95")
    PQclear(r3)

    // 14d. SUM aggregate
    let r4 = PQexec(conn, "SELECT SUM(score) FROM tml_int_adv")
    eq_i32(PQresultStatus(r4), 2, "SUM: TUPLES_OK")
    eq(PQgetvalue(r4, 0, 0), "420", "SUM(score) == 420")
    PQclear(r4)

    let rd = pg_exec_ok(conn, "DROP TABLE tml_int_adv")
    PQclear(rd)
    PQfinish(conn)
}

// ============================================================================
// main
// ============================================================================

func main() {
    println("=== PostgreSQL Full Integration Tests ===")
    println("Connection: host=localhost port=5433 dbname=projectv")

    test_connection()
    test_ddl()
    test_insert()
    test_select()
    test_update_delete()
    test_null_handling()
    test_data_types()
    test_transactions()
    test_column_metadata()
    test_prepared_statements()
    test_error_handling()
    test_dialect()
    test_oid_mapping()
    test_advanced_queries()

    println("\n=== DONE ===")
    println("Grep for 'FAIL' to find any failures.")
}
