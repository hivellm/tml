        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_str")
            let _ = conn.execute("CREATE TABLE tml_test_exec_str (val TEXT)")

            let ins = conn.execute_str("INSERT INTO tml_test_exec_str (val) VALUES ($1)", "hello_world")
            when ins {
                Err(_) => {
                    assert(false, "execute_str should succeed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_str")
                    conn.close()
                    return 1
                },
                Ok(rows) => {
                    assert_eq(rows, 1, "should insert 1 row")
                }
            }

            let count = conn.query_scalar_i64("SELECT COUNT(*) FROM tml_test_exec_str WHERE val = 'hello_world'")
            assert_eq(count, 1, "str param insert should persist")

            let _ = conn.execute("DROP TABLE tml_test_exec_str")
            conn.close()
            return 0
        }
    }
}

