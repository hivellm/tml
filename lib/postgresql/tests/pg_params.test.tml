// PostgreSQL parameterized execute_* method tests.
//
// Covers:
//   PgConnection::execute_i64_params, execute_i64_2, execute_str,
//   execute_str_i64, execute_i64_str, execute_3_i64, execute_2str, execute_2str_i64

use test::{assert, assert_eq}
use std::os::env_get
use postgresql::connection::PgConnection

const DEFAULT_DATABASE_URL: Str = "postgresql://projectv:projectv_dev@localhost:5433/projectv"

/// Reads connection URL from DATABASE_URL env var, falls back to local dev default.
func database_url() -> Str {
    let maybe_url = env_get("DATABASE_URL")
    when maybe_url {
        Just(url) => return url,
        Nothing => return DEFAULT_DATABASE_URL
    }
}

/// execute_i64_params — INSERT with one I64 ($1).
@test @slow_test
func test_execute_i64_params() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_p")
            let _ = conn.execute("CREATE TABLE tml_test_exec_i64_p (id BIGINT PRIMARY KEY)")

            let ins = conn.execute_i64_params("INSERT INTO tml_test_exec_i64_p (id) VALUES ($1)", 42)
            when ins {
                Err(_) => {
                    assert(false, "execute_i64_params should succeed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_p")
                    conn.close()
                    return 1
                },
                Ok(rows) => {
                    assert_eq(rows, 1, "should insert 1 row")
                }
            }

            let count = conn.query_scalar_i64("SELECT COUNT(*) FROM tml_test_exec_i64_p WHERE id = 42")
            assert_eq(count, 1, "parameterized insert should have persisted row with id=42")

            let _ = conn.execute("DROP TABLE tml_test_exec_i64_p")
            conn.close()
            return 0
        }
    }
}

/// execute_i64_2 — INSERT with two I64 params ($1, $2).
@test @slow_test
func test_execute_i64_2() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_2")
            let _ = conn.execute("CREATE TABLE tml_test_exec_i64_2 (a BIGINT, b BIGINT)")

            let ins = conn.execute_i64_2("INSERT INTO tml_test_exec_i64_2 (a, b) VALUES ($1, $2)", 10, 20)
            when ins {
                Err(_) => {
                    assert(false, "execute_i64_2 should succeed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_2")
                    conn.close()
                    return 1
                },
                Ok(rows) => {
                    assert_eq(rows, 1, "should insert 1 row")
                }
            }

            let sum = conn.query_scalar_i64("SELECT a + b FROM tml_test_exec_i64_2 LIMIT 1")
            assert_eq(sum, 30, "a=10 + b=20 should equal 30")

            let _ = conn.execute("DROP TABLE tml_test_exec_i64_2")
            conn.close()
            return 0
        }
    }
}

