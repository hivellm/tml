// PostgreSQL comprehensive API tests.
//
// Requires: PostgreSQL running on localhost:5433 (Docker)
//   docker run -d -p 5433:5432 \
//     -e POSTGRES_DB=projectv -e POSTGRES_USER=projectv \
//     -e POSTGRES_PASSWORD=projectv_dev postgres:16-alpine
//
// Covers the FULL public API surface of:
//   postgresql::connection::PgConnection
//   postgresql::statement::PgStatement
//   postgresql::dialect::PostgresDialect
//   postgresql::types::{from_pg_oid, to_pg_type, from_pg_type_name, OID constants}

use test::{assert, assert_eq}
use std::os::env_get
use postgresql::connection::PgConnection
use postgresql::statement::PgStatement
use postgresql::dialect::PostgresDialect
use postgresql::types::{from_pg_oid, to_pg_type, from_pg_type_name, PG_INT4_OID, PG_TEXT_OID, PG_FLOAT8_OID, PG_BOOL_OID, PG_BYTEA_OID, PG_TIMESTAMP_OID, PG_UUID_OID, PG_JSONB_OID, PG_INT8_OID, PG_INT2_OID, PG_FLOAT4_OID, PG_NUMERIC_OID, PG_VARCHAR_OID, PG_BPCHAR_OID}
use std::db::types::ColumnType

const DEFAULT_CONNSTR: Str = "host=localhost port=5433 dbname=projectv user=projectv password=projectv_dev"

/// Reads connection string from DATABASE_URL env var, falls back to default.
func get_connstr() -> Str {
    let maybe_url = env_get("DATABASE_URL")
    when maybe_url {
        Just(url) => return url,
        Nothing => {}
    }
    let maybe_pg = env_get("PG_TEST_CONNSTR")
    when maybe_pg {
        Just(pg) => return pg,
        Nothing => {}
    }
    return DEFAULT_CONNSTR
}

// ── Connection ───────────────────────────────────────────────────────────────

/// Successful connect reports is_alive() == true.
@test
func test_connect_success() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection should succeed")
            return 1
        },
        Ok(mut conn) => {
            assert(conn.is_alive(), "is_alive should be true after connect")
            conn.close()
            return 0
        }
    }
}

/// Connecting to a bad host returns Err.
@test
func test_connect_bad_host() -> I32 {
    let result = PgConnection::connect("host=nonexistent port=9999 dbname=x user=x password=x connect_timeout=1")
    when result {
        Err(_) => return 0,
        Ok(mut conn) => {
            assert(false, "connection to nonexistent host should fail")
            conn.close()
            return 1
        }
    }
}

/// close() makes is_alive() return false.
@test
func test_close_makes_not_alive() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            conn.close()
            assert(not conn.is_alive(), "is_alive should be false after close")
            return 0
        }
    }
}

/// server_version() returns a positive integer (PG 16 = 160000+).
@test
func test_server_version() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let ver = conn.server_version()
            assert(ver > 0, "server_version should be positive")
            conn.close()
            return 0
        }
    }
}

/// raw_handle() returns a non-null pointer.
@test
func test_raw_handle() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let handle = conn.raw_handle()
            assert(handle != 0 as *Unit, "raw_handle should be non-null")
            conn.close()
            return 0
        }
    }
}

/// transaction_status() is 0 (idle) when not in a transaction.
@test
func test_transaction_status_idle() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let status = conn.transaction_status()
            assert_eq(status, 0, "transaction_status should be 0 (idle) outside a transaction")
            conn.close()
            return 0
        }
    }
}

// ── DDL ──────────────────────────────────────────────────────────────────────

/// CREATE TABLE then DROP TABLE both succeed.
@test
func test_create_drop_table() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_create_drop")

            let create = conn.execute("CREATE TABLE tml_test_create_drop (id SERIAL PRIMARY KEY, val TEXT)")
            when create {
                Err(_) => {
                    assert(false, "CREATE TABLE should succeed")
                    conn.close()
                    return 1
                },
                Ok(_) => {}
            }

            let drop = conn.execute("DROP TABLE tml_test_create_drop")
            when drop {
                Err(_) => {
                    assert(false, "DROP TABLE should succeed")
                    conn.close()
                    return 1
                },
                Ok(_) => {}
            }

            conn.close()
            return 0
        }
    }
}

/// execute() with invalid SQL returns Err.
@test
func test_execute_error_bad_sql() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let bad = conn.execute("THIS IS NOT VALID SQL AT ALL !!!")
            when bad {
                Err(_) => {
                    conn.close()
                    return 0
                },
                Ok(_) => {
                    assert(false, "invalid SQL should return Err")
                    conn.close()
                    return 1
                }
            }
        }
    }
}

// ── Insert / Update / Delete ─────────────────────────────────────────────────

/// INSERT returns affected row count of 1.
@test
func test_insert_affected_rows() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_insert_rows")
            let _ = conn.execute("CREATE TABLE tml_test_insert_rows (id SERIAL PRIMARY KEY, val TEXT)")

            let ins = conn.execute("INSERT INTO tml_test_insert_rows (val) VALUES ('hello')")
            when ins {
                Err(_) => {
                    assert(false, "INSERT should succeed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_insert_rows")
                    conn.close()
                    return 1
                },
                Ok(rows) => {
                    assert_eq(rows, 1, "INSERT of one row should return 1 affected row")
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_insert_rows")
            conn.close()
            return 0
        }
    }
}

/// UPDATE N rows returns N.
@test
func test_update_affected_rows() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_update_rows")
            let _ = conn.execute("CREATE TABLE tml_test_update_rows (id SERIAL PRIMARY KEY, score INTEGER DEFAULT 0)")
            let _ = conn.execute("INSERT INTO tml_test_update_rows DEFAULT VALUES")
            let _ = conn.execute("INSERT INTO tml_test_update_rows DEFAULT VALUES")
            let _ = conn.execute("INSERT INTO tml_test_update_rows DEFAULT VALUES")

            let upd = conn.execute("UPDATE tml_test_update_rows SET score = 10")
            when upd {
                Err(_) => {
                    assert(false, "UPDATE should succeed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_update_rows")
                    conn.close()
                    return 1
                },
                Ok(rows) => {
                    assert_eq(rows, 3, "UPDATE of 3 rows should return 3 affected rows")
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_update_rows")
            conn.close()
            return 0
        }
    }
}

/// DELETE returns the correct count.
@test
func test_delete_affected_rows() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_delete_rows")
            let _ = conn.execute("CREATE TABLE tml_test_delete_rows (id INTEGER PRIMARY KEY)")
            let _ = conn.execute("INSERT INTO tml_test_delete_rows VALUES (1),(2),(3),(4),(5)")

            let del = conn.execute("DELETE FROM tml_test_delete_rows WHERE id <= 3")
            when del {
                Err(_) => {
                    assert(false, "DELETE should succeed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_delete_rows")
                    conn.close()
                    return 1
                },
                Ok(rows) => {
                    assert_eq(rows, 3, "DELETE of 3 rows should return 3")
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_delete_rows")
            conn.close()
            return 0
        }
    }
}

// ── Parameterized Queries ────────────────────────────────────────────────────

/// execute_i64_params — INSERT with one I64 ($1).
@test
func test_execute_i64_params() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_p")
            let _ = conn.execute("CREATE TABLE tml_test_exec_i64_p (id BIGINT PRIMARY KEY)")

            let ins = conn.execute_i64_params("INSERT INTO tml_test_exec_i64_p (id) VALUES ($1)", 42)
            when ins {
                Err(_) => {
                    assert(false, "execute_i64_params should succeed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_p")
                    conn.close()
                    return 1
                },
                Ok(rows) => {
                    assert_eq(rows, 1, "should insert 1 row")
                }
            }

            let count_r = conn.query_scalar_i64("SELECT COUNT(*) FROM tml_test_exec_i64_p WHERE id = 42")
            when count_r {
                Err(_) => {
                    assert(false, "count query failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_p")
                    conn.close()
                    return 1
                },
                Ok(count) => {
                    assert_eq(count, 1, "parameterized insert should have persisted row with id=42")
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_exec_i64_p")
            conn.close()
            return 0
        }
    }
}

/// execute_i64_2 — INSERT with two I64 params ($1, $2).
@test
func test_execute_i64_2() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_2")
            let _ = conn.execute("CREATE TABLE tml_test_exec_i64_2 (a BIGINT, b BIGINT)")

            let ins = conn.execute_i64_2("INSERT INTO tml_test_exec_i64_2 (a, b) VALUES ($1, $2)", 10, 20)
            when ins {
                Err(_) => {
                    assert(false, "execute_i64_2 should succeed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_2")
                    conn.close()
                    return 1
                },
                Ok(rows) => {
                    assert_eq(rows, 1, "should insert 1 row")
                }
            }

            let sum_r = conn.query_scalar_i64("SELECT a + b FROM tml_test_exec_i64_2 LIMIT 1")
            when sum_r {
                Err(_) => {
                    assert(false, "sum query failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_exec_i64_2")
                    conn.close()
                    return 1
                },
                Ok(sum) => {
                    assert_eq(sum, 30, "a=10 + b=20 should equal 30")
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_exec_i64_2")
            conn.close()
            return 0
        }
    }
}

