            when ins_r {
                Err(_) => {
                    assert(false, "prepare INSERT with nullable failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_null")
                    conn.close()
                    return 1
                },
                Ok(mut ins_stmt) => {
                    let bind1_r = ins_stmt.bind_i64(1, 1)
                    when bind1_r {
                        Err(_) => { assert(false, "bind_i64 failed") },
                        Ok(_) => {}
                    }
