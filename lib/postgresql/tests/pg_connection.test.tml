            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_multi")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_multi (n BIGINT)")
            let _ = conn.execute("INSERT INTO tml_test_stmt_multi VALUES (10),(20),(30),(40),(50)")

            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT n FROM tml_test_stmt_multi ORDER BY n", 0)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare SELECT failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_multi")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let exec_r = stmt.execute_query()
                    when exec_r {
                        Err(_) => {
                            assert(false, "execute_query failed")
                            stmt.finalize()
                            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_multi")
                            conn.close()
                            return 1
                        },
                        Ok(_) => {}
                    }

                    let row_count = stmt.row_count()
                    assert_eq(row_count, 5, "row_count should be 5")

                    var total: I64 = 0
                    loop (stmt.step()) {
                        total = total + stmt.column_i64(0)
                    }
                    assert_eq(total, 150, "sum of 10+20+30+40+50 should be 150")

                    stmt.finalize()
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_multi")
            conn.close()
            return 0
        }
    }
}

/// PgStatement: column_count, column_name, column_type_oid.
@test
func test_stmt_column_metadata() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_meta")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_meta (user_id BIGINT, username TEXT)")
            let _ = conn.execute("INSERT INTO tml_test_stmt_meta VALUES (1, 'alice')")

            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT user_id, username FROM tml_test_stmt_meta LIMIT 1", 0)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_meta")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let exec_r = stmt.execute_query()
                    when exec_r {
                        Err(_) => {
                            assert(false, "execute_query failed")
                            stmt.finalize()
                            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_meta")
                            conn.close()
                            return 1
                        },
                        Ok(_) => {}
                    }

                    let col_count = stmt.column_count()
                    assert_eq(col_count, 2, "column_count should be 2")

                    let col0_name = stmt.column_name(0)
                    assert_eq(col0_name, "user_id", "column_name(0) should be 'user_id'")

                    let col1_name = stmt.column_name(1)
                    assert_eq(col1_name, "username", "column_name(1) should be 'username'")

                    // column_type_oid for BIGINT (int8) = 20
                    let oid0 = stmt.column_type_oid(0)
                    assert_eq(oid0, 20, "OID for BIGINT column should be 20 (PG_INT8_OID)")

                    // column_type_oid for TEXT = 25
                    let oid1 = stmt.column_type_oid(1)
                    assert_eq(oid1, 25, "OID for TEXT column should be 25 (PG_TEXT_OID)")

                    stmt.finalize()
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_meta")
            conn.close()
            return 0
        }
    }
}

/// PgStatement: reset, rebind with new values, re-execute.
@test
func test_stmt_reset_rebind() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_reset")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_reset (id BIGINT PRIMARY KEY)")

            let stmt_r = PgStatement::prepare(conn.raw_handle(), "INSERT INTO tml_test_stmt_reset (id) VALUES ($1)", 1)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_reset")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    // First execution with id=1
                    let _ = stmt.bind_i64(1, 1)
                    let run1_r = stmt.run()
                    when run1_r {
                        Err(_) => { assert(false, "first run failed") },
                        Ok(rows) => { assert_eq(rows, 1, "first run should insert 1 row") }
                    }

                    // Reset and rebind with id=2
                    let reset_r = stmt.reset()
                    when reset_r {
                        Err(_) => {
                            assert(false, "reset failed")
                            stmt.finalize()
                            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_reset")
                            conn.close()
                            return 1
                        },
                        Ok(_) => {}
                    }

                    let _ = stmt.bind_i64(1, 2)
                    let run2_r = stmt.run()
                    when run2_r {
                        Err(_) => { assert(false, "second run after reset failed") },
                        Ok(rows) => { assert_eq(rows, 1, "second run should insert 1 row") }
                    }

                    stmt.finalize()
                }
            }

            let count_r = conn.query_scalar_i64("SELECT COUNT(*) FROM tml_test_stmt_reset")
            when count_r {
                Err(_) => {
                    assert(false, "count query failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_reset")
                    conn.close()
                    return 1
                },
                Ok(count) => {
                    assert_eq(count, 2, "both rows (id=1 and id=2) should exist after reset+rebind")
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_reset")
            conn.close()
            return 0
        }
    }
}

/// PgStatement: finalize releases server-side prepared statement.
@test
func test_stmt_finalize() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT 1::BIGINT AS n", 0)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare failed")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let exec_r = stmt.execute_query()
                    when exec_r {
                        Err(_) => {
                            assert(false, "execute_query failed")
                            stmt.finalize()
                            conn.close()
                            return 1
                        },
                        Ok(_) => {}
                    }

                    let has_row = stmt.step()
                    assert(has_row, "should have one row")
                    let n = stmt.column_i64(0)
                    assert_eq(n, 1, "SELECT 1 should return 1")

                    // finalize() should not crash and should deallocate the server statement
                    stmt.finalize()
                    // Connection should still be usable after finalize
                    let check_r = conn.query_scalar_i64("SELECT 2")
                    when check_r {
                        Err(_) => {
                            assert(false, "connection should still work after stmt finalize")
                            conn.close()
                            return 1
                        },
                        Ok(val) => {
                            assert_eq(val, 2, "connection should return 2 after stmt finalize")
                        }
                    }
                }
            }

            conn.close()
            return 0
        }
    }
}

