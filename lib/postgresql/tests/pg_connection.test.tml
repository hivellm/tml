// ── Transactions ─────────────────────────────────────────────────────────────

/// begin + commit — committed data is visible after commit.
@test
func test_transaction_commit() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_tx_commit")
            let _ = conn.execute("CREATE TABLE tml_test_tx_commit (id INTEGER PRIMARY KEY)")

            let begin_r = conn.begin()
            when begin_r {
                Err(_) => {
                    assert(false, "BEGIN failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_tx_commit")
                    conn.close()
                    return 1
                },
                Ok(_) => {}
            }

            let _ = conn.execute("INSERT INTO tml_test_tx_commit VALUES (42)")

            let commit_r = conn.commit()
            when commit_r {
                Err(_) => {
                    assert(false, "COMMIT failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_tx_commit")
                    conn.close()
                    return 1
                },
                Ok(_) => {}
            }

            let count_r = conn.query_scalar_i64("SELECT COUNT(*) FROM tml_test_tx_commit WHERE id = 42")
            when count_r {
                Err(_) => {
                    assert(false, "verify query failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_tx_commit")
                    conn.close()
                    return 1
                },
                Ok(count) => {
                    assert_eq(count, 1, "committed row must be visible")
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_tx_commit")
            conn.close()
            return 0
        }
    }
}

/// begin + rollback — rolled-back data is NOT visible after rollback.
@test
func test_transaction_rollback() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
