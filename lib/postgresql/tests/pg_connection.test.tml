                    when null_r {
                        Err(_) => { assert(false, "bind_null failed") },
                        Ok(_) => {}
                    }
                    let run_r = ins_stmt.run()
                    when run_r {
                        Err(_) => { assert(false, "run with null failed") },
                        Ok(_) => {}
                    }
                    ins_stmt.finalize()
                }
            }

            let sel_r = PgStatement::prepare(conn.raw_handle(), "SELECT optional FROM tml_test_stmt_null WHERE id = $1", 1)
            when sel_r {
                Err(_) => {
                    assert(false, "prepare SELECT nullable failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_null")
                    conn.close()
                    return 1
                },
                Ok(mut sel_stmt) => {
                    let bind_r = sel_stmt.bind_i64(1, 1)
                    when bind_r {
                        Err(_) => { assert(false, "bind failed") },
                        Ok(_) => {}
                    }
                    let exec_r = sel_stmt.execute_query()
                    when exec_r {
                        Err(_) => { assert(false, "execute_query failed") },
                        Ok(_) => {}
                    }

                    let has_row = sel_stmt.step()
                    assert(has_row, "should have row for null test")

                    let is_null = sel_stmt.column_is_null(0)
                    assert(is_null, "column_is_null should be true for bound NULL value")

                    sel_stmt.finalize()
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_null")
            conn.close()
            return 0
        }
    }
}

/// bind with index out of range returns Err.
@test
func test_stmt_bind_out_of_range() -> I32 {
    let result = PgConnection::connect(get_connstr())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT $1::BIGINT", 1)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare failed")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    // Bind at index 0 (< 1, should fail)
                    let bad_r = stmt.bind_i64(0, 42)
                    when bad_r {
                        Err(_) => {
                            // Expected — index 0 is out of range (1-based)
                        },
                        Ok(_) => {
                            assert(false, "bind_i64(0, ...) should return Err (index < 1)")
                        }
                    }
                    // Bind at index 2 (> param_count=1, should fail)
                    let bad2_r = stmt.bind_i64(2, 42)
                    when bad2_r {
                        Err(_) => {
                            // Expected
                        },
                        Ok(_) => {
                            assert(false, "bind_i64(2, ...) with param_count=1 should return Err")
                        }
                    }
                    stmt.finalize()
                }
            }

            conn.close()
            return 0
        }
    }
}

