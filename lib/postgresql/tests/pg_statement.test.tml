// PostgreSQL prepared statement tests — binding, stepping, metadata, NULL handling, and errors.
//
// Covers:
//   PgStatement::prepare, bind_i64, bind_str, bind_f64, bind_null,
//   run, execute_query, step, finalize, reset,
//   column_i64, column_str, column_f64, column_is_null,
//   column_count, column_name, column_type_oid, row_count

use test::{assert, assert_eq}
use std::os::env_get
use postgresql::connection::PgConnection
use postgresql::statement::PgStatement

const DEFAULT_DATABASE_URL: Str = "postgresql://projectv:projectv_dev@localhost:5433/projectv"

/// Reads connection URL from DATABASE_URL env var, falls back to local dev default.
func database_url() -> Str {
    let maybe_url = env_get("DATABASE_URL")
    when maybe_url {
        Just(url) => return url,
        Nothing => return DEFAULT_DATABASE_URL
    }
}

/// PgStatement::prepare + bind_i64 + run — basic DML.
@test @slow_test
func test_stmt_prepare_and_run() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_run")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_run (id BIGINT PRIMARY KEY, name TEXT)")

            let stmt_r = PgStatement::prepare(conn.raw_handle(), "INSERT INTO tml_test_stmt_run (id, name) VALUES ($1, $2)", 2)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare should succeed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_run")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let bind1_r = stmt.bind_i64(1, 100)
                    when bind1_r {
                        Err(_) => { assert(false, "bind_i64(1) failed") },
                        Ok(_) => {}
                    }
                    let bind2_r = stmt.bind_str(2, "prepared_row")
                    when bind2_r {
                        Err(_) => { assert(false, "bind_str(2) failed") },
                        Ok(_) => {}
                    }

                    let run_r = stmt.run()
                    when run_r {
                        Err(_) => {
                            assert(false, "stmt.run() should succeed")
                            stmt.finalize()
                            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_run")
                            conn.close()
                            return 1
                        },
                        Ok(rows) => {
                            assert_eq(rows, 1, "prepared statement run should insert 1 row")
                        }
                    }

                    stmt.finalize()
                }
            }

            let count_r = conn.query_scalar_i64("SELECT COUNT(*) FROM tml_test_stmt_run WHERE id = 100")
            when count_r {
                Err(_) => {
                    assert(false, "count query failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_run")
                    conn.close()
                    return 1
                },
                Ok(count) => {
                    assert_eq(count, 1, "prepared statement should have inserted row with id=100")
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_run")
            conn.close()
            return 0
        }
    }
}

/// PgStatement: prepare SELECT + execute_query + step + column_str + column_i64.
@test @slow_test
func test_stmt_select_step() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_select")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_select (id BIGINT, label TEXT)")
            let _ = conn.execute("INSERT INTO tml_test_stmt_select VALUES (5, 'five')")

            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT id, label FROM tml_test_stmt_select WHERE id = $1", 1)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare SELECT failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_select")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let bind_r = stmt.bind_i64(1, 5)
                    when bind_r {
                        Err(_) => { assert(false, "bind_i64 failed") },
                        Ok(_) => {}
                    }

                    let exec_r = stmt.execute_query()
                    when exec_r {
                        Err(_) => {
                            assert(false, "execute_query failed")
                            stmt.finalize()
                            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_select")
                            conn.close()
                            return 1
                        },
                        Ok(_) => {}
                    }

                    let has_row = stmt.step()
                    assert(has_row, "step() should return true for first row")

                    let id_val = stmt.column_i64(0)
                    assert_eq(id_val, 5, "column_i64(0) should return 5")

                    let label_val = stmt.column_str(1)
                    assert_eq(label_val, "five", "column_str(1) should return 'five'")

                    let no_more = stmt.step()
                    assert(not no_more, "step() should return false after all rows consumed")

                    stmt.finalize()
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_select")
            conn.close()
            return 0
        }
    }
}

/// PgStatement: bind_f64 — bind a float and query it back.
@test @slow_test
func test_stmt_bind_f64() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_f64")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_f64 (val DOUBLE PRECISION)")

            let stmt_r = PgStatement::prepare(conn.raw_handle(), "INSERT INTO tml_test_stmt_f64 (val) VALUES ($1)", 1)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare INSERT DOUBLE PRECISION failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_f64")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let bind_r = stmt.bind_f64(1, 3.14)
                    when bind_r {
                        Err(_) => { assert(false, "bind_f64 failed") },
                        Ok(_) => {}
                    }
                    let run_r = stmt.run()
                    when run_r {
                        Err(_) => { assert(false, "stmt.run() for f64 failed") },
                        Ok(_) => {}
                    }
                    stmt.finalize()
                }
            }

            // Read back with a select stmt and check column_f64
            let sel_r = PgStatement::prepare(conn.raw_handle(), "SELECT val FROM tml_test_stmt_f64 LIMIT 1", 0)
            when sel_r {
                Err(_) => {
                    assert(false, "prepare SELECT DOUBLE PRECISION failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_f64")
                    conn.close()
                    return 1
                },
                Ok(mut sel_stmt) => {
                    let exec_r = sel_stmt.execute_query()
                    when exec_r {
                        Err(_) => { assert(false, "execute_query for f64 failed") },
                        Ok(_) => {}
                    }

                    let has_row = sel_stmt.step()
                    assert(has_row, "should have a row for f64 test")

                    let val = sel_stmt.column_f64(0)
                    // Allow small floating-point tolerance — 3.14 round-trips through text protocol
                    assert(val > 3.13 and val < 3.15, "column_f64 should return ~3.14")

                    sel_stmt.finalize()
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_f64")
            conn.close()
            return 0
        }
    }
}

/// PgStatement: bind_null — column_is_null returns true for NULL column.
@test @slow_test
func test_stmt_bind_null() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_null")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_null (id BIGINT, optional TEXT)")

            let ins_r = PgStatement::prepare(conn.raw_handle(), "INSERT INTO tml_test_stmt_null (id, optional) VALUES ($1, $2)", 2)
            when ins_r {
                Err(_) => {
                    assert(false, "prepare INSERT with nullable failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_null")
                    conn.close()
                    return 1
                },
                Ok(mut ins_stmt) => {
                    let bind1_r = ins_stmt.bind_i64(1, 1)
                    when bind1_r {
                        Err(_) => { assert(false, "bind_i64 failed") },
                        Ok(_) => {}
                    }
                    let null_r = ins_stmt.bind_null(2)
                    when null_r {
                        Err(_) => { assert(false, "bind_null failed") },
                        Ok(_) => {}
                    }
                    let run_r = ins_stmt.run()
                    when run_r {
                        Err(_) => { assert(false, "run with null failed") },
                        Ok(_) => {}
                    }
                    ins_stmt.finalize()
                }
            }

            let sel_r = PgStatement::prepare(conn.raw_handle(), "SELECT optional FROM tml_test_stmt_null WHERE id = $1", 1)
            when sel_r {
                Err(_) => {
                    assert(false, "prepare SELECT nullable failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_null")
                    conn.close()
                    return 1
                },
                Ok(mut sel_stmt) => {
                    let bind_r = sel_stmt.bind_i64(1, 1)
                    when bind_r {
                        Err(_) => { assert(false, "bind failed") },
                        Ok(_) => {}
                    }
                    let exec_r = sel_stmt.execute_query()
                    when exec_r {
                        Err(_) => { assert(false, "execute_query failed") },
                        Ok(_) => {}
                    }

                    let has_row = sel_stmt.step()
                    assert(has_row, "should have row for null test")

                    let is_null = sel_stmt.column_is_null(0)
                    assert(is_null, "column_is_null should be true for bound NULL value")

                    sel_stmt.finalize()
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_null")
            conn.close()
            return 0
        }
    }
}

/// bind with index out of range returns Err.
@test @slow_test
func test_stmt_bind_out_of_range() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT $1::BIGINT", 1)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare failed")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    // Bind at index 0 (< 1, should fail)
                    let bad_r = stmt.bind_i64(0, 42)
                    when bad_r {
                        Err(_) => {
                            // Expected — index 0 is out of range (1-based)
                        },
                        Ok(_) => {
                            assert(false, "bind_i64(0, ...) should return Err (index < 1)")
                        }
                    }
                    // Bind at index 2 (> param_count=1, should fail)
                    let bad2_r = stmt.bind_i64(2, 42)
                    when bad2_r {
                        Err(_) => {
                            // Expected
                        },
                        Ok(_) => {
                            assert(false, "bind_i64(2, ...) with param_count=1 should return Err")
                        }
                    }
                    stmt.finalize()
                }
            }

            conn.close()
            return 0
        }
    }
}

/// PgStatement: step through multiple rows.
@test @slow_test
func test_stmt_multiple_rows() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_multi")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_multi (n BIGINT)")
            let _ = conn.execute("INSERT INTO tml_test_stmt_multi VALUES (10),(20),(30),(40),(50)")

            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT n FROM tml_test_stmt_multi ORDER BY n", 0)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare SELECT failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_multi")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let exec_r = stmt.execute_query()
                    when exec_r {
                        Err(_) => {
                            assert(false, "execute_query failed")
                            stmt.finalize()
                            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_multi")
                            conn.close()
                            return 1
                        },
                        Ok(_) => {}
                    }

                    let row_count = stmt.row_count()
                    assert_eq(row_count, 5, "row_count should be 5")

                    var total: I64 = 0
                    loop (stmt.step()) {
                        total = total + stmt.column_i64(0)
                    }
                    assert_eq(total, 150, "sum of 10+20+30+40+50 should be 150")

                    stmt.finalize()
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_multi")
            conn.close()
            return 0
        }
    }
}

/// PgStatement: column_count, column_name, column_type_oid.
@test @slow_test
func test_stmt_column_metadata() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_meta")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_meta (user_id BIGINT, username TEXT)")
            let _ = conn.execute("INSERT INTO tml_test_stmt_meta VALUES (1, 'alice')")

            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT user_id, username FROM tml_test_stmt_meta LIMIT 1", 0)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_meta")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let exec_r = stmt.execute_query()
                    when exec_r {
                        Err(_) => {
                            assert(false, "execute_query failed")
                            stmt.finalize()
                            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_meta")
                            conn.close()
                            return 1
                        },
                        Ok(_) => {}
                    }

                    let col_count = stmt.column_count()
                    assert_eq(col_count, 2, "column_count should be 2")

                    let col0_name = stmt.column_name(0)
                    assert_eq(col0_name, "user_id", "column_name(0) should be 'user_id'")

                    let col1_name = stmt.column_name(1)
                    assert_eq(col1_name, "username", "column_name(1) should be 'username'")

                    // column_type_oid for BIGINT (int8) = 20
                    let oid0 = stmt.column_type_oid(0)
                    assert_eq(oid0, 20, "OID for BIGINT column should be 20 (PG_INT8_OID)")

                    // column_type_oid for TEXT = 25
                    let oid1 = stmt.column_type_oid(1)
                    assert_eq(oid1, 25, "OID for TEXT column should be 25 (PG_TEXT_OID)")

                    stmt.finalize()
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_meta")
            conn.close()
            return 0
        }
    }
}

/// PgStatement: reset, rebind with new values, re-execute.
@test @slow_test
func test_stmt_reset_rebind() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_reset")
            let _ = conn.execute("CREATE TABLE tml_test_stmt_reset (id BIGINT PRIMARY KEY)")

            let stmt_r = PgStatement::prepare(conn.raw_handle(), "INSERT INTO tml_test_stmt_reset (id) VALUES ($1)", 1)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_reset")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    // First execution with id=1
                    let _ = stmt.bind_i64(1, 1)
                    let run1_r = stmt.run()
                    when run1_r {
                        Err(_) => { assert(false, "first run failed") },
                        Ok(rows) => { assert_eq(rows, 1, "first run should insert 1 row") }
                    }

                    // Reset and rebind with id=2
                    let reset_r = stmt.reset()
                    when reset_r {
                        Err(_) => {
                            assert(false, "reset failed")
                            stmt.finalize()
                            let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_reset")
                            conn.close()
                            return 1
                        },
                        Ok(_) => {}
                    }

                    let _ = stmt.bind_i64(1, 2)
                    let run2_r = stmt.run()
                    when run2_r {
                        Err(_) => { assert(false, "second run after reset failed") },
                        Ok(rows) => { assert_eq(rows, 1, "second run should insert 1 row") }
                    }

                    stmt.finalize()
                }
            }

            let count_r = conn.query_scalar_i64("SELECT COUNT(*) FROM tml_test_stmt_reset")
            when count_r {
                Err(_) => {
                    assert(false, "count query failed")
                    let _ = conn.execute("DROP TABLE IF EXISTS tml_test_stmt_reset")
                    conn.close()
                    return 1
                },
                Ok(count) => {
                    assert_eq(count, 2, "both rows (id=1 and id=2) should exist after reset+rebind")
                }
            }

            let _ = conn.execute("DROP TABLE tml_test_stmt_reset")
            conn.close()
            return 0
        }
    }
}

/// PgStatement: finalize releases server-side prepared statement.
@test @slow_test
func test_stmt_finalize() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT 1::BIGINT AS n", 0)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare failed")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let exec_r = stmt.execute_query()
                    when exec_r {
                        Err(_) => {
                            assert(false, "execute_query failed")
                            stmt.finalize()
                            conn.close()
                            return 1
                        },
                        Ok(_) => {}
                    }

                    let has_row = stmt.step()
                    assert(has_row, "should have one row")
                    let n = stmt.column_i64(0)
                    assert_eq(n, 1, "SELECT 1 should return 1")

                    // finalize() should not crash and should deallocate the server statement
                    stmt.finalize()
                    // Connection should still be usable after finalize
                    let check_r = conn.query_scalar_i64("SELECT 2")
                    when check_r {
                        Err(_) => {
                            assert(false, "connection should still work after stmt finalize")
                            conn.close()
                            return 1
                        },
                        Ok(val) => {
                            assert_eq(val, 2, "connection should return 2 after stmt finalize")
                        }
                    }
                }
            }

            conn.close()
            return 0
        }
    }
}

/// column_is_null returns false for non-null column.
@test @slow_test
func test_stmt_column_not_null() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELECT 42::BIGINT AS n", 0)
            when stmt_r {
                Err(_) => {
                    assert(false, "prepare failed")
                    conn.close()
                    return 1
                },
                Ok(mut stmt) => {
                    let exec_r = stmt.execute_query()
                    when exec_r {
                        Err(_) => { assert(false, "execute_query failed") },
                        Ok(_) => {}
                    }
                    let has_row = stmt.step()
                    assert(has_row, "should have a row")

                    let is_null = stmt.column_is_null(0)
                    assert(not is_null, "column_is_null should be false for non-null value")

                    stmt.finalize()
                }
            }

            conn.close()
            return 0
        }
    }
}

/// PgStatement::prepare with invalid SQL returns Err.
@test @slow_test
func test_stmt_prepare_bad_sql() -> I32 {
    let result = PgConnection::connect(database_url())
    when result {
        Err(_) => {
            assert(false, "connection failed")
            return 1
        },
        Ok(mut conn) => {
            let stmt_r = PgStatement::prepare(conn.raw_handle(), "SELEKT from nonsense !!!", 0)
            when stmt_r {
                Err(_) => {
                    // Expected — bad SQL for prepare
                    conn.close()
                    return 0
                },
                Ok(mut stmt) => {
                    assert(false, "prepare with invalid SQL should return Err")
                    stmt.finalize()
                    conn.close()
                    return 1
                }
            }
        }
    }
}
