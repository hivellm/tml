//! Raw FFI bindings to libpq (PostgreSQL C client library).
//!
//! These are low-level bindings — prefer [`PgConnection`] and [`PgStatement`]
//! for safe, high-level access.
//!
//! All opaque C pointers (PGconn*, PGresult*) are represented as `*Unit`.
//! String parameters use `Str` (TML handles null-termination automatically).
//! String returns from libpq use `Str` as well.

// ============================================================================
// Connection Management
// ============================================================================

/// Establishes a new connection to a PostgreSQL server.
///
/// `conninfo` is a connection string (e.g.
/// `"host=localhost port=5432 dbname=mydb user=myuser password=secret"`
/// or a URI like `"postgresql://user:pass@host:5432/db"`).
///
/// Returns a non-null `PGconn*` handle even on failure — call `PQstatus()`
/// to check whether the connection was actually established.
@extern("c")
pub func PQconnectdb(conninfo: Str) -> *Unit

/// Returns the status of the connection.
///
/// Returns `CONNECTION_OK` (0) if the connection is good,
/// `CONNECTION_BAD` (1) if the connection failed.
@extern("c")
pub func PQstatus(conn: *Unit) -> I32

/// Closes the connection and frees the `PGconn` object.
///
/// After calling this, the `conn` pointer is invalid and must not be used.
@extern("c")
pub func PQfinish(conn: *Unit)

/// Returns the error message most recently generated by an operation on
/// the connection.
///
/// The returned string is owned by libpq and valid until the next
/// operation on the same connection.
@extern("c")
pub func PQerrorMessage(conn: *Unit) -> Str

/// Returns the server version as an integer (e.g. 150000 for 15.0).
@extern("c")
pub func PQserverVersion(conn: *Unit) -> I32

/// Returns the protocol version used by the connection (normally 3).
@extern("c")
pub func PQprotocolVersion(conn: *Unit) -> I32

/// Resets the communication channel to the server.
///
/// Closes and re-opens the connection using the same connection
/// parameters. Useful for recovering from errors.
@extern("c")
pub func PQreset(conn: *Unit)

// ============================================================================
// Query Execution
// ============================================================================

/// Submits a SQL command to the server and waits for the result.
///
/// Returns a `PGresult*` handle. The caller MUST call `PQclear()` on the
/// result when done.  Returns null only if out of memory.
@extern("c")
pub func PQexec(conn: *Unit, query: Str) -> *Unit

/// Submits a parameterized SQL command.
///
/// Parameters:
/// - `command`: SQL text with `$1`, `$2`, ... placeholders
/// - `nParams`: number of parameters
/// - `paramTypes`: array of OIDs (pass null for automatic type inference)
/// - `paramValues`: array of C string pointers (null = SQL NULL)
/// - `paramLengths`: array of parameter lengths (ignored for text format)
/// - `paramFormats`: array of format codes (0=text, 1=binary; null=all text)
/// - `resultFormat`: 0 for text results, 1 for binary
@extern("c")
pub func PQexecParams(conn: *Unit, command: Str, nParams: I32, paramTypes: *Unit, paramValues: *Unit, paramLengths: *Unit, paramFormats: *Unit, resultFormat: I32) -> *Unit

/// Creates a prepared statement for later execution.
///
/// - `stmtName`: name for the prepared statement (empty string for unnamed)
/// - `query`: SQL text with `$1`, `$2`, ... placeholders
/// - `nParams`: number of parameters
/// - `paramTypes`: array of OIDs (pass null for automatic inference)
@extern("c")
pub func PQprepare(conn: *Unit, stmtName: Str, query: Str, nParams: I32, paramTypes: *Unit) -> *Unit

/// Executes a previously prepared statement.
///
/// - `stmtName`: name of the prepared statement
/// - `nParams`: number of parameters
/// - `paramValues`: array of C string pointers (null = SQL NULL)
/// - `paramLengths`: array of parameter lengths
/// - `paramFormats`: array of format codes
/// - `resultFormat`: 0 for text results, 1 for binary
@extern("c")
pub func PQexecPrepared(conn: *Unit, stmtName: Str, nParams: I32, paramValues: *Unit, paramLengths: *Unit, paramFormats: *Unit, resultFormat: I32) -> *Unit

/// Requests that the server abandon processing of the current query.
@extern("c")
pub func PQcancelRequest(conn: *Unit) -> I32

// ============================================================================
// Result Inspection
// ============================================================================

/// Returns the result status of a command.
///
/// Common return values:
/// - `PGRES_COMMAND_OK` (1): successful non-query command
/// - `PGRES_TUPLES_OK` (2): successful query with rows
/// - `PGRES_FATAL_ERROR` (7): query failed
@extern("c")
pub func PQresultStatus(result: *Unit) -> I32

/// Returns the number of rows (tuples) in the result.
@extern("c")
pub func PQntuples(result: *Unit) -> I32

/// Returns the number of columns (fields) in each row of the result.
@extern("c")
pub func PQnfields(result: *Unit) -> I32

/// Returns the value of a single field (row, column) as a C string.
///
/// Row and column indices are 0-based.  Returns an empty string for
/// NULL values — use `PQgetisnull()` to distinguish empty from NULL.
@extern("c")
pub func PQgetvalue(result: *Unit, row: I32, col: I32) -> Str

/// Tests whether a field is NULL.
///
/// Returns 1 if the field is NULL, 0 otherwise.
@extern("c")
pub func PQgetisnull(result: *Unit, row: I32, col: I32) -> I32

/// Returns the column name for the given 0-based column index.
@extern("c")
pub func PQfname(result: *Unit, col: I32) -> Str

/// Returns the OID of the data type of the given column.
@extern("c")
pub func PQftype(result: *Unit, col: I32) -> I32

/// Returns the column number (0-based) associated with the given column name.
///
/// Returns -1 if the name does not match any column.
@extern("c")
pub func PQfnumber(result: *Unit, col_name: Str) -> I32

/// Returns the number of rows affected by an INSERT, UPDATE, or DELETE.
///
/// Returns the string representation of the count (e.g. `"5"`).
/// For other commands, returns an empty string.
@extern("c")
pub func PQcmdTuples(result: *Unit) -> Str

/// Returns the error message associated with the result, or an empty
/// string if there was no error.
@extern("c")
pub func PQresultErrorMessage(result: *Unit) -> Str

/// Returns a specific field of an error report.
///
/// `fieldcode` is a single character: 'S' (severity), 'V' (severity
/// non-localized), 'C' (SQLSTATE code), 'M' (message), 'D' (detail),
/// 'H' (hint), etc.
@extern("c")
pub func PQresultErrorField(result: *Unit, fieldcode: I32) -> Str

/// Frees the storage associated with a `PGresult`.
///
/// Every `PGresult*` returned by libpq MUST be freed with this function
/// when no longer needed.
@extern("c")
pub func PQclear(result: *Unit)

// ============================================================================
// Result Status Constants
// ============================================================================

/// The query string was empty.
pub const PGRES_EMPTY_QUERY: I32 = 0

/// Successful completion of a command that does not return data.
pub const PGRES_COMMAND_OK: I32 = 1

/// Successful completion of a command returning data (e.g. SELECT).
pub const PGRES_TUPLES_OK: I32 = 2

/// Copy Out (from server) data transfer started.
pub const PGRES_COPY_OUT: I32 = 3

/// Copy In (to server) data transfer started.
pub const PGRES_COPY_IN: I32 = 4

/// The server's response was not understood.
pub const PGRES_BAD_RESPONSE: I32 = 5

/// A nonfatal error (notice or warning) occurred.
pub const PGRES_NONFATAL_ERROR: I32 = 6

/// A fatal error occurred.
pub const PGRES_FATAL_ERROR: I32 = 7

/// Copy Both transfer (used in replication).
pub const PGRES_COPY_BOTH: I32 = 8

/// Single tuple from larger result set (pipeline mode).
pub const PGRES_SINGLE_TUPLE: I32 = 9

// ============================================================================
// Connection Status Constants
// ============================================================================

/// The connection was successfully established.
pub const CONNECTION_OK: I32 = 0

/// The connection attempt failed.
pub const CONNECTION_BAD: I32 = 1

// ============================================================================
// Transaction Status
// ============================================================================

/// Returns the current in-transaction status of the server.
///
/// Returns one of:
/// - `PQTRANS_IDLE` (0): connection idle, not in transaction
/// - `PQTRANS_ACTIVE` (1): command in progress
/// - `PQTRANS_INTRANS` (2): idle, in a valid transaction block
/// - `PQTRANS_INERROR` (3): idle, in a failed transaction block
/// - `PQTRANS_UNKNOWN` (4): connection bad
@extern("c")
pub func PQtransactionStatus(conn: *Unit) -> I32

/// Connection idle.
pub const PQTRANS_IDLE: I32 = 0

/// Command in progress.
pub const PQTRANS_ACTIVE: I32 = 1

/// Idle, in valid transaction block.
pub const PQTRANS_INTRANS: I32 = 2

/// Idle, in failed transaction block.
pub const PQTRANS_INERROR: I32 = 3

/// Cannot determine status (connection bad).
pub const PQTRANS_UNKNOWN: I32 = 4

// ============================================================================
// Escaping
// ============================================================================

/// Escapes a string for use as a SQL string literal.
///
/// Returns a freshly allocated string that must be freed with `PQfreemem()`.
@extern("c")
pub func PQescapeLiteral(conn: *Unit, str: Str, length: I64) -> Str

/// Escapes a string for use as a SQL identifier (e.g. table name).
///
/// Returns a freshly allocated string that must be freed with `PQfreemem()`.
@extern("c")
pub func PQescapeIdentifier(conn: *Unit, str: Str, length: I64) -> Str

/// Frees memory allocated by libpq functions (e.g. PQescapeLiteral).
@extern("c")
pub func PQfreemem(ptr: *Unit)

// ============================================================================
// Miscellaneous
// ============================================================================

/// Returns the integer version of the libpq library being used.
///
/// Format: major * 10000 + minor * 100 + patch (e.g. 150002 for 15.0.2).
@extern("c")
pub func PQlibVersion() -> I32
