// Tests for test::coverage — assert_coverage_percent, assert_func_covered
use test::{assert, assert_eq}
use test::coverage::{assert_coverage_percent, get_coverage_percent, get_covered_func_count}

@test
func test_assert_coverage_percent_zero() -> I32 {
    // 0% threshold should always pass
    assert_coverage_percent(0, "zero threshold always passes")
    return 0
}

@test
func test_get_coverage_percent() -> I32 {
    let pct: I32 = get_coverage_percent()
    assert(pct >= 0, "coverage percent should be non-negative")
    return 0
}

@test
func test_get_covered_func_count() -> I32 {
    let count: I32 = get_covered_func_count()
    assert(count >= 0, "covered func count should be non-negative")
    return 0
}
