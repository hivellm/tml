// Tests for report module — color print functions
use test::{assert}
use test::report::{print_colored, print_green, print_red, print_yellow, print_bold}

@test
func test_print_colored_pass() -> I32 {
    print_colored("PASS", true)
    assert(true, "print_colored with passed=true should not crash")
    return 0
}

@test
func test_print_colored_fail() -> I32 {
    print_colored("FAIL", false)
    assert(true, "print_colored with passed=false should not crash")
    return 0
}

@test
func test_print_green() -> I32 {
    print_green("green text")
    assert(true, "print_green should not crash")
    return 0
}

@test
func test_print_red() -> I32 {
    print_red("red text")
    assert(true, "print_red should not crash")
    return 0
}

@test
func test_print_yellow() -> I32 {
    print_yellow("yellow text")
    assert(true, "print_yellow should not crash")
    return 0
}

@test
func test_print_bold() -> I32 {
    print_bold("bold text")
    assert(true, "print_bold should not crash")
    return 0
}
