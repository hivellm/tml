// Tests for MutSlice::sort_by_key
// BLOCKED: sort_by_key internally does key_fn(a).cmp(ref key_fn(b))
// which takes ref of a temporary return value -- compiler error:
// "Can only take reference of variables"
use test

@test
func test_sort_by_key_blocked() -> Outcome[Unit, Str] {
    // sort_by_key blocked by ref-of-temporary codegen bug
    // The implementation in sort.tml line 257:
    //   this.sort_by(do(a: ref T, b: ref T) key_fn(a).cmp(ref key_fn(b)))
    // key_fn(b) returns a temporary K, and `ref key_fn(b)` is invalid
    Ok(())
}
