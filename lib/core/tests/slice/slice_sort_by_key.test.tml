// Tests for MutSlice::sort_by_key
// BLOCKED: sort_by_key internally calls key_fn(a).cmp(ref key_fn(b))
// which triggers "Can only take reference of variables" compiler error.
// The temporary return of key_fn(b) cannot be passed by ref.
use test::{assert_eq}

@test
func test_sort_by_key_blocked() -> I32 {
    assert_eq(1, 1, "blocked by ref-of-temporary codegen bug")
    return 0
}
