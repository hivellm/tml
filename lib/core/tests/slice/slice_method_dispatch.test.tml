// Test cross-file method dispatch for slice iter methods
// Covers: Slice::chunks, Slice::chunks_exact, Slice::windows, Slice::iter
use test
use core::slice::{Slice}

@test
func test_slice_chunks_method() -> Outcome[Unit, Str] {
    let ptr: *Unit = alloc(12)
    atomic_store(ptr, 1)
    atomic_store(ptr_offset(ptr, 4), 2)
    atomic_store(ptr_offset(ptr, 8), 3)

    let s: Slice[I32] = Slice { data: ptr, len: 3 }
    let mut iter = s.chunks(2)

    let mut count: I32 = 0
    when iter.next() {
        Just(_) => { count = count + 1 },
        Nothing => {}
    }
    when iter.next() {
        Just(_) => { count = count + 1 },
        Nothing => {}
    }
    assert_eq(count, 2)

    dealloc(ptr)
    Ok(())
}

@test
func test_slice_chunks_exact_method() -> Outcome[Unit, Str] {
    let ptr: *Unit = alloc(20)
    atomic_store(ptr, 1)
    atomic_store(ptr_offset(ptr, 4), 2)
    atomic_store(ptr_offset(ptr, 8), 3)
    atomic_store(ptr_offset(ptr, 12), 4)
    atomic_store(ptr_offset(ptr, 16), 5)

    let s: Slice[I32] = Slice { data: ptr, len: 5 }
    let mut iter = s.chunks_exact(2)

    let mut count: I32 = 0
    when iter.next() {
        Just(chunk) => {
            assert_eq(chunk.len(), 2)
            count = count + 1
        },
        Nothing => {}
    }
    when iter.next() {
        Just(chunk) => {
            assert_eq(chunk.len(), 2)
            count = count + 1
        },
        Nothing => {}
    }
    // Third chunk should be Nothing (5 not evenly divisible by 2)
    let mut got_nothing: Bool = false
    when iter.next() {
        Just(_) => {},
        Nothing => { got_nothing = true }
    }
    assert_eq(count, 2)
    assert_true(got_nothing)

    let rem = iter.remainder()
    assert_eq(rem.len(), 1)

    dealloc(ptr)
    Ok(())
}

@test
func test_slice_windows_method() -> Outcome[Unit, Str] {
    let ptr: *Unit = alloc(16)
    atomic_store(ptr, 1)
    atomic_store(ptr_offset(ptr, 4), 2)
    atomic_store(ptr_offset(ptr, 8), 3)
    atomic_store(ptr_offset(ptr, 12), 4)

    let s: Slice[I32] = Slice { data: ptr, len: 4 }
    let mut iter = s.windows(2)

    let mut count: I32 = 0
    when iter.next() {
        Just(w) => {
            assert_eq(w.len(), 2)
            count = count + 1
        },
        Nothing => {}
    }
    when iter.next() {
        Just(w) => {
            assert_eq(w.len(), 2)
            count = count + 1
        },
        Nothing => {}
    }
    when iter.next() {
        Just(w) => {
            assert_eq(w.len(), 2)
            count = count + 1
        },
        Nothing => {}
    }
    let mut got_nothing: Bool = false
    when iter.next() {
        Just(_) => {},
        Nothing => { got_nothing = true }
    }
    assert_eq(count, 3)
    assert_true(got_nothing)

    dealloc(ptr)
    Ok(())
}

@test
func test_slice_iter_method() -> Outcome[Unit, Str] {
    let ptr: *Unit = alloc(12)
    atomic_store(ptr, 10)
    atomic_store(ptr_offset(ptr, 4), 20)
    atomic_store(ptr_offset(ptr, 8), 30)

    let s: Slice[I32] = Slice { data: ptr, len: 3 }
    let mut iter = s.iter()

    assert_eq(iter.len(), 3)
    assert_true(iter.is_empty() == false)

    let mut count: I32 = 0
    when iter.next() {
        Just(_) => { count = count + 1 },
        Nothing => {}
    }
    when iter.next() {
        Just(_) => { count = count + 1 },
        Nothing => {}
    }
    when iter.next() {
        Just(_) => { count = count + 1 },
        Nothing => {}
    }
    assert_eq(count, 3)
    assert_true(iter.is_empty())

    dealloc(ptr)
    Ok(())
}
