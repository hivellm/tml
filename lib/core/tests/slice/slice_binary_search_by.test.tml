// Tests for Slice::binary_search_by
use test::{assert, assert_eq}
use core::slice::Slice

func compare_to_5(elem: ref I32) -> Ordering {
    return elem.cmp(ref 5)
}

@test
func test_binary_search_by_found() -> I32 {
    let ptr: *Unit = alloc(5)
    atomic_store(ptr, 1)
    atomic_store(ptr_offset(ptr, 1), 3)
    atomic_store(ptr_offset(ptr, 2), 5)
    atomic_store(ptr_offset(ptr, 3), 7)
    atomic_store(ptr_offset(ptr, 4), 9)

    let slice: Slice[I32] = Slice::from_raw(ptr, 5)
    let result: Outcome[I64, I64] = slice.binary_search_by(compare_to_5)
    assert(result.is_ok(), "should find 5")
    assert_eq(result.unwrap(), 2, "5 is at index 2")

    dealloc(ptr)
    return 0
}

func compare_to_4(elem: ref I32) -> Ordering {
    return elem.cmp(ref 4)
}

@test
func test_binary_search_by_not_found() -> I32 {
    let ptr: *Unit = alloc(5)
    atomic_store(ptr, 1)
    atomic_store(ptr_offset(ptr, 1), 3)
    atomic_store(ptr_offset(ptr, 2), 5)
    atomic_store(ptr_offset(ptr, 3), 7)
    atomic_store(ptr_offset(ptr, 4), 9)

    let slice: Slice[I32] = Slice::from_raw(ptr, 5)
    let result: Outcome[I64, I64] = slice.binary_search_by(compare_to_4)
    assert(result.is_err(), "should not find 4")
    assert_eq(result.unwrap_err(), 2, "4 would be at index 2")

    dealloc(ptr)
    return 0
}
