// Tests for SliceIter (slice/iter module)
use test
use core::slice::{Slice, SliceIter}

@test
func test_slice_iter_len() -> Outcome[Unit, Str] {
    let ptr: *Unit = alloc(12)
    atomic_store(ptr, 10)
    atomic_store(ptr_offset(ptr, 4), 20)
    atomic_store(ptr_offset(ptr, 8), 30)

    let s: Slice[I32] = Slice { data: ptr, len: 3 }
    let iter = SliceIter { slice: s, index: 0 }

    assert_eq(iter.len(), 3)
    assert_true(iter.is_empty() == false)

    dealloc(ptr)
    Ok(())
}

@test
func test_slice_iter_empty() -> Outcome[Unit, Str] {
    let ptr: *Unit = alloc(4)
    let s: Slice[I32] = Slice { data: ptr, len: 0 }
    let iter = SliceIter { slice: s, index: 0 }

    assert_eq(iter.len(), 0)
    assert_true(iter.is_empty())

    dealloc(ptr)
    Ok(())
}

@test
func test_slice_iter_as_slice() -> Outcome[Unit, Str] {
    let ptr: *Unit = alloc(12)
    atomic_store(ptr, 10)
    atomic_store(ptr_offset(ptr, 4), 20)
    atomic_store(ptr_offset(ptr, 8), 30)

    let s: Slice[I32] = Slice { data: ptr, len: 3 }
    // Start at index 1, so as_slice should give remaining 2 elements
    let iter = SliceIter { slice: s, index: 1 }
    let remaining = iter.as_slice()
    assert_eq(remaining.len(), 2)

    dealloc(ptr)
    Ok(())
}
