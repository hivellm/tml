// Test: Ready[I32] creation via ready() function
use test::{assert_eq}
use core::future::{ready, Ready}

@test
func test_ready_creation() -> I32 {
    // Verify Ready[I32] can be constructed via ready()
    let f: Ready[I32] = ready[I32](42)
    // Type compiles correctly — Ready wraps Maybe[T]
    assert_eq(0, 0, "Ready[I32] constructed successfully")
    return 0
}
