// Tests for core::convert — widening From conversions
// NOTE: These call the From impls and work correctly, but the coverage tool
// does not register them as covered. The functions ARE emitted in IR (verified)
// and ARE called at runtime. This is a coverage tool name-matching limitation:
// multiple From impls (I8->I16, I8->I32, Bool->I32, etc.) all share the same
// method name "from" and the tracker cannot disambiguate them.
//
// Uncoverable by coverage tool: I16::from, I32::from, I64::from,
//   U16::from, U32::from, U64::from, F64::from
// Blocked by codegen: Outcome::from (generic E not resolved)
use test::{assert, assert_eq}
use core::traits::convert::From

@test
func test_i16_from_i8() -> I32 {
    let src: I8 = 42 as I8
    let v: I16 = I16::from(src)
    assert_eq(v as I64, 42, "I16::from(I8)")
    return 0
}

@test
func test_i32_from_i16() -> I32 {
    let src: I16 = 1000 as I16
    let v: I32 = I32::from(src)
    assert_eq(v as I64, 1000, "I32::from(I16)")
    return 0
}

@test
func test_i64_from_i32() -> I32 {
    let src: I32 = 999999
    let v: I64 = I64::from(src)
    assert_eq(v, 999999, "I64::from(I32)")
    return 0
}

@test
func test_u16_from_u8() -> I32 {
    let src: U8 = 200 as U8
    let v: U16 = U16::from(src)
    assert_eq(v as I64, 200, "U16::from(U8)")
    return 0
}

@test
func test_u32_from_u16() -> I32 {
    let src: U16 = 50000 as U16
    let v: U32 = U32::from(src)
    assert_eq(v as I64, 50000, "U32::from(U16)")
    return 0
}

@test
func test_u64_from_u32() -> I32 {
    let src: U32 = 3000000000 as U32
    let v: U64 = U64::from(src)
    assert_eq(v as I64, 3000000000, "U64::from(U32)")
    return 0
}

@test
func test_f64_from_f32() -> I32 {
    let src: F32 = 2.5 as F32
    let v: F64 = F64::from(src)
    assert(v > 2.4 and v < 2.6, "F64::from(F32)")
    return 0
}
