// Tests for TryFrom signed/unsigned cross conversions
use test::{assert, assert_eq}
use core::convert::{TryFrom, TryFromIntError}

@test
func test_tryfrom_i8_to_u8_ok() -> I32 {
    let result: Outcome[U8, TryFromIntError] = U8::try_from(42 as I8)
    assert(result.is_ok(), "positive I8 fits in U8")
    return 0
}

@test
func test_tryfrom_i8_to_u8_negative() -> I32 {
    let result: Outcome[U8, TryFromIntError] = U8::try_from(-1 as I8)
    assert(result.is_err(), "negative I8 fails for U8")
    return 0
}

@test
func test_tryfrom_i16_to_u16_ok() -> I32 {
    let result: Outcome[U16, TryFromIntError] = U16::try_from(1000 as I16)
    assert(result.is_ok(), "positive I16 fits in U16")
    return 0
}

@test
func test_tryfrom_i16_to_u16_negative() -> I32 {
    let result: Outcome[U16, TryFromIntError] = U16::try_from(-1 as I16)
    assert(result.is_err(), "negative I16 fails for U16")
    return 0
}

@test
func test_tryfrom_u8_to_i8_ok() -> I32 {
    let result: Outcome[I8, TryFromIntError] = I8::try_from(100 as U8)
    assert(result.is_ok(), "100 fits in I8")
    return 0
}

@test
func test_tryfrom_u8_to_i8_overflow() -> I32 {
    let result: Outcome[I8, TryFromIntError] = I8::try_from(200 as U8)
    assert(result.is_err(), "200 overflows I8")
    return 0
}

@test
func test_tryfrom_u16_to_i16_ok() -> I32 {
    let result: Outcome[I16, TryFromIntError] = I16::try_from(30000 as U16)
    assert(result.is_ok(), "30000 fits in I16")
    return 0
}

@test
func test_tryfrom_u16_to_i16_overflow() -> I32 {
    let result: Outcome[I16, TryFromIntError] = I16::try_from(40000 as U16)
    assert(result.is_err(), "40000 overflows I16")
    return 0
}

@test
func test_tryfrom_u32_to_i32_ok() -> I32 {
    let result: Outcome[I32, TryFromIntError] = I32::try_from(1000000 as U32)
    assert(result.is_ok(), "1000000 fits in I32")
    return 0
}

@test
func test_tryfrom_u32_to_i32_overflow() -> I32 {
    let result: Outcome[I32, TryFromIntError] = I32::try_from(3000000000 as U32)
    assert(result.is_err(), "3 billion overflows I32")
    return 0
}

@test
func test_tryfrom_u64_to_i64_ok() -> I32 {
    let result: Outcome[I64, TryFromIntError] = I64::try_from(1000 as U64)
    assert(result.is_ok(), "1000 fits in I64")
    return 0
}
