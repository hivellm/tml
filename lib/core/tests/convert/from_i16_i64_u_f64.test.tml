// Tests for uncovered From widening conversions
use test::{assert, assert_eq}
use core::convert::From

@test
func test_from_i8_to_i16() -> I32 {
    let v: I16 = I16::from(42 as I8)
    assert_eq(v, 42 as I16, "I8 to I16")
    return 0
}

@test
func test_from_i8_to_i64() -> I32 {
    let v: I64 = I64::from(42 as I8)
    assert_eq(v, 42 as I64, "I8 to I64")
    return 0
}

@test
func test_from_i16_to_i64() -> I32 {
    let v: I64 = I64::from(1000 as I16)
    assert_eq(v, 1000 as I64, "I16 to I64")
    return 0
}

@test
func test_from_u8_to_u16() -> I32 {
    let v: U16 = U16::from(200 as U8)
    assert_eq(v, 200 as U16, "U8 to U16")
    return 0
}

@test
func test_from_u8_to_u32() -> I32 {
    let v: U32 = U32::from(200 as U8)
    assert_eq(v, 200 as U32, "U8 to U32")
    return 0
}

@test
func test_from_u8_to_u64() -> I32 {
    let v: U64 = U64::from(200 as U8)
    assert_eq(v, 200 as U64, "U8 to U64")
    return 0
}

@test
func test_from_u16_to_u32() -> I32 {
    let v: U32 = U32::from(50000 as U16)
    assert_eq(v, 50000 as U32, "U16 to U32")
    return 0
}

@test
func test_from_u16_to_u64() -> I32 {
    let v: U64 = U64::from(50000 as U16)
    assert_eq(v, 50000 as U64, "U16 to U64")
    return 0
}

@test
func test_from_u32_to_u64() -> I32 {
    let v: U64 = U64::from(3000000 as U32)
    assert_eq(v, 3000000 as U64, "U32 to U64")
    return 0
}

@test
func test_from_f32_to_f64() -> I32 {
    let v: F64 = F64::from(3.14 as F32)
    assert(v > 3.13 and v < 3.15, "F32 to F64")
    return 0
}
