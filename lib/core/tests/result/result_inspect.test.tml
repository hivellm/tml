// Tests for Outcome::inspect and inspect_err
use test::{assert}

func ok_inspector(x: ref I32) {}
func err_inspector(x: ref Str) {}

@test
func test_outcome_inspect_ok() -> I32 {
    let x: Outcome[I32, Str] = Ok(42)
    let y = x.inspect(ok_inspector)
    assert(y.is_ok(), "inspect should pass through Ok")
    return 0
}

@test
func test_outcome_inspect_err() -> I32 {
    let x: Outcome[I32, Str] = Err("oops")
    let y = x.inspect(ok_inspector)
    assert(y.is_err(), "inspect on Err should pass through Err")
    return 0
}

@test
func test_outcome_inspect_err_method() -> I32 {
    let x: Outcome[I32, Str] = Err("fail")
    let y = x.inspect_err(err_inspector)
    assert(y.is_err(), "inspect_err should pass through Err")
    return 0
}

@test
func test_outcome_inspect_err_on_ok() -> I32 {
    let x: Outcome[I32, Str] = Ok(10)
    let y = x.inspect_err(err_inspector)
    assert(y.is_ok(), "inspect_err on Ok should pass through Ok")
    return 0
}
