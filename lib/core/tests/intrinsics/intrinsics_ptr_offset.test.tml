// Tests for ptr_offset intrinsic
use test::{assert, assert_eq}
use core::intrinsics::{ptr_read, ptr_write, ptr_offset}

@test
func test_ptr_offset_i32() -> I32 {
    let ptr: *Unit = alloc(16)
    let p0: *I32 = ptr as *I32
    ptr_write[I32](p0, 10)
    let p1: *I32 = ptr_offset[I32](p0, 1 as I64)
    ptr_write[I32](p1, 20)
    let p2: *I32 = ptr_offset[I32](p0, 2 as I64)
    ptr_write[I32](p2, 30)
    let p3: *I32 = ptr_offset[I32](p0, 3 as I64)
    ptr_write[I32](p3, 40)
    assert_eq(ptr_read[I32](p0), 10, "elem 0")
    assert_eq(ptr_read[I32](p1), 20, "elem 1")
    assert_eq(ptr_read[I32](p2), 30, "elem 2")
    assert_eq(ptr_read[I32](p3), 40, "elem 3")
    dealloc(ptr)
    return 0
}

@test
func test_ptr_offset_zero() -> I32 {
    let ptr: *Unit = alloc(4)
    let p: *I32 = ptr as *I32
    ptr_write[I32](p, 99)
    let same: *I32 = ptr_offset[I32](p, 0 as I64)
    assert_eq(ptr_read[I32](same), 99, "offset 0 reads same value")
    dealloc(ptr)
    return 0
}

@test
func test_ptr_offset_u8() -> I32 {
    let ptr: *Unit = alloc(4)
    let p0: *U8 = ptr as *U8
    ptr_write[U8](p0, 0x41 as U8)
    let p1: *U8 = ptr_offset[U8](p0, 1 as I64)
    ptr_write[U8](p1, 0x42 as U8)
    let p2: *U8 = ptr_offset[U8](p0, 2 as I64)
    ptr_write[U8](p2, 0x43 as U8)
    assert_eq(ptr_read[U8](p0) as I32, 0x41, "byte 0")
    assert_eq(ptr_read[U8](p1) as I32, 0x42, "byte 1")
    assert_eq(ptr_read[U8](p2) as I32, 0x43, "byte 2")
    dealloc(ptr)
    return 0
}
