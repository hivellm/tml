// Tests for array intrinsics: array_as_ptr
// Exercised through Array's as_slice() method.
//
// BLOCKED: array_as_mut_ptr — calling methods on MutSlice from as_mut_slice()
// generates invalid IR (passes { ptr, i64 } as ptr).
// BLOCKED: array_offset_ptr/array_offset_mut_ptr — ArrayIter.as_slice()
// crashes at runtime (access violation in array_offset_ptr).
use test::{assert, assert_eq}

// ============================================================================
// array_as_ptr — exercised via Array.as_slice()
// ============================================================================

@test
func test_array_as_ptr_via_as_slice() -> I32 {
    let arr: [I32; 4] = [10, 20, 30, 40]
    let s = arr.as_slice()
    assert_eq(s.len(), 4 as I64, "slice len should be 4")
    assert_eq(s[0], 10, "s[0] should be 10")
    assert_eq(s[1], 20, "s[1] should be 20")
    assert_eq(s[2], 30, "s[2] should be 30")
    assert_eq(s[3], 40, "s[3] should be 40")
    return 0
}

@test
func test_array_as_ptr_single_element() -> I32 {
    let arr: [I64; 1] = [42 as I64]
    let s = arr.as_slice()
    assert_eq(s.len(), 1 as I64, "single element slice len")
    assert_eq(s[0], 42 as I64, "single element value")
    return 0
}

@test
func test_array_as_ptr_slice_contains() -> I32 {
    let arr: [I32; 5] = [1, 2, 3, 4, 5]
    let s = arr.as_slice()
    // Verify that the slice sees the correct memory via array_as_ptr
    assert_eq(s[0], 1, "first element")
    assert_eq(s[4], 5, "last element")
    return 0
}
