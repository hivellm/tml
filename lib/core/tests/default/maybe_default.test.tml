// Tests for Maybe[T]::default — returns Nothing
use test::{assert, assert_eq}

@test
func test_maybe_i32_default_is_nothing() -> I32 {
    let m: Maybe[I32] = Maybe::default()
    assert(m.is_nothing(), "Maybe[I32]::default should be Nothing")
    return 0
}

@test
func test_maybe_bool_default_is_nothing() -> I32 {
    let m: Maybe[Bool] = Maybe::default()
    assert(m.is_nothing(), "Maybe[Bool]::default should be Nothing")
    return 0
}

@test
func test_maybe_i64_default_is_nothing() -> I32 {
    let m: Maybe[I64] = Maybe::default()
    assert(m.is_nothing(), "Maybe[I64]::default should be Nothing")
    return 0
}
