// Tests for Maybe[T] Default impl
use test::{assert, assert_eq}

@test
func test_maybe_i32_default() -> I32 {
    let x: Maybe[I32] = Maybe[I32]::default()
    assert(x.is_nothing(), "Maybe[I32]::default() = Nothing")
    return 0
}

@test
func test_maybe_bool_default() -> I32 {
    let x: Maybe[Bool] = Maybe[Bool]::default()
    assert(x.is_nothing(), "Maybe[Bool]::default() = Nothing")
    return 0
}

@test
func test_maybe_i64_default() -> I32 {
    let x: Maybe[I64] = Maybe[I64]::default()
    assert(x.is_nothing(), "Maybe[I64]::default() = Nothing")
    return 0
}
