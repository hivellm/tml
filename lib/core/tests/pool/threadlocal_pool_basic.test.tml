// Tests for ThreadLocalPool[T] — basic operations
use test::{assert, assert_eq}
use core::data::pool::{ThreadLocalPool, PoolStats}

@test
func test_threadlocal_pool_new() -> I32 {
    var pool: ThreadLocalPool[I32] = ThreadLocalPool::new[I32](8)
    assert_eq(pool.available(), 8, "initial available should be 8")
    assert_eq(pool.in_use(), 0, "initial in_use should be 0")
    return 0
}

@test
func test_threadlocal_pool_default() -> I32 {
    var pool: ThreadLocalPool[I32] = ThreadLocalPool::default[I32]()
    assert_eq(pool.available(), 32, "default capacity should be 32")
    assert_eq(pool.in_use(), 0, "default in_use should be 0")
    return 0
}

@test
func test_threadlocal_pool_stats() -> I32 {
    let pool: ThreadLocalPool[I32] = ThreadLocalPool::new[I32](4)
    let s: PoolStats = pool.stats()
    assert_eq(s.capacity, 4, "stats capacity should be 4")
    assert_eq(s.available, 4, "stats available should be 4")
    assert_eq(s.in_use, 0, "stats in_use should be 0")
    assert_eq(s.grows, 1, "stats grows should be 1 from initial allocation")
    return 0
}
