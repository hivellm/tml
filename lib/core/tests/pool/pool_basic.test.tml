// Tests for Pool[T] basic operations
use test::{assert, assert_eq, assert_true}
use core::data::pool::{Pool, GrowthPolicy}

@test
func test_pool_new_doubling() -> I32 {
    var pool: Pool[I32] = Pool::new[I32](4, GrowthPolicy::Doubling)
    assert_eq(pool.capacity(), 4, "initial capacity should be 4")
    assert_eq(pool.available(), 4, "all should be available")
    assert_eq(pool.in_use(), 0, "none in use")
    return 0
}

@test
func test_pool_fixed() -> I32 {
    var pool: Pool[I32] = Pool::fixed[I32](8)
    assert_eq(pool.capacity(), 8, "fixed capacity should be 8")
    assert_eq(pool.available(), 8, "all should be available")
    return 0
}

@test
func test_pool_stats() -> I32 {
    let pool: Pool[I32] = Pool::new[I32](4, GrowthPolicy::Doubling)
    let s = pool.stats()
    assert_eq(s.total_allocations, 0, "no allocations yet")
    return 0
}
