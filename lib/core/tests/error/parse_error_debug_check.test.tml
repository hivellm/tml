// Tests for ParseError::with_position — display and debug output
use test::{assert, assert_eq}
use core::error::ParseError

@test
func test_with_position_display_format() -> I32 {
    let err = ParseError::with_position("bad digit", 3)
    let s: Str = err.to_string()
    assert_eq(s, "parse error at position 3: bad digit", "display with position")
    return 0
}

@test
func test_with_position_debug_has_type_and_message() -> I32 {
    let err = ParseError::with_position("invalid char", 7)
    let dbg: Str = err.debug_string()
    assert(dbg.contains("ParseError"), "debug should contain type name")
    assert(dbg.contains("invalid char"), "debug should contain message")
    return 0
}

@test
func test_with_position_zero() -> I32 {
    let err = ParseError::with_position("unexpected start", 0)
    let s: Str = err.to_string()
    assert(s.contains("position 0"), "should handle position 0")
    return 0
}
