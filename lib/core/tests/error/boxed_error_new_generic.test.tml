// Tests for BoxedError::new[E: Error] — generic constructor
use test::{assert, assert_eq}
use core::error::{BoxedError, SimpleError}

@test
func test_boxed_error_new_from_simple_error() -> I32 {
    let err = SimpleError::new("something went wrong")
    let boxed = BoxedError::new(err)
    assert_eq(boxed.to_string(), "something went wrong", "BoxedError::new preserves message")
    return 0
}

@test
func test_boxed_error_new_debug_string() -> I32 {
    let err = SimpleError::new("test")
    let boxed = BoxedError::new(err)
    let dbg = boxed.debug_string()
    assert_eq(dbg, "BoxedError { message: test }", "BoxedError::new debug_string")
    return 0
}
