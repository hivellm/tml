// Tests for Error::description default method and Error::source default method
use test
use core::error::{SimpleError, ParseError}

@test
func test_simple_error_description() -> I32 {
    let err: SimpleError = SimpleError::new("something broke")
    let desc: Str = err.description()
    assert_eq(desc, "something broke", "description should match to_string")
    return 0
}

@test
func test_simple_error_source_nothing() -> I32 {
    let err: SimpleError = SimpleError::new("no cause")
    let src = err.source()
    assert(src.is_nothing(), "SimpleError has no source")
    return 0
}

@test
func test_parse_error_description() -> I32 {
    let err: ParseError = ParseError::new("bad input")
    let desc: Str = err.description()
    assert(desc.len() > 0, "ParseError description should have content")
    return 0
}
