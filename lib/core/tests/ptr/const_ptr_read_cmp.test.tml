// Tests for RawPtr::read and RawPtr::cmp
use test::{assert, assert_eq}
use core::ptr::const_ptr::RawPtr

@test
func test_raw_ptr_read() -> I32 {
    let p: *Unit = alloc(4)
    atomic_store(p, 42)
    let raw: RawPtr[I32] = RawPtr::from_addr(p as I64)
    let val: I32 = raw.read()
    assert_eq(val, 42, "read should return stored value")
    dealloc(p)
    return 0
}

@test
func test_raw_ptr_cmp_equal() -> I32 {
    let a: RawPtr[I64] = RawPtr::from_addr(0x1000 as I64)
    let b: RawPtr[I64] = RawPtr::from_addr(0x1000 as I64)
    let ord = a.cmp(ref b)
    assert(ord.is_equal(), "same address should be Equal")
    return 0
}

@test
func test_raw_ptr_cmp_less() -> I32 {
    let a: RawPtr[I64] = RawPtr::from_addr(0x1000 as I64)
    let b: RawPtr[I64] = RawPtr::from_addr(0x2000 as I64)
    let ord = a.cmp(ref b)
    assert(ord.is_less(), "lower address should be Less")
    return 0
}
