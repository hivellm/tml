// Tests for ptr::ops — copy, copy_nonoverlapping, copy_mut, copy_nonoverlapping_mut
use test::{assert, assert_eq}
use core::ptr::{RawPtr, RawMutPtr}
use core::ptr::ops::{copy_nonoverlapping, copy, copy_mut, copy_nonoverlapping_mut}

@test
func test_copy_nonoverlapping() -> I32 {
    let src_buf = mem_alloc(16)
    let dst_buf = mem_alloc(16)
    let src: RawMutPtr[I64] = RawMutPtr::from_addr(src_buf as I64)
    let dst: RawMutPtr[I64] = RawMutPtr::from_addr(dst_buf as I64)
    src.write(42 as I64)
    src.add(1 as I64).write(99 as I64)
    copy_nonoverlapping[I64](src.as_const(), dst, 2 as I64)
    assert_eq(dst.read(), 42 as I64, "copy_nonoverlapping [0]")
    assert_eq(dst.add(1 as I64).read(), 99 as I64, "copy_nonoverlapping [1]")
    return 0
}

@test
func test_copy_overlapping() -> I32 {
    let buf = mem_alloc(24)
    let p: RawMutPtr[I64] = RawMutPtr::from_addr(buf as I64)
    p.write(1 as I64)
    p.add(1 as I64).write(2 as I64)
    p.add(2 as I64).write(3 as I64)
    // Copy [1,2] to position [1,2] shifted by 1 — overlapping
    copy[I64](p.as_const(), p.add(1 as I64), 2 as I64)
    assert_eq(p.add(1 as I64).read(), 1 as I64, "copy overlap [1]")
    assert_eq(p.add(2 as I64).read(), 2 as I64, "copy overlap [2]")
    return 0
}

@test
func test_copy_mut() -> I32 {
    let src_buf = mem_alloc(8)
    let dst_buf = mem_alloc(8)
    let src: RawMutPtr[I64] = RawMutPtr::from_addr(src_buf as I64)
    let dst: RawMutPtr[I64] = RawMutPtr::from_addr(dst_buf as I64)
    src.write(55 as I64)
    copy_mut[I64](src, dst, 1 as I64)
    assert_eq(dst.read(), 55 as I64, "copy_mut should copy value")
    return 0
}

@test
func test_copy_nonoverlapping_mut() -> I32 {
    let src_buf = mem_alloc(8)
    let dst_buf = mem_alloc(8)
    let src: RawMutPtr[I64] = RawMutPtr::from_addr(src_buf as I64)
    let dst: RawMutPtr[I64] = RawMutPtr::from_addr(dst_buf as I64)
    src.write(77 as I64)
    copy_nonoverlapping_mut[I64](src, dst, 1 as I64)
    assert_eq(dst.read(), 77 as I64, "copy_nonoverlapping_mut should copy value")
    return 0
}
