// BLOCKED by codegen bug: the lowlevel intrinsics ptr_read_unaligned, ptr_write_unaligned,
// ptr_read_volatile, ptr_write_volatile are not declared in generated LLVM IR.
// Error: "use of undefined value '@tml_ptr_write_unaligned'" (and similar for others).
//
// Coverage functions blocked (4):
//   - RawMutPtr::read_unaligned  -> lowlevel { ptr_read_unaligned[T] }  (via RawPtr)
//   - RawMutPtr::write_unaligned -> lowlevel { ptr_write_unaligned[T] }
//   - RawMutPtr::read_volatile   -> lowlevel { ptr_read_volatile[T] }   (via RawPtr)
//   - RawMutPtr::write_volatile  -> lowlevel { ptr_write_volatile[T] }
//
// These tests document the intended behavior and will pass once the
// intrinsics are implemented in the codegen backend.
use test::{assert, assert_eq}

// --- Placeholder: tests below will compile once intrinsics are emitted ---

@test
func test_mut_ptr_unaligned_volatile_blocked() -> I32 {
    // Real tests for these 4 functions:
