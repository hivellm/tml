// Tests for RawMutPtr — read_unaligned, write_unaligned, read_volatile, write_volatile
use test::{assert, assert_eq}
use core::ptr::RawMutPtr

@test
func test_write_unaligned_read_unaligned() -> I32 {
    let buf = mem_alloc(16)
    let p: RawMutPtr[I32] = RawMutPtr::from_addr(buf as I64)
    p.write_unaligned(77)
    let val: I32 = p.read_unaligned()
    assert_eq(val, 77, "write_unaligned then read_unaligned")
    return 0
}

@test
func test_write_volatile_read_volatile() -> I32 {
    let buf = mem_alloc(16)
    let p: RawMutPtr[I64] = RawMutPtr::from_addr(buf as I64)
    p.write_volatile(42 as I64)
    let val: I64 = p.read_volatile()
    assert_eq(val, 42 as I64, "write_volatile then read_volatile")
    return 0
}
