// Tests for ptr::ops — write_bytes, zero_memory
use test::{assert, assert_eq}
use core::ptr::RawMutPtr
use core::ptr::ops::{write_bytes, zero_memory}

@test
func test_write_bytes() -> I32 {
    let buf = mem_alloc(8)
    let p: RawMutPtr[I64] = RawMutPtr::from_addr(buf as I64)
    p.write(0xFFFFFFFF as I64)
    write_bytes[I64](p, 0, 1 as I64)
    assert_eq(p.read(), 0 as I64, "write_bytes should zero 8 bytes")
    return 0
}

@test
func test_zero_memory() -> I32 {
    let buf = mem_alloc(16)
    let p: RawMutPtr[I64] = RawMutPtr::from_addr(buf as I64)
    p.write(12345 as I64)
    p.add(1 as I64).write(67890 as I64)
    zero_memory[I64](p, 2 as I64)
    assert_eq(p.read(), 0 as I64, "zero_memory [0]")
    assert_eq(p.add(1 as I64).read(), 0 as I64, "zero_memory [1]")
    return 0
}
