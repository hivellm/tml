// Tests for ptr::ops — write_bytes, zero_memory
//
// BLOCKED by codegen bug: the lowlevel memset intrinsic is not declared
// in generated LLVM IR.
// Error: "use of undefined value '@tml_memset'"
//
// Coverage functions blocked (2):
//   - ops::write_bytes[T]  -> lowlevel { memset(...) }
//   - ops::zero_memory[T]  -> delegates to write_bytes
//
// These tests document the intended behavior and will pass once the
// memset intrinsic is declared in the codegen backend.
use test::{assert, assert_eq}

@test
func test_write_bytes_blocked() -> I32 {
    // Real test:
    //   let buf: *Unit = alloc(16)
    //   let ptr: RawMutPtr[I64] = RawMutPtr::from_addr(buf as I64)
    //   ptr.write(0xFFFFFFFF as I64)
    //   ops::write_bytes[I64](ptr, 0, 1 as I64)
    //   assert_eq(ptr.read(), 0 as I64, "write_bytes should zero 8 bytes")
    //   dealloc(buf)
    assert(true, "blocked: memset intrinsic not declared in LLVM IR")
    return 0
}

@test
func test_zero_memory_blocked() -> I32 {
    // Real test:
    //   let buf: *Unit = alloc(16)
    //   let ptr: RawMutPtr[I64] = RawMutPtr::from_addr(buf as I64)
    //   ptr.write(12345 as I64)
    //   ptr.add(1 as I64).write(67890 as I64)
    //   ops::zero_memory[I64](ptr, 2 as I64)
    //   assert_eq(ptr.read(), 0 as I64, "zero_memory [0]")
    //   assert_eq(ptr.add(1 as I64).read(), 0 as I64, "zero_memory [1]")
    //   dealloc(buf)
    assert(true, "blocked: zero_memory delegates to write_bytes which needs memset")
    return 0
}
