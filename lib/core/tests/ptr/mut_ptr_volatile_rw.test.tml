// Tests for various ptr operations: volatile, unaligned, copy, memset
use test::{assert, assert_eq}
use core::ptr::{RawPtr, RawMutPtr}

@test
func test_volatile_write_read_i32() -> I32 {
    let buf = mem_alloc(8)
    let p: RawMutPtr[I32] = RawMutPtr::from_addr(buf as I64)
    p.write_volatile(123)
    let v: I32 = p.read_volatile()
    assert_eq(v, 123, "volatile i32 roundtrip")
    return 0
}

@test
func test_unaligned_write_read_i32() -> I32 {
    let buf = mem_alloc(8)
    let p: RawMutPtr[I32] = RawMutPtr::from_addr(buf as I64)
    p.write_unaligned(456)
    let v: I32 = p.read_unaligned()
    assert_eq(v, 456, "unaligned i32 roundtrip")
    return 0
}

@test
func test_copy_from_i32() -> I32 {
    let src_buf = mem_alloc(8)
    let dst_buf = mem_alloc(8)
    let src: RawMutPtr[I32] = RawMutPtr::from_addr(src_buf as I64)
    let dst: RawMutPtr[I32] = RawMutPtr::from_addr(dst_buf as I64)
    src.write(789)
    dst.copy_from(src.as_const(), 1 as I64)
    assert_eq(dst.read(), 789, "copy_from i32")
    return 0
}

@test
func test_write_bytes_val_i32() -> I32 {
    let buf = mem_alloc(8)
    let p: RawMutPtr[I32] = RawMutPtr::from_addr(buf as I64)
    p.write(-1 as I32)  // 0xFFFFFFFF as I32 (avoids T051 overflow)
    p.write_bytes_val(0, 1 as I64)
    assert_eq(p.read(), 0, "write_bytes_val zeroes i32")
    return 0
}
