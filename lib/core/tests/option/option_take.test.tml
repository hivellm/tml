// Tests for Maybe::take
use test::{assert, assert_eq}

@test
func test_maybe_take_just() -> I32 {
    let x: Maybe[I32] = Just(42)
    let taken: Maybe[I32] = x.take()
    assert(taken.is_just(), "take of Just should return Just")
    assert_eq(taken.unwrap(), 42, "taken value should be 42")
    return 0
}

@test
func test_maybe_take_nothing() -> I32 {
    let x: Maybe[I32] = Nothing
    let taken: Maybe[I32] = x.take()
    assert(taken.is_nothing(), "take of Nothing should return Nothing")
    return 0
}

@test
func test_maybe_take_preserves_value() -> I32 {
    let x: Maybe[Str] = Just("hello")
    let taken: Maybe[Str] = x.take()
    assert_eq(taken.unwrap(), "hello", "take preserves string value")
    return 0
}
