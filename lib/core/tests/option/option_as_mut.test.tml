// Tests for Maybe::as_mut
use test::{assert, assert_eq, assert_true}

@test
func test_maybe_as_mut_just() -> I32 {
    var x: Maybe[I32] = Just(10)
    let r: Maybe[mut ref I32] = x.as_mut()
    assert_true(r.is_just(), "as_mut on Just should be Just")
    assert_eq(*r.unwrap(), 10, "as_mut value should be 10")
    return 0
}

@test
func test_maybe_as_mut_nothing() -> I32 {
    var x: Maybe[I32] = Nothing
    let r: Maybe[mut ref I32] = x.as_mut()
    assert_true(r.is_nothing(), "as_mut on Nothing should be Nothing")
    return 0
}
