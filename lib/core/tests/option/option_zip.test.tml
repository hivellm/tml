// Tests for Maybe::zip
use test::{assert, assert_eq}

@test
func test_zip_both_just() -> I32 {
    let x: Maybe[I32] = Just(1)
    let y: Maybe[I32] = Just(2)
    let r = x.zip(y)
    assert(r.is_just(), "zip of two Just values should be Just")
    return 0
}

@test
func test_zip_first_nothing() -> I32 {
    let x: Maybe[I32] = Nothing
    let y: Maybe[I32] = Just(2)
    let r = x.zip(y)
    assert(r.is_nothing(), "zip with Nothing first should be Nothing")
    return 0
}

@test
func test_zip_second_nothing() -> I32 {
    let x: Maybe[I32] = Just(1)
    let y: Maybe[I32] = Nothing
    let r = x.zip(y)
    assert(r.is_nothing(), "zip with Nothing second should be Nothing")
    return 0
}
