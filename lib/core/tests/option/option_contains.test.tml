// Tests for Maybe::contains
use test::{assert}

@test
func test_contains_just_match() -> I32 {
    let x: Maybe[I32] = Just(42)
    assert(x.contains(ref 42), "contains should find matching value")
    return 0
}

@test
func test_contains_just_no_match() -> I32 {
    let x: Maybe[I32] = Just(42)
    assert(not x.contains(ref 99), "contains should not find non-matching value")
    return 0
}

@test
func test_contains_nothing() -> I32 {
    let x: Maybe[I32] = Nothing
    assert(not x.contains(ref 42), "contains on Nothing should return false")
    return 0
}
