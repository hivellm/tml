use test::{assert_eq}

@test
func test_let_explicit_type() -> I32 {
    let base: I64 = 42
    assert_eq(base, 42, "let with explicit type")
    return 0
}

@test
func test_let_in_if_block() -> I32 {
    var result: I32 = 0
    if true {
        let x: I64 = 99
        result = x as I32
    }
    assert_eq(result, 99, "let in if block")
    return 0
}
