// Tests for Str::as_bytes
use test::{assert, assert_eq}

@test
func test_str_as_bytes_basic() -> I32 {
    let s: Str = "hello"
    let bytes: ref [U8] = s.as_bytes()
    assert(true, "as_bytes compiled and ran")
    return 0
}

@test
func test_str_as_bytes_empty() -> I32 {
    let s: Str = ""
    let bytes: ref [U8] = s.as_bytes()
    assert(true, "as_bytes on empty string works")
    return 0
}
