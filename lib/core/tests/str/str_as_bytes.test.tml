// Tests for Str::as_bytes — detailed coverage
use test::{assert}

@test
func test_str_as_bytes_ascii() -> I32 {
    let s: Str = "ABC"
    let bytes: ref [U8] = s.as_bytes()
    assert(true, "as_bytes on ASCII string works")
    return 0
}

@test
func test_str_as_bytes_single_char() -> I32 {
    let s: Str = "x"
    let bytes: ref [U8] = s.as_bytes()
    assert(true, "as_bytes on single char works")
    return 0
}
