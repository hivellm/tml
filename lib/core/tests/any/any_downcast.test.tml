// Tests for AnyValue::downcast, downcast_mut, into_inner, drop
use test::{assert, assert_eq}
use core::types::any::AnyValue

@test
func test_anyvalue_drop_implicit() -> I32 {
    // Creating and discarding an AnyValue exercises drop
    let any: AnyValue = AnyValue::from[I32](42)
    assert(any.is_type[I32](), "should be I32 before drop")
    // any goes out of scope here, drop is called
    return 0
}

@test
func test_anyvalue_multiple_drop() -> I32 {
    // Multiple AnyValues created and dropped
    let a1: AnyValue = AnyValue::from[I32](1)
    let a2: AnyValue = AnyValue::from[I64](2)
    let a3: AnyValue = AnyValue::from[Bool](true)
    assert(a1.is_type[I32](), "a1 is I32")
    assert(a2.is_type[I64](), "a2 is I64")
    assert(a3.is_type[Bool](), "a3 is Bool")
    // All go out of scope, all dropped
    return 0
}

@test
func test_downcast_ok() -> I32 {
    let any: AnyValue = AnyValue::from[I32](42)
    let r: Maybe[ref I32] = any.downcast[I32]()
    assert(r.is_just(), "downcast should succeed for matching type")
    return 0
}

@test
func test_downcast_wrong_type() -> I32 {
    let any: AnyValue = AnyValue::from[I32](42)
    let r: Maybe[ref I64] = any.downcast[I64]()
    assert(r.is_nothing(), "downcast should fail for wrong type")
    return 0
}

// NOTE: into_inner[T] tests omitted — into_inner calls dealloc internally but TML
// does not yet support move semantics for 'this', so drop also runs on scope exit
// causing a double-free (heap corruption). Requires compiler move/consume support.
