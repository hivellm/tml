// Tests for Sync::to_string and Sync::debug_string
use test::{assert, assert_eq}
use core::alloc::sync::Sync

@test
func test_sync_to_string() -> I32 {
    let s: Sync[I32] = Sync::new(42)
    let str_val = s.to_string()
    assert_eq(str_val, "42", "Sync::to_string delegates to inner")
    return 0
}

@test
func test_sync_debug_string() -> I32 {
    let s: Sync[I32] = Sync::new(99)
    let dbg = s.debug_string()
    assert(dbg.len() > 0, "Sync::debug_string returns non-empty")
    return 0
}
