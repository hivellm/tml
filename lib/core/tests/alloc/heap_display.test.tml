// Tests for Heap::to_string and Heap::debug_string
use test::{assert, assert_eq}
use core::alloc::heap::Heap

@test
func test_heap_to_string() -> I32 {
    let h: Heap[I32] = Heap::new(42)
    let s = h.to_string()
    assert_eq(s, "Heap", "Heap::to_string returns Heap")
    return 0
}

@test
func test_heap_debug_string() -> I32 {
    let h: Heap[I32] = Heap::new(99)
    let s = h.debug_string()
    assert_eq(s, "Heap(...)", "Heap::debug_string returns Heap(...)")
    return 0
}
