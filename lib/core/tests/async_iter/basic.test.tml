use test::{assert, assert_eq}
use core::async::async_iter::{Once, Empty, Repeat, Take, FromIter, once, empty, repeat, from_iter}

// Test Once constructor and size_hint lower bound
@test
func test_once_size_hint() -> I32 {
    let o: Once[I32] = once(42)
    let hint = o.size_hint()
    assert_eq(hint.0, 1)
    return 0
}

// Test Once::new constructor
@test
func test_once_new() -> I32 {
    let o: Once[I32] = Once::new(7)
    let hint = o.size_hint()
    assert_eq(hint.0, 1)
    return 0
}

// Test Empty constructor and size_hint lower bound
@test
func test_empty_size_hint() -> I32 {
    let e: Empty[I32] = empty()
    let hint = e.size_hint()
    assert_eq(hint.0, 0)
    return 0
}

// Test Repeat constructor and size_hint
@test
func test_repeat_size_hint() -> I32 {
    let r: Repeat[I32] = repeat(42)
    let hint = r.size_hint()
    assert(hint.0 > 0, "Repeat lower bound should be large")
    return 0
}

// Test Take constructor and size_hint
@test
func test_take_size_hint() -> I32 {
    let r: Repeat[I32] = repeat(1)
    let t: Take[Repeat[I32]] = Take::new(r, 5)
    let hint = t.size_hint()
    assert_eq(hint.0, 5)
    return 0
}

// Test Take with Empty inner
@test
func test_take_empty() -> I32 {
    let e: Empty[I32] = empty()
    let t: Take[Empty[I32]] = Take::new(e, 10)
    let hint = t.size_hint()
    assert_eq(hint.0, 0)
    return 0
}
