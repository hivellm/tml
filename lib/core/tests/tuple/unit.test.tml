// Tests for core::tuple — Unit type
use test::{assert}
use core::tuple::Unit

@test
func test_unit_default() -> I32 {
    let u = Unit::default()
    assert(true, "Unit::default() should compile and run")
    return 0
}

@test
func test_unit_default_twice() -> I32 {
    // Multiple Unit::default() calls should work
    let a = Unit::default()
    let b = Unit::default()
    assert(true, "Multiple Unit::default() calls work")
    return 0
}
