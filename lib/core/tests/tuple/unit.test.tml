// Tests for core::tuple — Unit type
use test::{assert, assert_eq}
use core::types::tuple::Unit
use core::traits::clone::Clone

@test
func test_unit_default() -> I32 {
    let u = Unit::default()
    assert(true, "Unit::default() should compile and run")
    return 0
}

@test
func test_unit_default_twice() -> I32 {
    let a = Unit::default()
    let b = Unit::default()
    assert(true, "Multiple Unit::default() calls work")
    return 0
}

@test
func test_unit_eq() -> I32 {
    let a = Unit::default()
    let b = Unit::default()
    assert(a.eq(ref b), "Unit::eq should return true")
    return 0
}

@test
func test_unit_ne() -> I32 {
    let a = Unit::default()
    let b = Unit::default()
    assert(not a.ne(ref b), "Unit::ne should return false")
    return 0
}

@test
func test_unit_clone() -> I32 {
    let a = Unit::default()
    let b: Unit = a.clone()
    assert(true, "Unit::clone should work")
    return 0
}

@test
func test_unit_partial_cmp() -> I32 {
    let a = Unit::default()
    let b = Unit::default()
    let result = a.partial_cmp(ref b)
    when result {
        Just(ord) => {
            when ord {
                Ordering::Equal => assert(true, "Unit partial_cmp is Equal"),
                _ => assert(false, "Unit partial_cmp should be Equal")
            }
        },
        Nothing => assert(false, "Unit partial_cmp should not be Nothing")
    }
    return 0
}

@test
func test_unit_cmp() -> I32 {
    let a = Unit::default()
    let b = Unit::default()
    let ord = a.cmp(ref b)
    when ord {
        Ordering::Equal => assert(true, "Unit cmp is Equal"),
        _ => assert(false, "Unit cmp should be Equal")
    }
    return 0
}
