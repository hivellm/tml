// Tests for tuple Default, PartialEq, Clone implementations
use test::{assert, assert_eq}

@test
func test_tuple2_default() -> I32 {
    let t: (I32, I32) = (I32::default(), I32::default())
    assert_eq(t.0, 0, "tuple2 default .0 should be 0")
    assert_eq(t.1, 0, "tuple2 default .1 should be 0")
    0
}

@test
func test_tuple3_default() -> I32 {
    let t: (I32, I32, I32) = (I32::default(), I32::default(), I32::default())
    assert_eq(t.0, 0, "tuple3 default .0")
    assert_eq(t.1, 0, "tuple3 default .1")
    assert_eq(t.2, 0, "tuple3 default .2")
    0
}

@test
func test_tuple2_eq() -> I32 {
    let a: (I32, I32) = (1, 2)
    let b: (I32, I32) = (1, 2)
    let c: (I32, I32) = (1, 3)
    assert(a == b, "same tuples should be equal")
    assert(a != c, "different tuples should not be equal")
    0
}

@test
func test_tuple3_eq() -> I32 {
    let a: (I32, I32, I32) = (1, 2, 3)
    let b: (I32, I32, I32) = (1, 2, 3)
    let c: (I32, I32, I32) = (1, 2, 4)
    assert(a == b, "same 3-tuples should be equal")
    assert(a != c, "different 3-tuples should not be equal")
    0
}

@test
func test_tuple4_eq() -> I32 {
    let a: (I32, I32, I32, I32) = (1, 2, 3, 4)
    let b: (I32, I32, I32, I32) = (1, 2, 3, 4)
    let c: (I32, I32, I32, I32) = (1, 2, 3, 5)
    assert(a == b, "same 4-tuples should be equal")
    assert(a != c, "different 4-tuples should not be equal")
    0
}

@test
func test_tuple5_eq() -> I32 {
    let a: (I32, I32, I32, I32, I32) = (1, 2, 3, 4, 5)
    let b: (I32, I32, I32, I32, I32) = (1, 2, 3, 4, 5)
    let c: (I32, I32, I32, I32, I32) = (1, 2, 3, 4, 6)
    assert(a == b, "same 5-tuples should be equal")
    assert(a != c, "different 5-tuples should not be equal")
    0
}

@test
func test_tuple6_eq() -> I32 {
    let a: (I32, I32, I32, I32, I32, I32) = (1, 2, 3, 4, 5, 6)
    let b: (I32, I32, I32, I32, I32, I32) = (1, 2, 3, 4, 5, 6)
    let c: (I32, I32, I32, I32, I32, I32) = (1, 2, 3, 4, 5, 7)
    assert(a == b, "same 6-tuples should be equal")
    assert(a != c, "different 6-tuples should not be equal")
    0
}

// NOTE: Default::default() for tuple types blocked — "Type mismatch: expected (I32, I32), found ()"
// Generic behavior dispatch for compound/tuple types not monomorphized correctly (same bug as Clone, Ord)
