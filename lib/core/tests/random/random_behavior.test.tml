// Tests for core::random::Random behavior
use test
use core::random::RngSource
use core::random::Random

type CounterRng {
    state: I64,
}

impl RngSource for CounterRng {
    func next_i64(mut this) -> I64 {
        this.state = this.state + 1
        return this.state
    }
    func next_i32(mut this) -> I32 {
        this.state = this.state + 1
        return this.state as I32
    }
    func next_bool(mut this) -> Bool {
        this.state = this.state + 1
        return (this.state & 1) == 0
    }
    func next_f64(mut this) -> F64 {
        this.state = this.state + 1
        return 0.5
    }
    func range(mut this, min: I64, max: I64) -> I64 {
        this.state = this.state + 1
        if min >= max { return min }
        return min + (this.state % (max - min))
    }
}

// A type implementing Random[CounterRng]
type DieSide {
    face: I64,
}

impl Random[CounterRng] for DieSide {
    func random(rng: mut ref CounterRng) -> DieSide {
        return DieSide { face: rng.range(1, 7) }
    }
}

@test
func test_random_die_face() -> Outcome[Unit, Str] {
    var rng: CounterRng = CounterRng { state: 0 }
    let die: DieSide = DieSide::random(mut ref rng)
    // state becomes 1, 1 % 6 = 1, face = 1 + 1 = 2
    assert_eq(die.face, 2 as I64, "die face = 2 with state=1")
    Ok(())
}

@test
func test_random_die_face_in_range() -> Outcome[Unit, Str] {
    var rng: CounterRng = CounterRng { state: 5 }
    let die: DieSide = DieSide::random(mut ref rng)
    // state becomes 6, 6 % 6 = 0, face = 1 + 0 = 1
    assert_true(die.face >= 1 as I64 and die.face <= 6 as I64, "face in 1..=6")
    Ok(())
}
