// Simple test for RngSource behavior - avoid loops to prevent timeout
use test
use core::random::RngSource

type SimpleRng {
    state: I64,
}

impl RngSource for SimpleRng {
    func next_i64(mut this) -> I64 {
        this.state = this.state + 1
        return this.state
    }

    func next_i32(mut this) -> I32 {
        this.state = this.state + 1
        return this.state as I32
    }

    func next_bool(mut this) -> Bool {
        this.state = this.state + 1
        return (this.state & 1) == 0
    }

    func next_f64(mut this) -> F64 {
        this.state = this.state + 1
        return 0.5
    }

    func range(mut this, min: I64, max: I64) -> I64 {
        this.state = this.state + 1
        if min >= max {
            return min
        }
        return min + (this.state % (max - min))
    }
}

@test
func test_rngsource_next_i64() -> Outcome[Unit, Str] {
    var rng: SimpleRng = SimpleRng { state: 0 }
    let v: I64 = rng.next_i64()
    assert_eq(v, 1 as I64, "first call returns 1")
    Ok(())
}

@test
func test_rngsource_next_i32() -> Outcome[Unit, Str] {
    var rng: SimpleRng = SimpleRng { state: 10 }
    let v: I32 = rng.next_i32()
    assert_eq(v, 11 as I32, "returns state+1")
    Ok(())
}

@test
func test_rngsource_next_bool() -> Outcome[Unit, Str] {
    var rng: SimpleRng = SimpleRng { state: 1 }
    // state becomes 2, 2 & 1 == 0, so true
    let b: Bool = rng.next_bool()
    assert_true(b, "even state -> true")
    Ok(())
}

@test
func test_rngsource_next_f64() -> Outcome[Unit, Str] {
    var rng: SimpleRng = SimpleRng { state: 0 }
    let f: F64 = rng.next_f64()
    assert_true(f >= 0.0 and f < 1.0, "f64 in [0,1)")
    Ok(())
}

@test
func test_rngsource_range() -> Outcome[Unit, Str] {
    var rng: SimpleRng = SimpleRng { state: 0 }
    let v: I64 = rng.range(5, 15)
    // state becomes 1, 1 % 10 = 1, result = 5 + 1 = 6
    assert_eq(v, 6 as I64, "range(5,15) with state=1 = 6")
    Ok(())
}

@test
func test_rngsource_range_same() -> Outcome[Unit, Str] {
    var rng: SimpleRng = SimpleRng { state: 0 }
    let v: I64 = rng.range(42, 42)
    assert_eq(v, 42 as I64, "range(42,42) = 42")
    Ok(())
}
