// Tests for Step::steps_between — I8, I16, U8, U16, U32, U64 impls
use test::{assert, assert_eq}
use core::iter::range::Step

@test
func test_steps_between_i8() -> I32 {
    let r: Maybe[I64] = I8::steps_between(ref 0_i8, ref 10_i8)
    when r {
        Just(n) => assert_eq(n, 10_i64, "i8 steps_between(0, 10) = 10"),
        Nothing => assert(false, "should not be Nothing")
    }
    return 0
}

@test
func test_steps_between_i16() -> I32 {
    let r: Maybe[I64] = I16::steps_between(ref 0_i16, ref 100_i16)
    when r {
        Just(n) => assert_eq(n, 100_i64, "i16 steps_between(0, 100) = 100"),
        Nothing => assert(false, "should not be Nothing")
    }
    return 0
}

@test
func test_steps_between_u8() -> I32 {
    let r: Maybe[I64] = U8::steps_between(ref 0_u8, ref 50_u8)
    when r {
        Just(n) => assert_eq(n, 50_i64, "u8 steps_between(0, 50) = 50"),
        Nothing => assert(false, "should not be Nothing")
    }
    return 0
}

@test
func test_steps_between_u16() -> I32 {
    let r: Maybe[I64] = U16::steps_between(ref 10_u16, ref 110_u16)
    when r {
        Just(n) => assert_eq(n, 100_i64, "u16 steps_between(10, 110) = 100"),
        Nothing => assert(false, "should not be Nothing")
