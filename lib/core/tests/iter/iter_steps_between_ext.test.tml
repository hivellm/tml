@test
func test_u8_backward_checked() -> I32 {
    let v: U8 = 100_u8
    let r: Maybe[U8] = v.backward_checked(50_i64)
    when r {
        Just(n) => assert_eq(n, 50_u8, "u8 backward_checked(100, 50) = 50"),
        Nothing => assert(false, "should not be Nothing")
    }
    return 0
}

@test
func test_u16_backward_checked() -> I32 {
    let v: U16 = 200_u16
    let r: Maybe[U16] = v.backward_checked(100_i64)
    when r {
        Just(n) => assert_eq(n, 100_u16, "u16 backward_checked(200, 100) = 100"),
        Nothing => assert(false, "should not be Nothing")
    }
    return 0
}
