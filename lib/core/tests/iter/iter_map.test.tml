// Tests for Map iterator adapter
use test::{assert, assert_eq}
use core::iter::adapters::map::{Map, map}

type Counter { current: I32, max: I32 }
impl Iterator for Counter {
    type Item = I32
    pub func next(mut this) -> Maybe[I32] {
        if this.current >= this.max { return Nothing }
        let val: I32 = this.current
        this.current = this.current + 1
        return Just(val)
    }
}

@test
func test_map_double() -> I32 {
    var iter: Map[Counter, func(I32) -> I32] = map(Counter { current: 0, max: 3 }, do(x: I32) -> I32 { x * 2 })
    let v1: Maybe[I32] = iter.next()
    assert_eq(v1.unwrap(), 0, "0*2=0")
    let v2: Maybe[I32] = iter.next()
    assert_eq(v2.unwrap(), 2, "1*2=2")
    let v3: Maybe[I32] = iter.next()
    assert_eq(v3.unwrap(), 4, "2*2=4")
    let v4: Maybe[I32] = iter.next()
    assert(v4.is_nothing(), "exhausted")
    return 0
}

@test
func test_map_add_one() -> I32 {
    var iter: Map[Counter, func(I32) -> I32] = map(Counter { current: 5, max: 8 }, do(x: I32) -> I32 { x + 1 })
    assert_eq(iter.next().unwrap(), 6, "5+1=6")
    assert_eq(iter.next().unwrap(), 7, "6+1=7")
    assert_eq(iter.next().unwrap(), 8, "7+1=8")
    assert(iter.next().is_nothing(), "exhausted")
    return 0
}

@test
func test_map_empty() -> I32 {
    var iter: Map[Counter, func(I32) -> I32] = map(Counter { current: 0, max: 0 }, do(x: I32) -> I32 { x * 3 })
    assert(iter.next().is_nothing(), "empty map yields nothing")
    return 0
}
