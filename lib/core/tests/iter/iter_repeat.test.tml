// Tests for Repeat[T] iterator (infinite repeat with Duplicate)
use test::{assert, assert_eq}
use core::iter::sources::repeat::{Repeat, repeat}

@test
func test_repeat_next() -> I32 {
    let mut r: Repeat[I32] = repeat(42)
    assert_eq(r.next().unwrap(), 42, "repeat yields value")
    assert_eq(r.next().unwrap(), 42, "repeat yields same value again")
    assert_eq(r.next().unwrap(), 42, "repeat yields same value a third time")
    return 0
}

@test
func test_repeat_size_hint() -> I32 {
    let r: Repeat[I32] = repeat(1)
    let hint: (I64, Maybe[I64]) = r.size_hint()
    assert(hint.0 > 1000000 as I64, "repeat size_hint lo should be very large")
    return 0
}
