// Tests for iter/traits/accumulators — Sum and Product
use test::{assert, assert_eq}

type AccCounter { current: I32, max: I32 }
impl Iterator for AccCounter {
    type Item = I32
    pub func next(mut this) -> Maybe[I32] {
        if this.current >= this.max { return Nothing }
        let val: I32 = this.current
        this.current = this.current + 1
        return Just(val)
    }
}

@test
func test_i32_sum_basic() -> I32 {
    var iter: AccCounter = AccCounter { current: 1, max: 5 }
    let s: I32 = I32::sum(iter)
    assert_eq(s as I64, 10 as I64, "sum 1..4 = 10")
    return 0
}

@test
func test_i32_sum_empty() -> I32 {
    var iter: AccCounter = AccCounter { current: 0, max: 0 }
    let s: I32 = I32::sum(iter)
    assert_eq(s as I64, 0 as I64, "sum empty = 0")
    return 0
}

@test
func test_i32_product_basic() -> I32 {
    var iter: AccCounter = AccCounter { current: 1, max: 5 }
    let p: I32 = I32::product(iter)
    assert_eq(p as I64, 24 as I64, "product 1..4 = 24")
    return 0
}
