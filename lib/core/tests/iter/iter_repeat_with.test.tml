// Tests for RepeatWith[F] iterator (infinite repeat with generator function)
use test::{assert, assert_eq}
use core::iter::sources::repeat_with::{RepeatWith, repeat_with}

@test
func test_repeat_with_constant() -> I32 {
    let mut r: RepeatWith[func() -> I32] = repeat_with(do() -> I32 { 99 })
    assert_eq(r.next().unwrap(), 99, "repeat_with constant yields 99")
    assert_eq(r.next().unwrap(), 99, "repeat_with constant yields 99 again")
    return 0
}

@test
func test_repeat_with_size_hint() -> I32 {
    let r: RepeatWith[func() -> I32] = repeat_with(do() -> I32 { 1 })
    let hint: (I64, Maybe[I64]) = r.size_hint()
    assert(hint.0 > 1000000 as I64, "repeat_with size_hint lo should be very large")
    return 0
}

@test
func test_repeat_with_stateful() -> I32 {
    let mut counter: I32 = 0
    let mut r: RepeatWith[func() -> I32] = repeat_with(do() -> I32 {
        counter = counter + 1
        return counter
    })
    assert_eq(r.next().unwrap(), 1, "first call yields 1")
    assert_eq(r.next().unwrap(), 2, "second call yields 2")
    assert_eq(r.next().unwrap(), 3, "third call yields 3")
    return 0
}
