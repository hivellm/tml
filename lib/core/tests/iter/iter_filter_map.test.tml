// Tests for FilterMap iterator adapter
use test::{assert, assert_eq}
use core::iter::adapters::filter_map::{FilterMap, filter_map}

type FMCounter { current: I32, max: I32 }
impl Iterator for FMCounter {
    type Item = I32
    pub func next(mut this) -> Maybe[I32] {
        if this.current >= this.max { return Nothing }
        let val: I32 = this.current
        this.current = this.current + 1
        return Just(val)
    }
}

@test
func test_filter_map_keep_even_doubled() -> I32 {
    var iter: FilterMap[FMCounter, func(I32) -> Maybe[I32]] = filter_map(
        FMCounter { current: 0, max: 6 },
        do(x: I32) -> Maybe[I32] {
            if x % 2 == 0 { return Just(x * 2) }
            return Nothing
        }
    )
    assert_eq(iter.next().unwrap(), 0, "0*2=0")
    assert_eq(iter.next().unwrap(), 4, "2*2=4")
    assert_eq(iter.next().unwrap(), 8, "4*2=8")
    assert(iter.next().is_nothing(), "exhausted")
    return 0
}

@test
func test_filter_map_all_nothing() -> I32 {
    var iter: FilterMap[FMCounter, func(I32) -> Maybe[I32]] = filter_map(
        FMCounter { current: 0, max: 3 },
        do(x: I32) -> Maybe[I32] { return Nothing }
    )
    assert(iter.next().is_nothing(), "all filtered out")
    return 0
}

@test
func test_filter_map_empty() -> I32 {
    var iter: FilterMap[FMCounter, func(I32) -> Maybe[I32]] = filter_map(
        FMCounter { current: 0, max: 0 },
        do(x: I32) -> Maybe[I32] { return Just(x) }
    )
    assert(iter.next().is_nothing(), "empty source")
    return 0
}
