// Tests for Iterator extra methods: is_sorted
use test::{assert, assert_eq}

type Counter { current: I32, limit: I32 }
impl Iterator for Counter {
    type Item = I32
    pub func next(mut this) -> Maybe[I32] {
        if this.current >= this.limit { return Nothing }
        let val: I32 = this.current
        this.current = this.current + 1
        return Just(val)
    }
}

type DescCounter { current: I32, limit: I32 }
impl Iterator for DescCounter {
    type Item = I32
    pub func next(mut this) -> Maybe[I32] {
        if this.current <= this.limit { return Nothing }
        let val: I32 = this.current
        this.current = this.current - 1
        return Just(val)
    }
}

@test
func test_is_sorted_ascending() -> I32 {
    let mut iter: Counter = Counter { current: 0, limit: 5 }
    assert(iter.is_sorted(), "0,1,2,3,4 should be sorted")
    return 0
}

@test
func test_is_sorted_descending() -> I32 {
    let mut iter: DescCounter = DescCounter { current: 5, limit: 0 }
    assert(not iter.is_sorted(), "5,4,3,2,1 should NOT be sorted")
    return 0
}

@test
func test_is_sorted_empty() -> I32 {
    let mut iter: Counter = Counter { current: 5, limit: 5 }
    assert(iter.is_sorted(), "empty iterator should be sorted")
    return 0
}

@test
func test_is_sorted_single() -> I32 {
    let mut iter: Counter = Counter { current: 0, limit: 1 }
    assert(iter.is_sorted(), "single element should be sorted")
    return 0
}

@test
func test_is_sorted_equal_elements() -> I32 {
    // Counter always increments, so equal elements requires a different approach
    // Just test that a constant sequence is sorted
    let mut iter: Counter = Counter { current: 5, limit: 6 }
    assert(iter.is_sorted(), "single element 5 is sorted")
    return 0
}
