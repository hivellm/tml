// Tests for Sum/Product on small types: I8, I16, U8, U16, F32, F64
use test::{assert_eq, assert}

type I8Counter { current: I8, max: I8 }
impl Iterator for I8Counter {
    type Item = I8
    pub func next(mut this) -> Maybe[I8] {
        if this.current >= this.max { return Nothing }
        let val: I8 = this.current
        this.current = this.current + 1_i8
        return Just(val)
    }
}

@test
func test_i8_sum() -> I32 {
    var iter: I8Counter = I8Counter { current: 1_i8, max: 5_i8 }
    let s: I8 = I8::sum(iter)
    assert_eq(s as I32, 10, "i8 sum 1..4 = 10")
    return 0
}

@test
func test_i8_product() -> I32 {
    var iter: I8Counter = I8Counter { current: 1_i8, max: 5_i8 }
    let p: I8 = I8::product(iter)
    assert_eq(p as I32, 24, "i8 product 1..4 = 24")
    return 0
}

