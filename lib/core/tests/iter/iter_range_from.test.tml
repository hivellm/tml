// Tests for RangeFrom[I32] iterator (open-ended range)
use test::{assert, assert_eq}
use core::ops::range::RangeFrom
use core::iter

@test
func test_range_from_basic() -> I32 {
    var r: RangeFrom[I32] = RangeFrom { start: 10 }
    assert_eq(r.next().unwrap(), 10, "first is 10")
    assert_eq(r.next().unwrap(), 11, "second is 11")
    assert_eq(r.next().unwrap(), 12, "third is 12")
    return 0
}

@test
func test_range_from_negative() -> I32 {
    var r: RangeFrom[I32] = RangeFrom { start: -1 }
    assert_eq(r.next().unwrap(), -1, "start -1")
    assert_eq(r.next().unwrap(), 0, "next 0")
    assert_eq(r.next().unwrap(), 1, "next 1")
    return 0
}
