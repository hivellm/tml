// Tests for Iterator default trait methods (count, advance_by)
use test

type Counter { current: I32, max: I32 }
impl Iterator for Counter {
    type Item = I32
    pub func next(mut this) -> Maybe[I32] {
        if this.current >= this.max { return Nothing }
        let val: I32 = this.current
        this.current = this.current + 1
        return Just(val)
    }
}

// --- count ---

@test
func test_count_basic() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 5 }
    assert_eq(iter.count(), 5 as I64, "count 0..5 = 5")
    return 0
}

@test
func test_count_empty() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 0 }
    assert_eq(iter.count(), 0 as I64, "count empty = 0")
    return 0
}

@test
func test_count_partial() -> I32 {
    let mut iter: Counter = Counter { current: 3, max: 7 }
    assert_eq(iter.count(), 4 as I64, "count 3..7 = 4")
    return 0
}

@test
func test_count_single() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 1 }
    assert_eq(iter.count(), 1 as I64, "count single = 1")
    return 0
}

// --- advance_by ---

@test
func test_advance_by_basic() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 10 }
    let r = iter.advance_by(3 as I64)
    assert(r.is_ok(), "advance_by 3 should succeed")
    assert_eq(iter.next().unwrap(), 3, "after advance_by 3, next=3")
    return 0
}

@test
func test_advance_by_zero() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 5 }
    let r = iter.advance_by(0 as I64)
    assert(r.is_ok(), "advance_by 0 should succeed")
    assert_eq(iter.next().unwrap(), 0, "after advance_by 0, next=0")
    return 0
}

@test
func test_advance_by_exact() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 5 }
    let r = iter.advance_by(5 as I64)
    assert(r.is_ok(), "advance_by exact count should succeed")
    assert(iter.next().is_nothing(), "iterator exhausted after advance_by all")
    return 0
}

@test
func test_advance_by_too_many() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 3 }
    let r = iter.advance_by(10 as I64)
    assert(r.is_err(), "advance_by past end should fail")
    return 0
}

// --- last ---

@test
func test_last_basic() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 5 }
    let r: Maybe[I32] = iter.last()
    assert(r.is_just(), "last should return Just on non-empty")
    assert_eq(r.unwrap(), 4, "last element of 0..5 is 4")
    return 0
}

@test
func test_last_empty() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 0 }
    let r: Maybe[I32] = iter.last()
    assert(r.is_nothing(), "last on empty iterator is Nothing")
    return 0
}

// --- nth ---

@test
func test_nth_basic() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 10 }
    let r: Maybe[I32] = iter.nth(3 as I64)
    assert(r.is_just(), "nth(3) should find element")
    assert_eq(r.unwrap(), 3, "nth(3) of 0..10 is 3")
    return 0
}

@test
func test_nth_zero() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 5 }
    let r: Maybe[I32] = iter.nth(0 as I64)
    assert(r.is_just(), "nth(0) should return first element")
    assert_eq(r.unwrap(), 0, "nth(0) is 0")
    return 0
}

@test
func test_nth_out_of_bounds() -> I32 {
    let mut iter: Counter = Counter { current: 0, max: 3 }
    let r: Maybe[I32] = iter.nth(10 as I64)
    assert(r.is_nothing(), "nth past end is Nothing")
    return 0
}

// NOTE: for_each(do(v: I32) {}) — blocked by closure call codegen bug:
// passing closure struct as i32 (type mismatch in LLVM IR)

// --- all ---

@test
func test_all_true() -> I32 {
    var iter: Counter = Counter { current: 1, max: 5 }
    let r: Bool = iter.all(do(x: I32) x > 0)
    assert(r, "all positive => true")
    return 0
}

@test
func test_all_false() -> I32 {
    var iter: Counter = Counter { current: 0, max: 5 }
    let r: Bool = iter.all(do(x: I32) x > 0)
    assert(not r, "0 not positive => false")
    return 0
}

// --- any ---

@test
func test_any_true() -> I32 {
    var iter: Counter = Counter { current: 0, max: 5 }
    let r: Bool = iter.any(do(x: I32) x == 3)
    assert(r, "3 in 0..5 => true")
    return 0
}

@test
func test_any_false() -> I32 {
    var iter: Counter = Counter { current: 0, max: 3 }
    let r: Bool = iter.any(do(x: I32) x == 5)
    assert(not r, "5 not in 0..3 => false")
    return 0
}

// --- find ---

@test
func test_find_found() -> I32 {
    var iter: Counter = Counter { current: 0, max: 5 }
    let r: Maybe[I32] = iter.find(do(x: I32) x == 3)
    assert(r.is_just(), "find 3 in 0..5 found")
    assert_eq(r.unwrap() as I64, 3 as I64, "found 3")
    return 0
}

@test
func test_find_not_found() -> I32 {
    var iter: Counter = Counter { current: 0, max: 3 }
    let r: Maybe[I32] = iter.find(do(x: I32) x == 10)
    assert(r.is_nothing(), "find 10 not in 0..3")
    return 0
}

// --- position ---

@test
func test_position_found() -> I32 {
    var iter: Counter = Counter { current: 0, max: 5 }
    let r: Maybe[I64] = iter.position(do(x: I32) x == 3)
    assert(r.is_just(), "position of 3 found")
    assert_eq(r.unwrap(), 3 as I64, "position of 3 is index 3")
    return 0
}

@test
func test_position_not_found() -> I32 {
    var iter: Counter = Counter { current: 0, max: 3 }
    let r: Maybe[I64] = iter.position(do(x: I32) x == 10)
    assert(r.is_nothing(), "position of 10 not in 0..3")
    return 0
}

// NOTE: fold[B] — blocked by generic type param B not resolving when combined with
// This::Item associated type. Compiler emits "Type mismatch: expected I32, found B".

// --- max_by / min_by ---

@test
func test_max_by() -> I32 {
    var iter: Counter = Counter { current: 0, max: 5 }
    let r: Maybe[I32] = iter.max_by(do(a: ref I32, b: ref I32) -> Ordering {
        if *a > *b { return Ordering::Greater }
        if *a < *b { return Ordering::Less }
        return Ordering::Equal
    })
    assert(r.is_just(), "max_by on 0..4 found")
    assert_eq(r.unwrap() as I64, 4 as I64, "max of 0..4 = 4")
    return 0
}

@test
func test_min_by() -> I32 {
    var iter: Counter = Counter { current: 0, max: 5 }
    let r: Maybe[I32] = iter.min_by(do(a: ref I32, b: ref I32) -> Ordering {
        if *a > *b { return Ordering::Greater }
        if *a < *b { return Ordering::Less }
        return Ordering::Equal
    })
    assert(r.is_just(), "min_by on 0..4 found")
    assert_eq(r.unwrap() as I64, 0 as I64, "min of 0..4 = 0")
    return 0
}

// --- for_each ---

@test
func test_for_each_sum() -> I32 {
    var sum: I32 = 0
    var iter: Counter = Counter { current: 0, max: 5 }
    iter.for_each(do(x: I32) { sum = sum + x })
    assert_eq(sum as I64, 10 as I64, "for_each sum 0..4 = 10")
    return 0
}

// --- reduce ---

@test
func test_reduce_sum() -> I32 {
    var iter: Counter = Counter { current: 1, max: 5 }
    let r: Maybe[I32] = iter.reduce(do(acc: I32, x: I32) acc + x)
    assert(r.is_just(), "reduce on non-empty")
    assert_eq(r.unwrap() as I64, 10 as I64, "reduce sum 1..4 = 10")
    return 0
}

@test
func test_reduce_empty() -> I32 {
    var iter: Counter = Counter { current: 0, max: 0 }
    let r: Maybe[I32] = iter.reduce(do(acc: I32, x: I32) acc + x)
    assert(r.is_nothing(), "reduce on empty = Nothing")
    return 0
}

// --- size_hint ---

@test
func test_size_hint_default() -> I32 {
    let iter: Counter = Counter { current: 0, max: 5 }
    let (lo, hi): (I64, Maybe[I64]) = iter.size_hint()
    assert_eq(lo, 0 as I64, "default lower bound is 0")
    assert(hi.is_nothing(), "default upper bound is Nothing")
    return 0
}

