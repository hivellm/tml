// Tests for Array::each_ref, each_mut
use test::assert

@test
func test_array_each_ref() -> I32 {
    let arr: [I32; 3] = [10, 20, 30]
    let refs = arr.each_ref()
    assert(true, "each_ref compiled and ran")
    return 0
}

@test
func test_array_each_mut() -> I32 {
    let mut arr: [I32; 3] = [10, 20, 30]
    let mrefs = arr.each_mut()
    assert(true, "each_mut compiled and ran")
    return 0
}
