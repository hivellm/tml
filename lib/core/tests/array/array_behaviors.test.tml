// Tests for Array uncovered functions
// BLOCKED functions documented below with root causes
use test::{assert, assert_eq}

// --- index / index_mut are exercised via arr[i] syntax in array.test.tml ---
// The coverage tool may not track these as they use built-in codegen, not the impl body.

@test
func test_array_index_read() -> I32 {
    let arr: [I32; 3] = [10, 20, 30]
    let v: I32 = arr[1]
    assert(v == 20, "index should return element at position")
    return 0
}

@test
func test_array_index_mut_write() -> I32 {
    let mut arr: [I32; 3] = [10, 20, 30]
    arr[2] = 99
    assert(arr[2] == 99, "index_mut should allow writing element")
    return 0
}

@test
func test_array_as_slice() -> I32 {
    let arr: [I32; 3] = [1, 2, 3]
    let s = arr.as_slice()
    let len: I64 = s.len()
    assert(len == 3, "as_slice length should be 3")
    return 0
}

// --- PartialEq ---

@test
func test_array_eq() -> I32 {
    let a: [I32; 3] = [1, 2, 3]
    let b: [I32; 3] = [1, 2, 3]
    let c: [I32; 3] = [1, 2, 4]
    assert(a.eq(ref b), "equal arrays should return true")
    assert(not a.eq(ref c), "different arrays should return false")
    return 0
}

@test
func test_array_ne() -> I32 {
    let a: [I32; 3] = [1, 2, 3]
    let b: [I32; 3] = [1, 2, 4]
    assert(a.ne(ref b), "different arrays should return true for ne")
    return 0
}

// --- PartialOrd ---

@test
func test_array_partial_cmp() -> I32 {
    let a: [I32; 3] = [1, 2, 3]
    let b: [I32; 3] = [1, 2, 4]
    let c: [I32; 3] = [1, 2, 3]
    let r1 = a.partial_cmp(ref b)
    when r1 {
        Just(ord) => {
            when ord {
                Less => {}
                _ => { assert(false, "expected Less") }
            }
        }
        Nothing => { assert(false, "expected Just") }
    }
    let r2 = a.partial_cmp(ref c)
    when r2 {
        Just(ord) => {
            when ord {
                Equal => {}
                _ => { assert(false, "expected Equal") }
            }
        }
        Nothing => { assert(false, "expected Just") }
    }
    return 0
}

// --- Ord ---

@test
func test_array_cmp() -> I32 {
    let a: [I32; 3] = [1, 2, 3]
    let b: [I32; 3] = [1, 2, 4]
    let r = a.cmp(ref b)
    when r {
        Less => {}
        _ => { assert(false, "expected Less for cmp") }
    }
    return 0
}

// --- Duplicate / Clone ---

@test
func test_array_duplicate() -> I32 {
    let a: [I32; 3] = [10, 20, 30]
    let b: [I32; 3] = a.duplicate()
    assert(b[0] == 10, "duplicate elem 0")
    assert(b[1] == 20, "duplicate elem 1")
    assert(b[2] == 30, "duplicate elem 2")
    return 0
}

@test
func test_array_clone() -> I32 {
    let a: [I32; 3] = [10, 20, 30]
    let b: [I32; 3] = a.clone()
    assert(b[0] == 10, "clone elem 0")
    assert(b[1] == 20, "clone elem 1")
    assert(b[2] == 30, "clone elem 2")
    return 0
}

// --- Hash ---

@test
func test_array_hash() -> I32 {
    let a: [I32; 3] = [1, 2, 3]
    let h: I64 = a.hash()
    // Just verify it doesn't crash and returns a non-zero value
    assert(h != 0, "hash should be non-zero")
    return 0
}

// --- Display ---

@test
func test_array_to_string() -> I32 {
    let a: [I32; 3] = [1, 2, 3]
    let s: Str = a.to_string()
    // Basic check - should return some string representation
    assert(s.len() > 0, "to_string should return non-empty string")
    return 0
}

