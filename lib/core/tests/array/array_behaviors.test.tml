// Tests for Array uncovered functions
// BLOCKED functions documented below with root causes
use test::{assert, assert_eq}

// --- index / index_mut are exercised via arr[i] syntax in array.test.tml ---
// The coverage tool may not track these as they use built-in codegen, not the impl body.

@test
func test_array_index_read() -> I32 {
    let arr: [I32; 3] = [10, 20, 30]
    let v: I32 = arr[1]
    assert(v == 20, "index should return element at position")
    return 0
}

@test
func test_array_index_mut_write() -> I32 {
    let mut arr: [I32; 3] = [10, 20, 30]
    arr[2] = 99
    assert(arr[2] == 99, "index_mut should allow writing element")
    return 0
}

@test
func test_array_as_slice() -> I32 {
    let arr: [I32; 3] = [1, 2, 3]
    let s = arr.as_slice()
    let len: I64 = s.len()
    assert(len == 3, "as_slice length should be 3")
    return 0
}

