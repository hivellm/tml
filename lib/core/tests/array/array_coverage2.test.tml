// Tests for uncovered Array methods: Ord, Duplicate, Hash, eq_slice
// Many functions blocked by const generic inference bugs (try_map, zip, try_from_fn, repeat, from_ref, from_mut)
use test::{assert, assert_eq}
use core::array::{TryFromSliceError}
use core::slice::Slice

@test
func test_array_ord_cmp_equal() -> I32 {
    let a: [I32; 3] = [1, 2, 3]
    let b: [I32; 3] = [1, 2, 3]
    let ord: Ordering = a.cmp(ref b)
    assert(ord == Ordering::Equal, "identical arrays should be Equal")
    return 0
}

@test
func test_array_ord_cmp_less() -> I32 {
    let a: [I32; 3] = [1, 2, 3]
    let b: [I32; 3] = [1, 2, 4]
    let ord: Ordering = a.cmp(ref b)
    assert(ord == Ordering::Less, "a < b should be Less")
    return 0
}

@test
func test_array_ord_cmp_greater() -> I32 {
    let a: [I32; 3] = [1, 3, 3]
    let b: [I32; 3] = [1, 2, 3]
    let ord: Ordering = a.cmp(ref b)
    assert(ord == Ordering::Greater, "a > b should be Greater")
    return 0
}

// partial_cmp BLOCKED: returns () instead of Maybe[Ordering]

