@test
func test_array_tryfromsliceerror_to_string() -> I32 {
    let e: TryFromSliceError = TryFromSliceError { expected_len: 3, actual_len: 5 }
    let s: Str = e.to_string()
    assert(s.len() > 0, "to_string should return non-empty string")
    return 0
}

@test
func test_array_tryfromsliceerror_debug_string() -> I32 {
    let e: TryFromSliceError = TryFromSliceError { expected_len: 4, actual_len: 2 }
    let s: Str = e.debug_string()
    assert(s.len() > 0, "debug_string should return non-empty string")
    return 0
}

