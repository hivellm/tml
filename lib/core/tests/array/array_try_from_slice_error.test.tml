// Tests for TryFromSliceError Display and Debug
use test::{assert_eq}
use core::array::{TryFromSliceError}

@test
func test_try_from_slice_error_to_string() -> I32 {
    let err = TryFromSliceError { expected_len: 5, actual_len: 3 }
    let s: Str = err.to_string()
    assert_eq(s, "could not convert slice of length 3 to array of length 5", "to_string mismatch")
    return 0
}

@test
func test_try_from_slice_error_debug() -> I32 {
    let err = TryFromSliceError { expected_len: 2, actual_len: 7 }
    let s: Str = err.debug_string()
    assert_eq(s, "TryFromSliceError { expected: 2, actual: 7 }", "debug_string mismatch")
    return 0
}
