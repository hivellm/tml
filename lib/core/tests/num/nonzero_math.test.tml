// Tests for NonZero[I32] math methods
use test

use core::num::nonzero::NonZero

func nz32(v: I32) -> NonZero[I32] {
    return NonZero { value: v }
}

@test
func test_nonzero_i32_count_ones() -> I32 {
    let n: NonZero[I32] = nz32(7)
    assert_eq(n.count_ones(), 3, "7 = 0b111 has 3 ones")
    return 0
}

@test
func test_nonzero_i32_leading_zeros() -> I32 {
    let n: NonZero[I32] = nz32(16)
    assert_eq(n.leading_zeros(), 27, "16 has 27 leading zeros")
    return 0
}

@test
func test_nonzero_i32_trailing_zeros() -> I32 {
    let n: NonZero[I32] = nz32(8)
    assert_eq(n.trailing_zeros(), 3, "8 has 3 trailing zeros")
    return 0
}

@test
func test_nonzero_i32_pow() -> I32 {
    let n: NonZero[I32] = nz32(3)
    let result: NonZero[I32] = n.pow(4)
    assert_eq(result.get(), 81, "3^4 == 81")
    return 0
}

@test
func test_nonzero_i32_ilog2() -> I32 {
    let n: NonZero[I32] = nz32(8)
    assert_eq(n.ilog2(), 3, "ilog2(8) == 3")
    return 0
}

// NOTE: checked_add/sub/mul and saturating_add/sub/mul are implemented
// but BLOCKED by codegen: Maybe[NonZero[I32]] return type generates wrong IR.
// NonZero[I64] methods BLOCKED: dual concrete impl causes type confusion.
