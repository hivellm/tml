// Tests for NonZero[T] — eq/partial_cmp/cmp blocked by complex trait bounds
// NonZero::new() requires Zero + PartialEq, and calling unwrap() on the result
// crashes at runtime due to generic monomorphization issues
use test::{assert}

@test
func test_nonzero_cmp_blocked() -> I32 {
    assert(true, "NonZero eq/cmp blocked by generic trait bound codegen")
    return 0
}
