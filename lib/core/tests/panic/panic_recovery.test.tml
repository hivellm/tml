use test::{assert, assert_eq}
use core::panic::{catch_unwind_fn, set_hook, clear_hook, resume_unwind, CatchResult, PanicInfo}

func panics_boom() -> Unit {
    panic("boom")
}

func no_panic() -> Unit {
    let x: I64 = 1 + 1
}

@test
func test_panic_info_new() -> I32 {
    let info = PanicInfo::new("test message")
    assert_eq(info.message, "test message", "message field")
    assert_eq(info.line, 0, "line should be 0 when unknown")
    assert(not info.has_location(), "should have no location")
    return 0
}

@test
func test_panic_info_with_location() -> I32 {
    let info = PanicInfo::with_location("oops", "main.tml", 42, 5)
    assert_eq(info.message, "oops", "message")
    assert_eq(info.file, "main.tml", "file")
    assert_eq(info.line, 42, "line")
    assert_eq(info.column, 5, "column")
    assert(info.has_location(), "should have location")
    return 0
}

@test
func test_catch_no_panic() -> I32 {
    let fn_ptr: *U8 = lowlevel { no_panic as *U8 }
    let result = catch_unwind_fn(fn_ptr)
    when result {
        CatchResult::Ok => {},
        CatchResult::Panicked(msg) => {
            assert(false, "should not have panicked")
            return 1
        },
    }
    return 0
}

@test
func test_catch_panic() -> I32 {
    let fn_ptr: *U8 = lowlevel { panics_boom as *U8 }
    let result = catch_unwind_fn(fn_ptr)
    when result {
        CatchResult::Ok => {
            assert(false, "should have caught panic")
            return 1
        },
        CatchResult::Panicked(msg) => {
            assert_eq(msg, "boom", "panic message should match")
        },
    }
    return 0
}

@test
func test_catch_then_continue() -> I32 {
    // Catch a panic
    let panic_fn: *U8 = lowlevel { panics_boom as *U8 }
    let result = catch_unwind_fn(panic_fn)
    when result {
        CatchResult::Panicked(msg) => {},
        CatchResult::Ok => { return 1 },
    }

    // After catching, normal code still works
    let ok_fn: *U8 = lowlevel { no_panic as *U8 }
    let result2 = catch_unwind_fn(ok_fn)
    when result2 {
        CatchResult::Ok => {},
        CatchResult::Panicked(msg) => { return 1 },
    }
    return 0
}

func does_resume_unwind() -> Unit {
    let inner_fn: *U8 = lowlevel { panics_boom as *U8 }
    let result = catch_unwind_fn(inner_fn)
    when result {
        CatchResult::Panicked(msg) => resume_unwind(msg),
        CatchResult::Ok => {},
    }
}

@test
func test_resume_unwind() -> I32 {
    let fn_ptr: *U8 = lowlevel { does_resume_unwind as *U8 }
    let result = catch_unwind_fn(fn_ptr)
    when result {
        CatchResult::Panicked(msg) => {
            assert_eq(msg, "boom", "resume_unwind should propagate message")
        },
        CatchResult::Ok => {
            assert(false, "should have re-panicked")
            return 1
        },
    }
    return 0
}
