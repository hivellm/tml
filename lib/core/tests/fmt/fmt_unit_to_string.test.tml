// Tests for fmt/impls — Unit Display and Debug via to_string
use test::{assert, assert_eq}
use core::types::tuple::Unit
use core::fmt::Display

@test
func test_unit_to_string() -> I32 {
    let u = Unit::default()
    assert_eq(u.to_string(), "()", "Unit to_string is '()'")
    return 0
}

@test
func test_unit_to_string_len() -> I32 {
    let u = Unit::default()
    let s = u.to_string()
    assert_eq(s.len() as I32, 2, "Unit to_string length is 2")
    return 0
}
