// Tests for fmt::helpers — escape_string, escape_char
use test::{assert_eq}
use core::fmt::helpers::{escape_string, escape_char}

@test
func test_escape_string_passthrough() -> I32 {
    let result = escape_string("hello")
    assert_eq(result, "hello", "escape_string should pass through simple strings")
    return 0
}

@test
func test_escape_string_empty() -> I32 {
    let result = escape_string("")
    assert_eq(result, "", "escape_string should handle empty string")
    return 0
}

@test
func test_escape_char_simple() -> I32 {
    let result = escape_char('a')
    assert_eq(result, "a", "escape_char should convert simple char")
    return 0
}
