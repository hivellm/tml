// Tests for Unit Display/Debug implementations
use test::{assert, assert_eq}
use core::types::tuple::Unit
use core::fmt::Display
use core::fmt::Debug

@test
func test_unit_display() -> I32 {
    let u = Unit::default()
    let s = u.to_string()
    assert_eq(s, "()", "Unit::to_string should be '()'")
    return 0
}

@test
func test_unit_debug() -> I32 {
    let u = Unit::default()
    let d = u.debug_string()
    assert_eq(d, "()", "Unit::debug_string should be '()'")
    return 0
}
