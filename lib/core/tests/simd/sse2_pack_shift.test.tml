use test
use core::simd::i32x4::I32x4
use core::runtime::intrinsics::{
    sse2_slli_epi32, sse2_srli_epi32, sse2_srai_epi32
}

@test
func test_slli_epi32_by_2() -> I32 {
    let a = I32x4::new(1, 2, 3, 4)
    let result: I32x4 = lowlevel { sse2_slli_epi32(a, 2) }
    assert_eq(result.get(0), 4)
    assert_eq(result.get(1), 8)
    assert_eq(result.get(2), 12)
    assert_eq(result.get(3), 16)
    0
}

@test
func test_slli_epi32_by_0() -> I32 {
    let a = I32x4::new(10, 20, 30, 40)
    let result: I32x4 = lowlevel { sse2_slli_epi32(a, 0) }
    assert_eq(result.get(0), 10)
    assert_eq(result.get(3), 40)
    0
}

@test
func test_srli_epi32_by_2() -> I32 {
    let a = I32x4::new(16, 32, 64, 128)
    let result: I32x4 = lowlevel { sse2_srli_epi32(a, 2) }
    assert_eq(result.get(0), 4)
    assert_eq(result.get(1), 8)
    assert_eq(result.get(2), 16)
    assert_eq(result.get(3), 32)
    0
}

@test
func test_srai_epi32_positive() -> I32 {
    let a = I32x4::new(16, 32, 64, 128)
    let result: I32x4 = lowlevel { sse2_srai_epi32(a, 1) }
    assert_eq(result.get(0), 8)
    assert_eq(result.get(1), 16)
    assert_eq(result.get(2), 32)
    assert_eq(result.get(3), 64)
    0
}

@test
func test_srai_epi32_negative() -> I32 {
    let a = I32x4::new(-4, -8, -16, -32)
    let result: I32x4 = lowlevel { sse2_srai_epi32(a, 1) }
    // Arithmetic right shift preserves sign: -4>>1 = -2
    assert_eq(result.get(0), -2)
    assert_eq(result.get(1), -4)
    assert_eq(result.get(2), -8)
    assert_eq(result.get(3), -16)
    0
}
