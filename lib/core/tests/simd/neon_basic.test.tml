// v2
use test
use core::simd::neon::{
    neon_add_i32, neon_sub_i32, neon_mul_i32,
    neon_add_i64, neon_sub_i64,
    neon_add_f32, neon_sub_f32, neon_mul_f32,
    neon_add_f64, neon_sub_f64, neon_mul_f64
}
use core::simd::i32x4::I32x4
use core::simd::i64x2::I64x2
use core::simd::f32x4::F32x4
use core::simd::f64x2::F64x2

@test
func test_neon_add_i32() -> Outcome[Unit, Str] {
    let a = I32x4::new(1, 2, 3, 4)
    let b = I32x4::new(10, 20, 30, 40)
    let r = neon_add_i32(a, b)
    assert_eq(r.get(0), 11)
    assert_eq(r.get(1), 22)
    assert_eq(r.get(2), 33)
    assert_eq(r.get(3), 44)
    Ok(())
}

@test
func test_neon_sub_i32() -> Outcome[Unit, Str] {
    let a = I32x4::new(100, 200, 300, 400)
    let b = I32x4::new(1, 2, 3, 4)
    let r = neon_sub_i32(a, b)
    assert_eq(r.get(0), 99)
    assert_eq(r.get(3), 396)
    Ok(())
}

@test
func test_neon_mul_i32() -> Outcome[Unit, Str] {
    let a = I32x4::new(2, 3, 4, 5)
    let b = I32x4::new(10, 10, 10, 10)
    let r = neon_mul_i32(a, b)
    assert_eq(r.get(0), 20)
    assert_eq(r.get(1), 30)
    assert_eq(r.get(2), 40)
    assert_eq(r.get(3), 50)
    Ok(())
}

@test
func test_neon_add_i64() -> Outcome[Unit, Str] {
    let a = I64x2::new(100 as I64, 200 as I64)
    let b = I64x2::new(1 as I64, 2 as I64)
    let r = neon_add_i64(a, b)
    assert_eq(r.get(0), 101 as I64)
    assert_eq(r.get(1), 202 as I64)
    Ok(())
}

@test
func test_neon_sub_i64() -> Outcome[Unit, Str] {
    let a = I64x2::new(50 as I64, 100 as I64)
    let b = I64x2::new(10 as I64, 25 as I64)
    let r = neon_sub_i64(a, b)
    assert_eq(r.get(0), 40 as I64)
    assert_eq(r.get(1), 75 as I64)
    Ok(())
}

@test
func test_neon_add_f32() -> Outcome[Unit, Str] {
    let a = F32x4::new(1.0 as F32, 2.0 as F32, 3.0 as F32, 4.0 as F32)
    let b = F32x4::splat(0.5 as F32)
    let r = neon_add_f32(a, b)
    assert_eq(r.get(0), 1.5 as F32)
    assert_eq(r.get(3), 4.5 as F32)
    Ok(())
}

@test
func test_neon_mul_f32() -> Outcome[Unit, Str] {
    let a = F32x4::new(2.0 as F32, 3.0 as F32, 4.0 as F32, 5.0 as F32)
    let b = F32x4::splat(2.0 as F32)
    let r = neon_mul_f32(a, b)
    assert_eq(r.get(0), 4.0 as F32)
    assert_eq(r.get(1), 6.0 as F32)
    assert_eq(r.get(2), 8.0 as F32)
    assert_eq(r.get(3), 10.0 as F32)
    Ok(())
}

@test
func test_neon_add_f64() -> Outcome[Unit, Str] {
    let a = F64x2::new(1.5, 2.5)
    let b = F64x2::new(0.5, 1.5)
    let r = neon_add_f64(a, b)
    assert_eq(r.get(0), 2.0)
    assert_eq(r.get(1), 4.0)
    Ok(())
}

@test
func test_neon_mul_f64() -> Outcome[Unit, Str] {
    let a = F64x2::new(2.0, 3.0)
    let b = F64x2::new(4.0, 5.0)
    let r = neon_mul_f64(a, b)
    assert_eq(r.get(0), 8.0)
    assert_eq(r.get(1), 15.0)
    Ok(())
}
