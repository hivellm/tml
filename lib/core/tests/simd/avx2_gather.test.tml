use test
use core::simd::i32x8::I32x8
use core::runtime::intrinsics::{
    avx2_gather_epi32,
    ptr_write, ptr_offset
}

@test
func test_avx2_gather_epi32_sequential() -> I32 {
    lowlevel {
        let buf = mem_alloc(32)
        ptr_write[I32](buf, 100)
        ptr_write[I32](ptr_offset[I32](buf, 1), 200)
        ptr_write[I32](ptr_offset[I32](buf, 2), 300)
        ptr_write[I32](ptr_offset[I32](buf, 3), 400)
        ptr_write[I32](ptr_offset[I32](buf, 4), 500)
        ptr_write[I32](ptr_offset[I32](buf, 5), 600)
        ptr_write[I32](ptr_offset[I32](buf, 6), 700)
        ptr_write[I32](ptr_offset[I32](buf, 7), 800)

        // Gather in order: indices [0, 1, 2, 3, 4, 5, 6, 7]
        let indices = I32x8::new(0, 1, 2, 3, 4, 5, 6, 7)
        let mask = I32x8::splat(-1)
        var result: I32x8 = I32x8::zero()
        result = avx2_gather_epi32(buf, indices, mask, 4 as I8)

        assert_eq(result.get(0), 100)
        assert_eq(result.get(1), 200)
        assert_eq(result.get(2), 300)
        assert_eq(result.get(3), 400)
        assert_eq(result.get(4), 500)
        assert_eq(result.get(5), 600)
        assert_eq(result.get(6), 700)
        assert_eq(result.get(7), 800)

        mem_free(buf)
    }
    0
}

@test
func test_avx2_gather_epi32_permuted() -> I32 {
    lowlevel {
        let buf = mem_alloc(32)
        ptr_write[I32](buf, 10)
        ptr_write[I32](ptr_offset[I32](buf, 1), 20)
        ptr_write[I32](ptr_offset[I32](buf, 2), 30)
        ptr_write[I32](ptr_offset[I32](buf, 3), 40)
        ptr_write[I32](ptr_offset[I32](buf, 4), 50)
        ptr_write[I32](ptr_offset[I32](buf, 5), 60)
        ptr_write[I32](ptr_offset[I32](buf, 6), 70)
        ptr_write[I32](ptr_offset[I32](buf, 7), 80)

        // Gather reversed: [7, 6, 5, 4, 3, 2, 1, 0]
        let indices = I32x8::new(7, 6, 5, 4, 3, 2, 1, 0)
        let mask = I32x8::splat(-1)
        var result: I32x8 = I32x8::zero()
        result = avx2_gather_epi32(buf, indices, mask, 4 as I8)

        assert_eq(result.get(0), 80)
        assert_eq(result.get(1), 70)
        assert_eq(result.get(2), 60)
        assert_eq(result.get(3), 50)
        assert_eq(result.get(4), 40)
        assert_eq(result.get(5), 30)
        assert_eq(result.get(6), 20)
        assert_eq(result.get(7), 10)

        mem_free(buf)
    }
    0
}

@test
func test_avx2_gather_epi32_partial_mask() -> I32 {
    lowlevel {
        let buf = mem_alloc(32)
        ptr_write[I32](buf, 111)
        ptr_write[I32](ptr_offset[I32](buf, 1), 222)
        ptr_write[I32](ptr_offset[I32](buf, 2), 333)
        ptr_write[I32](ptr_offset[I32](buf, 3), 444)
        ptr_write[I32](ptr_offset[I32](buf, 4), 555)
        ptr_write[I32](ptr_offset[I32](buf, 5), 666)
        ptr_write[I32](ptr_offset[I32](buf, 6), 777)
        ptr_write[I32](ptr_offset[I32](buf, 7), 888)

        // Gather with partial mask: only even lanes active
        let indices = I32x8::new(0, 1, 2, 3, 4, 5, 6, 7)
        let mask = I32x8::new(-1, 0, -1, 0, -1, 0, -1, 0)
        var result: I32x8 = I32x8::zero()
        result = avx2_gather_epi32(buf, indices, mask, 4 as I8)

        // Active lanes get gathered value, inactive lanes get passthru (0)
        assert_eq(result.get(0), 111)
        assert_eq(result.get(1), 0)    // masked off
        assert_eq(result.get(2), 333)
        assert_eq(result.get(3), 0)    // masked off
        assert_eq(result.get(4), 555)
        assert_eq(result.get(5), 0)    // masked off
        assert_eq(result.get(6), 777)
        assert_eq(result.get(7), 0)    // masked off

        mem_free(buf)
    }
    0
}
