use test
use core::simd::i32x8::I32x8
use core::simd::f32x8::F32x8

@test
func test_i32x8_new_and_get() -> I32 {
    let v = I32x8::new(10, 20, 30, 40, 50, 60, 70, 80)
    assert_eq(v.get(0), 10)
    assert_eq(v.get(3), 40)
    assert_eq(v.get(7), 80)
    0
}

@test
func test_i32x8_splat() -> I32 {
    let v = I32x8::splat(42)
    assert_eq(v.get(0), 42)
    assert_eq(v.get(7), 42)
    0
}

@test
func test_i32x8_add() -> I32 {
    let a = I32x8::new(1, 2, 3, 4, 5, 6, 7, 8)
    let b = I32x8::splat(10)
    let c = a.add(b)
    assert_eq(c.get(0), 11)
    assert_eq(c.get(7), 18)
    assert_eq(c.sum(), 116)
    0
}

@test
func test_i32x8_sub() -> I32 {
    let a = I32x8::splat(100)
    let b = I32x8::new(1, 2, 3, 4, 5, 6, 7, 8)
    let c = a.sub(b)
    assert_eq(c.get(0), 99)
    assert_eq(c.get(7), 92)
    0
}

@test
func test_i32x8_mul() -> I32 {
    let a = I32x8::new(1, 2, 3, 4, 5, 6, 7, 8)
    let b = I32x8::splat(3)
    let c = a.mul(b)
    assert_eq(c.get(0), 3)
    assert_eq(c.get(7), 24)
    0
}

@test
func test_f32x8_add() -> I32 {
    let a = F32x8::splat(1.5)
    let b = F32x8::splat(2.5)
    let c = a.add(b)
    assert_true(c.get(0) > 3.9 and c.get(0) < 4.1)
    0
}

@test
func test_f32x8_mul() -> I32 {
    let a = F32x8::splat(3.0)
    let b = F32x8::splat(2.0)
    let c = a.mul(b)
    assert_true(c.get(0) > 5.9 and c.get(0) < 6.1)
    assert_true(c.get(7) > 5.9 and c.get(7) < 6.1)
    0
}
