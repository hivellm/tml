// Tests for core::ops::try_trait — from_output, from_residual (Try + FromResidual impls)
use test::{assert, assert_eq}
use core::ops::try_trait::{ControlFlow}

// === Maybe Try: from_output ===

@test
func test_maybe_from_output() -> I32 {
    let m: Maybe[I32] = Maybe::from_output(42)
    when m {
        Just(v) => assert_eq(v, 42, "from_output should produce Just(42)"),
        Nothing => assert(false, "from_output should not produce Nothing"),
    }
    return 0
}

@test
func test_maybe_from_output_i64() -> I32 {
    let m: Maybe[I64] = Maybe::from_output(100 as I64)
    assert(m.is_just(), "from_output I64 should produce Just")
    return 0
}

@test
func test_maybe_from_output_bool() -> I32 {
    let m: Maybe[Bool] = Maybe::from_output(true)
    assert(m.is_just(), "from_output Bool should produce Just")
    return 0
}
