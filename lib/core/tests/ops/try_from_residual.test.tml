// Tests for core::ops::try_trait — FromResidual impls
use test::{assert, assert_eq}
use core::ops::try_trait::Try

@test
func test_outcome_from_residual_str() -> I32 {
    let r: Outcome[I32, Str] = Outcome::from_residual("error msg")
    when r {
        Ok(_) => assert(false, "should be Err"),
        Err(e) => assert_eq(e, "error msg", "from_residual value")
    }
    return 0
}

@test
func test_outcome_from_residual_i32() -> I32 {
    let r: Outcome[Str, I32] = Outcome::from_residual(42)
    when r {
        Ok(_) => assert(false, "should be Err"),
        Err(e) => assert_eq(e, 42, "from_residual i32 value")
    }
    return 0
}

@test
func test_maybe_from_residual_unit() -> I32 {
    let r: Maybe[I32] = Maybe::from_residual(())
    when r {
        Just(_) => assert(false, "should be Nothing"),
        Nothing => assert(true, "from_residual returns Nothing")
    }
    return 0
}
