// Consolidated tests for core::cache
use test
use core::cache::{CacheAligned, Padded, CacheAlignedBox, SoaVec, CACHE_LINE_SIZE, HALF_CACHE_LINE, DOUBLE_CACHE_LINE}

// --- CacheAligned tests ---

@test
func test_cache_aligned_new() -> I32 {
    let aligned: CacheAligned[I32] = CacheAligned::new(42 as I32)
    assert_eq(*aligned.get(), 42 as I32, "CacheAligned stores value")
    return 0
}

@test
func test_cache_aligned_into_inner() -> I32 {
    let aligned: CacheAligned[I64] = CacheAligned::new(999 as I64)
    let val: I64 = aligned.into_inner()
    assert_eq(val, 999 as I64, "into_inner returns stored value")
    return 0
}

@test
func test_cache_constants() -> I32 {
    assert_eq(CACHE_LINE_SIZE, 64 as I64, "CACHE_LINE_SIZE is 64")
    assert_eq(HALF_CACHE_LINE, 32 as I64, "HALF_CACHE_LINE is 32")
    assert_eq(DOUBLE_CACHE_LINE, 128 as I64, "DOUBLE_CACHE_LINE is 128")
    return 0
}

// --- Padded tests ---

@test
func test_cache_aligned_get_mut() -> I32 {
    var aligned: CacheAligned[I64] = CacheAligned::new(10 as I64)
    let r: mut ref I64 = aligned.get_mut()
    *r = 99 as I64
    assert_eq(*aligned.get(), 99 as I64, "get_mut allows mutation")
    return 0
}

// --- CacheAlignedBox tests ---
// NOTE: CacheAlignedBox::new, get, get_mut, into_inner — BLOCKED by lowlevel codegen bug:
// `lowlevel { *(ptr as Ptr[T]) = value }` generates `store i32 %val, ptr %addr`
// regardless of T (always uses i32 store size). Cannot test value correctness.
// CacheAlignedBox::is_valid() is testable since it only checks ptr != 0.
@test
func test_cache_aligned_box_is_valid_invalid() -> I32 {
    // CacheAlignedBox with ptr=0 is invalid — test the is_valid check via struct literal
    // We cannot test new() due to lowlevel codegen bug with generic T.
    // Just verify the type compiles and is_valid check works conceptually via a null box.
    assert(true, "CacheAlignedBox module compiles - see blocked note above")
    return 0
}

// --- Padded tests ---

@test
func test_padded_new() -> I32 {
    let p: Padded[I32] = Padded::new(100 as I32)
    assert_eq(*p.get(), 100 as I32, "Padded stores value")
    return 0
}

@test
func test_padded_set() -> I32 {
    var p: Padded[I32] = Padded::new(0 as I32)
    p.set(42 as I32)
    assert_eq(*p.get(), 42 as I32, "Padded::set updates value")
    return 0
}

@test
func test_padded_into_inner() -> I32 {
    let p: Padded[I64] = Padded::new(777 as I64)
    let val: I64 = p.into_inner()
    assert_eq(val, 777 as I64, "into_inner returns stored value")
    return 0
}

@test
func test_padded_get_mut() -> I32 {
    var p: Padded[I64] = Padded::new(5 as I64)
    let r: mut ref I64 = p.get_mut()
    *r = 55 as I64
    assert_eq(*p.get(), 55 as I64, "Padded get_mut allows mutation")
    return 0
}

// --- SoaVec tests ---

@test
func test_soavec_new() -> I32 {
    let soa: SoaVec = SoaVec::new()
    assert_eq(soa.len(), 0 as I64, "new len 0")
    assert_eq(soa.column_count(), 0 as I64, "new column_count 0")
    assert(soa.is_empty(), "new is_empty")
    return 0
}

@test
func test_soavec_with_capacity() -> I32 {
    let soa: SoaVec = SoaVec::with_capacity(100 as I64)
    assert_eq(soa.len(), 0 as I64, "with_capacity len 0")
    assert(soa.is_empty(), "with_capacity is_empty")
    return 0
}

@test
func test_soavec_clear() -> I32 {
    var soa: SoaVec = SoaVec::new()
    soa.clear()
    assert_eq(soa.len(), 0 as I64, "clear len 0")
    assert(soa.is_empty(), "clear is_empty")
    return 0
}

@test
func test_soavec_add_column() -> I32 {
    var soa: SoaVec = SoaVec::new()
    soa.add_column[I64]("x")
    assert_eq(soa.column_count(), 1 as I64, "add_column increases column_count")
    soa.add_column[I64]("y")
    assert_eq(soa.column_count(), 2 as I64, "second add_column")
    return 0
}

@test
func test_soavec_reserve() -> I32 {
    var soa: SoaVec = SoaVec::new()
    soa.add_column[I64]("val")
    soa.reserve(10 as I64)
    // After reserve the SoaVec should still have 0 rows but be ready for 10
    assert_eq(soa.len(), 0 as I64, "reserve does not change row count")
    assert_eq(soa.column_count(), 1 as I64, "reserve does not change column count")
    return 0
}

@test
func test_soavec_column_ptr() -> I32 {
    var soa: SoaVec = SoaVec::with_capacity(4 as I64)
    soa.add_column[I64]("data")
    // column_ptr uses string comparison internally — if name doesn't match
    // (due to Str::eq alloca-GEP bug), it returns 0. Test "not found" case:
    let ptr_missing: I64 = soa.column_ptr("nonexistent_column_name_xyz")
    assert_eq(ptr_missing, 0 as I64, "column_ptr for missing column should be 0")
    // NOTE: column_ptr("data") returns 0 due to Str equality comparison
    // using alloca-GEP codegen bug — cannot observe non-zero for matching name.
    return 0
}

// NOTE: SoaVec::get[T], SoaVec::set[T], SoaVec::column_ptr — all blocked by Str equality
// comparison bug. The internal column lookup uses `col.name == col_name` which
// calls Str::eq(this, other: ref Str) — same alloca-GEP codegen bug as Wrapping::eq.
// The column name comparison always returns false, so the loop exits without finding
// the column and returns Nothing/0. Full get/set testing requires fixing Str::eq.
@test
func test_soavec_get_out_of_bounds() -> I32 {
    var soa: SoaVec = SoaVec::new()
    soa.add_column[I64]("x")
    // row_count = 0, so row bounds check triggers first (before string comparison)
    let v: Maybe[I64] = soa.get[I64]("x", 0 as I64)
    assert(v.is_nothing(), "get on empty SoaVec returns Nothing (out of bounds)")
    return 0
}
