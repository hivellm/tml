// LazyCell coverage — real tests in lazy_cell.test.tml
// This file kept for backward compatibility
use test::{assert}
use core::cell::lazy::LazyCell

@test
func test_lazy_cell_new_and_is_initialized() -> I32 {
    let cell = LazyCell[I32, func() -> I32]::new(do() -> I32 { return 1 })
    assert(not cell.is_initialized(), "new LazyCell should not be initialized")
    return 0
}
