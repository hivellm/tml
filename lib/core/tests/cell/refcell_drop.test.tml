// Tests for Ref[T]::drop and RefMut[T]::drop (implicit via scope exit)
use test::{assert, assert_eq}
use core::cell::ref_cell::RefCell

// Ref::drop is exercised by borrowing, then letting the Ref go out of scope
// and borrowing again (which would panic if drop didn't release the borrow)
@test
func test_ref_drop_releases_borrow() -> I32 {
    var cell: RefCell[I32] = RefCell::new(5)
    // First borrow -- Ref created
    let r1 = cell.borrow()
    let v1: ref I32 = r1.get()
    assert_eq(*v1, 5, "first borrow reads 5")
    // r1 dropped here (Ref::drop decrements borrow count)
    // NOTE: TML does not have explicit block-scoped drops yet,
    // so we rely on the implicit drop at function end. Since both
    // borrows are immutable, multiple Refs can coexist.
    let r2 = cell.borrow()
    let v2: ref I32 = r2.get()
    assert_eq(*v2, 5, "second borrow reads 5 (Ref::drop worked)")
    return 0
}

// RefMut::drop is exercised similarly
@test
func test_refmut_drop_releases_borrow() -> I32 {
    var cell: RefCell[I32] = RefCell::new(10)
    // borrow_mut creates RefMut, which sets state to Writing
    let rm = cell.borrow_mut()
    let v: mut ref I32 = rm.get_mut()
    *v = 20
    assert_eq(*v, 20, "borrow_mut allows mutation to 20")
    // rm dropped here (RefMut::drop resets borrow_state to Unused)
    // After drop, we should be able to use the cell again via get_mut
    assert_eq(*cell.get_mut(), 20, "value persists after RefMut drop")
    return 0
}
