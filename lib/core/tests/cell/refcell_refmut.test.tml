// Tests for RefMut[T] — get (read-only), replace
use test::{assert, assert_eq}
use core::cell::ref_cell::RefCell

@test
func test_refmut_get_reads_value() -> I32 {
    var cell: RefCell[I32] = RefCell::new(42)
    let rm = cell.borrow_mut()
    let v: ref I32 = rm.get()
    assert_eq(*v, 42, "RefMut::get should read stored value")
    return 0
}

