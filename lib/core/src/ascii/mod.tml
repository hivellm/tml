//! Operations on ASCII strings and characters.
//!
//! This module provides types and utilities for working with ASCII data.
//! ASCII (American Standard Code for Information Interchange) is a character
//! encoding standard that uses 7 bits to represent 128 characters.
//!
//! # Main Types
//!
//! - [`AsciiChar`]: An ASCII character (byte value 0-127)
//!
//! # Examples
//!
//! ```tml
//! use core::ascii::AsciiChar
//!
//! when AsciiChar::from_u8(65) {
//!     Just(ch) => {
//!         assert(ch.is_alphabetic())
//!         assert_eq(ch.to_lowercase().to_u8(), 97)
//!     },
//!     Nothing => panic("65 is valid ASCII")
//! }
//! ```

pub mod char       // AsciiChar type
pub mod functions  // standalone U8 classification/conversion functions

// Re-export main types
pub use char::AsciiChar
pub use char::to_string

// Re-export standalone functions
pub use functions::is_ascii_alphabetic
pub use functions::is_ascii_digit
pub use functions::is_ascii_alphanumeric
pub use functions::is_ascii_whitespace
pub use functions::is_ascii_uppercase
pub use functions::is_ascii_lowercase
pub use functions::is_ascii_punctuation
pub use functions::is_ascii_control
pub use functions::to_ascii_lowercase
pub use functions::to_ascii_uppercase
