//! Future join combinators — wait for all futures to complete.
//!
//! # `Join2` — Join Two Futures
//!
//! `Join2` polls two futures concurrently and returns both results as a tuple
//! when both are complete. Unlike `select`, which returns the first to finish,
//! `join` waits for ALL futures to complete.
//!
//! ```tml
//! use core::future::join::Join2
//! use core::task::{Ready}
//!
//! var a = Ready::new(10)
//! var b = Ready::new(20)
//! // join2 polls both and returns (10, 20) when both are ready
//! ```

use core::task::{Poll, Context}
use core::runtime::pin::Pin
use core::future::Future

// ============================================================================
// Join2 — Wait for two futures to complete
// ============================================================================

/// Holds two futures and their cached results.
///
/// When polled, it polls each incomplete future. Once both have produced
/// a value, it returns `Poll::Ready((a_result, b_result))`.
pub type Join2[A, B] {
    a: A,
    b: B,
    a_result: Maybe[I64],
    b_result: Maybe[I64],
}

impl[A, B] Join2[A, B] {
    /// Create a new Join2 that will wait for both futures.
    pub func new(a: A, b: B) -> Join2[A, B] {
        return Join2 {
            a: a,
            b: b,
            a_result: Nothing,
            b_result: Nothing,
        }
    }

    /// Check if both results are available.
    pub func is_complete(this) -> Bool {
        return this.a_result.is_just() and this.b_result.is_just()
    }
}

// ============================================================================
// Join3 — Wait for three futures to complete
// ============================================================================

/// Holds three futures and their cached results.
pub type Join3[A, B, C] {
    a: A,
    b: B,
    c: C,
    a_result: Maybe[I64],
    b_result: Maybe[I64],
    c_result: Maybe[I64],
}

impl[A, B, C] Join3[A, B, C] {
    /// Create a new Join3 that will wait for all three futures.
    pub func new(a: A, b: B, c: C) -> Join3[A, B, C] {
        return Join3 {
            a: a,
            b: b,
            c: c,
            a_result: Nothing,
            b_result: Nothing,
            c_result: Nothing,
        }
    }

    /// Check if all three results are available.
    pub func is_complete(this) -> Bool {
        return this.a_result.is_just() and this.b_result.is_just() and this.c_result.is_just()
    }
}

// ============================================================================
// Helper function — join two values
// ============================================================================

/// Create a Join2 from two futures.
///
/// # Examples
///
/// ```tml
/// use core::future::join::join2
/// use core::task::Ready
///
/// let joined = join2(Ready::new(1), Ready::new(2))
/// // When polled: returns (1, 2)
/// ```
pub func join2[A, B](a: A, b: B) -> Join2[A, B] {
    return Join2::new(a, b)
}

/// Create a Join3 from three futures.
pub func join3[A, B, C](a: A, b: B, c: C) -> Join3[A, B, C] {
    return Join3::new(a, b, c)
}
