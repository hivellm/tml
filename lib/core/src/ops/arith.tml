// ============================================================================

/// `I8 / I8 -> I8` (truncating division)
impl Div for I8 {
    /// Divides self by rhs, returning the I8 quotient.
    pub func div(this, rhs: I8) -> I8 {
        return this / rhs
    }
}

/// `I16 / I16 -> I16` (truncating division)
impl Div for I16 {
    /// Divides self by rhs, returning the I16 quotient.
    pub func div(this, rhs: I16) -> I16 {
        return this / rhs
    }
}

