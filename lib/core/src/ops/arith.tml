impl Rem for I32 {
    /// Returns the remainder of self divided by rhs as I32.
    pub func rem(this, rhs: I32) -> I32 {
        return this % rhs
    }
}

/// `I64 % I64 -> I64`
impl Rem for I64 {
    /// Returns the remainder of self divided by rhs as I64.
    pub func rem(this, rhs: I64) -> I64 {
        return this % rhs
    }
}

/// `U8 % U8 -> U8`
impl Rem for U8 {
    /// Returns the remainder of self divided by rhs as U8.
    pub func rem(this, rhs: U8) -> U8 {
        return this % rhs
    }
}

/// `U16 % U16 -> U16`
impl Rem for U16 {
    /// Returns the remainder of self divided by rhs as U16.
    pub func rem(this, rhs: U16) -> U16 {
        return this % rhs
    }
}

/// `U32 % U32 -> U32`
impl Rem for U32 {
    /// Returns the remainder of self divided by rhs as U32.
