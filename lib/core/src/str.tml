//! String manipulation utilities.
//!
//! This module provides functions for working with strings. All functions
//! operate on TML's `Str` type, which is a UTF-8 encoded string.
//!
//! # Categories
//!
//! ## Length and Emptiness
//! - [`len`] - Get string length in bytes
//! - [`is_empty`] - Check if string is empty
//!
//! ## Character Access
//! - [`char_at`] - Get character at byte index
//! - [`first_char`] / [`last_char`] - Get first/last character
//!
//! ## Substrings
//! - [`substring`] - Extract a portion of the string
//! - [`substring_from`] / [`substring_to`] - Partial extraction
//!
//! ## Trimming
//! - [`trim`] - Remove leading and trailing whitespace
//! - [`trim_start`] / [`trim_end`] - Trim one side
//!
//! ## Case Conversion
//! - [`to_uppercase`] / [`to_lowercase`] - Convert case
//!
//! ## Searching
//! - [`contains`] - Check if substring exists
//! - [`starts_with`] / [`ends_with`] - Check prefix/suffix
//! - [`find`] / [`rfind`] - Find substring position
//!
//! ## Splitting
//! - [`split`] - Split by delimiter
//! - [`split_whitespace`] - Split by whitespace
//! - [`lines`] - Split into lines
//!
//! ## Replacement
//! - [`replace`] - Replace all occurrences
//! - [`replace_first`] - Replace first occurrence
//!
//! ## Building
//! - [`repeat`] - Repeat string N times
//! - [`pad_left`] / [`pad_right`] - Add padding
//! - [`join`] - Join strings with separator
//! - [`concat`] / [`concat_all`] - Concatenate strings
//!
//! ## Parsing
//! - [`parse_i32`] / [`parse_i64`] / [`parse_f64`] - Parse numbers
//! - [`parse_bool`] - Parse boolean
//!
//! # Examples
//!
//! ```tml
//! use core::str::*
//!
//! let s = "  Hello, World!  "
//!
//! // Trimming
//! assert(trim(s) == "Hello, World!")
//!
//! // Searching
//! assert(contains(s, "World"))
//! assert(find(s, "World") == Just(9))
//!
//! // Splitting
//! let words = split(trim(s), ", ")
//! assert(words.len() == 2)
//!
//! // Case conversion
//! assert(to_uppercase("hello") == "HELLO")
//! ```


// ============================================================================
// FFI declarations for optimized C library string functions
// ============================================================================

@extern("strlen")
func c_strlen(s: Str) -> I64

@extern("memcmp")
func c_memcmp(a: *U8, b: *U8, n: I64) -> I32

@extern("memchr")
func c_memchr(s: *U8, c: I32, n: I64) -> *U8

// ============================================================================
// String Length and Emptiness
// ============================================================================

/// Returns the length of a string in bytes.
///
/// Note: This returns the byte length, not the character count. For UTF-8
/// strings with multi-byte characters, this may differ from the visible
/// character count.
///
/// # Examples
///
/// ```tml
/// assert(len("hello") == 5)
/// assert(len("") == 0)
/// ```
pub func len(s: Str) -> I64 {
    let addr: I64 = s as I64
    if addr == 0 {
        return 0
    }
    return c_strlen(s)
}

/// Returns `true` if the string is empty.
///
/// # Examples
///
/// ```tml
/// assert(is_empty("") == true)
/// assert(is_empty("hello") == false)
/// ```
pub func is_empty(s: Str) -> Bool {
    return len(s) == 0
}

// ============================================================================
// Character Access
// ============================================================================

/// Returns the character at the given byte index.
///
/// # Panics
///
/// Panics if the index is out of bounds.
///
/// # Examples
///
/// ```tml
/// assert(char_at("hello", 0) == 'h')
/// assert(char_at("hello", 4) == 'o')
/// ```
pub func char_at(s: Str, index: I64) -> I32 {
    let ptr_addr: I64 = s as I64
    if ptr_addr == 0 or index < 0 {
        return 0
    }
    let p: *U8 = (ptr_addr + index) as *U8
    let byte: U8 = lowlevel { ptr_read[U8](p) }
    return byte as I32
}

/// Returns the first character of the string, or `Nothing` if empty.
///
/// # Examples
///
/// ```tml
/// assert(first_char("hello") == Just('h'))
/// assert(first_char("") == Nothing)
/// ```
pub func first_char(s: Str) -> Maybe[I32] {
    if is_empty(s) {
        return Nothing
    }
    return Just(char_at(s, 0))
}

/// Returns the last character of the string, or `Nothing` if empty.
///
/// # Examples
///
/// ```tml
/// assert(last_char("hello") == Just('o'))
/// assert(last_char("") == Nothing)
/// ```
pub func last_char(s: Str) -> Maybe[I32] {
    let length: I64 = len(s)
    if length == 0 {
        return Nothing
    }
    return Just(char_at(s, length - 1))
}

// ============================================================================
// Substring Operations
// ============================================================================

/// Returns a substring from `start` to `end` (exclusive).
///
/// # Arguments
///
/// * `s` - The source string
/// * `start` - Starting byte index (inclusive)
/// * `end` - Ending byte index (exclusive)
///
/// # Examples
///
/// ```tml
/// assert(substring("hello", 1, 4) == "ell")
/// assert(substring("hello", 0, 5) == "hello")
/// ```
@allocates
pub func substring(s: Str, start: I64, end: I64) -> Str {
    let s_len: I64 = len(s)
    let st: I64 = start
    var en: I64 = end
    if st < 0 or st >= s_len or en <= st {
        return ""
    }
    if en > s_len {
        en = s_len
    }
    let sub_len: I64 = en - st
    let buf: *Unit = lowlevel { mem_alloc(sub_len + 1) }
    lowlevel { copy_nonoverlapping((s as I64 + st) as *U8, buf as *U8, sub_len) }
    lowlevel { ptr_write[U8]((buf as I64 + sub_len) as *U8, 0 as U8) }
    return buf as Str
}

/// Returns a substring from `start` to the end of the string.
///
/// # Examples
///
/// ```tml
/// assert(substring_from("hello", 2) == "llo")
/// ```
@allocates
pub func substring_from(s: Str, start: I64) -> Str {
    return substring(s, start, len(s))
}

/// Returns a substring from the beginning to `end` (exclusive).
///
/// # Examples
///
/// ```tml
/// assert(substring_to("hello", 3) == "hel")
/// ```
@allocates
pub func substring_to(s: Str, end: I64) -> Str {
    return substring(s, 0, end)
}

// ============================================================================
// Trimming
// ============================================================================

/// Returns true if a byte value is ASCII whitespace (space, tab, newline, carriage return).
func is_whitespace(b: I32) -> Bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

/// Removes leading and trailing whitespace from a string.
///
/// # Examples
///
/// ```tml
/// assert(trim("  hello  ") == "hello")
/// assert(trim("\n\thello\t\n") == "hello")
/// ```
@allocates
pub func trim(s: Str) -> Str {
    let s_len: I64 = len(s)
    if s_len == 0 {
        return ""
    }
    let src: I64 = s as I64
    var st: I64 = 0
    loop (st < s_len) {
        let p: *U8 = (src + st) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        if not is_whitespace(b as I32) {
            break
        }
        st = st + 1
    }
    var en: I64 = s_len
    loop (en > st) {
        let p: *U8 = (src + en - 1) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        if not is_whitespace(b as I32) {
            break
        }
        en = en - 1
    }
    if st >= en {
        return ""
    }
    return substring(s, st, en)
}

/// Removes leading whitespace from a string.
///
/// # Examples
///
/// ```tml
/// assert(trim_start("  hello  ") == "hello  ")
/// ```
@allocates
pub func trim_start(s: Str) -> Str {
    let s_len: I64 = len(s)
    if s_len == 0 {
        return ""
    }
    let src: I64 = s as I64
    var st: I64 = 0
    loop (st < s_len) {
        let p: *U8 = (src + st) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        if not is_whitespace(b as I32) {
            break
        }
        st = st + 1
    }
    if st == 0 {
        return s
    }
    return substring(s, st, s_len)
}

/// Removes trailing whitespace from a string.
///
/// # Examples
///
/// ```tml
/// assert(trim_end("  hello  ") == "  hello")
/// ```
@allocates
pub func trim_end(s: Str) -> Str {
    let s_len: I64 = len(s)
    if s_len == 0 {
        return ""
    }
    let src: I64 = s as I64
    var en: I64 = s_len
    loop (en > 0) {
        let p: *U8 = (src + en - 1) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        if not is_whitespace(b as I32) {
            break
        }
        en = en - 1
    }
    if en == s_len {
        return s
    }
    if en == 0 {
        return ""
    }
    return substring(s, 0, en)
}

// ============================================================================
// Case Conversion
// ============================================================================

/// Converts all characters to uppercase.
///
/// # Examples
///
/// ```tml
/// assert(to_uppercase("hello") == "HELLO")
/// assert(to_uppercase("Hello World") == "HELLO WORLD")
/// ```
@allocates
pub func to_uppercase(s: Str) -> Str {
    let s_len: I64 = len(s)
    if s_len == 0 {
        return ""
    }
    let buf: *Unit = lowlevel { mem_alloc(s_len + 1) }
    let src: I64 = s as I64
    let dst: I64 = buf as I64
    var i: I64 = 0
    loop (i < s_len) {
        let p: *U8 = (src + i) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        var ch: I32 = b as I32
        // ASCII lowercase a-z: 97-122 -> 65-90
        if ch >= 97 and ch <= 122 {
            ch = ch - 32
        }
        let dp: *U8 = (dst + i) as *U8
        lowlevel { ptr_write[U8](dp, ch as U8) }
        i = i + 1
    }
    let null_p: *U8 = (dst + s_len) as *U8
    lowlevel { ptr_write[U8](null_p, 0 as U8) }
    return buf as Str
}

/// Converts all characters to lowercase.
///
/// # Examples
///
/// ```tml
/// assert(to_lowercase("HELLO") == "hello")
/// assert(to_lowercase("Hello World") == "hello world")
/// ```
@allocates
pub func to_lowercase(s: Str) -> Str {
    let s_len: I64 = len(s)
    if s_len == 0 {
        return ""
    }
    let buf: *Unit = lowlevel { mem_alloc(s_len + 1) }
    let src: I64 = s as I64
    let dst: I64 = buf as I64
    var i: I64 = 0
    loop (i < s_len) {
        let p: *U8 = (src + i) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        var ch: I32 = b as I32
        // ASCII uppercase A-Z: 65-90 -> 97-122
        if ch >= 65 and ch <= 90 {
            ch = ch + 32
        }
        let dp: *U8 = (dst + i) as *U8
        lowlevel { ptr_write[U8](dp, ch as U8) }
        i = i + 1
    }
    let null_p: *U8 = (dst + s_len) as *U8
    lowlevel { ptr_write[U8](null_p, 0 as U8) }
    return buf as Str
}

// ============================================================================
// Search Operations
// ============================================================================

/// Returns `true` if the string contains the given substring.
///
/// # Examples
///
/// ```tml
/// assert(contains("hello world", "world") == true)
/// assert(contains("hello", "xyz") == false)
/// ```
pub func contains(s: Str, pattern: Str) -> Bool {
    let s_len: I64 = len(s)
    let p_len: I64 = len(pattern)
    if p_len == 0 {
        return true
    }
    if p_len > s_len {
        return false
    }
    let s_base: I64 = s as I64
    let p_ptr: *U8 = pattern as *U8
    let limit: I64 = s_len - p_len
    var i: I64 = 0
    loop (i <= limit) {
        if c_memcmp((s_base + i) as *U8, p_ptr, p_len) == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

/// Returns `true` if the string starts with the given prefix.
///
/// # Examples
///
/// ```tml
/// assert(starts_with("hello", "hel") == true)
/// assert(starts_with("hello", "lo") == false)
/// ```
pub func starts_with(s: Str, prefix: Str) -> Bool {
    let s_len: I64 = len(s)
    let p_len: I64 = len(prefix)
    if p_len > s_len {
        return false
    }
    if p_len == 0 {
        return true
    }
    return c_memcmp(s as *U8, prefix as *U8, p_len) == 0
}

/// Returns `true` if the string ends with the given suffix.
///
/// # Examples
///
/// ```tml
/// assert(ends_with("hello", "lo") == true)
/// assert(ends_with("hello", "hel") == false)
/// ```
pub func ends_with(s: Str, suffix: Str) -> Bool {
    let s_len: I64 = len(s)
    let x_len: I64 = len(suffix)
    if x_len > s_len {
        return false
    }
    if x_len == 0 {
        return true
    }
    let offset: I64 = s_len - x_len
    return c_memcmp((s as I64 + offset) as *U8, suffix as *U8, x_len) == 0
}

/// Returns the byte index of the first occurrence of the pattern.
///
/// Returns `Nothing` if the pattern is not found.
///
/// # Examples
///
/// ```tml
/// assert(find("hello", "ll") == Just(2))
/// assert(find("hello", "xyz") == Nothing)
/// ```
pub func find(s: Str, pattern: Str) -> Maybe[I64] {
    let s_len: I64 = len(s)
    let p_len: I64 = len(pattern)
    if p_len == 0 {
        return Just(0)
    }
    if p_len > s_len {
        return Nothing
    }
    let s_base: I64 = s as I64
    let p_ptr: *U8 = pattern as *U8
    let limit: I64 = s_len - p_len
    var i: I64 = 0
    loop (i <= limit) {
        if c_memcmp((s_base + i) as *U8, p_ptr, p_len) == 0 {
            return Just(i)
        }
        i = i + 1
    }
    return Nothing
}

/// Returns the byte index of the last occurrence of the pattern.
///
/// Returns `Nothing` if the pattern is not found.
///
/// # Examples
///
/// ```tml
/// assert(rfind("hello hello", "hello") == Just(6))
/// assert(rfind("hello", "xyz") == Nothing)
/// ```
pub func rfind(s: Str, pattern: Str) -> Maybe[I64] {
    let s_len: I64 = len(s)
    let p_len: I64 = len(pattern)
    if p_len == 0 {
        return Just(s_len)
    }
    if p_len > s_len {
        return Nothing
    }
    let s_base: I64 = s as I64
    let p_ptr: *U8 = pattern as *U8
    var i: I64 = s_len - p_len
    loop (i >= 0) {
        if c_memcmp((s_base + i) as *U8, p_ptr, p_len) == 0 {
            return Just(i)
        }
        i = i - 1
    }
    return Nothing
}

// ============================================================================
// Splitting
// ============================================================================

/// Splits a string by the given delimiter.
///
/// Returns a list of substrings. Empty strings are included if there are
/// consecutive delimiters.
///
/// # Examples
///
/// ```tml
/// let parts = split("a,b,c", ",")
/// assert(parts.len() == 3)
/// assert(parts[0] == "a")
///
/// let parts2 = split("a::b", "::")
/// assert(parts2.len() == 2)
/// ```
pub func split(s: Str, delimiter: Str) -> List[Str] {
    let result: List[Str] = List[Str]::new(8)
    let s_len: I64 = len(s)
    let d_len: I64 = len(delimiter)
    if s_len == 0 {
        result.push("")
        return result
    }
    if d_len == 0 {
        result.push(s)
        return result
    }
    let s_base: I64 = s as I64
    let d_base: I64 = delimiter as I64
    var start: I64 = 0
    var pos: I64 = 0
    loop (pos <= s_len - d_len) {
        if c_memcmp((s_base + pos) as *U8, d_base as *U8, d_len) == 0 {
            result.push(substring(s, start, pos))
            start = pos + d_len
            pos = start
        } else {
            pos = pos + 1
        }
    }
    // Push remainder
    result.push(substring(s, start, s_len))
    return result
}

/// Splits a string by whitespace.
///
/// Multiple consecutive whitespace characters are treated as a single
/// delimiter. Leading and trailing whitespace is ignored.
///
/// # Examples
///
/// ```tml
/// let words = split_whitespace("  hello   world  ")
/// assert(words.len() == 2)
/// assert(words[0] == "hello")
/// assert(words[1] == "world")
/// ```
pub func split_whitespace(s: Str) -> List[Str] {
    let result: List[Str] = List[Str]::new(8)
    let s_len: I64 = len(s)
    if s_len == 0 {
        return result
    }
    let src: I64 = s as I64
    var i: I64 = 0
    loop (i < s_len) {
        // Skip whitespace
        let p: *U8 = (src + i) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        if is_whitespace(b as I32) {
            i = i + 1
        } else {
            // Find end of word
            let word_start: I64 = i
            loop (i < s_len) {
                let wp: *U8 = (src + i) as *U8
                let wb: U8 = lowlevel { ptr_read[U8](wp) }
                if is_whitespace(wb as I32) {
                    break
                }
                i = i + 1
            }
            result.push(substring(s, word_start, i))
        }
    }
    return result
}

/// Splits a string into lines.
///
/// Handles both `\n` and `\r\n` line endings.
///
/// # Examples
///
/// ```tml
/// let lns = lines("line1\nline2\nline3")
/// assert(lns.len() == 3)
/// ```
pub func lines(s: Str) -> List[Str] {
    let result: List[Str] = List[Str]::new(8)
    let s_len: I64 = len(s)
    if s_len == 0 {
        return result
    }
    let src: I64 = s as I64
    var start: I64 = 0
    loop (start <= s_len) {
        let remaining: I64 = s_len - start
        if remaining <= 0 { break }
        let found: *U8 = c_memchr((src + start) as *U8, 10, remaining)
        let found_addr: I64 = found as I64
        if found_addr == 0 {
            // No more newlines — push the rest
            var end: I64 = s_len
            if end > start {
                let last_b: U8 = lowlevel { ptr_read[U8]((src + end - 1) as *U8) }
                if (last_b as I32) == 13 { end = end - 1 }
            }
            result.push(substring(s, start, end))
            break
        }
        let i: I64 = found_addr - src
        // Check for \r\n
        var line_end: I64 = i
        if line_end > start {
            let prev_b: U8 = lowlevel { ptr_read[U8]((src + line_end - 1) as *U8) }
            if (prev_b as I32) == 13 { line_end = line_end - 1 }
        }
        result.push(substring(s, start, line_end))
        start = i + 1
    }
    return result
}

// ============================================================================
// Replacement
// ============================================================================

/// Replaces all occurrences of a substring with another string.
///
/// # Arguments
///
/// * `s` - The source string
/// * `from` - The pattern to search for
/// * `to` - The replacement string
///
/// # Examples
///
/// ```tml
/// assert(replace("hello world", "world", "TML") == "hello TML")
/// assert(replace("aaa", "a", "b") == "bbb")
/// assert(replace("hello", "x", "y") == "hello")  // No match
/// ```
@allocates
pub func replace(s: Str, pattern: Str, replacement: Str) -> Str {
    let s_len: I64 = len(s)
    let p_len: I64 = len(pattern)
    let r_len: I64 = len(replacement)
    if p_len == 0 or s_len == 0 {
        return s
    }
    let s_base: I64 = s as I64
    let p_ptr: *U8 = pattern as *U8
    // First pass: count occurrences using memcmp
    var count: I64 = 0
    var pos: I64 = 0
    loop (pos <= s_len - p_len) {
        if c_memcmp((s_base + pos) as *U8, p_ptr, p_len) == 0 {
            count = count + 1
            pos = pos + p_len
        } else {
            pos = pos + 1
        }
    }
    if count == 0 {
        return s
    }
    // Allocate result
    let new_len: I64 = s_len + count * (r_len - p_len)
    let buf: *Unit = lowlevel { mem_alloc(new_len + 1) }
    let dst: I64 = buf as I64
    var si: I64 = 0
    var di: I64 = 0
    loop (si <= s_len - p_len) {
        if c_memcmp((s_base + si) as *U8, p_ptr, p_len) == 0 {
            // Copy replacement using memcpy
            if r_len > 0 {
                lowlevel { copy_nonoverlapping(replacement as *U8, (dst + di) as *U8, r_len) }
            }
            di = di + r_len
            si = si + p_len
        } else {
            let sp: *U8 = (s_base + si) as *U8
            let dp: *U8 = (dst + di) as *U8
            let b: U8 = lowlevel { ptr_read[U8](sp) }
            lowlevel { ptr_write[U8](dp, b) }
            si = si + 1
            di = di + 1
        }
    }
    // Copy remaining bytes after the last possible match position
    if si < s_len {
        let remaining: I64 = s_len - si
        lowlevel { copy_nonoverlapping((s_base + si) as *U8, (dst + di) as *U8, remaining) }
        di = di + remaining
    }
    let null_p: *U8 = (dst + di) as *U8
    lowlevel { ptr_write[U8](null_p, 0 as U8) }
    return buf as Str
}

/// Replaces only the first occurrence of a substring.
///
/// # Arguments
///
/// * `s` - The source string
/// * `from` - The pattern to search for
/// * `to` - The replacement string
///
/// # Examples
///
/// ```tml
/// assert(replace_first("aaa", "a", "b") == "baa")
/// assert(replace_first("hello hello", "hello", "hi") == "hi hello")
/// ```
@allocates
pub func replace_first(s: Str, pattern: Str, replacement: Str) -> Str {
    let result: Maybe[I64] = find(s, pattern)
    if result.is_just() {
        let pos: I64 = result.unwrap()
        let s_len: I64 = len(s)
        let p_len: I64 = len(pattern)
        let r_len: I64 = len(replacement)
        let new_len: I64 = s_len - p_len + r_len
        let buf: *Unit = lowlevel { mem_alloc(new_len + 1) }
        let dst: I64 = buf as I64
        // Copy before match
        if pos > 0 {
            lowlevel { copy_nonoverlapping(s as *U8, dst as *U8, pos) }
        }
        // Copy replacement
        if r_len > 0 {
            lowlevel { copy_nonoverlapping(replacement as *U8, (dst + pos) as *U8, r_len) }
        }
        // Copy after match
        let after_len: I64 = s_len - pos - p_len
        if after_len > 0 {
            lowlevel { copy_nonoverlapping((s as I64 + pos + p_len) as *U8, (dst + pos + r_len) as *U8, after_len) }
        }
        lowlevel { ptr_write[U8]((dst + new_len) as *U8, 0 as U8) }
        return buf as Str
    }
    return s
}

// ============================================================================
// Repetition and Padding
// ============================================================================

/// Repeats the string `n` times.
///
/// # Arguments
///
/// * `s` - The string to repeat
/// * `n` - Number of times to repeat (must be non-negative)
///
/// # Examples
///
/// ```tml
/// assert(repeat("ab", 3) == "ababab")
/// assert(repeat("x", 5) == "xxxxx")
/// assert(repeat("hello", 0) == "")
/// ```
@allocates
pub func repeat(s: Str, n: I64) -> Str {
    if n <= 0 {
        return ""
    }
    let s_len: I64 = len(s)
    if s_len == 0 {
        return ""
    }
    let total: I64 = s_len * n
    let buf: *Unit = lowlevel { mem_alloc(total + 1) }
    let dst: I64 = buf as I64
    var i: I64 = 0
    loop (i < n) {
        lowlevel { copy_nonoverlapping(s as *U8, (dst + i * s_len) as *U8, s_len) }
        i = i + 1
    }
    lowlevel { ptr_write[U8]((dst + total) as *U8, 0 as U8) }
    return buf as Str
}

/// Pads the string on the left to reach the given width.
///
/// If the string is already at least `width` bytes long, it is returned
/// unchanged.
///
/// # Arguments
///
/// * `s` - The string to pad
/// * `width` - The target width in bytes
/// * `pad_char` - The padding string (typically a single character)
///
/// # Examples
///
/// ```tml
/// assert(pad_left("42", 5, "0") == "00042")
/// assert(pad_left("hello", 10, " ") == "     hello")
/// assert(pad_left("long", 2, "x") == "long")  // Already long enough
/// ```
@allocates
pub func pad_left(s: Str, width: I64, pad_char: Str) -> Str {
    let current_len: I64 = len(s)
    if current_len >= width {
        return s
    }
    let padding: Str = repeat(pad_char, width - current_len)
    return padding + s
}

/// Pads the string on the right to reach the given width.
///
/// If the string is already at least `width` bytes long, it is returned
/// unchanged.
///
/// # Arguments
///
/// * `s` - The string to pad
/// * `width` - The target width in bytes
/// * `pad_char` - The padding string (typically a single character)
///
/// # Examples
///
/// ```tml
/// assert(pad_right("42", 5, "0") == "42000")
/// assert(pad_right("hello", 10, " ") == "hello     ")
/// assert(pad_right("long", 2, "x") == "long")  // Already long enough
/// ```
@allocates
pub func pad_right(s: Str, width: I64, pad_char: Str) -> Str {
    let current_len: I64 = len(s)
    if current_len >= width {
        return s
    }
    let padding: Str = repeat(pad_char, width - current_len)
    return s + padding
}

// ============================================================================
// Parsing
// ============================================================================

/// Parses a string as a 32-bit signed integer.
///
/// Attempts to parse the entire string as an integer. Leading and trailing
/// whitespace should be trimmed before calling.
///
/// # Examples
///
/// ```tml
/// assert(parse_i32("42") == Just(42))
/// assert(parse_i32("-17") == Just(-17))
/// assert(parse_i32("0") == Just(0))
/// ```
///
/// # Note
///
/// Currently always returns `Just(result)`. Proper error detection is
/// pending implementation.
pub func parse_i32(s: Str) -> Maybe[I32] {
    let s_len: I64 = len(s)
    if s_len == 0 {
        return Nothing
    }
    let src: I64 = s as I64
    var i: I64 = 0
    var negative: Bool = false
    // Check sign
    let first_p: *U8 = src as *U8
    let first_b: U8 = lowlevel { ptr_read[U8](first_p) }
    let first_ch: I32 = first_b as I32
    if first_ch == 45 {
        // '-'
        negative = true
        i = 1
    } else if first_ch == 43 {
        // '+'
        i = 1
    }
    if i >= s_len {
        return Nothing
    }
    var result: I64 = 0
    loop (i < s_len) {
        let p: *U8 = (src + i) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        let ch: I32 = b as I32
        if ch < 48 or ch > 57 {
            return Nothing
        }
        result = result * 10 + (ch - 48) as I64
        i = i + 1
    }
    if negative {
        result = 0 - result
    }
    return Just(result as I32)
}

/// Parses a string as a 64-bit signed integer.
///
/// Attempts to parse the entire string as an integer. Leading and trailing
/// whitespace should be trimmed before calling.
///
/// # Examples
///
/// ```tml
/// assert(parse_i64("9223372036854775807") == Just(9223372036854775807))
/// assert(parse_i64("-42") == Just(-42))
/// ```
///
/// # Note
///
/// Currently always returns `Just(result)`. Proper error detection is
/// pending implementation.
pub func parse_i64(s: Str) -> Maybe[I64] {
    let s_len: I64 = len(s)
    if s_len == 0 {
        return Nothing
    }
    let src: I64 = s as I64
    var i: I64 = 0
    var negative: Bool = false
    let first_p: *U8 = src as *U8
    let first_b: U8 = lowlevel { ptr_read[U8](first_p) }
    let first_ch: I32 = first_b as I32
    if first_ch == 45 {
        negative = true
        i = 1
    } else if first_ch == 43 {
        i = 1
    }
    if i >= s_len {
        return Nothing
    }
    var result: I64 = 0
    loop (i < s_len) {
        let p: *U8 = (src + i) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        let ch: I32 = b as I32
        if ch < 48 or ch > 57 {
            return Nothing
        }
        result = result * 10 + (ch - 48) as I64
        i = i + 1
    }
    if negative {
        result = 0 - result
    }
    return Just(result)
}

/// Parses a string as a 64-bit floating point number.
///
/// Accepts standard decimal notation and scientific notation.
///
/// # Examples
///
/// ```tml
/// assert(parse_f64("3.14") == Just(3.14))
/// assert(parse_f64("-0.5") == Just(-0.5))
/// assert(parse_f64("1e10") == Just(1e10))
/// ```
///
/// # Note
///
/// Currently always returns `Just(result)`. Proper error detection is
/// pending implementation.
pub func parse_f64(s: Str) -> Maybe[F64] {
    let s_len: I64 = len(s)
    if s_len == 0 {
        return Nothing
    }
    let src: I64 = s as I64
    var i: I64 = 0
    var negative: Bool = false
    let first_p: *U8 = src as *U8
    let first_b: U8 = lowlevel { ptr_read[U8](first_p) }
    let first_ch: I32 = first_b as I32
    if first_ch == 45 {
        negative = true
        i = 1
    } else if first_ch == 43 {
        i = 1
    }
    if i >= s_len {
        return Nothing
    }
    // Integer part
    var int_part: F64 = 0.0
    var has_digits: Bool = false
    loop (i < s_len) {
        let p: *U8 = (src + i) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        let ch: I32 = b as I32
        if ch >= 48 and ch <= 57 {
            int_part = int_part * 10.0 + (ch - 48) as F64
            has_digits = true
            i = i + 1
        } else {
            break
        }
    }
    var frac_part: F64 = 0.0
    // Decimal part
    if i < s_len {
        let dp: *U8 = (src + i) as *U8
        let db: U8 = lowlevel { ptr_read[U8](dp) }
        if (db as I32) == 46 {
            // '.'
            i = i + 1
            var divisor: F64 = 10.0
            loop (i < s_len) {
                let p: *U8 = (src + i) as *U8
                let b: U8 = lowlevel { ptr_read[U8](p) }
                let ch: I32 = b as I32
                if ch >= 48 and ch <= 57 {
                    frac_part = frac_part + (ch - 48) as F64 / divisor
                    divisor = divisor * 10.0
                    has_digits = true
                    i = i + 1
                } else {
                    break
                }
            }
        }
    }
    if not has_digits {
        return Nothing
    }
    var result: F64 = int_part + frac_part
    // Exponent part (e/E)
    if i < s_len {
        let ep: *U8 = (src + i) as *U8
        let eb: U8 = lowlevel { ptr_read[U8](ep) }
        let ech: I32 = eb as I32
        if ech == 101 or ech == 69 {
            // 'e' or 'E'
            i = i + 1
            var exp_negative: Bool = false
            if i < s_len {
                let esp: *U8 = (src + i) as *U8
                let esb: U8 = lowlevel { ptr_read[U8](esp) }
                let esch: I32 = esb as I32
                if esch == 45 {
                    exp_negative = true
                    i = i + 1
                } else if esch == 43 {
                    i = i + 1
                }
            }
            var exp_val: I64 = 0
            loop (i < s_len) {
                let p: *U8 = (src + i) as *U8
                let b: U8 = lowlevel { ptr_read[U8](p) }
                let ch: I32 = b as I32
                if ch >= 48 and ch <= 57 {
                    exp_val = exp_val * 10 + (ch - 48) as I64
                    i = i + 1
                } else {
                    break
                }
            }
            var multiplier: F64 = 1.0
            var ei: I64 = 0
            loop (ei < exp_val) {
                multiplier = multiplier * 10.0
                ei = ei + 1
            }
            if exp_negative {
                result = result / multiplier
            } else {
                result = result * multiplier
            }
        }
    }
    if negative {
        result = 0.0 - result
    }
    return Just(result)
}

/// Parses a string as a boolean value.
///
/// Accepts the following values (case insensitive):
/// - `"true"` or `"1"` → `Just(true)`
/// - `"false"` or `"0"` → `Just(false)`
/// - Any other value → `Nothing`
///
/// # Examples
///
/// ```tml
/// assert(parse_bool("true") == Just(true))
/// assert(parse_bool("FALSE") == Just(false))
/// assert(parse_bool("1") == Just(true))
/// assert(parse_bool("yes") == Nothing)
/// ```
pub func parse_bool(s: Str) -> Maybe[Bool] {
    let lower: Str = to_lowercase(s)
    if lower == "true" or lower == "1" {
        return Just(true)
    }
    if lower == "false" or lower == "0" {
        return Just(false)
    }
    return Nothing
}

// ============================================================================
// Joining
// ============================================================================

/// Joins a list of strings with the given separator.
///
/// Creates a single string by concatenating all elements with the separator
/// between each pair of adjacent elements.
///
/// # Arguments
///
/// * `parts` - The list of strings to join
/// * `separator` - The string to insert between elements
///
/// # Examples
///
/// ```tml
/// let words = ["hello", "world"]
/// assert(join(words, " ") == "hello world")
///
/// let nums = ["1", "2", "3"]
/// assert(join(nums, ", ") == "1, 2, 3")
///
/// let empty: List[Str] = []
/// assert(join(empty, ",") == "")
/// ```
@allocates
pub func join(parts: List[Str], separator: Str) -> Str {
    let count: I64 = parts.len()
    if count == 0 {
        return ""
    }
    let sep_len: I64 = len(separator)
    // Calculate total length
    var total: I64 = 0
    var idx: I64 = 0
    loop (idx < count) {
        total = total + len(parts.get(idx))
        if idx < count - 1 {
            total = total + sep_len
        }
        idx = idx + 1
    }
    if total == 0 {
        return ""
    }
    let buf: *Unit = lowlevel { mem_alloc(total + 1) }
    let dst: I64 = buf as I64
    var di: I64 = 0
    idx = 0
    loop (idx < count) {
        let part: Str = parts.get(idx)
        let p_len: I64 = len(part)
        if p_len > 0 {
            lowlevel { copy_nonoverlapping(part as *U8, (dst + di) as *U8, p_len) }
            di = di + p_len
        }
        if idx < count - 1 and sep_len > 0 {
            lowlevel { copy_nonoverlapping(separator as *U8, (dst + di) as *U8, sep_len) }
            di = di + sep_len
        }
        idx = idx + 1
    }
    lowlevel { ptr_write[U8]((dst + di) as *U8, 0 as U8) }
    return buf as Str
}

// ============================================================================
// Concatenation
// ============================================================================

/// Concatenates two strings.
///
/// This is equivalent to using the `+` operator on strings.
///
/// # Examples
///
/// ```tml
/// assert(concat("Hello, ", "World!") == "Hello, World!")
/// assert(concat("", "x") == "x")
/// ```
@allocates
pub func concat(a: Str, b: Str) -> Str {
    let result = a + b
    return result
}

/// Concatenates multiple strings without a separator.
///
/// This is equivalent to `join(parts, "")`.
///
/// # Examples
///
/// ```tml
/// let parts = ["a", "b", "c"]
/// assert(concat_all(parts) == "abc")
///
/// let words = ["Hello", " ", "World"]
/// assert(concat_all(words) == "Hello World")
/// ```
@allocates
pub func concat_all(parts: List[Str]) -> Str {
    return join(parts, "")
}

// ============================================================================
// Character Iteration
// ============================================================================

/// Returns a list of character (byte) values from the string.
///
/// # Examples
///
/// ```tml
/// let cs = chars("abc")
/// assert(cs.len() == 3)
/// assert(cs.get(0) == 97)  // 'a'
/// ```
pub func chars(s: Str) -> List[I32] {
    let result: List[I32] = List[I32]::new(8)
    let s_len: I64 = len(s)
    if s_len == 0 {
        return result
    }
    let src: I64 = s as I64
    var i: I64 = 0
    loop (i < s_len) {
        let p: *U8 = (src + i) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        result.push(b as I32)
        i = i + 1
    }
    return result
}

// ============================================================================
// Phase 1: High priority parsing helpers
// ============================================================================

/// Splits the string at the first occurrence of `delim`.
///
/// Returns `Just((before, after))` where `before` is the part before the
/// delimiter and `after` is the part after it. Returns `Nothing` if the
/// delimiter is not found.
///
/// # Examples
///
/// ```tml
/// assert(split_once("key=value", "=") == Just(("key", "value")))
/// assert(split_once("a::b::c", "::") == Just(("a", "b::c")))
/// assert(split_once("hello", "=") == Nothing)
/// ```
pub func split_once(s: Str, delim: Str) -> Maybe[(Str, Str)] {
    let result: Maybe[I64] = find(s, delim)
    if result.is_nothing() {
        return Nothing
    }
    let pos: I64 = result.unwrap()
    let d_len: I64 = len(delim)
    let s_len: I64 = len(s)
    let before: Str = substring(s, 0, pos)
    let after: Str = substring(s, pos + d_len, s_len)
    return Just((before, after))
}

/// Splits the string at the last occurrence of `delim`.
///
/// Returns `Just((before, after))` where `before` is the part before the
/// last delimiter and `after` is the part after it. Returns `Nothing` if
/// the delimiter is not found.
///
/// # Examples
///
/// ```tml
/// assert(rsplit_once("a::b::c", "::") == Just(("a::b", "c")))
/// assert(rsplit_once("key=value", "=") == Just(("key", "value")))
/// assert(rsplit_once("hello", "=") == Nothing)
/// ```
pub func rsplit_once(s: Str, delim: Str) -> Maybe[(Str, Str)] {
    let result: Maybe[I64] = rfind(s, delim)
    if result.is_nothing() {
        return Nothing
    }
    let pos: I64 = result.unwrap()
    let d_len: I64 = len(delim)
    let s_len: I64 = len(s)
    let before: Str = substring(s, 0, pos)
    let after: Str = substring(s, pos + d_len, s_len)
    return Just((before, after))
}

/// Removes a prefix from the string, returning the remainder.
///
/// Returns `Just(rest)` if the string starts with `prefix`, or `Nothing`
/// if it does not.
///
/// # Examples
///
/// ```tml
/// assert(strip_prefix("hello world", "hello ") == Just("world"))
/// assert(strip_prefix("hello", "world") == Nothing)
/// assert(strip_prefix("hello", "") == Just("hello"))
/// ```
pub func strip_prefix(s: Str, prefix: Str) -> Maybe[Str] {
    let p_len: I64 = len(prefix)
    if not starts_with(s, prefix) {
        return Nothing
    }
    let s_len: I64 = len(s)
    return Just(substring(s, p_len, s_len))
}

/// Removes a suffix from the string, returning the remainder.
///
/// Returns `Just(rest)` if the string ends with `suffix`, or `Nothing`
/// if it does not.
///
/// # Examples
///
/// ```tml
/// assert(strip_suffix("hello world", " world") == Just("hello"))
/// assert(strip_suffix("hello", "world") == Nothing)
/// assert(strip_suffix("hello", "") == Just("hello"))
/// ```
pub func strip_suffix(s: Str, suffix: Str) -> Maybe[Str] {
    let x_len: I64 = len(suffix)
    if not ends_with(s, suffix) {
        return Nothing
    }
    let s_len: I64 = len(s)
    return Just(substring(s, 0, s_len - x_len))
}

/// Splits the string by `delim` with a maximum of `n` parts.
///
/// Splits at most `n - 1` times, so the result has at most `n` elements.
/// The last element contains the remainder of the string, including any
/// unsplit delimiters.
///
/// # Examples
///
/// ```tml
/// let parts = splitn("a,b,c,d", 3, ",")
/// assert(parts.len() == 3)
/// assert(parts.get(0) == "a")
/// assert(parts.get(1) == "b")
/// assert(parts.get(2) == "c,d")
/// ```
pub func splitn(s: Str, n: I64, delim: Str) -> List[Str] {
    let result: List[Str] = List[Str]::new(8)
    if n <= 0 {
        return result
    }
    let s_len: I64 = len(s)
    let d_len: I64 = len(delim)
    if s_len == 0 {
        result.push("")
        return result
    }
    if d_len == 0 or n == 1 or d_len > s_len {
        result.push(s)
        return result
    }
    let s_base: I64 = s as I64
    let d_base: I64 = delim as I64
    var start: I64 = 0
    var pos: I64 = 0
    var count: I64 = 1
    let limit: I64 = s_len - d_len
    loop (pos <= limit) {
        if count >= n {
            break
        }
        if c_memcmp((s_base + pos) as *U8, d_base as *U8, d_len) == 0 {
            result.push(substring(s, start, pos))
            start = pos + d_len
            pos = start
            count = count + 1
        } else {
            pos = pos + 1
        }
    }
    // Push the remainder
    result.push(substring(s, start, s_len))
    return result
}

/// Returns `true` if all bytes in the string are valid ASCII (< 128).
///
/// An empty string returns `true`.
///
/// # Examples
///
/// ```tml
/// assert(is_ascii("hello") == true)
/// assert(is_ascii("") == true)
/// assert(is_ascii("caf\xc3\xa9") == false)  // UTF-8 é
/// ```
pub func is_ascii(s: Str) -> Bool {
    let s_len: I64 = len(s)
    let src: I64 = s as I64
    var i: I64 = 0
    loop (i < s_len) {
        let p: *U8 = (src + i) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        if (b as I32) >= 128 {
            return false
        }
        i = i + 1
    }
    return true
}

/// Compares two strings for equality, ignoring ASCII case.
///
/// Non-ASCII bytes are compared literally (case-sensitive).
///
/// # Examples
///
/// ```tml
/// assert(eq_ignore_ascii_case("Hello", "hello") == true)
/// assert(eq_ignore_ascii_case("WORLD", "world") == true)
/// assert(eq_ignore_ascii_case("abc", "xyz") == false)
/// ```
pub func eq_ignore_ascii_case(s: Str, other: Str) -> Bool {
    let s_len: I64 = len(s)
    let o_len: I64 = len(other)
    if s_len != o_len {
        return false
    }
    let src: I64 = s as I64
    let orc: I64 = other as I64
    var i: I64 = 0
    loop (i < s_len) {
        let sp: *U8 = (src + i) as *U8
        let op: *U8 = (orc + i) as *U8
        var sb: I32 = (lowlevel { ptr_read[U8](sp) }) as I32
        var ob: I32 = (lowlevel { ptr_read[U8](op) }) as I32
        // Normalize ASCII letters to lowercase
        if sb >= 65 and sb <= 90 {
            sb = sb + 32
        }
        if ob >= 65 and ob <= 90 {
            ob = ob + 32
        }
        if sb != ob {
            return false
        }
        i = i + 1
    }
    return true
}

// ============================================================================
// Phase 2: Medium priority utility methods
// ============================================================================

/// Splits the string by `delim`, iterating from the right.
///
/// Similar to `split` but produces tokens in reverse order relative to the
/// original string. The last delimited segment appears first in the result.
///
/// # Examples
///
/// ```tml
/// let parts = rsplit("a,b,c", ",")
/// assert(parts.len() == 3)
/// assert(parts.get(0) == "c")
/// assert(parts.get(1) == "b")
/// assert(parts.get(2) == "a")
/// ```
/// Splits the string by `delim`, iterating from the right.
///
/// Similar to `split` but produces tokens in reverse order relative to the
/// original string. The last delimited segment appears first in the result.
///
/// # Examples
///
/// ```tml
/// let parts = rsplit("a,b,c", ",")
/// assert(parts.len() == 3)
/// assert(parts.get(0) == "c")
/// assert(parts.get(1) == "b")
/// assert(parts.get(2) == "a")
/// ```
pub func rsplit(s: Str, delim: Str) -> List[Str] {
    let result: List[Str] = List[Str]::new(8)
    let s_len: I64 = len(s)
    let d_len: I64 = len(delim)
    if s_len == 0 {
        result.push("")
        return result
    }
    if d_len == 0 or d_len > s_len {
        result.push(s)
        return result
    }
    let s_base: I64 = s as I64
    let d_base: I64 = delim as I64
    var end_pos: I64 = s_len
    var pos: I64 = s_len - d_len
    loop (pos >= 0) {
        if c_memcmp((s_base + pos) as *U8, d_base as *U8, d_len) == 0 {
            result.push(substring(s, pos + d_len, end_pos))
            end_pos = pos
            pos = pos - d_len
        } else {
            pos = pos - 1
        }
    }
    // Push the leftmost remainder
    result.push(substring(s, 0, end_pos))
    return result
}

/// Replaces at most `count` occurrences of `pat` with `to`.
///
/// If `count` is 0, the original string is returned unchanged.
///
/// # Examples
///
/// ```tml
/// assert(replacen("aaa", "a", "b", 2) == "bba")
/// assert(replacen("hello hello hello", "hello", "hi", 2) == "hi hi hello")
/// ```
pub func replacen(s: Str, pat: Str, repl: Str, count: I64) -> Str {
    if count <= 0 {
        return s
    }
    let s_len: I64 = len(s)
    let p_len: I64 = len(pat)
    let r_len: I64 = len(repl)
    if p_len == 0 or s_len == 0 or p_len > s_len {
        return s
    }
    let s_base: I64 = s as I64
    let p_ptr: *U8 = pat as *U8
    // First pass: count matches up to `count` replacements
    var hits: I64 = 0
    var pos: I64 = 0
    let limit: I64 = s_len - p_len
    loop (pos <= limit and hits < count) {
        if c_memcmp((s_base + pos) as *U8, p_ptr, p_len) == 0 {
            hits = hits + 1
            pos = pos + p_len
        } else {
            pos = pos + 1
        }
    }
    if hits == 0 {
        return s
    }
    // Allocate output buffer
    let new_len: I64 = s_len + hits * (r_len - p_len)
    let buf: *Unit = lowlevel { mem_alloc(new_len + 1) }
    let dst: I64 = buf as I64
    let r_ptr: *U8 = repl as *U8
    var si: I64 = 0
    var di: I64 = 0
    var replaced: I64 = 0
    loop (si <= limit and replaced < count) {
        if c_memcmp((s_base + si) as *U8, p_ptr, p_len) == 0 {
            if r_len > 0 {
                lowlevel { copy_nonoverlapping(r_ptr, (dst + di) as *U8, r_len) }
            }
            di = di + r_len
            si = si + p_len
            replaced = replaced + 1
        } else {
            let sp: *U8 = (s_base + si) as *U8
            let dp: *U8 = (dst + di) as *U8
            let b: U8 = lowlevel { ptr_read[U8](sp) }
            lowlevel { ptr_write[U8](dp, b) }
            si = si + 1
            di = di + 1
        }
    }
    // Copy the remaining tail
    if si < s_len {
        let remaining: I64 = s_len - si
        lowlevel { copy_nonoverlapping((s_base + si) as *U8, (dst + di) as *U8, remaining) }
        di = di + remaining
    }
    // Null-terminate
    let nullp: *U8 = (dst + di) as *U8
    lowlevel { ptr_write[U8](nullp, 0) }
    return buf as Str
}

/// Trims all leading and trailing bytes that appear in `chars`.
///
/// `chars` is treated as a set of individual byte characters to trim.
/// Each byte in `chars` is a candidate for removal.
///
/// # Examples
///
/// ```tml
/// assert(trim_matches("##hello##", "#") == "hello")
/// assert(trim_matches("***world***", "*") == "world")
/// assert(trim_matches("xyzHELLOzyx", "xyz") == "HELLO")
/// ```
pub func trim_matches(s: Str, chars: Str) -> Str {
    let s_len: I64 = len(s)
    let c_len: I64 = len(chars)
    if s_len == 0 or c_len == 0 {
        return s
    }
    let src: I64 = s as I64
    let chs: I64 = chars as I64
    // Find the left boundary — skip bytes that appear in chars
    var left: I64 = 0
    var searching: Bool = true
    loop (left < s_len and searching) {
        let bp: *U8 = (src + left) as *U8
        let b: U8 = lowlevel { ptr_read[U8](bp) }
        var found: Bool = false
        var ci: I64 = 0
        loop (ci < c_len and not found) {
            let cp: *U8 = (chs + ci) as *U8
            let cb: U8 = lowlevel { ptr_read[U8](cp) }
            if b == cb {
                found = true
            }
            ci = ci + 1
        }
        if found {
            left = left + 1
        } else {
            searching = false
        }
    }
    // Find the right boundary — skip bytes that appear in chars
    var right: I64 = s_len - 1
    var searching2: Bool = true
    loop (right >= left and searching2) {
        let bp: *U8 = (src + right) as *U8
        let b: U8 = lowlevel { ptr_read[U8](bp) }
        var found: Bool = false
        var ci: I64 = 0
        loop (ci < c_len and not found) {
            let cp: *U8 = (chs + ci) as *U8
            let cb: U8 = lowlevel { ptr_read[U8](cp) }
            if b == cb {
                found = true
            }
            ci = ci + 1
        }
        if found {
            right = right - 1
        } else {
            searching2 = false
        }
    }
    if left > right {
        return ""
    }
    return substring(s, left, right + 1)
}

/// Returns a list of all non-overlapping matches of `pat` in the string.
///
/// # Examples
///
/// ```tml
/// let ms = matches("hello world hello", "hello")
/// assert(ms.len() == 2)
/// assert(ms.get(0) == "hello")
/// assert(ms.get(1) == "hello")
/// ```
pub func matches(s: Str, pat: Str) -> List[Str] {
    let result: List[Str] = List[Str]::new(8)
    let s_len: I64 = len(s)
    let p_len: I64 = len(pat)
    if p_len == 0 or p_len > s_len {
        return result
    }
    let s_base: I64 = s as I64
    let p_base: I64 = pat as I64
    var pos: I64 = 0
    let limit: I64 = s_len - p_len
    loop (pos <= limit) {
        if c_memcmp((s_base + pos) as *U8, p_base as *U8, p_len) == 0 {
            result.push(substring(s, pos, pos + p_len))
            pos = pos + p_len
        } else {
            pos = pos + 1
        }
    }
    return result
}

/// Returns the bytes of the string as a list of U8 values.
///
/// # Examples
///
/// ```tml
/// let bs = bytes("abc")
/// assert(bs.len() == 3)
/// assert(bs.get(0) == 97)
/// assert(bs.get(1) == 98)
/// assert(bs.get(2) == 99)
/// ```
pub func bytes(s: Str) -> List[U8] {
    let s_len: I64 = len(s)
    let result: List[U8] = List[U8]::new(s_len)
    let src: I64 = s as I64
    var i: I64 = 0
    loop (i < s_len) {
        let p: *U8 = (src + i) as *U8
        let b: U8 = lowlevel { ptr_read[U8](p) }
        result.push(b)
        i = i + 1
    }
    return result
}


// ============================================================================
// Str Methods
// ============================================================================

impl Str {
    /// Returns the length of this string in bytes.
    pub func len(this) -> I64 {
        return str::len(this)
    }

    /// Returns `true` if this string is empty.
    pub func is_empty(this) -> Bool {
        return str::is_empty(this)
    }

    /// Returns the underlying bytes of this string as a byte slice.
    /// Phase 46: Pure identity — Str and ref [U8] are both ptr in LLVM IR.
    pub func as_bytes(this) -> ref [U8] {
        return lowlevel { this }
    }

    /// Returns the character at the given byte index.
    pub func char_at(this, index: I64) -> I32 {
        return str::char_at(this, index)
    }

    /// Returns a substring from `start` to `end` (exclusive).
    @allocates
    pub func slice_str(this, start: I64, end: I64) -> Str {
        return str::substring(this, start, end)
    }

    /// Alias for slice_str
    @allocates
    pub func slice(this, start: I64, end: I64) -> Str {
        return str::substring(this, start, end)
    }

    /// Converts all characters to uppercase.
    @allocates
    pub func to_uppercase(this) -> Str {
        return str::to_uppercase(this)
    }

    /// Converts all characters to lowercase.
    @allocates
    pub func to_lowercase(this) -> Str {
        return str::to_lowercase(this)
    }

    /// Returns `true` if this string starts with the given prefix.
    pub func starts_with(this, prefix: Str) -> Bool {
        return str::starts_with(this, prefix)
    }

    /// Returns `true` if this string ends with the given suffix.
    pub func ends_with(this, suffix: Str) -> Bool {
        return str::ends_with(this, suffix)
    }

    /// Returns `true` if this string contains the given substring.
    pub func contains(this, pattern: Str) -> Bool {
        return str::contains(this, pattern)
    }

    /// Returns the byte index of the first occurrence of the pattern.
    /// Returns -1 if not found.
    pub func find(this, pattern: Str) -> I64 {
        let result: Maybe[I64] = str::find(this, pattern)
        if result.is_just() {
            return result.unwrap()
        }
        return -1
    }

    /// Returns the byte index of the last occurrence of the pattern.
    /// Returns -1 if not found.
    pub func rfind(this, pattern: Str) -> I64 {
        let result: Maybe[I64] = str::rfind(this, pattern)
        if result.is_just() {
            return result.unwrap()
        }
        return -1
    }

    /// Splits this string by the given delimiter.
    pub func split(this, delimiter: Str) -> List[Str] {
        return str::split(this, delimiter)
    }

    /// Returns a list of character (byte) values.
    pub func chars(this) -> List[I32] {
        return str::chars(this)
    }

    /// Removes leading and trailing whitespace.
    @allocates
    pub func trim(this) -> Str {
        return str::trim(this)
    }

    /// Removes leading whitespace.
    @allocates
    pub func trim_start(this) -> Str {
        return str::trim_start(this)
    }

    /// Removes trailing whitespace.
    @allocates
    pub func trim_end(this) -> Str {
        return str::trim_end(this)
    }

    /// Parses this string as an I64.
    pub func parse_i64(this) -> Maybe[I64] {
        return str::parse_i64(this)
    }

    /// Parses this string as a U16.
    pub func parse_u16(this) -> Maybe[U16] {
        let result: Maybe[I64] = str::parse_i64(this)
        if result.is_just() {
            return Just(result.unwrap() as U16)
        }
        return Nothing
    }

    /// Replaces all occurrences of a substring.
    @allocates
    pub func replace(this, pattern: Str, replacement: Str) -> Str {
        return str::replace(this, pattern, replacement)
    }

    /// Parses this string as an I32.
    pub func parse_i32(this) -> Maybe[I32] {
        return str::parse_i32(this)
    }

    /// Parses this string as an F64.
    pub func parse_f64(this) -> Maybe[F64] {
        return str::parse_f64(this)
    }

    /// Parses this string as a Bool.
    pub func parse_bool(this) -> Maybe[Bool] {
        return str::parse_bool(this)
    }

    // ── Phase 1 methods ──────────────────────────────────────────────────────

    /// Splits at the first occurrence of `delim`, returning a pair of slices.
    pub func split_once(this, delim: Str) -> Maybe[(Str, Str)] {
        return str::split_once(this, delim)
    }

    /// Splits at the last occurrence of `delim`, returning a pair of slices.
    pub func rsplit_once(this, delim: Str) -> Maybe[(Str, Str)] {
        return str::rsplit_once(this, delim)
    }

    /// Removes a prefix from the string if it starts with `prefix`.
    pub func strip_prefix(this, prefix: Str) -> Maybe[Str] {
        return str::strip_prefix(this, prefix)
    }

    /// Removes a suffix from the string if it ends with `suffix`.
    pub func strip_suffix(this, suffix: Str) -> Maybe[Str] {
        return str::strip_suffix(this, suffix)
    }

    /// Splits the string by `delim` with a maximum of `n` parts.
    pub func splitn(this, n: I64, delim: Str) -> List[Str] {
        return str::splitn(this, n, delim)
    }

    /// Returns `true` if all bytes in the string are valid ASCII (< 128).
    pub func is_ascii(this) -> Bool {
        return str::is_ascii(this)
    }

    /// Compares two strings for equality, ignoring ASCII case.
    pub func eq_ignore_ascii_case(this, other: Str) -> Bool {
        return str::eq_ignore_ascii_case(this, other)
    }

    // ── Phase 2 methods ──────────────────────────────────────────────────────

    /// Splits the string by `delim`, iterating from the right.
    pub func rsplit(this, delim: Str) -> List[Str] {
        return str::rsplit(this, delim)
    }

    /// Replaces at most `count` occurrences of `pat` with `repl`.
    @allocates
    pub func replacen(this, pat: Str, repl: Str, count: I64) -> Str {
        return str::replacen(this, pat, repl, count)
    }

    /// Trims all leading and trailing bytes that appear in `chars`.
    @allocates
    pub func trim_matches(this, chars: Str) -> Str {
        return str::trim_matches(this, chars)
    }

    /// Returns a list of all non-overlapping matches of `pat` in the string.
    pub func matches(this, pat: Str) -> List[Str] {
        return str::matches(this, pat)
    }

    /// Returns the bytes of the string as a list of U8 values.
    pub func bytes(this) -> List[U8] {
        return str::bytes(this)
    }

}
