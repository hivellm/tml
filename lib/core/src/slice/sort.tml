//! Slice sorting algorithms.
//!
//! This module provides sorting functionality for mutable slices:
//!
//! - [`sort`]: Sort using the element's natural ordering
//! - [`sort_by`]: Sort using a custom comparator function
//! - [`sort_by_key`]: Sort using a key extraction function
//!
//! # Stability
//!
//! The current implementation uses quicksort, which is **unstable** - equal
//! elements may be reordered. Future versions may add stable sorting options.
//!
//! # Complexity
//!
//! | Algorithm | Time Complexity | Space Complexity |
//! |-----------|-----------------|------------------|
//! | Quicksort | O(n log n) avg, O(n²) worst | O(log n) |
//!
//! # Examples
//!
//! ## Basic Sorting
//!
//! ```tml
//! let mut v = [5, 4, 1, 3, 2]
//! v.as_mut_slice().sort()
//! assert_eq(v, [1, 2, 3, 4, 5])
//! ```
//!
//! ## Custom Comparator
//!
//! ```tml
//! let mut v = [5, 4, 1, 3, 2]
//! // Sort in descending order
//! v.as_mut_slice().sort_by(do(a, b) b.cmp(a))
//! assert_eq(v, [5, 4, 3, 2, 1])
//! ```
//!
//! ## Sort by Key
//!
//! ```tml
//! let mut v = [-5, 4, 1, -3, 2]
//! // Sort by absolute value
//! v.as_mut_slice().sort_by_key(do(k) k.abs())
//! assert_eq(v, [1, 2, -3, 4, -5])
//! ```

use core::slice::{MutSlice}
// Ordering, Ord are builtins - no import needed

// ============================================================================
// Helpers
// ============================================================================

/// Compute floor(log2(n)) for positive n.
/// Used to determine introsort depth limit (2 * floor_log2(n)).
func floor_log2(n: I64) -> I64 {
    let mut result: I64 = 0
    let mut val: I64 = n
    loop (val > 1) {
        val = val / 2
        result = result + 1
    }
    return result
}

// ============================================================================
// Sort Behaviors
// ============================================================================

/// Behavior for sortable slices using natural ordering.
pub behavior SliceSort[T: Ord] {
    /// Sorts the slice in ascending order.
    func sort(mut this)
}

/// Behavior for sortable slices using custom comparators.
pub behavior SliceSortBy[T] {
    /// Sorts the slice with a comparator function.
    func sort_by(mut this, compare: func(ref T, ref T) -> Ordering)

    /// Sorts the slice with a key extraction function.
    func sort_by_key[K: Ord](mut this, key_fn: func(ref T) -> K)
}

// ============================================================================
// Sorting with Natural Order
// ============================================================================

impl[T: Ord] MutSlice[T] {
    /// Sorts the slice in ascending order.
    ///
    /// This sort is unstable (i.e., may reorder equal elements), in-place
    /// (i.e., does not allocate), and *O*(*n* \* log(*n*)) worst-case.
    ///
    /// # Current Implementation
    ///
    /// Uses introsort: quicksort with median-of-three pivot selection,
    /// insertion sort for small partitions (< 16 elements), and a depth
    /// limit of 2 * floor(log2(n)) that switches to heapsort to guarantee
    /// O(n log n) worst-case.
    ///
    /// # Examples
    ///
    /// ```tml
    /// let mut v = [5, 4, 1, 3, 2]
    /// v.as_mut_slice().sort()
    /// assert_eq(v, [1, 2, 3, 4, 5])
    /// ```
    ///
    /// # Stability
    ///
    /// This sort is **unstable**: equal elements may be reordered.
    pub func sort(mut this) {
        if this.len <= 1 {
            return
        }
        let max_depth: I64 = 2 * floor_log2(this.len)
        this.introsort(0, this.len - 1, max_depth)
    }

    /// Introsort: quicksort with depth limit that falls back to heapsort.
    func introsort(mut this, low: I64, high: I64, depth_limit: I64) {
        let size: I64 = high - low + 1
        if size <= 1 {
            return
        }
        if size < 16 {
            this.insertion_sort(low, high)
            return
        }
        if depth_limit == 0 {
            this.heapsort(low, high)
            return
        }
        let pivot: I64 = this.partition(low, high)
        if pivot > 0 {
            this.introsort(low, pivot - 1, depth_limit - 1)
        }
        this.introsort(pivot + 1, high, depth_limit - 1)
    }

    /// Insertion sort for small partitions.
    func insertion_sort(mut this, low: I64, high: I64) {
        let mut i: I64 = low + 1
        loop (i <= high) {
            let mut j: I64 = i
            loop (j > low) {
                let prev: ref T = this.get(j - 1).unwrap()
                let curr: ref T = this.get(j).unwrap()
                if prev.gt(curr) {
                    this.swap(j - 1, j)
                    j = j - 1
                } else {
                    // Element is in correct position
                    j = low  // break
                }
            }
            i = i + 1
        }
    }

    /// Heapsort fallback for depth-limited introsort.
    func heapsort(mut this, low: I64, high: I64) {
        let n: I64 = high - low + 1

        // Build max-heap (heapify from bottom up)
        let mut i: I64 = n / 2 - 1
        loop (i >= 0) {
            this.sift_down(low, i, n)
            i = i - 1
        }

        // Extract elements from heap one by one
        let mut end: I64 = n - 1
        loop (end > 0) {
            this.swap(low, low + end)
            this.sift_down(low, 0, end)
            end = end - 1
        }
    }

    /// Sift down element at index idx in a max-heap of size heap_size.
    /// All indices are relative to base offset in the slice.
    func sift_down(mut this, base_off: I64, idx: I64, heap_size: I64) {
        let mut root: I64 = idx
        loop (2 * root + 1 < heap_size) {
            let left: I64 = 2 * root + 1
            let right: I64 = left + 1
            let mut largest: I64 = root

            let largest_ref: ref T = this.get(base_off + largest).unwrap()
            let left_ref: ref T = this.get(base_off + left).unwrap()
            if left_ref.gt(largest_ref) {
                largest = left
            }

            if right < heap_size {
                let largest_ref2: ref T = this.get(base_off + largest).unwrap()
                let right_ref: ref T = this.get(base_off + right).unwrap()
                if right_ref.gt(largest_ref2) {
                    largest = right
                }
            }

            if largest == root {
                return
            }
            this.swap(base_off + root, base_off + largest)
            root = largest
        }
    }

    /// Lomuto partition with median-of-three pivot selection.
    ///
    /// Selects the median of {low, mid, high} elements as pivot and moves
    /// it to the high position before partitioning. This prevents O(n^2)
    /// on already-sorted or reverse-sorted inputs.
    func partition(mut this, low: I64, high: I64) -> I64 {
        // Median-of-three: select median of {low, mid, high} as pivot
        let mid: I64 = low + (high - low) / 2
        // Sort the three elements so median ends up in the middle
        let low_ref: ref T = this.get(low).unwrap()
        let mid_ref: ref T = this.get(mid).unwrap()
        if mid_ref.lt(low_ref) {
            this.swap(low, mid)
        }
        let low_ref2: ref T = this.get(low).unwrap()
        let high_ref: ref T = this.get(high).unwrap()
        if high_ref.lt(low_ref2) {
            this.swap(low, high)
        }
        let mid_ref2: ref T = this.get(mid).unwrap()
        let high_ref2: ref T = this.get(high).unwrap()
        if mid_ref2.lt(high_ref2) {
            // Median is at mid — move it to high (pivot position)
            this.swap(mid, high)
        }
        // Now the median element is at `high`

        let pivot_ref: ref T = this.get(high).unwrap()
        let mut i: I64 = low - 1
        let mut j: I64 = low
        loop (j < high) {
            let current_ref: ref T = this.get(j).unwrap()
            if current_ref.le(pivot_ref) {
                i = i + 1
                this.swap(i, j)
            }
            j = j + 1
        }
        this.swap(i + 1, high)
        return i + 1
    }
}

// ============================================================================
// Sorting with Custom Comparator
// ============================================================================

impl[T] MutSlice[T] {
    /// Sorts the slice with a comparator function.
    ///
    /// This sort is unstable (i.e., may reorder equal elements), in-place
    /// (i.e., does not allocate), and *O*(*n* \* log(*n*)) worst-case.
    ///
    /// The comparator function must define a total ordering for the elements
    /// in the slice. If the ordering is not total, the resulting order is
    /// unspecified.
    ///
    /// # Examples
    ///
    /// Sort in ascending order:
    ///
    /// ```tml
    /// let mut v = [5, 4, 1, 3, 2]
    /// v.as_mut_slice().sort_by(do(a, b) a.cmp(b))
    /// assert_eq(v, [1, 2, 3, 4, 5])
    /// ```
    ///
    /// Sort in descending order:
    ///
    /// ```tml
    /// let mut v = [5, 4, 1, 3, 2]
    /// v.as_mut_slice().sort_by(do(a, b) b.cmp(a))
    /// assert_eq(v, [5, 4, 3, 2, 1])
    /// ```
    ///
    /// Sort strings by length:
    ///
    /// ```tml
    /// let mut words = ["apple", "pie", "banana", "fig"]
    /// words.as_mut_slice().sort_by(do(a, b) a.len().cmp(ref b.len()))
    /// assert_eq(words, ["pie", "fig", "apple", "banana"])
    /// ```
    pub func sort_by(mut this, compare: func(ref T, ref T) -> Ordering) {
        if this.len <= 1 {
            return
        }
        let max_depth: I64 = 2 * floor_log2(this.len)
        this.introsort_by(0, this.len - 1, max_depth, compare)
    }

    /// Introsort with custom comparison: quicksort with depth limit.
    func introsort_by(mut this, low: I64, high: I64, depth_limit: I64, compare: func(ref T, ref T) -> Ordering) {
        let size: I64 = high - low + 1
        if size <= 1 {
            return
        }
        if size < 16 {
            this.insertion_sort_by(low, high, compare)
            return
        }
        if depth_limit == 0 {
            this.heapsort_by(low, high, compare)
            return
        }
        let pivot: I64 = this.partition_by(low, high, compare)
        if pivot > 0 {
            this.introsort_by(low, pivot - 1, depth_limit - 1, compare)
        }
        this.introsort_by(pivot + 1, high, depth_limit - 1, compare)
    }

    /// Insertion sort with custom comparison for small partitions.
    func insertion_sort_by(mut this, low: I64, high: I64, compare: func(ref T, ref T) -> Ordering) {
        let mut i: I64 = low + 1
        loop (i <= high) {
            let mut j: I64 = i
            loop (j > low) {
                let prev: ref T = this.get(j - 1).unwrap()
                let curr: ref T = this.get(j).unwrap()
                when compare(prev, curr) {
                    Greater => {
                        this.swap(j - 1, j)
                        j = j - 1
                    },
                    _ => {
                        j = low  // break
                    }
                }
            }
            i = i + 1
        }
    }

    /// Heapsort with custom comparison fallback.
    func heapsort_by(mut this, low: I64, high: I64, compare: func(ref T, ref T) -> Ordering) {
        let n: I64 = high - low + 1

        let mut i: I64 = n / 2 - 1
        loop (i >= 0) {
            this.sift_down_by(low, i, n, compare)
            i = i - 1
        }

        let mut end: I64 = n - 1
        loop (end > 0) {
            this.swap(low, low + end)
            this.sift_down_by(low, 0, end, compare)
            end = end - 1
        }
    }

    /// Sift down with custom comparison.
    func sift_down_by(mut this, base_off: I64, idx: I64, heap_size: I64, compare: func(ref T, ref T) -> Ordering) {
        let mut root: I64 = idx
        loop (2 * root + 1 < heap_size) {
            let left: I64 = 2 * root + 1
            let right: I64 = left + 1
            let mut largest: I64 = root

            let largest_ref: ref T = this.get(base_off + largest).unwrap()
            let left_ref: ref T = this.get(base_off + left).unwrap()
            when compare(left_ref, largest_ref) {
                Greater => { largest = left },
                _ => {}
            }

            if right < heap_size {
                let largest_ref2: ref T = this.get(base_off + largest).unwrap()
                let right_ref: ref T = this.get(base_off + right).unwrap()
                when compare(right_ref, largest_ref2) {
                    Greater => { largest = right },
                    _ => {}
                }
            }

            if largest == root {
                return
            }
            this.swap(base_off + root, base_off + largest)
            root = largest
        }
    }

    /// Partition with median-of-three pivot and custom comparison.
    func partition_by(mut this, low: I64, high: I64, compare: func(ref T, ref T) -> Ordering) -> I64 {
        let mid: I64 = low + (high - low) / 2

        // Sort three elements to find median
        let low_ref: ref T = this.get(low).unwrap()
        let mid_ref: ref T = this.get(mid).unwrap()
        when compare(mid_ref, low_ref) {
            Less => this.swap(low, mid),
            _ => {}
        }
        let low_ref2: ref T = this.get(low).unwrap()
        let high_ref: ref T = this.get(high).unwrap()
        when compare(high_ref, low_ref2) {
            Less => this.swap(low, high),
            _ => {}
        }
        let mid_ref2: ref T = this.get(mid).unwrap()
        let high_ref2: ref T = this.get(high).unwrap()
        when compare(mid_ref2, high_ref2) {
            Less => this.swap(mid, high),
            _ => {}
        }

        let pivot_ref: ref T = this.get(high).unwrap()
        let mut i: I64 = low - 1
        let mut j: I64 = low
        loop (j < high) {
            let current_ref: ref T = this.get(j).unwrap()
            when compare(current_ref, pivot_ref) {
                Less => {
                    i = i + 1
                    this.swap(i, j)
                },
                Equal => {
                    i = i + 1
                    this.swap(i, j)
                },
                Greater => {}
            }
            j = j + 1
        }
        this.swap(i + 1, high)
        return i + 1
    }

    /// Sorts the slice with a key extraction function.
    ///
    /// This sort is unstable (i.e., may reorder equal elements), in-place
    /// (i.e., does not allocate), and *O*(*m* \* *n* \* log(*n*)) worst-case,
    /// where the key function is *O*(*m*).
    ///
    /// # Examples
    ///
    /// Sort by absolute value:
    ///
    /// ```tml
    /// let mut v = [-5, 4, 1, -3, 2]
    /// v.as_mut_slice().sort_by_key(do(k) k.abs())
    /// assert_eq(v, [1, 2, -3, 4, -5])
    /// ```
    ///
    /// Sort structs by a field:
    ///
    /// ```tml
    /// let mut people = [
    ///     Person { name: "Alice", age: 30 },
    ///     Person { name: "Bob", age: 25 },
    ///     Person { name: "Charlie", age: 35 }
    /// ]
    /// people.as_mut_slice().sort_by_key(do(p) p.age)
    /// // Now sorted by age: Bob (25), Alice (30), Charlie (35)
    /// ```
    ///
    /// # Performance Note
    ///
    /// The key function is called multiple times per element during sorting.
    /// If the key computation is expensive, consider using sort_by with
    /// cached keys or a Schwartzian transform.
    pub func sort_by_key[K: Ord](mut this, key_fn: func(ref T) -> K) {
        this.sort_by(do(a: ref T, b: ref T) key_fn(a).cmp(ref key_fn(b)))
    }
}

// ============================================================================
// Additional Sorting Utilities
// ============================================================================

impl[T: Ord] MutSlice[T] {
    /// Checks if the slice is sorted in ascending order.
    ///
    /// Returns true for empty slices and single-element slices.
    ///
    /// # Examples
    ///
    /// ```tml
    /// let sorted = [1, 2, 3, 4, 5]
    /// let unsorted = [1, 3, 2, 4, 5]
    ///
    /// assert(sorted.as_mut_slice().is_sorted())
    /// assert(unsorted.as_mut_slice().is_sorted() == false)
    /// ```
    pub func is_sorted(this) -> Bool {
        if this.len <= 1 {
            return true
        }
        let mut i: I64 = 0
        loop (i < this.len - 1) {
            let a: ref T = this.get(i).unwrap()
            let b: ref T = this.get(i + 1).unwrap()
            if a.gt(b) {
                return false
            }
            i = i + 1
        }
        return true
    }
}

impl[T] MutSlice[T] {
    /// Checks if the slice is sorted according to a comparator.
    ///
    /// # Examples
    ///
    /// ```tml
    /// let desc = [5, 4, 3, 2, 1]
    /// assert(desc.as_mut_slice().is_sorted_by(do(a, b) b.cmp(a)))
    /// ```
    pub func is_sorted_by(this, compare: func(ref T, ref T) -> Ordering) -> Bool {
        if this.len <= 1 {
            return true
        }
        let mut i: I64 = 0
        loop (i < this.len - 1) {
            let a: ref T = this.get(i).unwrap()
            let b: ref T = this.get(i + 1).unwrap()
            when compare(a, b) {
                Greater => return false,
                _ => {}
            }
            i = i + 1
        }
        return true
    }
}
