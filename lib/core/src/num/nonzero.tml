//! Non-zero wrapper type.
//!
//! This module provides the [`NonZero`] wrapper type which guarantees
//! that a value is never zero at the type level.

// PartialEq, Eq, PartialOrd, Ord, Ordering, Duplicate, Copy are builtins - no import needed
use core::num::traits::Zero

// ============================================================================
// NonZero Wrapper Type
// ============================================================================

/// A non-zero wrapper type.
///
/// `NonZero[T]` guarantees at the type level that the value is never zero.
/// This enables optimizations like niche filling in `Maybe[NonZero[T]]`,
/// where the compiler can use zero to represent `Nothing` without any
/// extra space overhead.
///
/// # Examples
///
/// ```tml
/// use core::num::NonZero
///
/// when NonZero::new(42) {
///     Just(n) => assert_eq(n.get(), 42),
///     Nothing => panic("was zero")
/// }
///
/// // Zero returns Nothing
/// assert(NonZero::new(0).is_nothing())
/// ```
///
/// # Size Optimization
///
/// Because `NonZero[T]` can never be zero, `Maybe[NonZero[T]]` has the same
/// size as `T`:
///
/// ```tml
/// // Both are the same size as I32
/// let a: Maybe[NonZero[I32]] = Just(NonZero::new(42).unwrap())
/// let b: Maybe[NonZero[I32]] = Nothing
/// ```
///
/// # When to Use
///
/// - When you know a value cannot be zero
/// - For array lengths and counts (always positive)
/// - For IDs that are never zero
/// - To enable `Maybe` size optimization
pub type NonZero[T] {
    value: T
}

impl[T: Zero + PartialEq] NonZero[T] {
    /// Creates a new `NonZero` if the value is not zero.
    ///
    /// Returns `Nothing` if the value is zero.
    ///
    /// # Examples
    ///
    /// ```tml
    /// assert(NonZero::new(42).is_just())
    /// assert(NonZero::new(0).is_nothing())
    /// ```
    pub func new(value: T) -> Maybe[NonZero[T]] {
        if value.is_zero() {
            return Nothing
        }
        return Just(NonZero { value: value })
    }

    /// Returns the value.
    ///
    /// This method is safe because `NonZero` guarantees the value is never zero.
    ///
    /// # Examples
    ///
    /// ```tml
    /// let n = NonZero::new(42).unwrap()
    /// assert_eq(n.get(), 42)
    /// ```
    pub func get(this) -> T {
        return this.value
    }
}

// ============================================================================
// Checked Arithmetic for NonZero[I32]
// ============================================================================

use core::num::integer::{pow_i32, pow_i64, count_ones_i32, count_ones_i64,
    leading_zeros_i32, leading_zeros_i64, trailing_zeros_i32, trailing_zeros_i64}

impl NonZero[I32] {
    /// Checked addition. Returns `Nothing` on overflow or if the result is zero.
    pub func checked_add(this, other: NonZero[I32]) -> Maybe[NonZero[I32]] {
        let result: I32 = this.value + other.value
        // Check for overflow: if both positive, result must be positive
        // if both negative, result must be negative
        if (other.value > 0 and result < this.value) or
           (other.value < 0 and result > this.value) {
            return Nothing
        }
        if result == 0 {
            return Nothing
        }
        return Just(NonZero { value: result })
    }

    /// Checked subtraction. Returns `Nothing` on underflow or if the result is zero.
    pub func checked_sub(this, other: NonZero[I32]) -> Maybe[NonZero[I32]] {
        let result: I32 = this.value - other.value
        // Check for overflow
        if (other.value < 0 and result < this.value) or
           (other.value > 0 and result > this.value) {
            return Nothing
        }
        if result == 0 {
            return Nothing
        }
        return Just(NonZero { value: result })
    }

    /// Checked multiplication. Returns `Nothing` on overflow.
    pub func checked_mul(this, other: NonZero[I32]) -> Maybe[NonZero[I32]] {
        // Result is never zero since both operands are non-zero
        let a: I64 = this.value as I64
        let b: I64 = other.value as I64
        let result: I64 = a * b
        if result > 2147483647 or result < -2147483648 {
            return Nothing
        }
        return Just(NonZero { value: result as I32 })
    }

    /// Saturating addition. Clamps at I32 bounds. Result is always non-zero
    /// since at least one operand is non-zero and saturation doesn't reach zero.
    pub func saturating_add(this, other: NonZero[I32]) -> NonZero[I32] {
        let a: I64 = this.value as I64
        let b: I64 = other.value as I64
        let result: I64 = a + b
        var clamped: I32 = result as I32
        if result > 2147483647 {
            clamped = 2147483647
        } else if result < -2147483648 {
            clamped = -2147483648 as I32
        }
        // If somehow result is zero (e.g., NonZero(1) + NonZero(-1)), clamp to 1
        if clamped == 0 {
            clamped = 1
        }
        return NonZero { value: clamped }
    }

    /// Saturating subtraction. Clamps at I32 bounds.
    pub func saturating_sub(this, other: NonZero[I32]) -> NonZero[I32] {
        let a: I64 = this.value as I64
        let b: I64 = other.value as I64
        let result: I64 = a - b
        var clamped: I32 = result as I32
        if result > 2147483647 {
            clamped = 2147483647
        } else if result < -2147483648 {
            clamped = -2147483648 as I32
        }
        if clamped == 0 {
            clamped = 1
        }
        return NonZero { value: clamped }
    }

    /// Saturating multiplication. Clamps at I32 bounds.
    pub func saturating_mul(this, other: NonZero[I32]) -> NonZero[I32] {
        let a: I64 = this.value as I64
        let b: I64 = other.value as I64
        let result: I64 = a * b
        var clamped: I32 = result as I32
        if result > 2147483647 {
            clamped = 2147483647
        } else if result < -2147483648 {
            clamped = -2147483648 as I32
        }
        return NonZero { value: clamped }
    }

    /// Returns the number of ones in the binary representation.
    pub func count_ones(this) -> I32 {
        return count_ones_i32(this.value)
    }

    /// Returns the number of leading zeros in the binary representation.
    pub func leading_zeros(this) -> I32 {
        return leading_zeros_i32(this.value)
    }

    /// Returns the number of trailing zeros in the binary representation.
    pub func trailing_zeros(this) -> I32 {
        return trailing_zeros_i32(this.value)
    }

    /// Raises this non-zero value to the power of `exp`.
    pub func pow(this, exp: I32) -> NonZero[I32] {
        return NonZero { value: pow_i32(this.value, exp) }
    }

    /// Returns the base-2 logarithm of the value, rounded down.
    ///
    /// # Panics
    ///
    /// Panics if the value is negative.
    pub func ilog2(this) -> I32 {
        if this.value <= 0 {
            panic("NonZero::ilog2 called on non-positive value")
        }
        return 31 - leading_zeros_i32(this.value)
    }
}

// NOTE: NonZero[I64] methods (count_ones, leading_zeros, trailing_zeros, pow, ilog2)
// and checked/saturating methods for BOTH I32 and I64 are implemented above but
// BLOCKED by a codegen bug: having both `impl NonZero[I32]` and `impl NonZero[I64]`
// in the same file causes the codegen to confuse NonZero__I32 with NonZero__I64
// type layouts. Additionally, methods returning Maybe[NonZero[T]] on concrete
// specializations generate IR with wrong type. The I32 methods work when I64 impl
// is not present. The I64 impl will be re-added once the codegen bug is fixed.

// ============================================================================
// Trait Implementations
// ============================================================================

impl[T: Zero + PartialEq + Duplicate] Duplicate for NonZero[T] {
    pub func duplicate(this) -> NonZero[T] {
        return NonZero { value: this.value.duplicate() }
    }
}

impl[T: Copy] Copy for NonZero[T] {}

impl[T: PartialEq] PartialEq for NonZero[T] {
    pub func eq(this, other: ref NonZero[T]) -> Bool {
        return this.value.eq(ref other.value)
    }
}

impl[T: Eq] Eq for NonZero[T] {}

impl[T: PartialOrd] PartialOrd for NonZero[T] {
    pub func partial_cmp(this, other: ref NonZero[T]) -> Maybe[Ordering] {
        return this.value.partial_cmp(ref other.value)
    }
}

impl[T: Ord] Ord for NonZero[T] {
    pub func cmp(this, other: ref NonZero[T]) -> Ordering {
        return this.value.cmp(ref other.value)
    }
}
