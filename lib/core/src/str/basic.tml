//! Basic string operations: length, character access, and substrings.

// ============================================================================
// FFI declarations for optimized C library string functions
// ============================================================================

@extern("strlen")
func c_strlen(s: Str) -> I64

// phase1k: reads the cached length from the length-prefix header for
// heap-allocated Str buffers (O(1)); transparently falls back to
// strlen for literals and legacy raw-malloc strings via an image-range
// + magic-sentinel check inside the runtime.
@extern("tml_str_len")
func c_tml_str_len(s: Str) -> I64

@extern("memcmp")
func c_memcmp(a: *U8, b: *U8, n: I64) -> I32

@extern("memchr")
func c_memchr(s: *U8, c: I32, n: I64) -> *U8

// phase1k: length-prefix allocator — returned buffer has the
// `[magic | cap | len | data | NUL]` header, so the caller's `Str.len()`
// is O(1) and subsequent `str_append` on this buffer hits the in-place
// fast path.
@extern("tml_str_alloc_len")
func c_tml_str_alloc_len(len: I64) -> *U8

// ============================================================================
// String Length and Emptiness
// ============================================================================

/// Returns the length of a string in bytes.
///
/// Note: This returns the byte length, not the character count. For UTF-8
/// strings with multi-byte characters, this may differ from the visible
/// character count.
///
/// Binds to `tml_str_len` (phase1k), which is O(1) for heap-allocated
/// `Str` buffers (reads the cached length from the length-prefix
/// header). Falls back to `strlen` for `.rdata` literals and any
/// legacy heap string allocated without the header — so the result
/// is identical to the previous `strlen`-only implementation.
///
/// # Examples
///
/// ```tml
/// assert(len("hello") == 5)
/// assert(len("") == 0)
/// ```
pub func len(s: Str) -> I64 {
    let addr: I64 = s as I64
    if addr == 0 {
        return 0
    }
    return c_tml_str_len(s)
}

/// Returns `true` if the string is empty.
///
/// # Examples
///
/// ```tml
/// assert(is_empty("") == true)
/// assert(is_empty("hello") == false)
/// ```
pub func is_empty(s: Str) -> Bool {
    return len(s) == 0
}

// ============================================================================
// Character Access
// ============================================================================

/// Returns the character at the given byte index.
///
/// # Panics
///
/// Panics if the index is out of bounds.
///
/// # Examples
///
/// ```tml
/// assert(char_at("hello", 0) == 'h')
/// assert(char_at("hello", 4) == 'o')
/// ```
pub func char_at(s: Str, index: I64) -> I32 {
    let ptr_addr: I64 = s as I64
    if ptr_addr == 0 or index < 0 {
        return 0
    }
    let p: *U8 = (ptr_addr + index) as *U8
    let byte: U8 = lowlevel { ptr_read[U8](p) }
    return byte as I32
}

/// Returns the first character of the string, or `Nothing` if empty.
///
/// # Examples
///
/// ```tml
/// assert(first_char("hello") == Just('h'))
/// assert(first_char("") == Nothing)
/// ```
pub func first_char(s: Str) -> Maybe[I32] {
    if is_empty(s) {
        return Nothing
    }
    return Just(char_at(s, 0))
}

/// Returns the last character of the string, or `Nothing` if empty.
///
/// # Examples
///
/// ```tml
/// assert(last_char("hello") == Just('o'))
/// assert(last_char("") == Nothing)
/// ```
pub func last_char(s: Str) -> Maybe[I32] {
    let length: I64 = len(s)
    if length == 0 {
        return Nothing
    }
    return Just(char_at(s, length - 1))
}

// ============================================================================
// Substring Operations
// ============================================================================

/// Returns a substring from `start` to `end` (exclusive).
///
/// # Arguments
///
/// * `s` - The source string
/// * `start` - Starting byte index (inclusive)
/// * `end` - Ending byte index (exclusive)
///
/// # Examples
///
/// ```tml
/// assert(substring("hello", 1, 4) == "ell")
/// assert(substring("hello", 0, 5) == "hello")
/// ```
@allocates
pub func substring(s: Str, start: I64, end: I64) -> Str {
    let s_len: I64 = len(s)
    let st: I64 = start
    var en: I64 = end
    if st < 0 or st >= s_len or en <= st {
        return ""
    }
    if en > s_len {
        en = s_len
    }
    let sub_len: I64 = en - st
    // phase1k — length-prefix Str buffer; NUL already written by allocator.
    let buf: *U8 = c_tml_str_alloc_len(sub_len)
    lowlevel { copy_nonoverlapping((s as I64 + st) as *U8, buf, sub_len) }
    return buf as Str
}

/// Returns a substring from `start` to the end of the string.
///
/// # Examples
///
/// ```tml
/// assert(substring_from("hello", 2) == "llo")
/// ```
@allocates
pub func substring_from(s: Str, start: I64) -> Str {
    return substring(s, start, len(s))
}

/// Returns a substring from the beginning to `end` (exclusive).
///
/// # Examples
///
/// ```tml
/// assert(substring_to("hello", 3) == "hel")
/// ```
@allocates
pub func substring_to(s: Str, end: I64) -> Str {
    return substring(s, 0, end)
}
