            and this.m8 and this.m9 and this.m10 and this.m11
            and this.m12 and this.m13 and this.m14 and this.m15
            and this.m16 and this.m17 and this.m18 and this.m19
            and this.m20 and this.m21 and this.m22 and this.m23
            and this.m24 and this.m25 and this.m26 and this.m27
            and this.m28 and this.m29 and this.m30 and this.m31
    }

    /// True if no lane is true.
    pub func none(this) -> Bool {
        return not this.any()
    }

    /// Count the number of true lanes.
    pub func count(this) -> I32 {
        var n: I32 = 0
        if this.m0 { n = n + 1 }
