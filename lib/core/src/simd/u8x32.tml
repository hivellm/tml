//! 32-lane U8 SIMD vector type (256 bits, AVX2).

use core::runtime::intrinsics::{
    simd_load, simd_store, simd_extract, simd_insert,
    llvm_add, llvm_sub, llvm_and, llvm_or, llvm_xor
}

/// A 32-lane vector of U8 values (256 bits total).
/// Requires AVX2 support at runtime.
@simd
pub type U8x32 {
    e0: U8, e1: U8, e2: U8, e3: U8, e4: U8, e5: U8, e6: U8, e7: U8,
    e8: U8, e9: U8, e10: U8, e11: U8, e12: U8, e13: U8, e14: U8, e15: U8,
    e16: U8, e17: U8, e18: U8, e19: U8, e20: U8, e21: U8, e22: U8, e23: U8,
    e24: U8, e25: U8, e26: U8, e27: U8, e28: U8, e29: U8, e30: U8, e31: U8
}

impl U8x32 {
    /// Broadcast a single value to all 32 lanes.
    pub func splat(v: U8) -> U8x32 {
        return U8x32 {
            e0: v, e1: v, e2: v, e3: v, e4: v, e5: v, e6: v, e7: v,
            e8: v, e9: v, e10: v, e11: v, e12: v, e13: v, e14: v, e15: v,
            e16: v, e17: v, e18: v, e19: v, e20: v, e21: v, e22: v, e23: v,
            e24: v, e25: v, e26: v, e27: v, e28: v, e29: v, e30: v, e31: v
        }
    }

    /// All lanes zero.
    pub func zero() -> U8x32 {
        return U8x32::splat(0 as U8)
    }

    /// Get lane by index (0-31). Returns 0 for out-of-bounds.
    pub func get(this, idx: I32) -> U8 {
        if idx < 0 or idx > 31 { return 0 as U8 }
        lowlevel {
            let v = simd_load[U8x32](ref this)
            return simd_extract[U8x32, U8](v, idx)
        }
    }

    /// Return a new vector with lane `idx` replaced by `val`.
    pub func set(this, idx: I32, val: U8) -> U8x32 {
        lowlevel {
            let v = simd_load[U8x32](ref this)
            let w = simd_insert[U8x32, U8](v, val, idx)
            var result: U8x32 = U8x32::zero()
            simd_store[U8x32](mut ref result, w)
            return result
        }
    }

    /// Lane-wise addition (wrapping).
    pub func add(this, other: U8x32) -> U8x32 {
        lowlevel {
            let a = simd_load[U8x32](ref this)
            let b = simd_load[U8x32](ref other)
            let c = llvm_add(a, b)
            var result: U8x32 = U8x32::zero()
            simd_store[U8x32](mut ref result, c)
            return result
        }
    }

    /// Lane-wise subtraction (wrapping).
    pub func sub(this, other: U8x32) -> U8x32 {
        lowlevel {
            let a = simd_load[U8x32](ref this)
            let b = simd_load[U8x32](ref other)
            let c = llvm_sub(a, b)
            var result: U8x32 = U8x32::zero()
            simd_store[U8x32](mut ref result, c)
            return result
        }
    }

    /// Lane-wise bitwise AND.
    pub func band(this, other: U8x32) -> U8x32 {
        lowlevel {
            let a = simd_load[U8x32](ref this)
            let b = simd_load[U8x32](ref other)
            let r = llvm_and(a, b)
            var result: U8x32 = U8x32::zero()
            simd_store[U8x32](mut ref result, r)
            return result
        }
    }

    /// Lane-wise bitwise OR.
    pub func bor(this, other: U8x32) -> U8x32 {
        lowlevel {
            let a = simd_load[U8x32](ref this)
            let b = simd_load[U8x32](ref other)
            let r = llvm_or(a, b)
            var result: U8x32 = U8x32::zero()
            simd_store[U8x32](mut ref result, r)
            return result
        }
    }

    /// Lane-wise bitwise XOR.
    pub func bxor(this, other: U8x32) -> U8x32 {
        lowlevel {
            let a = simd_load[U8x32](ref this)
            let b = simd_load[U8x32](ref other)
            let r = llvm_xor(a, b)
            var result: U8x32 = U8x32::zero()
            simd_store[U8x32](mut ref result, r)
            return result
        }
    }

    /// Sum all 32 lanes into a U32.
    pub func sum(this) -> U32 {
        var total: U32 = 0
        var i = 0
        loop (i < 32) {
            total = total + this.get(i) as U32
            i = i + 1
        }
        return total
    }
}
