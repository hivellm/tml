//! 8-lane I32 SIMD vector type (256 bits, AVX2).

use core::simd::f32x8::F32x8
use core::runtime::intrinsics::{
    simd_load, simd_store, simd_extract, simd_insert, simd_splat,
    llvm_add, llvm_sub, llvm_mul, llvm_div,
    llvm_and, llvm_or, llvm_xor, llvm_shl, llvm_shr
}

/// An 8-lane vector of I32 values (256 bits total).
/// Requires AVX2 support at runtime.
@simd
pub type I32x8 {
    e0: I32, e1: I32, e2: I32, e3: I32,
    e4: I32, e5: I32, e6: I32, e7: I32
}

impl I32x8 {
    /// Construct from eight lane values.
    pub func new(e0: I32, e1: I32, e2: I32, e3: I32, e4: I32, e5: I32, e6: I32, e7: I32) -> I32x8 {
        return I32x8 { e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7 }
    }

    /// Broadcast a single value to all lanes.
    pub func splat(v: I32) -> I32x8 {
        return I32x8 { e0: v, e1: v, e2: v, e3: v, e4: v, e5: v, e6: v, e7: v }
    }

    /// All lanes zero.
    pub func zero() -> I32x8 {
        return I32x8::splat(0)
    }

    /// Get lane by index (0-7). Returns 0 for out-of-bounds.
    pub func get(this, idx: I32) -> I32 {
        if idx < 0 or idx > 7 { return 0 }
        lowlevel {
            let v = simd_load[I32x8](ref this)
            return simd_extract[I32x8, I32](v, idx)
        }
    }

    /// Return a new vector with lane `idx` replaced by `val`.
    pub func set(this, idx: I32, val: I32) -> I32x8 {
        lowlevel {
            let v = simd_load[I32x8](ref this)
            let w = simd_insert[I32x8, I32](v, val, idx)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, w)
            return result
        }
    }

    // -- Arithmetic --

    /// Lane-wise addition.
    pub func add(this, other: I32x8) -> I32x8 {
        lowlevel {
            let a = simd_load[I32x8](ref this)
            let b = simd_load[I32x8](ref other)
            let c = llvm_add(a, b)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, c)
            return result
        }
    }

    /// Lane-wise subtraction.
    pub func sub(this, other: I32x8) -> I32x8 {
        lowlevel {
            let a = simd_load[I32x8](ref this)
            let b = simd_load[I32x8](ref other)
            let c = llvm_sub(a, b)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, c)
            return result
        }
    }

    /// Lane-wise multiplication (low 32 bits of each product).
    pub func mul(this, other: I32x8) -> I32x8 {
        lowlevel {
            let a = simd_load[I32x8](ref this)
            let b = simd_load[I32x8](ref other)
            let c = llvm_mul(a, b)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, c)
            return result
        }
    }

    /// Lane-wise division.
    pub func div(this, other: I32x8) -> I32x8 {
        lowlevel {
            let a = simd_load[I32x8](ref this)
            let b = simd_load[I32x8](ref other)
            let c = llvm_div(a, b)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, c)
            return result
        }
    }

    /// Lane-wise negation.
    pub func neg(this) -> I32x8 {
        lowlevel {
            let z = simd_splat[I32x8, I32](0)
            let a = simd_load[I32x8](ref this)
            let r = llvm_sub(z, a)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, r)
            return result
        }
    }

    // -- Bitwise --

    /// Lane-wise bitwise AND.
    pub func band(this, other: I32x8) -> I32x8 {
        lowlevel {
            let a = simd_load[I32x8](ref this)
            let b = simd_load[I32x8](ref other)
            let r = llvm_and(a, b)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, r)
            return result
        }
    }

    /// Lane-wise bitwise OR.
    pub func bor(this, other: I32x8) -> I32x8 {
        lowlevel {
            let a = simd_load[I32x8](ref this)
            let b = simd_load[I32x8](ref other)
            let r = llvm_or(a, b)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, r)
            return result
        }
    }

    /// Lane-wise bitwise XOR.
    pub func bxor(this, other: I32x8) -> I32x8 {
        lowlevel {
            let a = simd_load[I32x8](ref this)
            let b = simd_load[I32x8](ref other)
            let r = llvm_xor(a, b)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, r)
            return result
        }
    }

    /// Lane-wise left shift.
    pub func shift_left(this, n: I32) -> I32x8 {
        lowlevel {
            let a = simd_load[I32x8](ref this)
            let s = simd_splat[I32x8, I32](n)
            let r = llvm_shl(a, s)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, r)
            return result
        }
    }

    /// Lane-wise arithmetic right shift.
    pub func shift_right(this, n: I32) -> I32x8 {
        lowlevel {
            let a = simd_load[I32x8](ref this)
            let s = simd_splat[I32x8, I32](n)
            let r = llvm_shr(a, s)
            var result: I32x8 = I32x8::zero()
            simd_store[I32x8](mut ref result, r)
            return result
        }
    }

    // -- Horizontal reductions --

    /// Sum all 8 lanes.
    pub func sum(this) -> I32 {
        return this.e0 + this.e1 + this.e2 + this.e3 + this.e4 + this.e5 + this.e6 + this.e7
    }

    /// Product of all lanes.
    pub func product(this) -> I32 {
        return this.e0 * this.e1 * this.e2 * this.e3 * this.e4 * this.e5 * this.e6 * this.e7
    }

    /// Minimum lane value.
    pub func hmin(this) -> I32 {
        var m: I32 = this.e0
        if this.e1 < m { m = this.e1 }
        if this.e2 < m { m = this.e2 }
        if this.e3 < m { m = this.e3 }
        if this.e4 < m { m = this.e4 }
        if this.e5 < m { m = this.e5 }
        if this.e6 < m { m = this.e6 }
        if this.e7 < m { m = this.e7 }
        return m
    }

    /// Maximum lane value.
    pub func hmax(this) -> I32 {
        var m: I32 = this.e0
        if this.e1 > m { m = this.e1 }
        if this.e2 > m { m = this.e2 }
        if this.e3 > m { m = this.e3 }
        if this.e4 > m { m = this.e4 }
        if this.e5 > m { m = this.e5 }
        if this.e6 > m { m = this.e6 }
        if this.e7 > m { m = this.e7 }
        return m
    }

    /// Lane-wise minimum.
    pub func min(this, other: I32x8) -> I32x8 {
        var r0 = this.e0; if other.e0 < r0 { r0 = other.e0 }
        var r1 = this.e1; if other.e1 < r1 { r1 = other.e1 }
        var r2 = this.e2; if other.e2 < r2 { r2 = other.e2 }
        var r3 = this.e3; if other.e3 < r3 { r3 = other.e3 }
        var r4 = this.e4; if other.e4 < r4 { r4 = other.e4 }
        var r5 = this.e5; if other.e5 < r5 { r5 = other.e5 }
        var r6 = this.e6; if other.e6 < r6 { r6 = other.e6 }
        var r7 = this.e7; if other.e7 < r7 { r7 = other.e7 }
        return I32x8 { e0: r0, e1: r1, e2: r2, e3: r3, e4: r4, e5: r5, e6: r6, e7: r7 }
    }

    /// Lane-wise maximum.
    pub func max(this, other: I32x8) -> I32x8 {
        var r0 = this.e0; if other.e0 > r0 { r0 = other.e0 }
        var r1 = this.e1; if other.e1 > r1 { r1 = other.e1 }
        var r2 = this.e2; if other.e2 > r2 { r2 = other.e2 }
        var r3 = this.e3; if other.e3 > r3 { r3 = other.e3 }
        var r4 = this.e4; if other.e4 > r4 { r4 = other.e4 }
        var r5 = this.e5; if other.e5 > r5 { r5 = other.e5 }
        var r6 = this.e6; if other.e6 > r6 { r6 = other.e6 }
        var r7 = this.e7; if other.e7 > r7 { r7 = other.e7 }
        return I32x8 { e0: r0, e1: r1, e2: r2, e3: r3, e4: r4, e5: r5, e6: r6, e7: r7 }
    }

    // -- Display / Debug --

    /// Display as string: "I32x8(e0, e1, ..., e7)".
    pub func to_string(this) -> Str {
        return "I32x8(" + this.e0.to_string() + ", " + this.e1.to_string() + ", "
             + this.e2.to_string() + ", " + this.e3.to_string() + ", "
             + this.e4.to_string() + ", " + this.e5.to_string() + ", "
             + this.e6.to_string() + ", " + this.e7.to_string() + ")"
    }

    /// Debug string representation.
    pub func debug_string(this) -> Str {
        return this.to_string()
    }

    // -- Conversions --

    /// Convert all lanes to F32, returning an F32x8.
    pub func to_f32x8(this) -> F32x8 {
        return F32x8::new(
            this.e0 as F32, this.e1 as F32, this.e2 as F32, this.e3 as F32,
            this.e4 as F32, this.e5 as F32, this.e6 as F32, this.e7 as F32
        )
    }
}
