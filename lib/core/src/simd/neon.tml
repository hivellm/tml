//! ARM NEON portable stubs. // v3
//!
//! These functions provide a NEON-like API using the portable SIMD types.
//! On x86-64, they delegate to the same underlying LLVM vector operations
//! that NEON would use on ARM64. When ARM64 target support is added,
//! these can be replaced with actual NEON intrinsics for optimal codegen.
//!
//! # Coverage
//!
//! - 5.1 Arithmetic: add/sub/mul for i16/i32/i64, f32/f64
//! - 5.2 FMA: fmla/fmls for f32/f64 (fused multiply-add/subtract)
//! - 5.3 Comparison: ceq/cgt/cge/clt/cle for i16/i32, ceq/cgt for f32/f64
//! - 5.4 Bitwise: and/or/xor/bsl/not for 128-bit vectors
//! - 5.5 Horizontal: addv/maxv/minv for i16/i32
//! - 5.6 Min/Max/Abs: lane-wise min/max for i16/i32/f32/f64, abs for i16/i32
//! - 5.7 Memory: ld1/st1/ld2 for i16/i32/i64
//!
//! Note: I8x16-dependent functions are in neon_i8.tml (separate module,
//! pending I8x16::get() codegen fix).

use core::simd::i32x4::I32x4
use core::simd::f32x4::F32x4
use core::simd::i64x2::I64x2
use core::simd::f64x2::F64x2

// ============================================================
// 5.1 NEON Arithmetic
// ============================================================

// -- I16 (8 lanes, delegated to I32x4 reinterpreted as pairs) --
// TML has no I16x8, so we use I32x4 to hold 4 I16 values via scalar ops.

/// NEON VADD.8H equivalent — 4-lane I16 addition via I32x4 scalar delegation.
/// Packs 4 I16 values into one I32x4 vector (in low 16 bits of each lane).
pub func neon_add_i16(a: I32x4, b: I32x4) -> I32x4 {
    return a.add(b)
}

/// NEON VSUB.8H equivalent — 4-lane I16 subtraction via I32x4 delegation.
pub func neon_sub_i16(a: I32x4, b: I32x4) -> I32x4 {
    return a.sub(b)
}

/// NEON VMUL.8H equivalent — 4-lane I16 multiplication (lower 16 bits of I32).
pub func neon_mul_i16(a: I32x4, b: I32x4) -> I32x4 {
    // Multiply as I32 and mask to lower 16 bits per lane to emulate I16 wrapping.
    let r = a.mul(b)
    let mask = I32x4::splat(0xFFFF)
    return r.band(mask)
}

// -- I32 (4 lanes) --

/// NEON VADD.4S equivalent — 4-lane I32 addition.
pub func neon_add_i32(a: I32x4, b: I32x4) -> I32x4 {
    return a.add(b)
}

/// NEON VSUB.4S equivalent — 4-lane I32 subtraction.
pub func neon_sub_i32(a: I32x4, b: I32x4) -> I32x4 {
    return a.sub(b)
}

/// NEON VMUL.4S equivalent — 4-lane I32 multiplication.
pub func neon_mul_i32(a: I32x4, b: I32x4) -> I32x4 {
    return a.mul(b)
}

// -- I64 (2 lanes) --

/// NEON VADD.2D equivalent — 2-lane I64 addition.
pub func neon_add_i64(a: I64x2, b: I64x2) -> I64x2 {
    return a.add(b)
}

/// NEON VSUB.2D equivalent — 2-lane I64 subtraction.
pub func neon_sub_i64(a: I64x2, b: I64x2) -> I64x2 {
    return a.sub(b)
}

// -- F32 (4 lanes) --

/// NEON FADD.4S equivalent — 4-lane F32 addition.
pub func neon_add_f32(a: F32x4, b: F32x4) -> F32x4 {
    return a.add(b)
}

/// NEON FSUB.4S equivalent — 4-lane F32 subtraction.
pub func neon_sub_f32(a: F32x4, b: F32x4) -> F32x4 {
    return a.sub(b)
}

/// NEON FMUL.4S equivalent — 4-lane F32 multiplication.
pub func neon_mul_f32(a: F32x4, b: F32x4) -> F32x4 {
    return a.mul(b)
}

// -- F64 (2 lanes) --

/// NEON FADD.2D equivalent — 2-lane F64 addition.
pub func neon_add_f64(a: F64x2, b: F64x2) -> F64x2 {
    return a.add(b)
}

/// NEON FSUB.2D equivalent — 2-lane F64 subtraction.
pub func neon_sub_f64(a: F64x2, b: F64x2) -> F64x2 {
    return a.sub(b)
}

/// NEON FMUL.2D equivalent — 2-lane F64 multiplication.
pub func neon_mul_f64(a: F64x2, b: F64x2) -> F64x2 {
    return a.mul(b)
}

// ============================================================
// 5.2 NEON FMA (Fused Multiply-Add / Multiply-Subtract)
// ============================================================

/// NEON VFMLA.4S equivalent — fused multiply-add: acc + (a * b) for 4 F32 lanes.
/// On x86 with FMA3, LLVM may fold mul+add into a single VFMADD instruction.
pub func neon_fmla_f32(acc: F32x4, a: F32x4, b: F32x4) -> F32x4 {
    return acc.add(a.mul(b))
}

/// NEON VFMLA.2D equivalent — fused multiply-add: acc + (a * b) for 2 F64 lanes.
pub func neon_fmla_f64(acc: F64x2, a: F64x2, b: F64x2) -> F64x2 {
    return acc.add(a.mul(b))
}

/// NEON VFMLS.4S equivalent — fused multiply-subtract: acc - (a * b) for 4 F32 lanes.
pub func neon_fmls_f32(acc: F32x4, a: F32x4, b: F32x4) -> F32x4 {
    return acc.sub(a.mul(b))
}

/// NEON VFMLS.2D equivalent — fused multiply-subtract: acc - (a * b) for 2 F64 lanes.
pub func neon_fmls_f64(acc: F64x2, a: F64x2, b: F64x2) -> F64x2 {
    return acc.sub(a.mul(b))
}

// ============================================================
// 5.3 NEON Comparison
// Returns vector with -1 (all bits set) for true, 0 for false per lane.
// Use pre-computed vars to avoid inline-if-in-constructor codegen bug.
// ============================================================

// -- I16 comparisons (use I32x4 as 4-lane I16 carrier) --

/// NEON VCEQ.4H equivalent — 4-lane I16 equality (I32x4 carrier). Returns I32x4 mask (-1/0).
pub func neon_ceq_i16(a: I32x4, b: I32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) == b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) == b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) == b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) == b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

/// NEON VCGT.4H equivalent — 4-lane I16 signed greater-than (I32x4 carrier). Returns I32x4 mask (-1/0).
pub func neon_cgt_i16(a: I32x4, b: I32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) > b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) > b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) > b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) > b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

/// NEON VCGE.4H equivalent — 4-lane I16 signed greater-or-equal (I32x4 carrier). Returns I32x4 mask (-1/0).
pub func neon_cge_i16(a: I32x4, b: I32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) >= b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) >= b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) >= b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) >= b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

// -- I32 comparisons --

/// NEON VCEQ.4S equivalent — 4-lane I32 equality comparison. Returns I32x4 mask (-1/0).
pub func neon_ceq_i32(a: I32x4, b: I32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) == b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) == b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) == b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) == b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

/// NEON VCGT.4S equivalent — 4-lane I32 signed greater-than. Returns I32x4 mask (-1/0).
pub func neon_cgt_i32(a: I32x4, b: I32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) > b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) > b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) > b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) > b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

/// NEON VCGE.4S equivalent — 4-lane I32 signed greater-or-equal. Returns I32x4 mask (-1/0).
pub func neon_cge_i32(a: I32x4, b: I32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) >= b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) >= b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) >= b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) >= b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

/// NEON VCLT.4S equivalent — 4-lane I32 signed less-than. Returns I32x4 mask (-1/0).
pub func neon_clt_i32(a: I32x4, b: I32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) < b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) < b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) < b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) < b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

/// NEON VCLE.4S equivalent — 4-lane I32 signed less-or-equal. Returns I32x4 mask (-1/0).
pub func neon_cle_i32(a: I32x4, b: I32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) <= b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) <= b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) <= b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) <= b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

// -- F32 comparisons --

/// NEON FCMEQ.4S equivalent — 4-lane F32 equality. Returns I32x4 mask (-1/0).
pub func neon_ceq_f32(a: F32x4, b: F32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) == b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) == b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) == b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) == b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

/// NEON FCMGT.4S equivalent — 4-lane F32 greater-than. Returns I32x4 mask (-1/0).
pub func neon_cgt_f32(a: F32x4, b: F32x4) -> I32x4 {
    var r0: I32 = 0; if a.get(0) > b.get(0) { r0 = -1 }
    var r1: I32 = 0; if a.get(1) > b.get(1) { r1 = -1 }
    var r2: I32 = 0; if a.get(2) > b.get(2) { r2 = -1 }
    var r3: I32 = 0; if a.get(3) > b.get(3) { r3 = -1 }
    return I32x4::new(r0, r1, r2, r3)
}

// -- F64 comparisons --

/// NEON FCMEQ.2D equivalent — 2-lane F64 equality. Returns I64x2 mask (-1/0).
pub func neon_ceq_f64(a: F64x2, b: F64x2) -> I64x2 {
    var r0: I64 = 0 as I64; if a.get(0) == b.get(0) { r0 = -1 as I64 }
    var r1: I64 = 0 as I64; if a.get(1) == b.get(1) { r1 = -1 as I64 }
    return I64x2::new(r0, r1)
}

/// NEON FCMGT.2D equivalent — 2-lane F64 greater-than. Returns I64x2 mask (-1/0).
pub func neon_cgt_f64(a: F64x2, b: F64x2) -> I64x2 {
    var r0: I64 = 0 as I64; if a.get(0) > b.get(0) { r0 = -1 as I64 }
    var r1: I64 = 0 as I64; if a.get(1) > b.get(1) { r1 = -1 as I64 }
    return I64x2::new(r0, r1)
}

// ============================================================
// 5.4 NEON Bitwise (128-bit, using I32x4 as the 128-bit carrier)
// ============================================================

/// NEON VAND equivalent — 128-bit bitwise AND (via I32x4).
pub func neon_and_v128(a: I32x4, b: I32x4) -> I32x4 {
    return a.band(b)
}

/// NEON VORR equivalent — 128-bit bitwise OR (via I32x4).
pub func neon_or_v128(a: I32x4, b: I32x4) -> I32x4 {
    return a.bor(b)
}

/// NEON VEOR equivalent — 128-bit bitwise XOR (via I32x4).
pub func neon_xor_v128(a: I32x4, b: I32x4) -> I32x4 {
    return a.bxor(b)
}

/// NEON VBSL equivalent — bitwise select: for each bit, choose `a` if mask bit is 1, else `b`.
/// mask=0xFFFFFFFF (all ones per lane) selects `a`; mask=0 selects `b`.
pub func neon_bsl_v128(mask: I32x4, a: I32x4, b: I32x4) -> I32x4 {
    // BSL: (mask AND a) OR (NOT mask AND b)
    let not_mask = mask.bxor(I32x4::splat(-1))
    return mask.band(a).bor(not_mask.band(b))
}

/// NEON VMVN equivalent — bitwise NOT (complement all bits).
pub func neon_not_v128(a: I32x4) -> I32x4 {
    return a.bxor(I32x4::splat(-1))
}

// ============================================================
// 5.5 NEON Horizontal Reductions
// ============================================================

/// NEON VADDV.4H equivalent — horizontal sum of 4 I16 lanes (I32x4 carrier), result as I32.
pub func neon_addv_i16(a: I32x4) -> I32 {
    return a.sum()
}

/// NEON VMAXV.4H equivalent — horizontal max of 4 I16 lanes (I32x4 carrier).
pub func neon_maxv_i16(a: I32x4) -> I32 {
    return a.hmax()
}

/// NEON VMINV.4H equivalent — horizontal min of 4 I16 lanes (I32x4 carrier).
pub func neon_minv_i16(a: I32x4) -> I32 {
    return a.hmin()
}

/// NEON VADDV.4S equivalent — horizontal sum of 4 I32 lanes.
pub func neon_addv_i32(a: I32x4) -> I32 {
    return a.sum()
}

/// NEON VMAXV.4S equivalent — horizontal max of 4 I32 lanes.
pub func neon_maxv_i32(a: I32x4) -> I32 {
    return a.hmax()
}

/// NEON VMINV.4S equivalent — horizontal min of 4 I32 lanes.
pub func neon_minv_i32(a: I32x4) -> I32 {
    return a.hmin()
}

// ============================================================
// 5.6 NEON Min / Max / Abs (lane-wise)
// ============================================================

// -- I16 lane-wise min/max/abs (I32x4 carrier) --

/// NEON VMIN.4H equivalent — lane-wise I16 min (I32x4 carrier).
pub func neon_min_i16(a: I32x4, b: I32x4) -> I32x4 {
    return a.min(b)
}

/// NEON VMAX.4H equivalent — lane-wise I16 max (I32x4 carrier).
pub func neon_max_i16(a: I32x4, b: I32x4) -> I32x4 {
    return a.max(b)
}

/// NEON VABS.4H equivalent — lane-wise I16 absolute value (I32x4 carrier).
pub func neon_abs_i16(a: I32x4) -> I32x4 {
    var r0: I32 = a.get(0); if r0 < 0 { r0 = 0 - r0 }
    var r1: I32 = a.get(1); if r1 < 0 { r1 = 0 - r1 }
    var r2: I32 = a.get(2); if r2 < 0 { r2 = 0 - r2 }
    var r3: I32 = a.get(3); if r3 < 0 { r3 = 0 - r3 }
    return I32x4::new(r0, r1, r2, r3)
}

// -- I32 lane-wise min/max/abs --

/// NEON VMIN.4S equivalent — lane-wise signed I32 min.
pub func neon_min_i32(a: I32x4, b: I32x4) -> I32x4 {
    return a.min(b)
}

/// NEON VMAX.4S equivalent — lane-wise signed I32 max.
pub func neon_max_i32(a: I32x4, b: I32x4) -> I32x4 {
    return a.max(b)
}

/// NEON VABS.4S equivalent — lane-wise I32 absolute value.
pub func neon_abs_i32(a: I32x4) -> I32x4 {
    var r0: I32 = a.get(0); if r0 < 0 { r0 = 0 - r0 }
    var r1: I32 = a.get(1); if r1 < 0 { r1 = 0 - r1 }
    var r2: I32 = a.get(2); if r2 < 0 { r2 = 0 - r2 }
    var r3: I32 = a.get(3); if r3 < 0 { r3 = 0 - r3 }
    return I32x4::new(r0, r1, r2, r3)
}

// -- F32 lane-wise min/max --

/// NEON FMIN.4S equivalent — lane-wise F32 min.
pub func neon_min_f32(a: F32x4, b: F32x4) -> F32x4 {
    return a.min(b)
}

/// NEON FMAX.4S equivalent — lane-wise F32 max.
pub func neon_max_f32(a: F32x4, b: F32x4) -> F32x4 {
    return a.max(b)
}

// -- F64 lane-wise min/max --

/// NEON FMIN.2D equivalent — lane-wise F64 min.
pub func neon_min_f64(a: F64x2, b: F64x2) -> F64x2 {
    return a.min(b)
}

/// NEON FMAX.2D equivalent — lane-wise F64 max.
pub func neon_max_f64(a: F64x2, b: F64x2) -> F64x2 {
    return a.max(b)
}

// ============================================================
// 5.7 NEON Memory (Load / Store)
// ============================================================

// Since TML SIMD types are value types (not backed by raw pointers here),
// ld1/st1 are simulated as constructors from individual scalar values.
// In practice, callers would use the type constructors directly.
// These functions serve as named stubs for API parity with NEON.

/// NEON VLD1.4H equivalent — load 4 I16 values into an I32x4 (I16 carrier).
pub func neon_ld1_i16(v0: I32, v1: I32, v2: I32, v3: I32) -> I32x4 {
    return I32x4::new(v0, v1, v2, v3)
}

/// NEON VLD1.4S equivalent — load 4 I32 values into an I32x4 vector.
pub func neon_ld1_i32(v0: I32, v1: I32, v2: I32, v3: I32) -> I32x4 {
    return I32x4::new(v0, v1, v2, v3)
}

/// NEON VLD1.2D equivalent — load 2 I64 values into an I64x2 vector.
pub func neon_ld1_i64(v0: I64, v1: I64) -> I64x2 {
    return I64x2::new(v0, v1)
}

/// NEON VST1.4S equivalent — extract all 4 I32 lanes from vector (store simulation).
/// Returns the vector unchanged; caller uses .get(i) to extract lanes.
pub func neon_st1_i32(v: I32x4) -> I32x4 {
    return v
}

/// NEON VST1.2D equivalent — returns the I64x2 vector unchanged (store simulation).
pub func neon_st1_i64(v: I64x2) -> I64x2 {
    return v
}

/// NEON VLD2.4S equivalent — deinterleave even-indexed I32 values from 8 alternating values.
pub func neon_ld2_i32_even(
    a0: I32, b0: I32, a1: I32, b1: I32,
    a2: I32, b2: I32, a3: I32, b3: I32
) -> I32x4 {
    return I32x4::new(a0, a1, a2, a3)
}

/// NEON VLD2.4S odd channel — returns the odd-index vector from interleaved data.
pub func neon_ld2_i32_odd(
    a0: I32, b0: I32, a1: I32, b1: I32,
    a2: I32, b2: I32, a3: I32, b3: I32
) -> I32x4 {
    return I32x4::new(b0, b1, b2, b3)
}
