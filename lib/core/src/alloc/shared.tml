//! Reference-Counted Pointer for Shared Ownership
//!
//! The `Shared[T]` type provides shared ownership of heap-allocated data using
//! non-atomic reference counting. Similar to Rust's `Rc[T]`.
//!
//! # Multiple Ownership
//!
//! `Shared[T]` allows multiple owners of the same value:
//! - Each `duplicate()` call increments the reference count
//! - When an owner is dropped, the count is decremented
//! - Memory is freed when the reference count reaches zero
//!
//! # Non-Thread-Safe
//!
//! `Shared[T]` uses non-atomic reference counting and is **NOT thread-safe**.
//! For thread-safe reference counting across threads, use `Sync[T]` instead (which
//! uses atomic operations).
//!
//! # Examples
//!
//! ```tml
//! let shared1 = Shared::new(42)
//! let shared2 = shared1.duplicate()  // Increments ref count
//! print(shared1.strong_count())  // 2
//! print(shared2.get())  // 42
//! // When both shared1 and shared2 are dropped, memory is freed
//! ```
//!
//! # Performance
//!
//! Because `Shared[T]` uses non-atomic operations, it is faster than `Sync[T]`
//! when sharing is only needed within a single thread.

use core::runtime::mem::{mem_alloc, mem_free, size_of}
use core::ops::Deref
use core::traits::clone::Duplicate
use core::fmt::{Display, Debug}
use core::traits::default::Default

/// Inner structure holding the value and reference counts.
type SharedInner[T] {
    value: T,
    strong_count: I32,
    weak_count: I32,
}

/// A reference-counted pointer for shared ownership.
///
/// `Shared[T]` allows multiple owners of the same heap-allocated value.
/// When the last owner is dropped, the memory is freed.
///
/// ## Reference Counting
///
/// - Each `duplicate()` increments the reference count
/// - Each drop decrements the reference count
/// - Memory is freed when the count reaches zero
///
/// ## Non-Thread-Safe
///
/// `Shared[T]` uses non-atomic reference counting and is NOT thread-safe.
/// For thread-safe reference counting, use `Sync[T]` (Arc).
///
/// ## Examples
///
/// ```tml
/// let original = Shared::new(100)
/// print(original.strong_count())  // 1
///
/// let clone1 = original.duplicate()
/// print(original.strong_count())  // 2
///
/// let clone2 = original.duplicate()
/// print(original.strong_count())  // 3
///
/// // All clones point to the same data
/// print(original.get())  // 100
/// print(clone1.get())    // 100
/// print(clone2.get())    // 100
/// ```
pub type Shared[T] {
    ptr: *SharedInner[T],
}

impl[T] Shared[T] {
    /// Creates a new `Shared[T]` with reference count of 1.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let shared = Shared::new(42)
    /// assert_eq(shared.strong_count(), 1)
    /// ```
    pub func new(value: T) -> Shared[T] {
        let size: I64 = size_of[SharedInner[T]]()
        let ptr: *Unit = mem_alloc(size)

        if ptr == null {
            panic("Shared::new: allocation failed")
        }

        let typed_ptr: *SharedInner[T] = ptr as *SharedInner[T]

        // Initialize the inner structure
        *typed_ptr = SharedInner[T] {
            value: value,
            strong_count: 1,
            weak_count: 1,
        }

        return Shared { ptr: typed_ptr }
    }

    /// Creates a new `Shared[T]` with a default value.
    pub func new_default() -> Shared[T] where T: Default {
        return Shared::new(T::default())
    }

    /// Returns a copy of the inner value.
    ///
    /// Reads through `ptr_read_clone`, which auto-emits `T::duplicate()` when
    /// `T` contains nested refcounted handles (`Shared` / `Heap` / `Sync` /
    /// `Str` …) so the returned copy carries fresh refcounts. For primitive
    /// `T` it is a plain load (zero cost).
    ///
    /// For a zero-copy read, prefer `get_ref(this) -> ref T`.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let shared = Shared::new(42)
    /// assert_eq(shared.get(), 42)
    /// ```
    pub func get(this) -> T {
        if this.ptr == null {
            panic("Shared::get: null pointer")
        }
        // `value` is field 0 of SharedInner[T], so this.ptr doubles as *T.
        let val_ptr: *T = this.ptr as *T
        return lowlevel { ptr_read_clone[T](val_ptr) }
    }

    /// Returns a deep clone of the inner value via `T::duplicate()`.
    ///
    /// Equivalent in safety to `get`, but requires `T: Duplicate` and always
    /// deep-clones by invoking `T::duplicate()` on the inner value, so every
    /// nested `Shared` / `Heap` / `Sync` handle in the result carries its own
    /// fresh refcount bump. Kept for callers that want the clone explicit in
    /// source.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let shared = Shared::new(42)
    /// assert_eq(shared.get_clone(), 42)
    /// ```
    pub func get_clone(this) -> T where T: Duplicate {
        if this.ptr == null {
            panic("Shared::get_clone: null pointer")
        }
        return (*this.ptr).value.duplicate()
    }

    /// Returns a reference to the inner value WITHOUT loading it by value.
    ///
    /// `get_ref` returns a borrow directly into the allocation: no bitwise
    /// temp is materialised and no drop-glue runs. This is the zero-copy
    /// pattern when the consumer wants to inspect the inner value (e.g.
    /// pattern-match on an enum) without taking ownership. Refcount semantics
    /// are unaffected — the original `Shared` retains its strong reference.
    ///
    /// The `value` field is at offset 0 of `SharedInner[T]`, so a borrow of
    /// the field aliases the allocation directly. This uses the same
    /// `ref (*this.ptr).value` borrow pattern as `Deref::deref` (a GEP into
    /// the inner, no aggregate load, no drop-glue) rather than the
    /// `ptr_as_ref[T]` intrinsic, whose codegen currently mis-types the
    /// return as `i32`.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let s = Shared::new(Tree::Leaf)
    /// let r: ref Tree = s.get_ref()
    /// when *r {
    ///     Leaf => println("leaf"),
    ///     Node(_) => println("node")
    /// }
    /// // s still owns its reference; r borrows into it.
    /// ```
    pub func get_ref(this) -> ref T {
        if this.ptr == null {
            panic("Shared::get_ref: null pointer")
        }
        lowlevel {
            return ref (*this.ptr).value
        }
    }

    /// Returns the current reference count.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let shared = Shared::new(42)
    /// assert_eq(shared.strong_count(), 1)
    ///
    /// let clone = shared.duplicate()
    /// assert_eq(shared.strong_count(), 2)
    /// ```
    pub func strong_count(this) -> I32 {
        if this.ptr == null {
            return 0
        }
        return (*this.ptr).strong_count
    }

    /// Returns `true` if this is the only reference to the data.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let shared = Shared::new(42)
    /// assert(shared.is_unique())
    ///
    /// let clone = shared.duplicate()
    /// assert(not shared.is_unique())
    /// ```
    pub func is_unique(this) -> Bool {
        return this.strong_count() == 1
    }

    /// Attempts to get a mutable reference if this is the only owner.
    ///
    /// Returns `Just(value)` if unique, `Nothing` otherwise.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let mut shared = Shared::new(42)
    /// assert(shared.is_unique())
    ///
    /// // Can get mutable access when unique
    /// when shared.get_mut() {
    ///     Just(val) => *val = 100,
    ///     Nothing => panic("Not unique!")
    /// }
    /// ```
    pub func get_mut(mut this) -> Maybe[*T] {
        if this.is_unique() {
            return Just(this.ptr as *T)
        } else {
            return Nothing
        }
    }

    /// Attempts to unwrap and return the inner value if this is the only owner.
    ///
    /// Returns `Just(value)` if unique, `Nothing` otherwise.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let shared = Shared::new(42)
    /// when Shared::try_unwrap(shared) {
    ///     Just(val) => print("Got: {val}"),
    ///     Nothing => print("Still has multiple owners")
    /// }
    /// ```
    pub func try_unwrap(mut this) -> Maybe[T] {
        if this.is_unique() {
            // Move the value out (bitwise) — the source storage is orphaned
            // without running value's drop-glue, so `value` is the sole owner.
            let value: T = (*this.ptr).value

            // Strong 1 → 0. Mirror `decrement_count`: drop the implicit weak
            // ref held by the strong refs, and free the allocation ONLY when
            // `weak_count` also reaches 0. Outstanding SharedWeak refs (from
            // `downgrade`) keep the inner alive; their `upgrade()` observes
            // strong == 0 and returns Nothing, and their `drop` frees the block
            // once weak reaches 0. Freeing here would dangle those weaks (F-023).
            lowlevel { (*this.ptr).strong_count = 0 }
            let old_weak: I32 = (*this.ptr).weak_count
            let new_weak: I32 = old_weak - 1
            lowlevel { (*this.ptr).weak_count = new_weak }
            if new_weak == 0 {
                mem_free(this.ptr as *Unit)
            }

            // Null the pointer so drop() is a no-op (the strong ref was already
            // released manually above).
            this.ptr = null
            return Just(value)
        } else {
            return Nothing
        }
    }

    /// Returns the raw pointer (for FFI or advanced usage).
    ///
    /// **Warning**: Does not change reference count!
    pub func as_ptr(this) -> *T {
        if this.ptr == null {
            return null
        }
        return this.ptr as *T
    }

    /// Creates a `Shared[T]` from a raw pointer.
    ///
    /// ## Safety
    ///
    /// The pointer must have been created by `Shared::into_raw` or similar.
    /// This does NOT increment the reference count.
    pub func from_raw(ptr: *SharedInner[T]) -> Shared[T] {
        return Shared { ptr: ptr }
    }

    /// Increments the reference count (used internally by duplicate).
    ///
    /// SOUNDNESS (ADR-009 / F-013): read the counter through a direct field
    /// access — NEVER `let inner: SharedInner[T] = *this.ptr`. That bitwise
    /// copy materializes `value: T` in a local whose drop-glue decrements any
    /// nested `Shared`/`Heap` handles for real (confirmed at IR + runtime:
    /// nested counts went 2 → 1 → -1 per duplicate on the AST codegen path).
    pub func increment_count(this) {
        if this.ptr != null {
            let old_count: I32 = (*this.ptr).strong_count
            let new_count: I32 = old_count + 1
            lowlevel { (*this.ptr).strong_count = new_count }
        }
    }

    /// Decrements the strong reference count. When strong reaches zero, the value
    /// is dropped. When both strong and weak reach zero, the allocation is freed.
    pub func decrement_count(this) {
        if this.ptr == null {
            return
        }

        // SOUNDNESS: direct field read — see increment_count (F-013).
        let old_strong: I32 = (*this.ptr).strong_count
        let new_strong: I32 = old_strong - 1
        lowlevel { (*this.ptr).strong_count = new_strong }

        if new_strong == 0 {
            // Decrement the implicit weak ref held by strong refs
            let old_weak: I32 = (*this.ptr).weak_count
            let new_weak: I32 = old_weak - 1
            lowlevel { (*this.ptr).weak_count = new_weak }
            if new_weak == 0 {
                mem_free(this.ptr as *Unit)
            }
        }
    }

    /// Returns the current weak reference count (not counting the implicit weak ref).
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let shared = Shared::new(42)
    /// assert_eq(shared.weak_count(), 0)
    /// let weak = shared.downgrade()
    /// assert_eq(shared.weak_count(), 1)
    /// ```
    pub func weak_count(this) -> I64 {
        if this.ptr == null {
            return 0 as I64
        }
        // weak_count stores (user weak refs + 1 implicit); subtract 1 for the implicit
        let raw: I32 = (*this.ptr).weak_count
        let result: I64 = raw as I64 - 1 as I64
        if result < 0 as I64 {
            return 0 as I64
        }
        return result
    }

    /// Returns `true` if both `Shared` values point to the same allocation.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let a = Shared::new(42)
    /// let b = a.duplicate()
    /// assert(a.ptr_eq(ref b))
    /// ```
    pub func ptr_eq(this, other: ref Shared[T]) -> Bool {
        return this.ptr == (*other).ptr
    }

    /// Creates a `Weak[T]` reference to this allocation.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let shared = Shared::new(42)
    /// let weak = shared.downgrade()
    /// ```
    pub func downgrade(this) -> SharedWeak[T] {
        if this.ptr == null {
            return SharedWeak { ptr: null }
        }
        // Increment the weak count
        let old_weak: I32 = (*this.ptr).weak_count
        lowlevel { (*this.ptr).weak_count = old_weak + 1 }
        return SharedWeak { ptr: this.ptr }
    }
}

/// A weak reference to `Shared[T]`-managed data.
///
/// `SharedWeak[T]` does not prevent the allocation from being freed. Use
/// `upgrade()` to attempt to get a strong `Shared[T]` reference.
///
/// ## Examples
///
/// ```tml
/// let shared = Shared::new(42)
/// let weak = shared.downgrade()
/// when weak.upgrade() {
///     Just(s) => print(s.get().to_string()),
///     Nothing => print("expired"),
/// }
/// ```
pub type SharedWeak[T] {
    ptr: *SharedInner[T],
}

impl[T] SharedWeak[T] {
    /// Attempts to upgrade to a strong `Shared[T]` reference.
    ///
    /// Returns `Nothing` if the allocation has been freed.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let shared = Shared::new(42)
    /// let weak = shared.downgrade()
    /// when weak.upgrade() {
    ///     Just(s) => assert_eq(s.get(), 42),
    ///     Nothing => panic("should not be expired"),
    /// }
    /// ```
    pub func upgrade(this) -> Maybe[Shared[T]] {
        if this.ptr == null {
            return Nothing
        }
        let strong: I32 = (*this.ptr).strong_count
        if strong == 0 {
            return Nothing
        }
        // Increment strong count
        lowlevel { (*this.ptr).strong_count = strong + 1 }
        return Just(Shared { ptr: this.ptr })
    }

    /// Returns `true` if the allocation has been freed (strong count == 0).
    pub func is_expired(this) -> Bool {
        if this.ptr == null {
            return true
        }
        return (*this.ptr).strong_count == 0
    }
}

impl[T] Drop for SharedWeak[T] {
    func drop(mut this) {
        if this.ptr == null {
            return
        }
        let old_weak: I32 = (*this.ptr).weak_count
        let new_weak: I32 = old_weak - 1
        lowlevel { (*this.ptr).weak_count = new_weak }
        if new_weak == 0 {
            mem_free(this.ptr as *Unit)
        }
    }
}

impl[T] Duplicate for Shared[T] {
    /// Creates a new reference to the same data, incrementing the count.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let original = Shared::new(42)
    /// let clone = original.duplicate()
    /// assert_eq(original.strong_count(), 2)
    /// ```
    pub func duplicate(this) -> Shared[T] {
        this.increment_count()
        return Shared { ptr: this.ptr }
    }
}

impl[T] Drop for Shared[T] {
    func drop(mut this) {
        this.decrement_count()
    }
}

impl[T] Display for Shared[T] where T: Display {
    /// Returns the display string of the contained value.
    pub func to_string(this) -> Str {
        return this.get().to_string()
    }
}

impl[T] Debug for Shared[T] where T: Debug {
    /// Returns the debug string representation of the Shared pointer and its value.
    pub func debug_string(this) -> Str {
        return "Shared(strong=" + this.strong_count().to_string() + ", " + this.get().debug_string() + ")"
    }
}

/// Creates a `Shared[T]` from a value.
///
/// ## Examples
///
/// ```tml
/// let shared = shared(42)
/// assert_eq(shared.get(), 42)
/// ```
pub func shared[T](value: T) -> Shared[T] {
    return Shared::new(value)
}
