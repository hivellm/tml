//! Atomic Reference-Counted Pointer for Thread-Safe Shared Ownership
//!
//! The `Sync[T]` type provides thread-safe shared ownership of heap-allocated data
//! using atomic reference counting. Similar to Rust's `Arc[T]`.
//!
//! # Thread-Safe Multiple Ownership
//!
//! `Sync[T]` allows multiple owners of the same value across threads:
//! - Each `duplicate()` call atomically increments the reference count
//! - When an owner is dropped, the count is atomically decremented
//! - Memory is freed when the reference count reaches zero
//! - All operations are thread-safe and atomic
//!
//! # Atomic Operations
//!
//! `Sync[T]` uses atomic operations for reference counting, making it safe
//! to share across threads. The reference count is managed with atomic
//! fetch-and-add, fetch-and-subtract, and load operations.
//!
//! # Examples
//!
//! ```tml
//! let sync1 = Sync::new(42)
//! let sync2 = sync1.duplicate()  // Atomically increments ref count
//! print(sync1.strong_count())  // 2
//! print(sync2.get())  // 42
//! // Can be safely shared across threads
//! // Memory freed when all owners are dropped
//! ```
//!
//! # Performance Considerations
//!
//! - Use `Sync[T]` when sharing across threads
//! - Use `Shared[T]` for single-threaded sharing (faster, no atomic overhead)
//! - Atomic operations have a small performance cost compared to non-atomic operations
//!
//! # Comparison with Shared[T]
//!
//! | Feature | Shared[T] | Sync[T] |
//! |---------|-----------|--------|
//! | Thread-safe | ❌ No | ✅ Yes |
//! | Ref counting | Non-atomic | Atomic |
//! | Performance | Faster | Slightly slower |
//! | Use case | Single-threaded | Multi-threaded |

use core::runtime::mem::{mem_alloc, mem_free, size_of}
use core::runtime::intrinsics::field_offset
use core::ops::Deref
use core::traits::clone::Duplicate
use core::fmt::{Display, Debug}
use core::traits::default::Default

/// FFI declarations for atomic operations (declared at module-level in runtime.cpp)
@extern("atomic_fetch_add_i32")
func atomic_fetch_add_i32(ptr: *I32, val: I32) -> I32

@extern("atomic_fetch_sub_i32")
func atomic_fetch_sub_i32(ptr: *I32, val: I32) -> I32

@extern("atomic_load_i32")
func atomic_load_i32(ptr: *I32) -> I32

/// Inner structure holding the value and atomic reference counts.
type SyncInner[T] {
    value: T,
    strong_count: I32,  // field index 1 — accessed atomically
    weak_count: I32,    // field index 2 — accessed atomically
}

/// An atomic reference-counted pointer for thread-safe shared ownership.
///
/// `Sync[T]` allows multiple owners of the same heap-allocated value across
/// multiple threads. When the last owner is dropped, the memory is freed.
///
/// ## Atomic Reference Counting
///
/// - Each `duplicate()` atomically increments the reference count
/// - Each drop atomically decrements the reference count
/// - Memory is freed when the count reaches zero
/// - All operations are thread-safe
///
/// ## Thread Safety
///
/// `Sync[T]` uses atomic operations for reference counting, making it safe
/// to share across threads.
///
/// ## Examples
///
/// ```tml
/// // Create a thread-safe shared integer
/// let original = Sync::new(100)
/// print(original.strong_count())  // 1
///
/// // Clone can be sent to another thread
/// let clone1 = original.duplicate()
/// print(original.strong_count())  // 2
///
/// // All clones point to the same data
/// print(original.get())  // 100
/// print(clone1.get())    // 100
/// ```
pub type Sync[T] {
    ptr: *SyncInner[T],
}

impl[T] Sync[T] {
    /// Returns a `*I32` to the strong_count field (field index 1).
    pub func strong_count_ptr(this) -> *I32 {
        let addr: I64 = this.ptr as I64
        let off: I64 = field_offset[SyncInner[T]](1)
        return (addr + off) as *I32
    }

    /// Returns a `*I32` to the weak_count field (field index 2).
    pub func weak_count_ptr(this) -> *I32 {
        let ptr_addr: I64 = this.ptr as I64
        let off: I64 = field_offset[SyncInner[T]](2)
        return (ptr_addr + off) as *I32
    }

    /// Creates a new `Sync[T]` with atomic reference count of 1.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let sync = Sync::new(42)
    /// assert_eq(sync.strong_count(), 1)
    /// ```
    pub func new(value: T) -> Sync[T] {
        let size: I64 = size_of[SyncInner[T]]()
        let ptr: *Unit = mem_alloc(size)

        if ptr == null {
            panic("Sync::new: allocation failed")
        }

        let typed_ptr: *SyncInner[T] = ptr as *SyncInner[T]

        // Initialize the inner structure
        *typed_ptr = SyncInner[T] {
            value: value,
            strong_count: 1,
            weak_count: 1,
        }

        return Sync { ptr: typed_ptr }
    }

    /// Creates a new `Sync[T]` with a default value.
    pub func new_default() -> Sync[T] where T: Default {
        return Sync::new(T::default())
    }

    /// Returns a copy of the inner value.
    ///
    /// Reads through `ptr_read_clone`, which auto-emits `T::duplicate()` when
    /// `T` contains nested refcounted handles (`Sync` / `Shared` / `Heap` /
    /// `Str` …) so the returned copy carries fresh refcounts. For primitive
    /// `T` it is a plain load (zero cost).
    ///
    /// For a zero-copy read, prefer `get_ref(this) -> ref T`.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let sync = Sync::new(42)
    /// assert_eq(sync.get(), 42)
    /// ```
    pub func get(this) -> T {
        if this.ptr == null {
            panic("Sync::get: null pointer")
        }
        // `value` is field 0 of SyncInner[T], so this.ptr doubles as *T.
        let val_ptr: *T = this.ptr as *T
        return lowlevel { ptr_read_clone[T](val_ptr) }
    }

    /// Returns a deep clone of the inner value via `T::duplicate()`.
    ///
    /// Equivalent in safety to `get`, but requires `T: Duplicate` and always
    /// deep-clones by invoking `T::duplicate()` on the inner value, so every
    /// nested `Sync` / `Shared` / `Heap` handle in the result carries its own
    /// fresh refcount bump. Kept for callers that want the clone explicit in
    /// source.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let sync = Sync::new(42)
    /// assert_eq(sync.get_clone(), 42)
    /// ```
    pub func get_clone(this) -> T where T: Duplicate {
        if this.ptr == null {
            panic("Sync::get_clone: null pointer")
        }
        return (*this.ptr).value.duplicate()
    }

    /// Returns a reference to the inner value WITHOUT loading it by value.
    ///
    /// `get_ref` returns a borrow into the allocation: no bitwise temp is
    /// materialised, no drop-glue runs. This is the zero-copy pattern when
    /// the consumer wants to inspect the inner value without taking
    /// ownership. Refcount semantics are unaffected — the original `Sync`
    /// retains its strong reference.
    ///
    /// The `value` field is at offset 0 of `SyncInner[T]`, so a borrow of the
    /// field aliases the allocation directly. This uses the same
    /// `ref (*this.ptr).value` borrow pattern as `Arc::get` / `Deref::deref`
    /// (a GEP into the inner, no aggregate load, no drop-glue) rather than the
    /// `ptr_as_ref[T]` intrinsic, whose codegen currently mis-types the return
    /// as `i32` (see `core/tests/ptr/non_null_blocked.test.tml`).
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let s = Sync::new(42)
    /// let r: ref I32 = s.get_ref()
    /// assert_eq(*r, 42)
    /// ```
    pub func get_ref(this) -> ref T {
        if this.ptr == null {
            panic("Sync::get_ref: null pointer")
        }
        lowlevel {
            return ref (*this.ptr).value
        }
    }

    /// Returns the current atomic strong reference count.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let sync = Sync::new(42)
    /// assert_eq(sync.strong_count(), 1)
    ///
    /// let clone = sync.duplicate()
    /// assert_eq(sync.strong_count(), 2)
    /// ```
    pub func strong_count(this) -> I32 {
        if this.ptr == null {
            return 0
        }
        return atomic_load_i32(this.strong_count_ptr())
    }

    /// Returns the current weak reference count (not counting the implicit weak ref).
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let sync = Sync::new(42)
    /// assert_eq(sync.weak_count(), 0)
    /// let weak = sync.downgrade()
    /// assert_eq(sync.weak_count(), 1)
    /// ```
    pub func weak_count(this) -> I64 {
        if this.ptr == null {
            return 0 as I64
        }
        let raw: I32 = atomic_load_i32(this.weak_count_ptr())
        let result: I64 = raw as I64 - 1 as I64
        if result < 0 as I64 {
            return 0 as I64
        }
        return result
    }

    /// Returns `true` if this is the only reference to the data.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let sync = Sync::new(42)
    /// assert(sync.is_unique())
    ///
    /// let clone = sync.duplicate()
    /// assert(not sync.is_unique())
    /// ```
    pub func is_unique(this) -> Bool {
        return this.strong_count() == 1
    }

    /// Attempts to get a mutable raw pointer if this is the only owner.
    ///
    /// Returns `Just(*T)` if unique, `Nothing` otherwise.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let mut sync = Sync::new(42)
    /// when sync.get_mut() {
    ///     Just(p) => lowlevel { *p = 100 },
    ///     Nothing => print("Not unique")
    /// }
    /// ```
    pub func get_mut(mut this) -> Maybe[*T] {
        if this.is_unique() {
            return Just(this.ptr as *T)
        } else {
            return Nothing
        }
    }

    /// Attempts to unwrap and return the inner value if this is the only owner.
    ///
    /// Returns `Just(value)` if unique, `Nothing` otherwise.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let sync = Sync::new(42)
    /// when Sync::try_unwrap(sync) {
    ///     Just(val) => print("Got: {val}"),
    ///     Nothing => print("Still has multiple owners")
    /// }
    /// ```
    pub func try_unwrap(mut this) -> Maybe[T] {
        if this.is_unique() {
            // Move the value out (bitwise) — the source storage is orphaned
            // without running value's drop-glue, so `value` is the sole owner.
            let value: T = (*this.ptr).value

            // Strong 1 → 0 (atomic). Mirror `decrement_count`: drop the
            // implicit weak ref held by the strong refs, and free the
            // allocation ONLY when `weak_count` also reaches 0. Outstanding
            // SyncWeak refs (from `downgrade`) keep the inner alive; their
            // `upgrade()` observes strong == 0 and returns Nothing, and their
            // `drop` frees the block once weak reaches 0. Freeing here would
            // dangle those weaks (F-023).
            atomic_fetch_sub_i32(this.strong_count_ptr(), 1)
            let prev_weak: I32 = atomic_fetch_sub_i32(this.weak_count_ptr(), 1)
            if prev_weak == 1 {
                mem_free(this.ptr as *Unit)
            }

            // Null the pointer so drop() is a no-op (the strong ref was already
            // released manually above).
            this.ptr = null
            return Just(value)
        } else {
            return Nothing
        }
    }

    /// Returns the raw pointer (for FFI or advanced usage).
    ///
    /// **Warning**: Does not change reference count!
    pub func as_ptr(this) -> *T {
        if this.ptr == null {
            return null
        }
        return this.ptr as *T
    }

    /// Creates a `Sync[T]` from a raw pointer.
    ///
    /// ## Safety
    ///
    /// The pointer must have been created by `Sync::into_raw` or similar.
    /// This does NOT increment the reference count.
    pub func from_raw(ptr: *SyncInner[T]) -> Sync[T] {
        return Sync { ptr: ptr }
    }

    /// Atomically increments the reference count (used internally by duplicate).
    pub func increment_count(this) {
        if this.ptr != null {
            atomic_fetch_add_i32(this.strong_count_ptr(), 1)
        }
    }

    /// Atomically decrements the reference count and frees if zero.
    pub func decrement_count(this) {
        if this.ptr == null {
            return
        }

        // Atomically decrement and get the previous value
        let prev: I32 = atomic_fetch_sub_i32(this.strong_count_ptr(), 1)

        // If previous value was 1, we're now at 0 — decrement implicit weak ref
        if prev == 1 {
            let prev_weak: I32 = atomic_fetch_sub_i32(this.weak_count_ptr(), 1)
            if prev_weak == 1 {
                mem_free(this.ptr as *Unit)
            }
        }
    }

    /// Returns `true` if both `Sync` values point to the same allocation.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let a = Sync::new(42)
    /// let b = a.duplicate()
    /// assert(a.ptr_eq(ref b))
    /// ```
    pub func ptr_eq(this, other: ref Sync[T]) -> Bool {
        return this.ptr == (*other).ptr
    }

    /// Creates a `SyncWeak[T]` reference to this allocation.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let sync = Sync::new(42)
    /// let weak = sync.downgrade()
    /// ```
    pub func downgrade(this) -> SyncWeak[T] {
        if this.ptr == null {
            return SyncWeak { ptr: null }
        }
        // Atomically increment the weak count
        atomic_fetch_add_i32(this.weak_count_ptr(), 1)
        return SyncWeak { ptr: this.ptr }
    }
}

/// A weak reference to `Sync[T]`-managed data.
///
/// `SyncWeak[T]` does not prevent the allocation from being freed. Use
/// `upgrade()` to attempt to get a strong `Sync[T]` reference.
///
/// ## Examples
///
/// ```tml
/// let sync = Sync::new(42)
/// let weak = sync.downgrade()
/// when weak.upgrade() {
///     Just(s) => print(s.get().to_string()),
///     Nothing => print("expired"),
/// }
/// ```
pub type SyncWeak[T] {
    ptr: *SyncInner[T],
}

impl[T] SyncWeak[T] {
    /// Returns a `*I32` to the strong_count field (field index 1).
    pub func strong_count_ptr(this) -> *I32 {
        let addr: I64 = this.ptr as I64
        let off: I64 = field_offset[SyncInner[T]](1)
        return (addr + off) as *I32
    }

    /// Returns a `*I32` to the weak_count field (field index 2).
    pub func weak_count_ptr(this) -> *I32 {
        let ptr_addr: I64 = this.ptr as I64
        let off: I64 = field_offset[SyncInner[T]](2)
        return (ptr_addr + off) as *I32
    }

    /// Attempts to upgrade to a strong `Sync[T]` reference.
    ///
    /// Returns `Nothing` if the allocation has been freed.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let sync = Sync::new(42)
    /// let weak = sync.downgrade()
    /// when weak.upgrade() {
    ///     Just(s) => assert_eq(s.get(), 42),
    ///     Nothing => panic("should not be expired"),
    /// }
    /// ```
    pub func upgrade(this) -> Maybe[Sync[T]] {
        if this.ptr == null {
            return Nothing
        }
        let strong: I32 = atomic_load_i32(this.strong_count_ptr())
        if strong == 0 {
            return Nothing
        }
        // Atomically increment strong count
        atomic_fetch_add_i32(this.strong_count_ptr(), 1)
        return Just(Sync { ptr: this.ptr })
    }

    /// Returns `true` if the allocation has been freed (strong count == 0).
    pub func is_expired(this) -> Bool {
        if this.ptr == null {
            return true
        }
        return atomic_load_i32(this.strong_count_ptr()) == 0
    }
}

impl[T] Drop for SyncWeak[T] {
    func drop(mut this) {
        if this.ptr == null {
            return
        }
        let ptr_addr: I64 = this.ptr as I64
        let off: I64 = field_offset[SyncInner[T]](2)
        let weak_ptr: *I32 = (ptr_addr + off) as *I32
        let prev: I32 = atomic_fetch_sub_i32(weak_ptr, 1)
        if prev == 1 {
            mem_free(this.ptr as *Unit)
        }
    }
}

impl[T] Duplicate for Sync[T] {
    /// Creates a new reference to the same data, atomically incrementing the count.
    ///
    /// This operation is thread-safe and can be called from multiple threads.
    ///
    /// ## Examples
    ///
    /// ```tml
    /// let original = Sync::new(42)
    /// let clone = original.duplicate()
    /// assert_eq(original.strong_count(), 2)
    /// ```
    pub func duplicate(this) -> Sync[T] {
        this.increment_count()
        return Sync { ptr: this.ptr }
    }
}

impl[T] Drop for Sync[T] {
    func drop(mut this) {
        this.decrement_count()
    }
}

impl[T] Display for Sync[T] where T: Display {
    /// Returns the display string of the contained value.
    pub func to_string(this) -> Str {
        return this.get().to_string()
    }
}

impl[T] Debug for Sync[T] where T: Debug {
    /// Returns the debug string representation of the Sync pointer and its value.
    pub func debug_string(this) -> Str {
        return "Sync(strong=" + this.strong_count().to_string() + ", " + this.get().debug_string() + ")"
    }
}

// Mark Sync[T] as Send and Sync when T is Send and Sync
// TODO: Requires marker trait support
// impl[T] marker::Send for Sync[T] where T: marker::Send + marker::Sync {}
// impl[T] marker::Sync for Sync[T] where T: marker::Send + marker::Sync {}

/// Creates a `Sync[T]` from a value.
///
/// ## Examples
///
/// ```tml
/// let synced = sync(42)
/// assert_eq(synced.get(), 42)
/// ```
pub func sync[T](value: T) -> Sync[T] {
    return Sync::new(value)
}
