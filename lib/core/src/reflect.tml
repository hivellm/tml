// ============================================================================
// Virtual Dispatch Reflection
// ============================================================================

/// Read the vtable pointer from a class instance.
///
/// Class instances have a vtable pointer as their first field (offset 0).
/// This returns the vtable pointer as an I64 for use with `call_vtable_slot`.
pub func get_vtable_ptr(obj_ptr: I64) -> I64 {
    let vtable_ptr_addr: *I64 = obj_ptr as *I64
    return lowlevel { ptr_read[I64](vtable_ptr_addr) }
}

/// Call a virtual method by vtable slot index (returns I64).
///
/// Reads the function pointer from the vtable at the given slot
/// and calls it with the object pointer as the first argument.
///
/// # Safety
/// The caller must ensure the slot index is valid and the function
/// signature matches: `func(this: ptr) -> I64`.
pub func call_vtable_slot_i64(obj_ptr: I64, vtable_ptr: I64, slot: I64) -> I64 {
    let func_ptr_addr: I64 = vtable_ptr + slot * 8
    let func_ptr: *I64 = func_ptr_addr as *I64
    let fn_addr: I64 = lowlevel { ptr_read[I64](func_ptr) }
    return lowlevel { call_fn_ptr_i64(fn_addr, obj_ptr) }
}

/// Call a virtual method by vtable slot index (returns Str/ptr).
///
/// Same as call_vtable_slot_i64 but for methods returning Str (pointer).
/// The result is the pointer cast to I64; use `as Str` to convert.
pub func call_vtable_slot_ptr(obj_ptr: I64, vtable_ptr: I64, slot: I64) -> I64 {
    let func_ptr_addr: I64 = vtable_ptr + slot * 8
    let func_ptr: *I64 = func_ptr_addr as *I64
    let fn_addr: I64 = lowlevel { ptr_read[I64](func_ptr) }
    return lowlevel { call_fn_ptr_ptr(fn_addr, obj_ptr) }
}

/// Call a virtual method by vtable slot index (no return value).
pub func call_vtable_slot_void(obj_ptr: I64, vtable_ptr: I64, slot: I64) {
    let func_ptr_addr: I64 = vtable_ptr + slot * 8
    let func_ptr: *I64 = func_ptr_addr as *I64
    let fn_addr: I64 = lowlevel { ptr_read[I64](func_ptr) }
    lowlevel { call_fn_ptr_void(fn_addr, obj_ptr) }
}
