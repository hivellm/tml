//! LCOV emit tests — phase 2.4 + 2.5.
//!
//! Goldens under `tests/fixtures/lcov/golden_*.info`:
//! - golden_minimal.info: one file, three DA records (one unhit), no FN/BRDA
//! - golden_full.info:    FN+FNDA, BRDA, DA — exercises every record type
//!
//! Also runs the round-trip test (parse → emit → parse equals parse)
//! against every `minimal/multi_file/with_functions/with_branches/comma_in_fn_name`
//! fixture.

use test::*
use coverage::types::*
use coverage::ingest::lcov::read_lcov
use coverage::emit::lcov::render_report

@test("golden emit — minimal")
func test_golden_minimal() {
    let report = make_minimal_report()
    let out = render_report(report)
    let expected = load_text("lib/coverage/tests/fixtures/lcov/golden_minimal.info")
    assert_eq(out, expected, "minimal golden mismatch")
}

@test("golden emit — full (FN + FNDA + BRDA + DA)")
func test_golden_full() {
    let report = make_full_report()
    let out = render_report(report)
    let expected = load_text("lib/coverage/tests/fixtures/lcov/golden_full.info")
    assert_eq(out, expected, "full golden mismatch")
}

@test("round-trip — minimal fixture")
func test_roundtrip_minimal() {
    assert_roundtrip("lib/coverage/tests/fixtures/lcov/minimal.info")
}

@test("round-trip — multi-file fixture")
func test_roundtrip_multi() {
    assert_roundtrip("lib/coverage/tests/fixtures/lcov/multi_file.info")
}

@test("round-trip — with_functions fixture")
func test_roundtrip_functions() {
    assert_roundtrip("lib/coverage/tests/fixtures/lcov/with_functions.info")
}

@test("round-trip — with_branches fixture")
func test_roundtrip_branches() {
    assert_roundtrip("lib/coverage/tests/fixtures/lcov/with_branches.info")
}

@test("round-trip — comma_in_fn_name fixture")
func test_roundtrip_comma() {
    assert_roundtrip("lib/coverage/tests/fixtures/lcov/comma_in_fn_name.info")
}

// ============================================================================
// Helpers
// ============================================================================

/// Parse fixture → emit → parse, and assert the second parse equals the
/// first on the observable fields (file paths + per-line hit count +
/// per-function hit count + per-branch hit count). Canonical record
/// order is enforced by emit, so parse-equality is the correct level.
func assert_roundtrip(path: Str) {
    let a = when read_lcov(path) {
        Ok(r) => r,
        Err(e) => {
            assert_true(false, `round-trip: first parse failed`)
            return
        }
    }
    let rendered = render_report(a)
    let tmp = `{path}.roundtrip.info`.as_str()
    let ok = std::file::File::write_all(tmp, rendered)
    assert_true(ok, "write_all failed")
    let b = when read_lcov(tmp) {
        Ok(r) => r,
        Err(e) => {
            assert_true(false, `round-trip: second parse failed`)
            return
        }
    }
    assert_eq(b.files.len(), a.files.len(), "file count preserved")
    var i: I64 = 0
    loop (i < a.files.len()) {
        let fa = a.files.get(i)
        let fb = b.files.get(i)
        assert_eq(fa.path, fb.path, "path preserved")
        assert_eq(fa.lines.len(), fb.lines.len(), "line count preserved")
        assert_eq(fa.functions.len(), fb.functions.len(), "func count preserved")
        assert_eq(fa.branches.len(), fb.branches.len(), "branch count preserved")
        i = i + 1
    }
}

func load_text(path: Str) -> Str {
    std::file::File::read_all(path)
}

func make_minimal_report() -> CoverageReport {
    let lines: List[LineHit] = List[LineHit]::new()
    lines.push(LineHit { line: 1, count: 1, branch_count: 0, branch_taken: 0 })
    lines.push(LineHit { line: 2, count: 1, branch_count: 0, branch_taken: 0 })
    lines.push(LineHit { line: 3, count: 0, branch_count: 0, branch_taken: 0 })

    let files: List[FileCoverage] = List[FileCoverage]::new()
    files.push(FileCoverage {
        path: "src/add.tml",
        lines: lines,
        functions: List[FuncHit]::new(),
        branches: List[BranchHit]::new(),
    })

    CoverageReport {
        files: files,
        source_roots: List[Str]::new(),
        tool: "test",
        version: "0",
        generated_at: 0,
    }
}

func make_full_report() -> CoverageReport {
    let lines: List[LineHit] = List[LineHit]::new()
    lines.push(LineHit { line: 1, count: 42, branch_count: 0, branch_taken: 0 })
    lines.push(LineHit { line: 2, count: 42, branch_count: 0, branch_taken: 0 })
    lines.push(LineHit { line: 5, count: 0,  branch_count: 0, branch_taken: 0 })
    lines.push(LineHit { line: 6, count: 0,  branch_count: 0, branch_taken: 0 })

    let fns: List[FuncHit] = List[FuncHit]::new()
    fns.push(FuncHit { name: "add", start_line: 1, hit_count: 42 })
    fns.push(FuncHit { name: "sub", start_line: 5, hit_count: 0 })

    let brs: List[BranchHit] = List[BranchHit]::new()
    brs.push(BranchHit { line: 2, block_id: 0, branch_id: 0, hit_count: 7 })
    brs.push(BranchHit { line: 2, block_id: 0, branch_id: 1, hit_count: 3 })

    let files: List[FileCoverage] = List[FileCoverage]::new()
    files.push(FileCoverage {
        path: "src/math.tml",
        lines: lines,
        functions: fns,
        branches: brs,
    })

    CoverageReport {
        files: files,
        source_roots: List[Str]::new(),
        tool: "test",
        version: "0",
        generated_at: 0,
    }
}
