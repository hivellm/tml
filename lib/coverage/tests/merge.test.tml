//! Merge tests — phase 5.4.

use test::*
use coverage::types::*
use coverage::merge::merge
use std::collections::List

@test("merge of empty list returns empty report")
func test_empty() {
    let r = merge(List[CoverageReport]::new())
    assert_eq(r.files.len(), 0, "no files")
    assert_eq(r.tool, "coverage-merge", "tool tag")
}

@test("merge single report returns equivalent shape")
func test_singleton() {
    let reports: List[CoverageReport] = List[CoverageReport]::new()
    reports.push(make_report("src/a.tml", 1, 5, 0, 0))
    let r = merge(reports)
    assert_eq(r.files.len(), 1, "one file")
    let f = r.files.get(0)
    assert_eq(f.path, "src/a.tml", "path preserved")
    assert_eq(f.lines.get(0).count, 5, "line count preserved")
}

@test("merge two reports — same file, same line, sums counts")
func test_sum_same_line() {
    let reports: List[CoverageReport] = List[CoverageReport]::new()
    reports.push(make_report("src/a.tml", 1, 5, 0, 0))
    reports.push(make_report("src/a.tml", 1, 3, 0, 0))
    let r = merge(reports)
    assert_eq(r.files.len(), 1, "one file after merge")
    let f = r.files.get(0)
    assert_eq(f.lines.get(0).count, 8, "5 + 3 = 8")
}

@test("merge two reports — distinct files preserved")
func test_distinct_files() {
    let reports: List[CoverageReport] = List[CoverageReport]::new()
    reports.push(make_report("src/a.tml", 1, 5, 0, 0))
    reports.push(make_report("src/b.tml", 10, 2, 0, 0))
    let r = merge(reports)
    assert_eq(r.files.len(), 2, "two files kept")
}

@test("merge two reports — same function sums hit_count")
func test_sum_function() {
    let reports: List[CoverageReport] = List[CoverageReport]::new()
    reports.push(make_report("src/a.tml", 0, 0, 10, 0))
    reports.push(make_report("src/a.tml", 0, 0, 4, 0))
    let r = merge(reports)
    let f = r.files.get(0)
    assert_eq(f.functions.len(), 1, "same-name function merged")
    assert_eq(f.functions.get(0).hit_count, 14, "10 + 4 = 14")
}

// Helpers ---------------------------------------------------------------

/// Build a one-file `CoverageReport`. `line == 0` / `fn_hit == 0` /
/// `br_hit == 0` mean "no record at this axis". Use non-zero to
/// populate that axis.
func make_report(path: Str, line: I64, line_count: I64, fn_hit: I64, br_hit: I64) -> CoverageReport {
    let lines: List[LineHit] = List[LineHit]::new()
    if line > 0 {
        lines.push(LineHit { line: line, count: line_count, branch_count: 0, branch_taken: 0 })
    }
    let fns: List[FuncHit] = List[FuncHit]::new()
    if fn_hit > 0 {
        fns.push(FuncHit { name: "f", start_line: 1, hit_count: fn_hit })
    }
    let brs: List[BranchHit] = List[BranchHit]::new()
    if br_hit > 0 {
        brs.push(BranchHit { line: 1, block_id: 0, branch_id: 0, hit_count: br_hit })
    }

    let files: List[FileCoverage] = List[FileCoverage]::new()
    files.push(FileCoverage {
        path: path,
        lines: lines,
        functions: fns,
        branches: brs,
    })

    CoverageReport {
        files: files,
        source_roots: List[Str]::new(),
        tool: "test",
        version: "0",
        generated_at: 0,
    }
}
