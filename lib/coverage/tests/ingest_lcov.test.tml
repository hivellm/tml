//! LCOV ingest tests — phase 2.2.
//!
//! Fixtures under `tests/fixtures/lcov/` cover:
//! - minimal.info:         one file, three DA records (one unhit)
//! - multi_file.info:      two files separated by `end_of_record`
//! - with_functions.info:  FN + FNDA records, one function unhit
//! - with_branches.info:   BRDA records, including `-` (untaken)
//! - empty.info:           zero-byte file (error path)
//! - comma_in_fn_name.info: FN name contains `,` (regression guard)

use test::*
use coverage::types::*
use coverage::ingest::lcov::read_lcov

@test("minimal LCOV — one file, three DA records")
func test_minimal() {
    let r = when read_lcov("lib/coverage/tests/fixtures/lcov/minimal.info") {
        Ok(r) => r,
        Err(e) => {
            assert_true(false, `read_lcov failed`)
            return
        }
    }
    assert_eq(r.files.len(), 1, "one file expected")
    let f = r.files.get(0)
    assert_eq(f.path, "src/add.tml", "path preserved verbatim")
    assert_eq(f.lines.len(), 3, "three DA records")
    assert_eq(f.lines.get(0).line, 1, "line 1")
    assert_eq(f.lines.get(0).count, 1, "line 1 hit once")
    assert_eq(f.lines.get(2).line, 3, "line 3")
    assert_eq(f.lines.get(2).count, 0, "line 3 unhit")
    assert_eq(f.functions.len(), 0, "no FN records")
    assert_eq(f.branches.len(), 0, "no BRDA records")
}

@test("multi-file LCOV — two files")
func test_multi_file() {
    let r = when read_lcov("lib/coverage/tests/fixtures/lcov/multi_file.info") {
        Ok(r) => r,
        Err(e) => {
            assert_true(false, `read_lcov failed`)
            return
        }
    }
    assert_eq(r.files.len(), 2, "two files expected")
    assert_eq(r.files.get(0).path, "src/add.tml", "first path")
    assert_eq(r.files.get(1).path, "src/sub.tml", "second path")
    assert_eq(r.files.get(1).lines.len(), 3, "sub.tml has 3 lines")
}

@test("function records — FN + FNDA correlate by name")
func test_with_functions() {
    let r = when read_lcov("lib/coverage/tests/fixtures/lcov/with_functions.info") {
        Ok(r) => r,
        Err(e) => {
            assert_true(false, `read_lcov failed`)
            return
        }
    }
    let f = r.files.get(0)
    assert_eq(f.functions.len(), 2, "two FN records")

    var add_hits: I64 = -1
    var sub_hits: I64 = -1
    var i: I64 = 0
    loop (i < f.functions.len()) {
        let fh = f.functions.get(i)
        if fh.name == "add" { add_hits = fh.hit_count }
        if fh.name == "sub" { sub_hits = fh.hit_count }
        i = i + 1
    }
    assert_eq(add_hits, 42, "add hit 42 times (FNDA correlated)")
    assert_eq(sub_hits, 0,  "sub unhit (FNDA=0)")
}

@test("branch records — numeric and '-' (untaken)")
func test_with_branches() {
    let r = when read_lcov("lib/coverage/tests/fixtures/lcov/with_branches.info") {
        Ok(r) => r,
        Err(e) => {
            assert_true(false, `read_lcov failed`)
            return
        }
    }
    let f = r.files.get(0)
    assert_eq(f.branches.len(), 4, "four BRDA records")
    // Untaken branch ('-') normalized to hit_count=0
    assert_eq(f.branches.get(2).hit_count, 0, "BRDA '-' -> 0")
    assert_eq(f.branches.get(3).hit_count, 10, "numeric branch preserved")
}

@test("empty file returns ReadError")
func test_empty_file() {
    let r = read_lcov("lib/coverage/tests/fixtures/lcov/empty.info")
    assert_true(r.is_err(), "empty file must return Err")
}

@test("missing file returns ReadError")
func test_missing_file() {
    let r = read_lcov("lib/coverage/tests/fixtures/lcov/does_not_exist.info")
    assert_true(r.is_err(), "missing file must return Err")
}

@test("FN name containing comma — rejoined correctly")
func test_comma_in_fn_name() {
    let r = when read_lcov("lib/coverage/tests/fixtures/lcov/comma_in_fn_name.info") {
        Ok(r) => r,
        Err(e) => {
            assert_true(false, `read_lcov failed`)
            return
        }
    }
    let f = r.files.get(0)
    assert_eq(f.functions.len(), 1, "one FN")
    assert_eq(f.functions.get(0).name, "fn_impl<T,U>", "FN name with comma preserved")
    assert_eq(f.functions.get(0).hit_count, 7, "FNDA correlation by full name")
}

// ---------------------------------------------------------------------------
// phase0w 11.2 cross-validation — LCOV produced by
// `llvm-cov export -format=lcov` (LLVM 22) round-trips through our
// ingest without loss.
//
// The fixture was produced from a 27-line C++ source with 3 functions,
// 1 branch (50 % taken), and 2 unhit lines. The reference file
// contains every section type the TML writer supports (SF, FN,
// FNDA, FNF/FNH, BRDA, BRF/BRH, DA, LF/LH, end_of_record) with
// counts matching llvm-cov's aggregate figures.
// ---------------------------------------------------------------------------
@test("llvm-cov reference — FN/FNDA/BRDA/DA preserved")
func test_llvm_cov_reference() {
    let r = when read_lcov("lib/coverage/tests/fixtures/lcov/llvm_cov_reference.info") {
        Ok(r) => r,
        Err(e) => {
            assert_true(false, `read_lcov failed on llvm-cov reference`)
            return
        }
    }
    assert_eq(r.files.len(), 1, "single SF section")
    let f = r.files.get(0)
    assert_eq(f.functions.len(), 3, "three FN records (main + add + branch_demo)")
    // Every FN has FNDA hit_count = 1 in the reference.
    var fn_hits: I64 = 0
    for i in 0 to f.functions.len() {
        let fh = f.functions.get(i)
        if fh.hit_count > 0 {
            fn_hits = fn_hits + 1
        }
    }
    assert_eq(fn_hits, 3, "FNH=3 — all three functions covered")
    assert_eq(f.branches.len(), 4, "BRDA count matches BRF=4")
    // Line totals mirror the llvm-cov LF=16 / LH=14 pair.
    assert_eq(f.lines.len(), 16, "LF=16 — every executable line recorded")
    var da_hits: I64 = 0
    for i in 0 to f.lines.len() {
        if f.lines.get(i).count > 0 {
            da_hits = da_hits + 1
        }
    }
    assert_eq(da_hits, 14, "LH=14 — two lines inside the unhit else-branch")
}
