use test::{assert, assert_eq}
use std::collections::List
use std::ia::tensor::{Tensor, DType, from_list_f64}
use std::ia::nn::norm::{LayerNorm, RMSNorm}

@test
func test_layernorm_shape() -> I32 {
    let ln = LayerNorm::new(3)
    let mut data = List[F64]::new(3)
    data.push(1.0)
    data.push(2.0)
    data.push(3.0)
    let mut dims = List[I64]::new(1)
    dims.push(3)
    let input = from_list_f64(data, dims)
    let out = ln.forward(ref input)
    assert_eq(out.numel(), 3, "layernorm output should have 3 elements")
    assert_eq(out.rank(), 1, "layernorm output should be rank 1")
    return 0
}

@test
func test_rmsnorm_shape() -> I32 {
    let rn = RMSNorm::new(4)
    let mut data = List[F64]::new(4)
    data.push(1.0)
    data.push(2.0)
    data.push(3.0)
    data.push(4.0)
    let mut dims = List[I64]::new(1)
    dims.push(4)
    let input = from_list_f64(data, dims)
    let out = rn.forward(ref input)
    assert_eq(out.numel(), 4, "rmsnorm output should have 4 elements")
    return 0
}
