use test::{assert, assert_eq}
use std::collections::List
use std::ia::tensor::{Tensor, DType, from_list_f64}
use std::ia::nn::activation::{gelu, silu, tanh_act, leaky_relu, log_softmax}

@test
func test_gelu_zero() -> I32 {
    // gelu(0) = 0 * 0.5 * (1 + tanh(0)) = 0
    let mut data = List[F64]::new(1)
    data.push(0.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = gelu(ref input)
    let v: F64 = out.get_f64(0)
    assert(v > -0.01 and v < 0.01, "gelu(0) should be ~0")
    return 0
}

@test
func test_gelu_positive() -> I32 {
    // gelu(2) ~ 1.9545 (tanh approximation)
    let mut data = List[F64]::new(1)
    data.push(2.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = gelu(ref input)
    let v: F64 = out.get_f64(0)
    assert(v > 1.9 and v < 2.0, "gelu(2) should be ~1.95")
    return 0
}

@test
func test_gelu_negative() -> I32 {
    // gelu(-1) should be small negative (close to 0, not -1)
    let mut data = List[F64]::new(1)
    data.push(-1.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = gelu(ref input)
    let v: F64 = out.get_f64(0)
    // gelu(-1) ~ -0.159
    assert(v > -0.3 and v < 0.0, "gelu(-1) should be a small negative value")
    return 0
}

@test
func test_silu_zero() -> I32 {
    // silu(0) = 0 * sigmoid(0) = 0 * 0.5 = 0
    let mut data = List[F64]::new(1)
    data.push(0.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = silu(ref input)
    let v: F64 = out.get_f64(0)
    assert(v > -0.01 and v < 0.01, "silu(0) = 0 * sigmoid(0) = 0")
    return 0
}

@test
func test_silu_positive() -> I32 {
    // silu(x) = x * sigmoid(x), for x > 0 result is in (0, x)
    let mut data = List[F64]::new(1)
    data.push(2.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = silu(ref input)
    let v: F64 = out.get_f64(0)
    // silu(2) = 2 * sigmoid(2) = 2 * 0.8808 ~ 1.7616
    assert(v > 1.5 and v < 2.0, "silu(2) should be ~1.76")
    return 0
}

@test
func test_tanh_act_zero() -> I32 {
    // tanh(0) = 0
    let mut data = List[F64]::new(1)
    data.push(0.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = tanh_act(ref input)
    let v: F64 = out.get_f64(0)
    assert(v > -0.01 and v < 0.01, "tanh(0) should be 0")
    return 0
}

@test
func test_tanh_act_positive() -> I32 {
    // tanh(1) ~ 0.7616
    let mut data = List[F64]::new(1)
    data.push(1.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = tanh_act(ref input)
    let v: F64 = out.get_f64(0)
    let diff: F64 = v - 0.7616
    assert(diff > -0.01 and diff < 0.01, "tanh(1) should be ~0.7616")
    return 0
}

@test
func test_tanh_act_negative_is_negative() -> I32 {
    // tanh is odd: tanh(-x) = -tanh(x)
    let mut data = List[F64]::new(1)
    data.push(-1.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = tanh_act(ref input)
    let v: F64 = out.get_f64(0)
    assert(v < 0.0, "tanh(-1) should be negative")
    let diff: F64 = v - (-0.7616)
    assert(diff > -0.01 and diff < 0.01, "tanh(-1) should be ~-0.7616")
    return 0
}

@test
func test_leaky_relu_negative() -> I32 {
    // leaky_relu(-2, alpha=0.01) = -0.02
    let mut data = List[F64]::new(1)
    data.push(-2.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = leaky_relu(ref input, 0.01)
    let v: F64 = out.get_f64(0)
    let diff: F64 = v - (-0.02)
    assert(diff > -0.001 and diff < 0.001, "leaky_relu(-2, 0.01) = -0.02")
    return 0
}

@test
func test_leaky_relu_positive() -> I32 {
    // leaky_relu(3, alpha=0.01) = 3 (positive passthrough)
    let mut data = List[F64]::new(1)
    data.push(3.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = leaky_relu(ref input, 0.01)
    let v: F64 = out.get_f64(0)
    let diff: F64 = v - 3.0
    assert(diff > -0.01 and diff < 0.01, "leaky_relu(3, 0.01) = 3")
    return 0
}

@test
func test_leaky_relu_zero() -> I32 {
    // leaky_relu(0, alpha=0.2) = 0
    let mut data = List[F64]::new(1)
    data.push(0.0)
    let mut dims = List[I64]::new(1)
    dims.push(1)
    let input = from_list_f64(data, dims)
    let out = leaky_relu(ref input, 0.2)
    let v: F64 = out.get_f64(0)
    assert(v > -0.01 and v < 0.01, "leaky_relu(0) = 0")
    return 0
}

@test
func test_log_softmax_uniform() -> I32 {
    // log_softmax([1,1,1]) = log(1/3) for all elements ~ -1.0986
    let mut data = List[F64]::new(3)
    data.push(1.0)
    data.push(1.0)
    data.push(1.0)
    let mut dims = List[I64]::new(1)
    dims.push(3)
    let input = from_list_f64(data, dims)
    let out = log_softmax(ref input)
    let v0: F64 = out.get_f64(0)
    let v1: F64 = out.get_f64(1)
    let v2: F64 = out.get_f64(2)
    // All elements should be equal and approximately -1.0986
    let diff01: F64 = v0 - v1
    assert(diff01 > -0.001 and diff01 < 0.001, "log_softmax uniform: all elements equal")
    let diff02: F64 = v0 - v2
    assert(diff02 > -0.001 and diff02 < 0.001, "log_softmax uniform: all elements equal")
    assert(v0 < 0.0, "log_softmax output should be negative for uniform input")
    return 0
}

@test
func test_log_softmax_dominant() -> I32 {
    // log_softmax([0, 0, 100]): last element dominates, log_softmax[2] ~ 0
    let mut data = List[F64]::new(3)
    data.push(0.0)
    data.push(0.0)
    data.push(100.0)
    let mut dims = List[I64]::new(1)
    dims.push(3)
    let input = from_list_f64(data, dims)
    let out = log_softmax(ref input)
    let vlast: F64 = out.get_f64(2)
    // log(softmax(100)) ~ log(1.0) ~ 0
    assert(vlast > -0.01 and vlast < 0.01, "log_softmax([0,0,100])[2] should be ~0")
    let vfirst: F64 = out.get_f64(0)
    // log(softmax(0)) when 100 dominates: very negative
    assert(vfirst < -50.0, "log_softmax([0,0,100])[0] should be very negative")
    return 0
}
