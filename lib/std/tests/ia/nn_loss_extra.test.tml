use test::{assert, assert_eq}
use std::collections::List
use std::ia::tensor::{Tensor, DType, from_list_f64}
use std::ia::nn::loss::{cross_entropy_loss, bce_loss, huber_loss}

@test
func test_cross_entropy_perfect() -> I32 {
    // preds = [0.7, 0.2, 0.1], targets = [1, 0, 0]
    // CE = -log(0.7) ~ 0.357
    let mut pd = List[F64]::new(3)
    pd.push(0.7)
    pd.push(0.2)
    pd.push(0.1)
    let mut d1 = List[I64]::new(1)
    d1.push(3)
    let preds = from_list_f64(pd, d1)
    let mut td = List[F64]::new(3)
    td.push(1.0)
    td.push(0.0)
    td.push(0.0)
    let mut d2 = List[I64]::new(1)
    d2.push(3)
    let targets = from_list_f64(td, d2)
    let loss = cross_entropy_loss(ref preds, ref targets)
    let v: F64 = loss.get_f64(0)
    // -log(0.7) / 3 ~ 0.119
    assert(v > 0.05 and v < 0.5, "cross_entropy([0.7,0.2,0.1], [1,0,0]) should be in (0.05, 0.5)")
    return 0
}

@test
func test_cross_entropy_uniform_prediction() -> I32 {
    // preds = [1/3, 1/3, 1/3], targets = [1, 0, 0]
    // CE = -log(1/3) ~ 1.099, mean over n=3 ~ 0.366
    let third: F64 = 0.3333
    let mut pd = List[F64]::new(3)
    pd.push(third)
    pd.push(third)
    pd.push(third)
    let mut d1 = List[I64]::new(1)
    d1.push(3)
    let preds = from_list_f64(pd, d1)
    let mut td = List[F64]::new(3)
    td.push(1.0)
    td.push(0.0)
    td.push(0.0)
    let mut d2 = List[I64]::new(1)
    d2.push(3)
    let targets = from_list_f64(td, d2)
    let loss = cross_entropy_loss(ref preds, ref targets)
    let v: F64 = loss.get_f64(0)
    assert(v > 0.0, "cross_entropy of uniform prediction should be positive")
    return 0
}

@test
func test_cross_entropy_identical() -> I32 {
    // When preds match targets exactly (one-hot), loss should be minimized
    // preds = [0.99, 0.005, 0.005], targets = [1, 0, 0]
    let mut pd = List[F64]::new(3)
    pd.push(0.99)
    pd.push(0.005)
    pd.push(0.005)
    let mut d1 = List[I64]::new(1)
    d1.push(3)
    let preds_high = from_list_f64(pd, d1)
    let mut pd2 = List[F64]::new(3)
    pd2.push(0.3333)
    pd2.push(0.3333)
    pd2.push(0.3334)
    let mut d1b = List[I64]::new(1)
    d1b.push(3)
    let preds_uniform = from_list_f64(pd2, d1b)
    let mut td = List[F64]::new(3)
    td.push(1.0)
    td.push(0.0)
    td.push(0.0)
    let mut d2 = List[I64]::new(1)
    d2.push(3)
    let targets = from_list_f64(td, d2)
    let loss_high = cross_entropy_loss(ref preds_high, ref targets)
    let loss_uniform = cross_entropy_loss(ref preds_uniform, ref targets)
    let v_high: F64 = loss_high.get_f64(0)
    let v_uniform: F64 = loss_uniform.get_f64(0)
    assert(v_high < v_uniform, "cross_entropy: confident correct prediction < uniform prediction")
    return 0
}

@test
func test_bce_loss_zero() -> I32 {
    // preds = [1, 0], targets = [1, 0] => near-zero loss
    let mut pd = List[F64]::new(2)
    pd.push(0.999)
    pd.push(0.001)
    let mut d1 = List[I64]::new(1)
    d1.push(2)
    let preds = from_list_f64(pd, d1)
    let mut td = List[F64]::new(2)
    td.push(1.0)
    td.push(0.0)
    let mut d2 = List[I64]::new(1)
    d2.push(2)
    let targets = from_list_f64(td, d2)
    let loss = bce_loss(ref preds, ref targets)
    let v: F64 = loss.get_f64(0)
    assert(v > -0.01 and v < 0.05, "bce_loss of near-perfect predictions should be ~0")
    return 0
}

@test
func test_bce_loss_confident() -> I32 {
    // preds = [0.9, 0.1], targets = [1, 0]
    // BCE = -(log(0.9) + log(1 - 0.1)) / 2 = -log(0.9) ~ 0.105
    let mut pd = List[F64]::new(2)
    pd.push(0.9)
    pd.push(0.1)
    let mut d1 = List[I64]::new(1)
    d1.push(2)
    let preds = from_list_f64(pd, d1)
    let mut td = List[F64]::new(2)
    td.push(1.0)
    td.push(0.0)
    let mut d2 = List[I64]::new(1)
    d2.push(2)
    let targets = from_list_f64(td, d2)
    let loss = bce_loss(ref preds, ref targets)
    let v: F64 = loss.get_f64(0)
    // -log(0.9) ~ 0.1054
    assert(v > 0.05 and v < 0.2, "bce_loss([0.9, 0.1], [1, 0]) should be ~0.105")
    return 0
}

@test
func test_bce_loss_wrong_prediction() -> I32 {
    // preds = [0.1, 0.9], targets = [1, 0] (wrong predictions => high loss)
    let mut pd = List[F64]::new(2)
    pd.push(0.1)
    pd.push(0.9)
    let mut d1 = List[I64]::new(1)
    d1.push(2)
    let preds = from_list_f64(pd, d1)
    let mut td = List[F64]::new(2)
    td.push(1.0)
    td.push(0.0)
    let mut d2 = List[I64]::new(1)
    d2.push(2)
    let targets = from_list_f64(td, d2)
    let loss = bce_loss(ref preds, ref targets)
    let v: F64 = loss.get_f64(0)
    // -log(0.1) ~ 2.3
    assert(v > 2.0, "bce_loss of wrong confident prediction should be > 2.0")
    return 0
}

@test
func test_huber_loss_zero() -> I32 {
    // identical preds and targets => loss = 0
    let mut pd = List[F64]::new(2)
    pd.push(1.0)
    pd.push(2.0)
    let mut d1 = List[I64]::new(1)
    d1.push(2)
    let preds = from_list_f64(pd, d1)
    let mut td = List[F64]::new(2)
    td.push(1.0)
    td.push(2.0)
    let mut d2 = List[I64]::new(1)
    d2.push(2)
    let targets = from_list_f64(td, d2)
    let loss = huber_loss(ref preds, ref targets, 1.0)
    let v: F64 = loss.get_f64(0)
    assert(v > -0.01 and v < 0.01, "huber_loss of identical tensors should be ~0")
    return 0
}

@test
func test_huber_loss_small_error() -> I32 {
    // |error| = 0.5, delta = 1.0 => quadratic: 0.5 * 0.5^2 = 0.125
    let mut pd = List[F64]::new(1)
    pd.push(1.5)
    let mut d1 = List[I64]::new(1)
    d1.push(1)
    let preds = from_list_f64(pd, d1)
    let mut td = List[F64]::new(1)
    td.push(1.0)
    let mut d2 = List[I64]::new(1)
    d2.push(1)
    let targets = from_list_f64(td, d2)
    let loss = huber_loss(ref preds, ref targets, 1.0)
    let v: F64 = loss.get_f64(0)
    let diff: F64 = v - 0.125
    assert(diff > -0.001 and diff < 0.001, "huber_loss(1.5, 1.0, delta=1.0) = 0.125")
    return 0
}

@test
func test_huber_loss_large_error() -> I32 {
    // |error| = 3.0, delta = 1.0 => linear: delta * (|error| - 0.5*delta) = 1*(3 - 0.5) = 2.5
    let mut pd = List[F64]::new(1)
    pd.push(4.0)
    let mut d1 = List[I64]::new(1)
    d1.push(1)
    let preds = from_list_f64(pd, d1)
    let mut td = List[F64]::new(1)
    td.push(1.0)
    let mut d2 = List[I64]::new(1)
    d2.push(1)
    let targets = from_list_f64(td, d2)
    let loss = huber_loss(ref preds, ref targets, 1.0)
    let v: F64 = loss.get_f64(0)
    let diff: F64 = v - 2.5
    assert(diff > -0.01 and diff < 0.01, "huber_loss(4.0, 1.0, delta=1.0) = 2.5")
    return 0
}

@test
func test_huber_loss_grows_slower_than_squared() -> I32 {
    // For large errors, huber loss grows slower than MSE
    // preds = [10], targets = [0]: huber(delta=1) = 1*(10-0.5) = 9.5
    // mse would be 100
    let mut pd = List[F64]::new(1)
    pd.push(10.0)
    let mut d1 = List[I64]::new(1)
    d1.push(1)
    let preds = from_list_f64(pd, d1)
    let mut td = List[F64]::new(1)
    td.push(0.0)
    let mut d2 = List[I64]::new(1)
    d2.push(1)
    let targets = from_list_f64(td, d2)
    let loss = huber_loss(ref preds, ref targets, 1.0)
    let v: F64 = loss.get_f64(0)
    let diff: F64 = v - 9.5
    assert(diff > -0.01 and diff < 0.01, "huber_loss(10, 0, delta=1.0) = 9.5")
    return 0
}
