use test::{assert, assert_eq}
use std::collections::List
use std::ia::tensor::{Tensor, DType, from_list_i64}
use std::ia::nn::embedding::Embedding

@test
func test_embedding_shape() -> I32 {
    // Embedding(10, 4).forward([0,1,2] as I64 tensor) -> shape [3, 4]
    let emb = Embedding::new(10, 4)
    let mut idx_data = List[I64]::new(3)
    idx_data.push(0)
    idx_data.push(1)
    idx_data.push(2)
    let mut idx_dims = List[I64]::new(1)
    idx_dims.push(3)
    let indices = from_list_i64(idx_data, idx_dims)
    let out = emb.forward(ref indices)
    assert_eq(out.rank(), 2, "embedding output should be rank 2")
    assert_eq(out.dim(0), 3, "embedding output seq_len dim should be 3")
    assert_eq(out.dim(1), 4, "embedding output embed_dim should be 4")
    return 0
}

@test
func test_embedding_num_parameters() -> I32 {
    // Embedding(10, 4) has 40 parameters
    let emb = Embedding::new(10, 4)
    assert_eq(emb.num_parameters(), 40, "embedding should have 10*4=40 parameters")
    return 0
}
