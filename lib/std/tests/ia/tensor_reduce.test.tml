// Reduction operation tests for std::ia tensor module.
use test
use test::{assert, assert_eq}
use std::collections::List
use std::ia::tensor::{Tensor, DType, from_list_f64, zeros, sum, mean, max_val, min_val, argmax, argmin}

@test
func test_sum() -> I32 {
    // sum([1,2,3,4]) = 10.0
    let mut data = List[F64]::new(4)
    data.push(1.0)
    data.push(2.0)
    data.push(3.0)
    data.push(4.0)
    let mut dims = List[I64]::new(1)
    dims.push(4)
    let t = from_list_f64(data, dims)
    let s = sum(ref t)
    let diff = s - 10.0
    assert(diff > -0.001 and diff < 0.001, "sum([1,2,3,4]) should be 10.0")
    return 0
}

@test
func test_mean() -> I32 {
    // mean([2,4,6,8]) = 5.0
    let mut data = List[F64]::new(4)
    data.push(2.0)
    data.push(4.0)
    data.push(6.0)
    data.push(8.0)
    let mut dims = List[I64]::new(1)
    dims.push(4)
    let t = from_list_f64(data, dims)
    let m = mean(ref t)
    let diff = m - 5.0
    assert(diff > -0.001 and diff < 0.001, "mean([2,4,6,8]) should be 5.0")
    return 0
}

@test
func test_max_min() -> I32 {
    // max_val([3,1,4,1,5]) = 5.0, min_val = 1.0
    let mut data = List[F64]::new(5)
    data.push(3.0)
    data.push(1.0)
    data.push(4.0)
    data.push(1.0)
    data.push(5.0)
    let mut dims = List[I64]::new(1)
    dims.push(5)
    let t = from_list_f64(data, dims)
    let mx = max_val(ref t)
    let diff_max = mx - 5.0
    assert(diff_max > -0.001 and diff_max < 0.001, "max_val should be 5.0")
    let mn = min_val(ref t)
    let diff_min = mn - 1.0
    assert(diff_min > -0.001 and diff_min < 0.001, "min_val should be 1.0")
    return 0
}

@test
func test_argmax_argmin() -> I32 {
    // argmax([3,1,4,1,5]) = 4 (index of 5), argmin = 1 (index of first 1)
    let mut data = List[F64]::new(5)
    data.push(3.0)
    data.push(1.0)
    data.push(4.0)
    data.push(1.0)
    data.push(5.0)
    let mut dims = List[I64]::new(1)
    dims.push(5)
    let t = from_list_f64(data, dims)
    let amax = argmax(ref t)
    assert_eq(amax, 4 as I64, "argmax should be 4 (index of 5.0)")
    let amin = argmin(ref t)
    assert_eq(amin, 1 as I64, "argmin should be 1 (index of first 1.0)")
    return 0
}
