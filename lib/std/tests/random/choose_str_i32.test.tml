// Tests for choose_i32 and choose_str
use test::{assert, assert_eq}
use std::random::{Rng, choose_i32, choose_str}
use std::collections::List

@test
func test_choose_i32_empty() -> I32 {
    var rng: Rng = Rng::with_seed(100)
    var empty: List[I32] = List[I32].new(0)
    let result: Maybe[I32] = choose_i32(empty, mut ref rng)
    assert(result.is_nothing(), "choose_i32 from empty returns Nothing")
    empty.destroy()
    return 0
}

@test
func test_choose_i32_single() -> I32 {
    var rng: Rng = Rng::with_seed(101)
    var list: List[I32] = List[I32].new(1)
    list.push(99)
    let result: Maybe[I32] = choose_i32(list, mut ref rng)
    assert(result.is_just(), "choose_i32 from single returns Just")
    assert_eq(result.unwrap(), 99, "single element is 99")
    list.destroy()
    return 0
}

@test
func test_choose_i32_from_list() -> I32 {
    var rng: Rng = Rng::with_seed(102)
    var list: List[I32] = List[I32].new(3)
    list.push(10)
    list.push(20)
    list.push(30)
    var i: I32 = 0
    loop (i < 10) {
        let r: Maybe[I32] = choose_i32(list, mut ref rng)
        assert(r.is_just(), "non-empty list always returns Just")
        let v: I32 = r.unwrap()
        assert(v == 10 or v == 20 or v == 30, "element from list")
        i = i + 1
    }
    list.destroy()
    return 0
}

@test
func test_choose_str_empty() -> I32 {
    var rng: Rng = Rng::with_seed(200)
    var empty: List[Str] = List[Str].new(0)
    let result: Maybe[Str] = choose_str(empty, mut ref rng)
    assert(result.is_nothing(), "choose_str from empty returns Nothing")
    empty.destroy()
    return 0
}

@test
func test_choose_str_single() -> I32 {
    var rng: Rng = Rng::with_seed(201)
    var list: List[Str] = List[Str].new(1)
    list.push("hello")
    let result: Maybe[Str] = choose_str(list, mut ref rng)
    assert(result.is_just(), "choose_str from single returns Just")
    assert_eq(result.unwrap(), "hello", "single element is hello")
    list.destroy()
    return 0
}

@test
func test_choose_str_from_list() -> I32 {
    var rng: Rng = Rng::with_seed(202)
    var list: List[Str] = List[Str].new(3)
    list.push("a")
    list.push("b")
    list.push("c")
    var i: I32 = 0
    loop (i < 10) {
        let r: Maybe[Str] = choose_str(list, mut ref rng)
        assert(r.is_just(), "non-empty list always returns Just")
        let v: Str = r.unwrap()
        assert(v == "a" or v == "b" or v == "c", "element from list")
        i = i + 1
    }
    list.destroy()
    return 0
}
