use test::{assert, assert_eq}
use std::db::driver::pool::{ConnectionPool, PoolConfig, PoolStats}

@test
func test_pool_custom_config() -> I32 {
    let config = PoolConfig::new(2, 5)
    assert_eq(config.min_connections(), 2, "min")
    assert_eq(config.max_connections(), 5, "max")
    assert_eq(config.idle_timeout_ms(), 30000, "default idle timeout")
    assert_eq(config.connect_timeout_ms(), 5000, "default connect timeout")
    return 0
}

@test
func test_pool_default_config() -> I32 {
    let config = PoolConfig::default()
    assert_eq(config.min_connections(), 1, "default min")
    assert_eq(config.max_connections(), 10, "default max")
    return 0
}

@test
func test_pool_multiple_acquire_release() -> I32 {
    let mut pool = ConnectionPool::new(PoolConfig::new(1, 5))
    pool.acquire()
    pool.acquire()
    pool.acquire()
    let s = pool.stats()
    assert_eq(s.active(), 3, "3 active")
    assert_eq(s.total(), 3, "3 total")
    pool.release()
    pool.release()
    let s2 = pool.stats()
    assert_eq(s2.active(), 1, "1 active after 2 releases")
    assert_eq(s2.idle(), 2, "2 idle")
    return 0
}

@test
func test_pool_reuse_idle() -> I32 {
    let mut pool = ConnectionPool::new(PoolConfig::new(1, 3))
    pool.acquire()
    pool.release()
    // Now 1 idle — next acquire should reuse it
    pool.acquire()
    let s = pool.stats()
    assert_eq(s.active(), 1, "1 active")
    assert_eq(s.idle(), 0, "0 idle after reuse")
    assert_eq(s.total(), 1, "still 1 total — reused, not new")
    return 0
}

@test
func test_pool_exhaustion_tracks_waits() -> I32 {
    let mut pool = ConnectionPool::new(PoolConfig::new(1, 2))
    pool.acquire()
    pool.acquire()
    let r1 = pool.acquire()
    assert(r1.is_err(), "should fail when exhausted")
    let r2 = pool.acquire()
    assert(r2.is_err(), "should fail again")
    let s = pool.stats()
    assert_eq(s.wait_count(), 2, "2 waits recorded")
    return 0
}

@test
func test_pool_close_resets_all() -> I32 {
    let mut pool = ConnectionPool::new(PoolConfig::new(1, 10))
    pool.acquire()
    pool.acquire()
    pool.release()
    pool.close_all()
    let s = pool.stats()
    assert_eq(s.active(), 0, "0 active after close")
    assert_eq(s.idle(), 0, "0 idle after close")
    assert_eq(s.total(), 0, "0 total after close")
    return 0
}

@test
func test_pool_stats_empty() -> I32 {
    let s = PoolStats::new()
    assert_eq(s.active(), 0, "empty active")
    assert_eq(s.idle(), 0, "empty idle")
    assert_eq(s.total(), 0, "empty total")
    assert_eq(s.wait_count(), 0, "empty waits")
    return 0
}
