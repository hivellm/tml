// ─── query_one_i64 (direct return) ──────────────────────────────────────────

@test
func test_query_one_i64_found() -> I32 {
    when SqliteConnection::open_in_memory() {
        Err(_) => {
            assert(false, "open failed")
            return 1
        },
        Ok(mut c) => {
            let _ = c.execute("CREATE TABLE scores (user_id INTEGER, score INTEGER)")
            let _ = c.execute_i64_2("INSERT INTO scores VALUES (?1, ?2)", 7, 9500)
            let score = c.query_one_i64("SELECT score FROM scores WHERE user_id = ?1", 7)
            assert_eq(score, 9500, "correct score")
        }
    }
    return 0
}

@test
func test_query_one_i64_not_found() -> I32 {
    when SqliteConnection::open_in_memory() {
        Err(_) => {
            assert(false, "open failed")
            return 1
        },
        Ok(mut c) => {
            let _ = c.execute("CREATE TABLE scores (user_id INTEGER, score INTEGER)")
            let score = c.query_one_i64("SELECT score FROM scores WHERE user_id = ?1", 999)
            assert_eq(score, 0, "zero when not found")
        }
    }
    return 0
}

// ─── query_one_str (direct return) ──────────────────────────────────────────

@test
func test_query_one_str_found() -> I32 {
    when SqliteConnection::open_in_memory() {
        Err(_) => {
            assert(false, "open failed")
            return 1
        },
        Ok(mut c) => {
            let _ = c.execute("CREATE TABLE users (id INTEGER, name TEXT)")
            let _ = c.execute_i64_str("INSERT INTO users VALUES (?1, ?2)", 1, "Alice")
            let name = c.query_one_str("SELECT name FROM users WHERE id = ?1", 1)
            assert_eq(name, "Alice", "correct name")
        }
    }
    return 0
}

@test
func test_query_one_str_not_found() -> I32 {
    when SqliteConnection::open_in_memory() {
        Err(_) => {
            assert(false, "open failed")
            return 1
        },
        Ok(mut c) => {
            let _ = c.execute("CREATE TABLE users (id INTEGER, name TEXT)")
            let name = c.query_one_str("SELECT name FROM users WHERE id = ?1", 42)
            assert_eq(name, "", "empty when not found")
        }
    }
    return 0
}

// ─── exists_by_str ──────────────────────────────────────────────────────────

@test
func test_exists_by_str_found() -> I32 {
    when SqliteConnection::open_in_memory() {
        Err(_) => {
            assert(false, "open failed")
            return 1
        },
        Ok(mut c) => {
            let _ = c.execute("CREATE TABLE tags (name TEXT)")
            let _ = c.execute_str("INSERT INTO tags VALUES (?1)", "rust")
            let found = c.exists_by_str("SELECT 1 FROM tags WHERE name = ?1", "rust")
            assert(found, "row found")
        }
    }
    return 0
}

@test
func test_exists_by_str_not_found() -> I32 {
    when SqliteConnection::open_in_memory() {
        Err(_) => {
            assert(false, "open failed")
            return 1
        },
        Ok(mut c) => {
            let _ = c.execute("CREATE TABLE tags (name TEXT)")
            let found = c.exists_by_str("SELECT 1 FROM tags WHERE name = ?1", "missing")
            assert(not found, "row not found")
        }
    }
    return 0
}

// ─── query_scalar_str ───────────────────────────────────────────────────────

@test
func test_query_scalar_str() -> I32 {
    when SqliteConnection::open_in_memory() {
        Err(_) => {
            assert(false, "open failed")
            return 1
        },
        Ok(mut c) => {
            let _ = c.execute("CREATE TABLE cfg (key TEXT, val TEXT)")
            let _ = c.execute_2str("INSERT INTO cfg VALUES (?1, ?2)", "theme", "dark")
            when c.query_scalar_str("SELECT val FROM cfg WHERE key = 'theme'") {
                Err(_) => {
                    assert(false, "query_scalar_str failed")
                    return 1
                },
                Ok(v) => {
                    assert_eq(v, "dark", "value is dark")
                }
            }
        }
    }
    return 0
}

