// Tests for SqliteConnection convenience APIs // v3
// Added in DB Performance Tier 2 (items 2.1-2.7)
use test::{assert, assert_eq}
use std::db::sqlite::connection::SqliteConnection

// ─── execute_str ────────────────────────────────────────────────────────────

@test
func test_execute_str_insert() -> I32 {
    when SqliteConnection::open_in_memory() {
        Err(_) => {
            assert(false, "open failed")
            return 1
        },
        Ok(mut c) => {
            let _ = c.execute("CREATE TABLE words (word TEXT NOT NULL)")
            when c.execute_str("INSERT INTO words VALUES (?1)", "hello") {
                Err(_) => {
                    assert(false, "execute_str failed")
                    return 1
                },
                Ok(n) => {
                    assert_eq(n, 1, "one row inserted")
                }
            }
        }
    }
    return 0
}

