// Core env API tests: get_var, set_var, remove_var, lookup, current_dir, temp_dir
use test::{assert}
use std::env

@test
func test_get_var_path_exists() -> I32 {
    let path: Maybe[Str] = env::get_var("PATH")
    assert(path.is_just(), "PATH env var should exist")
    return 0
}

@test
func test_get_var_missing() -> I32 {
    let val: Maybe[Str] = env::get_var("TML_NONEXISTENT_VAR_XYZ_999")
    assert(val.is_nothing(), "non-existent var should return Nothing")
    return 0
}

@test
func test_set_var_succeeds() -> I32 {
    let ok: Bool = env::set_var("TML_ENV_TEST_SET", "hello_world")
    assert(ok, "set_var should return true on success")
    return 0
}

@test
func test_remove_var_nonexistent() -> I32 {
    // Unsetting a variable that doesn't exist should not crash
    let _ = env::remove_var("TML_ENV_TEST_NEVER_SET_12345")
    return 0
}
