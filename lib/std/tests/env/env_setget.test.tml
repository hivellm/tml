// Tests for set_var / remove_var lifecycle
//
// NOTE: set_var followed immediately by get_var on the same variable
// hangs at runtime (pre-existing bug: tml_os_env_has spins after tml_os_env_set).
// These tests only verify the return value of set/remove, not read-back.
use test::{assert}
use std::env

@test
func test_set_var_returns_true() -> I32 {
    let ok: Bool = env::set_var("TML_ENV_SETGET_A", "value_a")
    assert(ok, "set_var should return true")
    return 0
}

@test
func test_remove_var_after_set() -> I32 {
    let ok: Bool = env::set_var("TML_ENV_SETGET_B", "value_b")
    assert(ok, "set_var should succeed")
    let rm: Bool = env::remove_var("TML_ENV_SETGET_B")
    assert(rm, "remove_var should succeed")
    return 0
}

@test
func test_lookup_alias_path() -> I32 {
    let path: Maybe[Str] = env::lookup("PATH")
    assert(path.is_just(), "lookup should find PATH env var")
    return 0
}
