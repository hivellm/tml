// Tests for PassThroughStream::pipe and PassThroughStream::unpipe
// Previously blocked by double mut ref codegen bug — fixed by removing
// redundant `mut ref` when forwarding already-ref parameters.
use test::{assert, assert_true, assert_false}
use std::stream::passthrough::PassThroughStream
use std::stream::writable_stream::WritableStream

func noop_write(data: I64, cb: I64) {}

@test
func test_passthrough_pipe_to_writable() -> I32 {
    var pt: PassThroughStream = PassThroughStream::new()
    var ws: WritableStream = WritableStream::new()
    ws.set_write_fn(noop_write as I64)

    pt.pipe(mut ref ws)
    // Writing to passthrough pushes to readable side, which is now piped to ws
    pt.write("hello")
    pt.end()

    assert_true(ws.writable_finished(), "ws finished after passthrough end")
    pt.destroy()
    ws.destroy()
    return 0
}

@test
func test_passthrough_unpipe_from_writable() -> I32 {
    var pt: PassThroughStream = PassThroughStream::new()
    var ws: WritableStream = WritableStream::new()
    ws.set_write_fn(noop_write as I64)

    pt.pipe(mut ref ws)
    pt.unpipe(mut ref ws)

    // After unpipe, ending passthrough should NOT end ws
    pt.end()
    assert_false(ws.writable_finished(), "ws NOT finished after unpipe + end")

    pt.destroy()
    ws.destroy()
    return 0
}
