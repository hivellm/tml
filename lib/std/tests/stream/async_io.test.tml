//! Tests for AsyncRead and AsyncWrite behavior definitions.
//!
//! These tests verify that the behavior definitions compile correctly and
//! that the Poll/Outcome return types work as expected.

use test::{assert, assert_eq}
use std::stream::async_io::{AsyncRead, AsyncWrite}
use core::task::{Poll, Context}
use core::runtime::error::{IoError, IoErrorKind}

// ============================================================================
// Tests for Poll[Outcome[...]] construction — validates the type signatures
// ============================================================================

@test
func test_poll_ready_ok_i64() -> I32 {
    let p: Poll[Outcome[I64, IoError]] = Poll::Ready(Ok(42 as I64))
    assert(p.is_ready(), "should be ready")
    return 0
}

@test
func test_poll_ready_err() -> I32 {
    let err: IoError = IoError::new(IoErrorKind::WouldBlock)
    let p: Poll[Outcome[I64, IoError]] = Poll::Ready(Err(err))
    assert(p.is_ready(), "should be ready (even though it's an error)")
    return 0
}

@test
func test_poll_pending() -> I32 {
    let p: Poll[Outcome[I64, IoError]] = Poll::Pending
    assert(p.is_pending(), "should be pending")
    return 0
}
