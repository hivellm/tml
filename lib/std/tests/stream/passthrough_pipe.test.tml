// Tests for PassThroughStream: unpipe_all guard path, emit
// NOTE: pipe/unpipe tests are in passthrough_pipe_unpipe.test.tml
use test::{assert, assert_false}
use std::stream::passthrough::PassThroughStream

@test
func test_passthrough_unpipe_all() -> I32 {
    var ps: PassThroughStream = PassThroughStream::new()
    ps.unpipe_all()
    ps.destroy()
    return 0
}

@test
func test_passthrough_emit_no_listeners() -> I32 {
    var ps: PassThroughStream = PassThroughStream::new()
    let result: Bool = ps.emit("data", 0)
    assert_false(result, "emit with no listeners should return false")
    ps.destroy()
    return 0
}
