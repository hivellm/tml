// Tests for DuplexStream::pipe and DuplexStream::unpipe
// Previously blocked by double mut ref codegen bug — fixed by removing
// redundant `mut ref` when forwarding already-ref parameters.
use test::{assert, assert_true, assert_false}
use std::stream::duplex::DuplexStream
use std::stream::writable_stream::WritableStream

func noop_write(data: I64, cb: I64) {}

@test
func test_duplex_pipe_to_writable() -> I32 {
    var ds: DuplexStream = DuplexStream::new()
    var ws: WritableStream = WritableStream::new()
    ws.set_write_fn(noop_write as I64)

    ds.pipe(mut ref ws)
    assert_true(ds.readable_flowing(), "flowing after pipe")

    ds.push("hello")
    ds.push_eof()

    assert_true(ws.writable_finished(), "ws finished after eof piped through duplex")
    ds.destroy()
    ws.destroy()
    return 0
}

@test
func test_duplex_unpipe_from_writable() -> I32 {
    var ds: DuplexStream = DuplexStream::new()
    var ws: WritableStream = WritableStream::new()
    ws.set_write_fn(noop_write as I64)

    ds.pipe(mut ref ws)
    assert_true(ds.readable_flowing(), "flowing after pipe")

    ds.unpipe(mut ref ws)
    // After unpipe, push_eof should NOT end ws
    ds.push_eof()
    assert_false(ws.writable_finished(), "ws NOT finished after unpipe + eof")

    ds.destroy()
    ws.destroy()
    return 0
}
