// Tests for console basic output functions (log, warn, error, debug, trace)
use test
use std::console

@test
func test_console_log() -> I32 {
    // log should print without crashing
    console::log("hello world")
    0
}

@test
func test_console_warn() -> I32 {
    console::warn("this is a warning")
    0
}

@test
func test_console_error() -> I32 {
    console::error("this is an error")
    0
}

@test
func test_console_debug() -> I32 {
    console::debug("debug info")
    0
}

@test
func test_console_trace() -> I32 {
    console::trace("trace output")
    0
}
