// Test thread spawning with actual computation and multiple threads.
use test
use std::thread::{spawn_fn, spawn_i64, UnitJoinHandle, I64JoinHandle, Builder}

@test
func test_spawn_i64_computation() -> Outcome[Unit, Str] {
    // Spawn a thread that performs a computation
    let handle: I64JoinHandle = spawn_i64(do() -> I64 {
        var sum: I64 = 0
        var i: I64 = 1
        loop (i <= 100) {
            sum = sum + i
            i = i + 1
        }
        return sum
    })

    let result = handle.join()
    assert_true(result.is_ok())
    // Sum of 1..100 = 5050
    assert_eq(result.unwrap(), 5050)
    Ok(())
}

@test
func test_spawn_with_name_and_sleep() -> Outcome[Unit, Str] {
    // spawn_fn directly (Builder::spawn is unsupported in current codegen)
    let handle: UnitJoinHandle = spawn_fn(do() {
        thread::sleep_ms(5 as U64)
    })

    let join_result = handle.join()
    assert_true(join_result.is_ok())
    Ok(())
}

@test
func test_spawn_i64_simple_value() -> Outcome[Unit, Str] {
    // spawn_i64 directly (Builder::spawn is unsupported in current codegen)
    let handle: I64JoinHandle = spawn_i64(do() -> I64 {
        return 99
    })

    let join_result = handle.join()
    assert_true(join_result.is_ok())
    assert_eq(join_result.unwrap(), 99)
    Ok(())
}
