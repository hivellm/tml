// Tests for ThreadId::eq — explicit method call
use test::{assert, assert_eq}
use std::thread

@test
func test_threadid_eq_same() -> I32 {
    let t: thread::Thread = thread::current()
    let id1: thread::ThreadId = t.id()
    let id2: thread::ThreadId = t.id()
    // Call eq() explicitly to ensure the Eq::eq impl is covered
    let result: Bool = id1.eq(ref id2)
    assert(result, "Same thread IDs should be eq")
    return 0
}

@test
func test_threadid_eq_consistent() -> I32 {
    let t: thread::Thread = thread::current()
    let id: thread::ThreadId = t.id()
    // eq with itself
    let self_eq: Bool = id.eq(ref id)
    assert(self_eq, "ThreadId should be equal to itself")
    return 0
}
