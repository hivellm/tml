use test
use std::thread::{spawn_i64, I64JoinHandle}

@test
func test_spawn_i64_computation() -> Outcome[Unit, Str] {
    let handle: I64JoinHandle = spawn_i64(do() -> I64 {
        // Compute sum 1..10
        var sum: I64 = 0
        var i: I64 = 1
        loop (i <= 10) {
            sum = sum + i
            i = i + 1
        }
        return sum
    })
    let result = handle.join()
    assert_true(result.is_ok())
    assert_eq(result.unwrap(), 55)
    Ok(())
}

@test
func test_spawn_i64_multiple_threads() -> Outcome[Unit, Str] {
    let h1: I64JoinHandle = spawn_i64(do() -> I64 { return 10 })
    let h2: I64JoinHandle = spawn_i64(do() -> I64 { return 20 })
    let h3: I64JoinHandle = spawn_i64(do() -> I64 { return 30 })

    let r1: I64 = h1.join().unwrap()
    let r2: I64 = h2.join().unwrap()
    let r3: I64 = h3.join().unwrap()

    assert_eq(r1 + r2 + r3, 60)
    Ok(())
}
