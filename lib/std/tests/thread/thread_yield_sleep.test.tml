// Tests for thread::yield_now and thread::sleep_ms
use test::{assert}
use std::thread

@test
func test_yield_now() -> I32 {
    thread::yield_now()
    assert(true, "yield_now should not crash")
    return 0
}

@test
func test_sleep_ms() -> I32 {
    thread::sleep_ms(1 as U64)
    assert(true, "sleep_ms(1) should complete")
    return 0
}
