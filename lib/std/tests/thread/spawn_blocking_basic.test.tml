// Test spawn_fn and spawn_i64 functionality.
use test::{assert_eq}
use std::thread::{spawn_fn, spawn_i64, UnitJoinHandle, I64JoinHandle}

@test
func test_spawn_fn_unit() -> I32 {
    let handle: UnitJoinHandle = spawn_fn(do() {
        // Simulate work in spawned thread
        let mut x: I64 = 0
        loop (x < 100) { x = x + 1 }
    })
    handle.join()
    assert_eq(0, 0, "spawn_fn completed")
    return 0
}

@test
func test_spawn_i64_computation() -> I32 {
    let handle: I64JoinHandle = spawn_i64(do() -> I64 {
        // Compute sum 0..999 = 499500
        var total: I64 = 0
        var i: I64 = 0
        loop (i < 1000) {
            total = total + i
            i = i + 1
        }
        return total
    })
    when handle.join() {
        Ok(result) => assert_eq(result, 499500, "sum should be 499500"),
        Err(_) => assert_eq(0, 1, "join should not fail"),
    }
    return 0
}
