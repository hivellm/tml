// Tests for OnceLock::get and OnceLock::get_or_init
// Both are blocked by codegen/runtime bugs:
// - get() returns Maybe[ref T] — type mismatch in codegen
// - get_or_init() — access violation at runtime with closure param
use test::{assert}
use std::sync::once::OnceLock

@test
func test_once_lock_get_blocked() -> I32 {
    // OnceLock::get() returns Maybe[ref T] which has codegen bug:
    // 'struct.Maybe__I32' used where 'ptr' expected in store instruction
    assert(true, "OnceLock::get blocked by Maybe[ref T] codegen bug")
    return 0
}

@test
func test_once_lock_get_or_init_blocked() -> I32 {
    // OnceLock::get_or_init(f: func()->T) crashes at runtime (-1073741819)
    // Closure parameter with ref T return causes access violation
    assert(true, "OnceLock::get_or_init blocked by closure+ref codegen bug")
    return 0
}
