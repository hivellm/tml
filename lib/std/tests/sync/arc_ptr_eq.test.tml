// Tests for Arc::ptr_eq
use test::{assert}
use std::sync::Arc

@test
func test_arc_ptr_eq_same() -> I32 {
    let a: Arc[I32] = Arc::new(42)
    let b: Arc[I32] = a.duplicate()
    assert(Arc::ptr_eq(ref a, ref b), "cloned arcs should point to same data")
    return 0
}

@test
func test_arc_ptr_eq_different() -> I32 {
    let a: Arc[I32] = Arc::new(42)
    let b: Arc[I32] = Arc::new(42)
    assert(not Arc::ptr_eq(ref a, ref b), "separate arcs should not be ptr_eq")
    return 0
}
