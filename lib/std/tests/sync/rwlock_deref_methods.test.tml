// Tests for RwLockReadGuard::deref, RwLockWriteGuard::deref, RwLockWriteGuard::deref_mut
// Previously blocked by codegen bug with generic guard struct deref
use test::{assert, assert_eq}
use std::sync::rwlock::RwLock

@test
func test_rwlock_read_guard_deref() -> I32 {
    var lock: RwLock[I32] = RwLock::new(55 as I32)
    let guard = lock.read()
    // Call deref() explicitly instead of relying on auto-deref (*guard)
    let val_ref: ref I32 = guard.deref()
    assert_eq(*val_ref, 55 as I32, "read guard deref should return 55")
    return 0
}

@test
func test_rwlock_write_guard_deref() -> I32 {
    var lock: RwLock[I32] = RwLock::new(88 as I32)
    let guard = lock.write()
    // Call deref() on write guard — returns ref T (read-only)
    let val_ref: ref I32 = guard.deref()
    assert_eq(*val_ref, 88 as I32, "write guard deref should return 88")
    return 0
}

@test
func test_rwlock_write_guard_deref_mut() -> I32 {
    var lock: RwLock[I32] = RwLock::new(10 as I32)
    var guard = lock.write()
    // Call deref_mut() on write guard — returns mut ref T
    let val_mut: mut ref I32 = guard.deref_mut()
    *val_mut = 20 as I32
    // Verify through deref() read path
    let val_ref: ref I32 = guard.deref()
    assert_eq(*val_ref, 20 as I32, "write guard deref_mut should allow mutation")
    return 0
}
