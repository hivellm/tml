// Tests for Sender::duplicate
use test::{assert_eq}
use std::sync::mpsc

@test
func test_sender_duplicate() -> I32 {
    let (tx, rx) = mpsc::channel[I32]()
    let tx2 = tx.duplicate()
    tx.send(1)
    tx2.send(2)
    let v1 = rx.recv().unwrap()
    let v2 = rx.recv().unwrap()
    assert_eq(v1 + v2, 3, "both senders should send to same channel")
    return 0
}
