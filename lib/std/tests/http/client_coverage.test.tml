// Tests for HttpClient — constructors only (network methods not testable)
use test::{assert_eq}
use std::http::client::HttpClient

@test
func test_http_client_new() -> I32 {
    let client: HttpClient = HttpClient::new()
    assert_eq(client.user_agent, "tml/1.0", "default user agent")
    return 0
}

@test
func test_http_client_with_user_agent() -> I32 {
    let client: HttpClient = HttpClient::with_user_agent("MyApp/2.0")
    assert_eq(client.user_agent, "MyApp/2.0", "custom user agent")
    return 0
}
