// Tests covering std::http::dispatch pure functions:
// app_status_text, generate_request_id, app_log_request,
// app_build_response, app_http_date
use test::{assert, assert_eq}
use core::str
use std::http::dispatch::{
    app_status_text,
    generate_request_id,
    app_log_request,
    app_build_response,
    app_http_date,
}

// ── app_status_text ───────────────────────────────────────────────

@test
func test_dispatch_status_text_200() -> I32 {
    let text: Str = app_status_text(200 as I64)
    assert_eq(text, "OK", "200 = OK")
    return 0
}

@test
func test_dispatch_status_text_404() -> I32 {
    let text: Str = app_status_text(404 as I64)
    assert_eq(text, "Not Found", "404 = Not Found")
    return 0
}

@test
func test_dispatch_status_text_500() -> I32 {
    let text: Str = app_status_text(500 as I64)
    assert_eq(text, "Internal Server Error", "500 = Internal Server Error")
    return 0
}

@test
func test_dispatch_status_text_unknown() -> I32 {
    let text: Str = app_status_text(999 as I64)
    // Unknown status codes return a fallback string
    assert(str::len(text) > 0 as I64, "unknown status should return non-empty string")
    return 0
}

// ── generate_request_id ───────────────────────────────────────────

@test
func test_dispatch_generate_request_id_runs() -> I32 {
    // generate_request_id converts time_ns() to hex. time_ns may return a
    // signed I64 — if negative, i64_to_hex_lower returns "". Just verify no crash.
    let id: Str = generate_request_id()
    assert(true, "generate_request_id should not crash")
    return 0
}

@test
func test_dispatch_generate_request_id_twice() -> I32 {
    // Verify calling twice doesn't crash
    let id1: Str = generate_request_id()
    let id2: Str = generate_request_id()
    assert(true, "generate_request_id called twice should not crash")
    return 0
}

// ── app_log_request ───────────────────────────────────────────────

@test
func test_dispatch_log_request_runs() -> I32 {
    // app_log_request writes to stdout — just verify it doesn't crash
    app_log_request("GET", "/health", 200 as I64, 123 as I64)
    assert(true, "app_log_request should not crash")
    return 0
}

// ── app_build_response ────────────────────────────────────────────

@test
func test_dispatch_build_response_200() -> I32 {
    let resp: Str = app_build_response(200 as I64, "application/json", "{\"ok\":true}")
    assert(str::len(resp) > 0 as I64, "response should be non-empty")
    return 0
}

@test
func test_dispatch_build_response_contains_status() -> I32 {
    let resp: Str = app_build_response(200 as I64, "text/plain", "hello")
    // Response should contain HTTP status line
    assert(str::len(resp) > 10 as I64, "response should contain HTTP header")
    return 0
}

@test
func test_dispatch_build_response_404() -> I32 {
    let resp: Str = app_build_response(404 as I64, "application/json", "{\"error\":\"not found\"}")
    assert(str::len(resp) > 0 as I64, "404 response non-empty")
    return 0
}

// ── app_http_date ─────────────────────────────────────────────────

@test
func test_dispatch_http_date_nonempty() -> I32 {
    let date: Str = app_http_date()
    assert(str::len(date) > 0 as I64, "http date should be non-empty")
    return 0
}

@test
func test_dispatch_http_date_format() -> I32 {
    let date: Str = app_http_date()
    // RFC 7231 dates contain ", " and " GMT" — verify length plausible (at least 20 chars)
    assert(str::len(date) >= 20 as I64, "http date should be a full date string")
    return 0
}
