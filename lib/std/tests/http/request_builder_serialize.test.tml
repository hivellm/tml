// Tests for Request builder methods (header, body, version) and serialize
use test::{assert, assert_eq, assert_true}
use std::http::request::Request
use std::http::version::HttpVersion
use core::str

@test
func test_request_header_builder() -> I32 {
    let req: Request = Request::get("http://example.com")
        .header("X-Custom", "test-value")
    assert_eq(req.body_data(), "", "no body set")
    req.destroy()
    return 0
}

@test
func test_request_body_builder() -> I32 {
    let req: Request = Request::post("http://example.com/api")
        .body("hello world")
    assert_eq(req.body_data(), "hello world", "body should match")
    req.destroy()
    return 0
}

@test
func test_request_serialize() -> I32 {
    let req: Request = Request::get("http://example.com/path")
    let wire: Str = req.serialize()
    assert_true(str::starts_with(wire, "GET"), "starts with GET")
    assert_true(str::contains(wire, "/path"), "contains path")
    assert_true(str::contains(wire, "HTTP/1.1"), "contains version")
    req.destroy()
    return 0
}
