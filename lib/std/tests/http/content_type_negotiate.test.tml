// Tests for content_type::negotiate
use test::{assert, assert_eq}
use std::http::content_type::negotiate

@test
func test_negotiate_exact_match() -> I32 {
    let result: Str = negotiate("text/html", "text/html,application/json")
    assert_eq(result, "text/html", "exact match should return text/html")
    return 0
}

@test
func test_negotiate_wildcard_accept() -> I32 {
    let result: Str = negotiate("*/*", "application/json,text/html")
    assert(result == "application/json" or result == "text/html", "wildcard should match first available")
    return 0
}

@test
func test_negotiate_no_match() -> I32 {
    let result: Str = negotiate("image/png", "text/html,application/json")
    assert_eq(result, "", "no match returns empty string")
    return 0
}

@test
func test_negotiate_empty_accept() -> I32 {
    let result: Str = negotiate("", "text/html")
    assert_eq(result, "", "empty accept returns empty")
    return 0
}

@test
func test_negotiate_empty_available() -> I32 {
    let result: Str = negotiate("text/html", "")
    assert_eq(result, "", "empty available returns empty")
    return 0
}
