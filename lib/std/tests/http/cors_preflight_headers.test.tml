// Tests for cors::preflight_headers
use test::{assert, assert_eq}
use core::str
use std::http::cors::{CorsOptions, preflight_headers}

@test
func test_preflight_headers_with_methods() -> I32 {
    var opts: CorsOptions = CorsOptions {
        allow_origin: "*",
        allow_methods: "GET, POST, OPTIONS",
        allow_headers: "Content-Type",
        allow_credentials: false,
        max_age: 0 as I64,
        expose_headers: "",
    }
    let result: Str = preflight_headers(ref opts, "https://example.com", "POST", "Content-Type")
    assert(str::len(result) > 0 as I64, "preflight headers should be non-empty")
    return 0
}

@test
func test_preflight_headers_reflect_request_headers() -> I32 {
    // When allow_headers is empty, request_headers should be reflected
    var opts: CorsOptions = CorsOptions {
        allow_origin: "*",
        allow_methods: "GET, POST",
        allow_headers: "",
        allow_credentials: false,
        max_age: 0 as I64,
        expose_headers: "",
    }
    let result: Str = preflight_headers(ref opts, "https://example.com", "POST", "X-Custom-Header")
    assert(str::len(result) > 0 as I64, "result non-empty")
    return 0
}

@test
func test_preflight_headers_with_max_age() -> I32 {
    var opts: CorsOptions = CorsOptions {
        allow_origin: "*",
        allow_methods: "GET",
        allow_headers: "Accept",
        allow_credentials: false,
        max_age: 3600 as I64,
        expose_headers: "",
    }
    let result: Str = preflight_headers(ref opts, "https://example.com", "GET", "Accept")
    assert(str::len(result) > 0 as I64, "result with max_age non-empty")
    return 0
}
