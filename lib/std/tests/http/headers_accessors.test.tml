// Tests for Headers convenience accessors on empty headers
use test::{assert_eq, assert_false}
use std::http::headers::Headers

@test
func test_headers_content_encoding_empty() -> I32 {
    let h: Headers = Headers::new()
    assert_eq(h.content_encoding(), "", "content_encoding on empty should be empty")
    h.destroy()
    return 0
}

@test
func test_headers_transfer_encoding_empty() -> I32 {
    let h: Headers = Headers::new()
    assert_eq(h.transfer_encoding(), "", "transfer_encoding on empty should be empty")
    h.destroy()
    return 0
}

@test
func test_headers_host_empty() -> I32 {
    let h: Headers = Headers::new()
    assert_eq(h.host(), "", "host on empty should be empty")
    h.destroy()
    return 0
}

@test
func test_headers_connection_empty() -> I32 {
    let h: Headers = Headers::new()
    assert_eq(h.connection(), "", "connection on empty should be empty")
