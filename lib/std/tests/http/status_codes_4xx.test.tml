// Tests for std::http::status — 4xx client error codes
use test::{assert, assert_eq}
use std::http::status::Status

@test
func test_4xx_client_error_codes() -> I32 {
    assert_eq(Status::BAD_REQUEST().code(), 400 as I32, "BAD_REQUEST")
    assert_eq(Status::UNAUTHORIZED().code(), 401 as I32, "UNAUTHORIZED")
    assert_eq(Status::PAYMENT_REQUIRED().code(), 402 as I32, "PAYMENT_REQUIRED")
    assert_eq(Status::FORBIDDEN().code(), 403 as I32, "FORBIDDEN")
    assert_eq(Status::NOT_FOUND().code(), 404 as I32, "NOT_FOUND")
    assert_eq(Status::METHOD_NOT_ALLOWED().code(), 405 as I32, "METHOD_NOT_ALLOWED")
    assert_eq(Status::NOT_ACCEPTABLE().code(), 406 as I32, "NOT_ACCEPTABLE")
    assert_eq(Status::PROXY_AUTHENTICATION_REQUIRED().code(), 407 as I32, "PROXY_AUTH")
    assert_eq(Status::REQUEST_TIMEOUT().code(), 408 as I32, "REQUEST_TIMEOUT")
    assert_eq(Status::CONFLICT().code(), 409 as I32, "CONFLICT")
    assert_eq(Status::GONE().code(), 410 as I32, "GONE")
    assert_eq(Status::LENGTH_REQUIRED().code(), 411 as I32, "LENGTH_REQUIRED")
    assert_eq(Status::PRECONDITION_FAILED().code(), 412 as I32, "PRECONDITION_FAILED")
    assert_eq(Status::PAYLOAD_TOO_LARGE().code(), 413 as I32, "PAYLOAD_TOO_LARGE")
    assert_eq(Status::URI_TOO_LONG().code(), 414 as I32, "URI_TOO_LONG")
    return 0
}

@test
func test_4xx_client_error_codes_continued() -> I32 {
    assert_eq(Status::UNSUPPORTED_MEDIA_TYPE().code(), 415 as I32, "UNSUPPORTED_MEDIA_TYPE")
    assert_eq(Status::RANGE_NOT_SATISFIABLE().code(), 416 as I32, "RANGE_NOT_SATISFIABLE")
    assert_eq(Status::EXPECTATION_FAILED().code(), 417 as I32, "EXPECTATION_FAILED")
    assert_eq(Status::IM_A_TEAPOT().code(), 418 as I32, "IM_A_TEAPOT")
    assert_eq(Status::MISDIRECTED_REQUEST().code(), 421 as I32, "MISDIRECTED_REQUEST")
    assert_eq(Status::UNPROCESSABLE_ENTITY().code(), 422 as I32, "UNPROCESSABLE_ENTITY")
    assert_eq(Status::LOCKED().code(), 423 as I32, "LOCKED")
    assert_eq(Status::FAILED_DEPENDENCY().code(), 424 as I32, "FAILED_DEPENDENCY")
    assert_eq(Status::TOO_EARLY().code(), 425 as I32, "TOO_EARLY")
    assert_eq(Status::UPGRADE_REQUIRED().code(), 426 as I32, "UPGRADE_REQUIRED")
    assert_eq(Status::PRECONDITION_REQUIRED().code(), 428 as I32, "PRECONDITION_REQUIRED")
    assert_eq(Status::TOO_MANY_REQUESTS().code(), 429 as I32, "TOO_MANY_REQUESTS")
    assert_eq(Status::REQUEST_HEADER_FIELDS_TOO_LARGE().code(), 431 as I32, "HEADER_TOO_LARGE")
    assert_eq(Status::UNAVAILABLE_FOR_LEGAL_REASONS().code(), 451 as I32, "LEGAL_REASONS")
    return 0
}

@test
func test_4xx_reasons() -> I32 {
    assert_eq(Status::BAD_REQUEST().reason(), "Bad Request", "400 reason")
    assert_eq(Status::UNAUTHORIZED().reason(), "Unauthorized", "401 reason")
    assert_eq(Status::PAYMENT_REQUIRED().reason(), "Payment Required", "402 reason")
    assert_eq(Status::FORBIDDEN().reason(), "Forbidden", "403 reason")
    assert_eq(Status::METHOD_NOT_ALLOWED().reason(), "Method Not Allowed", "405 reason")
    assert_eq(Status::NOT_ACCEPTABLE().reason(), "Not Acceptable", "406 reason")
    assert_eq(Status::REQUEST_TIMEOUT().reason(), "Request Timeout", "408 reason")
    assert_eq(Status::CONFLICT().reason(), "Conflict", "409 reason")
    assert_eq(Status::GONE().reason(), "Gone", "410 reason")
    assert_eq(Status::IM_A_TEAPOT().reason(), "I'm a Teapot", "418 reason")
    assert_eq(Status::UNPROCESSABLE_ENTITY().reason(), "Unprocessable Entity", "422 reason")
    assert_eq(Status::TOO_MANY_REQUESTS().reason(), "Too Many Requests", "429 reason")
    return 0
}

@test
func test_4xx_is_client_error() -> I32 {
    assert(Status::BAD_REQUEST().is_client_error(), "400 client error")
    assert(Status::UNAUTHORIZED().is_client_error(), "401 client error")
    assert(Status::FORBIDDEN().is_client_error(), "403 client error")
    assert(Status::NOT_FOUND().is_client_error(), "404 client error")
    assert(Status::IM_A_TEAPOT().is_client_error(), "418 client error")
    assert(Status::UNPROCESSABLE_ENTITY().is_client_error(), "422 client error")
    assert(Status::TOO_MANY_REQUESTS().is_client_error(), "429 client error")
    assert(Status::UNAVAILABLE_FOR_LEGAL_REASONS().is_client_error(), "451 client error")
    assert(not Status::BAD_REQUEST().is_success(), "400 not success")
    assert(not Status::BAD_REQUEST().is_server_error(), "400 not server error")
    return 0
}
