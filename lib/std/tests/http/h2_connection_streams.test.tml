// v3
use test
use std::collections::Buffer
use std::http::h2::frame::{
    H2_FLAG_END_HEADERS, H2_FLAG_END_STREAM,
}
use std::http::h2::hpack::{HpackContext, HpackEntry, hpack_encode_headers}
use std::http::h2::connection::{
    H2Connection,
    H2_CONN_EVENT_NONE, H2_CONN_EVENT_REQUEST, H2_CONN_EVENT_DATA,
    H2_CONN_EVENT_STREAM_RESET,
}

@test
func test_headers_new_stream() -> Outcome[Unit, Str] {
    var conn = H2Connection::new()
    var ctx = HpackContext::new(4096)
    var headers: List[HpackEntry] = List::new(4)
    headers.push(HpackEntry::new(":method", "GET"))
    headers.push(HpackEntry::new(":path", "/"))
    let hblock = hpack_encode_headers(mut ref ctx, headers)

    let flags: I32 = H2_FLAG_END_HEADERS | H2_FLAG_END_STREAM
    let ev = conn.process_frame(1, flags, 1, ref hblock)!
    assert_eq(ev.event_type, H2_CONN_EVENT_REQUEST)
    assert_eq(ev.stream_id, 1)
    assert_eq(ev.end_stream, 1)
    assert_eq(conn.active_streams(), 1)
    Ok(())
}

@test
func test_headers_multiple_streams() -> Outcome[Unit, Str] {
    var conn = H2Connection::new()

    // Stream 1
    var ctx1 = HpackContext::new(4096)
    var h1: List[HpackEntry] = List::new(4)
    h1.push(HpackEntry::new(":method", "GET"))
    h1.push(HpackEntry::new(":path", "/a"))
    let hb1 = hpack_encode_headers(mut ref ctx1, h1)
    let ev1 = conn.process_frame(1, H2_FLAG_END_HEADERS | H2_FLAG_END_STREAM, 1, ref hb1)!
    assert_eq(ev1.event_type, H2_CONN_EVENT_REQUEST)
    assert_eq(ev1.stream_id, 1)

    // Stream 3
    var ctx3 = HpackContext::new(4096)
    var h3: List[HpackEntry] = List::new(4)
    h3.push(HpackEntry::new(":method", "POST"))
    h3.push(HpackEntry::new(":path", "/b"))
    let hb3 = hpack_encode_headers(mut ref ctx3, h3)
    let ev3 = conn.process_frame(1, H2_FLAG_END_HEADERS, 3, ref hb3)!
    assert_eq(ev3.event_type, H2_CONN_EVENT_REQUEST)
    assert_eq(ev3.stream_id, 3)

    assert_eq(conn.active_streams(), 2)
    Ok(())
}

@test
func test_data_frame() -> Outcome[Unit, Str] {
    var conn = H2Connection::new()

    // Open stream 1 with HEADERS (no END_STREAM)
    var ctx = HpackContext::new(4096)
    var headers: List[HpackEntry] = List::new(4)
    headers.push(HpackEntry::new(":method", "POST"))
    headers.push(HpackEntry::new(":path", "/upload"))
    let hblock = hpack_encode_headers(mut ref ctx, headers)
    conn.process_frame(1, H2_FLAG_END_HEADERS, 1, ref hblock)!

    // Send DATA frame (type=0)
    let data = Buffer::new(16)
    var i: I64 = 0
    loop (i < 10) {
        data.write_byte(0x41)
        i = i + 1
    }
    let ev = conn.process_frame(0, 0, 1, ref data)!
    assert_eq(ev.event_type, H2_CONN_EVENT_DATA)
    assert_eq(ev.stream_id, 1)
    assert_eq(ev.data_len, 10)
    assert_eq(ev.end_stream, 0)
    Ok(())
}

@test
func test_rst_stream() -> Outcome[Unit, Str] {
    var conn = H2Connection::new()

    // Open stream 1
    var ctx = HpackContext::new(4096)
    var headers: List[HpackEntry] = List::new(4)
    headers.push(HpackEntry::new(":method", "GET"))
    let hblock = hpack_encode_headers(mut ref ctx, headers)
    conn.process_frame(1, H2_FLAG_END_HEADERS, 1, ref hblock)!

    // RST_STREAM (type=3)
    let rst_payload = Buffer::new(4)
    rst_payload.write_u32_be(8, 0)  // CANCEL
    let ev = conn.process_frame(3, 0, 1, ref rst_payload)!
    assert_eq(ev.event_type, H2_CONN_EVENT_STREAM_RESET)
    assert_eq(ev.stream_id, 1)
    assert_eq(ev.error_code, 8)
    Ok(())
}

@test
func test_stream_id_must_increase() -> Outcome[Unit, Str] {
    var conn = H2Connection::new()

    // Open stream 3
    var ctx = HpackContext::new(4096)
    var h: List[HpackEntry] = List::new(4)
    h.push(HpackEntry::new(":method", "GET"))
    let hb = hpack_encode_headers(mut ref ctx, h)
    conn.process_frame(1, H2_FLAG_END_HEADERS, 3, ref hb)!

    // Try stream 1 (lower than 3 — should fail)
    var ctx2 = HpackContext::new(4096)
    var h2: List[HpackEntry] = List::new(4)
    h2.push(HpackEntry::new(":method", "GET"))
    let hb2 = hpack_encode_headers(mut ref ctx2, h2)
    let result = conn.process_frame(1, H2_FLAG_END_HEADERS, 1, ref hb2)
    assert_true(result.is_err())
    Ok(())
}

@test
func test_encode_headers_response() -> Outcome[Unit, Str] {
    var conn = H2Connection::new()
    var resp_headers: List[HpackEntry] = List::new(4)
    resp_headers.push(HpackEntry::new(":status", "200"))
    resp_headers.push(HpackEntry::new("content-type", "text/plain"))
    let encoded = conn.encode_headers(1, resp_headers, 1)
    // Should be a valid frame
    assert_true(encoded.len() > 9)
    // Frame type = HEADERS (1)
    assert_eq(encoded.get(3), 1)
    // Flags should include END_HEADERS (0x04) and END_STREAM (0x01)
    let flags: I32 = encoded.get(4)
    assert_true((flags & 0x04) != 0)
    assert_true((flags & 0x01) != 0)
    Ok(())
}
