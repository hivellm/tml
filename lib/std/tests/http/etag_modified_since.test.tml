// Tests for etag — If-Modified-Since
use test::{assert}
use std::http::etag::is_not_modified_since

@test
func test_is_not_modified_since() -> I32 {
    assert(is_not_modified_since("Mon, 17 Mar 2026 12:00:00 GMT", "Mon, 17 Mar 2026 12:00:00 GMT"), "same date")
    assert(not is_not_modified_since("Mon, 16 Mar 2026 12:00:00 GMT", "Mon, 17 Mar 2026 12:00:00 GMT"), "different date")
    assert(not is_not_modified_since("", "Mon, 17 Mar 2026 12:00:00 GMT"), "empty IMS")
    return 0
}
