// Tests for static_server — MIME type lookup
use test::{assert, assert_eq}
use core::str
use std::http::static_server::mime_for_extension

@test
func test_mime_for_extension() -> I32 {
    assert(str::starts_with(mime_for_extension("html"), "text/html"), "html")
    assert(str::starts_with(mime_for_extension("css"), "text/css"), "css")
    assert(str::starts_with(mime_for_extension("js"), "text/javascript"), "js")
    assert(str::starts_with(mime_for_extension("json"), "application/json"), "json")
    assert_eq(mime_for_extension("png"), "image/png", "png")
    assert_eq(mime_for_extension("jpg"), "image/jpeg", "jpg")
    assert_eq(mime_for_extension("woff2"), "font/woff2", "woff2")
    assert_eq(mime_for_extension("mp4"), "video/mp4", "mp4")
    assert_eq(mime_for_extension("wasm"), "application/wasm", "wasm")
    assert_eq(mime_for_extension("pdf"), "application/pdf", "pdf")
    assert_eq(mime_for_extension("unknown"), "application/octet-stream", "unknown fallback")
    return 0
}
