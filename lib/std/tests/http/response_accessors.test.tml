// Tests for Response::content_type, content_length
use test::{assert_eq}
use std::http::response::Response
use std::http::headers::Headers
use std::http::status::Status

@test
func test_response_content_length_missing() -> I32 {
    let h: Headers = Headers::new()
    let resp: Response = Response::new(Status::new(200), h, "")
    assert_eq(resp.content_length(), -1 as I64, "missing content-length should be -1")
    resp.destroy()
    return 0
}

@test
func test_response_content_type_empty() -> I32 {
    let h: Headers = Headers::new()
    let resp: Response = Response::new(Status::new(200), h, "")
    assert_eq(resp.content_type(), "", "no content-type should be empty")
    resp.destroy()
    return 0
}

// NOTE: Response with h.set() headers crashes — mut Headers before passing to Response::new
// NOTE: Response::parse and Response::headers also blocked
