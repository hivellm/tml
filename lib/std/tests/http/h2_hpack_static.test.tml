// Tests for HPACK static table lookup (RFC 7541 Appendix A)
use test::{assert, assert_eq}
use std::http::h2::hpack::{
    HpackEntry,
    hpack_static_table_entry,
}

@test
func test_static_table_authority() -> I32 {
    let entry: Maybe[HpackEntry] = hpack_static_table_entry(1)
    assert(entry.is_just(), "index 1 exists")
    let e: HpackEntry = entry.unwrap()
    assert_eq(e.name, ":authority", "name = :authority")
    assert_eq(e.value, "", "value = empty")
    return 0
}

@test
func test_static_table_method_get() -> I32 {
    let entry: Maybe[HpackEntry] = hpack_static_table_entry(2)
    assert(entry.is_just(), "index 2 exists")
    let e: HpackEntry = entry.unwrap()
    assert_eq(e.name, ":method", "name = :method")
    assert_eq(e.value, "GET", "value = GET")
    return 0
}

