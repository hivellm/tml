@test
func test_static_table_index_zero() -> I32 {
    let entry: Maybe[HpackEntry] = hpack_static_table_entry(0)
    assert(entry.is_nothing(), "index 0 = Nothing")
    return 0
}

@test
func test_static_table_index_62() -> I32 {
    let entry: Maybe[HpackEntry] = hpack_static_table_entry(62)
