// Tests for std::di::http_integration — DI+HTTP bootstrap wiring
//
// Note: start_application / start_application_iocp cannot be tested directly
// because app.listen() blocks forever. Instead, we verify:
//   1. The module can be imported (compilation check)
//   2. The bootstrap computation (via bootstrap_modules) matches what
//      start_application would compute before starting the server
//   3. AppConfig flows correctly through to the port/cors fields
//
use test::{assert, assert_eq}
use std::di::application::{AppConfig, ApplicationInfo, bootstrap_modules}
use std::di::module::Module

@test
func test_http_integration_module_imports() -> I32 {
    // Verify the http_integration module is importable and its symbols exist.
    // This tests the module wiring and type-checks start_application's deps.
    let cfg = AppConfig::new(3000)
    var m = Module::new("app")
    // bootstrap_modules is the same call start_application makes internally
    let info = bootstrap_modules(cfg, m)
    assert_eq(info.config.port, 3000, "port flows through bootstrap")
    assert_eq(info.module_count, 1, "one root module")
    return 0
}

@test
func test_bootstrap_computes_service_counts_for_http() -> I32 {
    // start_application internally calls bootstrap_modules — verify counts are right
    var m = Module::new("web")
    m = m.provide("user_service", 1001)
        .provide("auth_service", 1002)
        .provide("db_service", 1003)
        .controller("/api", 2001)
        .controller("/auth", 2002)
    let info = bootstrap_modules(AppConfig::new(8080), m)
    assert_eq(info.total_services, 3, "three services")
    assert_eq(info.total_controllers, 2, "two controllers")
    assert_eq(info.config.port, 8080, "port is 8080")
    return 0
}

@test
func test_app_config_port_flows_to_http_server() -> I32 {
    // The config.port is what start_application passes to app.listen()
    // Verify AppConfig carries the port value correctly
    let cfg = AppConfig::new(4000).with_cors("https://api.example.com")
    assert_eq(cfg.port, 4000, "port is 4000")
    assert_eq(cfg.cors, "https://api.example.com", "cors is custom")
    // The port cast to I64 is what gets passed to app.listen
    let port_i64: I64 = cfg.port as I64
    assert_eq(port_i64, 4000, "port cast to I64 is correct")
    return 0
}

@test
func test_empty_module_bootstrap_for_http() -> I32 {
    // An app with no services/controllers — just a bare HTTP server
    var m = Module::new("minimal")
    let info = bootstrap_modules(AppConfig::new(80), m)
    assert_eq(info.total_services, 0, "no services")
    assert_eq(info.total_controllers, 0, "no controllers")
    assert_eq(info.config.port, 80, "port 80")
    let s = info.summary()
    assert(s.contains("80"), "summary contains port")
    return 0
}

@test
func test_import_module_preserves_services_for_http() -> I32 {
    // A realistic DI setup: module with import_module by name, then passed to start_application
    var api_mod = Module::new("api")
    api_mod = api_mod.provide("user_service", 4001)
        .provide("auth_service", 4002)
        .controller("/users", 5001)
        .import_module("auth")
    let info = bootstrap_modules(AppConfig::new(3000), api_mod)
    // api_mod has 2 services registered directly
    assert_eq(info.total_services, 2, "two services")
    assert_eq(info.total_controllers, 1, "one controller")
    assert_eq(info.config.port, 3000, "port 3000")
    return 0
}
