// Tests for EventEmitter::emit_async and EventEmitter::emit_next_tick
// BLOCKED: aio::timer_set has a parameter named `entry` which conflicts with
// the LLVM basic block label `entry:` in the generated IR.
// Error: "unable to create block named 'entry'" — compiler bug in parameter naming.
// These functions are not testable until the codegen bug is fixed.
use test::{assert}

@test
func test_emit_async_blocked() -> I32 {
    assert(true, "emit_async blocked by timer_set parameter name codegen bug")
    return 0
}

@test
func test_emit_next_tick_blocked() -> I32 {
    assert(true, "emit_next_tick blocked by timer_set parameter name codegen bug")
    return 0
}
