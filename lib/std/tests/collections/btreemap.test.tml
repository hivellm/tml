// Tests for std::collections::BTreeMap
use test
use std::collections::BTreeMap

@test
func test_btreemap_create_empty() -> Outcome[Unit, Str] {
    let m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    assert_true(m.is_empty(), "new map should be empty")
    assert_eq(m.len(), 0 as I64, "len should be 0")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_insert_get() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(5, 50)
    m.insert(3, 30)
    m.insert(7, 70)
    assert_eq(m.len(), 3 as I64, "len should be 3")
    assert_eq(m.get(5), 50 as I64, "get(5) should be 50")
    assert_eq(m.get(3), 30 as I64, "get(3) should be 30")
    assert_eq(m.get(7), 70 as I64, "get(7) should be 70")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_contains_key() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(1, 10)
    m.insert(2, 20)
    assert_true(m.contains_key(1), "should contain 1")
    assert_true(m.contains_key(2), "should contain 2")
    assert_false(m.contains_key(3), "should not contain 3")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_update_value() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(1, 10)
    m.insert(1, 99)
    assert_eq(m.len(), 1 as I64, "should still have 1 entry")
    assert_eq(m.get(1), 99 as I64, "value should be updated to 99")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_sorted_order() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(50, 500)
    m.insert(10, 100)
    m.insert(30, 300)
    m.insert(20, 200)
    m.insert(40, 400)
    assert_eq(m.min_key(), 10 as I64, "min_key should be 10")
    assert_eq(m.max_key(), 50 as I64, "max_key should be 50")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_remove() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(1, 10)
    m.insert(2, 20)
    m.insert(3, 30)
    let removed: Bool = m.remove(2)
    assert_true(removed, "remove(2) should return true")
    assert_eq(m.len(), 2 as I64, "len should be 2 after remove")
    assert_false(m.contains_key(2), "should not contain 2 after remove")
    assert_eq(m.get(1), 10 as I64, "get(1) should still work")
    assert_eq(m.get(3), 30 as I64, "get(3) should still work")
    let not_removed: Bool = m.remove(99)
    assert_false(not_removed, "remove(99) should return false")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_clear() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(1, 10)
    m.insert(2, 20)
    m.clear()
    assert_true(m.is_empty(), "should be empty after clear")
    assert_eq(m.len(), 0 as I64, "len should be 0 after clear")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_many_inserts() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    var i: I64 = 0
    loop (i < 50) {
        m.insert(50 - i, i * 10)
        i = i + 1
    }
    assert_eq(m.len(), 50 as I64, "should have 50 entries")
    assert_eq(m.min_key(), 1 as I64, "min should be 1")
    assert_eq(m.max_key(), 50 as I64, "max should be 50")
    assert_eq(m.get(25), 250 as I64, "get(25) should be 250")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_insert_after_remove() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(1, 10)
    m.insert(2, 20)
    m.insert(3, 30)
    m.remove(2)
    m.insert(2, 99)
    assert_eq(m.len(), 3 as I64, "should have 3 entries")
    assert_eq(m.get(2), 99 as I64, "re-inserted key should have new value")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_single_element() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(42, 420)
    assert_eq(m.len(), 1 as I64, "should have 1 entry")
    assert_eq(m.min_key(), 42 as I64, "min should be 42")
    assert_eq(m.max_key(), 42 as I64, "max should be 42")
    assert_eq(m.get(42), 420 as I64, "get(42) should be 420")
    m.remove(42)
    assert_true(m.is_empty(), "should be empty after removing only element")
    m.destroy()
    Ok(())
}
