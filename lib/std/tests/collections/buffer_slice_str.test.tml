// Tests for Buffer slice and string conversion
use test::{assert_eq}
use std::collections::Buffer

@test
func test_buffer_to_string() -> I32 {
    let buf: Buffer = Buffer.new(16)
    buf.write_str("Hello")
    let s: Str = buf.to_string()
    assert_eq(s, "Hello", "to_string roundtrip")
    buf.destroy()
    return 0
}

@test
func test_buffer_from_string() -> I32 {
    let buf: Buffer = Buffer.from_string("World")
    assert_eq(buf.len(), 5 as I64, "from_string len")
    let s: Str = buf.to_string()
    assert_eq(s, "World", "from_string content")
    buf.destroy()
    return 0
}

@test
func test_buffer_slice() -> I32 {
    let buf: Buffer = Buffer.new(16)
    buf.write_str("Hello World")
    let sliced: Buffer = buf.slice(0 as I64, 5 as I64)
    let s: Str = sliced.to_string()
    assert_eq(s, "Hello", "slice 0..5")
    sliced.destroy()
    buf.destroy()
    return 0
}
