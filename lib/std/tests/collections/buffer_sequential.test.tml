// Tests for Buffer sequential write/read methods and state accessors
use test::{assert, assert_eq}
use std::collections::Buffer

@test
func test_buffer_write_read_i32_sequential() -> I32 {
    let buf: Buffer = Buffer.new(16)
    buf.write_i32(42)
    buf.write_i32(-7)
    buf.reset_read()
    let v1: I32 = buf.read_i32()
    let v2: I32 = buf.read_i32()
    assert_eq(v1, 42, "should read back 42")
    assert_eq(v2, -7, "should read back -7")
    buf.destroy()
    return 0
}

@test
func test_buffer_capacity_accessor() -> I32 {
    let buf: Buffer = Buffer.new(128)
    assert_eq(buf.capacity(), 128 as I64, "initial capacity should be 128")
    buf.destroy()
    return 0
}

@test
func test_buffer_default_capacity() -> I32 {
    let buf: Buffer = Buffer.default()
    assert_eq(buf.capacity(), 64 as I64, "default capacity should be 64")
    assert_eq(buf.len(), 0 as I64, "default buffer should be empty")
    buf.destroy()
    return 0
}
