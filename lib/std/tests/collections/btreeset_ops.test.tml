// Tests for BTreeSet set operations and ordered access
use test
use std::collections::BTreeSet

@test
func test_btreeset_get_at() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    s.insert(30)
    s.insert(10)
    s.insert(20)
    assert_eq(s.get_at(0), 10 as I64, "get_at(0) should be 10")
    assert_eq(s.get_at(1), 20 as I64, "get_at(1) should be 20")
    assert_eq(s.get_at(2), 30 as I64, "get_at(2) should be 30")
    s.destroy()
    Ok(())
}

@test
func test_btreeset_union_with() -> Outcome[Unit, Str] {
    var a: BTreeSet[I64] = BTreeSet[I64]::create()
    a.insert(1)
    a.insert(2)
    a.insert(3)
    var b: BTreeSet[I64] = BTreeSet[I64]::create()
    b.insert(3)
    b.insert(4)
    b.insert(5)
    let u: BTreeSet[I64] = a.union_with(ref b)
    assert_eq(u.len(), 5 as I64, "union should have 5 elements")
    assert_true(u.contains(1), "union contains 1")
    assert_true(u.contains(3), "union contains 3")
    assert_true(u.contains(5), "union contains 5")
    a.destroy()
    b.destroy()
    u.destroy()
    Ok(())
}

@test
func test_btreeset_intersection() -> Outcome[Unit, Str] {
    var a: BTreeSet[I64] = BTreeSet[I64]::create()
    a.insert(1)
    a.insert(2)
    a.insert(3)
    var b: BTreeSet[I64] = BTreeSet[I64]::create()
    b.insert(2)
    b.insert(3)
    b.insert(4)
    let inter: BTreeSet[I64] = a.intersection(ref b)
    assert_eq(inter.len(), 2 as I64, "intersection should have 2 elements")
    assert_true(inter.contains(2), "intersection contains 2")
    assert_true(inter.contains(3), "intersection contains 3")
    assert_false(inter.contains(1), "intersection does not contain 1")
    assert_false(inter.contains(4), "intersection does not contain 4")
    a.destroy()
    b.destroy()
    inter.destroy()
    Ok(())
}

@test
func test_btreeset_difference() -> Outcome[Unit, Str] {
    var a: BTreeSet[I64] = BTreeSet[I64]::create()
    a.insert(1)
    a.insert(2)
    a.insert(3)
    var b: BTreeSet[I64] = BTreeSet[I64]::create()
    b.insert(2)
    b.insert(3)
    b.insert(4)
    let diff: BTreeSet[I64] = a.difference(ref b)
    assert_eq(diff.len(), 1 as I64, "difference should have 1 element")
    assert_true(diff.contains(1), "difference contains 1")
    assert_false(diff.contains(2), "difference does not contain 2")
    a.destroy()
    b.destroy()
    diff.destroy()
    Ok(())
}

@test
func test_btreeset_symmetric_difference() -> Outcome[Unit, Str] {
    var a: BTreeSet[I64] = BTreeSet[I64]::create()
    a.insert(1)
    a.insert(2)
    a.insert(3)
    var b: BTreeSet[I64] = BTreeSet[I64]::create()
    b.insert(2)
    b.insert(3)
    b.insert(4)
    let sdiff: BTreeSet[I64] = a.symmetric_difference(ref b)
    assert_eq(sdiff.len(), 2 as I64, "symmetric_difference should have 2 elements")
    assert_true(sdiff.contains(1), "sym_diff contains 1")
    assert_true(sdiff.contains(4), "sym_diff contains 4")
    assert_false(sdiff.contains(2), "sym_diff does not contain 2")
    assert_false(sdiff.contains(3), "sym_diff does not contain 3")
    a.destroy()
    b.destroy()
    sdiff.destroy()
    Ok(())
}

@test
func test_btreeset_is_subset() -> Outcome[Unit, Str] {
    var a: BTreeSet[I64] = BTreeSet[I64]::create()
    a.insert(2)
    a.insert(3)
    var b: BTreeSet[I64] = BTreeSet[I64]::create()
    b.insert(1)
    b.insert(2)
    b.insert(3)
    b.insert(4)
    assert_true(a.is_subset(ref b), "a is subset of b")
    assert_false(b.is_subset(ref a), "b is not subset of a")
    a.destroy()
    b.destroy()
    Ok(())
}

@test
func test_btreeset_is_superset() -> Outcome[Unit, Str] {
    var a: BTreeSet[I64] = BTreeSet[I64]::create()
    a.insert(1)
    a.insert(2)
    a.insert(3)
    var b: BTreeSet[I64] = BTreeSet[I64]::create()
    b.insert(2)
    b.insert(3)
    assert_true(a.is_superset(ref b), "a is superset of b")
    assert_false(b.is_superset(ref a), "b is not superset of a")
    a.destroy()
    b.destroy()
    Ok(())
}

@test
func test_btreeset_is_disjoint() -> Outcome[Unit, Str] {
    var a: BTreeSet[I64] = BTreeSet[I64]::create()
    a.insert(1)
    a.insert(2)
    var b: BTreeSet[I64] = BTreeSet[I64]::create()
    b.insert(3)
    b.insert(4)
    var c: BTreeSet[I64] = BTreeSet[I64]::create()
    c.insert(2)
    c.insert(5)
    assert_true(a.is_disjoint(ref b), "a and b are disjoint")
    assert_false(a.is_disjoint(ref c), "a and c share element 2")
    a.destroy()
    b.destroy()
    c.destroy()
    Ok(())
}

@test
func test_btreeset_empty_operations() -> Outcome[Unit, Str] {
    var a: BTreeSet[I64] = BTreeSet[I64]::create()
    a.insert(1)
    a.insert(2)
    var empty: BTreeSet[I64] = BTreeSet[I64]::create()
    let u: BTreeSet[I64] = a.union_with(ref empty)
    assert_eq(u.len(), 2 as I64, "union with empty = original")
    let inter: BTreeSet[I64] = a.intersection(ref empty)
    assert_eq(inter.len(), 0 as I64, "intersection with empty = empty")
    let diff: BTreeSet[I64] = a.difference(ref empty)
    assert_eq(diff.len(), 2 as I64, "difference with empty = original")
    assert_true(empty.is_subset(ref a), "empty is subset of any set")
    assert_true(a.is_superset(ref empty), "any set is superset of empty")
    assert_true(a.is_disjoint(ref empty), "any set is disjoint with empty")
    a.destroy()
    empty.destroy()
    u.destroy()
    inter.destroy()
    diff.destroy()
    Ok(())
}
