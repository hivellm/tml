// Tests for HashMap retain
use test::{assert, assert_eq}
use std::collections::hashmap::HashMap

@test
func test_retain() -> I32 {
    let map = HashMap::new[Str, I64](16)
    map.set("a", 1)
    map.set("b", 2)
    map.set("c", 3)
    map.set("d", 4)

    // Keep only values > 2
    map.retain(do(key: Str, val: I64) -> Bool { val > 2 })

    assert_eq(map.len(), 2, "should have 2 entries after retain")
    assert(not map.has("a"), "a should be removed")
    assert(not map.has("b"), "b should be removed")
    assert(map.has("c"), "c should be retained")
    assert(map.has("d"), "d should be retained")

    map.destroy()
    return 0
}
