// Tests for List::drain — removes and returns a range of elements
use test::{assert, assert_eq}
use std::collections::List

@test
func test_drain_middle() -> I32 {
    let list: List[I32] = List[I32].new(8)
    list.push(1)
    list.push(2)
    list.push(3)
    list.push(4)
    list.push(5)

    // Drain elements [1, 3) => removes indices 1 and 2
    let drained: List[I32] = list.drain(1, 3)

    // Check drained list
    assert_eq(drained.len(), 2 as I64, "drained should have 2 elements")
    assert_eq(drained.get(0), 2 as I64, "drained[0] is 2")
    assert_eq(drained.get(1), 3 as I64, "drained[1] is 3")

    // Check original list
    assert_eq(list.len(), 3 as I64, "original should have 3 elements")
    assert_eq(list.get(0), 1 as I64, "original[0] is 1")
    assert_eq(list.get(1), 4 as I64, "original[1] is 4")
    assert_eq(list.get(2), 5 as I64, "original[2] is 5")

    drained.destroy()
    list.destroy()
    return 0
}

@test
func test_drain_from_start() -> I32 {
    let list: List[I32] = List[I32].new(4)
    list.push(10)
    list.push(20)
    list.push(30)

    // Drain from beginning
    let drained: List[I32] = list.drain(0, 2)

    assert_eq(drained.len(), 2 as I64, "drained 2 from start")
    assert_eq(drained.get(0), 10 as I64, "drained[0] is 10")
    assert_eq(drained.get(1), 20 as I64, "drained[1] is 20")

    assert_eq(list.len(), 1 as I64, "original has 1 left")
    assert_eq(list.get(0), 30 as I64, "original[0] is 30")

    drained.destroy()
    list.destroy()
    return 0
}

@test
func test_drain_to_end() -> I32 {
    let list: List[I32] = List[I32].new(4)
    list.push(10)
    list.push(20)
    list.push(30)

    // Drain from index 1 to end
    let drained: List[I32] = list.drain(1, 3)

    assert_eq(drained.len(), 2 as I64, "drained 2 from end")
    assert_eq(drained.get(0), 20 as I64, "drained[0] is 20")
    assert_eq(drained.get(1), 30 as I64, "drained[1] is 30")

    assert_eq(list.len(), 1 as I64, "original has 1 left")
    assert_eq(list.get(0), 10 as I64, "original[0] is 10")

    drained.destroy()
    list.destroy()
    return 0
}
