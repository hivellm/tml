// Tests for BTreeMap implicit drop behavior
use test
use std::collections::BTreeMap

@test
func test_btreemap_create_only() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    Ok(())
}

@test
func test_btreemap_destroy_then_drop() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.destroy()
    Ok(())
}
