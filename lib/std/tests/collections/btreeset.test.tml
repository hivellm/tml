// Tests for std::collections::BTreeSet
use test
use std::collections::BTreeSet

@test
func test_btreeset_create_empty() -> Outcome[Unit, Str] {
    let s: BTreeSet[I64] = BTreeSet[I64]::create()
    assert_true(s.is_empty(), "new set should be empty")
    assert_eq(s.len(), 0 as I64, "len should be 0")
    s.destroy()
    Ok(())
}

@test
func test_btreeset_insert_contains() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    let added1: Bool = s.insert(10)
    let added2: Bool = s.insert(20)
    let added3: Bool = s.insert(30)
    assert_true(added1, "first insert should return true")
    assert_true(added2, "second insert should return true")
    assert_true(added3, "third insert should return true")
    assert_eq(s.len(), 3 as I64, "len should be 3")
    assert_true(s.contains(10), "should contain 10")
    assert_true(s.contains(20), "should contain 20")
    assert_false(s.contains(99), "should not contain 99")
    s.destroy()
    Ok(())
}

@test
func test_btreeset_no_duplicates() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    let first: Bool = s.insert(5)
    let second: Bool = s.insert(5)
    assert_true(first, "first insert should return true")
    assert_false(second, "duplicate insert should return false")
    assert_eq(s.len(), 1 as I64, "len should still be 1")
    s.destroy()
    Ok(())
}

@test
func test_btreeset_remove() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    s.insert(1)
    s.insert(2)
    s.insert(3)
    let removed: Bool = s.remove(2)
    assert_true(removed, "remove(2) should return true")
    assert_eq(s.len(), 2 as I64, "len should be 2")
    assert_false(s.contains(2), "should not contain 2")
    let not_removed: Bool = s.remove(99)
    assert_false(not_removed, "remove(99) should return false")
    s.destroy()
    Ok(())
}

@test
func test_btreeset_min_max() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    s.insert(50)
    s.insert(10)
    s.insert(30)
    assert_eq(s.min(), 10 as I64, "min should be 10")
    assert_eq(s.max(), 50 as I64, "max should be 50")
    s.destroy()
    Ok(())
}

@test
func test_btreeset_clear() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    s.insert(1)
    s.insert(2)
    s.clear()
    assert_true(s.is_empty(), "should be empty after clear")
    assert_eq(s.len(), 0 as I64, "len should be 0 after clear")
    s.destroy()
    Ok(())
}
