// Tests for BTreeSet::drop — Drop behavior triggered by scope exit
use test
use std::collections::BTreeSet

@test
func test_btreeset_drop_empty() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    s.destroy()
    assert_true(true, "BTreeSet::drop (via destroy) should not crash")
    Ok(())
}

@test
func test_btreeset_drop_with_elements() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    s.insert(1)
    s.insert(2)
    s.insert(3)
    s.destroy()
    assert_true(true, "BTreeSet::drop with elements should not crash")
    Ok(())
}

@test
func test_btreeset_scope_drop() -> Outcome[Unit, Str] {
    {
        var s: BTreeSet[I64] = BTreeSet[I64]::create()
        s.insert(10)
        s.insert(20)
    }
    assert_true(true, "BTreeSet scope drop should not crash")
    Ok(())
}
