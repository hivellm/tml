@test
func test_hashmap_default() -> I32 {
    let map: HashMap[I32, I32] = HashMap[I32, I32].default()
    assert_eq(map.len(), 0 as I64, "default hashmap should be empty")
    map.destroy()
    return 0
}

@test
func test_hashmap_index() -> I32 {
    let map: HashMap[I32, I32] = HashMap[I32, I32].new(16)
    map.set(1, 100)
    map.set(2, 200)
    assert_eq(map.index(1), 100, "index key 1")
    assert_eq(map.index(2), 200, "index key 2")
    map.destroy()
    return 0
}

@test
func test_hashmap_duplicate() -> I32 {
    let map: HashMap[I32, I32] = HashMap[I32, I32].new(16)
    map.set(1, 10)
    map.set(2, 20)
    let copy: HashMap[I32, I32] = map.duplicate()
    assert_eq(copy.len(), 2 as I64, "duplicate should have same length")
    assert_eq(copy.get(1), 10, "duplicate key 1")
    assert_eq(copy.get(2), 20, "duplicate key 2")
    copy.destroy()
    map.destroy()
    return 0
}

@test
func test_hashmap_to_string() -> I32 {
    let map: HashMap[I32, I32] = HashMap[I32, I32].new(16)
    map.set(1, 42)
    let s = map.to_string()
    // HashMap iteration order is not guaranteed, but with 1 entry it's deterministic
    assert_eq(s, "{1: 42}", "to_string for single-entry map")
    map.destroy()
    return 0
}

@test
func test_hashmap_debug_string() -> I32 {
    let map: HashMap[I32, I32] = HashMap[I32, I32].new(16)
    map.set(1, 42)
    let s = map.debug_string()
    assert_eq(s, "HashMap{1: 42}", "debug_string for single-entry map")
    map.destroy()
    return 0
}

