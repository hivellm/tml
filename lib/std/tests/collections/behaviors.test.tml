// Tests for std::collections::behaviors module
use test
use test::{assert, assert_eq}
use std::collections::List
use std::collections::HashMap

@test
func test_list_default() -> I32 {
    let list: List[I32] = List[I32].default()
    assert_eq(list.len(), 0 as I64, "default list should be empty")
    list.destroy()
    return 0
}

@test
func test_list_duplicate() -> I32 {
    let list: List[I32] = List[I32].new(4)
    list.push(10)
    list.push(20)
    list.push(30)
    let copy: List[I32] = list.duplicate()
    assert_eq(copy.len(), 3 as I64, "duplicate should have same length")
    assert_eq(copy.get(0 as I64), 10, "duplicate elem 0")
    assert_eq(copy.get(1 as I64), 20, "duplicate elem 1")
    assert_eq(copy.get(2 as I64), 30, "duplicate elem 2")
    copy.destroy()
    list.destroy()
    return 0
}

@test
func test_list_eq_same() -> I32 {
    let a: List[I32] = List[I32].new(4)
    a.push(1)
    a.push(2)
    let b: List[I32] = List[I32].new(4)
    b.push(1)
    b.push(2)
    assert(a.eq(ref b), "identical lists should be equal")
    a.destroy()
    b.destroy()
    return 0
}

@test
func test_list_eq_different() -> I32 {
    let a: List[I32] = List[I32].new(4)
    a.push(1)
    a.push(2)
    let b: List[I32] = List[I32].new(4)
    b.push(1)
    b.push(3)
    assert(not a.eq(ref b), "different lists should not be equal")
    a.destroy()
    b.destroy()
    return 0
}

@test
func test_list_eq_different_length() -> I32 {
    let a: List[I32] = List[I32].new(4)
    a.push(1)
    let b: List[I32] = List[I32].new(4)
    b.push(1)
    b.push(2)
    assert(not a.eq(ref b), "lists with different lengths should not be equal")
    a.destroy()
    b.destroy()
    return 0
}

@test
func test_list_partial_cmp_less() -> I32 {
    let a: List[I32] = List[I32].new(4)
    a.push(1)
    a.push(2)
    let b: List[I32] = List[I32].new(4)
    b.push(1)
    b.push(3)
    let result = a.partial_cmp(ref b)
    assert(result.is_just(), "partial_cmp should return Just")
    a.destroy()
    b.destroy()
    return 0
}

@test
func test_list_cmp_less() -> I32 {
    let a: List[I32] = List[I32].new(4)
    a.push(1)
    a.push(2)
    let b: List[I32] = List[I32].new(4)
    b.push(1)
    b.push(3)
    let result = a.cmp(ref b)
    // Less should be the result since 2 < 3
    a.destroy()
    b.destroy()
    return 0
}

@test
func test_list_cmp_shorter() -> I32 {
    let a: List[I32] = List[I32].new(4)
    a.push(1)
    let b: List[I32] = List[I32].new(4)
    b.push(1)
    b.push(2)
    let result = a.cmp(ref b)
    // shorter list is Less
    a.destroy()
    b.destroy()
    return 0
}

@test
func test_list_to_string() -> I32 {
    let list: List[I32] = List[I32].new(4)
    list.push(1)
    list.push(2)
    list.push(3)
    let s = list.to_string()
    assert_eq(s, "[1, 2, 3]", "to_string format")
    list.destroy()
    return 0
}

@test
func test_list_debug_string() -> I32 {
    let list: List[I32] = List[I32].new(4)
    list.push(1)
    list.push(2)
    let s = list.debug_string()
    assert_eq(s, "List[1, 2]", "debug_string format")
    list.destroy()
    return 0
}

@test
func test_list_hash() -> I32 {
    let a: List[I32] = List[I32].new(4)
    a.push(1)
    a.push(2)
    let b: List[I32] = List[I32].new(4)
    b.push(1)
    b.push(2)
    assert_eq(a.hash(), b.hash(), "equal lists should have equal hashes")
    a.destroy()
    b.destroy()
    return 0
}

@test
func test_list_index() -> I32 {
    let list: List[I32] = List[I32].new(4)
    list.push(10)
    list.push(20)
    list.push(30)
    assert_eq(list.index(0 as I64), 10, "index 0")
    assert_eq(list.index(1 as I64), 20, "index 1")
    assert_eq(list.index(2 as I64), 30, "index 2")
    list.destroy()
    return 0
}

