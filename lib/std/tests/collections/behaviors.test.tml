@test
func test_list_to_string_empty() -> I32 {
    let list: List[I32] = List[I32].new(4)
    assert_eq(list.to_string(), "[]", "empty list to_string")
    list.destroy()
    return 0
}

@test
func test_list_hash_different() -> I32 {
    let a: List[I32] = List[I32].new(4)
    a.push(1)
    a.push(2)
    let b: List[I32] = List[I32].new(4)
    b.push(2)
    b.push(1)
    assert(a.hash() != b.hash(), "different lists should have different hashes")
    a.destroy()
    b.destroy()
    return 0
}
