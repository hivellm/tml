// Tests for BTreeMap range queries and ordered iteration
use test
use std::collections::BTreeMap

@test
func test_btreemap_key_at() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(10, 100)
    m.insert(20, 200)
    m.insert(30, 300)
    assert_eq(m.key_at(0), 10 as I64, "key_at(0) should be 10")
    assert_eq(m.key_at(1), 20 as I64, "key_at(1) should be 20")
    assert_eq(m.key_at(2), 30 as I64, "key_at(2) should be 30")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_value_at() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(10, 100)
    m.insert(20, 200)
    m.insert(30, 300)
    assert_eq(m.value_at(0), 100 as I64, "value_at(0) should be 100")
    assert_eq(m.value_at(1), 200 as I64, "value_at(1) should be 200")
    assert_eq(m.value_at(2), 300 as I64, "value_at(2) should be 300")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_lower_bound() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(10, 100)
    m.insert(20, 200)
    m.insert(30, 300)
    m.insert(40, 400)
    assert_eq(m.lower_bound(10), 0 as I64, "lower_bound(10) -> idx 0")
    assert_eq(m.lower_bound(20), 1 as I64, "lower_bound(20) -> idx 1")
    assert_eq(m.lower_bound(25), 2 as I64, "lower_bound(25) -> idx 2")
    assert_eq(m.lower_bound(40), 3 as I64, "lower_bound(40) -> idx 3")
    assert_eq(m.lower_bound(50), 4 as I64, "lower_bound(50) -> past end")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_upper_bound() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(10, 100)
    m.insert(20, 200)
    m.insert(30, 300)
    m.insert(40, 400)
    assert_eq(m.upper_bound(5), 0 as I64, "upper_bound(5) -> 0")
    assert_eq(m.upper_bound(10), 1 as I64, "upper_bound(10) -> 1")
    assert_eq(m.upper_bound(25), 2 as I64, "upper_bound(25) -> 2")
    assert_eq(m.upper_bound(40), 4 as I64, "upper_bound(40) -> 4")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_range_count() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(10, 100)
    m.insert(20, 200)
    m.insert(30, 300)
    m.insert(40, 400)
    m.insert(50, 500)
    assert_eq(m.range_count(10, 50), 5 as I64, "all elements in range")
    assert_eq(m.range_count(20, 40), 3 as I64, "20..40 -> 3 elements")
    assert_eq(m.range_count(15, 35), 2 as I64, "15..35 -> 20,30")
    assert_eq(m.range_count(60, 100), 0 as I64, "no elements in range")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_range_key_at() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(10, 100)
    m.insert(20, 200)
    m.insert(30, 300)
    m.insert(40, 400)
    assert_eq(m.range_key_at(20, 40, 0), 20 as I64, "first key in [20,40]")
    assert_eq(m.range_key_at(20, 40, 1), 30 as I64, "second key in [20,40]")
    assert_eq(m.range_key_at(20, 40, 2), 40 as I64, "third key in [20,40]")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_range_value_at() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(10, 100)
    m.insert(20, 200)
    m.insert(30, 300)
    m.insert(40, 400)
    assert_eq(m.range_value_at(20, 40, 0), 200 as I64, "first value in [20,40]")
    assert_eq(m.range_value_at(20, 40, 1), 300 as I64, "second value in [20,40]")
    assert_eq(m.range_value_at(20, 40, 2), 400 as I64, "third value in [20,40]")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_ordered_iteration() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(50, 500)
    m.insert(10, 100)
    m.insert(30, 300)
    m.insert(20, 200)
    m.insert(40, 400)
    var sum: I64 = 0
    var i: I64 = 0
    loop (i < m.len()) {
        sum = sum + m.value_at(i)
        i = i + 1
    }
    assert_eq(sum, 1500 as I64, "sum of all values")
    assert_eq(m.key_at(0), 10 as I64, "first key should be 10")
    assert_eq(m.key_at(4), 50 as I64, "last key should be 50")
    m.destroy()
    Ok(())
}
