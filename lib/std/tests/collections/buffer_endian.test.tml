// Tests for Buffer endian read/write: u16, u32, u64 in BE and LE
use test::{assert_eq}
use std::collections::Buffer

@test
func test_buffer_u16_be_roundtrip() -> I32 {
    let buf: Buffer = Buffer.new(16)
    buf.write_u16_be(0x1234 as I32, 0)
    let v: I32 = buf.read_u16_be(0)
    assert_eq(v, 0x1234 as I32, "u16 BE roundtrip")
    buf.destroy()
    return 0
}

@test
func test_buffer_u16_le_roundtrip() -> I32 {
    let buf: Buffer = Buffer.new(16)
    buf.write_u16_le(0xABCD as I32, 0)
    let v: I32 = buf.read_u16_le(0)
    assert_eq(v, 0xABCD as I32, "u16 LE roundtrip")
    buf.destroy()
    return 0
}

@test
func test_buffer_u32_le_roundtrip() -> I32 {
    let buf: Buffer = Buffer.new(16)
    buf.write_u32_le(0xDEADBEEF as I64, 0)
    let v: I64 = buf.read_u32_le(0)
    assert_eq(v, 0xDEADBEEF as I64, "u32 LE roundtrip")
    buf.destroy()
    return 0
}

@test
func test_buffer_u64_le_roundtrip() -> I32 {
    let buf: Buffer = Buffer.new(16)
    buf.write_u64_le(0x0807060504030201 as I64, 0)
    let v: I64 = buf.read_u64_le(0)
    assert_eq(v, 0x0807060504030201 as I64, "u64 LE roundtrip")
    buf.destroy()
    return 0
}

@test
func test_buffer_multiple_offsets() -> I32 {
    let buf: Buffer = Buffer.new(16)
    buf.write_u16_be(0x1122 as I32, 0)
    buf.write_u16_be(0x3344 as I32, 2)
    buf.write_u16_be(0x5566 as I32, 4)
    let a: I32 = buf.read_u16_be(0)
    let b: I32 = buf.read_u16_be(2)
    let c: I32 = buf.read_u16_be(4)
    assert_eq(a, 0x1122 as I32, "offset 0")
    assert_eq(b, 0x3344 as I32, "offset 2")
    assert_eq(c, 0x5566 as I32, "offset 4")
    buf.destroy()
    return 0
}
