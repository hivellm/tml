// Tests for BTreeMapIter — accumulation and range patterns
use test
use std::collections::{BTreeMap, BTreeMapIter}

@test
func test_btreemap_iter_accumulate() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(1, 10)
    m.insert(2, 20)
    m.insert(3, 30)
    m.insert(4, 40)
    m.insert(5, 50)
    var it: BTreeMapIter[I64, I64] = m.iter()
    var key_sum: I64 = 0
    var val_sum: I64 = 0
    var count: I64 = 0
    loop (it.has_next()) {
        key_sum = key_sum + it.key()
        val_sum = val_sum + it.value()
        count = count + 1
        it.next()
    }
    assert_eq(count, 5 as I64, "should count 5 entries")
    assert_eq(key_sum, 15 as I64, "key sum should be 15")
    assert_eq(val_sum, 150 as I64, "value sum should be 150")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_iter_after_insert_remove() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(10, 100)
    m.insert(20, 200)
    m.insert(30, 300)
    m.remove(20)
    var it: BTreeMapIter[I64, I64] = m.iter()
    assert_true(it.has_next(), "should have entry")
    assert_eq(it.key(), 10 as I64, "first key should be 10")
    it.next()
    assert_true(it.has_next(), "should have second entry")
    assert_eq(it.key(), 30 as I64, "second key should be 30")
    it.next()
    assert_false(it.has_next(), "should be exhausted")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_iter_next_past_end_safe() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(1, 10)
    var it: BTreeMapIter[I64, I64] = m.iter()
    it.next()
    it.next()
    assert_false(it.has_next(), "should remain exhausted")
    m.destroy()
    Ok(())
}
