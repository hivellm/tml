// Tests for List::retain — keeps elements matching predicate
use test::{assert, assert_eq}
use std::collections::List

@test
func test_retain_keeps_matching() -> I32 {
    let list: List[I32] = List[I32].new(8)
    list.push(1)
    list.push(2)
    list.push(3)
    list.push(4)
    list.push(5)

    // Keep only elements > 2
    list.retain(do(x: ref I32) *x > 2)

    assert_eq(list.len(), 3 as I64, "should have 3 elements")
    assert_eq(list.get(0), 3 as I64, "first retained is 3")
    assert_eq(list.get(1), 4 as I64, "second retained is 4")
    assert_eq(list.get(2), 5 as I64, "third retained is 5")
    list.destroy()
    return 0
}

@test
func test_retain_removes_all() -> I32 {
    let list: List[I32] = List[I32].new(4)
    list.push(1)
    list.push(2)
    list.push(3)

    // Remove all elements
    list.retain(do(x: ref I32) false)

    assert_eq(list.len(), 0 as I64, "should be empty")
    assert(list.is_empty(), "is_empty after retain-none")
    list.destroy()
    return 0
}

@test
func test_retain_keeps_all() -> I32 {
    let list: List[I32] = List[I32].new(4)
    list.push(10)
    list.push(20)
    list.push(30)

    // Keep all elements
    list.retain(do(x: ref I32) true)

    assert_eq(list.len(), 3 as I64, "should still have 3 elements")
    assert_eq(list.get(0), 10 as I64, "first is 10")
    assert_eq(list.get(1), 20 as I64, "second is 20")
    assert_eq(list.get(2), 30 as I64, "third is 30")
    list.destroy()
    return 0
}
