// Tests for BTreeMapIter — ordered iteration over BTreeMap entries
use test
use std::collections::{BTreeMap, BTreeMapIter}

@test
func test_btreemap_iter_empty() -> Outcome[Unit, Str] {
    let m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    var it: BTreeMapIter[I64, I64] = m.iter()
    assert_false(it.has_next(), "empty map iterator should have no next")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_iter_single() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(42, 420)
    var it: BTreeMapIter[I64, I64] = m.iter()
    assert_true(it.has_next(), "should have first entry")
    assert_eq(it.key(), 42 as I64, "key should be 42")
    assert_eq(it.value(), 420 as I64, "value should be 420")
    it.next()
    assert_false(it.has_next(), "should be exhausted after single entry")
    m.destroy()
    Ok(())
}

@test
func test_btreemap_iter_sorted_order() -> Outcome[Unit, Str] {
    var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::create()
    m.insert(30, 300)
    m.insert(10, 100)
    m.insert(20, 200)
    var it: BTreeMapIter[I64, I64] = m.iter()

    assert_true(it.has_next(), "should have entry 0")
    assert_eq(it.key(), 10 as I64, "first key should be 10")
    assert_eq(it.value(), 100 as I64, "first value should be 100")
    it.next()

    assert_true(it.has_next(), "should have entry 1")
    assert_eq(it.key(), 20 as I64, "second key should be 20")
    assert_eq(it.value(), 200 as I64, "second value should be 200")
    it.next()

    assert_true(it.has_next(), "should have entry 2")
    assert_eq(it.key(), 30 as I64, "third key should be 30")
    assert_eq(it.value(), 300 as I64, "third value should be 300")
    it.next()

    assert_false(it.has_next(), "should be exhausted")
    m.destroy()
    Ok(())
}
