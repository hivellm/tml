// Tests for BTreeSetIter — ordered iteration over BTreeSet elements
use test
use std::collections::{BTreeSet, BTreeSetIter}

@test
func test_btreeset_iter_empty() -> Outcome[Unit, Str] {
    let s: BTreeSet[I64] = BTreeSet[I64]::create()
    var it: BTreeSetIter[I64] = s.iter()
    assert_false(it.has_next(), "empty set iterator should have no next")
    s.destroy()
    Ok(())
}

@test
func test_btreeset_iter_single() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    s.insert(99)
    var it: BTreeSetIter[I64] = s.iter()
    assert_true(it.has_next(), "should have first element")
    assert_eq(it.value(), 99 as I64, "value should be 99")
    it.next()
    assert_false(it.has_next(), "should be exhausted after single element")
    s.destroy()
    Ok(())
}

@test
func test_btreeset_iter_sorted_order() -> Outcome[Unit, Str] {
    var s: BTreeSet[I64] = BTreeSet[I64]::create()
    s.insert(50)
    s.insert(10)
    s.insert(30)
    s.insert(20)
    s.insert(40)
    var it: BTreeSetIter[I64] = s.iter()

    assert_eq(it.value(), 10 as I64, "1st should be 10")
    it.next()
    assert_eq(it.value(), 20 as I64, "2nd should be 20")
    it.next()
    assert_eq(it.value(), 30 as I64, "3rd should be 30")
    it.next()
    assert_eq(it.value(), 40 as I64, "4th should be 40")
    it.next()
    assert_eq(it.value(), 50 as I64, "5th should be 50")
    it.next()

    assert_false(it.has_next(), "should be exhausted after 5 elements")
    s.destroy()
    Ok(())
}
