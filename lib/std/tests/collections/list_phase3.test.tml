// Tests for List[T] Phase 3 — dedup, resize, split_at, sort_by
use test
use std::collections::List

@test
func test_dedup() -> I32 {
    let list = List[I64]::new(8)
    list.push(1)
    list.push(1)
    list.push(2)
    list.push(3)
    list.push(3)
    list.push(3)
    list.push(4)
    list.dedup()
    assert_eq(list.len(), 4)
    assert_eq(list.get(0), 1)
    assert_eq(list.get(1), 2)
    assert_eq(list.get(2), 3)
    assert_eq(list.get(3), 4)
    list.destroy()
    0
}

@test
func test_dedup_no_duplicates() -> I32 {
    let list = List[I64]::new(4)
    list.push(1)
    list.push(2)
    list.push(3)
    list.dedup()
    assert_eq(list.len(), 3)
    list.destroy()
    0
}

@test
func test_dedup_all_same() -> I32 {
    let list = List[I64]::new(4)
    list.push(7)
    list.push(7)
    list.push(7)
    list.dedup()
    assert_eq(list.len(), 1)
    assert_eq(list.get(0), 7)
    list.destroy()
    0
}

@test
func test_resize_grow() -> I32 {
    let list = List[I64]::new(4)
    list.push(1)
    list.push(2)
    list.resize(5, 99)
    assert_eq(list.len(), 5)
    assert_eq(list.get(0), 1)
    assert_eq(list.get(1), 2)
    assert_eq(list.get(2), 99)
    assert_eq(list.get(3), 99)
    assert_eq(list.get(4), 99)
    list.destroy()
    0
}

@test
func test_resize_shrink() -> I32 {
    let list = List[I64]::new(4)
    list.push(1)
    list.push(2)
    list.push(3)
    list.push(4)
    list.resize(2, 0)
    assert_eq(list.len(), 2)
    assert_eq(list.get(0), 1)
    assert_eq(list.get(1), 2)
    list.destroy()
    0
}

@test
func test_split_at() -> I32 {
    let list = List[I64]::new(8)
    list.push(1)
    list.push(2)
    list.push(3)
    list.push(4)
    list.push(5)
    let pair: (List[I64], List[I64]) = list.split_at(2)
    let left: List[I64] = pair.0
    let right: List[I64] = pair.1
    assert_eq(left.len(), 2)
    assert_eq(left.get(0), 1)
    assert_eq(left.get(1), 2)
    assert_eq(right.len(), 3)
    assert_eq(right.get(0), 3)
    assert_eq(right.get(1), 4)
    assert_eq(right.get(2), 5)
    assert_eq(list.len(), 0)
    left.destroy()
    right.destroy()
    list.destroy()
    0
}

@test
func test_sort_by_descending() -> I32 {
    let list = List[I64]::new(4)
    list.push(10)
    list.push(30)
    list.push(20)
    list.push(40)
    // Sort descending: if a > b return -1 (a first), else 1
    list.sort_by(do(a: ref I64, b: ref I64) -> I32 {
        if *a > *b {
            return -1
        }
        if *a < *b {
            return 1
        }
        0
    })
    assert_eq(list.get(0), 40)
    assert_eq(list.get(1), 30)
    assert_eq(list.get(2), 20)
    assert_eq(list.get(3), 10)
    list.destroy()
    0
}
