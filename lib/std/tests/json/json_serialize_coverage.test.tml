@test
func test_pretty_builder_nested_object() -> I32 {
    let b: PrettyBuilder = pretty_object()
    b.k("inner")
    b.obj()
    b.ks("x", "val")
    b.end_obj()
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("val"), "pretty nested object should contain value")
    b.drop()
    return 0
}

@test
func test_pretty_builder_nested_array() -> I32 {
    let b: PrettyBuilder = pretty_object()
    b.k("nums")
    b.arr()
    b.n(1 as I64)
    b.n(2 as I64)
    b.end_arr()
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("nums"), "pretty nested array key should appear")
    b.drop()
    return 0
}
