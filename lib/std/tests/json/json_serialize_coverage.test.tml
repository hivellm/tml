// Tests targeting uncovered functions in json/builder module
// (json/serialize is blocked - trait impls on primitives return () in codegen)
use test
use std::json::builder::{Builder, object, array, PrettyBuilder, pretty_object, pretty_array}

// =============================================================================
// Builder::with_capacity, Builder::n32, Builder::f, Builder::raw, Builder::len
// =============================================================================

@test
func test_builder_with_capacity() -> I32 {
    let b: Builder = Builder::with_capacity(512 as I64)
    b.arr()
    b.n(1 as I64)
    b.end_arr()
    let s: Str = b.build()
    assert(s.len() > 0, "with_capacity builder should produce output")
    b.drop()
    return 0
}

@test
func test_builder_n32() -> I32 {
    let b: Builder = array()
    b.n32(42)
    b.n32(-7)
    b.end_arr()
    let s: Str = b.build()
    assert_eq(s, "[42,-7]", "n32 should add I32 numbers")
    b.drop()
    return 0
}

@test
func test_builder_f() -> I32 {
    let b: Builder = array()
    b.f(3.14)
    b.end_arr()
    let s: Str = b.build()
    assert(s.len() > 3, "f should add float value")
    b.drop()
    return 0
}

@test
func test_builder_kn32() -> I32 {
    let b: Builder = object()
    b.kn32("age", 25)
    b.end_obj()
    let s: Str = b.build()
    assert(s.len() > 0, "kn32 should produce output")
    b.drop()
    return 0
}

@test
func test_builder_kf() -> I32 {
    let b: Builder = object()
    b.kf("pi", 3.14)
    b.end_obj()
    let s: Str = b.build()
    assert(s.len() > 0, "kf should produce output")
    b.drop()
    return 0
}

@test
func test_builder_raw() -> I32 {
    let b: Builder = array()
    b.raw("{\"nested\":true}")
    b.end_arr()
    let s: Str = b.build()
    assert(s.len() > 10, "raw should inject pre-built JSON")
    b.drop()
    return 0
}

@test
func test_builder_len() -> I32 {
    let b: Builder = array()
    b.n(1 as I64)
    let l: I64 = b.len()
    assert(l > 0 as I64, "len should return positive value")
    b.end_arr()
    b.drop()
    return 0
}

// =============================================================================
// Builder — nested objects and arrays
// =============================================================================

@test
func test_builder_nested_object_in_array() -> I32 {
    let b: Builder = array()
    b.obj()
    b.ks("name", "alice")
    b.kn("count", 3 as I64)
    b.end_obj()
    b.end_arr()
    let s: Str = b.build()
    assert(s.contains("alice"), "nested object name should appear")
    assert(s.contains("3"), "nested object count should appear")
    b.drop()
    return 0
}

@test
func test_builder_nested_array_in_object() -> I32 {
    let b: Builder = object()
    b.k("items")
    b.arr()
    b.n(10 as I64)
    b.n(20 as I64)
    b.end_arr()
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("items"), "key 'items' should appear")
    assert(s.contains("10"), "first element should appear")
    b.drop()
    return 0
}

@test
func test_builder_kb_true() -> I32 {
    let b: Builder = object()
    b.kb("active", true)
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("true"), "kb true should write true")
    b.drop()
    return 0
}

@test
func test_builder_kb_false() -> I32 {
    let b: Builder = object()
    b.kb("deleted", false)
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("false"), "kb false should write false")
    b.drop()
    return 0
}

@test
func test_builder_nil_in_array() -> I32 {
    let b: Builder = array()
    b.nil()
    b.n(1 as I64)
    b.end_arr()
    let s: Str = b.build()
    assert(s.contains("null"), "nil should produce null")
    b.drop()
    return 0
}

@test
func test_builder_knil() -> I32 {
    let b: Builder = object()
    b.knil("deleted_at")
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("null"), "knil should produce null value")
    b.drop()
    return 0
}

@test
func test_builder_multiple_keys() -> I32 {
    let b: Builder = object()
    b.ks("name", "bob")
    b.kn("age", 30 as I64)
    b.kb("active", true)
    b.knil("email")
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("bob"), "name should appear")
    assert(s.contains("30"), "age should appear")
    b.drop()
    return 0
}

@test
func test_builder_empty_object() -> I32 {
    let b: Builder = object()
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("{"), "empty object should have opening brace")
    assert(s.contains("}"), "empty object should have closing brace")
    b.drop()
    return 0
}

@test
func test_builder_empty_array() -> I32 {
    let b: Builder = array()
    b.end_arr()
    let s: Str = b.build()
    assert(s.contains("["), "empty array should have opening bracket")
    assert(s.contains("]"), "empty array should have closing bracket")
    b.drop()
    return 0
}

@test
func test_builder_bool_true_in_array() -> I32 {
    let b: Builder = array()
    b.b(true)
    b.b(false)
    b.end_arr()
    let s: Str = b.build()
    assert(s.contains("true"), "true in array")
    assert(s.contains("false"), "false in array")
    b.drop()
    return 0
}

// =============================================================================
// PrettyBuilder methods
// =============================================================================

@test
func test_pretty_array_builder() -> I32 {
    let b: PrettyBuilder = pretty_array()
    b.n(1 as I64)
    b.n(2 as I64)
    b.end_arr()
    let s: Str = b.build()
    assert(s.len() > 0, "pretty_array should produce output")
    b.drop()
    return 0
}

@test
func test_pretty_builder_s() -> I32 {
    let b: PrettyBuilder = pretty_array()
    b.s("hello")
    b.s("world")
    b.end_arr()
    let s: Str = b.build()
    assert(s.len() > 0, "pretty s should produce string values")
    b.drop()
    return 0
}

