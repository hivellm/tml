@test
func test_pretty_builder_kn() -> I32 {
    let b: PrettyBuilder = pretty_object()
    b.kn("total", 999 as I64)
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("999"), "pretty kn should contain the number")
    b.drop()
    return 0
}

@test
func test_pretty_builder_kb() -> I32 {
    let b: PrettyBuilder = pretty_object()
    b.kb("enabled", true)
    b.end_obj()
    let s: Str = b.build()
    assert(s.contains("true"), "pretty kb should contain bool")
