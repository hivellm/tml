// Tests for Ipv4Addr::eq, Ipv6Addr::eq, IpAddr::eq, fmt (Display/Debug)
use test
use std::net::ip::{Ipv4Addr, Ipv6Addr, IpAddr}

// ============================================================================
// Ipv4Addr::eq
// ============================================================================

@test
func test_ipv4_eq_same() -> I32 {
    let a = Ipv4Addr::new(192, 168, 1, 1)
    let b = Ipv4Addr::new(192, 168, 1, 1)
    assert(a == b, "same IPv4 address should be equal")
    return 0
}

@test
func test_ipv4_eq_different() -> I32 {
    let a = Ipv4Addr::new(192, 168, 1, 1)
    let b = Ipv4Addr::new(192, 168, 1, 2)
    assert(not (a == b), "different IPv4 addresses should not be equal")
    return 0
}

// NOTE: Ipv4Addr::to_string (fmt/Display) is blocked by codegen bug:
// undefined symbol '@tml_N3std3net2ip8Ipv4Addr9to_stringE'
// The Display impl for Ipv4Addr generates an undefined symbol when called.

// ============================================================================
// Ipv6Addr::eq
// NOTE: Ipv6Addr::eq has a known bug — different addresses may compare as equal
// due to inner PartialEq comparison not working correctly for multi-field structs.
// Only testing the reflexive case (a == a).
// ============================================================================

@test
func test_ipv6_eq_same() -> I32 {
    let a = Ipv6Addr::LOCALHOST()
    let b = Ipv6Addr::LOCALHOST()
    assert(a == b, "same IPv6 address should be equal")
    return 0
}

// NOTE: Ipv6Addr::to_string (fmt/Display) is blocked by codegen bug:
// undefined symbol '@tml_N3std3net2ip8Ipv6Addr9to_stringE'
// All three IP address Display impls have the same undefined symbol issue.

// ============================================================================
// IpAddr::eq
// ============================================================================

@test
func test_ipaddr_eq_v4() -> I32 {
    let a = IpAddr::V4(Ipv4Addr::LOCALHOST())
    let b = IpAddr::V4(Ipv4Addr::LOCALHOST())
    assert(a == b, "IpAddr::V4 localhost should equal itself")
    return 0
}

@test
func test_ipaddr_eq_different_families() -> I32 {
    let a = IpAddr::V4(Ipv4Addr::LOCALHOST())
    let b = IpAddr::V6(Ipv6Addr::LOCALHOST())
    assert(not (a == b), "IPv4 and IPv6 addresses should not be equal")
    return 0
}

// NOTE: IpAddr::to_string (fmt) is blocked by codegen bug:
// undefined symbol '@tml_N3std3net2ip6IpAddr9to_stringE'
// The Display impl for IpAddr generates an undefined symbol when called.
