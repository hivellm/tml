@test
func test_tcp_stream_as_raw_socket() -> I32 {
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::LOCALHOST(), 0 as U16))
    let bind_result = TcpListener::bind(addr)
    when bind_result {
        Ok(listener) => {
            let local = listener.local_addr()
            when local {
                Ok(local_addr) => {
                    let conn = TcpStream::connect(local_addr)
                    when conn {
                        Ok(stream) => {
                            let raw = stream.as_raw_socket()
                            assert(raw.is_valid(), "stream raw socket should be valid")
                        },
                        Err(_) => {},
                    }
                },
                Err(_) => {},
            }
        },
        Err(_) => {},
    }
    return 0
}
