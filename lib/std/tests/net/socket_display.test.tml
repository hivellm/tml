// Tests for SocketAddrV4/V6/SocketAddr Display (to_string) and Debug (debug_string)
use test::{assert, assert_eq}
use std::net::socket::{SocketAddrV4, SocketAddrV6, SocketAddr}
use std::net::ip::{Ipv4Addr, Ipv6Addr}

@test
func test_socket_addr_v4_to_string() -> I32 {
    let addr = SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), 8080 as U16)
    let s = addr.to_string()
    assert_eq(s, "127.0.0.1:8080", "SocketAddrV4 to_string")
    return 0
}

@test
func test_socket_addr_v4_debug_string() -> I32 {
    let addr = SocketAddrV4::new(Ipv4Addr::new(192, 168, 1, 1), 443 as U16)
    let s = addr.debug_string()
    assert_eq(s, "192.168.1.1:443", "SocketAddrV4 debug_string")
    return 0
}

@test
func test_socket_addr_to_string() -> I32 {
    let v4 = SocketAddrV4::new(Ipv4Addr::new(10, 0, 0, 1), 3000 as U16)
    let addr = SocketAddr::V4(v4)
    let s = addr.to_string()
    assert_eq(s, "10.0.0.1:3000", "SocketAddr to_string")
    return 0
}
