// Tests for UdpSocket timeout methods:
// - set_read_timeout / read_timeout
// - set_write_timeout / write_timeout
// Using the same pattern as tcp_timeout.test.tml (Just(Duration))
use test::{assert, assert_eq}
use std::net::{SocketAddr, SocketAddrV4}
use std::net::ip::Ipv4Addr
use std::net::udp::UdpSocket
use core::time::Duration

// === set_read_timeout and read_timeout ===

@test
func test_udp_set_read_timeout() -> I32 {
    let v4 = SocketAddrV4::new(Ipv4Addr::LOCALHOST(), 0 as U16)
    let addr = SocketAddr::V4(v4)
    let sock = UdpSocket::bind(addr).unwrap()
    let timeout = Duration::from_millis(500)
    let set_result = sock.set_read_timeout(Just(timeout))
    assert(set_result.is_ok(), "set_read_timeout should succeed")
    let get_result = sock.read_timeout()
    assert(get_result.is_ok(), "read_timeout should succeed")
    return 0
}

// === set_write_timeout and write_timeout ===

@test
func test_udp_set_write_timeout() -> I32 {
    let v4 = SocketAddrV4::new(Ipv4Addr::LOCALHOST(), 0 as U16)
    let addr = SocketAddr::V4(v4)
    let sock = UdpSocket::bind(addr).unwrap()
    let timeout = Duration::from_millis(500)
    let set_result = sock.set_write_timeout(Just(timeout))
    assert(set_result.is_ok(), "set_write_timeout should succeed")
    let get_result = sock.write_timeout()
    assert(get_result.is_ok(), "write_timeout should succeed")
    return 0
}
