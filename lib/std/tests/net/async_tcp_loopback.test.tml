// ============================================================================
// from_std conversion
// ============================================================================

@test
func test_async_tcp_listener_from_std() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sync_listener: TcpListener = TcpListener::bind(addr).unwrap()
    let async_listener: AsyncTcpListener = AsyncTcpListener::from_std(sync_listener).unwrap()
    let bound: SocketAddr = async_listener.local_addr().unwrap()
    assert(bound.port() as I32 > 0, "from_std listener should have valid port")
    return 0
}

@test
func test_async_tcp_stream_from_std() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: TcpListener = TcpListener::bind(addr).unwrap()
    let bound: SocketAddr = listener.local_addr().unwrap()
    let sync_stream: TcpStream = TcpStream::connect(bound).unwrap()
    let async_stream: AsyncTcpStream = AsyncTcpStream::from_std(sync_stream).unwrap()
    let local: SocketAddr = async_stream.local_addr().unwrap()
    assert(local.port() as I32 > 0, "from_std stream should have valid port")
    return 0
}