// Tests for async_tcp module — loopback tests
use test::{assert, assert_eq}
use std::net::{SocketAddr, SocketAddrV4, Ipv4Addr}
use std::net::async_tcp::{AsyncTcpListener, AsyncTcpStream}
use std::net::tcp::{TcpListener, TcpStream}
use std::net::sys::{ShutdownMode, RawSocket}

// ============================================================================
// AsyncTcpListener
// ============================================================================

@test
func test_async_tcp_bind_and_local_addr() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: AsyncTcpListener = AsyncTcpListener::bind(addr).unwrap()
    let bound: SocketAddr = listener.local_addr().unwrap()
    assert(bound.port() as I32 > 0, "should bind to ephemeral port")
    return 0
}

@test
func test_async_tcp_set_reuse_addr() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: AsyncTcpListener = AsyncTcpListener::bind(addr).unwrap()
    listener.set_reuse_addr(true).unwrap()
    assert(true, "set_reuse_addr should succeed")
    return 0
}

@test
func test_async_tcp_listener_socket_handle() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: AsyncTcpListener = AsyncTcpListener::bind(addr).unwrap()
    let handle: I64 = listener.socket_handle()
    assert(handle != 0, "socket_handle should be non-zero")
    return 0
}

