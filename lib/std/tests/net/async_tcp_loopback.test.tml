func test_async_tcp_stream_shutdown() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: AsyncTcpListener = AsyncTcpListener::bind(addr).unwrap()
    let bound: SocketAddr = listener.local_addr().unwrap()
    let client: AsyncTcpStream = AsyncTcpStream::connect(bound).unwrap()
    client.shutdown(ShutdownMode::Both).unwrap()
    assert(true, "shutdown should succeed")
    return 0
}

// ============================================================================
// AsyncTcpListener + AsyncTcpStream — accept and I/O
// ============================================================================

@test
func test_async_tcp_try_accept_nothing() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: AsyncTcpListener = AsyncTcpListener::bind(addr).unwrap()
    let result = listener.try_accept().unwrap()
    assert(result.is_nothing(), "try_accept with no client should be Nothing")
    return 0
}

@test
func test_async_tcp_accept_loopback() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: AsyncTcpListener = AsyncTcpListener::bind(addr).unwrap()
    let bound: SocketAddr = listener.local_addr().unwrap()
    let client: AsyncTcpStream = AsyncTcpStream::connect(bound).unwrap()
    when listener.accept() {
        Ok(result) => assert(true, "accept succeeded")
        Err(_) => assert(false, "accept should succeed on loopback")
    }
    return 0
}

@test
func test_async_tcp_stream_peer_addr() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: AsyncTcpListener = AsyncTcpListener::bind(addr).unwrap()
    let bound: SocketAddr = listener.local_addr().unwrap()
    let client: AsyncTcpStream = AsyncTcpStream::connect(bound).unwrap()
    when listener.accept() {
        Ok(result) => {
            let server: AsyncTcpStream = result.0
            let peer: SocketAddr = server.peer_addr().unwrap()
            assert(peer.port() as I32 > 0, "server should see client peer port")
        }
        Err(_) => assert(false, "accept should succeed")
    }
    return 0
}

@test
func test_async_tcp_stream_write_read() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: AsyncTcpListener = AsyncTcpListener::bind(addr).unwrap()
    let bound: SocketAddr = listener.local_addr().unwrap()
    let client: AsyncTcpStream = AsyncTcpStream::connect(bound).unwrap()
    when listener.accept() {
        Ok(result) => {
            let server: AsyncTcpStream = result.0
            let data: [U8; 5] = [104 as U8, 101 as U8, 108 as U8, 108 as U8, 111 as U8]
            let sent = client.try_write(ref data).unwrap()
            assert(sent.is_just(), "try_write should succeed on loopback")
            var buf: [U8; 32] = [0 as U8; 32]
            var attempts: I32 = 0
            var read_result = server.try_read(mut ref buf).unwrap()
            loop (read_result.is_nothing() and attempts < 10000) {
                read_result = server.try_read(mut ref buf).unwrap()
                attempts = attempts + 1
            }
            assert(read_result.is_just(), "try_read should eventually get data")
        }
        Err(_) => assert(false, "accept should succeed")
    }
    return 0
}

@test
func test_async_tcp_stream_blocking_write_read() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let listener: AsyncTcpListener = AsyncTcpListener::bind(addr).unwrap()
    let bound: SocketAddr = listener.local_addr().unwrap()
    let client: AsyncTcpStream = AsyncTcpStream::connect(bound).unwrap()
    when listener.accept() {
        Ok(result) => {
            let server: AsyncTcpStream = result.0
            let data: [U8; 3] = [65 as U8, 66 as U8, 67 as U8]
            let sent: I64 = client.write(ref data).unwrap()
            assert_eq(sent as I32, 3)
            var buf: [U8; 32] = [0 as U8; 32]
            let received: I64 = server.read(mut ref buf).unwrap()
            assert_eq(received as I32, 3)
            assert_eq(buf[0] as I32, 65)
        }
        Err(_) => assert(false, "accept should succeed")
    }
    return 0
}

