// Tests for async_udp module — loopback tests
use test::{assert}
use std::net::{SocketAddr, SocketAddrV4, Ipv4Addr}
use std::net::async_udp::{AsyncUdpSocket, UdpHandle}
use std::net::udp::UdpSocket
use std::net::sys::RawSocket
use std::aio::event_loop::EventLoop

// ============================================================================
// AsyncUdpSocket — bind and query
// ============================================================================

@test
func test_async_udp_bind_and_local_addr() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let bound: SocketAddr = sock.local_addr().unwrap()
    assert(bound.port() as I32 > 0, "should bind to ephemeral port")
    return 0
}

@test
func test_async_udp_socket_handle() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let handle: I64 = sock.socket_handle()
    assert(handle != 0, "socket_handle should be non-zero")
    return 0
}

@test
func test_async_udp_is_connected_false() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    assert(not sock.is_connected(), "should not be connected initially")
    return 0
}

@test
func test_async_udp_set_broadcast() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    sock.set_broadcast(true).unwrap()
    assert(true, "set_broadcast should succeed")
    return 0
}

@test
func test_async_udp_connect() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    var sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let bound: SocketAddr = sock.local_addr().unwrap()
    sock.connect(bound).unwrap()
    assert(sock.is_connected(), "should be connected after connect")
    return 0
}

@test
func test_async_udp_peer_addr_after_connect() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    var sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let bound: SocketAddr = sock.local_addr().unwrap()
    sock.connect(bound).unwrap()
    let peer: SocketAddr = sock.peer_addr().unwrap()
    assert(peer.port() as I32 > 0, "peer should have port after connect")
    return 0
}

@test
func test_async_udp_peer_addr_not_connected() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    when sock.peer_addr() {
        Ok(_) => assert(false, "peer_addr should fail when not connected")
        Err(_) => assert(true, "peer_addr returns error when not connected")
    }
    return 0
}

@test
func test_async_udp_into_raw_socket() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let raw = sock.into_raw_socket()
    assert(true, "into_raw_socket should succeed")
    return 0
}

@test
func test_async_udp_try_send_not_connected() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let data: [U8; 3] = [1 as U8, 2 as U8, 3 as U8]
    when sock.try_send(ref data) {
        Ok(_) => assert(false, "try_send should fail when not connected")
        Err(_) => assert(true, "try_send returns error when not connected")
    }
    return 0
}

@test
func test_async_udp_try_recv_not_connected() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    var buf: [U8; 32] = [0 as U8; 32]
    when sock.try_recv(mut ref buf) {
        Ok(_) => assert(false, "try_recv should fail when not connected")
        Err(_) => assert(true, "try_recv returns error when not connected")
    }
    return 0
}

@test
func test_async_udp_try_send_to() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let bound: SocketAddr = sock.local_addr().unwrap()
    let data: [U8; 3] = [1 as U8, 2 as U8, 3 as U8]
    let result = sock.try_send_to(ref data, bound).unwrap()
    assert(result.is_just(), "try_send_to to self should succeed")
    return 0
}

@test
func test_async_udp_try_recv_from() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let bound: SocketAddr = sock.local_addr().unwrap()
    // Send to self first
    let data: [U8; 3] = [10 as U8, 20 as U8, 30 as U8]
    sock.try_send_to(ref data, bound).unwrap()
    // Now try to receive
    var buf: [U8; 32] = [0 as U8; 32]
    var attempts: I32 = 0
    var result = sock.try_recv_from(mut ref buf).unwrap()
    loop (result.is_nothing() and attempts < 10000) {
        result = sock.try_recv_from(mut ref buf).unwrap()
        attempts = attempts + 1
    }
    assert(result.is_just(), "try_recv_from should receive sent data")
    return 0
}

@test
func test_async_udp_send_to_recv_from() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let bound: SocketAddr = sock.local_addr().unwrap()
    let data: [U8; 2] = [42 as U8, 43 as U8]
    let sent: I64 = sock.send_to(ref data, bound).unwrap()
    assert(sent as I32 == 2, "send_to should send 2 bytes")
    var buf: [U8; 32] = [0 as U8; 32]
    let result: (I64, SocketAddr) = sock.recv_from(mut ref buf).unwrap()
    assert(result.0 as I32 == 2, "recv_from should receive 2 bytes")
    return 0
}

@test
func test_async_udp_connected_send_recv() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    var sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let bound: SocketAddr = sock.local_addr().unwrap()
    sock.connect(bound).unwrap()
    let data: [U8; 2] = [1 as U8, 2 as U8]
    let sent: I64 = sock.send(ref data).unwrap()
    assert(sent as I32 == 2, "connected send should work")
    var buf: [U8; 32] = [0 as U8; 32]
    let received: I64 = sock.recv(mut ref buf).unwrap()
    assert(received as I32 == 2, "connected recv should work")
    return 0
}

@test
func test_async_udp_as_raw_socket() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let raw: ref RawSocket = sock.as_raw_socket()
    assert(raw.handle != 0, "as_raw_socket should return valid ref")
    return 0
}

@test
func test_async_udp_from_std() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sync_sock: UdpSocket = UdpSocket::bind(addr).unwrap()
    let async_sock: AsyncUdpSocket = AsyncUdpSocket::from_std(sync_sock).unwrap()
    let bound: SocketAddr = async_sock.local_addr().unwrap()
    assert(bound.port() as I32 > 0, "from_std should have valid port")
    return 0
}

@test
func test_udp_socket_from_raw_socket() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let raw: RawSocket = sock.into_raw_socket()
    let restored: UdpSocket = UdpSocket::from_raw_socket(raw)
    assert(true, "from_raw_socket should succeed")
    return 0
}

// ============================================================================
// EventLoop integration
// ============================================================================

@test
func test_async_udp_register_with_loop() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    var el: EventLoop = EventLoop::new()
    let token: U32 = sock.register_with_loop(mut ref el, 1 as U32).unwrap()
    assert(true, "register_with_loop should succeed")
    return 0
}

@test
func test_async_udp_unregister_from_loop() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    var el: EventLoop = EventLoop::new()
    let token: U32 = sock.register_with_loop(mut ref el, 3 as U32).unwrap()
    sock.unregister_from_loop(mut ref el, token)
    assert(true, "unregister_from_loop should succeed")
    return 0
}

// ============================================================================
// UdpHandle
// ============================================================================

@test
func test_udp_handle_bind() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    var handle: UdpHandle = UdpHandle::bind(0, addr).unwrap()
    assert(true, "UdpHandle::bind should succeed")
    return 0
}

@test
func test_udp_handle_set_callbacks() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    var handle: UdpHandle = UdpHandle::bind(0, addr).unwrap()
    handle.set_on_message(12345)
    handle.set_on_error(67890)
    assert(true, "set_on_message and set_on_error should succeed")
    return 0
}

@test
func test_udp_handle_send_to() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    let sock: AsyncUdpSocket = AsyncUdpSocket::bind(addr).unwrap()
    let bound: SocketAddr = sock.local_addr().unwrap()
    var handle: UdpHandle = UdpHandle::bind(0, addr).unwrap()
    let data: [U8; 3] = [1 as U8, 2 as U8, 3 as U8]
    let sent: Bool = handle.send_to(ref data, bound)
    // May or may not send since we're sending to a different socket
    assert(true, "UdpHandle::send_to should not crash")
    return 0
}

@test
func test_udp_handle_register_and_close() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    var handle: UdpHandle = UdpHandle::bind(0, addr).unwrap()
    var el: EventLoop = EventLoop::new()
    let token: U32 = handle.register(mut ref el)
    handle.close(mut ref el)
    assert(true, "register + close should succeed")
    return 0
}

@test
func test_udp_handle_destroy() -> I32 {
    let lo: Ipv4Addr = Ipv4Addr::LOCALHOST()
    let addr: SocketAddr = SocketAddr::V4(SocketAddrV4::new(lo, 0 as U16))
    var handle: UdpHandle = UdpHandle::bind(0, addr).unwrap()
    handle.destroy()
    assert(true, "destroy should succeed")
    return 0
}
