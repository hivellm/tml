// Tests for Ipv4Addr::to_string (Display impl)
// Fixed: Display impl was using Rust-style fmt(Formatter) instead of TML to_string() pattern
use test::{assert_eq}
use std::net::ip::Ipv4Addr

@test
func test_ipv4_display_localhost() -> I32 {
    let addr = Ipv4Addr::new(127, 0, 0, 1)
    let s = addr.to_string()
    assert_eq(s, "127.0.0.1", "localhost display")
    return 0
}

@test
func test_ipv4_display_unspecified() -> I32 {
    let addr = Ipv4Addr::UNSPECIFIED()
    assert_eq(addr.to_string(), "0.0.0.0", "unspecified display")
    return 0
}

@test
func test_ipv4_display_broadcast() -> I32 {
    let addr = Ipv4Addr::BROADCAST()
    assert_eq(addr.to_string(), "255.255.255.255", "broadcast display")
    return 0
}
