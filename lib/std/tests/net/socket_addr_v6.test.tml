// Tests for SocketAddr::V6 constructor
// PARTIALLY UNBLOCKED: SocketAddr::V6 constructor works (preserves port),
// but full IPv6 support is pending (stores as V4 internally).
// See: socket_remaining_coverage.test.tml (test_socket_addr_v6_constructor_preserves_port)
use test::{assert, assert_eq}
use std::net::ip::Ipv6Addr
use std::net::socket::{SocketAddrV6, SocketAddr}

@test
func test_socket_addr_v6_port_preserved() -> I32 {
    let v6 = SocketAddrV6::new(Ipv6Addr::LOCALHOST(), 4000 as U16, 0 as U32, 0 as U32)
    let addr = SocketAddr::V6(v6)
    assert_eq(addr.port() as I32, 4000, "V6 constructor should preserve port")
    return 0
}
