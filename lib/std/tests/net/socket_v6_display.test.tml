// Tests for SocketAddrV6 display and SocketAddr debug_string
use test::{assert, assert_eq}
use std::net::socket::{SocketAddrV4, SocketAddrV6, SocketAddr}
use std::net::ip::{Ipv4Addr, Ipv6Addr}

@test
func test_socket_addr_v6_to_string() -> I32 {
    let v6 = SocketAddrV6::new(Ipv6Addr::LOCALHOST(), 9090 as U16, 0 as U32, 0 as U32)
    let s = v6.to_string()
    assert_eq(s, "[0:0:0:0:0:0:0:1]:9090", "SocketAddrV6 to_string")
    return 0
}

@test
func test_socket_addr_v6_debug_string() -> I32 {
    let v6 = SocketAddrV6::new(Ipv6Addr::LOCALHOST(), 443 as U16, 0 as U32, 0 as U32)
    let s = v6.debug_string()
    assert_eq(s, "[0:0:0:0:0:0:0:1]:443", "SocketAddrV6 debug_string")
    return 0
}

@test
func test_socket_addr_debug_string() -> I32 {
    let v4 = SocketAddrV4::new(Ipv4Addr::new(10, 0, 0, 1), 3000 as U16)
    let addr = SocketAddr::V4(v4)
    let s = addr.debug_string()
    assert_eq(s, "10.0.0.1:3000", "SocketAddr debug_string")
    return 0
}
