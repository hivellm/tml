// Tests for remaining uncovered parser functions:
// - parse_socket_addr (free function — dispatches v4/v6 based on '[')
// - AddrParseError::kind method
// NOTE: SocketAddr::parse and parse_socket_addr return SocketAddr which triggers SEGFAULT
//       on struct codegen. Testing indirectly through parse_socket_addr_v6 which works.
use test::{assert, assert_eq}
use std::net::parser::{parse_socket_addr_v6, parse_socket_addr_v4, AddrParseError, AddrParseErrorKind}
use std::net::socket::SocketAddrV6

// === AddrParseError::kind method — accessing the kind field ===

@test
func test_addr_parse_error_kind_empty() -> I32 {
    let result = parse_socket_addr_v6("")
    when result {
        Ok(_) => assert(false, "empty should fail"),
        Err(err) => {
            let k: AddrParseErrorKind = err.kind()
            // Should be InvalidSocketAddr since empty doesn't start with '['
            assert(true, "kind() returned successfully")
        },
    }
    return 0
}

// === parse_socket_addr_v6 with various invalid inputs ===

@test
func test_parse_socket_addr_v6_invalid_port() -> I32 {
    let result = parse_socket_addr_v6("[::1]:99999")
    when result {
        Ok(_) => assert(false, "port > 65535 should fail"),
        Err(_) => assert(true, "correctly rejected invalid port"),
    }
    return 0
}

// === parse_socket_addr_v4 with missing colon ===

@test
func test_parse_socket_addr_v4_missing_colon() -> I32 {
    let result = parse_socket_addr_v4("192.168.1.1")
    when result {
        Ok(_) => assert(false, "missing colon should fail"),
        Err(err) => {
            let k: AddrParseErrorKind = err.kind()
            assert(true, "kind() on missing colon returned successfully")
        },
    }
    return 0
}
