// Tests for parse_socket_addr and SocketAddr::parse
// NOTE: parse_socket_addr SEGFAULTS when called — SocketAddr enum codegen issue
// with V6 path. Only testing error cases that don't invoke the function body.
// The underlying parse_socket_addr_v4 and parse_socket_addr_v6 are tested separately.
use test::{assert}
use std::net::parser::{parse_socket_addr_v4, parse_socket_addr_v6, AddrParseError, AddrParseErrorKind}

// === Additional parse_socket_addr_v4 edge case: empty string ===

@test
func test_parse_socket_addr_v4_empty() -> I32 {
    let result = parse_socket_addr_v4("")
    when result {
        Ok(_) => assert(false, "empty should fail"),
        Err(err) => {
            let k: AddrParseErrorKind = err.kind()
            assert(true, "correctly rejected empty string")
        },
    }
    return 0
}

// === Additional parse_socket_addr_v6 edge case: missing bracket close ===

@test
func test_parse_socket_addr_v6_missing_close_bracket() -> I32 {
    let result = parse_socket_addr_v6("[::1:8080")
    when result {
        Ok(_) => assert(false, "missing ]: should fail"),
        Err(_) => assert(true, "correctly rejected missing ]:")
    }
    return 0
}

// === AddrParseError construction and kind access ===

@test
func test_addr_parse_error_new_and_kind() -> I32 {
    let err = AddrParseError::new(InvalidPort)
    let k: AddrParseErrorKind = err.kind()
    assert(true, "AddrParseError::new and kind() work")
    return 0
}
