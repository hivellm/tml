/// Tests for protobuf oneof descriptor and proto3 last-one-wins semantics.
///
/// Covers phase1a items 4.1-4.5:
///   - OneofDescriptor and MessageDescriptor.oneof_groups
///   - oneof_field() + oneof_index tracking
///   - parse_oneof() populates oneof_groups
///   - runtime "only one set" encode semantics via optional fields
///   - last-one-wins decode semantics

use test::*
use std::protobuf::{
    ProtoWriter, ProtoReader,
    FieldType, FieldDescriptor, MessageDescriptor, OneofDescriptor,
    scalar_field, oneof_field,
}
use std::protobuf::proto_parser::{ProtoFile, parse_proto}
use std::collections::Buffer

@test func test_oneof_descriptor_round_trip() {
    var msg = MessageDescriptor::new("Contact")
    // Non-oneof field first.
    msg.add_field(scalar_field("id", 1, FieldType::Int64))
    // Create a oneof group and register two member fields.
    let idx = msg.add_oneof("identifier")
    let email_f = oneof_field("email", 2, FieldType::String, idx)
    let phone_f = oneof_field("phone", 3, FieldType::String, idx)
    msg.add_field(email_f)
    msg.add_oneof_member(idx, 2)
    msg.add_field(phone_f)
    msg.add_oneof_member(idx, 3)

    assert_eq(msg.oneof_groups.len(), 1)
    let g: OneofDescriptor = msg.oneof_groups.get(0)
    assert_eq(g.name, "identifier")
    assert_eq(g.field_numbers.len(), 2)
    assert_eq(g.field_numbers.get(0), 2)
    assert_eq(g.field_numbers.get(1), 3)

    // Non-oneof field has oneof_index = -1.
    let id_field: FieldDescriptor = msg.fields.get(0)
    assert_eq(id_field.oneof_index, -1)

    // Oneof fields carry the group index.
    let email_field: FieldDescriptor = msg.fields.get(1)
    assert_eq(email_field.oneof_index, idx)
    let phone_field: FieldDescriptor = msg.fields.get(2)
    assert_eq(phone_field.oneof_index, idx)
}

@test func test_parse_oneof_populates_groups() {
    let src: Str = "syntax = \"proto3\";\nmessage Sample { oneof choice { string name = 1; int32 tag = 2; } }\n"
    let parsed = parse_proto(src)
    assert_eq(parsed.messages.len(), 1)

    let m: MessageDescriptor = parsed.messages.get(0)
    assert_eq(m.name, "Sample")
    assert_eq(m.oneof_groups.len(), 1)

    let g: OneofDescriptor = m.oneof_groups.get(0)
    assert_eq(g.name, "choice")
    assert_eq(g.field_numbers.len(), 2)

    assert_eq(m.fields.len(), 2)
    let f0: FieldDescriptor = m.fields.get(0)
    assert_eq(f0.name, "name")
    assert_eq(f0.oneof_index, 0)
    let f1: FieldDescriptor = m.fields.get(1)
    assert_eq(f1.name, "tag")
    assert_eq(f1.oneof_index, 0)
}

@test func test_oneof_encode_only_set_field() {
    // Mirror a message with a 2-field oneof — only write the "set" branch.
    var w = ProtoWriter::new()
    // Simulate: Contact { email = "a@b" } — email is field 2, phone is field 3.
    w.write_field_string(2, "a@b")

    let wb: Buffer = w.to_buffer()
    var r = ProtoReader::from_buffer(ref wb)
    let tag = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(tag.field_num, 2)
    let s = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(s, "a@b")
    assert(not r.has_more(), "single oneof branch, no trailing bytes")
}

@test func test_oneof_last_one_wins_on_decode() {
    // Write two different branches of a oneof. Per proto3 spec, the decoder
    // takes the LAST one.
    var w = ProtoWriter::new()
    w.write_field_string(2, "first@a.com")
    w.write_field_string(3, "+1-555-0123")

    let wb: Buffer = w.to_buffer()
    var r = ProtoReader::from_buffer(ref wb)

    var last_field: I64 = 0
    var last_value: Str = ""
    loop (r.has_more()) {
        let tag = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
        let v = when r.read_string() { Ok(s) => s, Err(e) => { assert(false, e); return } }
        last_field = tag.field_num
        last_value = v
    }
    assert_eq(last_field, 3)
    assert_eq(last_value, "+1-555-0123")
}
