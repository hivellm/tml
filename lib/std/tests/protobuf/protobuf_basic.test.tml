// Tests for protobuf module — zigzag encoding, varint, and basic field encoding
use test
use std::protobuf::{ProtoWriter, ProtoReader, ProtoTag, zigzag_encode, zigzag_decode}
use std::collections::Buffer

// =============================================================================
// Zigzag encoding
// =============================================================================

@test
func test_zigzag_encode_zero() -> I32 {
    assert_eq(zigzag_encode(0), 0, "zigzag(0) = 0")
    return 0
}

@test
func test_zigzag_encode_neg1() -> I32 {
    assert_eq(zigzag_encode(-1), 1, "zigzag(-1) = 1")
    return 0
}

@test
func test_zigzag_encode_pos1() -> I32 {
    assert_eq(zigzag_encode(1), 2, "zigzag(1) = 2")
    return 0
}

@test
func test_zigzag_encode_neg2() -> I32 {
    assert_eq(zigzag_encode(-2), 3, "zigzag(-2) = 3")
    return 0
}

@test
func test_zigzag_encode_pos2() -> I32 {
    assert_eq(zigzag_encode(2), 4, "zigzag(2) = 4")
    return 0
}

@test
func test_zigzag_roundtrip() -> I32 {
    assert_eq(zigzag_decode(zigzag_encode(0)), 0, "roundtrip 0")
    assert_eq(zigzag_decode(zigzag_encode(-1)), -1, "roundtrip -1")
    assert_eq(zigzag_decode(zigzag_encode(1)), 1, "roundtrip 1")
    assert_eq(zigzag_decode(zigzag_encode(-100)), -100, "roundtrip -100")
    assert_eq(zigzag_decode(zigzag_encode(100)), 100, "roundtrip 100")
    return 0
}

@test
func test_zigzag_decode_values() -> I32 {
    assert_eq(zigzag_decode(0), 0, "decode 0 -> 0")
    assert_eq(zigzag_decode(1), -1, "decode 1 -> -1")
    assert_eq(zigzag_decode(2), 1, "decode 2 -> 1")
    assert_eq(zigzag_decode(3), -2, "decode 3 -> -2")
    assert_eq(zigzag_decode(4), 2, "decode 4 -> 2")
    return 0
}

// =============================================================================
// Varint encoding/decoding
// =============================================================================

@test
func test_varint_zero() -> I32 {
    var w: ProtoWriter = ProtoWriter::new()
    w.write_varint(0)
    let buf: Buffer = w.to_buffer()
    assert_eq(buf.len(), 1, "varint 0 = 1 byte")
    assert_eq(buf.read_u8(0), 0, "varint 0 = 0x00")
    return 0
}

@test
func test_varint_one() -> I32 {
    var w: ProtoWriter = ProtoWriter::new()
    w.write_varint(1)
    let buf: Buffer = w.to_buffer()
    assert_eq(buf.len(), 1, "varint 1 = 1 byte")
    assert_eq(buf.read_u8(0), 1, "varint 1 = 0x01")
    return 0
}

@test
func test_varint_127() -> I32 {
    var w: ProtoWriter = ProtoWriter::new()
    w.write_varint(127)
    let buf: Buffer = w.to_buffer()
    assert_eq(buf.len(), 1, "varint 127 = 1 byte")
    assert_eq(buf.read_u8(0), 127, "varint 127 = 0x7F")
    return 0
}

@test
func test_varint_128() -> I32 {
    var w: ProtoWriter = ProtoWriter::new()
    w.write_varint(128)
    let buf: Buffer = w.to_buffer()
    assert_eq(buf.len(), 2, "varint 128 = 2 bytes")
    assert_eq(buf.read_u8(0), 0x80, "first byte 0x80")
    assert_eq(buf.read_u8(1), 0x01, "second byte 0x01")
    return 0
}

@test
func test_varint_300() -> I32 {
    // 300 = 0b100101100
    // LEB128: 10101100 00000010 = 0xAC 0x02
    var w: ProtoWriter = ProtoWriter::new()
    w.write_varint(300)
    let buf: Buffer = w.to_buffer()
    assert_eq(buf.len(), 2, "varint 300 = 2 bytes")
    assert_eq(buf.read_u8(0), 0xAC, "first byte 0xAC")
    assert_eq(buf.read_u8(1), 0x02, "second byte 0x02")
    return 0
}

@test
func test_varint_150() -> I32 {
    // 150 in varint = 0x96 0x01 (from protobuf docs)
    var w: ProtoWriter = ProtoWriter::new()
    w.write_varint(150)
    let buf: Buffer = w.to_buffer()
    assert_eq(buf.len(), 2, "varint 150 = 2 bytes")
    assert_eq(buf.read_u8(0), 0x96, "first byte")
    assert_eq(buf.read_u8(1), 0x01, "second byte")
    return 0
}

@test
func test_varint_roundtrip() -> I32 {
    var w: ProtoWriter = ProtoWriter::new()
    w.write_varint(0)
    w.write_varint(1)
    w.write_varint(127)
    w.write_varint(128)
    w.write_varint(300)
    w.write_varint(16384)

    let buf: Buffer = w.to_buffer()
    var r: ProtoReader = ProtoReader::from_buffer(ref buf)

    let v0 = r.read_varint()
    assert_eq(when v0 { Ok(v) => v, Err(e) => -1 }, 0, "roundtrip 0")

    let v1 = r.read_varint()
    assert_eq(when v1 { Ok(v) => v, Err(e) => -1 }, 1, "roundtrip 1")

    let v2 = r.read_varint()
    assert_eq(when v2 { Ok(v) => v, Err(e) => -1 }, 127, "roundtrip 127")

    let v3 = r.read_varint()
    assert_eq(when v3 { Ok(v) => v, Err(e) => -1 }, 128, "roundtrip 128")

    let v4 = r.read_varint()
    assert_eq(when v4 { Ok(v) => v, Err(e) => -1 }, 300, "roundtrip 300")

    let v5 = r.read_varint()
    assert_eq(when v5 { Ok(v) => v, Err(e) => -1 }, 16384, "roundtrip 16384")

    return 0
}
