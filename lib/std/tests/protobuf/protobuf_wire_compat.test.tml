/// Wire-format compatibility tests against the official protobuf specification.
/// Each test encodes a message and verifies the output matches the exact byte
/// sequence that protoc/reference implementations produce.
///
/// Proto schemas: lib/std/tests/protobuf/protos/

use test::*
use std::protobuf::{ProtoWriter, ProtoReader, ProtoTag, zigzag_encode, zigzag_decode}
use std::collections::Buffer

const WIRE_VARINT: I64 = 0
const WIRE_FIXED64: I64 = 1
const WIRE_LEN: I64 = 2
const WIRE_FIXED32: I64 = 5

func make_tag(field_num: I64, wire_type: I64) -> I64 {
    return (field_num << 3) | wire_type
}

// ============================================================================
// Helper: compare buffer bytes against expected hex
// ============================================================================

func buf_byte(buf: ref Buffer, i: I64) -> I64 {
    return buf.read_u8(i) as I64
}

// ============================================================================
// Protobuf spec example: varint encoding of 150
// From https://protobuf.dev/programming-guides/encoding/
//   field 1, wire type 0 (varint), value 150
//   Tag: 08 (field=1, wire=0)
//   Value: 96 01 (150 in LEB128)
//   Full: 08 96 01
// ============================================================================

@test func test_spec_example_varint_150() {
    var w = ProtoWriter::new()
    w.write_field_varint(1, 150)
    let buf = w.to_buffer()
    assert_eq(buf.len(), 3)
    assert_eq(buf_byte(ref buf, 0), 0x08) // tag: field 1, varint
    assert_eq(buf_byte(ref buf, 1), 0x96) // 150 LEB128 low byte
    assert_eq(buf_byte(ref buf, 2), 0x01) // 150 LEB128 high byte
}

// ============================================================================
// Protobuf spec example: string "testing"
// From https://protobuf.dev/programming-guides/encoding/
//   field 2, wire type 2 (length-delimited), value "testing"
//   Tag: 12 (field=2, wire=2)
//   Length: 07
//   Data: 74 65 73 74 69 6e 67
//   Full: 12 07 74 65 73 74 69 6e 67
// ============================================================================

@test func test_spec_example_string_testing() {
    var w = ProtoWriter::new()
    w.write_field_string(2, "testing")
    let buf = w.to_buffer()
    assert_eq(buf.len(), 9)
    assert_eq(buf_byte(ref buf, 0), 0x12) // tag: field 2, len-delimited
    assert_eq(buf_byte(ref buf, 1), 0x07) // length: 7
    assert_eq(buf_byte(ref buf, 2), 0x74) // 't'
    assert_eq(buf_byte(ref buf, 3), 0x65) // 'e'
    assert_eq(buf_byte(ref buf, 4), 0x73) // 's'
    assert_eq(buf_byte(ref buf, 5), 0x74) // 't'
    assert_eq(buf_byte(ref buf, 6), 0x69) // 'i'
    assert_eq(buf_byte(ref buf, 7), 0x6E) // 'n'
    assert_eq(buf_byte(ref buf, 8), 0x67) // 'g'
}

// ============================================================================
// Tag encoding: (field_number << 3) | wire_type
// ============================================================================

@test func test_tag_encoding_field1_varint() {
    // field 1, wire type 0 → tag = (1 << 3) | 0 = 8 → single byte 0x08
    assert_eq(make_tag(1, WIRE_VARINT), 8)
}

@test func test_tag_encoding_field2_len() {
    // field 2, wire type 2 → tag = (2 << 3) | 2 = 18 → single byte 0x12
    assert_eq(make_tag(2, WIRE_LEN), 18)
}

@test func test_tag_encoding_field15_varint() {
    // field 15, wire type 0 → tag = (15 << 3) | 0 = 120 → single byte 0x78
    assert_eq(make_tag(15, WIRE_VARINT), 120)
}

@test func test_tag_encoding_field16_varint() {
    // field 16, wire type 0 → tag = (16 << 3) | 0 = 128 → TWO bytes (varint)
    var w = ProtoWriter::new()
    w.write_tag(16, WIRE_VARINT)
    let buf = w.to_buffer()
    assert_eq(buf.len(), 2)  // field 16+ needs 2 byte tag
    assert_eq(buf_byte(ref buf, 0), 0x80) // 128 low byte
    assert_eq(buf_byte(ref buf, 1), 0x01) // 128 high byte
}

// ============================================================================
// person.proto: Person { name="Alice", id=123, email="alice@test.com" }
//
//   field 1 (name, string):  0a 05 41 6c 69 63 65
//   field 2 (id, int32):     10 7b
//   field 3 (email, string): 1a 0e 61 6c 69 63 65 40 74 65 73 74 2e 63 6f 6d
// ============================================================================

@test func test_person_alice() {
    var w = ProtoWriter::new()
    w.write_field_string(1, "Alice")          // name
    w.write_field_varint(2, 123)              // id
    w.write_field_string(3, "alice@test.com") // email
    let buf = w.to_buffer()

    // field 1: tag=0x0a (field 1, LEN), len=5, "Alice"
    assert_eq(buf_byte(ref buf, 0), 0x0A)
    assert_eq(buf_byte(ref buf, 1), 5)
    assert_eq(buf_byte(ref buf, 2), 0x41) // 'A'

    // field 2: tag=0x10 (field 2, VARINT), value=123=0x7b
    assert_eq(buf_byte(ref buf, 7), 0x10)
    assert_eq(buf_byte(ref buf, 8), 0x7B)

    // field 3: tag=0x1a (field 3, LEN), len=14
    assert_eq(buf_byte(ref buf, 9), 0x1A)
    assert_eq(buf_byte(ref buf, 10), 14)

    // Roundtrip decode
    var r = ProtoReader::new(w.to_bytes())
    let tag1 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(tag1.field_num, 1)
    let name = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(name, "Alice")

    let tag2 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(tag2.field_num, 2)
    let id = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(id, 123)

    let tag3 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(tag3.field_num, 3)
    let email = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(email, "alice@test.com")

    assert(not r.has_more(), "should be at end")
}

// ============================================================================
// person.proto: Person with PhoneNumber (nested message)
//   Person { name="Bob", id=456, phones=[{number="555-1234", type=MOBILE}] }
//
//   field 1 (name):   0a 03 42 6f 62
//   field 2 (id):     10 c8 03
//   field 4 (phones): 22 0c 0a 08 35 35 35 2d 31 32 33 34 10 01
// ============================================================================

@test func test_person_nested_phone() {
    // Encode PhoneNumber sub-message
    var phone = ProtoWriter::new()
    phone.write_field_string(1, "555-1234")   // number
    phone.write_field_varint(2, 1)            // type = MOBILE

    // Encode Person
    var w = ProtoWriter::new()
    w.write_field_string(1, "Bob")            // name
    w.write_field_varint(2, 456)              // id
    w.write_field_message(4, ref phone)       // phones[0]

    let buf = w.to_buffer()

    // Verify tag bytes
    assert_eq(buf_byte(ref buf, 0), 0x0A) // field 1 (name), LEN
    assert_eq(buf_byte(ref buf, 4), 0x10) // field 2 (id), VARINT
    // 456 in LEB128 = c8 03
    assert_eq(buf_byte(ref buf, 5), 0xC8)
    assert_eq(buf_byte(ref buf, 6), 0x03)
    assert_eq(buf_byte(ref buf, 7), 0x22) // field 4 (phones), LEN

    // Roundtrip: decode and skip to phone sub-message
    var r = ProtoReader::new(w.to_bytes())

    // field 1: name
    let t1 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t1.field_num, 1)
    let name = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(name, "Bob")

    // field 2: id
    let t2 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t2.field_num, 2)
    let id = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(id, 456)

    // field 4: phones (sub-message)
    let t4 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t4.field_num, 4)
    assert_eq(t4.wire_type, WIRE_LEN)
    var sub_r = when r.read_message_bytes() { Ok(v) => v, Err(e) => { assert(false, e); return } }

    // Decode phone sub-message
    let pt1 = when sub_r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(pt1.field_num, 1)
    let number = when sub_r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(number, "555-1234")

    let pt2 = when sub_r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(pt2.field_num, 2)
    let phone_type = when sub_r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(phone_type, 1) // MOBILE
}

// ============================================================================
// scalars.proto: message with various scalar types
// ============================================================================

@test func test_scalars_int_types() {
    var w = ProtoWriter::new()
    w.write_field_varint(3, 100)       // int32
    w.write_field_varint(4, 100000)    // int64
    w.write_field_varint(5, 42)        // uint32
    w.write_field_varint(6, 99999)     // uint64

    var r = ProtoReader::new(w.to_bytes())

    let t3 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t3.field_num, 3)
    let v3 = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v3, 100)

    let t4 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t4.field_num, 4)
    let v4 = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v4, 100000)

    let t5 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t5.field_num, 5)
    let v5 = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v5, 42)

    let t6 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t6.field_num, 6)
    let v6 = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v6, 99999)
}

@test func test_scalars_sint_zigzag() {
    // sint32 uses zigzag: -1→1, 1→2, -2→3, 2→4
    var w = ProtoWriter::new()
    w.write_field_sint(7, -1)    // sint32 field 7
    w.write_field_sint(8, -100)  // sint64 field 8

    var r = ProtoReader::new(w.to_bytes())

    let t7 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t7.field_num, 7)
    let raw7 = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(zigzag_decode(raw7), -1)

    let t8 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t8.field_num, 8)
    let raw8 = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(zigzag_decode(raw8), -100)
}

@test func test_scalars_fixed32() {
    var w = ProtoWriter::new()
    w.write_field_fixed32(9, 0x12345678)  // fixed32 field 9

    let buf = w.to_buffer()
    // tag: field 9, wire type 5 (I32) = (9 << 3) | 5 = 77 = 0x4D
    assert_eq(buf_byte(ref buf, 0), 0x4D)
    // little-endian: 78 56 34 12
    assert_eq(buf_byte(ref buf, 1), 0x78)
    assert_eq(buf_byte(ref buf, 2), 0x56)
    assert_eq(buf_byte(ref buf, 3), 0x34)
    assert_eq(buf_byte(ref buf, 4), 0x12)
}

@test func test_scalars_fixed64() {
    var w = ProtoWriter::new()
    w.write_field_fixed64(10, 0x0102030405060708)  // fixed64 field 10

    let buf = w.to_buffer()
    // tag: field 10, wire type 1 (I64) = (10 << 3) | 1 = 81 = 0x51
    assert_eq(buf_byte(ref buf, 0), 0x51)
    // little-endian: 08 07 06 05 04 03 02 01
    assert_eq(buf_byte(ref buf, 1), 0x08)
    assert_eq(buf_byte(ref buf, 2), 0x07)
    assert_eq(buf_byte(ref buf, 3), 0x06)
    assert_eq(buf_byte(ref buf, 4), 0x05)
    assert_eq(buf_byte(ref buf, 5), 0x04)
    assert_eq(buf_byte(ref buf, 6), 0x03)
    assert_eq(buf_byte(ref buf, 7), 0x02)
    assert_eq(buf_byte(ref buf, 8), 0x01)
}

@test func test_scalars_bool() {
    var w = ProtoWriter::new()
    w.write_field_bool(13, true)
    w.write_field_bool(13, false)

    var r = ProtoReader::new(w.to_bytes())
    let t1 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t1.field_num, 13)
    let b1 = when r.read_bool() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert(b1, "expected true")

    let t2 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    let b2 = when r.read_bool() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert(not b2, "expected false")
}

@test func test_scalars_string_and_bytes() {
    var w = ProtoWriter::new()
    w.write_field_string(14, "hello world")
    w.write_field_bytes(15, "abc")

    var r = ProtoReader::new(w.to_bytes())

    let t14 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t14.field_num, 14)
    assert_eq(t14.wire_type, WIRE_LEN)
    let s = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(s, "hello world")

    let t15 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t15.field_num, 15)
    let b = when r.read_bytes() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(b.len(), 3)
}

// ============================================================================
// Varint edge cases from the spec
// ============================================================================

@test func test_varint_single_byte_0() {
    var w = ProtoWriter::new()
    w.write_varint(0)
    let buf = w.to_buffer()
    assert_eq(buf.len(), 1)
    assert_eq(buf_byte(ref buf, 0), 0x00)
}

@test func test_varint_single_byte_127() {
    var w = ProtoWriter::new()
    w.write_varint(127)
    let buf = w.to_buffer()
    assert_eq(buf.len(), 1)
    assert_eq(buf_byte(ref buf, 0), 0x7F)
}

@test func test_varint_two_bytes_128() {
    var w = ProtoWriter::new()
    w.write_varint(128)
    let buf = w.to_buffer()
    assert_eq(buf.len(), 2)
    assert_eq(buf_byte(ref buf, 0), 0x80)
    assert_eq(buf_byte(ref buf, 1), 0x01)
}

@test func test_varint_two_bytes_300() {
    // 300 = 0b100101100
    // LEB128: 10101100 00000010 = AC 02
    var w = ProtoWriter::new()
    w.write_varint(300)
    let buf = w.to_buffer()
    assert_eq(buf.len(), 2)
    assert_eq(buf_byte(ref buf, 0), 0xAC)
    assert_eq(buf_byte(ref buf, 1), 0x02)
}

@test func test_varint_five_bytes_max_u32() {
    // 2^32 - 1 = 4294967295
    // LEB128: FF FF FF FF 0F
    var w = ProtoWriter::new()
    w.write_varint(4294967295)
    let buf = w.to_buffer()
    assert_eq(buf.len(), 5)
    assert_eq(buf_byte(ref buf, 0), 0xFF)
    assert_eq(buf_byte(ref buf, 1), 0xFF)
    assert_eq(buf_byte(ref buf, 2), 0xFF)
    assert_eq(buf_byte(ref buf, 3), 0xFF)
    assert_eq(buf_byte(ref buf, 4), 0x0F)
}

// ============================================================================
// Skip unknown fields — decoder MUST handle fields it doesn't know
// ============================================================================

@test func test_skip_unknown_varint() {
    var w = ProtoWriter::new()
    w.write_field_varint(1, 42)     // known
    w.write_field_varint(99, 9999)  // unknown field 99
    w.write_field_string(2, "end")  // known

    var r = ProtoReader::new(w.to_bytes())

    let t1 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t1.field_num, 1)
    let v1 = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v1, 42)

    // Skip unknown field 99
    let t99 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t99.field_num, 99)
    when r.skip_field(t99.wire_type) { Ok(v) => {}, Err(e) => { assert(false, e); return } }

    // Continue to field 2
    let t2 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t2.field_num, 2)
    let v2 = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v2, "end")
}

@test func test_skip_unknown_fixed_and_len() {
    var w = ProtoWriter::new()
    w.write_field_string(1, "start")
    w.write_field_fixed32(50, 0xDEADBEEF)   // unknown fixed32
    w.write_field_fixed64(51, 0xCAFEBABE)    // unknown fixed64
    w.write_field_string(52, "skip_this")    // unknown string
    w.write_field_string(2, "end")

    var r = ProtoReader::new(w.to_bytes())

    // Read field 1
    let t1 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    let v1 = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v1, "start")

    // Skip 3 unknown fields
    for i in 0 to 3 {
        let tu = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
        when r.skip_field(tu.wire_type) { Ok(v) => {}, Err(e) => { assert(false, e); return } }
    }

    // Field 2 still readable
    let t2 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t2.field_num, 2)
    let v2 = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v2, "end")
}

// ============================================================================
// Empty message (zero fields) — valid protobuf
// ============================================================================

@test func test_empty_message() {
    var w = ProtoWriter::new()
    let buf = w.to_buffer()
    assert_eq(buf.len(), 0)

    var r = ProtoReader::new(w.to_bytes())
    assert(not r.has_more(), "empty message should have no fields")
}

// ============================================================================
// Default value omission — fields with default values (0, false, "")
// should NOT be on the wire in proto3
// ============================================================================

@test func test_default_value_int_zero_is_omitted() {
    // In proto3, encoder SHOULD NOT emit fields with default values.
    // This test verifies the user can choose to omit them.
    var w = ProtoWriter::new()
    // Only write non-default fields
    let id: I64 = 0
    if id != 0 { w.write_field_varint(2, id) }
    let name: Str = ""
    if name.len() > 0 { w.write_field_string(1, name) }
    let active: Bool = false
    if active { w.write_field_bool(4, active) }

    let buf = w.to_buffer()
    assert_eq(buf.len(), 0) // all defaults → empty message
}

// ============================================================================
// Multiple messages concatenation (proto spec: "merge semantics")
// "Parsing the concatenation of two encoded messages produces exactly
// the same result as if you had parsed the two messages separately
// and merged the resulting objects."
// ============================================================================

@test func test_concatenation_merge_semantics() {
    // Encode two partial messages
    var w1 = ProtoWriter::new()
    w1.write_field_string(1, "Alice") // name

    var w2 = ProtoWriter::new()
    w2.write_field_varint(2, 42)      // id

    // Concatenate bytes by reading both as strings
    let bytes1 = w1.to_bytes()
    let bytes2 = w2.to_bytes()
    let merged_str = bytes1 + bytes2

    // Read merged: should see both fields
    var r = ProtoReader::new(merged_str)
    let t1 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t1.field_num, 1)
    let name = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(name, "Alice")

    let t2 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t2.field_num, 2)
    let id = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(id, 42)
}

// ============================================================================
// Field ordering: fields can appear in ANY order
// ============================================================================

@test func test_fields_out_of_order() {
    var w = ProtoWriter::new()
    w.write_field_varint(3, 300)      // field 3 first
    w.write_field_string(1, "hello")  // field 1 second
    w.write_field_varint(2, 200)      // field 2 third

    var r = ProtoReader::new(w.to_bytes())

    let t3 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t3.field_num, 3)
    let v3 = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v3, 300)

    let t1 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t1.field_num, 1)
    let v1 = when r.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v1, "hello")

    let t2 = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t2.field_num, 2)
    let v2 = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v2, 200)
}

// ============================================================================
// Large field numbers (29-bit max = 536870911)
// ============================================================================

@test func test_large_field_number() {
    var w = ProtoWriter::new()
    w.write_field_varint(1000, 42)

    var r = ProtoReader::new(w.to_bytes())
    let t = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(t.field_num, 1000)
    let v = when r.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(v, 42)
}

// ============================================================================
// Nested messages: AddressBook → Person → PhoneNumber (3 levels deep)
// ============================================================================

@test func test_three_level_nesting() {
    // PhoneNumber { number="123", type=2 }
    var phone = ProtoWriter::new()
    phone.write_field_string(1, "123")
    phone.write_field_varint(2, 2) // HOME

    // Person { name="Eve", id=1, phones=[phone] }
    var person = ProtoWriter::new()
    person.write_field_string(1, "Eve")
    person.write_field_varint(2, 1)
    person.write_field_message(4, ref phone)

    // AddressBook { people=[person] }
    var book = ProtoWriter::new()
    book.write_field_message(1, ref person)

    // Decode: AddressBook → Person → PhoneNumber
    var r = ProtoReader::new(book.to_bytes())
    let tb = when r.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(tb.field_num, 1)
    var pr = when r.read_message_bytes() { Ok(v) => v, Err(e) => { assert(false, e); return } }

    // Person
    let tp1 = when pr.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(tp1.field_num, 1)
    let pname = when pr.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(pname, "Eve")

    let tp2 = when pr.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    let pid = when pr.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(pid, 1)

    let tp4 = when pr.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    assert_eq(tp4.field_num, 4)
    var phr = when pr.read_message_bytes() { Ok(v) => v, Err(e) => { assert(false, e); return } }

    // PhoneNumber
    let tph1 = when phr.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    let pnum = when phr.read_string() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(pnum, "123")

    let tph2 = when phr.read_tag() { Ok(t) => t, Err(e) => { assert(false, e); return } }
    let ptype = when phr.read_varint() { Ok(v) => v, Err(e) => { assert(false, e); return } }
    assert_eq(ptype, 2)
}
