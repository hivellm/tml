// Tests for ObservableI32 factory functions — additional coverage
use test::{assert, assert_eq}
use std::events::observable::{
    ObservableI32,
    observable_of2_i32, observable_of3_i32,
    observable_from_list_i32,
    obs_subscribe_next_i32
}

@test
func test_of2_negative_values() -> I32 {
    var sum: I32 = 0
    let obs: ObservableI32 = observable_of2_i32(-5, -7)
    obs_subscribe_next_i32(obs, do(v: I32) { sum = sum + v })
    assert_eq(sum, -12, "sum should be -12")
    return 0
}

@test
func test_of3_zero_values() -> I32 {
    var count: I64 = 0
    let obs: ObservableI32 = observable_of3_i32(0, 0, 0)
    obs_subscribe_next_i32(obs, do(v: I32) { count = count + 1 })
    assert_eq(count, 3, "should emit 3 zeroes")
    return 0
}

@test
func test_from_empty_list() -> I32 {
    var items: List[I32] = List::new(4)
    var count: I64 = 0
    let obs: ObservableI32 = observable_from_list_i32(items)
    obs_subscribe_next_i32(obs, do(v: I32) { count = count + 1 })
    assert_eq(count, 0, "empty list should emit no values")
    return 0
}

@test
func test_from_single_item_list() -> I32 {
    var items: List[I32] = List::new(1)
    items.push(99)
    var received: I32 = 0
    let obs: ObservableI32 = observable_from_list_i32(items)
    obs_subscribe_next_i32(obs, do(v: I32) { received = v })
    assert_eq(received, 99, "should receive 99")
    return 0
}
