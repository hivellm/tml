// Tests for ObservableI32 operators — map, filter, take, skip, scan, distinct
use test::{assert, assert_eq}
use std::observable::{
    ObservableI32, Observer, Subscription,
    observable_of3_i32, observable_from_list_i32,
    observable_map_i32, observable_filter_i32,
    observable_take_i32, observable_skip_i32,
    observable_scan_i32, observable_distinct_i32,
    obs_subscribe_next_i32
}

// ============================================================================
// map
// ============================================================================

@test
func test_map_double() -> I32 {
    let source: ObservableI32 = observable_of3_i32(1, 2, 3)
    let doubled: ObservableI32 = observable_map_i32(source, do(x: I32) -> I32 { return x * 2 })
    var sum: I32 = 0
    obs_subscribe_next_i32(doubled, do(v: I32) { sum = sum + v })
    assert_eq(sum, 12, "2+4+6 = 12")
    return 0
}

@test
func test_map_negate() -> I32 {
    let source: ObservableI32 = observable_of3_i32(10, 20, 30)
    let negated: ObservableI32 = observable_map_i32(source, do(x: I32) -> I32 { return 0 - x })
    var sum: I32 = 0
    obs_subscribe_next_i32(negated, do(v: I32) { sum = sum + v })
    assert_eq(sum, -60, "sum of negated should be -60")
    return 0
}

// ============================================================================
// filter
// ============================================================================

@test
func test_filter_even() -> I32 {
    var items: List[I32] = List::new(6)
    items.push(1)
    items.push(2)
    items.push(3)
    items.push(4)
    items.push(5)
    items.push(6)
    let source: ObservableI32 = observable_from_list_i32(items)
    let evens: ObservableI32 = observable_filter_i32(source, do(x: I32) -> Bool { return x % 2 == 0 })
    var sum: I32 = 0
    obs_subscribe_next_i32(evens, do(v: I32) { sum = sum + v })
    assert_eq(sum, 12, "2+4+6 = 12")
    return 0
}

@test
func test_filter_none_match() -> I32 {
    let source: ObservableI32 = observable_of3_i32(1, 3, 5)
    let evens: ObservableI32 = observable_filter_i32(source, do(x: I32) -> Bool { return x % 2 == 0 })
    var count: I64 = 0
    obs_subscribe_next_i32(evens, do(v: I32) { count = count + 1 })
    assert_eq(count, 0, "no values should pass filter")
    return 0
}

// ============================================================================
// take
// ============================================================================

@test
func test_take_first_two() -> I32 {
    var items: List[I32] = List::new(5)
    items.push(10)
    items.push(20)
    items.push(30)
    items.push(40)
    items.push(50)
    let source: ObservableI32 = observable_from_list_i32(items)
    let taken: ObservableI32 = observable_take_i32(source, 2)
    var sum: I32 = 0
    obs_subscribe_next_i32(taken, do(v: I32) { sum = sum + v })
    assert_eq(sum, 30, "10+20 = 30")
    return 0
}

// ============================================================================
// skip
// ============================================================================

@test
func test_skip_first_two() -> I32 {
    var items: List[I32] = List::new(5)
    items.push(10)
    items.push(20)
    items.push(30)
    items.push(40)
    items.push(50)
    let source: ObservableI32 = observable_from_list_i32(items)
    let skipped: ObservableI32 = observable_skip_i32(source, 2)
    var sum: I32 = 0
    obs_subscribe_next_i32(skipped, do(v: I32) { sum = sum + v })
    assert_eq(sum, 120, "30+40+50 = 120")
    return 0
}

// ============================================================================
// scan
// ============================================================================

@test
func test_scan_running_sum() -> I32 {
    let source: ObservableI32 = observable_of3_i32(1, 2, 3)
    let scanned: ObservableI32 = observable_scan_i32(source, 0, do(acc: I32, x: I32) -> I32 { return acc + x })

    var last: I32 = 0
    var count: I64 = 0
    obs_subscribe_next_i32(scanned, do(v: I32) {
        last = v
        count = count + 1
    })
    assert_eq(count, 3, "should emit 3 intermediate results")
    assert_eq(last, 6, "final accumulated value should be 6")
    return 0
}

// ============================================================================
// distinct
// ============================================================================

@test
func test_distinct_consecutive() -> I32 {
    var items: List[I32] = List::new(8)
    items.push(1)
    items.push(1)
    items.push(2)
    items.push(2)
    items.push(3)
    items.push(1)
    let source: ObservableI32 = observable_from_list_i32(items)
    let distinct: ObservableI32 = observable_distinct_i32(source)
    var count: I64 = 0
    var sum: I32 = 0
    obs_subscribe_next_i32(distinct, do(v: I32) {
        count = count + 1
        sum = sum + v
    })
    // 1, 2, 3, 1 (distinct consecutive)
    assert_eq(count, 4, "should emit 4 distinct consecutive values")
    assert_eq(sum, 7, "1+2+3+1 = 7")
    return 0
}
