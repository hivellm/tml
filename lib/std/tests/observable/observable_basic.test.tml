// Tests for ObservableI32 — basic creation, subscribe, and factory functions
use test::{assert, assert_eq}
use std::events::observable::{
    ObservableI32, Observer, Subscription,
    observable_of2_i32, observable_of3_i32, observable_from_list_i32,
    observable_empty_i32, observable_never_i32, observable_throw_i32,
    obs_subscribe_i32, obs_subscribe_next_i32
}

func noop_error(msg: Str) {}
func noop_complete() {}

// ============================================================================
// of2, of3
// ============================================================================

@test
func test_observable_of2_i32() -> I32 {
    var sum: I32 = 0
    let obs: ObservableI32 = observable_of2_i32(5, 7)
    obs_subscribe_next_i32(obs, do(v: I32) { sum = sum + v })
    assert_eq(sum, 12, "sum of 5+7 should be 12")
    return 0
}

@test
func test_observable_of3_i32() -> I32 {
    var sum: I32 = 0
    var count: I64 = 0
    let obs: ObservableI32 = observable_of3_i32(10, 20, 30)

    let observer: Observer[I32] = Observer {
        on_next: do(v: I32) {
            sum = sum + v
            count = count + 1
        },
        on_error: noop_error,
        on_complete: noop_complete
    }
    obs_subscribe_i32(obs, observer)
    assert_eq(sum, 60, "sum of 10+20+30 should be 60")
    assert_eq(count, 3, "should receive 3 values")
    return 0
}

// ============================================================================
// from_list
// ============================================================================

@test
func test_observable_from_list_i32() -> I32 {
    var items: List[I32] = List::new(4)
    items.push(100)
    items.push(200)
    items.push(300)

    var sum: I32 = 0
    let obs: ObservableI32 = observable_from_list_i32(ref items)
    obs_subscribe_next_i32(obs, do(v: I32) { sum = sum + v })
    assert_eq(sum, 600, "sum should be 600")
    return 0
}

// ============================================================================
// empty, never, throw
// ============================================================================

@test
func test_observable_empty_completes() -> I32 {
    var count: I64 = 0
    var completed: Bool = false
    let obs: ObservableI32 = observable_empty_i32()

    let observer: Observer[I32] = Observer {
        on_next: do(v: I32) { count = count + 1 },
        on_error: noop_error,
        on_complete: do() { completed = true }
    }
    obs_subscribe_i32(obs, observer)
    assert_eq(count, 0, "empty should emit no values")
    assert(completed, "empty should complete")
    return 0
}

@test
func test_observable_never() -> I32 {
    var count: I64 = 0
    var completed: Bool = false
    let obs: ObservableI32 = observable_never_i32()

    let observer: Observer[I32] = Observer {
        on_next: do(v: I32) { count = count + 1 },
        on_error: noop_error,
        on_complete: do() { completed = true }
    }
    let sub: Subscription = obs_subscribe_i32(obs, observer)
    assert_eq(count, 0, "never should emit no values")
    assert(not completed, "never should not complete")
    assert(sub.is_active(), "never subscription should be active")
    return 0
}

@test
func test_observable_throw() -> I32 {
    var error_msg: Str = ""
    var count: I64 = 0
    let obs: ObservableI32 = observable_throw_i32("test error")

    let observer: Observer[I32] = Observer {
        on_next: do(v: I32) { count = count + 1 },
        on_error: do(msg: Str) { error_msg = msg },
        on_complete: noop_complete
    }
    obs_subscribe_i32(obs, observer)
    assert_eq(count, 0, "throw should emit no values")
    assert_eq(error_msg, "test error", "should receive error message")
    return 0
}

// ============================================================================
// on_complete callback
// ============================================================================

@test
func test_observable_on_complete_called() -> I32 {
    var completed: Bool = false
    let obs: ObservableI32 = observable_of2_i32(1, 2)

    let observer: Observer[I32] = Observer {
        on_next: do(v: I32) {},
        on_error: noop_error,
        on_complete: do() { completed = true }
    }
    obs_subscribe_i32(obs, observer)
    assert(completed, "on_complete should have been called")
    return 0
}
