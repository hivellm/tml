// Tests for Drop impls on all 7 zlib stream types
// Drop is called when the value goes out of scope (no explicit destroy())
use test::{assert}
use std::zlib::stream::{Deflate, DeflateRaw, Gzip, Inflate, InflateRaw, Gunzip, Unzip}
use std::zlib::error::ZlibError

@test
func test_deflate_drop() -> I32 {
    let r: Outcome[Deflate, ZlibError] = Deflate::new()
    assert(r.is_ok(), "Deflate::new should succeed")
    let _d: Deflate = r.unwrap()
    // _d goes out of scope here — Drop::drop is called automatically
    return 0
}

@test
func test_deflate_raw_drop() -> I32 {
    let r: Outcome[DeflateRaw, ZlibError] = DeflateRaw::new()
    assert(r.is_ok(), "DeflateRaw::new should succeed")
    let _d: DeflateRaw = r.unwrap()
    return 0
}

