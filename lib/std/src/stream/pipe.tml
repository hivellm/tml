//! Stream piping utilities.
//!
//! Provides functions to efficiently copy bytes between streams.
//!
//! # Example
//!
//! ```tml
//! use std::stream::{ByteStream, pipe, copy_bytes}
//!
//! var src = ByteStream::from_string("Hello World")
//! var dst = ByteStream::new()
//! let n = pipe(mut ref src, mut ref dst)!  // n == 11
//! ```

use core::runtime::error::{IoError, IoErrorKind}
use std::collections::buffer::{
    buf_get_data,
    buf_set_data,
    buf_get_len,
    buf_set_len,
    buf_get_cap,
    buf_set_cap,
    buf_get_read_pos,
    buf_set_read_pos,
    buf_mem_realloc,
    buf_read_byte_at,
    buf_write_byte_at,
}
use std::stream::byte_stream::ByteStream

// Internal: copy `count` bytes from `src_data` at `src_offset` into `dst_data` at `dst_offset`.
func copy_bytes_raw(src_data: *Unit, src_offset: I64, dst_data: *Unit, dst_offset: I64, count: I64) {
    var i: I64 = 0
    loop (i < count) {
        buf_write_byte_at(dst_data, dst_offset + i, buf_read_byte_at(src_data, src_offset + i))
        i = i + 1
    }
}

// Internal: ensure a ByteStream handle has at least `needed` additional bytes of capacity.
func pipe_ensure_capacity(h: I64, needed: I64) {
    let dst_len: I64 = buf_get_len(h)
    let dst_cap: I64 = buf_get_cap(h)
    if dst_len + needed > dst_cap {
        var new_cap: I64 = dst_cap * 2
        loop (new_cap < dst_len + needed) {
            new_cap = new_cap * 2
        }
        let old_data: *Unit = buf_get_data(h)
        let new_data: *Unit = buf_mem_realloc(old_data, new_cap)
        buf_set_data(h, new_data)
        buf_set_cap(h, new_cap)
    }
}

/// Copies all remaining bytes from `source` to `dest`.
///
/// Reads directly from source's internal data and writes to dest
/// using write_string. Returns the total number of bytes transferred.
pub func pipe(source: mut ref ByteStream, dest: mut ref ByteStream) -> Outcome[I64, IoError] {
    let h_src: I64 = source.handle as I64
    let src_rp: I64 = buf_get_read_pos(h_src)
    let src_len: I64 = buf_get_len(h_src)
    let remaining: I64 = src_len - src_rp

    if remaining <= 0 {
        return Ok(0 as I64)
    }

    let src_data: *Unit = buf_get_data(h_src)

    let h_dst: I64 = dest.handle as I64
    let dst_len: I64 = buf_get_len(h_dst)

    pipe_ensure_capacity(h_dst, remaining)

    let dst_data: *Unit = buf_get_data(h_dst)
    copy_bytes_raw(src_data, src_rp, dst_data, dst_len, remaining)

    buf_set_read_pos(h_src, src_rp + remaining)
    buf_set_len(h_dst, dst_len + remaining)

    Ok(remaining)
}

/// Copies up to `limit` bytes from `source` to `dest`.
///
/// Stops when either `limit` bytes have been transferred or the
/// source reaches EOF. Returns the actual number of bytes copied.
pub func copy_bytes(source: mut ref ByteStream, dest: mut ref ByteStream, limit: I64) -> Outcome[I64, IoError] {
    if limit <= 0 {
        return Ok(0 as I64)
    }

    let h_src: I64 = source.handle as I64
    let src_rp: I64 = buf_get_read_pos(h_src)
    let src_len: I64 = buf_get_len(h_src)
    let remaining: I64 = src_len - src_rp

    var to_copy: I64 = remaining
    if to_copy > limit {
        to_copy = limit
    }
    if to_copy <= 0 {
        return Ok(0 as I64)
    }

    let src_data: *Unit = buf_get_data(h_src)

    let h_dst: I64 = dest.handle as I64
    let dst_len: I64 = buf_get_len(h_dst)

    pipe_ensure_capacity(h_dst, to_copy)

    let dst_data: *Unit = buf_get_data(h_dst)
    copy_bytes_raw(src_data, src_rp, dst_data, dst_len, to_copy)

    buf_set_read_pos(h_src, src_rp + to_copy)
    buf_set_len(h_dst, dst_len + to_copy)

    Ok(to_copy)
}
