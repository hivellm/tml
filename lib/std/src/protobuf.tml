//! # Protocol Buffers Wire Format
//!
//! Pure TML implementation of the Protocol Buffers binary wire format
//! (encoding and decoding). Supports all core wire types: varint (LEB128),
//! fixed32, fixed64, and length-delimited fields.

use std::collections::Buffer

// =========================================================================
// Wire type constants
// =========================================================================

const WIRE_TYPE_VARINT: I64 = 0
const WIRE_TYPE_FIXED64: I64 = 1
const WIRE_TYPE_LENGTH_DELIMITED: I64 = 2
const WIRE_TYPE_FIXED32: I64 = 5

// =========================================================================
// Zigzag encoding helpers
// =========================================================================

/// Encodes a signed integer using zigzag encoding.
/// Maps: 0->0, -1->1, 1->2, -2->3, 2->4, ...
pub func zigzag_encode(n: I64) -> I64 {
    let shifted_left: I64 = n << 1
    let sign_bits: I64 = n >> 63
    return shifted_left ^ sign_bits
}

/// Decodes a zigzag-encoded integer back to signed.
/// Maps: 0->0, 1->-1, 2->1, 3->-2, 4->2, ...
pub func zigzag_decode(n: I64) -> I64 {
    let half: I64 = ((n as U64) >> 1) as I64
    let sign: I64 = 0 - (n & 1)
    return half ^ sign
}

// =========================================================================
// ProtoTag — decoded field tag
// =========================================================================

/// A decoded protobuf field tag containing the field number and wire type.
pub type ProtoTag {
    field_num: I64,
    wire_type: I64,
}

// =========================================================================
// ProtoWriter — encodes protobuf wire format
// =========================================================================

/// A Protocol Buffers encoder that writes to an internal byte buffer.
pub type ProtoWriter {
    buf: Buffer,
}

impl ProtoWriter {
    /// Creates a new writer with default buffer capacity.
    pub func new() -> ProtoWriter {
        ProtoWriter { buf: Buffer::new(256) }
    }

    /// Creates a new writer with specified initial capacity.
    pub func with_capacity(cap: I64) -> ProtoWriter {
        ProtoWriter { buf: Buffer::new(cap) }
    }

    /// Returns the number of bytes written so far.
    pub func len(this) -> I64 {
        return this.buf.len()
    }

    /// Returns the encoded bytes as a string (binary data).
    pub func to_bytes(this) -> Str {
        return this.buf.to_string()
    }

    /// Returns the encoded bytes as a Buffer.
    pub func to_buffer(this) -> Buffer {
        return this.buf
    }

    /// Writes an unsigned varint (LEB128 encoding).
    pub func write_varint(mut this, value: I64) {
        var v: U64 = value as U64
        loop (true) {
            let byte_val: I32 = (v & (127 as U64)) as I32
            v = v >> 7
            if v == (0 as U64) {
                this.buf.write_byte(byte_val)
                break
            } else {
                this.buf.write_byte(byte_val | 128)
            }
        }
    }

    /// Writes a 32-bit value in little-endian byte order.
    pub func write_fixed32(mut this, value: I32) {
        let v: I64 = value as I64
        this.buf.write_byte((v as I32) & 0xFF)
        this.buf.write_byte(((v >> 8) as I32) & 0xFF)
        this.buf.write_byte(((v >> 16) as I32) & 0xFF)
        this.buf.write_byte(((v >> 24) as I32) & 0xFF)
    }

    /// Writes a 64-bit value in little-endian byte order.
    pub func write_fixed64(mut this, value: I64) {
        for i in 0 to 8 {
            let shift: I64 = i * 8
            let byte_val: I32 = ((value >> shift) as I32) & 0xFF
            this.buf.write_byte(byte_val)
        }
    }

    /// Writes raw bytes (length-prefixed with a varint).
    pub func write_bytes(mut this, data: Str) {
        let n: I64 = data.len()
        this.write_varint(n)
        for i in 0 to n {
            let ch: I32 = data.char_at(i) as I32
            this.buf.write_byte(ch)
        }
    }

    /// Writes a UTF-8 string (length-prefixed with a varint).
    pub func write_string(mut this, value: Str) {
        this.write_bytes(value)
    }

    /// Writes a field tag: (field_number << 3) | wire_type.
    pub func write_tag(mut this, field_num: I64, wire_type: I64) {
        let tag: I64 = (field_num << 3) | wire_type
        this.write_varint(tag)
    }

    /// Writes a varint field (tag + varint value).
    pub func write_field_varint(mut this, field_num: I64, value: I64) {
        this.write_tag(field_num, WIRE_TYPE_VARINT)
        this.write_varint(value)
    }

    /// Writes a string field (tag + length-prefixed string).
    pub func write_field_string(mut this, field_num: I64, value: Str) {
        this.write_tag(field_num, WIRE_TYPE_LENGTH_DELIMITED)
        this.write_string(value)
    }

    /// Writes a bytes field (tag + length-prefixed bytes).
    pub func write_field_bytes(mut this, field_num: I64, data: Str) {
        this.write_tag(field_num, WIRE_TYPE_LENGTH_DELIMITED)
        this.write_bytes(data)
    }

    /// Writes a fixed32 field (tag + 4 bytes little-endian).
    pub func write_field_fixed32(mut this, field_num: I64, value: I32) {
        this.write_tag(field_num, WIRE_TYPE_FIXED32)
        this.write_fixed32(value)
    }

    /// Writes a fixed64 field (tag + 8 bytes little-endian).
    pub func write_field_fixed64(mut this, field_num: I64, value: I64) {
        this.write_tag(field_num, WIRE_TYPE_FIXED64)
        this.write_fixed64(value)
    }

    /// Writes a nested message field (tag + length-prefixed submessage bytes).
    pub func write_field_message(mut this, field_num: I64, sub: ref ProtoWriter) {
        this.write_tag(field_num, WIRE_TYPE_LENGTH_DELIMITED)
        let sub_buf: Buffer = sub.to_buffer()
        let n: I64 = sub_buf.len()
        this.write_varint(n)
        for i in 0 to n {
            this.buf.write_byte(sub_buf.read_u8(i))
        }
    }

    /// Writes a signed varint field using zigzag encoding (sint32/sint64).
    pub func write_field_sint(mut this, field_num: I64, value: I64) {
        this.write_tag(field_num, WIRE_TYPE_VARINT)
        this.write_varint(zigzag_encode(value))
    }
}

// =========================================================================
// ProtoReader — decodes protobuf wire format
// =========================================================================

/// A Protocol Buffers decoder that reads from a byte buffer.
pub type ProtoReader {
    buf: Buffer,
    pos: I64,
}

impl ProtoReader {
    /// Creates a new reader from a raw byte string.
    pub func new(data: Str) -> ProtoReader {
        ProtoReader { buf: Buffer::from_string(data), pos: 0 }
    }

    /// Creates a new reader from a Buffer.
    pub func from_buffer(data: ref Buffer) -> ProtoReader {
        ProtoReader { buf: data.duplicate(), pos: 0 }
    }

    /// Returns the current read position.
    pub func position(this) -> I64 {
        return this.pos
    }

    /// Returns the number of remaining bytes.
    pub func remaining(this) -> I64 {
        return this.buf.len() - this.pos
    }

    /// Returns true if there are more bytes to read.
    pub func has_more(this) -> Bool {
        return this.pos < this.buf.len()
    }

    /// Reads a single byte and advances. Returns Err on EOF.
    pub func next_byte(mut this) -> Outcome[I32, Str] {
        if this.pos >= this.buf.len() {
            return Err("unexpected end of input")
        }
        let b: I32 = this.buf.read_u8(this.pos)
        this.pos = this.pos + 1
        return Ok(b)
    }

    /// Reads an unsigned varint (LEB128 decoding).
    pub func read_varint(mut this) -> Outcome[I64, Str] {
        var result: I64 = 0
        var shift: I64 = 0
        loop (true) {
            if shift >= 70 {
                return Err("varint too long")
            }
            let byte_result = this.next_byte()
            let b: I32 = when byte_result {
                Ok(v) => v,
                Err(e) => { return Err(e) },
            }
            let value_bits: I64 = (b & 0x7F) as I64
            result = result | (value_bits << shift)
            if b < 128 {
                return Ok(result)
            }
            shift = shift + 7
        }
    }

    /// Reads a 32-bit value in little-endian byte order.
    pub func read_fixed32(mut this) -> Outcome[I32, Str] {
        if this.remaining() < 4 {
            return Err("not enough bytes for fixed32")
        }
        let b0_r = this.next_byte()
        let b0: I32 = when b0_r { Ok(v) => v, Err(e) => { return Err(e) } }
        let b1_r = this.next_byte()
        let b1: I32 = when b1_r { Ok(v) => v, Err(e) => { return Err(e) } }
        let b2_r = this.next_byte()
        let b2: I32 = when b2_r { Ok(v) => v, Err(e) => { return Err(e) } }
        let b3_r = this.next_byte()
        let b3: I32 = when b3_r { Ok(v) => v, Err(e) => { return Err(e) } }
        let result: I64 = (b0 as I64) | ((b1 as I64) << 8) | ((b2 as I64) << 16) | ((b3 as I64) << 24)
        return Ok(result as I32)
    }

    /// Reads a 64-bit value in little-endian byte order.
    pub func read_fixed64(mut this) -> Outcome[I64, Str] {
        if this.remaining() < 8 {
            return Err("not enough bytes for fixed64")
        }
        var result: I64 = 0
        for i in 0 to 8 {
            let b_r = this.next_byte()
            let b: I32 = when b_r { Ok(v) => v, Err(e) => { return Err(e) } }
            let shift: I64 = i * 8
            result = result | ((b as I64) << shift)
        }
        return Ok(result)
    }

    /// Reads length-prefixed bytes and returns them as a Str.
    pub func read_bytes(mut this) -> Outcome[Str, Str] {
        let len_r = this.read_varint()
        let n: I64 = when len_r { Ok(v) => v, Err(e) => { return Err(e) } }
        if n < 0 {
            return Err("negative length in bytes field")
        }
        if this.remaining() < n {
            return Err("not enough bytes for length-delimited field")
        }
        let str_ptr: *U8 = lowlevel { mem_alloc(n + 1) } as *U8
        let addr: I64 = str_ptr as I64
        for i in 0 to n {
            let b_r = this.next_byte()
            let b: I32 = when b_r { Ok(v) => v, Err(e) => { return Err(e) } }
            lowlevel { ptr_write[U8]((addr + i) as *U8, b as U8) }
        }
        lowlevel { ptr_write[U8]((addr + n) as *U8, 0 as U8) }
        return Ok(str_ptr as Str)
    }

    /// Reads a length-prefixed UTF-8 string.
    pub func read_string(mut this) -> Outcome[Str, Str] {
        return this.read_bytes()
    }

    /// Reads a field tag and returns a ProtoTag with field_num and wire_type.
    pub func read_tag(mut this) -> Outcome[ProtoTag, Str] {
        let tag_r = this.read_varint()
        let tag: I64 = when tag_r { Ok(v) => v, Err(e) => { return Err(e) } }
        let wire_type: I64 = tag & 7
        let field_num: I64 = ((tag as U64) >> 3) as I64
        return Ok(ProtoTag { field_num: field_num, wire_type: wire_type })
    }

    /// Skips a field value based on its wire type.
    pub func skip_field(mut this, wire_type: I64) -> Outcome[Unit, Str] {
        if wire_type == 0 {
            let discard_r = this.read_varint()
            when discard_r {
                Ok(v) => {},
                Err(e) => { return Err(e) },
            }
            return Ok(())
        } else if wire_type == 1 {
            if this.remaining() < 8 {
                return Err("not enough bytes to skip fixed64")
            }
            this.pos = this.pos + 8
            return Ok(())
        } else if wire_type == 2 {
            let len_r = this.read_varint()
            let n: I64 = when len_r { Ok(v) => v, Err(e) => { return Err(e) } }
            if this.remaining() < n {
                return Err("not enough bytes to skip length-delimited field")
            }
            this.pos = this.pos + n
            return Ok(())
        } else if wire_type == 5 {
            if this.remaining() < 4 {
                return Err("not enough bytes to skip fixed32")
            }
            this.pos = this.pos + 4
            return Ok(())
        } else {
            return Err("unknown wire type")
        }
    }
}

// =========================================================================
// ProtoMessage behavior
// =========================================================================

/// Behavior for types that can be encoded/decoded as Protocol Buffer messages.
pub behavior ProtoMessage {
    /// Encodes this message's fields into the writer.
    func encode(this, writer: mut ref ProtoWriter)

    /// Decodes a message from the reader. Returns Err on malformed input.
    func decode(reader: mut ref ProtoReader) -> Outcome[Self, Str]
}
