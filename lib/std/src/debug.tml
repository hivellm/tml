//! Debug utilities for reflected types.
//!
//! This module provides generic debug printing and inspection utilities
//! for types that implement the `Reflect` behavior via `@derive(Reflect)`.
//!
//! # Usage
//!
//! ```tml
//! use std::debug::debug_print
//! use core::reflect::Reflect
//!
//! @derive(Reflect)
//! type Point {
//!     x: I64,
//!     y: I64,
//! }
//!
//! func main() {
//!     let p = Point { x: 1, y: 2 }
//!     debug_print(ref p)
//!     // Output: Point { x: 1, y: 2 }
//! }
//! ```

use core::reflect::{Reflect, TypeKind, read_field_i64}
use core::runtime::intrinsics::{field_name, field_offset}

/// Internal helper: get the raw pointer value of a reference as I64.
/// Used to obtain the base address for field offset calculations.
func get_ref_ptr[T](value: ref T) -> I64 {
    return lowlevel { value as I64 }
}

/// Print a debug representation of any Reflect type to stdout.
///
/// For struct types, prints: `TypeName { field0: <raw_i64>, field1: <raw_i64>, ... }`
/// For enum types, prints the type name with variant count.
/// For other types, prints the type name and kind.
///
/// Field values are displayed as their raw I64 bit pattern.
pub func debug_print[T: Reflect](value: ref T) {
    let s: Str = debug_string(value)
    print(s)
    print("\n")
}

/// Build a debug string for any Reflect type.
///
/// For struct types, produces: `TypeName { field0: <raw_i64>, field1: <raw_i64>, ... }`
/// For enum types, produces type name with variant count.
/// For other types, produces type name and kind string.
///
/// Field values are shown as raw I64 bit-pattern values. This is a best-effort
/// representation since generic field type dispatch is not yet available.
pub func debug_string[T: Reflect](value: ref T) -> Str {
    let info = value.runtime_type_info()
    let type_name: Str = info.name
    let kind_tag: I32 = info.kind.tag()

    // Struct: kind_tag == 0
    if kind_tag == 0 {
        return struct_debug_string(value, type_name, info.field_count)
    }

    // Enum: kind_tag == 1
    if kind_tag == 1 {
        return type_name + " (enum, variants=" + info.variant_count.to_string() + ")"
    }

    // Other types
    return type_name + " (" + info.kind.to_string() + ")"
}

func struct_debug_string[T: Reflect](value: ref T, type_name: Str, fc: I64) -> Str {
    var result: Str = type_name + " {}"
    if fc > 0 {
        result = type_name + " { "
        let base_ptr: I64 = get_ref_ptr(value)
        for i in 0 to fc {
            if i > 0 {
                result = result + ", "
            }
            let fname: Str = field_name[T](i)
            let offset: I64 = field_offset[T](i)
            let raw: I64 = read_field_i64(base_ptr, offset)
            result = result + fname + ": " + raw.to_string()
        }
        result = result + " }"
    }
    return result
}

/// Convert any Reflect type to a JSON-like string representation.
///
/// For struct types, produces: `{"field0": <raw_i64>, "field1": <raw_i64>}`
/// For other types, produces: `{"__type": "TypeName"}`
///
/// Field values are shown as raw I64 bit-pattern values.
pub func to_json[T: Reflect](value: ref T) -> Str {
    let info = value.runtime_type_info()
    let type_name: Str = info.name
    let kind_tag: I32 = info.kind.tag()

    // Struct: kind_tag == 0
    if kind_tag == 0 {
        return struct_to_json(value, info.field_count)
    }

    // Other types
    return "{\"__type\": \"" + type_name + "\"}"
}

func struct_to_json[T: Reflect](value: ref T, fc: I64) -> Str {
    var result: Str = "{"
    if fc > 0 {
        let base_ptr: I64 = get_ref_ptr(value)
        for i in 0 to fc {
            if i > 0 {
                result = result + ", "
            }
            let fname: Str = field_name[T](i)
            let offset: I64 = field_offset[T](i)
            let raw: I64 = read_field_i64(base_ptr, offset)
            result = result + "\"" + fname + "\": " + raw.to_string()
        }
    }
    result = result + "}"
    return result
}
