//! ORDER BY clause types.

use std::db::query::expression::SortDir

/// An ORDER BY clause specifying a column and sort direction.
pub type OrderByClause {
    column: Str,
    direction: SortDir
}

impl OrderByClause {
    /// Creates a new ORDER BY clause with the given column and direction.
    pub func new(column: Str, direction: SortDir) -> OrderByClause {
        return OrderByClause { column: column, direction: direction }
    }

    /// Creates an ascending ORDER BY clause for the given column.
    pub func asc(column: Str) -> OrderByClause {
        return OrderByClause { column: column, direction: SortDir::Asc }
    }

    /// Creates a descending ORDER BY clause for the given column.
    pub func desc(column: Str) -> OrderByClause {
        return OrderByClause { column: column, direction: SortDir::Desc }
    }

    /// Renders the clause to a SQL string (e.g. `"name ASC"`).
    pub func to_sql(this) -> Str {
        return this.column + " " + this.direction.to_sql()
    }
}
