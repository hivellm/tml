//! INSERT query builder.
//!
//! Uses string accumulation instead of List[T] to avoid heavy generic
//! instantiation that causes suite-mode compilation timeouts.

use std::db::query::expression::Expr

/// An INSERT query builder.
pub type InsertQuery {
    table: Str,
    columns_str: Str,
    values_str: Str,
    count: I32
}

impl InsertQuery {
    /// Creates a new INSERT query for the given table.
    pub func new(table: Str) -> InsertQuery {
        return InsertQuery { table: table, columns_str: "", values_str: "", count: 0 }
    }

    /// Adds a column-value pair to the INSERT.
    pub func value(this, column: Str, expr: Expr) -> InsertQuery {
        if this.count == 0 {
            return InsertQuery {
                table: this.table,
                columns_str: column,
                values_str: expr.to_sql(),
                count: 1
            }
        }
        return InsertQuery {
            table: this.table,
            columns_str: this.columns_str + ", " + column,
            values_str: this.values_str + ", " + expr.to_sql(),
            count: this.count + 1
        }
    }

    /// Renders the query to a SQL string.
    pub func to_sql(this) -> Str {
        if this.count == 0 {
            return "INSERT INTO " + this.table + " DEFAULT VALUES"
        }
        return "INSERT INTO " + this.table + " (" + this.columns_str + ") VALUES (" + this.values_str + ")"
    }

    /// Returns the number of column-value pairs.
    pub func len(this) -> I32 {
        return this.count
    }
}
