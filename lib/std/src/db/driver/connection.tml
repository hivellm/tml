//! Database connection behavior.
//!
//! The `Connection` behavior defines the abstract interface for a live database
//! connection.  Concrete implementations (e.g. `SqliteConnection`) wrap the
//! underlying driver and translate its errors into [`DbError`].

use std::db::error::DbError

/// A database connection that can execute queries and manage transactions.
///
/// Every driver must implement this behavior to participate in the db
/// abstraction layer.  Methods that do not return rows use `execute`;
/// methods that produce a result set are handled via `prepare` on the
/// concrete connection type.
pub behavior Connection {
    /// Executes a SQL statement that does not return rows (INSERT, UPDATE, DELETE, DDL).
    ///
    /// Returns the number of rows affected by the statement.
    func execute(this, sql: Str) -> Outcome[I64, DbError]

    /// Tests whether the connection is still alive.
    ///
    /// Returns `true` if the underlying driver reports the connection as open
    /// and usable, `false` otherwise.
    func is_alive(this) -> Bool

    /// Closes the connection and releases any associated resources.
    func close(mut this)

    // ── Transaction support ──────────────────────────────────────────────

    /// Begins a new transaction.
    func begin(this) -> Outcome[Unit, DbError]

    /// Commits the current transaction.
    func commit(this) -> Outcome[Unit, DbError]

    /// Rolls back the current transaction.
    func rollback(this) -> Outcome[Unit, DbError]

    // ── Parameterized execute helpers ────────────────────────────────────

    /// Executes a parameterized statement with one I64 parameter.
    ///
    /// Binds `p1` at position 1.  Returns the number of rows affected.
    func execute_i64_params(this, sql: Str, p1: I64) -> Outcome[I64, DbError]

    /// Executes a parameterized statement with two I64 parameters.
    ///
    /// Binds `p1` at position 1, `p2` at position 2.
    /// Returns the number of rows affected.
    func execute_i64_2(this, sql: Str, p1: I64, p2: I64) -> Outcome[I64, DbError]

    /// Executes a parameterized statement with one Str parameter.
    ///
    /// Binds `p1` at position 1.  Returns the number of rows affected.
    func execute_str(this, sql: Str, p1: Str) -> Outcome[I64, DbError]

    /// Executes a parameterized statement with one Str then one I64 parameter.
    ///
    /// Binds `p1` (Str) at position 1, `p2` (I64) at position 2.
    /// Returns the number of rows affected.
    func execute_str_i64(this, sql: Str, p1: Str, p2: I64) -> Outcome[I64, DbError]

    /// Executes a parameterized statement with one I64 then one Str parameter.
    ///
    /// Binds `p1` (I64) at position 1, `p2` (Str) at position 2.
    /// Returns the number of rows affected.
    func execute_i64_str(this, sql: Str, p1: I64, p2: Str) -> Outcome[I64, DbError]

    // ── Scalar / existence queries ───────────────────────────────────────

    /// Queries a single I64 scalar value (e.g. `COUNT(*)`).
    ///
    /// Returns the value from column 0 of the first row, or 0 on error or
    /// when the result set is empty.
    func query_scalar_i64(this, sql: Str) -> I64

    /// Queries whether at least one row exists, with an I64 parameter.
    ///
    /// Binds `p1` at position 1.  Returns `true` if a row was found,
    /// `false` on error or when no rows match.
    func exists_by_i64(this, sql: Str, p1: I64) -> Bool

    /// Queries whether at least one row exists, with a Str parameter.
    ///
    /// Binds `p1` at position 1.  Returns `true` if a row was found,
    /// `false` on error or when no rows match.
    func exists_by_str(this, sql: Str, p1: Str) -> Bool
}
