//! Database connection pool.
//!
//! Manages a pool of reusable database connections for efficient resource usage.

use std::db::error::{DbError, DbErrorKind}

/// Configuration for the connection pool.
pub type PoolConfig {
    /// Minimum number of connections to keep.
    min_connections: I32,
    /// Maximum number of connections allowed.
    max_connections: I32,
    /// Idle timeout in milliseconds (connections idle longer are closed).
    idle_timeout_ms: I64,
    /// Connection timeout in milliseconds (max wait for a connection).
    connect_timeout_ms: I64
}

impl PoolConfig {
    /// Creates a default pool configuration.
    pub func default() -> PoolConfig {
        return PoolConfig {
            min_connections: 1,
            max_connections: 10,
            idle_timeout_ms: 30000,
            connect_timeout_ms: 5000
        }
    }

    /// Creates a pool configuration with custom min/max.
    pub func new(min_conn: I32, max_conn: I32) -> PoolConfig {
        return PoolConfig {
            min_connections: min_conn,
            max_connections: max_conn,
            idle_timeout_ms: 30000,
            connect_timeout_ms: 5000
        }
    }

    /// Returns the minimum number of connections.
    pub func min_connections(this) -> I32 { return this.min_connections }

    /// Returns the maximum number of connections.
    pub func max_connections(this) -> I32 { return this.max_connections }

    /// Returns the idle timeout in milliseconds.
    pub func idle_timeout_ms(this) -> I64 { return this.idle_timeout_ms }

    /// Returns the connection timeout in milliseconds.
    pub func connect_timeout_ms(this) -> I64 { return this.connect_timeout_ms }
}

/// Statistics about the connection pool.
pub type PoolStats {
    /// Number of connections currently in use.
    active: I32,
    /// Number of idle connections available.
    idle: I32,
    /// Total number of connections (active + idle).
    total: I32,
    /// Number of times a connection was waited for.
    wait_count: I64
}

impl PoolStats {
    /// Creates an empty stats snapshot.
    pub func new() -> PoolStats {
        return PoolStats { active: 0, idle: 0, total: 0, wait_count: 0 }
    }

    /// Returns the number of active (in-use) connections.
    pub func active(this) -> I32 { return this.active }

    /// Returns the number of idle connections.
    pub func idle(this) -> I32 { return this.idle }

    /// Returns the total number of managed connections.
    pub func total(this) -> I32 { return this.total }

    /// Returns how many times a caller had to wait for a connection.
    pub func wait_count(this) -> I64 { return this.wait_count }
}

/// A database connection pool that manages reusable connections.
///
/// Uses a simple counter-based approach: tracks how many connections
/// are active vs idle. Actual connection objects are managed externally.
pub type ConnectionPool {
    config: PoolConfig,
    active_count: I32,
    idle_count: I32,
    total_count: I32,
    wait_count: I64,
    is_closed: Bool
}

impl ConnectionPool {
    /// Creates a new connection pool with the given configuration.
    pub func new(config: PoolConfig) -> ConnectionPool {
        return ConnectionPool {
            config: config,
            active_count: 0,
            idle_count: 0,
            total_count: 0,
            wait_count: 0,
            is_closed: false
        }
    }

    /// Creates a pool with default configuration.
    pub func with_defaults() -> ConnectionPool {
        return ConnectionPool::new(PoolConfig::default())
    }

    /// Acquires a connection from the pool.
    /// Returns Ok(true) if a connection is available, Err if pool is exhausted or closed.
    pub func acquire(mut this) -> Outcome[Bool, DbError] {
        if this.is_closed {
            return Err(DbError::new(DbErrorKind::Pool, "pool is closed"))
        }
        if this.idle_count > 0 {
            this.idle_count = this.idle_count - 1
            this.active_count = this.active_count + 1
            return Ok(true)
        }
        if this.total_count < this.config.max_connections() {
            this.total_count = this.total_count + 1
            this.active_count = this.active_count + 1
            return Ok(true)
        }
        this.wait_count = this.wait_count + 1
        return Err(DbError::new(DbErrorKind::Pool, "pool exhausted"))
    }

    /// Releases a connection back to the pool.
    pub func release(mut this) {
        if this.active_count > 0 {
            this.active_count = this.active_count - 1
            this.idle_count = this.idle_count + 1
        }
    }

    /// Closes all connections in the pool.
    pub func close_all(mut this) {
        this.active_count = 0
        this.idle_count = 0
        this.total_count = 0
        this.is_closed = true
    }

    /// Returns current pool statistics.
    pub func stats(this) -> PoolStats {
        return PoolStats {
            active: this.active_count,
            idle: this.idle_count,
            total: this.total_count,
            wait_count: this.wait_count
        }
    }

    /// Returns the pool configuration.
    pub func config(this) -> PoolConfig {
        return this.config
    }

    /// Returns true if the pool is closed.
    pub func is_closed(this) -> Bool {
        return this.is_closed
    }
}
