//! Migration runner — applies and rolls back migrations.
use std::db::driver::connection::Connection
use std::db::error::{DbError, DbErrorKind}
use std::db::migration::migration::Migration
use std::db::migration::history

/// Ensures the migration history table exists.
///
/// Must be called once before any other migration operations.
pub func ensure_history_table[C](conn: ref C) -> Outcome[Unit, DbError] where C: Connection {
    let result = conn.execute(history::create_history_sql())
    when result {
        Ok(_) => return Ok(()),
        Err(e) => return Err(e)
    }
}

/// Applies a single migration inside a transaction.
///
/// On success, records the migration in `_tml_migrations` and commits.
/// On failure, rolls back the transaction and returns the error.
pub func apply_migration[C](conn: ref C, m: ref Migration) -> Outcome[Unit, DbError] where C: Connection {
    let begin_result = conn.begin()
    when begin_result {
        Ok(_) => {
            let exec_result = conn.execute(m.up_sql())
            when exec_result {
                Ok(_) => {
                    let record_sql = history::record_migration_sql(m.version(), m.name(), m.checksum())
                    let record_result = conn.execute(record_sql)
                    when record_result {
                        Ok(_) => {
                            let commit_result = conn.commit()
                            when commit_result {
                                Ok(_) => return Ok(()),
                                Err(e) => return Err(e)
                            }
                        },
                        Err(e) => {
                            let _ = conn.rollback()
                            return Err(e)
                        }
                    }
                },
                Err(e) => {
                    let _ = conn.rollback()
                    return Err(e)
                }
            }
        },
        Err(e) => return Err(e)
    }
}

/// Rolls back a single migration inside a transaction.
///
/// On success, removes the migration record from `_tml_migrations` and commits.
/// On failure, rolls back the transaction and returns the error.
pub func rollback_migration[C](conn: ref C, m: ref Migration) -> Outcome[Unit, DbError] where C: Connection {
    let begin_result = conn.begin()
    when begin_result {
        Ok(_) => {
            let exec_result = conn.execute(m.down_sql())
            when exec_result {
                Ok(_) => {
                    let remove_sql = history::remove_migration_sql(m.version())
                    let remove_result = conn.execute(remove_sql)
                    when remove_result {
                        Ok(_) => {
                            let commit_result = conn.commit()
                            when commit_result {
                                Ok(_) => return Ok(()),
                                Err(e) => return Err(e)
                            }
                        },
                        Err(e) => {
                            let _ = conn.rollback()
                            return Err(e)
                        }
                    }
                },
                Err(e) => {
                    let _ = conn.rollback()
                    return Err(e)
                }
            }
        },
        Err(e) => return Err(e)
    }
}

/// Returns the current migration version (0 if no migrations have been applied).
pub func current_version[C](conn: ref C) -> Outcome[I64, DbError] where C: Connection {
    let sql = history::latest_version_sql()
    return conn.query_scalar_i64(sql)
}
