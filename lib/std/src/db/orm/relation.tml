//! ORM relations — defines relationships between entities.
//!
//! Uses JoinClause from the query builder to generate JOIN SQL,
//! rather than duplicating SQL generation logic.
//!
//! Inspired by TypeORM's @OneToOne, @OneToMany, @ManyToOne, @ManyToMany.

use std::db::query::join::{JoinClause, JoinType}

/// Relationship types between entities.
@repr(U8)
pub enum RelationType {
    HasOne,
    HasMany,
    BelongsTo,
    ManyToMany
}

impl RelationType {
    /// Returns the string representation of this relation type.
    pub func to_string(this) -> Str {
        when this {
            RelationType::HasOne     => "has_one",
            RelationType::HasMany    => "has_many",
            RelationType::BelongsTo  => "belongs_to",
            RelationType::ManyToMany => "many_to_many"
        }
    }
}

/// Cascade options for a relation.
///
/// Controls which DML operations on the parent are cascaded to child rows.
pub type CascadeOptions {
    on_insert: Bool,
    on_update: Bool,
    on_delete: Bool
}

impl CascadeOptions {
    /// Creates cascade options with all operations disabled.
    pub func none() -> CascadeOptions {
        return CascadeOptions { on_insert: false, on_update: false, on_delete: false }
    }

    /// Creates cascade options with all operations enabled.
    pub func all() -> CascadeOptions {
        return CascadeOptions { on_insert: true, on_update: true, on_delete: true }
    }
}

/// Join-table configuration for M:N relations.
///
/// Describes the pivot/junction table that connects two entities.
pub type JoinTableConfig {
    pivot_table: Str,
    local_col: Str,
    foreign_col: Str
}

/// A relationship definition between two entities (tables).
///
/// `foreign_table` is the target table of the relationship.
/// `foreign_key` is the column on the "many" side (or target for belongs_to).
/// `local_key` is the column on the source side (defaults to "id").
/// `cascade` controls cascading DML options.
/// `join_table_cfg` optionally specifies the pivot table for M:N relations.
/// `has_join_table` indicates whether a JoinTableConfig is set.
/// `inverse_field` names the reverse-side field for bidirectional relations.
/// `has_inverse` indicates whether an inverse field is set.
pub type Relation {
    name: Str,
    rel_type: RelationType,
    foreign_table: Str,
    foreign_key: Str,
    local_key: Str,
    cascade: CascadeOptions,
    join_table_cfg: JoinTableConfig,
    has_join_table: Bool,
    inverse_field: Str,
    has_inverse: Bool
}

impl Relation {
    /// Creates a new relationship definition with all fields explicit.
    pub func new(name: Str, rel_type: RelationType, foreign_table: Str, foreign_key: Str, local_key: Str) -> Relation {
        return Relation {
            name: name,
            rel_type: rel_type,
            foreign_table: foreign_table,
            foreign_key: foreign_key,
            local_key: local_key,
            cascade: CascadeOptions::none(),
            join_table_cfg: JoinTableConfig { pivot_table: "", local_col: "", foreign_col: "" },
            has_join_table: false,
            inverse_field: "",
            has_inverse: false
        }
    }

    /// Creates a has-one relation (like TypeORM's @OneToOne).
    ///
    /// Source table's `id` is referenced by `fk` in the target `table`.
    pub func has_one(name: Str, table: Str, fk: Str) -> Relation {
        return Relation::new(name, RelationType::HasOne, table, fk, "id")
    }

    /// Creates a has-many relation (like TypeORM's @OneToMany).
    ///
    /// Source table's `id` is referenced by `fk` in the target `table`.
    pub func has_many(name: Str, table: Str, fk: Str) -> Relation {
        return Relation::new(name, RelationType::HasMany, table, fk, "id")
    }

    /// Creates a belongs-to relation (like TypeORM's @ManyToOne).
    ///
    /// Source table has column `fk` pointing to target `table.id`.
    pub func belongs_to(name: Str, table: Str, fk: Str) -> Relation {
        return Relation::new(name, RelationType::BelongsTo, table, "id", fk)
    }

    /// Creates a many-to-many relation.
    ///
    /// Requires a join table; `fk` is the foreign key in the join table
    /// pointing to the target table.
    pub func many_to_many(name: Str, table: Str, fk: Str) -> Relation {
        return Relation::new(name, RelationType::ManyToMany, table, fk, "id")
    }

    /// Generates a JoinClause for eager loading this relation.
    ///
    /// Uses the query builder's JoinClause::left to produce a LEFT JOIN,
    /// which is the standard for ORM eager loading (preserves rows with
    /// no matching related records).
    pub func to_join(this, source_table: Str) -> JoinClause {
        let condition = source_table + "." + this.local_key + " = " + this.foreign_table + "." + this.foreign_key
        return JoinClause::left(this.foreign_table, condition)
    }

    /// Generates the JOIN SQL string for this relation.
    ///
    /// Convenience method that calls `to_join` and renders it to SQL.
    pub func join_sql(this, source_table: Str) -> Str {
        return this.to_join(source_table).to_sql()
    }

    /// Returns the relation name.
    pub func rel_name(this) -> Str { return this.name }

    /// Returns the target table name.
    pub func target(this) -> Str { return this.foreign_table }

    /// Returns the relation type.
    pub func kind(this) -> RelationType { return this.rel_type }

    /// Sets cascade options for this relation (4.1).
    ///
    /// `insert` — cascade INSERT, `update` — cascade UPDATE, `delete` — cascade DELETE.
    ///
    /// Example: `r.with_cascade(true, false, true)` cascades inserts and deletes.
    pub func with_cascade(this, insert: Bool, update: Bool, delete: Bool) -> Relation {
        return Relation {
            name: this.name,
            rel_type: this.rel_type,
            foreign_table: this.foreign_table,
            foreign_key: this.foreign_key,
            local_key: this.local_key,
            cascade: CascadeOptions { on_insert: insert, on_update: update, on_delete: delete },
            join_table_cfg: this.join_table_cfg,
            has_join_table: this.has_join_table,
            inverse_field: this.inverse_field,
            has_inverse: this.has_inverse
        }
    }

    /// Configures the pivot/junction table for a M:N relation (4.2).
    ///
    /// `pivot` — name of the join table, `local_col` — column pointing to the source,
    /// `foreign_col` — column pointing to the target.
    pub func join_table(this, pivot: Str, local_col: Str, foreign_col: Str) -> Relation {
        return Relation {
            name: this.name,
            rel_type: this.rel_type,
            foreign_table: this.foreign_table,
            foreign_key: this.foreign_key,
            local_key: this.local_key,
            cascade: this.cascade,
            join_table_cfg: JoinTableConfig { pivot_table: pivot, local_col: local_col, foreign_col: foreign_col },
            has_join_table: true,
            inverse_field: this.inverse_field,
            has_inverse: this.has_inverse
        }
    }

    /// Sets the inverse-side field name for bidirectional relations (4.3).
    ///
    /// This mirrors TypeORM's `inverseSide` option, e.g. `r.inverse_side("user")`.
    pub func inverse_side(this, field_name: Str) -> Relation {
        return Relation {
            name: this.name,
            rel_type: this.rel_type,
            foreign_table: this.foreign_table,
            foreign_key: this.foreign_key,
            local_key: this.local_key,
            cascade: this.cascade,
            join_table_cfg: this.join_table_cfg,
            has_join_table: this.has_join_table,
            inverse_field: field_name,
            has_inverse: true
        }
    }

    /// Returns the cascade options for this relation.
    pub func get_cascade(this) -> CascadeOptions { return this.cascade }

    /// Returns true if a join table is configured.
    pub func has_join_table_cfg(this) -> Bool { return this.has_join_table }

    /// Returns the join table pivot name (empty if not configured).
    pub func pivot_table(this) -> Str {
        if this.has_join_table {
            return this.join_table_cfg.pivot_table
        }
        return ""
    }

    /// Returns the inverse side field name (empty if not set).
    pub func get_inverse(this) -> Str {
        if this.has_inverse {
            return this.inverse_field
        }
        return ""
    }
}
