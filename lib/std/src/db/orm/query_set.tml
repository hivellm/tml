//! QuerySet — fluent query builder for ORM queries.

/// A chainable query builder for model queries.
pub type QuerySet {
    table: Str,
    where_clause: Str,
    order_clause: Str,
    limit_val: I64,
    offset_val: I64,
    has_where: Bool,
    has_order: Bool,
    has_limit: Bool,
    has_offset: Bool,
}

impl QuerySet {
    /// Creates a new QuerySet targeting `table`.
    pub func new(table: Str) -> QuerySet {
        return QuerySet {
            table: table,
            where_clause: "",
            order_clause: "",
            limit_val: 0,
            offset_val: 0,
            has_where: false,
            has_order: false,
            has_limit: false,
            has_offset: false,
        }
    }

    /// Adds a WHERE condition (ANDed with any existing conditions).
    pub func filter(this, condition: Str) -> QuerySet {
        if this.has_where {
            return QuerySet {
                table: this.table,
                where_clause: this.where_clause + " AND " + condition,
                order_clause: this.order_clause,
                limit_val: this.limit_val,
                offset_val: this.offset_val,
                has_where: true,
                has_order: this.has_order,
                has_limit: this.has_limit,
                has_offset: this.has_offset,
            }
        }
        return QuerySet {
            table: this.table,
            where_clause: condition,
            order_clause: this.order_clause,
            limit_val: this.limit_val,
            offset_val: this.offset_val,
            has_where: true,
            has_order: this.has_order,
            has_limit: this.has_limit,
            has_offset: this.has_offset,
        }
    }

    /// Sets the ORDER BY clause.
    pub func order_by(this, clause: Str) -> QuerySet {
        return QuerySet {
            table: this.table,
            where_clause: this.where_clause,
            order_clause: clause,
            limit_val: this.limit_val,
            offset_val: this.offset_val,
            has_where: this.has_where,
            has_order: true,
            has_limit: this.has_limit,
            has_offset: this.has_offset,
        }
    }

    /// Sets a LIMIT on the number of rows returned.
    pub func limit(this, n: I64) -> QuerySet {
        return QuerySet {
            table: this.table,
            where_clause: this.where_clause,
            order_clause: this.order_clause,
            limit_val: n,
            offset_val: this.offset_val,
            has_where: this.has_where,
            has_order: this.has_order,
            has_limit: true,
            has_offset: this.has_offset,
        }
    }

    /// Sets a row OFFSET for pagination.
    pub func offset(this, n: I64) -> QuerySet {
        return QuerySet {
            table: this.table,
            where_clause: this.where_clause,
            order_clause: this.order_clause,
            limit_val: this.limit_val,
            offset_val: n,
            has_where: this.has_where,
            has_order: this.has_order,
            has_limit: this.has_limit,
            has_offset: true,
        }
    }

    /// Renders the full SELECT SQL for this query.
    pub func to_sql(this) -> Str {
        var sql: Str = "SELECT * FROM " + this.table
        if this.has_where  { sql = sql + " WHERE "    + this.where_clause }
        if this.has_order  { sql = sql + " ORDER BY " + this.order_clause }
        if this.has_limit  { sql = sql + " LIMIT "    + this.limit_val.to_string() }
        if this.has_offset { sql = sql + " OFFSET "   + this.offset_val.to_string() }
        return sql
    }

    /// Renders COUNT(*) SQL honoring the current WHERE clause.
    pub func count_sql(this) -> Str {
        var sql: Str = "SELECT COUNT(*) FROM " + this.table
        if this.has_where { sql = sql + " WHERE " + this.where_clause }
        return sql
    }
}
