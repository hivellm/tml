//! Repository — CRUD operations for ORM entities.
//!
//! All functions build complete SQL strings with values inlined and execute
//! via `conn.execute(sql)` or `conn.query_scalar_i64(sql)`.  Only methods
//! from the `Connection` behavior are used; no SQLite-specific helpers.

use std::db::driver::connection::Connection
use std::db::error::{DbError, DbErrorKind}
use std::db::orm::entity::EntityMeta
use std::db::orm::query_set::OrmQuerySet

/// Creates the table for an entity (like TypeORM's synchronize).
pub func sync_entity[C](conn: ref C, entity: ref EntityMeta) -> Outcome[Unit, DbError] where C: Connection {
    let result = conn.execute(entity.create_table_sql())
    when result {
        Ok(_) => Ok(()),
        Err(e) => Err(e)
    }
}

/// Inserts a row with an I64 primary key and a single Str value column.
pub func insert_str[C](conn: ref C, table: Str, pk_val: I64, col_name: Str, col_val: Str) -> Outcome[I64, DbError] where C: Connection {
    let sql = "INSERT INTO " + table + " (id, " + col_name + ") VALUES (" + pk_val.to_string() + ", '" + col_val + "')"
    return conn.execute(sql)
}

/// Returns whether a row with the given primary key exists.
pub func find_one[C](conn: ref C, table: Str, pk_col: Str, pk_val: I64) -> Outcome[Bool, DbError] where C: Connection {
    let sql = "SELECT COUNT(*) FROM " + table + " WHERE " + pk_col + " = " + pk_val.to_string()
    let result = conn.query_scalar_i64(sql)
    when result {
        Ok(n) => Ok(n > 0),
        Err(e) => Err(e)
    }
}

/// Counts all rows in a table.
pub func count[C](conn: ref C, table: Str) -> Outcome[I64, DbError] where C: Connection {
    let sql = "SELECT COUNT(*) FROM " + table
    return conn.query_scalar_i64(sql)
}

/// Deletes a row by primary key.
pub func delete_by_id[C](conn: ref C, table: Str, pk_col: Str, pk_val: I64) -> Outcome[I64, DbError] where C: Connection {
    let sql = "DELETE FROM " + table + " WHERE " + pk_col + " = " + pk_val.to_string()
    return conn.execute(sql)
}

/// Updates a single I64 column by primary key.
pub func update_i64_by_id[C](conn: ref C, table: Str, col: Str, new_val: I64, pk_col: Str, pk_val: I64) -> Outcome[I64, DbError] where C: Connection {
    let sql = "UPDATE " + table + " SET " + col + " = " + new_val.to_string() + " WHERE " + pk_col + " = " + pk_val.to_string()
    return conn.execute(sql)
}

/// Updates a single Str column by primary key.
pub func update_str_by_id[C](conn: ref C, table: Str, col: Str, new_val: Str, pk_col: Str, pk_val: I64) -> Outcome[I64, DbError] where C: Connection {
    let sql = "UPDATE " + table + " SET " + col + " = '" + new_val + "' WHERE " + pk_col + " = " + pk_val.to_string()
    return conn.execute(sql)
}

/// Executes raw SQL directly (for DDL or complex statements).
pub func exec[C](conn: ref C, sql: Str) -> Outcome[I64, DbError] where C: Connection {
    return conn.execute(sql)
}

/// Creates a [`OrmQuerySet`] for fluent queries on the given table.
pub func query(table: Str) -> OrmQuerySet {
    return OrmQuerySet::new(table)
}

/// Inserts or replaces a row (upsert) with an I64 primary key and a single Str value column.
pub func save[C](conn: ref C, table: Str, pk_val: I64, col_name: Str, col_val: Str) -> Outcome[I64, DbError] where C: Connection {
    let sql = "INSERT OR REPLACE INTO " + table + " (id, " + col_name + ") VALUES (" + pk_val.to_string() + ", '" + col_val + "')"
    return conn.execute(sql)
}

/// Finds the first row where `col = val` (Str value).
pub func find_by[C](conn: ref C, table: Str, col: Str, val: Str) -> Outcome[Bool, DbError] where C: Connection {
    let sql = "SELECT COUNT(*) FROM " + table + " WHERE " + col + " = '" + val + "'"
    let result = conn.query_scalar_i64(sql)
    when result {
        Ok(n) => Ok(n > 0),
        Err(e) => Err(e)
    }
}

/// Finds rows matching a WHERE clause, up to `limit` rows, returning the count found.
pub func find_many[C](conn: ref C, table: Str, where_clause: Str, limit: I64) -> Outcome[I64, DbError] where C: Connection {
    let sql = "SELECT COUNT(*) FROM (SELECT 1 FROM " + table + " WHERE " + where_clause + " LIMIT " + limit.to_string() + ")"
    return conn.query_scalar_i64(sql)
}

/// Counts rows matching a WHERE condition.
pub func count_where[C](conn: ref C, table: Str, condition: Str) -> Outcome[I64, DbError] where C: Connection {
    let sql = "SELECT COUNT(*) FROM " + table + " WHERE " + condition
    return conn.query_scalar_i64(sql)
}

/// Soft-deletes a row by setting `deleted_at` to a timestamp string.
pub func soft_delete[C](conn: ref C, table: Str, pk_col: Str, pk_val: I64, timestamp: Str) -> Outcome[I64, DbError] where C: Connection {
    let sql = "UPDATE " + table + " SET deleted_at = '" + timestamp + "' WHERE " + pk_col + " = " + pk_val.to_string()
    return conn.execute(sql)
}

/// Restores a soft-deleted row by setting `deleted_at` to NULL.
pub func restore[C](conn: ref C, table: Str, pk_col: Str, pk_val: I64) -> Outcome[I64, DbError] where C: Connection {
    let sql = "UPDATE " + table + " SET deleted_at = NULL WHERE " + pk_col + " = " + pk_val.to_string()
    return conn.execute(sql)
}

/// Atomically increments an I64 column by the given amount.
pub func increment[C](conn: ref C, table: Str, col: Str, amount: I64, pk_col: Str, pk_val: I64) -> Outcome[I64, DbError] where C: Connection {
    let sql = "UPDATE " + table + " SET " + col + " = " + col + " + " + amount.to_string() + " WHERE " + pk_col + " = " + pk_val.to_string()
    return conn.execute(sql)
}

/// Returns whether any row exists where `col = val` (Str value).
pub func exists[C](conn: ref C, table: Str, col: Str, val: Str) -> Outcome[Bool, DbError] where C: Connection {
    let sql = "SELECT COUNT(*) FROM " + table + " WHERE " + col + " = '" + val + "'"
    let result = conn.query_scalar_i64(sql)
    when result {
        Ok(n) => Ok(n > 0),
        Err(e) => Err(e)
    }
}
