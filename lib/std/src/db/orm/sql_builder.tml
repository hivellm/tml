//! Pure SQL string building helpers for ORM operations.
//!
//! These functions produce SQL strings without requiring a live database
//! connection. Use them when constructing queries to pass to a driver.

/// Returns a SELECT * SQL string for all rows in `table`.
pub func find_all_sql(table: Str) -> Str {
    return "SELECT * FROM " + table
}

/// Returns a SELECT * SQL string that filters by primary key value.
pub func find_by_id_sql(table: Str, pk_col: Str, pk_val: I64) -> Str {
    return "SELECT * FROM " + table + " WHERE " + pk_col + " = " + pk_val.to_string()
}

/// Returns an INSERT INTO SQL string.
///
/// `columns` — comma-separated column list
/// `values`  — comma-separated value list (literals or SQL expressions)
pub func insert_sql(table: Str, columns: Str, values: Str) -> Str {
    return "INSERT INTO " + table + " (" + columns + ") VALUES (" + values + ")"
}

/// Returns an UPDATE SET SQL string filtered by primary key.
pub func update_sql(table: Str, set_clause: Str, pk_col: Str, pk_val: I64) -> Str {
    return "UPDATE " + table + " SET " + set_clause + " WHERE " + pk_col + " = " + pk_val.to_string()
}

/// Returns a DELETE SQL string filtered by primary key.
pub func delete_sql(table: Str, pk_col: Str, pk_val: I64) -> Str {
    return "DELETE FROM " + table + " WHERE " + pk_col + " = " + pk_val.to_string()
}

/// Returns a COUNT(*) SQL string.
pub func count_sql(table: Str) -> Str {
    return "SELECT COUNT(*) FROM " + table
}
