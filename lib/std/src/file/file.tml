//! File I/O operations.
//!
//! Provides the [`File`] type for reading and writing files.
//!
//! # Example
//!
//! ```tml
//! use std::file::File
//!
//! let content = File::read_all("config.txt")
//! File::write_all("output.txt", "Hello, World!")
//! ```


// FFI declarations for C runtime file operations
@extern("file_open_read")
func ffi_file_open_read(path: Str) -> *Unit

@extern("file_open_write")
func ffi_file_open_write(path: Str) -> *Unit

@extern("file_open_append")
func ffi_file_open_append(path: Str) -> *Unit

@extern("file_close")
func ffi_file_close(handle: *Unit)

@extern("file_is_open")
func ffi_file_is_open(handle: *Unit) -> Bool

@allocates
@extern("file_read_line")
func ffi_file_read_line(handle: *Unit) -> Str

@extern("file_write_str")
func ffi_file_write_str(handle: *Unit, content: Str) -> Bool

@extern("file_size")
func ffi_file_size(handle: *Unit) -> I64

@extern("file_flush")
func ffi_file_flush(handle: *Unit) -> Bool

@extern("file_seek_from")
func ffi_file_seek_from(handle: *Unit, offset: I64, whence: I32) -> I64

@allocates
@extern("file_read_all")
func ffi_file_read_all(path: Str) -> Str

@extern("file_write_all")
func ffi_file_write_all(path: Str, content: Str) -> Bool

@extern("file_append_all")
func ffi_file_append_all(path: Str, content: Str) -> Bool

// Binary I/O FFI declarations
@extern("file_read_bytes")
func ffi_file_read_bytes(handle: *Unit, buf_ptr: I64, count: I64) -> I64

@extern("file_write_bytes")
func ffi_file_write_bytes(handle: *Unit, buf_ptr: I64, count: I64) -> I64

@extern("file_get_file_size")
func ffi_file_get_file_size(path: Str) -> I64

@extern("file_read_all_bytes")
func ffi_file_read_all_bytes(path: Str, buf_ptr: I64, buf_capacity: I64) -> I64

@extern("file_write_all_bytes")
func ffi_file_write_all_bytes(path: Str, buf_ptr: I64, count: I64) -> Bool

// File metadata FFI declarations
@extern("file_metadata_size")
func ffi_file_metadata_size(path: Str) -> I64

@extern("file_metadata_modified")
func ffi_file_metadata_modified(path: Str) -> I64

@extern("file_metadata_is_readonly")
func ffi_file_metadata_is_readonly(path: Str) -> Bool

use std::collections::Buffer

/// Metadata about a file or directory.
///
/// Contains size, modification time, and permission information.
///
/// # Example
///
/// ```tml
/// let meta: FileMetadata = File::metadata("config.txt")
/// print(meta.size.to_string())
/// ```
pub type FileMetadata {
    /// Size in bytes. -1 if the file does not exist.
    size: I64,
    /// Last modification time as a Unix timestamp (seconds since epoch).
    /// -1 if unavailable.
    modified: I64,
    /// True if the file is read-only.
    is_readonly: Bool
}

/// A file handle for reading and writing operations.
///
/// `File` provides both instance methods for streaming I/O
/// and static methods for simple read/write operations.
///
/// # Example
///
/// ```tml
/// let file = File::open_read("data.txt")
/// let line = file.read_line()
/// file.close()
/// ```
pub type File {
    handle: *Unit
}

impl File {
    /// Open a file for reading
    pub func open_read(path: Str) -> File {
        let h: *Unit = ffi_file_open_read(path)
        File { handle: h }
    }

    /// Open a file for writing (creates or truncates)
    pub func open_write(path: Str) -> File {
        let h: *Unit = ffi_file_open_write(path)
        File { handle: h }
    }

    /// Open a file for appending
    pub func open_append(path: Str) -> File {
        let h: *Unit = ffi_file_open_append(path)
        File { handle: h }
    }

    /// Check if the file is open
    pub func is_open(this) -> Bool {
        return ffi_file_is_open(this.handle)
    }

    /// Read a single line from the file
    pub func read_line(this) -> Str {
        return ffi_file_read_line(this.handle)
    }

    /// Write a string to the file
    pub func write_str(this, content: Str) -> Bool {
        return ffi_file_write_str(this.handle, content)
    }

    /// Get the size of the file in bytes
    pub func size(this) -> I64 {
        return ffi_file_size(this.handle)
    }

    /// Flush buffered data to disk.
    pub func flush(this) -> Bool {
        return ffi_file_flush(this.handle)
    }

    /// Close the file
    pub func close(this) {
        ffi_file_close(this.handle)
    }

    /// Read binary data from the file into a Buffer.
    ///
    /// Reads up to `count` bytes from the current file position.
    /// Returns a Buffer containing the bytes actually read.
    ///
    /// # Example
    ///
    /// ```tml
    /// let file = File::open_read("image.png")
    /// let header: Buffer = file.read_bytes(8)
    /// file.close()
    /// ```
    pub func read_bytes(this, count: I64) -> Buffer {
        var buf: Buffer = Buffer::new(count)
        if count <= 0 {
            return buf
        }
        // Allocate temp buffer, read into it, copy to Buffer, free temp
        let tmp: *Unit = lowlevel { mem_alloc(count) }
        let n: I64 = ffi_file_read_bytes(this.handle, tmp as I64, count)
        if n > 0 {
            buf.write_from_ptr(tmp as I64, n)
        }
        lowlevel { mem_free(tmp) }
        return buf
    }

    /// Write binary data from a Buffer to the file.
    ///
    /// Writes the entire contents of the buffer.
    /// Returns the number of bytes actually written.
    ///
    /// # Example
    ///
    /// ```tml
    /// let file = File::open_write("output.bin")
    /// var buf: Buffer = Buffer::new(4)
    /// buf.write_byte(0x89)
    /// buf.write_byte(0x50)
    /// let written: I64 = file.write_bytes(buf)
    /// file.close()
    /// ```
    pub func write_bytes(this, data: Buffer) -> I64 {
        let ptr: I64 = data.data_ptr()
        let count: I64 = data.len()
        return ffi_file_write_bytes(this.handle, ptr, count)
    }

    // ========== Static utility functions ==========

    /// Read entire file contents as a string
    pub func read_all(path: Str) -> Str {
        let result = ffi_file_read_all(path)
        return result
    }

    /// Write content to a file (overwrites if exists)
    pub func write_all(path: Str, content: Str) -> Bool {
        let result = ffi_file_write_all(path, content)
        return result
    }

    /// Append content to a file
    pub func append_all(path: Str, content: Str) -> Bool {
        return ffi_file_append_all(path, content)
    }

    /// Read entire file contents as binary data.
    ///
    /// Returns a Buffer containing all bytes from the file.
    ///
    /// # Example
    ///
    /// ```tml
    /// let data: Buffer = File::read_all_bytes("image.png")
    /// print(data.len().to_string())
    /// ```
    pub func read_all_bytes(path: Str) -> Buffer {
        let file_size: I64 = ffi_file_get_file_size(path)
        if file_size <= 0 {
            return Buffer::new(0)
        }
        var buf: Buffer = Buffer::new(file_size)
        // Allocate temp buffer, read into it, copy to Buffer, free temp
        let tmp: *Unit = lowlevel { mem_alloc(file_size) }
        let n: I64 = ffi_file_read_all_bytes(path, tmp as I64, file_size)
        if n > 0 {
            buf.write_from_ptr(tmp as I64, n)
        }
        lowlevel { mem_free(tmp) }
        return buf
    }

    /// Write binary data to a file (overwrites if exists).
    ///
    /// Returns true if all bytes were written successfully.
    ///
    /// # Example
    ///
    /// ```tml
    /// var buf: Buffer = Buffer::new(16)
    /// buf.write_str("hello binary")
    /// File::write_all_bytes("output.bin", buf)
    /// ```
    pub func write_all_bytes(path: Str, data: Buffer) -> Bool {
        let ptr: I64 = data.data_ptr()
        let count: I64 = data.len()
        return ffi_file_write_all_bytes(path, ptr, count)
    }

    /// Get metadata for a file or directory.
    ///
    /// Returns a `FileMetadata` with size, modification time, and
    /// permission information. If the path does not exist, `size`
    /// and `modified` will be -1.
    ///
    /// # Example
    ///
    /// ```tml
    /// let meta: FileMetadata = File::metadata("config.txt")
    /// if meta.size >= 0 {
    ///     print("Size: " + meta.size.to_string())
    /// }
    /// ```
    pub func metadata(path: Str) -> FileMetadata {
        let s: I64 = ffi_file_metadata_size(path)
        let m: I64 = ffi_file_metadata_modified(path)
        let ro: Bool = ffi_file_metadata_is_readonly(path)
        return FileMetadata {
            size: s,
            modified: m,
            is_readonly: ro
        }
    }
}

use std::stream::seek::{Seek, SeekFrom}
use core::runtime::error::{IoError, IoErrorKind}

impl Seek for File {
    /// Seek to a position in the file.
    ///
    /// Uses the C runtime `file_seek_from` which wraps `fseek`/`ftell`.
    /// Returns the new absolute position, or an error.
    pub func seek(mut this, pos: SeekFrom) -> Outcome[I64, IoError] {
        // whence: 0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END
        var offset: I64 = 0
        var whence: I32 = 0
        when pos {
            Start(o) => {
                offset = o
                whence = 0
            },
            Current(o) => {
                offset = o
                whence = 1
            },
            End(o) => {
                offset = o
                whence = 2
            },
        }
        let result: I64 = ffi_file_seek_from(this.handle, offset, whence)
        if result < 0 {
            return Err(IoError::with_message(
                IoErrorKind::Other,
                "file seek failed"
            ))
        }
        return Ok(result)
    }
}
