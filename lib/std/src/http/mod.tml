//! HTTP — complete HTTP/1.1 stack with NestJS-style framework.
//!
//! ## Module Structure
//!
//! | Module | Contents |
//! |--------|----------|
//! | `protocol` | method, status, version, headers, error, cookie, chunked, functions |
//! | `server` | HTTP server, workers, IOCP, dispatch, parsing, connections |
//! | `client` | HTTP client, agent, connection pool |
//! | `request` | request/response types, body parser, content type, multipart, encoding |
//! | `middleware` | CORS, security, ETag, cache, rate limit, compression, SSE, static files |
//! | `router` | radix-tree URL router |
//! | `app` | application framework, controller, arena |
//! | `websocket` | WebSocket protocol (RFC 6455) |
//! | `h2` | HTTP/2 protocol (RFC 7540 + RFC 7541) |
//! | `framework` | NestJS-style: JsonResponse, guards, pipes, interceptors |

// ── Subdirectory modules ─────────────────────────────────────
pub mod protocol
pub mod server
pub mod client
pub mod request
pub mod middleware
pub mod router
pub mod app
pub mod websocket

// ── Pre-existing subdirectory modules ────────────────────────
pub mod h2
pub mod framework

// ── Re-exports for backward compatibility ────────────────────
// These keep all existing `use std::http::X` import paths working.
// New code should prefer the organized paths, e.g. `std::http::protocol::method::Method`.

// protocol/
pub use std::http::protocol::method::Method
pub use std::http::protocol::status::Status
pub use std::http::protocol::version::HttpVersion
pub use std::http::protocol::headers::Headers
pub use std::http::protocol::error::{HttpError, HttpErrorKind}
pub use std::http::protocol::cookie::Cookie
pub use std::http::protocol::chunked::{encode_chunk, encode_final_chunk, encode_body_chunked, decode_chunked, recv_chunked_body, ChunkedResult}
pub use std::http::protocol::functions::{methods, status_codes, validate_header_name, validate_header_value, MAX_HEADER_SIZE}

// server/
pub use std::http::server::server::HttpServer
pub use std::http::server::incoming::{IncomingMessage, parse_request}
pub use std::http::server::server_response::ServerResponse
pub use std::http::server::connection::{Connection, ConnectionInfo}

// client/
pub use std::http::client::client::HttpClient
pub use std::http::client::agent::{Agent, AgentOptions}

// request/
pub use std::http::request::request::Request
pub use std::http::request::response::Response
pub use std::http::request::multipart::{MultipartBuilder, MultipartPart}
pub use std::http::request::content_type::{parse_content_type, matches_type, negotiate}
pub use std::http::request::body_parser::{ParsedBody, parse_body, form_get, url_decode}
// NOTE: encoding re-exports omitted to avoid pulling in std::zlib (zstd/brotli/zlib DLLs).
// Import directly: use std::http::request::encoding::{compress, decompress}

// router/
pub use std::http::router::router::{Router, RouteMatch}

// app/
pub use std::http::app::controller::{Controller, ControllerInfo, register_controller, register_controllers, register_all}

// middleware/
pub use std::http::middleware::cors::{CorsOptions, cors_headers, preflight_headers, is_preflight}
pub use std::http::middleware::security::{SecurityOptions, security_headers}
pub use std::http::middleware::etag::{generate, generate_weak, is_not_modified}
pub use std::http::middleware::stream::{SseEvent, sse_headers, sse_ping, sse_comment, streaming_headers, ndjson_headers, ndjson_line}
pub use std::http::middleware::range::{ByteRange, parse_range, content_range, content_range_unsatisfied, is_range_satisfiable}
pub use std::http::middleware::cache_control::{CacheOptions, cache_control_header}
pub use std::http::middleware::rate_limit::{RateLimitOptions, RateLimitResult, RateLimiter}
pub use std::http::middleware::static_server::{StaticOptions, resolve_path, get_extension, mime_for_extension, static_file_headers}
pub use std::http::middleware::compression::{CompressionOptions, select_encoding, should_compress, compress_response}

// websocket/
pub use std::http::websocket::websocket::{WsOpcode, WsCloseCode, WsError, WsFrame, WsMessage, ws_accept_key, ws_upgrade_response, ws_validate_upgrade, ws_encode_frame, ws_decode_frame, ws_assemble_message, ws_close_frame, ws_apply_mask, ws_mask, ws_unmask}

// ── Internal module re-exports (for test access) ────────────────
// app/
pub use std::http::app::arena::Arena
pub use std::http::app::bytes::Bytes

// client/
pub use std::http::client::conn_pool::{ConnectionPool, PoolEntry}

// server/ internal
pub use std::http::server::dispatch::{app_status_text, generate_request_id, app_log_request, app_build_response, app_http_date}
pub use std::http::server::parse::{app_is_bodyless_method, app_find_header_end_in_str, app_extract_query, app_extract_path_from_url, app_zerocopy_method, app_zerocopy_path, app_is_http11, app_extract_method, app_extract_path, app_has_header_end, app_has_connection_close, app_count_requests, app_store_param, app_parse_headers, app_has_chunked_encoding, app_percent_decode, MAX_HEADERS, HEADER_ENTRY_SIZE}
pub use std::http::server::shared_state::SharedConfig
pub use std::http::server::simd_parse::{find_crlf, find_colon, find_space, find_header_end, count_headers}
pub use std::http::server::vectored_io::{send_two, send_response_parts}
pub use std::http::server::work_stealing::{LocalQueue, WorkStealingScheduler}

// request/ internal
pub use std::http::request::encoding::{compress, decompress, accepted_encodings}
