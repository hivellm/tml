//! HTTP server response — builds and sends responses to clients.
//!
//! Corresponds to Node.js `http.ServerResponse`. Provides a builder
//! interface for setting status, headers, and body, then serializes
//! and sends the complete HTTP/1.1 response.

use core::str
use core::intrinsics::{ptr_read, ptr_write, copy_nonoverlapping, mem_alloc, mem_free}
use std::http::headers::Headers
use std::http::error::{HttpError, HttpErrorKind}
use std::http::cookie::Cookie
use core::fmt::helpers::i64_to_str

/// Returns the standard reason phrase for an HTTP status code.
func get_reason_phrase(code: I64) -> Str {
    if code == 100 { return "Continue" }
    if code == 101 { return "Switching Protocols" }
    if code == 102 { return "Processing" }
    if code == 103 { return "Early Hints" }
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 202 { return "Accepted" }
    if code == 204 { return "No Content" }
    if code == 206 { return "Partial Content" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 303 { return "See Other" }
    if code == 304 { return "Not Modified" }
    if code == 307 { return "Temporary Redirect" }
    if code == 308 { return "Permanent Redirect" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 408 { return "Request Timeout" }
    if code == 409 { return "Conflict" }
    if code == 413 { return "Payload Too Large" }
    if code == 415 { return "Unsupported Media Type" }
    if code == 422 { return "Unprocessable Entity" }
    if code == 429 { return "Too Many Requests" }
    if code == 500 { return "Internal Server Error" }
    if code == 501 { return "Not Implemented" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    if code == 504 { return "Gateway Timeout" }
    return "Unknown"
}

// ── Header helpers (reconstruct Headers from raw pointer) ──

/// Reconstructs a Headers wrapper from a raw handle pointer.
/// Headers is just `{ handle: *Unit }` — we create the wrapper and overwrite
/// its handle field to point at the existing allocation.
func headers_from_ptr(hdr_ptr: I64) -> Headers {
    let hdrs: Headers = Headers { handle: hdr_ptr as *Unit }
    hdrs
}

/// Sets a header in the raw headers block pointed to by hdr_ptr.
func headers_set_raw(hdr_ptr: I64, name: Str, value: Str) {
    if hdr_ptr == 0 { return }
    let hdrs: Headers = headers_from_ptr(hdr_ptr)
    hdrs.set(name, value)
}

/// Gets a header from the raw headers block.
func headers_get_raw(hdr_ptr: I64, name: Str) -> Str {
    if hdr_ptr == 0 { return "" }
    let hdrs: Headers = headers_from_ptr(hdr_ptr)
    hdrs.get(name)
}

/// Checks if a header exists in the raw headers block.
func headers_has_raw(hdr_ptr: I64, name: Str) -> Bool {
    if hdr_ptr == 0 { return false }
    let hdrs: Headers = headers_from_ptr(hdr_ptr)
    hdrs.has(name)
}

/// Serializes all headers to wire format.
func headers_serialize_raw(hdr_ptr: I64) -> Str {
    if hdr_ptr == 0 { return "" }
    let hdrs: Headers = headers_from_ptr(hdr_ptr)
    hdrs.serialize()
}

/// An HTTP response being constructed on the server side.
pub type ServerResponse {
    resp_status_code: I64,
    resp_status_message: Str,
    resp_headers_ptr: I64,
    body_chunks: I64,
    body_chunk_count: I64,
    body_chunk_cap: I64,
    body_total_len: I64,
    headers_sent: Bool,
    finished: Bool,
    send_date: Bool,
    socket_fd: I64,
    req_method: Str,
}

impl ServerResponse {
    /// Creates a new ServerResponse with default 200 OK status.
    pub func new() -> ServerResponse {
        let hdrs: Headers = Headers::new()
        let hdrs_addr: I64 = (ref hdrs) as I64
        let hdrs_ptr: I64 = lowlevel { ptr_read[I64](hdrs_addr as *I64) }
        ServerResponse {
            resp_status_code: 200,
            resp_status_message: "",
            resp_headers_ptr: hdrs_ptr,
            body_chunks: lowlevel { mem_alloc(64) } as I64,
            body_chunk_count: 0,
            body_chunk_cap: 8,
            body_total_len: 0,
            headers_sent: false,
            finished: false,
            send_date: true,
            socket_fd: -1 as I64,
            req_method: "",
        }
    }

    /// Creates a ServerResponse tied to a socket and request method.
    pub func for_request(fd: I64, method: Str) -> ServerResponse {
        let hdrs: Headers = Headers::new()
        let hdrs_addr: I64 = (ref hdrs) as I64
        let hdrs_ptr: I64 = lowlevel { ptr_read[I64](hdrs_addr as *I64) }
        ServerResponse {
            resp_status_code: 200,
            resp_status_message: "",
            resp_headers_ptr: hdrs_ptr,
            body_chunks: lowlevel { mem_alloc(64) } as I64,
            body_chunk_count: 0,
            body_chunk_cap: 8,
            body_total_len: 0,
            headers_sent: false,
            finished: false,
            send_date: true,
            socket_fd: fd,
            req_method: method,
        }
    }

    // ── Status ───────────────────────────────────────────────────

    pub func set_status(mut this, code: I64) { this.resp_status_code = code }
    pub func status_code(this) -> I64 { this.resp_status_code }
    pub func set_status_message(mut this, message: Str) { this.resp_status_message = message }

    pub func status_message(this) -> Str {
        if str::len(this.resp_status_message) > 0 {
            return this.resp_status_message
        }
        return get_reason_phrase(this.resp_status_code)
    }

    // ── Headers ──────────────────────────────────────────────────

    pub func set_header(this, name: Str, value: Str) {
        headers_set_raw(this.resp_headers_ptr, name, value)
    }

    pub func get_header(this, name: Str) -> Str {
        return headers_get_raw(this.resp_headers_ptr, name)
    }

    pub func has_header(this, name: Str) -> Bool {
        return headers_has_raw(this.resp_headers_ptr, name)
    }

    pub func is_headers_sent(this) -> Bool { this.headers_sent }
    pub func set_send_date(mut this, send: Bool) { this.send_date = send }

    // ── Write Head ───────────────────────────────────────────────

    pub func write_head(mut this, code: I64, message: Str) {
        this.resp_status_code = code
        if str::len(message) > 0 {
            this.resp_status_message = message
        }
        this.headers_sent = true
    }

    pub func write_head_simple(mut this, code: I64) {
        this.resp_status_code = code
        this.headers_sent = true
    }

    // ── Body Writing ─────────────────────────────────────────────

    pub func write(mut this, chunk: Str) {
        let chunk_len: I64 = str::len(chunk)
        if chunk_len == 0 { return }

        if this.body_chunk_count >= this.body_chunk_cap {
            let new_cap: I64 = this.body_chunk_cap * 2
            let new_chunks: I64 = lowlevel { mem_alloc(new_cap * 8) } as I64
            lowlevel { copy_nonoverlapping(this.body_chunks as *Unit, new_chunks as *Unit, this.body_chunk_cap * 8) }
            lowlevel { mem_free(this.body_chunks as *Unit) }
            this.body_chunks = new_chunks
            this.body_chunk_cap = new_cap
        }

        let chunk_copy: I64 = lowlevel { mem_alloc(chunk_len + 1) } as I64
        lowlevel { copy_nonoverlapping(chunk as *Unit, chunk_copy as *Unit, chunk_len) }
        lowlevel { ptr_write[U8]((chunk_copy + chunk_len) as *U8, 0 as U8) }

        lowlevel { ptr_write[I64]((this.body_chunks + this.body_chunk_count * 8) as *I64, chunk_copy) }
        this.body_chunk_count = this.body_chunk_count + 1
        this.body_total_len = this.body_total_len + chunk_len

        if not this.headers_sent { this.headers_sent = true }
    }

    pub func end(mut this, data: Str) {
        if str::len(data) > 0 { this.write(data) }
        this.finished = true
        if not this.headers_sent { this.headers_sent = true }
    }

    pub func end_empty(mut this) {
        this.finished = true
        if not this.headers_sent { this.headers_sent = true }
    }

    pub func is_finished(this) -> Bool { this.finished }

    // ── Special Response Methods ─────────────────────────────────

    pub func write_continue() -> Str { "HTTP/1.1 100 Continue\r\n\r\n" }
    pub func write_processing() -> Str { "HTTP/1.1 102 Processing\r\n\r\n" }

    pub func write_early_hints(link: Str) -> Str {
        return "HTTP/1.1 103 Early Hints\r\nLink: {link}\r\n\r\n"
    }

    pub func flush_headers(mut this) { this.headers_sent = true }

    // ── Convenience Methods (cmmv-server / Express style) ────────

    /// Send a response body, auto-detecting content type if not set.
    /// Sets Content-Length and finishes the response.
    pub func send(mut this, body: Str) {
        let body_len: I64 = str::len(body)
        if body_len > 0 and not this.has_header("content-type") {
            // Auto-detect: if starts with '{' or '[', assume JSON; otherwise text
            let first: I32 = str::char_at(body, 0)
            if first == 123 or first == 91 {  // '{' or '['
                this.set_header("content-type", "application/json; charset=utf-8")
            } else if first == 60 {  // '<'
                this.set_header("content-type", "text/html; charset=utf-8")
            } else {
                this.set_header("content-type", "text/plain; charset=utf-8")
            }
        }
        this.end(body)
    }

    /// Send a JSON response. Sets content-type to application/json.
    pub func json(mut this, data: Str) {
        this.set_header("content-type", "application/json; charset=utf-8")
        this.end(data)
    }

    /// Send an HTML response. Sets content-type to text/html.
    pub func html(mut this, body: Str) {
        this.set_header("content-type", "text/html; charset=utf-8")
        this.end(body)
    }

    /// Send a plain text response. Sets content-type to text/plain.
    pub func text(mut this, body: Str) {
        this.set_header("content-type", "text/plain; charset=utf-8")
        this.end(body)
    }

    /// Send a redirect response (default 302 Found).
    pub func redirect(mut this, url: Str) {
        this.resp_status_code = 302
        this.set_header("location", url)
        this.set_header("content-length", "0")
        this.finished = true
        if not this.headers_sent { this.headers_sent = true }
    }

    /// Send a redirect response with a specific status code (301, 302, 307, 308).
    pub func redirect_with(mut this, status: I64, url: Str) {
        this.resp_status_code = status
        this.set_header("location", url)
        this.set_header("content-length", "0")
        this.finished = true
        if not this.headers_sent { this.headers_sent = true }
    }

    /// Set the Content-Type header.
    pub func type_set(this, mime: Str) {
        this.set_header("content-type", mime)
    }

    /// Add a field to the Vary header (appends if already set).
    pub func vary(this, field: Str) {
        let existing: Str = this.get_header("vary")
        if str::len(existing) == 0 {
            this.set_header("vary", field)
        } else {
            this.set_header("vary", existing + ", " + field)
        }
    }

    /// Chainable status setter. Returns nothing (TML doesn't support ref Self return).
    /// Use: res.status(404); res.json("{\"error\":\"not found\"}")
    pub func status(mut this, code: I64) {
        this.resp_status_code = code
    }

    // ── Cookie Methods ──────────────────────────────────────────

    /// Set a cookie on the response. Appends a Set-Cookie header.
    /// Usage: res.cookie(Cookie::new("session", "abc123").with_http_only().with_path("/"))
    pub func set_cookie(this, c: Cookie) {
        let value: Str = c.to_set_cookie()
        // Set-Cookie headers don't overwrite — each cookie gets its own header.
        // Since our headers use set() (which overwrites), we use a workaround:
        // append to existing Set-Cookie value with \r\nSet-Cookie: separator.
        let existing: Str = this.get_header("set-cookie")
        if str::len(existing) > 0 {
            this.set_header("set-cookie", existing + "\r\nSet-Cookie: " + value)
        } else {
            this.set_header("set-cookie", value)
        }
    }

    /// Set a simple name=value cookie with defaults (Path=/, HttpOnly).
    pub func cookie(this, name: Str, value: Str) {
        let c: Cookie = Cookie::new(name, value).with_http_only()
        this.set_cookie(c)
    }

    /// Clear a cookie by setting Max-Age=0.
    pub func clear_cookie(this, name: Str) {
        let c: Cookie = Cookie::new(name, "").with_max_age(0)
        this.set_cookie(c)
    }

    // ── Serialization ────────────────────────────────────────────

    /// Serialize the entire response to a single HTTP/1.1 response string.
    /// Uses single-buffer allocation for performance — no string interpolation.
    pub func serialize(this) -> Str {
        // Set auto-headers before serializing
        if this.body_total_len > 0 and not this.has_header("content-length") {
            this.set_header("content-length", i64_to_str(this.body_total_len))
        }
        if this.body_total_len == 0 and not this.has_header("content-length")
            and not this.has_header("transfer-encoding") {
            this.set_header("content-length", "0")
        }
        if not this.has_header("connection") {
            this.set_header("connection", "keep-alive")
        }
        if not this.has_header("server") {
            this.set_header("server", "TML")
        }

        // Get status line components
        let status_line: Str = fast_status_line(this.resp_status_code)
        let has_precomputed: Bool = str::len(status_line) > 0

        // Custom status message overrides pre-computed line
        let custom_msg: Str = this.resp_status_message
        let use_custom: Bool = str::len(custom_msg) > 0 and not has_precomputed

        // Pre-compute sizes
        var status_part_len: I64 = 0
        if has_precomputed {
            status_part_len = str::len(status_line)
        } else {
            // "HTTP/1.1 " + status_code + " " + message + "\r\n"
            let code_str: Str = i64_to_str(this.resp_status_code)
            let msg: Str = this.status_message()
            status_part_len = 9 + str::len(code_str) + 1 + str::len(msg) + 2
        }

        let hdrs_str: Str = headers_serialize_raw(this.resp_headers_ptr)
        let hdrs_len: I64 = str::len(hdrs_str)

        // Headers separator: \r\n
        let sep_len: I64 = 2

        // Body length (skip for HEAD)
        var body_len: I64 = 0
        let is_head: Bool = this.req_method == "HEAD"
        if not is_head {
            body_len = this.body_total_len
        }

        let total: I64 = status_part_len + hdrs_len + sep_len + body_len
        let buf: I64 = lowlevel { mem_alloc(total + 1) } as I64
        var pos: I64 = 0

        // Write status line
        if has_precomputed {
            lowlevel { copy_nonoverlapping(status_line as *Unit, (buf + pos) as *Unit, status_part_len) }
            pos = pos + status_part_len
        } else {
            let prefix: Str = "HTTP/1.1 "
            let prefix_len: I64 = 9
            lowlevel { copy_nonoverlapping(prefix as *Unit, (buf + pos) as *Unit, prefix_len) }
            pos = pos + prefix_len
            let code_str: Str = i64_to_str(this.resp_status_code)
            let code_len: I64 = str::len(code_str)
            lowlevel { copy_nonoverlapping(code_str as *Unit, (buf + pos) as *Unit, code_len) }
            pos = pos + code_len
            lowlevel { ptr_write[U8]((buf + pos) as *U8, 32 as U8) }
            pos = pos + 1
            let msg: Str = this.status_message()
            let msg_len: I64 = str::len(msg)
            lowlevel { copy_nonoverlapping(msg as *Unit, (buf + pos) as *Unit, msg_len) }
            pos = pos + msg_len
            lowlevel { ptr_write[U8]((buf + pos) as *U8, 13 as U8) }
            lowlevel { ptr_write[U8]((buf + pos + 1) as *U8, 10 as U8) }
            pos = pos + 2
        }

        // Write headers
        if hdrs_len > 0 {
            lowlevel { copy_nonoverlapping(hdrs_str as *Unit, (buf + pos) as *Unit, hdrs_len) }
            pos = pos + hdrs_len
        }

        // Headers separator \r\n
        lowlevel { ptr_write[U8]((buf + pos) as *U8, 13 as U8) }
        lowlevel { ptr_write[U8]((buf + pos + 1) as *U8, 10 as U8) }
        pos = pos + 2

        // Write body chunks
        if not is_head and this.body_chunk_count > 0 {
            var i: I64 = 0
            loop (i < this.body_chunk_count) {
                let chunk_ptr: I64 = lowlevel { ptr_read[I64]((this.body_chunks + i * 8) as *I64) }
                let chunk_str: Str = chunk_ptr as Str
                let chunk_len: I64 = str::len(chunk_str)
                if chunk_len > 0 {
                    lowlevel { copy_nonoverlapping(chunk_str as *Unit, (buf + pos) as *Unit, chunk_len) }
                    pos = pos + chunk_len
                }
                i = i + 1
            }
        }

        // Null-terminate
        lowlevel { ptr_write[U8]((buf + pos) as *U8, 0 as U8) }
        return buf as Str
    }

    pub func destroy(this) {
        var i: I64 = 0
        loop (i < this.body_chunk_count) {
            let chunk_ptr: I64 = lowlevel { ptr_read[I64]((this.body_chunks + i * 8) as *I64) }
            if chunk_ptr != 0 { lowlevel { mem_free(chunk_ptr as *Unit) } }
            i = i + 1
        }
        if this.body_chunks != 0 { lowlevel { mem_free(this.body_chunks as *Unit) } }
    }
}

// ════════════════════════════════════════════════════════════════════
// Pre-computed status lines — avoids string concat in hot path
// ════════════════════════════════════════════════════════════════════

/// Returns a pre-computed "HTTP/1.1 NNN Reason\r\n" string for common status codes.
/// Returns "" for uncommon codes (caller falls back to dynamic construction).
func fast_status_line(code: I64) -> Str {
    if code == 200 { return "HTTP/1.1 200 OK\r\n" }
    if code == 201 { return "HTTP/1.1 201 Created\r\n" }
    if code == 204 { return "HTTP/1.1 204 No Content\r\n" }
    if code == 301 { return "HTTP/1.1 301 Moved Permanently\r\n" }
    if code == 302 { return "HTTP/1.1 302 Found\r\n" }
    if code == 304 { return "HTTP/1.1 304 Not Modified\r\n" }
    if code == 400 { return "HTTP/1.1 400 Bad Request\r\n" }
    if code == 401 { return "HTTP/1.1 401 Unauthorized\r\n" }
    if code == 403 { return "HTTP/1.1 403 Forbidden\r\n" }
    if code == 404 { return "HTTP/1.1 404 Not Found\r\n" }
    if code == 405 { return "HTTP/1.1 405 Method Not Allowed\r\n" }
    if code == 413 { return "HTTP/1.1 413 Payload Too Large\r\n" }
    if code == 429 { return "HTTP/1.1 429 Too Many Requests\r\n" }
    if code == 500 { return "HTTP/1.1 500 Internal Server Error\r\n" }
    if code == 502 { return "HTTP/1.1 502 Bad Gateway\r\n" }
    if code == 503 { return "HTTP/1.1 503 Service Unavailable\r\n" }
    return ""
}

