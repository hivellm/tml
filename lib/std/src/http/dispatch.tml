//! HTTP request dispatch — route matching + handler invocation.
//!
//! Implements the route dispatch pipeline:
//!   route match → handler(req) -> Str → return HTTP response string
//!
//! Hooks and middleware are defined but not called from app_dispatch due to a
//! codegen bug: ServerResponse (12 fields with Bool/i1) causes LLVM IR errors
//! when passed through fn ptrs. They will be re-enabled when the bug is fixed.
//!
//! Includes inline radix-tree lookup (avoids cross-module List dependency).

use core::str
use core::intrinsics::{ptr_read, ptr_write, mem_alloc, mem_free, copy_nonoverlapping}
use std::http::incoming::IncomingMessage
use std::http::server_response::ServerResponse
use std::http::parse::{app_store_param, app_find_header_end_in_str, MAX_PARAMS}

// ════════════════════════════════════════════════════════════════════
// Response constants
// ════════════════════════════════════════════════════════════════════

pub const RESPONSE_404: Str = "HTTP/1.1 404 Not Found\r\nContent-Type: application/json\r\nContent-Length: 23\r\nServer: TML\r\nConnection: keep-alive\r\n\r\n{\"error\":\"not found\"}"
pub const RESPONSE_500: Str = "HTTP/1.1 500 Internal Server Error\r\nContent-Type: application/json\r\nContent-Length: 36\r\nServer: TML\r\nConnection: close\r\n\r\n{\"error\":\"internal server error\"}"
pub const RESPONSE_405: Str = "HTTP/1.1 405 Method Not Allowed\r\nContent-Type: application/json\r\nContent-Length: 33\r\nServer: TML\r\nConnection: keep-alive\r\n\r\n{\"error\":\"method not allowed\"}"
pub const RESPONSE_400: Str = "HTTP/1.1 400 Bad Request\r\nContent-Type: application/json\r\nContent-Length: 25\r\nServer: TML\r\nConnection: close\r\n\r\n{\"error\":\"bad request\"}"
pub const RESPONSE_413: Str = "HTTP/1.1 413 Payload Too Large\r\nContent-Type: application/json\r\nContent-Length: 33\r\nServer: TML\r\nConnection: close\r\n\r\n{\"error\":\"payload too large\"}"

// ════════════════════════════════════════════════════════════════════
// Shared state memory layout offsets
// ════════════════════════════════════════════════════════════════════

const OFF_TABLE: I64 = 0
const OFF_COUNT: I64 = 8
const OFF_ROUTER: I64 = 16
const OFF_MW_TABLE: I64 = 24
const OFF_MW_COUNT: I64 = 32
const OFF_SHUTDOWN: I64 = 40
const OFF_ON_REQUEST_TABLE: I64 = 80
const OFF_ON_REQUEST_COUNT: I64 = 88
const OFF_PRE_HANDLER_TABLE: I64 = 96
const OFF_PRE_HANDLER_COUNT: I64 = 104
const OFF_ON_SEND_TABLE: I64 = 112
const OFF_ON_SEND_COUNT: I64 = 120
const OFF_ON_RESPONSE_TABLE: I64 = 128
const OFF_ON_RESPONSE_COUNT: I64 = 136
const OFF_ON_ERROR_TABLE: I64 = 144
const OFF_ON_ERROR_COUNT: I64 = 152
const OFF_ERROR_HANDLER: I64 = 160

const ENTRY_SIZE: I64 = 24

// ════════════════════════════════════════════════════════════════════
// Method index — O(1) method → radix tree lookup
// ════════════════════════════════════════════════════════════════════

const METHOD_GET: I64 = 0
const METHOD_POST: I64 = 1
const METHOD_PUT: I64 = 2
const METHOD_DELETE: I64 = 3
const METHOD_PATCH: I64 = 4
const METHOD_HEAD: I64 = 5
const METHOD_OPTIONS: I64 = 6

func method_index(method: Str) -> I64 {
    // Fast path: check first char then length
    let len: I64 = str::len(method)
    if len == 3 {
        let c: I32 = str::char_at(method, 0)
        if c == 71 { return METHOD_GET }    // 'G'
        if c == 80 { return METHOD_PUT }    // 'P' + len=3
    }
    if len == 4 {
        let c: I32 = str::char_at(method, 0)
        if c == 80 { return METHOD_POST }   // 'P' + len=4
        if c == 72 { return METHOD_HEAD }   // 'H'
    }
    if len == 5 {
        // PATCH starts with 'P' (80), TRACE starts with 'T' (84)
        let c: I32 = str::char_at(method, 0)
        if c == 80 { return METHOD_PATCH }
        // TRACE is not routable — return -1
        return -1
    }
    if len == 6 { return METHOD_DELETE }
    if len == 7 { return METHOD_OPTIONS }
    return -1
}

// ════════════════════════════════════════════════════════════════════
// Inline radix-tree lookup (avoids cross-module List dependency)
// ════════════════════════════════════════════════════════════════════
// Node layout from router.tml: 80 bytes per node

const RT_PREFIX: I64 = 0
const RT_CHILDREN_PTR: I64 = 8
const RT_CHILDREN_COUNT: I64 = 16
const RT_PARAM_CHILD: I64 = 32
const RT_WILDCARD_CHILD: I64 = 40
const RT_HANDLER: I64 = 48
const RT_PARAM_NAME: I64 = 56
const RT_KIND: I64 = 64

func rt_get(node: I64, off: I64) -> I64 {
    lowlevel { ptr_read[I64]((node + off) as *I64) }
}

func rt_find_child(node: I64, byte_key: I32) -> I64 {
    let arr: I64 = rt_get(node, 8)
    let count: I64 = rt_get(node, 16)
    if arr == 0 or count == 0 { return 0 }
    let key: I64 = byte_key as I64
    var entry: I64 = arr
    var idx: I64 = 0
    loop (idx < count) {
        let k: I64 = lowlevel { ptr_read[I64](entry as *I64) }
        if k == key {
            return lowlevel { ptr_read[I64]((entry + 8) as *I64) }
        }
        entry = entry + 16
        idx = idx + 1
    }
    return 0
}

func rt_match_prefix(path: Str, pos: I64, prefix: Str) -> I64 {
    let plen: I64 = str::len(path)
    let prelen: I64 = str::len(prefix)
    var i: I64 = 0
    loop (i < prelen) {
        if pos + i >= plen { return i }
        if str::char_at(path, pos + i) != str::char_at(prefix, i) { return i }
        i = i + 1
    }
    return prelen
}

func rt_find_slash(path: Str, from: I64, plen: I64) -> I64 {
    var i: I64 = from
    loop (i < plen) {
        if str::char_at(path, i) == 47 { return i }
        i = i + 1
    }
    return plen
}

/// Inline radix-tree search. Returns handler_id (0 = not found).
/// Stores up to MAX_PARAMS name/value pairs in params_buf.
/// params_buf layout: [name0, value0, name1, value1, ...] as I64 (Str pointers).
/// param_count is set to the number of extracted params.
pub func app_find_route(root: I64, path: Str, params_buf: I64, param_count: mut ref I64) -> I64 {
    let plen: I64 = str::len(path)
    param_count = 0

    // Root route
    if path == "/" or plen == 0 {
        return rt_get(root, RT_HANDLER)
    }

    var current: I64 = root
    var pos: I64 = 0

    loop (pos < plen) {
        let c: I32 = str::char_at(path, pos)

        // Try static child
        let child: I64 = rt_find_child(current, c)
        if child != 0 {
            let prefix: Str = rt_get(child, RT_PREFIX) as Str
            let prelen: I64 = str::len(prefix)
            let matched: I64 = rt_match_prefix(path, pos, prefix)
            if matched == prelen {
                current = child
                pos = pos + prelen
                continue
            }
        }

        // Try parametric child
        let param: I64 = rt_get(current, RT_PARAM_CHILD)
        if param != 0 {
            // Skip leading /
            var cap_start: I64 = pos
            if cap_start < plen and str::char_at(path, cap_start) == 47 {
                cap_start = cap_start + 1
            }
            let seg_end: I64 = rt_find_slash(path, cap_start, plen)
            if param_count < MAX_PARAMS {
                let name: Str = rt_get(param, RT_PARAM_NAME) as Str
                // Manual substring to avoid cross-module str::substring call
                let vlen: I64 = seg_end - cap_start
                let vbuf: I64 = lowlevel { mem_alloc(vlen + 1) } as I64
                lowlevel { copy_nonoverlapping((path as I64 + cap_start) as *Unit, vbuf as *Unit, vlen) }
                lowlevel { ptr_write[U8]((vbuf + vlen) as *U8, 0 as U8) }
                let value: Str = vbuf as Str
                app_store_param(params_buf, param_count, name, value)
                param_count = param_count + 1
            }
            current = param
            pos = seg_end
            continue
        }

        // Try wildcard child
        let wc: I64 = rt_get(current, RT_WILDCARD_CHILD)
        if wc != 0 {
            var wc_start: I64 = pos
            if wc_start < plen and str::char_at(path, wc_start) == 47 {
                wc_start = wc_start + 1
            }
            if param_count < MAX_PARAMS {
                let name: Str = rt_get(wc, RT_PARAM_NAME) as Str
                let value: Str = str::substring(path, wc_start, plen)
                app_store_param(params_buf, param_count, name, value)
                param_count = param_count + 1
            }
            return rt_get(wc, RT_HANDLER)
        }

        // No match
        return 0
    }

    return rt_get(current, RT_HANDLER)
}

// ════════════════════════════════════════════════════════════════════
// Dispatch — hook lifecycle + route matching + handler invocation
// ════════════════════════════════════════════════════════════════════

/// Build an IncomingMessage from zero-copy parsed fields (fast path).
/// Does not allocate headers — suitable for high-throughput scenarios.
/// Handlers that need headers can inspect the raw buffer directly.
func app_make_request(method: Str, path: Str, body: Str, fd: I64,
                      params_buf: I64, param_count: I64) -> IncomingMessage {
    // Direct struct construction — avoids IncomingMessage::new() which allocates Headers.
    // route_params_ptr stores our params_buf layout: [name0, value0, ...].
    // IncomingMessage layout matches struct field order exactly.
    IncomingMessage {
        req_method: method,
        req_url: path,
        req_headers_ptr: params_buf,
        raw_header_count: param_count,
        req_body: body,
        req_version: "HTTP/1.1",
        is_complete: true,
        socket_fd: fd,
    }
}

/// Get a path parameter by name from an IncomingMessage (fast-path requests).
/// For fast-path requests, params are stored in req_headers_ptr (params_buf)
/// and raw_header_count (param_count). Layout: [name0, value0, name1, value1, ...] as I64.
pub func app_get_param(req: IncomingMessage, name: Str) -> Str {
    let params_buf: I64 = req.req_headers_ptr
    let pc: I64 = req.raw_header_count
    if params_buf == 0 or pc == 0 { return "" }
    // O(n) scan — each param is 16 bytes: [name I64, value I64]
    var off: I64 = 0
    var i: I64 = 0
    loop (i < pc) {
        let n: Str = lowlevel { ptr_read[I64]((params_buf + off) as *I64) } as Str
        if n == name {
            return lowlevel { ptr_read[I64]((params_buf + off + 8) as *I64) } as Str
        }
        off = off + 16
        i = i + 1
    }
    return ""
}

/// Run all 2-param hooks in a hook table (onRequest, preHandler, onSend, onResponse).
/// Returns true if the pipeline should continue (res not yet finished).
/// Returns false if a hook called res.end() and short-circuited the pipeline.
///
/// NOTE: Not called from app_dispatch currently due to a codegen bug where
/// ServerResponse (Bool fields / i1 type) causes LLVM IR errors through fn ptrs.
/// Will be re-enabled when that bug is fixed.
func app_run_hooks(hook_table: I64, hook_count: I64, req: IncomingMessage, res: ServerResponse) -> Bool {
    var i: I64 = 0
    loop (i < hook_count) {
        let fn_ptr: I64 = lowlevel { ptr_read[I64]((hook_table + i * 8) as *I64) }
        if fn_ptr != 0 {
            let hook: func(IncomingMessage, ServerResponse) = fn_ptr as func(IncomingMessage, ServerResponse)
            hook(req, res)
            // If hook marked response finished, short-circuit
            if res.is_finished() { return false }
        }
        i = i + 1
    }
    return true
}

/// Run all onError hooks (3-param: req, res, error_msg).
///
/// NOTE: Not called from app_dispatch currently due to a codegen bug where
/// ServerResponse (Bool fields / i1 type) causes LLVM IR errors through fn ptrs.
/// Will be re-enabled when that bug is fixed.
func app_run_error_hooks(hook_table: I64, hook_count: I64, error_handler: I64,
                         req: IncomingMessage, res: ServerResponse, msg: Str) {
    // Run custom error handler first if set
    if error_handler != 0 {
        let h: func(IncomingMessage, ServerResponse, Str) = error_handler as func(IncomingMessage, ServerResponse, Str)
        h(req, res, msg)
        return
    }
    // Run onError hooks
    var i: I64 = 0
    loop (i < hook_count) {
        let fn_ptr: I64 = lowlevel { ptr_read[I64]((hook_table + i * 8) as *I64) }
        if fn_ptr != 0 {
            let hook: func(IncomingMessage, ServerResponse, Str) = fn_ptr as func(IncomingMessage, ServerResponse, Str)
            hook(req, res, msg)
        }
        i = i + 1
    }
}

/// Radix-tree dispatch: look up handler_id by method and path.
/// Returns handler fn_ptr (I64) and stores params into params_buf.
/// Returns 0 if not found.
func app_dispatch_tree_lookup(table: I64, trees: I64, method: Str, path: Str,
                              params_buf: I64, param_count: mut ref I64) -> I64 {
    let idx: I64 = method_index(method)
    if idx < 0 { return 0 }
    let root: I64 = lowlevel { ptr_read[I64]((trees + idx * 8) as *I64) }
    if root == 0 { return 0 }
    let handler_id: I64 = app_find_route(root, path, params_buf, ref param_count)
    if handler_id <= 0 { return 0 }
    let offset: I64 = (handler_id - 1) * ENTRY_SIZE
    return lowlevel { ptr_read[I64]((table + offset + 16) as *I64) }
}

/// Main dispatch function. Looks up a route and calls handler(req) -> Str.
///
/// Hooks and middleware are intentionally skipped: passing ServerResponse through
/// fn ptrs triggers a codegen bug (Bool/i1 fields cause LLVM IR type errors).
/// They will be re-enabled once that bug is fixed.
///
/// Handler signature: func(req: IncomingMessage) -> Str
///   The returned Str must be a complete HTTP response (built with app_build_response).
///
/// params_buf: pre-allocated buffer for route params (reused per worker).
/// Returns the serialized HTTP response string.
/// Linear scan dispatch — matches method + path against the flat handler table.
/// Supports exact match and pattern matching for `:param` segments.
/// Stores extracted path params into params_buf, sets param_count.
func app_linear_lookup(table: I64, count: I64, method: Str, path: Str,
                       params_buf: I64, param_count: mut ref I64) -> I64 {
    param_count = 0
    var i: I64 = 0
    loop (i < count) {
        var off: I64 = 0
        var j: I64 = 0
        loop (j < i) { off = off + ENTRY_SIZE; j = j + 1 }
        let m: Str = lowlevel { ptr_read[I64]((table + off) as *I64) } as Str
        let p: Str = lowlevel { ptr_read[I64]((table + off + 8) as *I64) } as Str
        if m == method {
            if p == path {
                // Exact match — no params
                return lowlevel { ptr_read[I64]((table + off + 16) as *I64) }
            }
            // Pattern match for :param segments
            let matched_params: I64 = app_pattern_match_extract(p, path, params_buf)
            if matched_params >= 0 {
                param_count = matched_params
                return lowlevel { ptr_read[I64]((table + off + 16) as *I64) }
            }
        }
        i = i + 1
    }
    return 0
}

/// Pattern matcher for `:param` routes. Returns number of extracted params, or -1 if no match.
/// Avoids mut ref for param counting — uses a local var and returns the count.
func app_pattern_match_extract(pattern: Str, path: Str, params_buf: I64) -> I64 {
    let pat_len: I64 = str::len(pattern)
    let path_len: I64 = str::len(path)
    var pp: I64 = 0
    var xp: I64 = 0
    var pc: I64 = 0

    loop (pp < pat_len and xp < path_len) {
        if str::char_at(pattern, pp) == 58 {
            // ':' parametric segment — extract param name and value
            let name_start: I64 = pp + 1
            var name_end: I64 = name_start
            loop (name_end < pat_len and str::char_at(pattern, name_end) != 47) {
                name_end = name_end + 1
            }
            var val_end: I64 = xp
            loop (val_end < path_len and str::char_at(path, val_end) != 47) {
                val_end = val_end + 1
            }
            if pc < MAX_PARAMS {
                let name_len: I64 = name_end - name_start
                let nbuf: I64 = lowlevel { mem_alloc(name_len + 1) } as I64
                lowlevel { copy_nonoverlapping((pattern as I64 + name_start) as *Unit, nbuf as *Unit, name_len) }
                lowlevel { ptr_write[U8]((nbuf + name_len) as *U8, 0 as U8) }
                let val_len: I64 = val_end - xp
                let vbuf: I64 = lowlevel { mem_alloc(val_len + 1) } as I64
                lowlevel { copy_nonoverlapping((path as I64 + xp) as *Unit, vbuf as *Unit, val_len) }
                lowlevel { ptr_write[U8]((vbuf + val_len) as *U8, 0 as U8) }
                app_store_param(params_buf, pc, nbuf as Str, vbuf as Str)
                pc = pc + 1
            }
            pp = name_end
            xp = val_end
        } else {
            if str::char_at(pattern, pp) != str::char_at(path, xp) { return -1 }
            pp = pp + 1
            xp = xp + 1
        }
    }
    if pp >= pat_len and xp >= path_len {
        return pc
    }
    return -1
}

pub func app_dispatch(shared: I64, method: Str, path: Str, body: Str, fd: I64, params_buf: I64) -> Str {
    let table: I64 = lowlevel { ptr_read[I64]((shared + OFF_TABLE) as *I64) }
    let count: I64 = lowlevel { ptr_read[I64]((shared + OFF_COUNT) as *I64) }
    let trees: I64 = lowlevel { ptr_read[I64]((shared + OFF_ROUTER) as *I64) }

    var param_count: I64 = 0

    // ── Route lookup: radix tree (O(1) for exact paths), linear scan fallback ──
    var fn_ptr: I64 = app_dispatch_tree_lookup(table, trees, method, path, params_buf, ref param_count)
    if fn_ptr == 0 {
        // Tree miss (split corruption, pattern routes) — linear scan fallback
        fn_ptr = app_linear_lookup(table, count, method, path, params_buf, ref param_count)
    }

    // ── Construct IncomingMessage ─────────────────────────────────
    let req: IncomingMessage = app_make_request(method, path, body, fd, params_buf, param_count)

    // ── Route not found ──────────────────────────────────────────
    if fn_ptr == 0 {
        return app_error_response(404, "not found")
    }

    // ── Route handler ────────────────────────────────────────────
    let handler: func(IncomingMessage) -> Str = fn_ptr as func(IncomingMessage) -> Str
    return handler(req)
}

// ════════════════════════════════════════════════════════════════════
// Status helpers
// ════════════════════════════════════════════════════════════════════

pub func app_status_text(code: I64) -> Str {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 204 { return "No Content" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 304 { return "Not Modified" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 408 { return "Request Timeout" }
    if code == 413 { return "Payload Too Large" }
    if code == 429 { return "Too Many Requests" }
    if code == 500 { return "Internal Server Error" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    return "OK"
}

/// Pre-computed "HTTP/1.1 NNN Reason\r\n" status lines — avoids I64.to_string() in hot path.
func app_status_line(code: I64) -> Str {
    if code == 200 { return "HTTP/1.1 200 OK\r\n" }
    if code == 201 { return "HTTP/1.1 201 Created\r\n" }
    if code == 204 { return "HTTP/1.1 204 No Content\r\n" }
    if code == 301 { return "HTTP/1.1 301 Moved Permanently\r\n" }
    if code == 302 { return "HTTP/1.1 302 Found\r\n" }
    if code == 304 { return "HTTP/1.1 304 Not Modified\r\n" }
    if code == 400 { return "HTTP/1.1 400 Bad Request\r\n" }
    if code == 401 { return "HTTP/1.1 401 Unauthorized\r\n" }
    if code == 403 { return "HTTP/1.1 403 Forbidden\r\n" }
    if code == 404 { return "HTTP/1.1 404 Not Found\r\n" }
    if code == 405 { return "HTTP/1.1 405 Method Not Allowed\r\n" }
    if code == 408 { return "HTTP/1.1 408 Request Timeout\r\n" }
    if code == 413 { return "HTTP/1.1 413 Payload Too Large\r\n" }
    if code == 429 { return "HTTP/1.1 429 Too Many Requests\r\n" }
    if code == 500 { return "HTTP/1.1 500 Internal Server Error\r\n" }
    if code == 502 { return "HTTP/1.1 502 Bad Gateway\r\n" }
    if code == 503 { return "HTTP/1.1 503 Service Unavailable\r\n" }
    // Fallback: build dynamically (rare path)
    let status_str: Str = code.to_string()
    let status_text: Str = app_status_text(code)
    let prefix: Str = "HTTP/1.1 "
    let plen: I64 = 9 + str::len(status_str) + 1 + str::len(status_text) + 2
    let p: I64 = lowlevel { mem_alloc(plen + 1) } as I64
    var pos: I64 = 0
    pos = app_buf_copy(p, pos, prefix)
    pos = app_buf_copy(p, pos, status_str)
    lowlevel { ptr_write[U8]((p + pos) as *U8, 32 as U8) }
    pos = pos + 1
    pos = app_buf_copy(p, pos, status_text)
    lowlevel { ptr_write[U8]((p + pos) as *U8, 13 as U8) }
    lowlevel { ptr_write[U8]((p + pos + 1) as *U8, 10 as U8) }
    pos = pos + 2
    lowlevel { ptr_write[U8]((p + pos) as *U8, 0 as U8) }
    return p as Str
}

/// Fast integer to decimal string for Content-Length.
/// Zero-alloc: counts digits first, then writes directly in reverse.
func app_itoa_content_length(buf: I64, pos: I64, n: I64) -> I64 {
    if n == 0 {
        lowlevel { ptr_write[U8]((buf + pos) as *U8, 48 as U8) }
        return pos + 1
    }
    // Count digits
    var digits: I64 = 0
    var tmp: I64 = n
    loop (tmp > 0) { digits = digits + 1; tmp = tmp / 10 }
    // Write digits in reverse directly into output buffer
    var write_pos: I64 = pos + digits - 1
    var val: I64 = n
    loop (val > 0) {
        lowlevel { ptr_write[U8]((buf + write_pos) as *U8, ((val % 10) + 48) as U8) }
        write_pos = write_pos - 1
        val = val / 10
    }
    return pos + digits
}

/// Copy a string into buffer at position, return new position.
func app_buf_copy(buf: I64, pos: I64, s: Str) -> I64 {
    let len: I64 = str::len(s)
    if len > 0 {
        lowlevel { copy_nonoverlapping(s as *Unit, (buf + pos) as *Unit, len) }
    }
    return pos + len
}

// Pre-computed header fragments
const HDR_CT: Str = "Content-Type: "
const HDR_CL: Str = "Content-Length: "
const HDR_SUFFIX: Str = "\r\nServer: TML\r\nConnection: keep-alive\r\n\r\n"

/// Build HTTP response — optimized hot path.
pub func app_build_response(status: I64, content_type: Str, body: Str) -> Str {
    let body_len: I64 = str::len(body)
    let status_line: Str = app_status_line(status)
    let sl_len: I64 = str::len(status_line)
    let ct_len: I64 = str::len(content_type)
    let hdr_suffix_len: I64 = str::len(HDR_SUFFIX)
    let max_total: I64 = sl_len + 14 + ct_len + 2 + 16 + 10 + hdr_suffix_len + body_len
    let buf: I64 = lowlevel { mem_alloc(max_total + 1) } as I64
    var pos: I64 = 0
    lowlevel { copy_nonoverlapping(status_line as *Unit, buf as *Unit, sl_len) }
    pos = sl_len
    lowlevel { copy_nonoverlapping(HDR_CT as *Unit, (buf + pos) as *Unit, 14) }
    pos = pos + 14
    lowlevel { copy_nonoverlapping(content_type as *Unit, (buf + pos) as *Unit, ct_len) }
    pos = pos + ct_len
    lowlevel { ptr_write[U8]((buf + pos) as *U8, 13 as U8) }
    lowlevel { ptr_write[U8]((buf + pos + 1) as *U8, 10 as U8) }
    pos = pos + 2
    lowlevel { copy_nonoverlapping(HDR_CL as *Unit, (buf + pos) as *Unit, 16) }
    pos = pos + 16
    pos = app_itoa_content_length(buf, pos, body_len)
    lowlevel { copy_nonoverlapping(HDR_SUFFIX as *Unit, (buf + pos) as *Unit, hdr_suffix_len) }
    pos = pos + hdr_suffix_len
    if body_len > 0 {
        lowlevel { copy_nonoverlapping(body as *Unit, (buf + pos) as *Unit, body_len) }
        pos = pos + body_len
    }
    lowlevel { ptr_write[U8]((buf + pos) as *U8, 0 as U8) }
    return buf as Str
}

/// Build HTTP response into a pre-allocated buffer (zero-alloc hot path).
/// Returns the total bytes written. Caller must ensure buf has enough space.
/// Use this in the worker with a per-worker scratch buffer to avoid mem_alloc per request.
pub func app_build_response_into(buf: I64, status: I64, content_type: Str, body: Str) -> I64 {
    let body_len: I64 = str::len(body)
    let status_line: Str = app_status_line(status)
    let sl_len: I64 = str::len(status_line)
    let ct_len: I64 = str::len(content_type)
    let hdr_suffix_len: I64 = str::len(HDR_SUFFIX)
    var pos: I64 = 0
    lowlevel { copy_nonoverlapping(status_line as *Unit, buf as *Unit, sl_len) }
    pos = sl_len
    lowlevel { copy_nonoverlapping(HDR_CT as *Unit, (buf + pos) as *Unit, 14) }
    pos = pos + 14
    lowlevel { copy_nonoverlapping(content_type as *Unit, (buf + pos) as *Unit, ct_len) }
    pos = pos + ct_len
    lowlevel { ptr_write[U8]((buf + pos) as *U8, 13 as U8) }
    lowlevel { ptr_write[U8]((buf + pos + 1) as *U8, 10 as U8) }
    pos = pos + 2
    lowlevel { copy_nonoverlapping(HDR_CL as *Unit, (buf + pos) as *Unit, 16) }
    pos = pos + 16
    pos = app_itoa_content_length(buf, pos, body_len)
    lowlevel { copy_nonoverlapping(HDR_SUFFIX as *Unit, (buf + pos) as *Unit, hdr_suffix_len) }
    pos = pos + hdr_suffix_len
    if body_len > 0 {
        lowlevel { copy_nonoverlapping(body as *Unit, (buf + pos) as *Unit, body_len) }
        pos = pos + body_len
    }
    lowlevel { ptr_write[U8]((buf + pos) as *U8, 0 as U8) }
    return pos
}

/// Build a JSON error response following cmmv-server format.
pub func app_error_response(status: I64, message: Str) -> Str {
    let status_text: Str = app_status_text(status)
    let status_str: Str = status.to_string()
    let body_prefix: Str = "{\"statusCode\":"
    let body_err: Str = ",\"error\":\""
    let body_msg: Str = "\",\"message\":\""
    let body_suffix: Str = "\"}"
    let status_str_len: I64 = str::len(status_str)
    let status_text_len: I64 = str::len(status_text)
    let message_len: I64 = str::len(message)
    let body_len: I64 = 14 + status_str_len + 10 + status_text_len + 14 + message_len + 2
    let body_buf: I64 = lowlevel { mem_alloc(body_len + 1) } as I64
    var bp: I64 = 0
    bp = app_buf_copy(body_buf, bp, body_prefix)
    bp = app_buf_copy(body_buf, bp, status_str)
    bp = app_buf_copy(body_buf, bp, body_err)
    bp = app_buf_copy(body_buf, bp, status_text)
    bp = app_buf_copy(body_buf, bp, body_msg)
    bp = app_buf_copy(body_buf, bp, message)
    bp = app_buf_copy(body_buf, bp, body_suffix)
    lowlevel { ptr_write[U8]((body_buf + bp) as *U8, 0 as U8) }
    let body: Str = body_buf as Str
    return app_build_response(status, "application/json; charset=utf-8", body)
}
