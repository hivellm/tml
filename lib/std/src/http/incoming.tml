//! HTTP incoming message — parsed request received by the server.
//!
//! Represents an HTTP request as received over the wire, with method,
//! URL, headers, body, and HTTP version. This is the server-side
//! equivalent of what the client sends as a `Request`.
//!
//! Corresponds to Node.js `http.IncomingMessage` (server-side).

use core::str
use core::intrinsics::{ptr_read, ptr_write, copy_nonoverlapping, mem_alloc, mem_free}
use std::http::method::Method
use std::http::headers::Headers
use std::http::version::HttpVersion
use std::http::error::{HttpError, HttpErrorKind}

/// An HTTP request received by the server (incoming message).
///
/// All fields are primitive types (Str, I64, Bool) to avoid codegen
/// issues with nested struct field offsets. Headers are accessed via
/// a pointer stored as I64.
pub type IncomingMessage {
    req_method: Str,         // "GET", "POST", etc.
    req_url: Str,
    req_headers_ptr: I64,    // pointer to Headers object
    raw_header_count: I64,
    req_body: Str,
    req_version: Str,        // "HTTP/1.1" etc.
    is_complete: Bool,
    socket_fd: I64,
}

impl IncomingMessage {
    /// Creates an empty IncomingMessage (for testing or manual construction).
    pub func new(method: Str, url: Str, version: Str) -> IncomingMessage {
        let hdrs: Headers = Headers::new()
        // Store headers pointer, escape @allocates
        let hdrs_addr: I64 = (ref hdrs) as I64
        let hdrs_ptr: I64 = lowlevel { ptr_read[I64](hdrs_addr as *I64) }
        IncomingMessage {
            req_method: method,
            req_url: url,
            req_headers_ptr: hdrs_ptr,
            raw_header_count: 0,
            req_body: "",
            req_version: version,
            is_complete: false,
            socket_fd: -1 as I64,
        }
    }

    // ── Accessors (Node.js http.IncomingMessage properties) ───────

    /// Returns the HTTP method string (e.g. "GET"). Server-side only.
    pub func method(this) -> Str { this.req_method }

    /// Returns the request URL path (e.g. "/api/users?page=1"). Server-side only.
    pub func url(this) -> Str { this.req_url }

    /// Returns true if a complete HTTP message was received and parsed.
    pub func complete(this) -> Bool { this.is_complete }

    /// Returns the request body (may be empty for GET/HEAD/DELETE).
    pub func body(this) -> Str { this.req_body }

    /// Returns the HTTP version as a string (e.g. "HTTP/1.1").
    pub func http_version(this) -> Str { this.req_version }

    /// Returns the underlying socket file descriptor.
    pub func socket(this) -> I64 { this.socket_fd }

    // ── Header access via direct pointer operations ─────────────
    // We avoid constructing Headers structs (codegen issues) and
    // instead read the internal layout directly.
    //
    // Headers internal layout at handle:
    //   offset 0:  keys pointer (*Str array) — 8 bytes
    //   offset 8:  values pointer (array of {ptr: I64, len: I64} pairs) — 8 bytes
    //   offset 16: len (I64) — 8 bytes

    /// Gets a header value by name (case-insensitive).
    /// Name must be provided in lowercase.
    pub func get_header(this, name: Str) -> Str {
        return get_header_from_ptr(this.req_headers_ptr, name)
    }

    /// Returns true if a header exists.
    pub func has_header(this, name: Str) -> Bool {
        return has_header_from_ptr(this.req_headers_ptr, name)
    }

    /// Returns the number of headers.
    pub func header_count(this) -> I64 {
        let hdr: I64 = this.req_headers_ptr
        if hdr == 0 { return 0 }
        return lowlevel { ptr_read[I64]((hdr + 16) as *I64) }
    }

    // ── Convenience header accessors ─────────────────────────────

    /// Returns the Host header value, or "".
    pub func host(this) -> Str { this.get_header("host") }

    /// Returns the Content-Type header value, or "".
    pub func content_type(this) -> Str { this.get_header("content-type") }

    /// Returns the Content-Length as I64, or -1 if not set.
    pub func content_length(this) -> I64 {
        let val: Str = this.get_header("content-length")
        if str::len(val) == 0 { return -1 as I64 }
        let parsed: Maybe[I64] = str::parse_i64(val)
        when parsed {
            Just(n) => return n,
            Nothing => return -1 as I64,
        }
    }

    /// Returns the Connection header value, or "".
    pub func connection(this) -> Str { this.get_header("connection") }

    /// Returns the User-Agent header value, or "".
    pub func user_agent(this) -> Str { this.get_header("user-agent") }

    /// Returns the Accept header value, or "".
    pub func accept(this) -> Str { this.get_header("accept") }

    /// Returns the Authorization header value, or "".
    pub func authorization(this) -> Str { this.get_header("authorization") }

    /// Returns true if the client sent Connection: keep-alive.
    pub func is_keep_alive(this) -> Bool {
        let conn: Str = this.get_header("connection")
        return str::contains(str::to_lowercase(conn), "keep-alive")
    }

    /// Returns true if Transfer-Encoding: chunked.
    pub func is_chunked(this) -> Bool {
        let te: Str = this.get_header("transfer-encoding")
        return str::contains(te, "chunked")
    }

    // ── URL decomposition ────────────────────────────────────────

    /// Returns just the path component (before '?').
    pub func path(this) -> Str {
        let url_len: I64 = str::len(this.req_url)
        var qpos: I64 = 0
        loop (qpos < url_len) {
            if str::char_at(this.req_url, qpos) == 63 {  // '?'
                return str::substring(this.req_url, 0, qpos)
            }
            qpos = qpos + 1
        }
        return this.req_url
    }

    /// Returns the query string (after '?', without the '?').
    pub func query(this) -> Str {
        let url_len: I64 = str::len(this.req_url)
        var qpos: I64 = 0
        loop (qpos < url_len) {
            if str::char_at(this.req_url, qpos) == 63 {  // '?'
                return str::substring(this.req_url, qpos + 1, url_len)
            }
            qpos = qpos + 1
        }
        return ""
    }

    /// Frees internal storage.
    pub func destroy(this) {
        // Headers destroy is handled via the pointer
        // For now, leak rather than risk double-free from struct reconstruction
    }
}

/// Gets a header value from a raw headers pointer.
/// Keys in the headers are already lowercase.
/// The `name` parameter should be lowercase.
func get_header_from_ptr(hdr: I64, name: Str) -> Str {
    if hdr == 0 { return "" }
    let lower: Str = str::to_lowercase(name)
    let keys_addr: I64 = lowlevel { ptr_read[I64](hdr as *I64) }
    let vals_addr: I64 = lowlevel { ptr_read[I64]((hdr + 8) as *I64) }
    let cur_len: I64 = lowlevel { ptr_read[I64]((hdr + 16) as *I64) }
    var i: I64 = 0
    loop (i < cur_len) {
        let existing_key: Str = lowlevel { ptr_read[I64]((keys_addr + i * 8) as *I64) } as Str
        if existing_key == lower {
            let val_ptr: I64 = lowlevel { ptr_read[I64]((vals_addr + i * 16) as *I64) }
            return val_ptr as Str
        }
        i = i + 1
    }
    return ""
}

/// Checks if a header exists from a raw headers pointer.
func has_header_from_ptr(hdr: I64, name: Str) -> Bool {
    if hdr == 0 { return false }
    let lower: Str = str::to_lowercase(name)
    let keys_addr: I64 = lowlevel { ptr_read[I64](hdr as *I64) }
    let cur_len: I64 = lowlevel { ptr_read[I64]((hdr + 16) as *I64) }
    var i: I64 = 0
    loop (i < cur_len) {
        let existing_key: Str = lowlevel { ptr_read[I64]((keys_addr + i * 8) as *I64) } as Str
        if existing_key == lower {
            return true
        }
        i = i + 1
    }
    return false
}

/// Parses an HTTP/1.1 request from raw wire format into an IncomingMessage.
///
/// Expects: "GET /path HTTP/1.1\r\nHeader: Value\r\n\r\nbody"
pub func parse_request(raw: Str) -> Outcome[IncomingMessage, HttpError] {
    let raw_len: I64 = str::len(raw)
    if raw_len < 14 {  // Minimum: "GET / HTTP/1.1"
        return Err(HttpError::invalid_response("request too short"))
    }

    // Find end of request line (\r\n)
    var line_end: I64 = 0
    loop (line_end < raw_len - 1) {
        if str::char_at(raw, line_end) == 13 and str::char_at(raw, line_end + 1) == 10 {
            break
        }
        line_end = line_end + 1
    }
    if line_end >= raw_len - 1 {
        return Err(HttpError::invalid_response("no request line terminator"))
    }

    // Parse method (first space)
    var sp1: I64 = 0
    loop (sp1 < line_end and str::char_at(raw, sp1) != 32) {
        sp1 = sp1 + 1
    }
    if sp1 >= line_end {
        return Err(HttpError::invalid_response("no method in request line"))
    }
    let method_str_i64: I64 = str::substring(raw, 0, sp1) as I64

    // Parse URL (between first and second space)
    var sp2: I64 = sp1 + 1
    loop (sp2 < line_end and str::char_at(raw, sp2) != 32) {
        sp2 = sp2 + 1
    }
    if sp2 >= line_end {
        return Err(HttpError::invalid_response("no URL in request line"))
    }
    let url_i64: I64 = str::substring(raw, sp1 + 1, sp2) as I64

    // Parse version
    let version_i64: I64 = str::substring(raw, sp2 + 1, line_end) as I64

    // Parse headers
    let headers: Headers = Headers::new()
    var raw_count: I64 = 0

    var pos: I64 = line_end + 2  // skip \r\n
    loop (pos < raw_len - 1) {
        // Check for empty line (end of headers)
        if str::char_at(raw, pos) == 13 and str::char_at(raw, pos + 1) == 10 {
            pos = pos + 2
            break
        }
        // Find end of this header line
        var hline_end: I64 = pos
        loop (hline_end < raw_len - 1) {
            if str::char_at(raw, hline_end) == 13 and str::char_at(raw, hline_end + 1) == 10 {
                break
            }
            hline_end = hline_end + 1
        }
        // Find colon
        var colon: I64 = pos
        loop (colon < hline_end and str::char_at(raw, colon) != 58) {
            colon = colon + 1
        }
        if colon < hline_end {
            // Skip ": " after colon
            var val_start: I64 = colon + 1
            loop (val_start < hline_end and str::char_at(raw, val_start) == 32) {
                val_start = val_start + 1
            }

            // Store in lowercase Headers map (escape @allocates with I64)
            let key_i64: I64 = str::substring(raw, pos, colon) as I64
            let val_i64: I64 = str::substring(raw, val_start, hline_end) as I64
            headers.set(key_i64 as Str, val_i64 as Str)
            lowlevel { mem_free(key_i64 as *Unit) }
            raw_count = raw_count + 1
        }
        pos = hline_end + 2  // skip \r\n
    }

    // Body is everything after headers (escape @allocates)
    let body_i64: I64 = str::substring(raw, pos, raw_len) as I64

    // Get headers handle pointer (escape @allocates)
    let hdrs_addr: I64 = (ref headers) as I64
    let hdrs_ptr: I64 = lowlevel { ptr_read[I64](hdrs_addr as *I64) }

    return Ok(IncomingMessage {
        req_method: method_str_i64 as Str,
        req_url: url_i64 as Str,
        req_headers_ptr: hdrs_ptr,
        raw_header_count: raw_count,
        req_body: body_i64 as Str,
        req_version: version_i64 as Str,
        is_complete: true,
        socket_fd: -1 as I64,
    })
}
