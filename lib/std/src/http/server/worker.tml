//! HTTP server workers — thread pool and event loop implementations.
//!
//! Two server modes:
//!   - Thread pool (`app_listen`): N worker threads pull connections from a shared queue.
//!     Each worker handles one connection at a time (blocking I/O). Best throughput.
//!   - Event loop (`app_listen_evloop`): N workers each own a non-blocking poller.
//!     Accept thread distributes connections round-robin. More concurrent connections.
//!
//! Both modes share the same shared-state memory layout and dispatch pipeline.

use core::str
use core::runtime::intrinsics::{ptr_read, ptr_write, mem_alloc, mem_free, copy_nonoverlapping}
use std::http::server::dispatch::{app_dispatch, RESPONSE_413, RESPONSE_400}
use std::http::server::parse::{app_zerocopy_method, app_zerocopy_path, app_extract_body,
                       app_has_header_end, app_has_connection_close, app_is_http11,
                       app_is_bodyless_method, app_find_header_end_in_str,
                       app_count_requests, app_request_offset,
                       app_parse_headers, app_get_content_length,
                       app_has_chunked_encoding, app_has_expect_continue,
                       MAX_HEADERS, HEADER_ENTRY_SIZE}
use std::http::protocol::chunked::{recv_chunked_body, decode_chunked}
use std::net::eventloop::{NetEventLoop, Interest, Event}

// ── FFI ─────────────────────────────────────────────────────────
@extern("c") func tml_sys_recv(handle: I64, buf: *Unit, len: I64) -> I64
@extern("c") func tml_sys_send(handle: I64, buf: *Unit, len: I64) -> I64
@extern("c") func tml_sys_setsockopt(handle: I64, level: I32, opt: I32, val: I32) -> I32
@extern("tml_sys_close") func sys_close(handle: I64) -> I64
@extern("tml_sys_accept_v4") func sys_accept(handle: I64) -> I64
@extern("c") func tml_sys_socket(domain: I32, typ: I32, proto: I32) -> I64
@extern("c") func tml_sys_bind_v4(handle: I64, addr: I32, port: I32) -> I64
@extern("c") func tml_sys_listen(handle: I64, backlog: I32) -> I64
@extern("tml_thread_spawn") func raw_thread_spawn(f: *Unit, arg: *Unit, stack: U64) -> U64
@extern("tml_thread_detach") func raw_thread_detach(h: U64) -> I32
@extern("tml_thread_available_parallelism") func cpu_count() -> U32
@extern("tml_thread_sleep_ms") func thread_sleep_ms(ms: U64)

// High-resolution timer for latency measurement
@extern("c") func time_ns() -> I64

// Mutex FFI
@extern("c") func tml_mutex_init(mutex: *Unit) -> I32
@extern("c") func tml_mutex_lock(mutex: *Unit) -> I32
@extern("c") func tml_mutex_unlock(mutex: *Unit) -> I32

// Condvar FFI
@extern("c") func tml_condvar_init(cvar: *Unit) -> I32
@extern("c") func tml_condvar_notify_one(cvar: *Unit) -> I32
@extern("c") func tml_condvar_notify_all(cvar: *Unit) -> I32
@extern("c") func tml_condvar_wait(cvar: *Unit, mutex: *Unit) -> I32

// Compiler-generated decorator route registration.
// Always emitted by the codegen (empty if no @Get/@Post/etc. routes).
// Writes route entries to the flat handler table and updates count_ptr.
@extern("c") func __tml_register_routes(table: I64, count_ptr: mut ref I64, trees: I64)

const AF_INET: I32 = 2
const SOCK_STREAM: I32 = 1
const SOL_SOCKET: I32 = 65535
const SO_REUSEADDR: I32 = 4
#if LINUX
const SO_REUSEPORT: I32 = 15
#endif
const SO_RCVTIMEO: I32 = 4102
const SO_SNDTIMEO: I32 = 4101
const IPPROTO_TCP: I32 = 6
const TCP_NODELAY: I32 = 1
const BUF_SIZE: I64 = 65536     // 64KB for HTTP pipelining (captures ~100 pipelined requests)
const RESP_BUF_SIZE: I64 = 65536 // 64KB response batch buffer
const QUEUE_CAP: I64 = 4096

// ════════════════════════════════════════════════════════════════════
// Shared state memory layout offsets (same layout as dispatch.tml)
// ════════════════════════════════════════════════════════════════════

const OFF_TABLE: I64 = 0
const OFF_COUNT: I64 = 8
const OFF_ROUTER: I64 = 16
const OFF_MW_TABLE: I64 = 24
const OFF_MW_COUNT: I64 = 32
const OFF_SHUTDOWN: I64 = 40
const OFF_READ_TIMEOUT: I64 = 48
const OFF_WRITE_TIMEOUT: I64 = 56
const OFF_IDLE_TIMEOUT: I64 = 64
const OFF_BODY_LIMIT: I64 = 72
const OFF_ON_REQUEST_TABLE: I64 = 80
const OFF_ON_REQUEST_COUNT: I64 = 88
const OFF_PRE_HANDLER_TABLE: I64 = 96
const OFF_PRE_HANDLER_COUNT: I64 = 104
const OFF_ON_SEND_TABLE: I64 = 112
const OFF_ON_SEND_COUNT: I64 = 120
const OFF_ON_RESPONSE_TABLE: I64 = 128
const OFF_ON_RESPONSE_COUNT: I64 = 136
const OFF_ON_ERROR_TABLE: I64 = 144
const OFF_ON_ERROR_COUNT: I64 = 152
const OFF_ERROR_HANDLER: I64 = 160
const OFF_QUEUE_BUF: I64 = 168
const OFF_QUEUE_HEAD: I64 = 176
const OFF_QUEUE_TAIL: I64 = 184
const OFF_QUEUE_CAP: I64 = 192
const OFF_QUEUE_LEN: I64 = 200
const OFF_MUTEX: I64 = 208
const OFF_CONDVAR: I64 = 272

const SHARED_SIZE: I64 = 336
const ENTRY_SIZE: I64 = 24

// ════════════════════════════════════════════════════════════════════
// Shared state accessors (encapsulate raw ptr_read/ptr_write)
// ════════════════════════════════════════════════════════════════════

/// Read an I64 field from the shared state block at the given offset.
func shared_get(shared: I64, offset: I64) -> I64 {
    lowlevel { ptr_read[I64]((shared + offset) as *I64) }
}

/// Write an I64 field to the shared state block at the given offset.
func shared_set(shared: I64, offset: I64, value: I64) {
    lowlevel { ptr_write[I64]((shared + offset) as *I64, value) }
}

// ════════════════════════════════════════════════════════════════════
// Shutdown
// ════════════════════════════════════════════════════════════════════

/// Signal a running server to shut down gracefully.
/// Takes the shared state pointer (from listen setup).
/// Phase 1: Stop accepting (set DRAINING flag).
/// Phase 2: Wait for in-flight requests to drain (drain_timeout_ms).
/// Phase 3: Force shutdown remaining connections.
pub func app_shutdown(shared: I64) {
    app_shutdown_with_timeout(shared, 5000)
}

/// Graceful shutdown with configurable drain timeout (milliseconds).
/// 0 = immediate shutdown (no draining).
pub func app_shutdown_with_timeout(shared: I64, drain_timeout_ms: I64) {
    if shared == 0 { return }

    // Phase 1: Set shutdown flag — workers stop accepting new work
    shared_set(shared, OFF_SHUTDOWN, 1)

    // Phase 2: Drain — wait for in-flight requests to complete
    if drain_timeout_ms > 0 {
        let start: I64 = time_ns()
        let deadline_ns: I64 = start + drain_timeout_ms * 1000000
        loop (time_ns() < deadline_ns) {
            let queue_len: I64 = shared_get(shared, OFF_QUEUE_LEN)
            if queue_len == 0 { break }
            // Brief sleep to avoid busy-wait (1ms)
            thread_sleep_ms(1 as U64)
        }
    }

    // Phase 3: Wake all blocked workers to exit
    let condvar_ptr: I64 = shared + OFF_CONDVAR
    tml_condvar_notify_all(condvar_ptr as *Unit)
}

// ════════════════════════════════════════════════════════════════════
// Thread Pool — ring buffer with mutex+condvar
// ════════════════════════════════════════════════════════════════════

/// Enqueue a file descriptor into the work queue. Returns true if enqueued.
func queue_push(shared: I64, fd: I64) -> Bool {
    let mutex_ptr: I64 = shared + OFF_MUTEX
    tml_mutex_lock(mutex_ptr as *Unit)

    let buf: I64 = shared_get(shared, OFF_QUEUE_BUF)
    let cap: I64 = shared_get(shared, OFF_QUEUE_CAP)
    let len: I64 = shared_get(shared, OFF_QUEUE_LEN)

    if len >= cap {
        tml_mutex_unlock(mutex_ptr as *Unit)
        return false
    }

    let tail: I64 = shared_get(shared, OFF_QUEUE_TAIL)
    lowlevel { ptr_write[I64]((buf + tail * 8) as *I64, fd) }
    let new_tail: I64 = (tail + 1) % cap
    shared_set(shared, OFF_QUEUE_TAIL, new_tail)
    shared_set(shared, OFF_QUEUE_LEN, len + 1)

    let condvar_ptr: I64 = shared + OFF_CONDVAR
    tml_condvar_notify_one(condvar_ptr as *Unit)
    tml_mutex_unlock(mutex_ptr as *Unit)
    return true
}

/// Dequeue a file descriptor. Blocks until one is available or shutdown.
/// Returns -1 on shutdown.
func queue_pop(shared: I64) -> I64 {
    let mutex_ptr: I64 = shared + OFF_MUTEX
    let condvar_ptr: I64 = shared + OFF_CONDVAR
    tml_mutex_lock(mutex_ptr as *Unit)

    loop (true) {
        if shared_get(shared, OFF_SHUTDOWN) != 0 {
            tml_mutex_unlock(mutex_ptr as *Unit)
            return -1
        }
        if shared_get(shared, OFF_QUEUE_LEN) > 0 { break }
        tml_condvar_wait(condvar_ptr as *Unit, mutex_ptr as *Unit)
    }

    let buf: I64 = shared_get(shared, OFF_QUEUE_BUF)
    let cap: I64 = shared_get(shared, OFF_QUEUE_CAP)
    let head: I64 = shared_get(shared, OFF_QUEUE_HEAD)
    let len: I64 = shared_get(shared, OFF_QUEUE_LEN)

    let fd: I64 = lowlevel { ptr_read[I64]((buf + head * 8) as *I64) }
    let new_head: I64 = (head + 1) % cap
    shared_set(shared, OFF_QUEUE_HEAD, new_head)
    shared_set(shared, OFF_QUEUE_LEN, len - 1)

    tml_mutex_unlock(mutex_ptr as *Unit)
    return fd
}

// ════════════════════════════════════════════════════════════════════
// Worker thread — pulls fds from queue, handles connections
// ════════════════════════════════════════════════════════════════════

/// Dispatch a single HTTP request from the recv buffer at the given offset.
/// Uses zero-copy parsing: null-terminates in-place at buf+offset.
/// Returns the response string (from app_dispatch or error handler).
func dispatch_single(shared: I64, buf: I64, offset: I64, req_len: I64,
                     fd: I64, params_buf: I64, body_limit: I64) -> Str {
    let req_buf: I64 = buf + offset
    lowlevel { ptr_write[U8]((req_buf + req_len) as *U8, 0 as U8) }
    let method: Str = app_zerocopy_method(req_buf, req_len)
    let path: Str = app_zerocopy_path(req_buf, req_len)

    let method_len: I64 = str::len(method)
    var body: Str = ""
    if method_len != 3 and not app_is_bodyless_method(method) {
        body = app_extract_body(req_buf, req_len)
        let body_len: I64 = str::len(body)
        if body_limit > 0 and body_len > body_limit {
            return RESPONSE_413
        }
    }

    return app_dispatch(shared, method, path, body, fd, params_buf)
}

/// Accept-per-worker: each thread calls accept() directly on the listener.
/// No shared queue, no mutex contention. Kernel distributes connections.
pub func app_accept_worker(arg: *Unit) {
    let shared: I64 = arg as I64
    let listener: I64 = shared_get(shared, OFF_QUEUE_BUF)
    let body_limit: I64 = shared_get(shared, OFF_BODY_LIMIT)
    let read_timeout: I64 = shared_get(shared, OFF_READ_TIMEOUT)
    let write_timeout: I64 = shared_get(shared, OFF_WRITE_TIMEOUT)
    let idle_timeout: I64 = shared_get(shared, OFF_IDLE_TIMEOUT)

    let buf: I64 = lowlevel { mem_alloc(BUF_SIZE) } as I64
    let params_buf: I64 = lowlevel { mem_alloc(128) } as I64
    let hdrs_buf_size: I64 = MAX_HEADERS * HEADER_ENTRY_SIZE
    let hdrs_buf: I64 = lowlevel { mem_alloc(hdrs_buf_size) } as I64
    let resp_buf: I64 = lowlevel { mem_alloc(RESP_BUF_SIZE) } as I64

    loop (true) {
        let shutdown: I64 = shared_get(shared, OFF_SHUTDOWN)
        if shutdown != 0 { break }

        // Accept directly — kernel distributes among N threads
        let fd: I64 = sys_accept(listener)
        if fd < 0 { continue }

        // Set socket options
        tml_sys_setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, 1)
        if idle_timeout > 0 {
            tml_sys_setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, idle_timeout as I32)
        }

        // Keep-alive loop
        loop (true) {
            let n: I64 = tml_sys_recv(fd, buf as *Unit, BUF_SIZE - 1)
            if n <= 0 { break }
            var total: I64 = n

            if not app_has_header_end(buf, total) {
                loop (total < BUF_SIZE - 1) {
                    let n2: I64 = tml_sys_recv(fd, (buf + total) as *Unit, BUF_SIZE - total - 1)
                    if n2 <= 0 { break }
                    total = total + n2
                    if app_has_header_end(buf, total) { break }
                }
                if not app_has_header_end(buf, total) {
                    if total >= BUF_SIZE - 1 {
                        tml_sys_send(fd, RESPONSE_400 as *Unit, str::len(RESPONSE_400))
                    }
                    break
                }
            }

            let response: Str = dispatch_single(shared, buf, 0, total, fd, params_buf, body_limit)
            let resp_len: I64 = str::len(response)
            tml_sys_send(fd, response as *Unit, resp_len)

            // Check Connection: close
            lowlevel { ptr_write[U8]((buf + total) as *U8, 0 as U8) }
            if app_has_connection_close(buf, total) { break }
            if not app_is_http11(buf, total) { break }
        }

        sys_close(fd)
    }

    lowlevel { mem_free(buf as *Unit) }
    lowlevel { mem_free(params_buf as *Unit) }
    lowlevel { mem_free(hdrs_buf as *Unit) }
    lowlevel { mem_free(resp_buf as *Unit) }
}

pub func app_worker(arg: *Unit) {
    let shared: I64 = arg as I64
    let body_limit: I64 = shared_get(shared, OFF_BODY_LIMIT)

    let buf: I64 = lowlevel { mem_alloc(BUF_SIZE) } as I64
    let params_buf: I64 = lowlevel { mem_alloc(128) } as I64
    // Per-worker headers buffer (32 headers x 32 bytes = 1024 bytes)
    let hdrs_buf_size: I64 = MAX_HEADERS * HEADER_ENTRY_SIZE
    let hdrs_buf: I64 = lowlevel { mem_alloc(hdrs_buf_size) } as I64
    // Response batch buffer for HTTP pipelining
    let resp_buf: I64 = lowlevel { mem_alloc(RESP_BUF_SIZE) } as I64

    // Per-worker latency stats (nanoseconds)
    var stat_requests: I64 = 0
    var stat_latency_total_us: I64 = 0
    var stat_latency_min_us: I64 = 999999999
    var stat_latency_max_us: I64 = 0

    let idle_timeout: I64 = shared_get(shared, OFF_IDLE_TIMEOUT)

    loop (true) {
        let fd: I64 = queue_pop(shared)
        if fd < 0 { break }

        // Set idle timeout for keep-alive connections (SO_RCVTIMEO)
        // This makes recv() return 0/-1 if no data arrives within the timeout,
        // preventing connections from lingering indefinitely.
        if idle_timeout > 0 {
            tml_sys_setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, idle_timeout as I32)
        }

        // Keep-alive loop — process requests on this connection
        loop (true) {
            // ── 1. Read until headers complete (\r\n\r\n) ──────────
            let n: I64 = tml_sys_recv(fd, buf as *Unit, BUF_SIZE - 1)
            if n <= 0 { break }
            var total: I64 = n

            if not app_has_header_end(buf, total) {
                loop (total < BUF_SIZE - 1) {
                    let n2: I64 = tml_sys_recv(fd, (buf + total) as *Unit, BUF_SIZE - total - 1)
                    if n2 <= 0 { break }
                    total = total + n2
                    if app_has_header_end(buf, total) { break }
                }
                if not app_has_header_end(buf, total) {
                    // Headers too large or connection closed
                    if total >= BUF_SIZE - 1 {
                        tml_sys_send(fd, RESPONSE_400 as *Unit, str::len(RESPONSE_400))
                    }
                    break
                }
            }

            // ── 2. Detect HTTP version + Connection header ─────────
            let is_http11: Bool = app_is_http11(buf, total)
            var should_close: Bool = not is_http11
            if not should_close {
                should_close = app_has_connection_close(buf, total)
            }

            // ── 3. Pipelining fast path for bodyless methods ───────
            // For GET/HEAD/OPTIONS, \r\n\r\n reliably marks request boundaries
            // (no body to contain false \r\n\r\n). Batch process + batch send.
            let num_pipelined: I64 = app_count_requests(buf, total)
            if num_pipelined > 1 {
                // Check first method is bodyless (peek without mutating)
                var first_is_bodyless: Bool = false
                let first_space: I64 = 0
                var fs: I64 = 0
                loop (fs < total and fs < 10) {
                    if lowlevel { ptr_read[U8]((buf + fs) as *U8) } == 32 as U8 { break }
                    fs = fs + 1
                }
                // GET=3, HEAD=4, OPTIONS=7, TRACE=5
                if fs == 3 or fs == 4 or fs == 7 { first_is_bodyless = true }

                if first_is_bodyless {
                    // Batch dispatch: process each pipelined request, batch responses
                    var batch_pos: I64 = 0
                    var req_idx: I64 = 0
                    loop (req_idx < num_pipelined) {
                        let req_start: I64 = app_request_offset(buf, total, req_idx)
                        if req_start < 0 { break }
                        var req_end: I64 = total
                        if req_idx + 1 < num_pipelined {
                            let next: I64 = app_request_offset(buf, total, req_idx + 1)
                            if next > 0 { req_end = next }
                        }
                        let req_len: I64 = req_end - req_start

                        let response: Str = dispatch_single(shared, buf, req_start, req_len, fd, params_buf, body_limit)
                        let resp_len: I64 = str::len(response)

                        if batch_pos + resp_len <= RESP_BUF_SIZE {
                            lowlevel { copy_nonoverlapping(response as *Unit, (resp_buf + batch_pos) as *Unit, resp_len) }
                            batch_pos = batch_pos + resp_len
                        } else {
                            // Flush batch, send directly
                            if batch_pos > 0 {
                                var sent: I64 = 0
                                loop (sent < batch_pos) {
                                    let w: I64 = tml_sys_send(fd, (resp_buf + sent) as *Unit, batch_pos - sent)
                                    if w <= 0 { break }
                                    sent = sent + w
                                }
                                batch_pos = 0
                            }
                            tml_sys_send(fd, response as *Unit, resp_len)
                        }
                        req_idx = req_idx + 1
                    }
                    // Send batched responses
                    if batch_pos > 0 {
                        var sent: I64 = 0
                        loop (sent < batch_pos) {
                            let w: I64 = tml_sys_send(fd, (resp_buf + sent) as *Unit, batch_pos - sent)
                            if w <= 0 { break }
                            sent = sent + w
                        }
                    }
                    if should_close { break }
                    continue  // Back to recv for more requests
                }
                // else: first request has body — fall through to single-request path
            }

            // ── 3b. Parse headers (zero-copy into recv buffer) ─────
            let hdr_count: I64 = app_parse_headers(buf, total, hdrs_buf)

            // ── 4. Zero-copy parse method + path ───────────────────
            lowlevel { ptr_write[U8]((buf + total) as *U8, 0 as U8) }
            let method: Str = app_zerocopy_method(buf, total)
            let path: Str = app_zerocopy_path(buf, total)
            let method_len: I64 = str::len(method)

            // ── 4b. Expect: 100-continue (RFC 7231 §5.1.1) ────────
            // If client sent "Expect: 100-continue", send 100 Continue before
            // reading the body so the client knows it's safe to proceed.
            if not app_is_bodyless_method(method) and app_has_expect_continue(hdrs_buf, hdr_count) {
                let resp_100: Str = "HTTP/1.1 100 Continue\r\n\r\n"
                tml_sys_send(fd, resp_100 as *Unit, str::len(resp_100))
            }

            // ── 5. Read body (chunked or Content-Length) ─────────────
            var body: Str = ""
            if method_len != 3 and not app_is_bodyless_method(method) {
                let is_chunked: Bool = app_has_chunked_encoding(hdrs_buf, hdr_count)

                if is_chunked {
                    // Chunked transfer encoding — read chunks from socket
                    let initial_data: Str = app_extract_body(buf, total)
                    body = recv_chunked_body(fd, initial_data, body_limit)
                    let decoded_len: I64 = str::len(body)
                    if body_limit > 0 and decoded_len > body_limit {
                        tml_sys_send(fd, RESPONSE_413 as *Unit, str::len(RESPONSE_413))
                        break
                    }
                } else {
                    // Content-Length based body reading
                    let content_length: I64 = app_get_content_length(hdrs_buf, hdr_count)

                    if content_length > 0 {
                        // Check body limit
                        if body_limit > 0 and content_length > body_limit {
                            tml_sys_send(fd, RESPONSE_413 as *Unit, str::len(RESPONSE_413))
                            break
                        }

                        // Find where body starts in current buffer
                        let body_in_buf: Str = app_extract_body(buf, total)
                        let body_have: I64 = str::len(body_in_buf)

                        if body_have >= content_length {
                            // All body already in buffer — common case for small POST
                            body = body_in_buf
                        } else {
                            // Need to read more body data
                            let body_buf: I64 = lowlevel { mem_alloc(content_length + 1) } as I64
                            // Copy what we have
                            if body_have > 0 {
                                lowlevel { copy_nonoverlapping(body_in_buf as *Unit, body_buf as *Unit, body_have) }
                            }
                            var body_read: I64 = body_have
                            // Read remaining body
                            loop (body_read < content_length) {
                                let remaining: I64 = content_length - body_read
                                let nr: I64 = tml_sys_recv(fd, (body_buf + body_read) as *Unit, remaining)
                                if nr <= 0 { break }
                                body_read = body_read + nr
                            }
                            lowlevel { ptr_write[U8]((body_buf + body_read) as *U8, 0 as U8) }
                            body = body_buf as Str
                        }
                    } else if content_length == 0 {
                        body = ""
                    } else {
                        // No Content-Length — take whatever body is in the buffer
                        body = app_extract_body(buf, total)
                    }
                }
            }

            // ── 6. HEAD support ────────────────────────────────────
            let is_head: Bool = method_len == 4 and str::char_at(method, 0) == 72

            // ── 7. Dispatch to handler (with latency tracking) ─────
            let t0: I64 = time_ns()
            let response: Str = app_dispatch(shared, method, path, body, fd, params_buf)
            let t1: I64 = time_ns()
            let latency_us: I64 = (t1 - t0) / 1000
            stat_requests = stat_requests + 1
            stat_latency_total_us = stat_latency_total_us + latency_us
            if latency_us < stat_latency_min_us { stat_latency_min_us = latency_us }
            if latency_us > stat_latency_max_us { stat_latency_max_us = latency_us }
            var send_len: I64 = str::len(response)
            if is_head {
                let header_end: I64 = app_find_header_end_in_str(response)
                if header_end > 0 { send_len = header_end }
            }

            // ── 8. Send response ───────────────────────────────────
            var sent_total: I64 = 0
            loop (sent_total < send_len) {
                let sent: I64 = tml_sys_send(fd, (response as I64 + sent_total) as *Unit, send_len - sent_total)
                if sent <= 0 { break }
                sent_total = sent_total + sent
            }
            if sent_total < send_len { break }
            if should_close { break }
        }

        sys_close(fd)
    }

    lowlevel { mem_free(buf as *Unit) }
    lowlevel { mem_free(params_buf as *Unit) }
    lowlevel { mem_free(hdrs_buf as *Unit) }
    lowlevel { mem_free(resp_buf as *Unit) }
}

// ════════════════════════════════════════════════════════════════════
// Listen — binds, spawns thread pool, accepts connections
// ════════════════════════════════════════════════════════════════════

pub func app_listen(
    table: I64, count: I64, trees: I64,
    mw_table: I64, mw_count: I64,
    on_request_table: I64, on_request_count: I64,
    pre_handler_table: I64, pre_handler_count: I64,
    on_send_table: I64, on_send_count: I64,
    on_response_table: I64, on_response_count: I64,
    on_error_table: I64, on_error_count: I64,
    error_handler: I64,
    read_timeout: I64, write_timeout: I64, idle_timeout: I64,
    body_limit: I64, port: I64
) {
    // Auto-register decorator routes (@Get, @Post, etc.) into the handler table.
    // The compiler always emits __tml_register_routes (empty if no decorators).
    // This merges decorator routes with any manually-registered routes.
    var total_count: I64 = count
    __tml_register_routes(table, mut ref total_count, trees)

    let num_workers: I64 = cpu_count() as I64
    if num_workers < 1 { return }

    println("TML HTTP Server")
    println("  Port:       " + port.to_string())
    println("  Workers:    " + num_workers.to_string() + " (thread pool)")
    println("  Keep-Alive: yes")
    println("  Timeouts:   read=" + read_timeout.to_string() + "ms write=" + write_timeout.to_string() + "ms idle=" + idle_timeout.to_string() + "ms")
    println("  Middleware: " + mw_count.to_string())
    println("  Routes:     " + total_count.to_string())
    println("  Hooks:      onRequest=" + on_request_count.to_string() +
            " preHandler=" + pre_handler_count.to_string() +
            " onSend=" + on_send_count.to_string() +
            " onResponse=" + on_response_count.to_string() +
            " onError=" + on_error_count.to_string())
    println("")

    var i: I64 = 0
    loop (i < total_count) {
        let offset: I64 = i * ENTRY_SIZE
        let m: Str = lowlevel { ptr_read[I64]((table + offset) as *I64) } as Str
        let p: Str = lowlevel { ptr_read[I64]((table + offset + 8) as *I64) } as Str
        println("  " + m + "\t" + p)
        i = i + 1
    }
    println("")

    let listener: I64 = app_bind_listener(port)
    if listener < 0 {
        println("ERROR: could not bind to port " + port.to_string())
        return
    }
    println("Listening on http://localhost:" + port.to_string())

    // Allocate and zero shared state
    let shared: I64 = lowlevel { mem_alloc(SHARED_SIZE) } as I64
    var z: I64 = 0
    loop (z < SHARED_SIZE) {
        lowlevel { ptr_write[U8]((shared + z) as *U8, 0 as U8) }
        z = z + 1
    }

    // Write shared state fields
    shared_set(shared, OFF_TABLE, table)
    shared_set(shared, OFF_COUNT, total_count)
    shared_set(shared, OFF_ROUTER, trees)
    shared_set(shared, OFF_MW_TABLE, mw_table)
    shared_set(shared, OFF_MW_COUNT, mw_count)
    shared_set(shared, OFF_SHUTDOWN, 0)
    shared_set(shared, OFF_READ_TIMEOUT, read_timeout)
    shared_set(shared, OFF_WRITE_TIMEOUT, write_timeout)
    shared_set(shared, OFF_IDLE_TIMEOUT, idle_timeout)
    shared_set(shared, OFF_BODY_LIMIT, body_limit)
    shared_set(shared, OFF_ON_REQUEST_TABLE, on_request_table)
    shared_set(shared, OFF_ON_REQUEST_COUNT, on_request_count)
    shared_set(shared, OFF_PRE_HANDLER_TABLE, pre_handler_table)
    shared_set(shared, OFF_PRE_HANDLER_COUNT, pre_handler_count)
    shared_set(shared, OFF_ON_SEND_TABLE, on_send_table)
    shared_set(shared, OFF_ON_SEND_COUNT, on_send_count)
    shared_set(shared, OFF_ON_RESPONSE_TABLE, on_response_table)
    shared_set(shared, OFF_ON_RESPONSE_COUNT, on_response_count)
    shared_set(shared, OFF_ON_ERROR_TABLE, on_error_table)
    shared_set(shared, OFF_ON_ERROR_COUNT, on_error_count)
    shared_set(shared, OFF_ERROR_HANDLER, error_handler)

    // Init thread pool queue
    let queue_buf: I64 = lowlevel { mem_alloc(QUEUE_CAP * 8) } as I64
    shared_set(shared, OFF_QUEUE_BUF, queue_buf)
    shared_set(shared, OFF_QUEUE_CAP, QUEUE_CAP)

    // Init mutex and condvar
    let mutex_ptr: I64 = shared + OFF_MUTEX
    let condvar_ptr: I64 = shared + OFF_CONDVAR
    tml_mutex_init(mutex_ptr as *Unit)
    tml_condvar_init(condvar_ptr as *Unit)

    // Spawn worker threads (pull from shared queue)
    var w: I64 = 0
    loop (w < num_workers) {
        let h: U64 = raw_thread_spawn(app_worker as *Unit, shared as *Unit, 0 as U64)
        if h != 0 as U64 {
            raw_thread_detach(h)
        }
        w = w + 1
    }

    // Accept loop — main thread accepts and pushes to queue
    loop (true) {
        let shutdown: I64 = shared_get(shared, OFF_SHUTDOWN)
        if shutdown != 0 { break }

        let fd: I64 = sys_accept(listener)
        if fd < 0 { continue }

        // Set socket options in accept thread (saves syscalls in worker)
        tml_sys_setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, 1)
        if idle_timeout > 0 {
            tml_sys_setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, idle_timeout as I32)
        }

        let ok: Bool = queue_push(shared, fd)
        if not ok {
            sys_close(fd)
        }
    }

    sys_close(listener)
}

// ════════════════════════════════════════════════════════════════════
// Event Loop — non-blocking I/O via std::net::eventloop
// ════════════════════════════════════════════════════════════════════

const CONN_STRIDE_EV: I64 = 56
const CONN_FD: I64 = 0
const CONN_BUF: I64 = 8
const CONN_USED: I64 = 16
const CONN_STATE: I64 = 24
const CONN_RESP: I64 = 32
const CONN_RESP_LEN: I64 = 40
const CONN_RESP_SENT: I64 = 48
const MAX_CONNS_PER_WORKER: I64 = 1024

const WSTATE_SIZE: I64 = 40
const WS_SHARED: I64 = 0
const WS_MUTEX: I64 = 8
const WS_NEW_FDS: I64 = 16
const WS_NEW_FDS_COUNT: I64 = 24
const WS_NEW_FDS_CAP: I64 = 32

func conn_get(conns: I64, idx: I64, field: I64) -> I64 {
    lowlevel { ptr_read[I64]((conns + idx * CONN_STRIDE_EV + field) as *I64) }
}

func conn_set(conns: I64, idx: I64, field: I64, val: I64) {
    lowlevel { ptr_write[I64]((conns + idx * CONN_STRIDE_EV + field) as *I64, val) }
}

/// Event loop worker thread. Each worker owns an EventLoop + connection table.
pub func app_evloop_worker(arg: *Unit) {
    let ws: I64 = arg as I64
    let shared: I64 = lowlevel { ptr_read[I64]((ws + WS_SHARED) as *I64) }
    let mutex_ptr: I64 = lowlevel { ptr_read[I64]((ws + WS_MUTEX) as *I64) }
    let body_limit: I64 = shared_get(shared, OFF_BODY_LIMIT)
    let params_buf: I64 = lowlevel { mem_alloc(128) } as I64

    var ev: NetEventLoop = NetEventLoop::new(256)
    let conns_mem: I64 = MAX_CONNS_PER_WORKER * CONN_STRIDE_EV
    let conns: I64 = lowlevel { mem_alloc(conns_mem) } as I64
    var conn_count: I64 = 0

    loop (true) {
        let shutdown: I64 = shared_get(shared, OFF_SHUTDOWN)
        if shutdown != 0 { break }

        // Drain new connections from accept thread
        tml_mutex_lock(mutex_ptr as *Unit)
        let new_count: I64 = lowlevel { ptr_read[I64]((ws + WS_NEW_FDS_COUNT) as *I64) }
        let new_buf: I64 = lowlevel { ptr_read[I64]((ws + WS_NEW_FDS) as *I64) }
        var ni: I64 = 0
        loop (ni < new_count and conn_count < MAX_CONNS_PER_WORKER) {
            let fd: I64 = lowlevel { ptr_read[I64]((new_buf + ni * 8) as *I64) }
            ev.make_nonblocking(fd)
            tml_sys_setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, 1)
            let buf: I64 = lowlevel { mem_alloc(BUF_SIZE) } as I64
            conn_set(conns, conn_count, CONN_FD, fd)
            conn_set(conns, conn_count, CONN_BUF, buf)
            conn_set(conns, conn_count, CONN_USED, 0)
            conn_set(conns, conn_count, CONN_STATE, 0)
            conn_set(conns, conn_count, CONN_RESP, 0)
            conn_set(conns, conn_count, CONN_RESP_LEN, 0)
            conn_set(conns, conn_count, CONN_RESP_SENT, 0)
            ev.register(fd, conn_count, Interest::readable())
            conn_count = conn_count + 1
            ni = ni + 1
        }
        lowlevel { ptr_write[I64]((ws + WS_NEW_FDS_COUNT) as *I64, 0 as I64) }
        tml_mutex_unlock(mutex_ptr as *Unit)

        // Adaptive poll: 0ms under load, 5ms idle
        var poll_ms: I32 = 0
        if conn_count == 0 { poll_ms = 5 }
        let n: I64 = ev.poll(poll_ms)
        if n <= 0 { continue }

        var ei: I64 = 0
        loop (ei < n) {
            let event: Event = ev.event_at(ei)
            let idx: I64 = event.token()

            if idx < 0 or idx >= conn_count { ei = ei + 1; continue }
            let fd: I64 = conn_get(conns, idx, CONN_FD)
            if fd <= 0 { ei = ei + 1; continue }

            let state: I64 = conn_get(conns, idx, CONN_STATE)

            if state == 0 and event.is_readable() {
                let buf: I64 = conn_get(conns, idx, CONN_BUF)
                let used: I64 = conn_get(conns, idx, CONN_USED)
                let n_read: I64 = tml_sys_recv(fd, (buf + used) as *Unit, BUF_SIZE - used - 1)
                if n_read <= 0 {
                    ev.deregister(fd)
                    sys_close(fd)
                    lowlevel { mem_free(buf as *Unit) }
                    conn_set(conns, idx, CONN_FD, 0)
                } else {
                    let new_used: I64 = used + n_read
                    conn_set(conns, idx, CONN_USED, new_used)
                    if app_has_header_end(buf, new_used) {
                        lowlevel { ptr_write[U8]((buf + new_used) as *U8, 0 as U8) }
                        let method: Str = app_zerocopy_method(buf, new_used)
                        let path: Str = app_zerocopy_path(buf, new_used)

                        var body: Str = ""
                        if not app_is_bodyless_method(method) {
                            // Parse headers to check for chunked encoding
                            let ev_hdrs_buf_size: I64 = MAX_HEADERS * HEADER_ENTRY_SIZE
                            let ev_hdrs_buf: I64 = lowlevel { mem_alloc(ev_hdrs_buf_size) } as I64
                            let ev_hdr_count: I64 = app_parse_headers(buf, new_used, ev_hdrs_buf)
                            let ev_is_chunked: Bool = app_has_chunked_encoding(ev_hdrs_buf, ev_hdr_count)
                            lowlevel { mem_free(ev_hdrs_buf as *Unit) }

                            if ev_is_chunked {
                                // Decode chunked body from what's already buffered
                                let raw_body: Str = app_extract_body(buf, new_used)
                                let chunked_result = decode_chunked(raw_body)
                                if chunked_result.complete {
                                    body = chunked_result.body
                                } else {
                                    // Incomplete chunked data — use raw for now
                                    // (event loop will accumulate more on next read)
                                    body = raw_body
                                }
                            } else {
                                body = app_extract_body(buf, new_used)
                            }
                        }

                        let body_len: I64 = str::len(body)
                        if body_limit > 0 and body_len > body_limit {
                            tml_sys_send(fd, RESPONSE_413 as *Unit, str::len(RESPONSE_413))
                            ev.deregister(fd)
                            sys_close(fd)
                            lowlevel { mem_free(buf as *Unit) }
                            conn_set(conns, idx, CONN_FD, 0)
                        } else {
                            let response: Str = app_dispatch(shared, method, path, body, fd, params_buf)
                            let resp_len: I64 = str::len(response)
                            conn_set(conns, idx, CONN_STATE, 1)
                            conn_set(conns, idx, CONN_RESP, response as I64)
                            conn_set(conns, idx, CONN_RESP_LEN, resp_len)
                            conn_set(conns, idx, CONN_RESP_SENT, 0)
                            conn_set(conns, idx, CONN_USED, 0)
                            ev.reregister(fd, idx, Interest::writable())
                        }
                    }
                }
            } else if state == 1 and event.is_writable() {
                let resp: I64 = conn_get(conns, idx, CONN_RESP)
                let resp_len: I64 = conn_get(conns, idx, CONN_RESP_LEN)
                let sent: I64 = conn_get(conns, idx, CONN_RESP_SENT)
                let remaining: I64 = resp_len - sent
                if remaining > 0 {
                    let n_sent: I64 = tml_sys_send(fd, (resp + sent) as *Unit, remaining)
                    if n_sent <= 0 {
                        ev.deregister(fd)
                        sys_close(fd)
                        let buf: I64 = conn_get(conns, idx, CONN_BUF)
                        lowlevel { mem_free(buf as *Unit) }
                        conn_set(conns, idx, CONN_FD, 0)
                    } else {
                        conn_set(conns, idx, CONN_RESP_SENT, sent + n_sent)
                        if sent + n_sent >= resp_len {
                            conn_set(conns, idx, CONN_STATE, 0)
                            conn_set(conns, idx, CONN_RESP, 0)
                            ev.reregister(fd, idx, Interest::readable())
                        }
                    }
                }
            }
            ei = ei + 1
        }
    }

    // Cleanup
    var ci: I64 = 0
    loop (ci < conn_count) {
        let fd: I64 = conn_get(conns, ci, CONN_FD)
        if fd > 0 {
            sys_close(fd)
            let buf: I64 = conn_get(conns, ci, CONN_BUF)
            lowlevel { mem_free(buf as *Unit) }
        }
        ci = ci + 1
    }
    lowlevel { mem_free(conns as *Unit) }
    lowlevel { mem_free(params_buf as *Unit) }
    ev.destroy()
}

/// Event-loop based listen. Each worker runs its own poller.
pub func app_listen_evloop(
    table: I64, count: I64, trees: I64,
    mw_table: I64, mw_count: I64,
    on_request_table: I64, on_request_count: I64,
    pre_handler_table: I64, pre_handler_count: I64,
    on_send_table: I64, on_send_count: I64,
    on_response_table: I64, on_response_count: I64,
    on_error_table: I64, on_error_count: I64,
    error_handler: I64,
    read_timeout: I64, write_timeout: I64, idle_timeout: I64,
    body_limit: I64, port: I64
) {
    // Auto-register decorator routes
    var total_count: I64 = count
    __tml_register_routes(table, mut ref total_count, trees)

    let num_workers: I64 = cpu_count() as I64
    if num_workers < 1 { return }

    println("TML HTTP Server (event loop)")
    println("  Port:       " + port.to_string())
    println("  Workers:    " + num_workers.to_string() + " (event loop, non-blocking)")
    println("  Keep-Alive: yes")
    println("  Timeouts:   read=" + read_timeout.to_string() + "ms write=" + write_timeout.to_string() + "ms idle=" + idle_timeout.to_string() + "ms")
    println("  Middleware: " + mw_count.to_string())
    println("  Routes:     " + total_count.to_string())
    println("  Hooks:      onRequest=" + on_request_count.to_string() +
            " preHandler=" + pre_handler_count.to_string() +
            " onSend=" + on_send_count.to_string() +
            " onResponse=" + on_response_count.to_string() +
            " onError=" + on_error_count.to_string())
    println("")

    var i: I64 = 0
    loop (i < total_count) {
        let offset: I64 = i * ENTRY_SIZE
        let m: Str = lowlevel { ptr_read[I64]((table + offset) as *I64) } as Str
        let p: Str = lowlevel { ptr_read[I64]((table + offset + 8) as *I64) } as Str
        println("  " + m + "\t" + p)
        i = i + 1
    }
    println("")

    let listener: I64 = app_bind_listener(port)
    if listener < 0 {
        println("ERROR: could not bind to port " + port.to_string())
        return
    }
    println("Listening on http://localhost:" + port.to_string())

    // Allocate and zero shared state
    let shared: I64 = lowlevel { mem_alloc(SHARED_SIZE) } as I64
    var z: I64 = 0
    loop (z < SHARED_SIZE) { lowlevel { ptr_write[U8]((shared + z) as *U8, 0 as U8) }; z = z + 1 }

    shared_set(shared, OFF_TABLE, table)
    shared_set(shared, OFF_COUNT, total_count)
    shared_set(shared, OFF_ROUTER, trees)
    shared_set(shared, OFF_MW_TABLE, mw_table)
    shared_set(shared, OFF_MW_COUNT, mw_count)
    shared_set(shared, OFF_SHUTDOWN, 0)
    shared_set(shared, OFF_READ_TIMEOUT, read_timeout)
    shared_set(shared, OFF_WRITE_TIMEOUT, write_timeout)
    shared_set(shared, OFF_IDLE_TIMEOUT, idle_timeout)
    shared_set(shared, OFF_BODY_LIMIT, body_limit)
    shared_set(shared, OFF_ON_REQUEST_TABLE, on_request_table)
    shared_set(shared, OFF_ON_REQUEST_COUNT, on_request_count)
    shared_set(shared, OFF_PRE_HANDLER_TABLE, pre_handler_table)
    shared_set(shared, OFF_PRE_HANDLER_COUNT, pre_handler_count)
    shared_set(shared, OFF_ON_SEND_TABLE, on_send_table)
    shared_set(shared, OFF_ON_SEND_COUNT, on_send_count)
    shared_set(shared, OFF_ON_RESPONSE_TABLE, on_response_table)
    shared_set(shared, OFF_ON_RESPONSE_COUNT, on_response_count)
    shared_set(shared, OFF_ON_ERROR_TABLE, on_error_table)
    shared_set(shared, OFF_ON_ERROR_COUNT, on_error_count)
    shared_set(shared, OFF_ERROR_HANDLER, error_handler)

    // Create per-worker state
    let workers: I64 = lowlevel { mem_alloc(num_workers * 8) } as I64
    var w: I64 = 0
    loop (w < num_workers) {
        let ws: I64 = lowlevel { mem_alloc(WSTATE_SIZE) } as I64
        var wz: I64 = 0
        loop (wz < WSTATE_SIZE) { lowlevel { ptr_write[U8]((ws + wz) as *U8, 0 as U8) }; wz = wz + 1 }
        let mutex: I64 = lowlevel { mem_alloc(64) } as I64
        tml_mutex_init(mutex as *Unit)
        let new_fds_cap: I64 = 256
        let new_fds: I64 = lowlevel { mem_alloc(2048) } as I64
        lowlevel { ptr_write[I64]((ws + WS_SHARED) as *I64, shared) }
        lowlevel { ptr_write[I64]((ws + WS_MUTEX) as *I64, mutex) }
        lowlevel { ptr_write[I64]((ws + WS_NEW_FDS) as *I64, new_fds) }
        lowlevel { ptr_write[I64]((ws + WS_NEW_FDS_COUNT) as *I64, 0 as I64) }
        lowlevel { ptr_write[I64]((ws + WS_NEW_FDS_CAP) as *I64, new_fds_cap) }
        lowlevel { ptr_write[I64]((workers + w * 8) as *I64, ws) }
        let h: U64 = raw_thread_spawn(app_evloop_worker as *Unit, ws as *Unit, 0 as U64)
        if h != 0 as U64 { raw_thread_detach(h) }
        w = w + 1
    }

    // Accept loop — round-robin distribute to workers
    var rr: I64 = 0
    loop (true) {
        let shutdown: I64 = shared_get(shared, OFF_SHUTDOWN)
        if shutdown != 0 { break }
        let fd: I64 = sys_accept(listener)
        if fd < 0 { continue }
        let ws: I64 = lowlevel { ptr_read[I64]((workers + rr * 8) as *I64) }
        let mutex: I64 = lowlevel { ptr_read[I64]((ws + WS_MUTEX) as *I64) }
        tml_mutex_lock(mutex as *Unit)
        let new_count: I64 = lowlevel { ptr_read[I64]((ws + WS_NEW_FDS_COUNT) as *I64) }
        let new_cap: I64 = lowlevel { ptr_read[I64]((ws + WS_NEW_FDS_CAP) as *I64) }
        let new_buf: I64 = lowlevel { ptr_read[I64]((ws + WS_NEW_FDS) as *I64) }
        if new_count < new_cap {
            lowlevel { ptr_write[I64]((new_buf + new_count * 8) as *I64, fd) }
            lowlevel { ptr_write[I64]((ws + WS_NEW_FDS_COUNT) as *I64, new_count + 1) }
            tml_mutex_unlock(mutex as *Unit)
        } else {
            tml_mutex_unlock(mutex as *Unit)
            let reject: Str = "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
            tml_sys_send(fd, reject as *Unit, str::len(reject))
            sys_close(fd)
        }
        rr = (rr + 1) % num_workers
    }

    sys_close(listener)
}

/// Create and bind a TCP listener socket on the given port.
/// Backlog 8192 for high-throughput scenarios (500K+ req/s target).
pub func app_bind_listener(port: I64) -> I64 {
    let sock: I64 = tml_sys_socket(AF_INET, SOCK_STREAM, 0)
    if sock < 0 { return -1 }
    tml_sys_setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, 1)
    #if LINUX
    tml_sys_setsockopt(sock, SOL_SOCKET, SO_REUSEPORT, 1)
    #endif
    if tml_sys_bind_v4(sock, 0, port as I32) < 0 { sys_close(sock); return -1 }
    if tml_sys_listen(sock, 8192) < 0 { sys_close(sock); return -1 }
    return sock
}
