//! HTTP request parsing — zero-copy and allocating parsers.
//!
//! Zero-copy parsers null-terminate in-place in the recv buffer, returning
//! a Str that points directly into the buffer. No allocations.
//! Allocating parsers copy into fresh heap buffers (for external callers).
//!
//! Pattern matching helpers support the legacy linear-scan compatibility path.

use core::str
use core::runtime::intrinsics::{ptr_read, ptr_write, mem_alloc, copy_nonoverlapping}

/// Read a byte at buf + offset.
func rd(buf: I64, offset: I64) -> I32 {
    lowlevel { ptr_read[U8]((buf + offset) as *U8) } as I32
}

/// Write a byte at buf + offset.
func wr(buf: I64, offset: I64, value: I32) {
    lowlevel { ptr_write[U8]((buf + offset) as *U8, value as U8) }
}

/// Maximum number of path parameters extracted per request.
pub const MAX_PARAMS: I64 = 8

// ════════════════════════════════════════════════════════════════════
// Zero-copy HTTP parsing
// ════════════════════════════════════════════════════════════════════
// These functions null-terminate in-place in the recv buffer, returning
// a Str that points directly into the buffer. No allocations.
// The caller's buffer is modified but that's fine — we only read method/path
// once per request before overwriting with the next recv.

/// Zero-copy method extraction. Overwrites the space after method with \0.
/// Returns Str pointing into buf. "GET /path HTTP/1.1\r\n" → "GET"
pub func app_zerocopy_method(buf: I64, len: I64) -> Str {
    var i: I64 = 0
    loop (i < len and i < 10) {
        let c: I32 = rd(buf, i)
        if c == 32 {
            wr(buf, i, 0)
            return buf as Str
        }
        i = i + 1
    }
    return ""
}

/// Zero-copy path extraction. Overwrites the space/? after path with \0.
/// Returns Str pointing into buf. Assumes method was already null-terminated.
/// Scans from start of buf to find the first null byte (end of method), then
/// the path starts at the next byte.
pub func app_zerocopy_path(buf: I64, len: I64) -> Str {
    // Find start: skip past the null-terminated method + the null byte
    var start: I64 = 0
    loop (start < len and start < 10) {
        if rd(buf, start) == 0 {
            start = start + 1
            break
        }
        start = start + 1
    }
    let path_start: I64 = start
    var end: I64 = start
    loop (end < len) {
        let c: I32 = rd(buf, end)
        if c == 32 or c == 63 { break }
        end = end + 1
    }
    if end <= path_start { return "/" }
    wr(buf, end, 0)
    // Percent-decode path in-place (e.g., %20 → space)
    let path_len: I64 = end - path_start
    app_percent_decode(buf + path_start, path_len)
    return (buf + path_start) as Str
}

/// Decode a hex character (0-9, A-F, a-f) to its value (0-15).
/// Returns -1 if not a valid hex character.
func hex_val(c: U8) -> I64 {
    let v: I64 = c as I64
    if v >= 48 and v <= 57 { return v - 48 }       // '0'-'9'
    if v >= 65 and v <= 70 { return v - 55 }       // 'A'-'F'
    if v >= 97 and v <= 102 { return v - 87 }      // 'a'-'f'
    return -1
}

/// URL percent-decode a path in-place. Converts %XX sequences to bytes.
/// Returns the new length (may be shorter than input). Null-terminates.
/// Example: "/hello%20world" → "/hello world" (length 12)
pub func app_percent_decode(buf: I64, len: I64) -> I64 {
    var read: I64 = 0
    var write: I64 = 0
    loop (read < len) {
        let c: I32 = rd(buf, read)
        if c == 37 and read + 2 < len {
            // '%' followed by two hex chars
            let h1: U8 = rd(buf, read + 1) as U8
            let h2: U8 = rd(buf, read + 2) as U8
            let v1: I64 = hex_val(h1)
            let v2: I64 = hex_val(h2)
            if v1 >= 0 and v2 >= 0 {
                wr(buf, write, (v1 * 16 + v2) as I32)
                write = write + 1
                read = read + 3
                continue
            }
        }
        if c == 43 {
            // '+' → space (common in query strings, also valid in paths)
            wr(buf, write, 32)
        } else if read != write {
            wr(buf, write, c)
        }
        write = write + 1
        read = read + 1
    }
    wr(buf, write, 0)
    return write
}

/// Detect HTTP version from request line. Returns true if HTTP/1.1, false if HTTP/1.0.
/// Scans backwards from the first \r to find "HTTP/1.0" or "HTTP/1.1".
/// Default: true (assume 1.1 if not detected).
pub func app_is_http11(buf: I64, len: I64) -> Bool {
    // Find first \r (end of request line)
    var cr: I64 = 0
    loop (cr < len and cr < 2048) {
        if rd(buf, cr) == 13 { break }
        cr = cr + 1
    }
    // "HTTP/1.0" is 8 chars before \r
    if cr >= 8 {
        let h: I64 = cr - 8
        let c0: I32 = rd(buf, h)      // 'H'
        let c4: I32 = rd(buf, h + 4)  // '/'
        let c7: I32 = rd(buf, h + 7)  // '0' or '1'
        if c0 == 72 and c4 == 47 {
            if c7 == 48 { return false }  // '0' → HTTP/1.0
        }
    }
    return true  // default HTTP/1.1
}

/// Check if HTTP method is "bodyless" (GET, HEAD, TRACE, OPTIONS).
/// Bodyless methods should not have the body parsed from the request.
pub func app_is_bodyless_method(method: Str) -> Bool {
    let len: I64 = str::len(method)
    if len == 3 {
        let c: I32 = str::char_at(method, 0)
        if c == 71 { return true }  // 'G' → GET
    }
    if len == 4 {
        let c: I32 = str::char_at(method, 0)
        if c == 72 { return true }  // 'H' → HEAD
    }
    if len == 5 {
        let c: I32 = str::char_at(method, 0)
        if c == 84 { return true }  // 'T' → TRACE
    }
    if len == 7 {
        let c: I32 = str::char_at(method, 0)
        if c == 79 { return true }  // 'O' → OPTIONS
    }
    return false
}

// ── Allocating HTTP parsing (kept for external use) ────────────

pub func app_extract_method(buf: I64, len: I64) -> Str {
    var i: I64 = 0
    loop (i < len and i < 10) {
        let c: I32 = rd(buf, i)
        if c == 32 {
            let p: I64 = lowlevel { mem_alloc(i + 1) } as I64
            lowlevel { copy_nonoverlapping(buf as *Unit, p as *Unit, i) }
            wr(p, i, 0)
            return p as Str
        }
        i = i + 1
    }
    return ""
}

pub func app_extract_path(buf: I64, len: I64) -> Str {
    var start: I64 = 0
    loop (start < len and start < 10) {
        let c: I32 = rd(buf, start)
        if c == 32 { start = start + 1; break }
        start = start + 1
    }
    var end: I64 = start
    loop (end < len) {
        let c: I32 = rd(buf, end)
        if c == 32 or c == 63 { break }
        end = end + 1
    }
    let path_len: I64 = end - start
    if path_len <= 0 { return "/" }
    let p: I64 = lowlevel { mem_alloc(path_len + 1) } as I64
    lowlevel { copy_nonoverlapping((buf + start) as *Unit, p as *Unit, path_len) }
    wr(p, path_len, 0)
    return p as Str
}

pub func app_extract_body(buf: I64, len: I64) -> Str {
    var i: I64 = 0
    loop (i < len - 3) {
        let c0: I32 = rd(buf, i)
        let c1: I32 = rd(buf, i + 1)
        let c2: I32 = rd(buf, i + 2)
        let c3: I32 = rd(buf, i + 3)
        if c0 == 13 and c1 == 10 and c2 == 13 and c3 == 10 {
            let body_start: I64 = i + 4
            let body_len: I64 = len - body_start
            if body_len <= 0 { return "" }
            let p: I64 = lowlevel { mem_alloc(body_len + 1) } as I64
            lowlevel { copy_nonoverlapping((buf + body_start) as *Unit, p as *Unit, body_len) }
            wr(p, body_len, 0)
            return p as Str
        }
        i = i + 1
    }
    return ""
}

pub func app_has_header_end(buf: I64, len: I64) -> Bool {
    if len < 4 { return false }
    // Scan backwards from end — header end (\r\n\r\n) is almost always near the
    // end of received data. For typical HTTP requests this finds it in 1-2 iterations
    // instead of scanning the entire buffer from the start.
    var i: I64 = len - 1
    loop (i >= 3) {
        let c3: I32 = rd(buf, i)
        // Quick filter: most bytes aren't \n (0x0A), skip immediately
        if c3 == 10 {
            let c2: I32 = rd(buf, i - 1)
            if c2 == 13 {
                let c1: I32 = rd(buf, i - 2)
                if c1 == 10 {
                    let c0: I32 = rd(buf, i - 3)
                    if c0 == 13 { return true }
                }
            }
        }
        i = i - 1
    }
    return false
}

/// Check if request has "Connection: close" header.
/// Scans raw recv buffer for case-insensitive "connection: close".
pub func app_has_connection_close(buf: I64, len: I64) -> Bool {
    // Simple scan for "onnection: close" (skip first char for case insensitivity)
    var i: I64 = 0
    loop (i < len - 16) {
        let c: I32 = rd(buf, i)
        // Check for 'o' or 'O' followed by "nnection: close"
        if (c == 111 or c == 79) {
            let n1: I32 = rd(buf, i + 1)
            let n2: I32 = rd(buf, i + 2)
            if (n1 == 110 or n1 == 78) and (n2 == 110 or n2 == 78) {
                // Check "ection: close" at i+3
                let e: I32 = rd(buf, i + 3)
                if e == 101 or e == 69 {
                    // Check ": close" or ":close" after "onnection"
                    var j: I64 = i + 10  // skip past "onnection"
                    // Find ':'
                    loop (j < i + 14 and j < len) {
                        if rd(buf, j) == 58 { break }
                        j = j + 1
                    }
                    if j < len {
                        j = j + 1
                        // Skip spaces
                        loop (j < len and rd(buf, j) == 32) {
                            j = j + 1
                        }
                        // Check "close"
                        if j + 5 <= len {
                            let c1: I32 = rd(buf, j)
                            let c2: I32 = rd(buf, j + 1)
                            if (c1 == 99 or c1 == 67) and (c2 == 108 or c2 == 76) {
                                return true
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return false
}

/// Find the end of headers (\r\n\r\n) in a response string. Returns position after \r\n\r\n, or 0.
pub func app_find_header_end_in_str(s: Str) -> I64 {
    let len: I64 = str::len(s)
    let buf: I64 = s as I64
    var i: I64 = 3
    loop (i < len) {
        if rd(buf, i - 3) == 13
           and rd(buf, i - 2) == 10
           and rd(buf, i - 1) == 13
           and rd(buf, i) == 10 {
            return i + 1
        }
        i = i + 1
    }
    return 0
}

// ════════════════════════════════════════════════════════════════════
// HTTP pipelining — count and locate request boundaries
// ════════════════════════════════════════════════════════════════════

/// Count the number of complete HTTP requests in a recv buffer.
/// Each \r\n\r\n marks the end of one request's headers.
/// Returns the count of complete requests (0 if none complete).
pub func app_count_requests(buf: I64, len: I64) -> I64 {
    if len < 4 { return 0 }
    var count: I64 = 0
    var i: I64 = 3
    loop (i < len) {
        if rd(buf, i) == 10
           and rd(buf, i - 1) == 13
           and rd(buf, i - 2) == 10
           and rd(buf, i - 3) == 13 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

/// Find the byte offset where the Nth request starts in the buffer (0-indexed).
/// Request 0 starts at offset 0. Request 1 starts after the first \r\n\r\n.
/// Returns -1 if the Nth request doesn't exist.
pub func app_request_offset(buf: I64, len: I64, n: I64) -> I64 {
    if n == 0 { return 0 }
    var count: I64 = 0
    var i: I64 = 3
    loop (i < len) {
        if rd(buf, i) == 10
           and rd(buf, i - 1) == 13
           and rd(buf, i - 2) == 10
           and rd(buf, i - 3) == 13 {
            count = count + 1
            if count == n { return i + 1 }
        }
        i = i + 1
    }
    return -1
}

// ════════════════════════════════════════════════════════════════════
// Zero-copy header parsing — nginx-style
// ════════════════════════════════════════════════════════════════════
// Headers are stored as pointers into the recv buffer. No allocations.
// Layout: headers_buf holds [name_ptr, name_len, value_ptr, value_len] x N
// Each entry is 32 bytes (4 x I64).

pub const MAX_HEADERS: I64 = 32
pub const HEADER_ENTRY_SIZE: I64 = 32

/// Parse HTTP headers from a recv buffer into a flat array.
/// Starts scanning after the request line (first \r\n).
/// Null-terminates header names and values in-place in the buffer.
/// Returns the number of headers parsed.
/// headers_buf layout: [name_ptr, name_len, value_ptr, value_len] per header.
pub func app_parse_headers(buf: I64, len: I64, headers_buf: I64) -> I64 {
    // Find end of request line (first \r\n)
    var pos: I64 = 0
    loop (pos < len - 1) {
        if rd(buf, pos) == 13 and rd(buf, pos + 1) == 10 {
            pos = pos + 2
            break
        }
        pos = pos + 1
    }

    var count: I64 = 0
    // Parse each header line: "Name: Value\r\n"
    loop (pos < len - 1 and count < MAX_HEADERS) {
        // Check for empty line (\r\n) = end of headers
        if rd(buf, pos) == 13 and rd(buf, pos + 1) == 10 {
            break
        }

        // Find colon
        let name_start: I64 = pos
        var colon: I64 = pos
        loop (colon < len) {
            if rd(buf, colon) == 58 { break }
            colon = colon + 1
        }
        if colon >= len { break }

        let name_len: I64 = colon - name_start

        // Skip ": " (colon + optional spaces)
        var val_start: I64 = colon + 1
        loop (val_start < len and rd(buf, val_start) == 32) {
            val_start = val_start + 1
        }

        // Find end of value (\r\n)
        var val_end: I64 = val_start
        loop (val_end < len - 1) {
            if rd(buf, val_end) == 13 and rd(buf, val_end + 1) == 10 {
                break
            }
            val_end = val_end + 1
        }
        let val_len: I64 = val_end - val_start

        // Store header entry: [name_ptr, name_len, value_ptr, value_len]
        var entry_off: I64 = 0
        for k in 0 to count { entry_off = entry_off + HEADER_ENTRY_SIZE }
        lowlevel { ptr_write[I64]((headers_buf + entry_off) as *I64, buf + name_start) }
        lowlevel { ptr_write[I64]((headers_buf + entry_off + 8) as *I64, name_len) }
        lowlevel { ptr_write[I64]((headers_buf + entry_off + 16) as *I64, buf + val_start) }
        lowlevel { ptr_write[I64]((headers_buf + entry_off + 24) as *I64, val_len) }
        count = count + 1

        // Move past \r\n
        pos = val_end + 2
    }
    return count
}

/// Get a header value by name (case-insensitive).
/// Scans the headers_buf parsed by app_parse_headers.
/// Returns the value as Str (pointer into recv buffer), or "" if not found.
pub func app_get_header(headers_buf: I64, header_count: I64, name: Str) -> Str {
    let name_len: I64 = str::len(name)
    var i: I64 = 0
    var off: I64 = 0
    loop (i < header_count) {
        let h_name_ptr: I64 = lowlevel { ptr_read[I64]((headers_buf + off) as *I64) }
        let h_name_len: I64 = lowlevel { ptr_read[I64]((headers_buf + off + 8) as *I64) }
        let h_val_ptr: I64 = lowlevel { ptr_read[I64]((headers_buf + off + 16) as *I64) }
        let h_val_len: I64 = lowlevel { ptr_read[I64]((headers_buf + off + 24) as *I64) }

        if h_name_len == name_len {
            // Case-insensitive comparison
            var matched: Bool = true
            for j in 0 to name_len {
                var a: I32 = rd(h_name_ptr, j)
                var b: I32 = rd(name as I64, j)
                // Lowercase: if A-Z (65-90), add 32
                if a >= 65 and a <= 90 { a = a + 32 }
                if b >= 65 and b <= 90 { b = b + 32 }
                if a != b { matched = false; break }
            }
            if matched {
                // Return a null-terminated copy of the value
                let vbuf: I64 = lowlevel { mem_alloc(h_val_len + 1) } as I64
                lowlevel { copy_nonoverlapping(h_val_ptr as *Unit, vbuf as *Unit, h_val_len) }
                wr(vbuf, h_val_len, 0)
                return vbuf as Str
            }
        }
        off = off + HEADER_ENTRY_SIZE
        i = i + 1
    }
    return ""
}

/// Extract Content-Length value from headers. Returns -1 if not present.
pub func app_get_content_length(headers_buf: I64, header_count: I64) -> I64 {
    let cl_str: Str = app_get_header(headers_buf, header_count, "content-length")
    if str::len(cl_str) == 0 { return -1 }
    // Parse integer from string
    var result: I64 = 0
    let slen: I64 = str::len(cl_str)
    for i in 0 to slen {
        let c: I32 = str::char_at(cl_str, i)
        if c < 48 or c > 57 { return -1 }  // not a digit
        result = result * 10 + (c - 48) as I64
    }
    return result
}

/// Check if request has "Expect: 100-continue" header (RFC 7231 §5.1.1).
/// Uses the headers_buf parsed by app_parse_headers.
/// Returns true if the client expects a 100 Continue before sending the body.
pub func app_has_expect_continue(headers_buf: I64, header_count: I64) -> Bool {
    let expect_val: Str = app_get_header(headers_buf, header_count, "expect")
    if str::len(expect_val) == 0 { return false }
    // RFC 7231: value must be "100-continue" (case-insensitive)
    return str::contains(str::to_lowercase(expect_val), "100-continue")
}

/// Check if Transfer-Encoding header contains "chunked" (case-insensitive).
/// Uses the headers_buf parsed by app_parse_headers.
pub func app_has_chunked_encoding(headers_buf: I64, header_count: I64) -> Bool {
    let te_str: Str = app_get_header(headers_buf, header_count, "transfer-encoding")
    if str::len(te_str) == 0 { return false }
    return str::contains(str::to_lowercase(te_str), "chunked")
}

/// Extract query string from a URL. Returns everything after '?' or "" if no query.
/// Does NOT modify the input — returns a new allocated string.
pub func app_extract_query(url: Str) -> Str {
    let len: I64 = str::len(url)
    for i in 0 to len {
        if str::char_at(url, i) == 63 {  // '?'
            if len - i - 1 <= 0 { return "" }
            return str::substring_from(url, i + 1)
        }
    }
    return ""
}

/// Extract path from a URL (everything before '?'). Allocating copy.
pub func app_extract_path_from_url(url: Str) -> Str {
    let len: I64 = str::len(url)
    for i in 0 to len {
        if str::char_at(url, i) == 63 {  // '?'
            if i == 0 { return "/" }
            return str::substring_to(url, i)
        }
    }
    return url  // no query string
}

// ════════════════════════════════════════════════════════════════════
// Pattern-matching helpers (kept for legacy linear-scan compat)
// ════════════════════════════════════════════════════════════════════

/// Check if a route pattern contains ':' (parametric segment).
func app_pattern_has_param(pattern: Str) -> Bool {
    let len: I64 = str::len(pattern)
    for i in 0 to len {
        if str::char_at(pattern, i) == 58 { return true }  // ':'
    }
    return false
}

/// Store a param name+value at index in the params buffer.
/// Each param = 16 bytes (name I64 + value I64).
pub func app_store_param(params_buf: I64, index: I64, name: Str, value: Str) {
    // Offset = index * 16. Use loop addition to avoid i32 multiplication codegen bug.
    var off: I64 = 0
    for j in 0 to index { off = off + 16 }
    lowlevel { ptr_write[I64]((params_buf + off) as *I64, name as I64) }
    lowlevel { ptr_write[I64]((params_buf + off + 8) as *I64, value as I64) }
}

/// Match a pattern like "/users/:id/posts" against a path like "/users/42/posts".
/// Returns true if match, stores extracted params in params_buf.
func app_pattern_match(pattern: Str, path: Str, params_buf: I64, pc: mut ref I64) -> Bool {
    let pat_len: I64 = str::len(pattern)
    let path_len: I64 = str::len(path)
    var pp: I64 = 0  // pattern position
    var xp: I64 = 0  // path position

    loop (pp < pat_len and xp < path_len) {
        if str::char_at(pattern, pp) == 58 {
            // Parametric segment: extract param name and value
            let name_start: I64 = pp + 1
            var name_end: I64 = name_start
            loop (name_end < pat_len and str::char_at(pattern, name_end) != 47) {
                name_end = name_end + 1
            }
            // Extract path value until next '/'
            var val_end: I64 = xp
            loop (val_end < path_len and str::char_at(path, val_end) != 47) {
                val_end = val_end + 1
            }
            if pc < MAX_PARAMS {
                let name: Str = str::substring(pattern, name_start, name_end)
                let value: Str = str::substring(path, xp, val_end)
                app_store_param(params_buf, pc, name, value)
                pc = pc + 1
            }
            pp = name_end
            xp = val_end
        } else {
            // Static character must match exactly
            if str::char_at(pattern, pp) != str::char_at(path, xp) {
                return false
            }
            pp = pp + 1
            xp = xp + 1
        }
    }
    // Both must be consumed (or pattern ends with param that consumed rest of path)
    return pp >= pat_len and xp >= path_len
}
