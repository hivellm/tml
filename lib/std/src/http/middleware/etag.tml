//! ETag generation and conditional request handling.
//!
//! Implements ETag (entity tag) generation for HTTP caching per RFC 7232.
//! Uses FNV-1a hash for fast, deterministic ETag generation.
//! Inspired by Express.js `etag` package.

use core::str
use core::fmt::helpers::i64_to_str
use std::text::Text

/// FNV-1a hash of a string, returned as a hex string.
/// Fast, deterministic, and good distribution for ETag use.
func fnv1a_hex(content: Str) -> Str {
    let content_len: I64 = str::len(content)
    // FNV-1a 64-bit: offset basis and prime (unsigned per spec)
    var hash: U64 = 14695981039346656037 as U64  // 0xCBF29CE484222325
    let prime: U64 = 1099511628211 as U64         // 0x100000001B3
    for i in 0 to content_len {
        let byte: U64 = str::char_at(content, i) as U64
        // XOR with byte, then multiply by prime (wrapping — FNV-1a requires modular arithmetic)
        hash = hash ^ byte
        hash = hash.wrapping_mul(prime)
    }
    // Convert to hex string
    let hex_chars: Str = "0123456789abcdef"
    var text = Text::new()
    // Output 16 hex chars (full 64-bit hash), extracting each nibble via right-shift
    var shift: I64 = 60
    loop (shift >= 0) {
        let nibble: U64 = (hash >> (shift as U64)) % (16 as U64)
        let idx: I64 = nibble as I64
        text.push_str(str::substring(hex_chars, idx, idx + 1))
        shift = shift - 4
    }
    return text.as_str()
}


/// Generates a strong ETag for the given content.
/// Uses FNV-1a hash + content length.
/// Returns: "\"hash-length\""
pub func generate(content: Str) -> Str {
    let content_len: I64 = str::len(content)
    if content_len == 0 {
        return "\"0-0\""
    }
    let hash: Str = fnv1a_hex(content)
    return "\"{hash}-{i64_to_str(content_len)}\""
}

/// Generates a weak ETag for the given content.
/// Returns: "W/\"hash-length\""
pub func generate_weak(content: Str) -> Str {
    let strong: Str = generate(content)
    return "W/{strong}"
}

/// Checks if the request's If-None-Match header matches the ETag.
/// Returns true if the content has NOT been modified (304 should be sent).
pub func is_not_modified(if_none_match: Str, etag: Str) -> Bool {
    let inm_len: I64 = str::len(if_none_match)
    let etag_len: I64 = str::len(etag)
    if inm_len == 0 or etag_len == 0 { return false }

    // Wildcard match
    if if_none_match == "*" { return true }

    // Direct match
    if if_none_match == etag { return true }

    // Strip W/ prefix for weak comparison
    var clean_inm: Str = if_none_match
    if str::starts_with(if_none_match, "W/") {
        clean_inm = str::substring(if_none_match, 2, inm_len)
    }
    var clean_etag: Str = etag
    if str::starts_with(etag, "W/") {
        clean_etag = str::substring(etag, 2, etag_len)
    }
    if clean_inm == clean_etag { return true }

    // Multiple ETags in If-None-Match (comma-separated)
    var pos: I64 = 0
    loop (pos < inm_len) {
        // Skip whitespace and commas
        loop (pos < inm_len and (str::char_at(if_none_match, pos) == 32 or str::char_at(if_none_match, pos) == 44)) {
            pos = pos + 1
        }
        var end: I64 = pos
        loop (end < inm_len and str::char_at(if_none_match, end) != 44) {
            end = end + 1
        }
        let part: Str = str::trim(str::substring(if_none_match, pos, end))
        if part == etag { return true }
        let part_len: I64 = str::len(part)
        var clean_part: Str = part
        if str::starts_with(part, "W/") {
            clean_part = str::substring(part, 2, part_len)
        }
        if clean_part == clean_etag { return true }
        pos = end + 1
    }
    return false
}

/// Checks If-Modified-Since header against a last-modified timestamp.
/// Returns true if the resource has NOT been modified (304 should be sent).
pub func is_not_modified_since(if_modified_since: Str, last_modified: Str) -> Bool {
    if str::len(if_modified_since) == 0 or str::len(last_modified) == 0 {
        return false
    }
    return if_modified_since == last_modified
}
