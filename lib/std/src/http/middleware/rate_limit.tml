//! HTTP rate limiting — token bucket algorithm.
//!
//! Implements in-memory rate limiting per client/key.
//! Inspired by Express.js `express-rate-limit`.

use core::str
use core::runtime::intrinsics::{ptr_read, ptr_write, mem_alloc, mem_free, copy_nonoverlapping}
use core::fmt::helpers::i64_to_str
use std::text::Text

/// Rate limiter configuration.
pub type RateLimitOptions {
    window_ms: I64,
    max_requests: I64,
}

impl RateLimitOptions {
    /// Creates default rate limit options (100 requests per 15 minutes).
    pub func new() -> RateLimitOptions {
        RateLimitOptions { window_ms: 900000, max_requests: 100 }
    }

    pub func with_window(this, ms: I64) -> RateLimitOptions {
        RateLimitOptions { window_ms: ms, max_requests: this.max_requests }
    }

    pub func with_max(this, max: I64) -> RateLimitOptions {
        RateLimitOptions { window_ms: this.window_ms, max_requests: max }
    }
}

/// Rate limit check result.
pub type RateLimitResult {
    allowed: Bool,
    remaining: I64,
    limit: I64,
    reset_at: I64,
}

impl RateLimitResult {
    pub func headers(this) -> Str {
        var text = Text::new()
        text.push_str("X-RateLimit-Limit: ")
        text.push_str(i64_to_str(this.limit))
        text.push_str("\r\nX-RateLimit-Remaining: ")
        text.push_str(i64_to_str(this.remaining))
        text.push_str("\r\nX-RateLimit-Reset: ")
        text.push_str(i64_to_str(this.reset_at))
        text.push_str("\r\n")
        if not this.allowed {
            text.push_str("Retry-After: ")
            text.push_str(i64_to_str(this.reset_at))
            text.push_str("\r\n")
        }
        return text.as_str()
    }
}

/// In-memory rate limiter with typed fields.
/// Entries are stored as a flat array of {key, count, window_start} triplets
/// on the heap, managed via lowlevel (justified: fixed-stride array with
/// linear scan, no existing collection supports 3-field stride).
pub type RateLimiter {
    window_ms: I64,
    max_requests: I64,
    entries: I64,       // heap ptr to [{key: I64, count: I64, start: I64}] × cap
    entry_count: I64,
    entry_cap: I64,
}

const ENTRY_STRIDE: I64 = 24  // 3 × I64

// Field offsets within a rate limiter entry.
const RL_FIELD_KEY: I64 = 0
const RL_FIELD_COUNT: I64 = 8
const RL_FIELD_START: I64 = 16

func entry_get(entries: I64, index: I64, field: I64) -> I64 {
    lowlevel { ptr_read[I64]((entries + index * ENTRY_STRIDE + field) as *I64) }
}

func entry_set(entries: I64, index: I64, field: I64, value: I64) {
    lowlevel { ptr_write[I64]((entries + index * ENTRY_STRIDE + field) as *I64, value) }
}

impl RateLimiter {
    pub func new(opts: RateLimitOptions) -> RateLimiter {
        let cap: I64 = 64
        RateLimiter {
            window_ms: opts.window_ms,
            max_requests: opts.max_requests,
            entries: lowlevel { mem_alloc(cap * ENTRY_STRIDE) } as I64,
            entry_count: 0,
            entry_cap: cap,
        }
    }

    pub func check(mut this, key: Str, now_ms: I64) -> RateLimitResult {
        let max_req: I64 = this.max_requests

        // Search for existing entry
        for i in 0 to this.entry_count {
            let entry_key: Str = entry_get(this.entries, i, RL_FIELD_KEY) as Str
            if entry_key == key {
                let entry_count: I64 = entry_get(this.entries, i, RL_FIELD_COUNT)
                let entry_start: I64 = entry_get(this.entries, i, RL_FIELD_START)

                if now_ms - entry_start >= this.window_ms {
                    // Reset window
                    entry_set(this.entries, i, RL_FIELD_COUNT, 1)
                    entry_set(this.entries, i, RL_FIELD_START, now_ms)
                    return RateLimitResult {
                        allowed: true, remaining: max_req - 1,
                        limit: max_req, reset_at: now_ms + this.window_ms,
                    }
                }

                let new_count: I64 = entry_count + 1
                entry_set(this.entries, i, RL_FIELD_COUNT, new_count)

                if new_count > max_req {
                    return RateLimitResult {
                        allowed: false, remaining: 0,
                        limit: max_req, reset_at: entry_start + this.window_ms,
                    }
                }
                return RateLimitResult {
                    allowed: true, remaining: max_req - new_count,
                    limit: max_req, reset_at: entry_start + this.window_ms,
                }
            }
        }

        // New entry
        let new_index: I64 = this.entry_count
        entry_set(this.entries, new_index, RL_FIELD_KEY,   key as I64)
        entry_set(this.entries, new_index, RL_FIELD_COUNT, 1)
        entry_set(this.entries, new_index, RL_FIELD_START, now_ms)
        this.entry_count = this.entry_count + 1

        return RateLimitResult {
            allowed: true, remaining: max_req - 1,
            limit: max_req, reset_at: now_ms + this.window_ms,
        }
    }

    pub func reset(mut this, key: Str) {
        for i in 0 to this.entry_count {
            let entry_key: Str = entry_get(this.entries, i, RL_FIELD_KEY) as Str
            if entry_key == key {
                let last: I64 = this.entry_count - 1
                if i != last {
                    let loff: I64 = last * ENTRY_STRIDE
                    let off: I64 = i * ENTRY_STRIDE
                    lowlevel { copy_nonoverlapping((this.entries + loff) as *Unit, (this.entries + off) as *Unit, ENTRY_STRIDE) }
                }
                this.entry_count = last
                return
            }
        }
    }

    pub func destroy(this) {
        if this.entries != 0 {
            lowlevel { mem_free(this.entries as *Unit) }
        }
    }
}
