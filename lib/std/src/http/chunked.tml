//! HTTP chunked transfer encoding — read and write.
//!
//! Implements chunked transfer encoding per RFC 7230 Section 4.1.
//! Used when the total content length is unknown at the time headers are sent.
//!
//! Format:
//!   chunk-size (hex)\r\n
//!   chunk-data\r\n
//!   ...
//!   0\r\n
//!   trailer-headers\r\n
//!   \r\n

use core::str
use core::intrinsics::{ptr_read, ptr_write, copy_nonoverlapping, mem_alloc, mem_free}
use std::collections::Buffer
use std::http::headers::Headers
use std::text::Text

// ============================================================================
// Hex helpers
// ============================================================================

/// Converts an I64 to a lowercase hexadecimal string (no prefix).
func i64_to_hex(n: I64) -> Str {
    if n == 0 { return "0" }
    let hex_chars: Str = "0123456789abcdef"
    // Collect digits least-significant-first into a 16-slot fixed array,
    // then write them in reverse to produce the correct MSB-first string.
    var digits: [Str; 16] = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
    var count: I64 = 0
    var val: I64 = n
    loop (val > 0) {
        let digit: I64 = val % 16
        digits[count] = str::substring(hex_chars, digit, digit + 1)
        count = count + 1
        val = val / 16
    }
    var builder: Text = Text::new()
    var j: I64 = count - 1
    loop (j >= 0) {
        builder.push_str(digits[j])
        j = j - 1
    }
    return builder.as_str()
}

/// Parses a hex string to I64. Returns -1 on invalid input.
func hex_to_i64(hex: Str) -> I64 {
    let hex_len: I64 = str::len(hex)
    if hex_len == 0 { return -1 as I64 }
    var result: I64 = 0
    var i: I64 = 0
    loop (i < hex_len) {
        let c: I32 = str::char_at(hex, i)
        var digit: I64 = 0
        if c >= 48 and c <= 57 {          // '0'-'9'
            digit = (c - 48) as I64
        } else if c >= 97 and c <= 102 {  // 'a'-'f'
            digit = (c - 87) as I64
        } else if c >= 65 and c <= 70 {   // 'A'-'F'
            digit = (c - 55) as I64
        } else {
            return -1 as I64  // invalid hex character
        }
        result = result * 16 + digit
        i = i + 1
    }
    return result
}

// ============================================================================
// Chunked Encoding (Writer)
// ============================================================================

/// Encodes a body string as a single chunk in chunked transfer encoding.
/// Returns: "hex-size\r\ndata\r\n"
pub func encode_chunk(data: Str) -> Str {
    let data_len: I64 = str::len(data)
    if data_len == 0 {
        return ""
    }
    let hex: Str = i64_to_hex(data_len)
    return "{hex}\r\n{data}\r\n"
}

/// Returns the final chunk marker (zero-length chunk).
/// Returns: "0\r\n\r\n"
pub func encode_final_chunk() -> Str {
    return "0\r\n\r\n"
}

/// Returns the final chunk marker with trailer headers.
/// Returns: "0\r\nTrailer: value\r\n\r\n"
pub func encode_final_chunk_with_trailers(trailers: ref Headers) -> Str {
    var result: Str = "0\r\n"
    result = "{result}{trailers.serialize()}"
    result = "{result}\r\n"
    return result
}

/// Encodes an entire body as chunked transfer encoding.
/// The body is sent as a single chunk followed by the final chunk.
pub func encode_body_chunked(body: Str) -> Str {
    let body_len: I64 = str::len(body)
    if body_len == 0 {
        return encode_final_chunk()
    }
    var result: Str = encode_chunk(body)
    result = "{result}{encode_final_chunk()}"
    return result
}

/// Encodes a body in multiple chunks of the specified size.
pub func encode_body_multi_chunk(body: Str, chunk_size: I64) -> Str {
    let body_len: I64 = str::len(body)
    if body_len == 0 {
        return encode_final_chunk()
    }
    var builder: Text = Text::new()
    var pos: I64 = 0
    loop (pos < body_len) {
        var end: I64 = pos + chunk_size
        if end > body_len {
            end = body_len
        }
        let chunk_data: Str = str::substring(body, pos, end)
        builder.push_str(encode_chunk(chunk_data))
        pos = end
    }
    builder.push_str(encode_final_chunk())
    return builder.as_str()
}

// ============================================================================
// Chunked Decoding (Reader)
// ============================================================================

/// Result of decoding a chunked body.
pub type ChunkedResult {
    complete: I64,       // 1=complete, 0=incomplete
    bytes_consumed: I64,
    body: Str,
}

impl ChunkedResult {
    pub func is_complete(this) -> I64 { this.complete }
    pub func get_body(this) -> Str { this.body }
    pub func get_bytes_consumed(this) -> I64 { this.bytes_consumed }
}

/// Decodes a chunked transfer-encoded body.
///
/// Input is the raw data after the header section (everything after \r\n\r\n).
/// Returns the decoded body, any trailer headers, and whether decoding is complete.
pub func decode_chunked(data: Str) -> ChunkedResult {
    let data_len: I64 = str::len(data)
    var pos: I64 = 0

    var buf: Buffer = Buffer::new(4096)

    loop (pos < data_len) {
        // Find end of chunk size line (\r\n)
        var line_end: I64 = pos
        loop (line_end < data_len - 1) {
            if str::char_at(data, line_end) == 13 and str::char_at(data, line_end + 1) == 10 {
                break
            }
            line_end = line_end + 1
        }
        if line_end >= data_len - 1 {
            // Incomplete chunk header
            return ChunkedResult {
                complete: 0,
                bytes_consumed: pos,
                body: buf.to_string(),
            }
        }

        // Parse chunk size (hex) — may have chunk extension after ';'
        let size_line: Str = str::substring(data, pos, line_end)
        // Strip chunk extensions (anything after ';')
        var semicolon: I64 = 0
        let size_line_len: I64 = str::len(size_line)
        loop (semicolon < size_line_len) {
            if str::char_at(size_line, semicolon) == 59 { break }  // ';'
            semicolon = semicolon + 1
        }
        let hex_str: Str = str::substring(size_line, 0, semicolon)
        // Trim whitespace from hex string
        let trimmed: Str = str::trim(hex_str)
        let chunk_size: I64 = hex_to_i64(trimmed)

        if chunk_size < 0 {
            // Invalid chunk size
            return ChunkedResult {
                complete: 0,
                bytes_consumed: pos,
                body: buf.to_string(),
            }
        }

        pos = line_end + 2  // skip \r\n after size line

        if chunk_size == 0 {
            // Final chunk — skip any trailer headers
            loop (pos < data_len - 1) {
                if str::char_at(data, pos) == 13 and str::char_at(data, pos + 1) == 10 {
                    pos = pos + 2
                    break
                }
                // Skip trailer line
                var tline_end: I64 = pos
                loop (tline_end < data_len - 1) {
                    if str::char_at(data, tline_end) == 13 and str::char_at(data, tline_end + 1) == 10 {
                        break
                    }
                    tline_end = tline_end + 1
                }
                pos = tline_end + 2
            }

            return ChunkedResult {
                complete: 1,
                bytes_consumed: pos,
                body: buf.to_string(),
            }
        }

        // Read chunk_size bytes of data
        if pos + chunk_size > data_len {
            // Not enough data yet
            return ChunkedResult {
                complete: 0,
                bytes_consumed: pos,
                body: buf.to_string(),
            }
        }

        // Copy chunk data to buffer
        buf.write_from_ptr((data as I64) + pos, chunk_size)
        pos = pos + chunk_size

        // Skip trailing \r\n after chunk data
        if pos + 1 < data_len and str::char_at(data, pos) == 13 and str::char_at(data, pos + 1) == 10 {
            pos = pos + 2
        }
    }

    // Ran out of data without final chunk
    return ChunkedResult {
        complete: 0,
        bytes_consumed: pos,
        body: buf.to_string(),
    }
}

// ============================================================================
// Socket-based Chunked Decoding
// ============================================================================

@extern("c") func tml_sys_recv(handle: I64, buf: *Unit, len: I64) -> I64

/// Maximum size for a single chunked transfer body (8 MB).
const MAX_CHUNKED_BODY: I64 = 8388608

/// Reads a chunked transfer-encoded body from a socket.
///
/// `fd` is the socket file descriptor. `initial_data` is any leftover data
/// after the \r\n\r\n header terminator that was already read from the socket.
/// `body_limit` is the maximum allowed body size (0 means use MAX_CHUNKED_BODY).
///
/// Returns the decoded body as Str, or "" if decoding fails or body exceeds limit.
///
/// This function handles the case where chunk boundaries may span multiple
/// recv() calls, accumulating raw data in a Buffer and periodically attempting
/// to decode the accumulated chunked stream.
pub func recv_chunked_body(fd: I64, initial_data: Str, body_limit: I64) -> Str {
    let limit: I64 = if body_limit > 0 { body_limit } else { MAX_CHUNKED_BODY }

    // Accumulate raw chunked data in a buffer
    var raw_buf: Buffer = Buffer::new(4096)

    // Write initial leftover data from the header read
    let initial_len: I64 = str::len(initial_data)
    if initial_len > 0 {
        raw_buf.write_from_ptr(initial_data as I64, initial_len)
    }

    // Try decoding what we have so far — the entire body may already be buffered
    let raw_str: Str = raw_buf.to_string()
    let first_try: ChunkedResult = decode_chunked(raw_str)
    if first_try.complete {
        let body_len: I64 = str::len(first_try.body)
        if body_len > limit { return "" }
        return first_try.body
    }

    // Need to read more data from the socket
    let recv_size: I64 = 8192
    let recv_buf: I64 = lowlevel { mem_alloc(recv_size) } as I64

    loop (true) {
        let n: I64 = tml_sys_recv(fd, recv_buf as *Unit, recv_size)
        if n <= 0 { break }

        raw_buf.write_from_ptr(recv_buf, n)

        // Check total accumulated size against limit
        let total_raw: I64 = raw_buf.len()
        if total_raw > limit * 2 {
            // Raw data exceeds reasonable bounds — bail out
            lowlevel { mem_free(recv_buf as *Unit) }
            return ""
        }

        // Try to decode the accumulated chunked stream
        let attempt_str: Str = raw_buf.to_string()
        let result: ChunkedResult = decode_chunked(attempt_str)
        if result.complete {
            lowlevel { mem_free(recv_buf as *Unit) }
            let body_len: I64 = str::len(result.body)
            if body_len > limit { return "" }
            return result.body
        }
    }

    // Connection closed before receiving final chunk
    lowlevel { mem_free(recv_buf as *Unit) }
    return ""
}
