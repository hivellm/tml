//! HTTP header map with case-insensitive keys.
//!
//! Wraps `HashMap[Str, Str]` with automatic key lowercasing.
//! Multi-value headers use comma-separated format per RFC 7230.

use core::str
use core::intrinsics::{ptr_read, ptr_write}
use std::collections::HashMap
use std::text::Text

/// A collection of HTTP headers with case-insensitive key lookup.
///
/// Internally backed by a `HashMap[Str, Str]`. Keys are lowercased on every
/// operation so that lookups are case-insensitive per HTTP semantics.
///
/// The handle field stores the HashMap's internal *Unit pointer directly.
/// This avoids embedding a generic type in the struct (which causes
/// cross-module monomorphization bugs). Operations construct a temporary
/// HashMap, call the method, then null out the temporary's handle via
/// lowlevel to prevent the auto-Drop from freeing the shared storage.
pub type Headers {
    handle: *Unit
}

/// Nulls out a HashMap's handle field via lowlevel ptr_write.
/// This prevents the auto-Drop from freeing the underlying storage
/// when the temporary HashMap goes out of scope.
func hdr_forget_map(map_ref: I64) {
    lowlevel { ptr_write[I64](map_ref as *I64, 0 as I64) }
}

impl Headers {
    /// Creates an empty header map.
    pub func new() -> Headers {
        let map: HashMap[Str, Str] = HashMap[Str, Str]::new(16)
        let h: *Unit = map.handle
        hdr_forget_map((ref map) as I64)
        Headers { handle: h }
    }

    /// Constructs a Headers from a raw HashMap handle pointer.
    /// Used by IncomingMessage to reconstruct Headers from I64.
    pub func from_handle(h: I64) -> Headers {
        Headers { handle: h as *Unit }
    }

    /// Returns the raw handle pointer for storing in I64 fields.
    pub func to_handle(this) -> I64 {
        this.handle as I64
    }

    /// Sets a header value, replacing any existing value for that key.
    pub func set(this, key: Str, value: Str) {
        var map: HashMap[Str, Str] = HashMap[Str, Str] { handle: this.handle }
        map.set(str::to_lowercase(key), value)
        hdr_forget_map((ref map) as I64)
    }

    /// Appends a value to a header, joining with ", " if the key already exists.
    /// Per RFC 7230 §3.2.2, multiple header values can be combined with commas.
    /// Use set() instead if you want to replace the existing value.
    pub func append(this, key: Str, value: Str) {
        let lk: Str = str::to_lowercase(key)
        let existing: Str = this.get(lk)
        if str::len(existing) > 0 {
            this.set(lk, existing + ", " + value)
        } else {
            this.set(lk, value)
        }
    }

    /// Gets the value for a header key, or "" if not present.
    pub func get(this, key: Str) -> Str {
        var map: HashMap[Str, Str] = HashMap[Str, Str] { handle: this.handle }
        let val: Str = map.get(str::to_lowercase(key))
        hdr_forget_map((ref map) as I64)
        if val as I64 == 0 {
            return ""
        }
        val
    }

    /// Returns true if the header exists.
    pub func has(this, key: Str) -> Bool {
        var map: HashMap[Str, Str] = HashMap[Str, Str] { handle: this.handle }
        let result: Bool = map.has(str::to_lowercase(key))
        hdr_forget_map((ref map) as I64)
        result
    }

    /// Removes a header by key.
    pub func remove(this, key: Str) {
        var map: HashMap[Str, Str] = HashMap[Str, Str] { handle: this.handle }
        map.remove(str::to_lowercase(key))
        hdr_forget_map((ref map) as I64)
    }

    /// Appends a value to an existing header, comma-separated per RFC 7230.
    /// If the header doesn't exist yet, behaves like set().
    pub func append(this, key: Str, value: Str) {
        let lower: Str = str::to_lowercase(key)
        var map: HashMap[Str, Str] = HashMap[Str, Str] { handle: this.handle }
        let existing: Str = map.get(lower)
        if existing as I64 == 0 {
            map.set(lower, value)
        } else {
            map.set(lower, "{existing}, {value}")
        }
        hdr_forget_map((ref map) as I64)
    }

    /// Serializes all headers to HTTP/1.1 wire format.
    /// Each header becomes "Key: Value\r\n".
    pub func serialize(this) -> Str {
        var map: HashMap[Str, Str] = HashMap[Str, Str] { handle: this.handle }
        var builder: Text = Text::new()
        var it = map.iter()
        loop (it.has_next()) {
            let k: Str = it.key()
            let v: Str = it.value()
            builder.push_str(k)
            builder.push_str(": ")
            builder.push_str(v)
            builder.push_str("\r\n")
            it.next()
        }
        it.destroy()
        hdr_forget_map((ref map) as I64)
        return builder.as_str()
    }

    // ── Convenience accessors ───────────────────────────────

    /// Returns the Content-Length as I64, or -1 if not set or invalid.
    pub func content_length(this) -> I64 {
        let val: Str = this.get("content-length")
        if str::len(val) == 0 {
            return -1 as I64
        }
        let parsed: Maybe[I64] = str::parse_i64(val)
        when parsed {
            Just(n) => return n,
            Nothing => return -1 as I64,
        }
    }

    /// Returns the Content-Type header value, or "".
    pub func content_type(this) -> Str {
        return this.get("content-type")
    }

    /// Returns the Content-Encoding header value, or "".
    pub func content_encoding(this) -> Str {
        return this.get("content-encoding")
    }

    /// Returns the Transfer-Encoding header value, or "".
    pub func transfer_encoding(this) -> Str {
        return this.get("transfer-encoding")
    }

    /// Returns true if Transfer-Encoding contains "chunked".
    pub func is_chunked(this) -> Bool {
        let te: Str = this.get("transfer-encoding")
        return str::contains(te, "chunked")
    }

    /// Returns the Host header value, or "".
    pub func host(this) -> Str {
        return this.get("host")
    }

    /// Returns the Connection header value, or "".
    pub func connection(this) -> Str {
        return this.get("connection")
    }

    /// Returns true if Connection: keep-alive.
    pub func is_keep_alive(this) -> Bool {
        let conn: Str = this.get("connection")
        return str::contains(str::to_lowercase(conn), "keep-alive")
    }

    /// Returns true if Connection: close.
    pub func is_close(this) -> Bool {
        let conn: Str = this.get("connection")
        return str::contains(str::to_lowercase(conn), "close")
    }

    /// Returns the Accept header value, or "".
    pub func accept(this) -> Str {
        return this.get("accept")
    }

    /// Returns the Accept-Encoding header value, or "".
    pub func accept_encoding(this) -> Str {
        return this.get("accept-encoding")
    }

    /// Returns the Authorization header value, or "".
    pub func authorization(this) -> Str {
        return this.get("authorization")
    }

    /// Returns the Location header value, or "".
    pub func location(this) -> Str {
        return this.get("location")
    }

    /// Returns the number of headers.
    pub func len(this) -> I64 {
        // Read len directly from HashMap header at offset 16
        lowlevel { ptr_read[I64]((this.handle as I64 + 16) as *I64) }
    }

    /// Returns true if no headers are set.
    pub func is_empty(this) -> Bool {
        return this.len() == 0
    }

    /// Frees internal storage.
    pub func destroy(this) {
        var map: HashMap[Str, Str] = HashMap[Str, Str] { handle: this.handle }
        map.destroy()
        // Drop will call destroy() again but handle is already 0 — no-op
    }
}
