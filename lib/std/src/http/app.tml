//! HTTP Application Framework — cmmv-server style API for TML.
//!
//! Features:
//!   - Radix-tree router with path params (`:id`) and wildcards (`*`)
//!   - Thread pool (N workers = CPU cores) — no thread-per-connection
//!   - Hook lifecycle: onRequest, preHandler, onSend, onResponse, onError
//!     (hooks are defined but not wired in dispatch until a codegen bug is fixed)
//!   - Handler signature: func(req: IncomingMessage) -> Str
//!     Use app_build_response(status, content_type, body) to build responses.
//!   - Read/write/idle timeouts
//!   - Graceful shutdown via app.shutdown()
//!   - Keep-alive connections
//!
//! # Example
//!
//! ```tml
//! use std::http::app::{App, app_get_param, app_build_response}
//! use std::http::incoming::IncomingMessage
//!
//! func handle_root(req: IncomingMessage) -> Str {
//!     app_build_response(200, "application/json", "{\"status\":\"ok\"}")
//! }
//!
//! func handle_user(req: IncomingMessage) -> Str {
//!     let id: Str = app_get_param(req, "id")
//!     app_build_response(200, "application/json", "{\"user_id\":\"" + id + "\"}")
//! }
//!
//! pub func main() -> I32 {
//!     var app: App = App::new()
//!     app.get("/", handle_root as I64)
//!     app.get("/users/:id", handle_user as I64)
//!     app.listen(3000)
//!     return 0
//! }
//! ```

use core::str
use core::intrinsics::{ptr_read, ptr_write, mem_alloc}
use std::http::router::{NODE_STATIC, insert, node_new}
use std::http::incoming::IncomingMessage
use std::http::server_response::ServerResponse
use std::http::dispatch::{app_get_param, app_error_response, app_build_response,
                          app_status_text, app_find_route}
use std::http::worker::{app_listen, app_listen_evloop, app_bind_listener, app_shutdown}
use std::http::iocp_worker::{app_listen_iocp}
use std::http::parse::MAX_PARAMS

// Re-exports removed — import directly from std::http::worker or std::http::parse

const MAX_HANDLERS: I64 = 256
const MAX_MIDDLEWARE: I64 = 32
const MAX_HOOKS: I64 = 16
const MAX_BODY_SIZE: I64 = 1048576

// Method index constants (needed by app_register)
const METHOD_GET: I64 = 0
const METHOD_POST: I64 = 1
const METHOD_PUT: I64 = 2
const METHOD_DELETE: I64 = 3
const METHOD_PATCH: I64 = 4
const METHOD_HEAD: I64 = 5
const METHOD_OPTIONS: I64 = 6
const METHOD_COUNT: I64 = 7
const ENTRY_SIZE: I64 = 24

func method_index(method: Str) -> I64 {
    let len: I64 = str::len(method)
    if len == 3 {
        let c: I32 = str::char_at(method, 0)
        if c == 71 { return METHOD_GET }    // 'G'
        if c == 80 { return METHOD_PUT }    // 'P' + len=3
    }
    if len == 4 {
        let c: I32 = str::char_at(method, 0)
        if c == 80 { return METHOD_POST }   // 'P' + len=4
        if c == 72 { return METHOD_HEAD }   // 'H'
    }
    if len == 5 {
        let c: I32 = str::char_at(method, 0)
        if c == 80 { return METHOD_PATCH }  // 'P'
        return -1  // TRACE not routable
    }
    if len == 6 { return METHOD_DELETE }
    if len == 7 { return METHOD_OPTIONS }
    return -1
}

// ════════════════════════════════════════════════════════════════════
// App — route registration, hooks, server config
// ════════════════════════════════════════════════════════════════════
//
// All fields are I64 to avoid mut-this field access codegen bug.
// Handler functions are stored as I64 fn pointers and cast when calling.
// Handler signature: func(req: IncomingMessage) -> Str stored as I64.
//   Use app_build_response(status, content_type, body) in handler bodies.
// Hook signature (future, pending codegen fix): func(req: IncomingMessage, res: ServerResponse)
// Error hook signature (future): func(req: IncomingMessage, res: ServerResponse, msg: Str)

pub type App {
    table: I64,             // ptr to handler table (method, path, fn_ptr entries)
    count: I64,             // number of registered routes
    trees: I64,             // ptr to array of radix tree roots (one per method)
    mw_table: I64,          // ptr to middleware fn_ptr array
    mw_count: I64,          // number of middleware
    on_request_table: I64,  // ptr to onRequest hook fn_ptr array
    on_request_count: I64,
    pre_handler_table: I64, // ptr to preHandler hook fn_ptr array
    pre_handler_count: I64,
    on_send_table: I64,     // ptr to onSend hook fn_ptr array
    on_send_count: I64,
    on_response_table: I64, // ptr to onResponse hook fn_ptr array
    on_response_count: I64,
    on_error_table: I64,    // ptr to onError hook fn_ptr array (3-param: req, res, msg)
    on_error_count: I64,
    error_handler: I64,     // custom error handler fn_ptr (3-param), 0 = default
    read_timeout: I64,
    write_timeout: I64,
    idle_timeout: I64,
    body_limit: I64,        // max body size in bytes (default 1MB)
    // Settings (I64 booleans: 0=false, 1=true)
    trust_proxy: I64,       // trust X-Forwarded-For/Proto headers (default 0)
    etag_enabled: I64,      // auto-generate ETag headers (default 0)
    x_powered_by: I64,      // add X-Powered-By: TML header (default 1)
}

impl App {
    /// Create a new App with default settings.
    pub func new() -> App {
        let table: I64 = lowlevel { mem_alloc(MAX_HANDLERS * ENTRY_SIZE) } as I64
        let mw_table: I64 = lowlevel { mem_alloc(MAX_MIDDLEWARE * 8) } as I64
        // Fixed array of METHOD_COUNT radix tree roots, all initialized to 0
        let trees: I64 = lowlevel { mem_alloc(METHOD_COUNT * 8) } as I64
        var t: I64 = 0
        loop (t < METHOD_COUNT) {
            lowlevel { ptr_write[I64]((trees + t * 8) as *I64, 0 as I64) }
            t = t + 1
        }
        let on_request_table: I64 = lowlevel { mem_alloc(MAX_HOOKS * 8) } as I64
        let pre_handler_table: I64 = lowlevel { mem_alloc(MAX_HOOKS * 8) } as I64
        let on_send_table: I64 = lowlevel { mem_alloc(MAX_HOOKS * 8) } as I64
        let on_response_table: I64 = lowlevel { mem_alloc(MAX_HOOKS * 8) } as I64
        let on_error_table: I64 = lowlevel { mem_alloc(MAX_HOOKS * 8) } as I64
        return App {
            table: table,
            count: 0,
            trees: trees,
            mw_table: mw_table,
            mw_count: 0,
            on_request_table: on_request_table,
            on_request_count: 0,
            pre_handler_table: pre_handler_table,
            pre_handler_count: 0,
            on_send_table: on_send_table,
            on_send_count: 0,
            on_response_table: on_response_table,
            on_response_count: 0,
            on_error_table: on_error_table,
            on_error_count: 0,
            error_handler: 0,
            read_timeout: 30000,
            write_timeout: 30000,
            idle_timeout: 60000,
            body_limit: MAX_BODY_SIZE,
            trust_proxy: 0,
            etag_enabled: 0,
            x_powered_by: 1,
        }
    }

    // ── Route Registration ────────────────────────────────────────
    // Handlers stored as I64 fn pointers. Call via:
    //   let h: func(IncomingMessage) -> Str = fn_ptr as func(IncomingMessage) -> Str
    //   let response: Str = h(req)

    /// Register a GET handler. Pass function as I64: `handle_root as I64`
    pub func get(mut this, path: Str, handler: I64) {
        app_register(this.table, ref this.count, this.trees, "GET", path, handler)
    }

    /// Register a POST handler.
    pub func post(mut this, path: Str, handler: I64) {
        app_register(this.table, ref this.count, this.trees, "POST", path, handler)
    }

    /// Register a PUT handler.
    pub func put(mut this, path: Str, handler: I64) {
        app_register(this.table, ref this.count, this.trees, "PUT", path, handler)
    }

    /// Register a DELETE handler.
    pub func delete(mut this, path: Str, handler: I64) {
        app_register(this.table, ref this.count, this.trees, "DELETE", path, handler)
    }

    /// Register a PATCH handler.
    pub func patch(mut this, path: Str, handler: I64) {
        app_register(this.table, ref this.count, this.trees, "PATCH", path, handler)
    }

    /// Register a HEAD handler.
    pub func head(mut this, path: Str, handler: I64) {
        app_register(this.table, ref this.count, this.trees, "HEAD", path, handler)
    }

    /// Register an OPTIONS handler.
    pub func options(mut this, path: Str, handler: I64) {
        app_register(this.table, ref this.count, this.trees, "OPTIONS", path, handler)
    }

    /// Register a handler for all HTTP methods (GET, POST, PUT, DELETE, PATCH).
    pub func all(mut this, path: Str, handler: I64) {
        app_register(this.table, ref this.count, this.trees, "GET", path, handler)
        app_register(this.table, ref this.count, this.trees, "POST", path, handler)
        app_register(this.table, ref this.count, this.trees, "PUT", path, handler)
        app_register(this.table, ref this.count, this.trees, "DELETE", path, handler)
        app_register(this.table, ref this.count, this.trees, "PATCH", path, handler)
    }

    // ── Middleware ────────────────────────────────────────────────

    /// Register a middleware function (same signature as handler: I64 fn ptr).
    /// Return without calling res.end() to continue to next middleware/handler.
    /// Call res.end() to short-circuit the pipeline.
    pub func use_middleware(mut this, mw: I64) {
        if this.mw_count >= MAX_MIDDLEWARE { return }
        lowlevel { ptr_write[I64]((this.mw_table + this.mw_count * 8) as *I64, mw) }
        this.mw_count = this.mw_count + 1
    }

    // ── Hook System ───────────────────────────────────────────────
    // Hooks follow cmmv-server lifecycle:
    //   onRequest    → first hook, runs before routing (can short-circuit)
    //   preHandler   → runs after routing but before handler
    //   onSend       → runs after handler, before sending (can modify response)
    //   onResponse   → runs after response is sent (logging, metrics)
    //   onError      → runs when an error occurs (3-param signature)

    /// Add an onRequest hook. Called for every request before routing.
    /// Signature: func(req: IncomingMessage, res: ServerResponse) stored as I64.
    pub func add_hook_on_request(mut this, hook: I64) {
        if this.on_request_count >= MAX_HOOKS { return }
        lowlevel { ptr_write[I64]((this.on_request_table + this.on_request_count * 8) as *I64, hook) }
        this.on_request_count = this.on_request_count + 1
    }

    /// Add a preHandler hook. Called after routing but before the route handler.
    /// Signature: func(req: IncomingMessage, res: ServerResponse) stored as I64.
    pub func add_hook_pre_handler(mut this, hook: I64) {
        if this.pre_handler_count >= MAX_HOOKS { return }
        lowlevel { ptr_write[I64]((this.pre_handler_table + this.pre_handler_count * 8) as *I64, hook) }
        this.pre_handler_count = this.pre_handler_count + 1
    }

    /// Add an onSend hook. Called after the handler writes the response, before sending.
    /// Signature: func(req: IncomingMessage, res: ServerResponse) stored as I64.
    pub func add_hook_on_send(mut this, hook: I64) {
        if this.on_send_count >= MAX_HOOKS { return }
        lowlevel { ptr_write[I64]((this.on_send_table + this.on_send_count * 8) as *I64, hook) }
        this.on_send_count = this.on_send_count + 1
    }

    /// Add an onResponse hook. Called after the response is sent (logging, metrics).
    /// Signature: func(req: IncomingMessage, res: ServerResponse) stored as I64.
    pub func add_hook_on_response(mut this, hook: I64) {
        if this.on_response_count >= MAX_HOOKS { return }
        lowlevel { ptr_write[I64]((this.on_response_table + this.on_response_count * 8) as *I64, hook) }
        this.on_response_count = this.on_response_count + 1
    }

    /// Add an onError hook. Called when an unhandled error occurs.
    /// Signature: func(req: IncomingMessage, res: ServerResponse, msg: Str) stored as I64.
    pub func add_hook_on_error(mut this, hook: I64) {
        if this.on_error_count >= MAX_HOOKS { return }
        lowlevel { ptr_write[I64]((this.on_error_table + this.on_error_count * 8) as *I64, hook) }
        this.on_error_count = this.on_error_count + 1
    }

    /// Set a custom error handler replacing the default 500 response.
    /// Signature: func(req: IncomingMessage, res: ServerResponse, msg: Str) stored as I64.
    pub func set_error_handler(mut this, handler: I64) {
        this.error_handler = handler
    }

    // ── Settings ──────────────────────────────────────────────────

    /// Set read timeout in milliseconds (default: 30000).
    pub func set_read_timeout(mut this, ms: I64) { this.read_timeout = ms }

    /// Set write timeout in milliseconds (default: 30000).
    pub func set_write_timeout(mut this, ms: I64) { this.write_timeout = ms }

    /// Set idle timeout in milliseconds (default: 60000).
    pub func set_idle_timeout(mut this, ms: I64) { this.idle_timeout = ms }

    /// Set maximum body size in bytes (default: 1048576 = 1MB).
    pub func set_body_limit(mut this, bytes: I64) { this.body_limit = bytes }

    /// Enable/disable trust proxy (uses X-Forwarded-For/Proto headers). Default: false.
    pub func set_trust_proxy(mut this, enabled: Bool) {
        if enabled { this.trust_proxy = 1 } else { this.trust_proxy = 0 }
    }

    /// Enable/disable automatic ETag header generation. Default: false.
    pub func set_etag(mut this, enabled: Bool) {
        if enabled { this.etag_enabled = 1 } else { this.etag_enabled = 0 }
    }

    /// Enable/disable X-Powered-By: TML header. Default: true.
    pub func set_x_powered_by(mut this, enabled: Bool) {
        if enabled { this.x_powered_by = 1 } else { this.x_powered_by = 0 }
    }

    // ── Listen ────────────────────────────────────────────────────

    /// Start server with thread pool (highest throughput, default).
    pub func listen(this, port: I64) {
        app_listen(
            this.table, this.count, this.trees,
            this.mw_table, this.mw_count,
            this.on_request_table, this.on_request_count,
            this.pre_handler_table, this.pre_handler_count,
            this.on_send_table, this.on_send_count,
            this.on_response_table, this.on_response_count,
            this.on_error_table, this.on_error_count,
            this.error_handler,
            this.read_timeout, this.write_timeout, this.idle_timeout,
            this.body_limit, port
        )
    }

    /// Start server with non-blocking event loop (more concurrent connections).
    /// Uses std::net::eventloop internally — WSAPoll on Windows, epoll on Linux.
    pub func listen_async(this, port: I64) {
        app_listen_evloop(
            this.table, this.count, this.trees,
            this.mw_table, this.mw_count,
            this.on_request_table, this.on_request_count,
            this.pre_handler_table, this.pre_handler_count,
            this.on_send_table, this.on_send_count,
            this.on_response_table, this.on_response_count,
            this.on_error_table, this.on_error_count,
            this.error_handler,
            this.read_timeout, this.write_timeout, this.idle_timeout,
            this.body_limit, port
        )
    }

    /// Start server with IOCP (Windows, highest throughput).
    /// Uses Windows I/O Completion Ports for truly async accept/recv/send.
    /// This is the fastest option on Windows — zero blocking syscalls in the hot path.
    pub func listen_iocp(this, port: I64) {
        app_listen_iocp(
            this.table, this.count, this.trees,
            this.mw_table, this.mw_count,
            this.on_request_table, this.on_request_count,
            this.pre_handler_table, this.pre_handler_count,
            this.on_send_table, this.on_send_count,
            this.on_response_table, this.on_response_count,
            this.on_error_table, this.on_error_count,
            this.error_handler,
            this.read_timeout, this.write_timeout, this.idle_timeout,
            this.body_limit, port
        )
    }
}

// ════════════════════════════════════════════════════════════════════
// Route registration
// ════════════════════════════════════════════════════════════════════

/// Register a handler in the flat table and radix tree.
/// handler is an I64 fn pointer (cast from func(IncomingMessage) -> Str).
pub func app_register(table: I64, count: mut ref I64, trees: I64, method: Str, path: Str, handler: I64) {
    if count >= MAX_HANDLERS { return }
    let handler_id: I64 = count + 1
    let offset: I64 = count * ENTRY_SIZE
    // Handler table: flat array for O(1) lookup by handler_id (1-indexed)
    lowlevel { ptr_write[I64]((table + offset) as *I64, method as I64) }
    lowlevel { ptr_write[I64]((table + offset + 8) as *I64, path as I64) }
    lowlevel { ptr_write[I64]((table + offset + 16) as *I64, handler) }
    // Insert into radix-tree for O(log n) path matching with params/wildcards
    let idx: I64 = method_index(method)
    if idx >= 0 {
        var root: I64 = lowlevel { ptr_read[I64]((trees + idx * 8) as *I64) }
        if root == 0 {
            root = node_new("/", NODE_STATIC)
            lowlevel { ptr_write[I64]((trees + idx * 8) as *I64, root) }
        }
        insert(root, path, handler_id)
    }
    count = count + 1
}

// ════════════════════════════════════════════════════════════════════
// Decorator-based route registration
// ════════════════════════════════════════════════════════════════════
//
// When functions are decorated with @Get("/path"), @Post("/path"), etc.,
// the TML compiler generates a `__tml_register_routes(table, count, trees)`
// function that calls app_register for each decorated handler.
//
// Usage in user code:
//
//     use std::http::app::{App, app_register}
//     use std::http::incoming::IncomingMessage
//     use std::http::dispatch::app_build_response
//
//     // Declare the compiler-generated function
//     @extern("c")
//     func __tml_register_routes(table: I64, count: mut ref I64, trees: I64)
//
//     @Get("/hello")
//     func hello(req: IncomingMessage) -> Str {
//         app_build_response(200, "text/plain", "Hello!")
//     }
//
//     @Post("/users")
//     func create_user(req: IncomingMessage) -> Str {
//         app_build_response(201, "application/json", "{\"id\":1}")
//     }
//
//     pub func main() -> I32 {
//         var app: App = App::new()
//         __tml_register_routes(app.table, ref app.count, app.trees)
//         app.listen(3000)
//         return 0
//     }
