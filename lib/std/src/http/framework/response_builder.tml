//! Response Builder — Express/CMMV-style fluent HTTP response.
//!
//! ```tml
//! use std::http::framework::response_builder::Response
//!
//! func handle(req: IncomingMessage, res: Response) -> Str {
//!     return res.json("{\"ok\":true}")
//! }
//! func handle_err(req: IncomingMessage, res: Response) -> Str {
//!     return res.status(404).json("{\"error\":\"not found\"}")
//! }
//! ```

use core::str
use std::http::middleware::cors::{CorsOptions, cors_headers}
use std::http::middleware::security::{SecurityOptions, security_headers}
use std::http::middleware::etag
use std::http::middleware::cache_control::{CacheOptions, cache_control_header}

/// HTTP Response builder — auto-resolves headers.
/// Created by the dispatcher for each request.
pub type Response {
    code: I32,
    content_type: Str,
    body: Str,
    custom_headers: Str,
    use_cors: Bool,
    use_security: Bool,
    use_etag: Bool,
    cache_mode: I32
}

impl Response {
    /// Creates a response with the given status code.
    pub func status(code: I32) -> Response {
        return Response { code: code, content_type: "application/json; charset=utf-8", body: "", custom_headers: "", use_cors: true, use_security: true, use_etag: true, cache_mode: 0 }
    }

    /// Creates a response with status 200 and the socket fd.
    pub func for_request(fd: I64) -> Response {
        return Response::status(200)
    }

    /// Set status code (chainable).
    pub func set_status(this, code: I32) -> Response {
        return Response { code: code, content_type: this.content_type, body: this.body, custom_headers: this.custom_headers, use_cors: this.use_cors, use_security: this.use_security, use_etag: this.use_etag, cache_mode: this.cache_mode }
    }

    /// Set JSON body and return the complete HTTP response string.
    pub func json(this, data: Str) -> Str {
        return build_http_response(this.code, "application/json; charset=utf-8", data, this.custom_headers, this.use_cors, this.use_security, this.use_etag, this.cache_mode)
    }

    /// Set HTML body and return the complete HTTP response string.
    pub func html(this, data: Str) -> Str {
        return build_http_response(this.code, "text/html; charset=utf-8", data, this.custom_headers, this.use_cors, this.use_security, this.use_etag, this.cache_mode)
    }

    /// Set plain text body and return the complete HTTP response string.
    pub func text(this, data: Str) -> Str {
        return build_http_response(this.code, "text/plain; charset=utf-8", data, this.custom_headers, this.use_cors, this.use_security, this.use_etag, this.cache_mode)
    }

    /// Add a custom header (chainable).
    pub func header(this, name: Str, value: Str) -> Response {
        return Response { code: this.code, content_type: this.content_type, body: this.body, custom_headers: this.custom_headers + name + ": " + value + "\r\n", use_cors: this.use_cors, use_security: this.use_security, use_etag: this.use_etag, cache_mode: this.cache_mode }
    }

    /// Disable CORS headers (chainable).
    pub func no_cors(this) -> Response {
        return Response { code: this.code, content_type: this.content_type, body: this.body, custom_headers: this.custom_headers, use_cors: false, use_security: this.use_security, use_etag: this.use_etag, cache_mode: this.cache_mode }
    }
}

/// Builds the complete HTTP/1.1 response string with auto-resolved headers.
/// This is a free function to avoid cross-module method resolution issues.
func build_http_response(code: I32, content_type: Str, body: Str, custom_headers: Str, cors: Bool, security: Bool, use_etag: Bool, cache_mode: I32) -> Str {
    let body_len: I64 = str::len(body)
    var resp: Str = "HTTP/1.1 " + response_status_line(code) + "\r\n"

    resp = resp + "Content-Type: " + content_type + "\r\n"
    resp = resp + "Content-Length: " + body_len.to_string() + "\r\n"

    // CORS headers via middleware module
    if cors {
        var cors_opts: CorsOptions = CorsOptions::new()
        resp = resp + cors_headers(ref cors_opts, "")
    }

    // Security headers via middleware module
    if security {
        var sec_opts: SecurityOptions = SecurityOptions::minimal()
        resp = resp + security_headers(ref sec_opts)
    }

    // ETag header via middleware module
    if use_etag and body_len > 0 {
        let tag: Str = etag::generate(body)
        resp = resp + "ETag: " + tag + "\r\n"
    }

    // Cache-Control via middleware module based on cache_mode
    if cache_mode == 0 {
        // Default: no-store for dynamic content
        var cache_opts: CacheOptions = CacheOptions::no_store()
        let cc_value: Str = cache_control_header(ref cache_opts)
        resp = resp + "Cache-Control: " + cc_value + "\r\n"
    } else if cache_mode == 1 {
        // Short-lived cache (5 minutes)
        var cache_opts: CacheOptions = CacheOptions::short()
        let cc_value: Str = cache_control_header(ref cache_opts)
        resp = resp + "Cache-Control: " + cc_value + "\r\n"
    } else if cache_mode == 2 {
        // Immutable static asset (1 year)
        var cache_opts: CacheOptions = CacheOptions::immutable_asset()
        let cc_value: Str = cache_control_header(ref cache_opts)
        resp = resp + "Cache-Control: " + cc_value + "\r\n"
    }

    // Custom headers
    if custom_headers != "" {
        resp = resp + custom_headers
    }

    resp = resp + "Connection: keep-alive\r\n"
    resp = resp + "\r\n" + body
    return resp
}

/// Maps status code to reason phrase.
func response_status_line(code: I32) -> Str {
    if code == 200 { return "200 OK" }
    if code == 201 { return "201 Created" }
    if code == 204 { return "204 No Content" }
    if code == 400 { return "400 Bad Request" }
    if code == 401 { return "401 Unauthorized" }
    if code == 403 { return "403 Forbidden" }
    if code == 404 { return "404 Not Found" }
    if code == 500 { return "500 Internal Server Error" }
    return "200 OK"
}
