//! Socket address types.
//!
//! This module re-exports the core socket address types. The actual implementations
//! live in `core::net::socket` since they are pure data types with no OS dependencies.
//!
//! # Types
//!
//! - [`SocketAddrV4`] - IPv4 socket address (IP + port)
//! - [`SocketAddrV6`] - IPv6 socket address (IP + port + flow info + scope ID)
//! - [`SocketAddr`] - Socket address wrapper

pub use core::net::socket::*
