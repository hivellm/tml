//! IP address types.
//!
//! This module re-exports the core IP address types. The actual implementations
//! live in `core::net::ip` since they are pure data types with no OS dependencies.
//!
//! # Types
//!
//! - [`Ipv4Addr`] - A 32-bit IPv4 address stored as 4 octets
//! - [`Ipv6Addr`] - A 128-bit IPv6 address stored as 8 segments
//! - [`IpAddr`] - An enum that holds either an IPv4 or IPv6 address

pub use core::net::ip::*
