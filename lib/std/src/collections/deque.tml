//! Double-ended queue.
//!
//! A ring buffer backed [`Deque[T]`] supporting efficient insertion and
//! removal at both ends.
//!
//! # Example
//!
//! ```tml
//! use std::collections::Deque
//!
//! var dq: Deque[I64] = Deque::create[I64]()
//! dq.push_back(1)
//! dq.push_front(0)
//! print(dq.pop_front().unwrap().to_string())  // 0
//! ```

use std::collections::List

/// A double-ended queue backed by a ring buffer.
///
/// `Deque[T]` provides O(1) amortised insertion and removal at both
/// the front and the back. Random access via [`get`] is O(1).
pub type Deque[T] {
    data: List[T],
    head: I64,
    length: I64,
    capacity: I64,
    initialized: Bool
}

impl[T] Deque[T] {
    /// Creates a new empty Deque with the default capacity (16).
    pub func create() -> Deque[T] {
        let initial_capacity: I64 = 16
        let list: List[T] = List[T].new(initial_capacity)
        return Deque {
            data: list,
            head: 0,
            length: 0,
            capacity: initial_capacity,
            initialized: false,
        }
    }

    /// Creates a Deque with the specified initial capacity.
    pub func with_capacity(cap: I64) -> Deque[T] {
        let list: List[T] = List[T].new(cap)
        return Deque {
            data: list,
            head: 0,
            length: 0,
            capacity: cap,
            initialized: false,
        }
    }

    /// Returns the number of elements.
    pub func count(this) -> I64 {
        return this.length
    }

    /// Returns true if the deque has no elements.
    pub func is_empty(this) -> Bool {
        return this.length == 0
    }

    /// Removes all elements.
    pub func clear(mut this) {
        this.data.clear()
        this.head = 0
        this.length = 0
        this.initialized = false
    }

    /// Destroys the deque and frees all associated memory.
    pub func destroy(mut this) {
        this.data.destroy()
    }

    /// Pre-fills the backing list so set() works at any index.
    func fill_backing(mut this, value: T) {
        var i: I64 = 0
        loop (i < this.capacity) {
            this.data.push(value)
            i = i + 1
        }
        this.initialized = true
    }

    /// Adds an element to the back of the deque.
    pub func push_back(mut this, item: T) {
        if not this.initialized {
            this.fill_backing(item)
        }
        if this.length >= this.capacity {
            this.grow()
        }
        let idx: I64 = (this.head + this.length) % this.capacity
        this.data.set(idx, item)
        this.length = this.length + 1
    }

    /// Adds an element to the front of the deque.
    pub func push_front(mut this, item: T) {
        if not this.initialized {
            this.fill_backing(item)
        }
        if this.length >= this.capacity {
            this.grow()
        }
        this.head = (this.head - 1 + this.capacity) % this.capacity
        this.data.set(this.head, item)
        this.length = this.length + 1
    }

    /// Removes and returns the element at the front.
    pub func pop_front(mut this) -> Maybe[T] {
        if this.length == 0 {
            return Nothing
        }
        let item: T = this.data.get(this.head)
        this.head = (this.head + 1) % this.capacity
        this.length = this.length - 1
        if this.length == 0 {
            this.head = 0
        }
        return Just(item)
    }

    /// Removes and returns the element at the back.
    pub func pop_back(mut this) -> Maybe[T] {
        if this.length == 0 {
            return Nothing
        }
        let tail_idx: I64 = (this.head + this.length - 1) % this.capacity
        let item: T = this.data.get(tail_idx)
        this.length = this.length - 1
        if this.length == 0 {
            this.head = 0
        }
        return Just(item)
    }

    /// Returns the front element without removing it.
    pub func front(this) -> Maybe[T] {
        if this.length == 0 {
            return Nothing
        }
        return Just(this.data.get(this.head))
    }

    /// Returns the back element without removing it.
    pub func back(this) -> Maybe[T] {
        if this.length == 0 {
            return Nothing
        }
        let tail_idx: I64 = (this.head + this.length - 1) % this.capacity
        return Just(this.data.get(tail_idx))
    }

    /// Returns the element at the given index (0 = front).
    pub func get(this, index: I64) -> T {
        if index < 0 or index >= this.length {
            panic("Deque::get index out of bounds")
        }
        let actual: I64 = (this.head + index) % this.capacity
        return this.data.get(actual)
    }

    /// Returns a zero-copy borrow of the element at `index` (0 = front).
    ///
    /// Unlike `get` (which clone-reads), this forwards a borrow into the
    /// ring buffer at the physical slot (a pure GEP) — no refcount bump, no
    /// drop-glue. Panics if `index` is out of bounds.
    ///
    /// # Invalidation
    ///
    /// The reference is valid ONLY until the next mutating operation on the
    /// deque (`push_*` / `pop_*` / `clear` / `grow`). Compile-time
    /// enforcement lands in a later cluster.
    pub func get_ref(this, index: I64) -> ref T {
        if index < 0 or index >= this.length {
            panic("Deque::get_ref index out of bounds")
        }
        let actual: I64 = (this.head + index) % this.capacity
        return this.data.get_ref(actual)
    }

    /// Returns a zero-copy mutable borrow of the element at `index`.
    ///
    /// Writes through the borrow are visible on subsequent reads. No clone,
    /// no drop-glue. Panics if `index` is out of bounds.
    ///
    /// # Invalidation
    ///
    /// Same rule as `get_ref`: valid only until the next mutating operation.
    pub func get_mut(mut this, index: I64) -> mut ref T {
        if index < 0 or index >= this.length {
            panic("Deque::get_mut index out of bounds")
        }
        let actual: I64 = (this.head + index) % this.capacity
        return this.data.get_mut(actual)
    }

    /// Grows the capacity by copying elements into a fresh buffer.
    pub func grow(mut this) {
        let new_capacity: I64 = this.capacity * 2
        var new_data: List[T] = List[T].new(new_capacity)

        // Pre-fill new backing list
        let first: T = this.data.get(this.head)
        var fill_i: I64 = 0
        loop (fill_i < new_capacity) {
            new_data.push(first)
            fill_i = fill_i + 1
        }

        // Copy elements in order to positions 0..length
        var i: I64 = 0
        loop (i < this.length) {
            let idx: I64 = (this.head + i) % this.capacity
            new_data.set(i, this.data.get(idx))
            i = i + 1
        }

        this.data.destroy()
        this.data = new_data
        this.head = 0
        this.capacity = new_capacity
    }
}

/// Methods that require element equality comparison.
impl[T: PartialEq] Deque[T] {
    /// Returns true if the deque contains the element.
    pub func contains(this, item: T) -> Bool {
        var i: I64 = 0
        loop (i < this.length) {
            let idx: I64 = (this.head + i) % this.capacity
            if this.data.get(idx) == item {
                return true
            }
            i = i + 1
        }
        return false
    }
}

impl[T] Drop for Deque[T] {
    func drop(mut this) {
        this.destroy()
    }
}

// ─── DequeIter ──────────────────────────────────────────────────────────────

/// Forward iterator over a snapshot of a [`Deque[T]`].
///
/// Created by [`Deque::iter`]. Iterates elements from front to back.
///
/// The iterator owns a fresh, logically-ordered `snapshot` of the deque's
/// elements (mirroring `HeapIter`/`BTreeMapIter`), NOT an alias of the deque's
/// backing buffer. A `List[T]` is move-only (it has `Drop` but no `Duplicate`),
/// so a bitwise `data: this.data` copy would share the deque's buffer and its
/// drop-glue would double-free it once the deque is later dropped or destroyed.
/// Copying into an owned snapshot keeps the iterator's drop balanced.
pub type DequeIter[T] {
    snapshot: List[T],
    length: I64,
    index: I64,
}

impl[T] DequeIter[T] {
    /// Returns the next element, or Nothing when exhausted.
    pub func next(mut this) -> Maybe[T] {
        if this.index >= this.length {
            return Nothing
        }
        let val: T = this.snapshot.get(this.index)
        this.index = this.index + 1
        return Just(val)
    }
}

// ─── Additional Deque[T] methods ────────────────────────────────────────────

impl[T] Deque[T] {
    /// Returns the number of elements. Alias for `count()`.
    pub func len(this) -> I64 {
        return this.length
    }

    /// Inserts `value` at logical position `index` (0 = front), shifting elements after it back.
    ///
    /// Panics if `index > length`.
    pub func insert(mut this, index: I64, value: T) {
        if index < 0 or index > this.length {
            panic("Deque::insert index out of bounds")
        }
        // Push to back first (ensures capacity and initialization)
        this.push_back(value)
        // Shift the newly added element from the back to position `index`
        var i: I64 = this.length - 1
        loop (i > index) {
            let prev: I64 = i - 1
            let cur_idx: I64 = (this.head + i) % this.capacity
            let prev_idx: I64 = (this.head + prev) % this.capacity
            let tmp: T = this.data.get(prev_idx)
            this.data.set(cur_idx, tmp)
            i = i - 1
        }
        let target_idx: I64 = (this.head + index) % this.capacity
        this.data.set(target_idx, value)
    }

    /// Removes and returns the element at logical position `index`, shifting elements after it forward.
    ///
    /// Returns `Nothing` if `index` is out of bounds.
    pub func remove(mut this, index: I64) -> Maybe[T] {
        if index < 0 or index >= this.length {
            return Nothing
        }
        let actual: I64 = (this.head + index) % this.capacity
        let removed: T = this.data.get(actual)
        // Shift elements from index+1 forward to fill the gap
        var i: I64 = index
        loop (i < this.length - 1) {
            let cur_idx: I64 = (this.head + i) % this.capacity
            let next_idx: I64 = (this.head + i + 1) % this.capacity
            this.data.set(cur_idx, this.data.get(next_idx))
            i = i + 1
        }
        this.length = this.length - 1
        if this.length == 0 {
            this.head = 0
        }
        return Just(removed)
    }

    /// Returns a forward iterator over the elements (front to back).
    ///
    /// Non-consuming: builds an owned, logically-ordered snapshot of the
    /// current elements so the iterator's lifetime is independent of the deque.
    pub func iter(this) -> DequeIter[T] {
        var snapshot: List[T] = List[T].new(this.length)
        for i in 0 to this.length {
            let actual: I64 = (this.head + i) % this.capacity
            snapshot.push(this.data.get(actual))
        }
        return DequeIter {
            snapshot: snapshot,
            length: this.length,
            index: 0,
        }
    }

    /// Retains only elements for which `pred` returns true, removing the rest.
    pub func retain(mut this, pred: func(ref T) -> Bool) {
        var write: I64 = 0
        var read: I64 = 0
        loop (read < this.length) {
            let read_idx: I64 = (this.head + read) % this.capacity
            let val: T = this.data.get(read_idx)
            if pred(ref val) {
                if write != read {
                    let write_idx: I64 = (this.head + write) % this.capacity
                    this.data.set(write_idx, val)
                }
                write = write + 1
            }
            read = read + 1
        }
        this.length = write
        if this.length == 0 {
            this.head = 0
        }
    }

    /// Removes all elements and returns them in a `List[T]` (front to back order).
    pub func drain(mut this) -> List[T] {
        var result: List[T] = List[T].new(this.length)
        var i: I64 = 0
        loop (i < this.length) {
            let idx: I64 = (this.head + i) % this.capacity
            result.push(this.data.get(idx))
            i = i + 1
        }
        this.length = 0
        this.head = 0
        return result
    }

    /// Rotates the deque left by `n` positions.
    ///
    /// Elements shifted off the front are appended to the back.
    /// Equivalent to calling `pop_front` + `push_back` n times, but O(1) for the head pointer.
    pub func rotate_left(mut this, n: I64) {
        if this.length == 0 {
            return
        }
        let steps: I64 = n % this.length
        if steps == 0 {
            return
        }
        // The live elements occupy slots [head, head + length) mod capacity.
        // Advancing `head` alone slides that window onto `steps` slots that hold
        // no element, so the tail read back as uninitialised memory and the
        // first `steps` elements were lost. That is only harmless in the special
        // case capacity == length, where the window wraps exactly onto itself.
        // Move the elements instead (phase44b).
        var moved: I64 = 0
        loop (moved < steps) {
            let Just(front) = this.pop_front() else { break }
            this.push_back(front)
            moved = moved + 1
        }
    }

    /// Rotates the deque right by `n` positions.
    ///
    /// Elements shifted off the back are prepended to the front.
    pub func rotate_right(mut this, n: I64) {
        if this.length == 0 {
            return
        }
        let steps: I64 = n % this.length
        if steps == 0 {
            return
        }
        // Same defect as rotate_left: moving `head` backwards slides the live
        // window onto slots that hold no element whenever capacity > length.
        var moved: I64 = 0
        loop (moved < steps) {
            let Just(back) = this.pop_back() else { break }
            this.push_front(back)
            moved = moved + 1
        }
    }
}

/// Binary search methods for sorted Deque.
impl[T: Ord] Deque[T] {
    /// Searches a sorted deque for `value`.
    ///
    /// Returns `Ok(index)` if found, or `Err(insert_index)` giving the position
    /// where `value` could be inserted to maintain sort order.
    pub func binary_search(this, value: T) -> Outcome[I64, I64] {
        var lo: I64 = 0
        var hi: I64 = this.length
        var found: Bool = false
        var result_ok: I64 = 0
        var result_err: I64 = 0
        loop (lo < hi and not found) {
            let mid: I64 = lo + (hi - lo) / 2
            let mid_idx: I64 = (this.head + mid) % this.capacity
            let mid_val: T = this.data.get(mid_idx)
            if mid_val == value {
                found = true
                result_ok = mid
            } else {
                if mid_val < value {
                    lo = mid + 1
                } else {
                    hi = mid
                }
                result_err = lo
            }
        }
        if found {
            return Ok(result_ok)
        }
        return Err(lo)
    }
}
