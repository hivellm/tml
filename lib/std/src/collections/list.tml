//! Dynamic array collection type — pure TML implementation.
//!
//! `List[T]` is a generic collection that stores elements of type `T`
//! contiguously in memory and grows as needed.
//!
//! Elements are stored at their natural size using `size_of[T]()`.
//! This correctly handles scalar types (I32, I64, Str) as well as
//! multi-field struct types (LinkedListNode, Bm25Result, etc.).
//!
//! # Example
//!
//! ```tml
//! let nums = List[I32]::new(8)
//! nums.push(10)
//! nums.push(20)
//! let first = nums.get(0)  // 10
//! nums.destroy()
//! ```

use core::runtime::intrinsics::{ptr_read, ptr_write, mem_free}
use core::runtime::mem::size_of

/// A dynamic array that grows automatically.
///
/// `List[T]` stores elements contiguously in a heap-allocated buffer.
/// Each element occupies `size_of[T]()` bytes.
///
/// # Type Parameters
///
/// * `T` - The type of elements stored in the list
pub type List[T] {
    handle: *Unit
}

// Internal layout of the list header (stored at handle):
//   offset 0:  data pointer (*Unit) — 8 bytes
//   offset 8:  len (I64) — 8 bytes
//   offset 16: capacity (I64) — 8 bytes
//   offset 24: stride (I64) — 8 bytes  (cached size_of[T])
// Total header: 32 bytes

impl[T] List[T] {
    /// Creates a new list with the specified initial capacity.
    /// Call with `List[T]::new(8)` for specific capacity or `List[T]::new(0)` for default.
    pub func new(initial_capacity: I64) -> List[T] {
        // Ensure minimum capacity of 4
        var cap: I64 = initial_capacity
        if cap < 4 {
            cap = 4
        }

        // Get element size
        let stride: I64 = lowlevel { sizeof_type[T]() }
        // Minimum stride of 8 for scalar types stored as I64
        var elem_size: I64 = stride
        if elem_size < 8 {
            elem_size = 8
        }

        // Allocate header (32 bytes: ptr + len + capacity + stride)
        let header: *Unit = lowlevel { mem_alloc(32) }
        let hdr: I64 = header as I64

        // Allocate data buffer (cap * elem_size bytes)
        let data_size: I64 = cap * elem_size
        let data: *Unit = lowlevel { mem_alloc(data_size) }

        // Store data pointer at offset 0
        let p_data: *I64 = hdr as *I64
        lowlevel { ptr_write[I64](p_data, data as I64) }

        // Store len (0) at offset 8
        let p_len: *I64 = (hdr + 8) as *I64
        lowlevel { ptr_write[I64](p_len, 0 as I64) }

        // Store capacity at offset 16
        let p_cap: *I64 = (hdr + 16) as *I64
        lowlevel { ptr_write[I64](p_cap, cap) }

        // Store stride at offset 24
        let p_stride: *I64 = (hdr + 24) as *I64
        lowlevel { ptr_write[I64](p_stride, elem_size) }

        List[T] { handle: header }
    }

    /// Creates a new list with default capacity (8).
    pub func default() -> List[T] {
        List[T].new(8)
    }

    /// Appends an element to the back of the list.
    @inline
    pub func push(this, value: T) {
        let hdr: I64 = this.handle as I64

        // Read current len, capacity and stride
        let p_len: *I64 = (hdr + 8) as *I64
        let p_cap: *I64 = (hdr + 16) as *I64
        let p_stride: *I64 = (hdr + 24) as *I64
        let cur_len: I64 = lowlevel { ptr_read[I64](p_len) }
        let cur_cap: I64 = lowlevel { ptr_read[I64](p_cap) }
        let stride: I64 = lowlevel { ptr_read[I64](p_stride) }

        // Grow if needed
        if cur_len >= cur_cap {
            let new_cap: I64 = cur_cap * 2
            let new_size: I64 = new_cap * stride

            // Read current data pointer
            let p_data: *I64 = hdr as *I64
            let old_data_addr: I64 = lowlevel { ptr_read[I64](p_data) }
            let old_data: *Unit = old_data_addr as *Unit

            // Reallocate
            let new_data: *Unit = lowlevel { mem_realloc(old_data, new_size) }

            // Update header
            lowlevel { ptr_write[I64](p_data, new_data as I64) }
            lowlevel { ptr_write[I64](p_cap, new_cap) }
        }

        // Read (possibly updated) data pointer
        let p_data2: *I64 = hdr as *I64
        let data_addr: I64 = lowlevel { ptr_read[I64](p_data2) }

        // Write value at data[len] using T-sized stride
        let elem_ptr: *T = (data_addr + cur_len * stride) as *T
        lowlevel { ptr_write[T](elem_ptr, value) }

        // Increment len
        lowlevel { ptr_write[I64](p_len, cur_len + 1) }
    }

    /// Removes the last element from the list and returns it.
    @inline
    pub func pop(this) -> T {
        let hdr: I64 = this.handle as I64
        let p_len: *I64 = (hdr + 8) as *I64
        let p_stride: *I64 = (hdr + 24) as *I64
        let cur_len: I64 = lowlevel { ptr_read[I64](p_len) }
        let stride: I64 = lowlevel { ptr_read[I64](p_stride) }

        // Read data pointer
        let p_data: *I64 = hdr as *I64
        let data_addr: I64 = lowlevel { ptr_read[I64](p_data) }

        // Read element at data[len-1]
        let new_len: I64 = cur_len - 1
        let elem_ptr: *T = (data_addr + new_len * stride) as *T
        let val: T = lowlevel { ptr_read[T](elem_ptr) }

        // Decrement len
        lowlevel { ptr_write[I64](p_len, new_len) }

        val
    }

    /// Returns the element at the given index.
    /// Uses GEP-based pointer arithmetic and unchecked multiply to preserve
    /// pointer provenance and avoid overflow branches — enables LLVM LICM
    /// and auto-vectorization for hot loops.
    @inline
    pub func get(this, index: I64) -> T {
        let stride_ptr: *I64 = lowlevel { ptr_offset(this.handle, 24) } as *I64
        let stride: I64 = lowlevel { ptr_read[I64](stride_ptr) }
        let data: *Unit = lowlevel { ptr_read[*Unit](this.handle as *(*Unit)) }
        // Unchecked multiply avoids overflow branch that blocks vectorization
        let byte_offset: I64 = lowlevel { unchecked_mul(index, stride) }
        let elem_ptr: *T = lowlevel { ptr_offset(data, byte_offset) } as *T
        // clone-read: the list retains ownership of the stored value.
        lowlevel { ptr_read_clone[T](elem_ptr) }
    }

    /// Sets the element at the given index.
    @inline
    pub func set(this, index: I64, value: T) {
        let stride_ptr: *I64 = lowlevel { ptr_offset(this.handle, 24) } as *I64
        let stride: I64 = lowlevel { ptr_read[I64](stride_ptr) }
        let data: *Unit = lowlevel { ptr_read[*Unit](this.handle as *(*Unit)) }
        let byte_offset: I64 = lowlevel { unchecked_mul(index, stride) }
        let elem_ptr: *T = lowlevel { ptr_offset(data, byte_offset) } as *T
        lowlevel { ptr_write[T](elem_ptr, value) }
    }

    /// Returns a zero-copy borrow of the element at `index`.
    ///
    /// Unlike `get`, this does not clone the element — it forwards a pointer
    /// into the backing buffer (a pure GEP), so no refcount is bumped and no
    /// drop-glue runs. Reading fields through the borrow is free.
    ///
    /// Panics if `index` is out of bounds (a dangling borrow would be unsafe).
    ///
    /// # Invalidation
    ///
    /// The returned reference is valid ONLY until the next mutating operation
    /// on the list (`push` / `insert` / `remove` / `pop` / `retain` / `drain`
    /// or any resize). Using it afterward is undefined behavior; compile-time
    /// enforcement lands in a later cluster.
    @inline
    pub func get_ref(this, index: I64) -> ref T {
        if index < 0 or index >= this.len() {
            panic("List::get_ref: index out of bounds")
        }
        let hdr: I64 = this.handle as I64
        let stride: I64 = lowlevel { ptr_read[I64]((hdr + 24) as *I64) }
        let data_addr: I64 = lowlevel { ptr_read[I64](hdr as *I64) }
        let elem_ptr: *T = (data_addr + index * stride) as *T
        return lowlevel { ref (*elem_ptr) }
    }

    /// Returns a zero-copy mutable borrow of the element at `index`.
    ///
    /// Forwards a pointer into the backing buffer via the `list_get_mut`
    /// intrinsic (pure GEP). Writes through the borrow are visible on
    /// subsequent reads. No clone, no drop-glue.
    ///
    /// Panics if `index` is out of bounds.
    ///
    /// # Invalidation
    ///
    /// Same rule as `get_ref`: the reference is valid only until the next
    /// mutating operation on the list.
    @inline
    pub func get_mut(mut this, index: I64) -> mut ref T {
        if index < 0 or index >= this.len() {
            panic("List::get_mut: index out of bounds")
        }
        return lowlevel { list_get_mut(this.handle, index) }
    }

    /// Returns the number of elements in the list.
    @inline
    pub func len(this) -> I64 {
        let hdr: I64 = this.handle as I64
        let p_len: *I64 = (hdr + 8) as *I64
        lowlevel { ptr_read[I64](p_len) }
    }

    /// Returns the current capacity of the list.
    pub func capacity(this) -> I64 {
        let hdr: I64 = this.handle as I64
        let p_cap: *I64 = (hdr + 16) as *I64
        lowlevel { ptr_read[I64](p_cap) }
    }

    /// Returns `true` if the list contains no elements.
    pub func is_empty(this) -> Bool {
        this.len() == 0
    }

    /// Returns the raw data pointer as an I64 integer address.
    ///
    /// Used by iterators to avoid repeated header indirection.
    /// The caller must not outlive the list or mutate the list while using this pointer.
    pub func data_ptr(this) -> I64 {
        let hdr: I64 = this.handle as I64
        lowlevel { ptr_read[I64](hdr as *I64) }
    }

    /// Returns the first element of the list.
    pub func first(this) -> T {
        this.get(0)
    }

    /// Returns the last element of the list.
    pub func last(this) -> T {
        this.get(this.len() - 1)
    }

    /// Removes all elements from the list.
    pub func clear(this) {
        let hdr: I64 = this.handle as I64
        let p_len: *I64 = (hdr + 8) as *I64
        lowlevel { ptr_write[I64](p_len, 0 as I64) }
    }

    /// Destroys the list and frees all associated memory.
    /// Safe to call multiple times — subsequent calls are no-ops.
    pub func destroy(mut this) {
        if this.handle == (0 as *Unit) {
            return
        }
        let hdr: I64 = this.handle as I64

        // Read layout
        let p_data: *I64 = hdr as *I64
        let data_addr: I64 = lowlevel { ptr_read[I64](p_data) }
        let cur_len: I64 = lowlevel { ptr_read[I64]((hdr + 8) as *I64) }
        let stride: I64 = lowlevel { ptr_read[I64]((hdr + 24) as *I64) }

        // F-022 (phase26b step 3): release each live element's handles before
        // freeing the buffer — previously only the buffer was freed, so every
        // element handle (Shared/Heap/Str/...) leaked. Taking ownership into a
        // local runs its drop exactly once; no-op for primitive T.
        for i in 0 to cur_len {
            let elem_ptr: *T = (data_addr + i * stride) as *T
            let _elem: T = lowlevel { ptr_read[T](elem_ptr) }
        }

        // Free data buffer
        lowlevel { mem_free(data_addr as *Unit) }

        // Free header
        lowlevel { mem_free(this.handle) }
        this.handle = 0 as *Unit
    }

    /// Retains only the elements for which the predicate returns `true`.
    ///
    /// Elements are visited in order. Elements for which `pred` returns `false`
    /// are removed. The relative order of retained elements is preserved.
    ///
    /// # Examples
    ///
    /// ```tml
    /// let list = List[I32]::new(4)
    /// list.push(1)
    /// list.push(2)
    /// list.push(3)
    /// list.push(4)
    /// list.retain(do(x: ref I32) *x > 2)  // list is now [3, 4]
    /// ```
    pub func retain(this, pred: func(ref T) -> Bool) {
        let hdr: I64 = this.handle as I64
        let p_len: *I64 = (hdr + 8) as *I64
        let p_stride: *I64 = (hdr + 24) as *I64
        let cur_len: I64 = lowlevel { ptr_read[I64](p_len) }
        let stride: I64 = lowlevel { ptr_read[I64](p_stride) }

        // Read data pointer
        let p_data: *I64 = hdr as *I64
        let data_addr: I64 = lowlevel { ptr_read[I64](p_data) }

        // Two-pointer compaction: write_idx tracks where to write next. The
        // predicate borrows each slot (no copy, no drop-glue); kept elements
        // that shift are moved byte-wise with no typed local; only REMOVED
        // elements are read into an owning local whose drop releases them once.
        var write_idx: I64 = 0
        for read_idx in 0 to cur_len {
            let elem_ptr: *T = (data_addr + read_idx * stride) as *T
            let slot_ref: ref T = lowlevel { ref (*elem_ptr) }
            if pred(slot_ref) {
                // Keep this element — move it byte-wise to write_idx (no
                // typed local, so no spurious drop-glue; the stale source
                // slot ends up beyond the compacted length and is never
                // dropped because its bits were moved).
                if write_idx != read_idx {
                    let dst_ptr: *Unit = (data_addr + write_idx * stride) as *Unit
                    lowlevel { mem_copy(dst_ptr, elem_ptr as *Unit, stride) }
                }
                write_idx = write_idx + 1
            } else {
                // Removed element: take ownership so its drop releases the
                // handles (otherwise removal would leak them).
                let _removed: T = lowlevel { ptr_read[T](elem_ptr) }
            }
        }

        // Update length
        lowlevel { ptr_write[I64](p_len, write_idx) }
    }

    /// Removes and returns elements in the range `[start, end)` as a new list.
    ///
    /// Elements after the drained range are shifted left to fill the gap.
    /// The returned list owns the removed elements.
    ///
    /// # Examples
    ///
    /// ```tml
    /// let list = List[I32]::new(8)
    /// list.push(1)
    /// list.push(2)
    /// list.push(3)
    /// list.push(4)
    /// list.push(5)
    /// let drained = list.drain(1, 3)  // drained = [2, 3], list = [1, 4, 5]
    /// ```
    pub func drain(this, start: I64, end: I64) -> List[T] {
        let hdr: I64 = this.handle as I64
        let p_len: *I64 = (hdr + 8) as *I64
        let p_stride: *I64 = (hdr + 24) as *I64
        let cur_len: I64 = lowlevel { ptr_read[I64](p_len) }
        let stride: I64 = lowlevel { ptr_read[I64](p_stride) }

        // Read data pointer
        let p_data: *I64 = hdr as *I64
        let data_addr: I64 = lowlevel { ptr_read[I64](p_data) }

        // Calculate drain count
        let drain_count: I64 = end - start

        // Create result list with the drained elements
        let result: List[T] = List[T].new(drain_count)
        for i in 0 to drain_count {
            let src_ptr: *T = (data_addr + (start + i) * stride) as *T
            let elem: T = lowlevel { ptr_read[T](src_ptr) }
            result.push(elem)
        }

        // Shift remaining elements left to fill the gap
        let tail_count: I64 = cur_len - end
        if tail_count > 0 {
            let dst: *Unit = (data_addr + start * stride) as *Unit
            let src: *Unit = (data_addr + end * stride) as *Unit
            let byte_count: I64 = tail_count * stride
            lowlevel { copy_nonoverlapping(src, dst, byte_count) }
        }

        // Update length
        let new_len: I64 = cur_len - drain_count
        lowlevel { ptr_write[I64](p_len, new_len) }

        result
    }

    // =========================================================================
    // Search & Query
    // =========================================================================

    /// Returns `true` if the list contains an element equal to `value`.
    pub func contains(this, value: T) -> Bool {
        let n: I64 = this.len()
        for i in 0 to n {
            // Borrow-read (no clone): compare the element in place.
            if *this.get_ref(i) == value {
                return true
            }
        }
        false
    }

    /// Returns the index of the first element equal to `value`, or `Nothing` if not found.
    pub func index_of(this, value: T) -> Maybe[I64] {
        let n: I64 = this.len()
        for i in 0 to n {
            // Borrow-read (no clone): compare the element in place.
            if *this.get_ref(i) == value {
                return Just(i)
            }
        }
        Nothing
    }

    /// Performs a binary search on a sorted list.
    ///
    /// Returns `Ok(index)` if the value is found, or `Err(index)` where `index`
    /// is the insertion point that would maintain sorted order.
    ///
    /// The list MUST be sorted in ascending order before calling this method.
    pub func binary_search(this, value: T) -> Outcome[I64, I64] {
        let n: I64 = this.len()
        var lo: I64 = 0
        var hi: I64 = n
        loop (lo < hi) {
            let mid: I64 = lo + (hi - lo) / 2
            // Borrow-read (no clone): compare the probed element in place.
            let mid_val: ref T = this.get_ref(mid)
            if *mid_val == value {
                return Ok(mid)
            }
            if *mid_val < value {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        Err(lo)
    }

    // =========================================================================
    // Mutation — swap, reverse, insert, remove
    // =========================================================================

    /// Swaps the elements at indices `i` and `j`.
    pub func swap(this, i: I64, j: I64) {
        let tmp: T = this.get(i)
        this.set(i, this.get(j))
        this.set(j, tmp)
    }

    /// Reverses the order of elements in the list in place.
    pub func reverse(this) {
        let n: I64 = this.len()
        var lo: I64 = 0
        var hi: I64 = n - 1
        loop (lo < hi) {
            this.swap(lo, hi)
            lo = lo + 1
            hi = hi - 1
        }
    }

    /// Inserts an element at the given index, shifting all elements after it to the right.
    pub func insert(this, index: I64, value: T) {
        // Push to grow (reuses grow logic), then shift
        this.push(value)
        let cur_len: I64 = this.len()
        var i: I64 = cur_len - 1
        loop (i > index) {
            this.set(i, this.get(i - 1))
            i = i - 1
        }
        this.set(index, value)
    }

    /// Removes and returns the element at the given index, shifting all elements after it to the left.
    pub func remove(this, index: I64) -> T {
        let hdr: I64 = this.handle as I64
        let p_len: *I64 = (hdr + 8) as *I64
        let cur_len: I64 = lowlevel { ptr_read[I64](p_len) }

        let removed: T = this.get(index)
        for i in index to (cur_len - 1) {
            this.set(i, this.get(i + 1))
        }
        lowlevel { ptr_write[I64](p_len, cur_len - 1) }
        removed
    }

    /// Removes the element at `index` by swapping it with the last element. O(1) but doesn't preserve order.
    pub func swap_remove(this, index: I64) -> T {
        let hdr: I64 = this.handle as I64
        let p_len: *I64 = (hdr + 8) as *I64
        let cur_len: I64 = lowlevel { ptr_read[I64](p_len) }
        let last_idx: I64 = cur_len - 1

        let removed: T = this.get(index)
        if index != last_idx {
            this.set(index, this.get(last_idx))
        }
        lowlevel { ptr_write[I64](p_len, last_idx) }
        removed
    }

    /// Appends all elements from another list.
    pub func extend(this, other: ref List[T]) {
        let n: I64 = other.len()
        for i in 0 to n {
            this.push(other.get(i))
        }
    }

    // =========================================================================
    // Capacity & Resize
    // =========================================================================

    /// Ensures the list has capacity for at least `additional` more elements
    /// without reallocating.
    pub func reserve(this, additional: I64) {
        let cur_len: I64 = this.len()
        let cur_cap: I64 = this.capacity()
        let needed: I64 = cur_len + additional
        if needed <= cur_cap {
            return
        }

        let hdr: I64 = this.handle as I64
        let p_stride: *I64 = (hdr + 24) as *I64
        let stride: I64 = lowlevel { ptr_read[I64](p_stride) }

        // Double capacity until sufficient
        var new_cap: I64 = cur_cap
        loop (new_cap < needed) {
            new_cap = new_cap * 2
        }

        let new_size: I64 = new_cap * stride

        // Reallocate data buffer
        let p_data: *I64 = hdr as *I64
        let old_data_addr: I64 = lowlevel { ptr_read[I64](p_data) }
        let old_data: *Unit = old_data_addr as *Unit
        let new_data: *Unit = lowlevel { mem_realloc(old_data, new_size) }

        // Update header
        lowlevel { ptr_write[I64](p_data, new_data as I64) }
        let p_cap: *I64 = (hdr + 16) as *I64
        lowlevel { ptr_write[I64](p_cap, new_cap) }
    }

    /// Shortens the list to `new_len` elements. If `new_len` is greater than
    /// or equal to the current length, this has no effect.
    pub func truncate(this, new_len: I64) {
        let cur_len: I64 = this.len()
        if new_len < cur_len {
            let hdr: I64 = this.handle as I64
            let p_len: *I64 = (hdr + 8) as *I64
            lowlevel { ptr_write[I64](p_len, new_len) }
        }
    }

    /// Removes consecutive duplicate elements in place.
    /// The list should be sorted first if you want to remove all duplicates.
    pub func dedup(this) {
        let n: I64 = this.len()
        if n < 2 {
            return
        }
        var write_idx: I64 = 1
        for read_idx in 1 to n {
            // Borrow-read both operands (no clone) for the equality check; the
            // compaction `set` below is a genuine move and stays a value copy.
            if *this.get_ref(read_idx) != *this.get_ref(write_idx - 1) {
                if write_idx != read_idx {
                    this.set(write_idx, this.get(read_idx))
                }
                write_idx = write_idx + 1
            }
        }
        this.truncate(write_idx)
    }

    /// Sets all elements in the list to `value`.
    pub func fill(this, value: T) {
        let n: I64 = this.len()
        for i in 0 to n {
            this.set(i, value)
        }
    }

    /// Resizes the list to `new_len` elements. If growing, fills new slots with `value`.
    /// If shrinking, truncates the list.
    pub func resize(this, new_len: I64, value: T) {
        let cur_len: I64 = this.len()
        if new_len <= cur_len {
            this.truncate(new_len)
        } else {
            this.reserve(new_len - cur_len)
            var i: I64 = cur_len
            loop (i < new_len) {
                this.push(value)
                i = i + 1
            }
        }
    }

    /// Splits the list at position `mid`, returning two new lists.
    /// The first list contains elements `[0, mid)`, the second `[mid, len)`.
    /// The original list is left empty.
    pub func split_at(this, mid: I64) -> (List[T], List[T]) {
        let n: I64 = this.len()
        let left: List[T] = List[T].new(mid)
        let right: List[T] = List[T].new(n - mid)
        for i in 0 to mid {
            left.push(this.get(i))
        }
        for i in mid to n {
            right.push(this.get(i))
        }
        this.clear()
        (left, right)
    }

    // =========================================================================
    // Sorting
    // =========================================================================

    /// Sorts the list in ascending order using an in-place quicksort.
    pub func sort(this) {
        let n: I64 = this.len()
        if n > 1 {
            this._quicksort(0, n - 1)
        }
    }

    /// Sorts the list using a custom comparator function.
    ///
    /// The comparator should return a negative value if `a < b`, zero if `a == b`,
    /// and a positive value if `a > b`.
    pub func sort_by(this, cmp: func(ref T, ref T) -> I32) {
        let n: I64 = this.len()
        if n > 1 {
            this._quicksort_by(0, n - 1, cmp)
        }
    }

    // Internal quicksort with custom comparator
    func _quicksort_by(this, lo: I64, hi: I64, cmp: func(ref T, ref T) -> I32) {
        if lo < hi {
            // Pivot is copied once (a stable snapshot: swaps below relocate
            // elements, so a borrow into slot `hi` would be fragile). The
            // per-element read is a zero-copy borrow passed straight into
            // cmp's `ref T` parameter — no `let cur: T = get(j)` clone.
            let pivot_val: T = this.get(hi)
            var i: I64 = lo
            for j in lo to hi {
                if cmp(this.get_ref(j), ref pivot_val) <= 0 {
                    this.swap(i, j)
                    i = i + 1
                }
            }
            this.swap(i, hi)
            if i > 0 {
                this._quicksort_by(lo, i - 1, cmp)
            }
            this._quicksort_by(i + 1, hi, cmp)
        }
    }

    // Internal quicksort (ascending, uses PartialOrd <=)
    func _quicksort(this, lo: I64, hi: I64) {
        if lo < hi {
            // Pivot copied once (stable under the swaps below); the per-element
            // read is a zero-copy borrow compared in place — no get(j) clone.
            let pivot_val: T = this.get(hi)
            var i: I64 = lo
            for j in lo to hi {
                if *this.get_ref(j) <= pivot_val {
                    this.swap(i, j)
                    i = i + 1
                }
            }
            this.swap(i, hi)
            if i > 0 {
                this._quicksort(lo, i - 1)
            }
            this._quicksort(i + 1, hi)
        }
    }
}

impl[T] Drop for List[T] {
    func drop(mut this) {
        this.destroy()
    }
}
