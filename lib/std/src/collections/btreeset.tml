//! Sorted set backed by a BTreeMap.
//!
//! `BTreeSet[T]` maintains elements in sorted order using `Ord`, providing
//! O(log n) lookup and O(n) insertion.
//!
//! # Example
//!
//! ```tml
//! use std::collections::BTreeSet
//!
//! var s: BTreeSet[I64] = BTreeSet[I64]::new()
//! s.insert(3)
//! s.insert(1)
//! s.insert(2)
//! assert(s.contains(2))
//! ```

use std::collections::{BTreeMap, BTreeMapIter}

/// A sorted set backed by a `BTreeMap[T, I64]`.
///
/// Elements are maintained in sorted order. Lookups use binary search (O(log n)).
pub type BTreeSet[T] {
    map: BTreeMap[T, I64]
}

impl[T: Ord] BTreeSet[T] {
    /// Creates a new empty BTreeSet.
    pub func new() -> BTreeSet[T] {
        return BTreeSet[T] { map: BTreeMap[T, I64]::new() }
    }

    /// Creates a new empty BTreeSet (alias for new).
    pub func create() -> BTreeSet[T] {
        return BTreeSet[T]::new()
    }

    /// Returns the number of elements.
    pub func len(this) -> I64 {
        return this.map.len()
    }

    /// Returns true if the set is empty.
    pub func is_empty(this) -> Bool {
        return this.map.is_empty()
    }

    /// Inserts an element. Returns true if the element was not already present.
    pub func insert(mut this, value: T) -> Bool {
        if this.map.contains_key(value) {
            return false
        }
        this.map.insert(value, 0)
        return true
    }

    /// Returns true if the set contains the given element.
    pub func contains(this, value: T) -> Bool {
        return this.map.contains_key(value)
    }

    /// Removes an element. Returns true if the element was found.
    pub func remove(mut this, value: T) -> Bool {
        return this.map.remove(value)
    }

    /// Removes all elements.
    pub func clear(mut this) {
        this.map.clear()
    }

    /// Destroys the set and frees all associated memory.
    pub func destroy(mut this) {
        this.map.destroy()
    }

    /// Returns the smallest element, or panics if empty.
    pub func min(this) -> T {
        return this.map.min_key()
    }

    /// Returns the largest element, or panics if empty.
    pub func max(this) -> T {
        return this.map.max_key()
    }

    /// Returns the element at index i in sorted order.
    pub func get_at(this, i: I64) -> T {
        return this.map.key_at(i)
    }

    /// Returns a new set with all elements from both sets.
    pub func union_with(this, other: ref BTreeSet[T]) -> BTreeSet[T] {
        var result: BTreeSet[T] = BTreeSet[T]::new()
        for i in 0 to this.len() {
            result.insert(this.map.key_at(i))
        }
        for j in 0 to other.len() {
            result.insert(other.map.key_at(j))
        }
        return result
    }

    /// Returns a new set with elements common to both sets.
    pub func intersection(this, other: ref BTreeSet[T]) -> BTreeSet[T] {
        var result: BTreeSet[T] = BTreeSet[T]::new()
        for i in 0 to this.len() {
            let val: T = this.map.key_at(i)
            if other.contains(val) {
                result.insert(val)
            }
        }
        return result
    }

    /// Returns a new set with elements in this but not in other.
    pub func difference(this, other: ref BTreeSet[T]) -> BTreeSet[T] {
        var result: BTreeSet[T] = BTreeSet[T]::new()
        for i in 0 to this.len() {
            let val: T = this.map.key_at(i)
            if not other.contains(val) {
                result.insert(val)
            }
        }
        return result
    }

    /// Returns a new set with elements in either but not both.
    pub func symmetric_difference(this, other: ref BTreeSet[T]) -> BTreeSet[T] {
        var result: BTreeSet[T] = BTreeSet[T]::new()
        for i in 0 to this.len() {
            let val: T = this.map.key_at(i)
            if not other.contains(val) {
                result.insert(val)
            }
        }
        for j in 0 to other.len() {
            let val: T = other.map.key_at(j)
            if not this.contains(val) {
                result.insert(val)
            }
        }
        return result
    }

    /// Returns true if all elements of this set are in other.
    pub func is_subset(this, other: ref BTreeSet[T]) -> Bool {
        for i in 0 to this.len() {
            if not other.contains(this.map.key_at(i)) {
                return false
            }
        }
        return true
    }

    /// Returns true if this set contains all elements of other.
    pub func is_superset(this, other: ref BTreeSet[T]) -> Bool {
        return other.is_subset(ref this)
    }

    /// Returns true if this set and other share no elements.
    pub func is_disjoint(this, other: ref BTreeSet[T]) -> Bool {
        for i in 0 to this.len() {
            if other.contains(this.map.key_at(i)) {
                return false
            }
        }
        return true
    }

    /// Returns an iterator over elements with values in [from, until] (inclusive).
    pub func range(this, from: T, until: T) -> BTreeSetIter[T] {
        let map_iter: BTreeMapIter[T, I64] = this.map.range(from, until)
        return BTreeSetIter[T] { inner: map_iter }
    }

    /// Returns an iterator over elements in sorted ascending order.
    pub func iter(this) -> BTreeSetIter[T] {
        let map_iter: BTreeMapIter[T, I64] = this.map.iter()
        return BTreeSetIter[T] { inner: map_iter }
    }
}

impl[T: Ord] Drop for BTreeSet[T] {
    pub func drop(mut this) {
        this.destroy()
    }
}

/// An iterator over BTreeSet elements in sorted ascending order.
pub type BTreeSetIter[T] {
    inner: BTreeMapIter[T, I64]
}

impl[T] BTreeSetIter[T] {
    /// Returns `true` if there are more elements to iterate.
    pub func has_next(this) -> Bool {
        return this.inner.has_next()
    }

    /// Returns the current element value.
    pub func value(this) -> T {
        return this.inner.key()
    }

    /// Advances the iterator to the next element.
    pub func next(mut this) {
        this.inner.next()
    }
}
