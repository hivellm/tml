//! Sorted key-value map backed by sorted arrays with binary search.
//!
//! `BTreeMap[K, V]` maintains keys in sorted order, providing O(log n) lookup,
//! O(n) insertion (due to shifting), and ordered iteration.
//!
//! # Example
//!
//! ```tml
//! use std::collections::BTreeMap
//!
//! var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::new()
//! m.insert(3, 30)
//! m.insert(1, 10)
//! m.insert(2, 20)
//! let v: I64 = m.get(2)  // 20
//! ```

use std::collections::List
use core::traits::cmp::Ordering

/// A sorted key-value map using parallel sorted arrays.
///
/// Keys are maintained in sorted order using the `Ord` behavior.
/// Lookups use binary search (O(log n)).
/// Insertions and removals are O(n) due to element shifting.
pub type BTreeMap[K, V] {
    keys: List[K],
    values: List[V],
    length: I64
}

impl[K: Ord, V] BTreeMap[K, V] {
    /// Creates a new empty BTreeMap.
    pub func new() -> BTreeMap[K, V] {
        let k: List[K] = List[K].new(16)
        let v: List[V] = List[V].new(16)
        return BTreeMap[K, V] {
            keys: k,
            values: v,
            length: 0
        }
    }

    /// Creates a new empty BTreeMap (alias for new).
    pub func create() -> BTreeMap[K, V] {
        return BTreeMap[K, V]::new()
    }

    /// Returns the number of key-value pairs.
    pub func len(this) -> I64 {
        return this.length
    }

    /// Returns true if the map is empty.
    pub func is_empty(this) -> Bool {
        return this.length == 0
    }

    /// Inserts a key-value pair. If the key exists, its value is updated.
    pub func insert(mut this, key: K, value: V) {
        let idx: I64 = this.find_index(ref key)
        if idx >= 0 {
            this.values.set(idx, value)
            return
        }
        let pos: I64 = 0 - idx - 1
        this.insert_at(pos, key, value)
        this.length = this.length + 1
    }

    /// Returns the value for the given key, or panics if not found.
    pub func get(this, key: K) -> V {
        let idx: I64 = this.find_index(ref key)
        if idx < 0 {
            panic("BTreeMap::get: key not found")
        }
        return this.values.get(idx)
    }

    /// Returns Maybe[V] for the given key.
    pub func get_opt(this, key: K) -> Maybe[V] {
        let idx: I64 = this.find_index(ref key)
        if idx < 0 {
            return Nothing
        }
        return Just(this.values.get(idx))
    }

    /// Returns true if the map contains the given key.
    pub func contains_key(this, key: K) -> Bool {
        return this.find_index(ref key) >= 0
    }

    /// Removes a key-value pair. Returns true if the key was found.
    pub func remove(mut this, key: K) -> Bool {
        let idx: I64 = this.find_index(ref key)
        if idx < 0 {
            return false
        }
        this.remove_at(idx)
        this.length = this.length - 1
        return true
    }

    /// Returns all keys in sorted order.
    pub func keys(this) -> List[K] {
        var result: List[K] = List[K].new(this.length)
        for i in 0 to this.length {
            result.push(this.keys.get(i))
        }
        return result
    }

    /// Returns all values in key-sorted order.
    pub func values(this) -> List[V] {
        var result: List[V] = List[V].new(this.length)
        for i in 0 to this.length {
            result.push(this.values.get(i))
        }
        return result
    }

    /// Removes all entries.
    pub func clear(mut this) {
        this.keys.destroy()
        this.values.destroy()
        let k: List[K] = List[K].new(16)
        let v: List[V] = List[V].new(16)
        this.keys = k
        this.values = v
        this.length = 0
    }

    /// Destroys the map and frees all associated memory.
    pub func destroy(mut this) {
        this.keys.destroy()
        this.values.destroy()
    }

    /// Returns the smallest key, or panics if empty.
    pub func min_key(this) -> K {
        if this.length == 0 {
            panic("BTreeMap::min_key: empty map")
        }
        return this.keys.get(0)
    }

    /// Returns the largest key, or panics if empty.
    pub func max_key(this) -> K {
        if this.length == 0 {
            panic("BTreeMap::max_key: empty map")
        }
        return this.keys.get(this.length - 1)
    }

    /// Returns the key at the given index (for ordered iteration).
    pub func key_at(this, idx: I64) -> K {
        return this.keys.get(idx)
    }

    /// Returns the value at the given index (for ordered iteration).
    pub func value_at(this, idx: I64) -> V {
        return this.values.get(idx)
    }

    /// Returns the first index with key >= from_key (inclusive lower bound).
    pub func lower_bound(this, from_key: K) -> I64 {
        var lo: I64 = 0
        var hi: I64 = this.length
        loop (lo < hi) {
            let mid: I64 = lo + (hi - lo) / 2
            let mid_key: K = this.keys.get(mid)
            when mid_key.cmp(ref from_key) {
                Ordering::Less => { lo = mid + 1 },
                _ => { hi = mid }
            }
        }
        return lo
    }

    /// Returns the first index with key > to_key (exclusive upper bound).
    pub func upper_bound(this, to_key: K) -> I64 {
        var lo: I64 = 0
        var hi: I64 = this.length
        loop (lo < hi) {
            let mid: I64 = lo + (hi - lo) / 2
            let mid_key: K = this.keys.get(mid)
            when mid_key.cmp(ref to_key) {
                Ordering::Greater => { hi = mid },
                _ => { lo = mid + 1 }
            }
        }
        return lo
    }

    /// Count of entries with from_key <= key <= to_key.
    pub func range_count(this, from_key: K, to_key: K) -> I64 {
        let lo: I64 = this.lower_bound(from_key)
        let hi: I64 = this.upper_bound(to_key)
        if hi > lo { return hi - lo }
        return 0
    }

    /// Returns the key of the i-th entry in range [from_key, to_key].
    /// Use range_count() to know how many entries exist.
    pub func range_key_at(this, from_key: K, to_key: K, i: I64) -> K {
        let lo: I64 = this.lower_bound(from_key)
        return this.keys.get(lo + i)
    }

    /// Returns the value of the i-th entry in range [from_key, to_key].
    pub func range_value_at(this, from_key: K, to_key: K, i: I64) -> V {
        let lo: I64 = this.lower_bound(from_key)
        return this.values.get(lo + i)
    }

    // ========================================================================
    // Internal helpers
    // ========================================================================

    /// Binary search returning index if found, or -(insertion_point + 1) if not.
    pub func find_index(this, key: ref K) -> I64 {
        var lo: I64 = 0
        var hi: I64 = this.length - 1
        loop (lo <= hi) {
            let mid: I64 = lo + (hi - lo) / 2
            let mid_key: K = this.keys.get(mid)
            when mid_key.cmp(key) {
                Ordering::Equal => { return mid },
                Ordering::Less => { lo = mid + 1 },
                Ordering::Greater => { hi = mid - 1 }
            }
        }
        return 0 - lo - 1
    }

    /// Kept for backward compatibility — delegates to find_index.
    pub func binary_search(this, key: K) -> I64 {
        return this.find_index(ref key)
    }

    /// Insert key and value at position, shifting elements right.
    pub func insert_at(mut this, pos: I64, key: K, value: V) {
        // Append at end to grow the lists
        this.keys.push(key)
        this.values.push(value)
        // Shift elements right from end to pos
        var i: I64 = this.length
        loop (i > pos) {
            this.keys.set(i, this.keys.get(i - 1))
            this.values.set(i, this.values.get(i - 1))
            i = i - 1
        }
        // Place at position
        this.keys.set(pos, key)
        this.values.set(pos, value)
    }

    /// Remove key and value at index, shifting elements left.
    pub func remove_at(mut this, idx: I64) {
        for i in idx to this.length - 1 {
            this.keys.set(i, this.keys.get(i + 1))
            this.values.set(i, this.values.get(i + 1))
        }
        let _k: K = this.keys.pop()
        let _v: V = this.values.pop()
    }

    /// Returns an iterator over entries with keys in [from, to] (inclusive).
    ///
    /// ## Examples
    ///
    /// ```tml
    /// var m: BTreeMap[I64, I64] = BTreeMap[I64, I64]::new()
    /// m.insert(10, 100)
    /// m.insert(20, 200)
    /// m.insert(30, 300)
    /// var it: BTreeMapIter[I64, I64] = m.range(10, 20)
    /// // iterates keys 10, 20
    /// ```
    pub func range(this, from: K, until: K) -> BTreeMapIter[K, V] {
        let lo: I64 = this.lower_bound(from)
        let hi: I64 = this.upper_bound(until)
        let count: I64 = if hi > lo { hi - lo } else { 0 }
        var result_keys: List[K] = List[K].new(count)
        var result_vals: List[V] = List[V].new(count)
        for i in lo to hi {
            result_keys.push(this.keys.get(i))
            result_vals.push(this.values.get(i))
        }
        return BTreeMapIter[K, V] {
            keys: result_keys,
            values: result_vals,
            length: count,
            index: 0
        }
    }

    /// Returns an iterator over entries in sorted key order.
    pub func iter(this) -> BTreeMapIter[K, V] {
        var result_keys: List[K] = List[K].new(this.length)
        var result_vals: List[V] = List[V].new(this.length)
        for i in 0 to this.length {
            result_keys.push(this.keys.get(i))
            result_vals.push(this.values.get(i))
        }
        return BTreeMapIter[K, V] {
            keys: result_keys,
            values: result_vals,
            length: this.length,
            index: 0
        }
    }
}

impl[K: Ord, V] Drop for BTreeMap[K, V] {
    pub func drop(mut this) {
        this.destroy()
    }
}

/// A key-value pair yielded by BTreeMap iteration.
///
/// # Example
///
/// ```tml
/// for entry in map.iter() {
///     let k = entry.key
///     let v = entry.value
/// }
/// ```
pub type MapEntry[K, V] {
    key: K,
    value: V
}

/// An iterator over BTreeMap entries in sorted key order.
pub type BTreeMapIter[K, V] {
    keys: List[K],
    values: List[V],
    length: I64,
    index: I64
}

impl[K, V] BTreeMapIter[K, V] {
    /// Returns `true` if there are more entries to iterate.
    pub func has_next(this) -> Bool {
        return this.index < this.length
    }

    /// Returns the key of the current entry (cursor API).
    pub func key(this) -> K {
        if this.index >= this.length {
            panic("BTreeMapIter::key: iterator exhausted")
        }
        return this.keys.get(this.index)
    }

    /// Returns the value of the current entry (cursor API).
    pub func value(this) -> V {
        if this.index >= this.length {
            panic("BTreeMapIter::value: iterator exhausted")
        }
        return this.values.get(this.index)
    }

    /// Advances the iterator to the next entry (cursor API).
    pub func advance(mut this) {
        if this.index < this.length {
            this.index = this.index + 1
        }
    }
}

impl[K, V] Iterator for BTreeMapIter[K, V] {
    type Item = MapEntry[K, V]

    /// Advances the iterator and returns the next key-value pair.
    ///
    /// Returns `Nothing` when all entries have been visited.
    pub func next(mut this) -> Maybe[MapEntry[K, V]] {
        if this.index >= this.length {
            return Nothing
        }
        let k: K = this.keys.get(this.index)
        let v: V = this.values.get(this.index)
        this.index = this.index + 1
        return Just(MapEntry[K, V] { key: k, value: v })
    }
}
