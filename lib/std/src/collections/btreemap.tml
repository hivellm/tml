//! Sorted key-value map backed by sorted arrays with binary search.
//!
//! `BTreeMap[K, V]` maintains keys in sorted order, providing O(log n) lookup,
//! O(n) insertion (due to shifting), and ordered iteration.
//!
//! Currently specialized for `I64` keys and `I64` values due to compiler
//! limitations with nested generics in multi-param types.
//!
//! # Example
//!
//! ```tml
//! use std::collections::BTreeMap
//!
//! var m: BTreeMap = BTreeMap::create()
//! m.insert(3, 30)
//! m.insert(1, 10)
//! m.insert(2, 20)
//! let v: I64 = m.get(2)  // 20
//! ```

use std::collections::List
use core::runtime::intrinsics::ptr_read

/// A sorted key-value map using parallel sorted arrays.
///
/// Keys and values are `I64`. Keys are maintained in sorted order.
/// Lookups use binary search (O(log n)).
/// Insertions and removals are O(n) due to element shifting.
pub type BTreeMap {
    keys: List[I64],
    values: List[I64],
    length: I64
}

impl BTreeMap {
    /// Creates a new empty BTreeMap.
    pub func create() -> BTreeMap {
        let k: List[I64] = List[I64].new(16)
        let v: List[I64] = List[I64].new(16)
        return BTreeMap {
            keys: k,
            values: v,
            length: 0
        }
    }

    /// Returns the number of key-value pairs.
    pub func len(this) -> I64 {
        return this.length
    }

    /// Returns true if the map is empty.
    pub func is_empty(this) -> Bool {
        return this.length == 0
    }

    /// Inserts a key-value pair. If the key exists, its value is updated.
    pub func insert(mut this, key: I64, value: I64) {
        let idx: I64 = this.binary_search(key)
        if idx >= 0 {
            this.values.set(idx, value)
            return
        }
        let pos: I64 = 0 - idx - 1
        this.insert_at(pos, key, value)
        this.length = this.length + 1
    }

    /// Returns the value for the given key, or panics if not found.
    pub func get(this, key: I64) -> I64 {
        let idx: I64 = this.binary_search(key)
        if idx < 0 {
            panic("BTreeMap::get: key not found")
        }
        return this.values.get(idx)
    }

    /// Returns true if the map contains the given key.
    pub func contains_key(this, key: I64) -> Bool {
        return this.binary_search(key) >= 0
    }

    /// Removes a key-value pair. Returns true if the key was found.
    pub func remove(mut this, key: I64) -> Bool {
        let idx: I64 = this.binary_search(key)
        if idx < 0 {
            return false
        }
        this.remove_at(idx)
        this.length = this.length - 1
        return true
    }


    /// Removes all entries.
    pub func clear(mut this) {
        this.keys.destroy()
        this.values.destroy()
        let k: List[I64] = List[I64].new(16)
        let v: List[I64] = List[I64].new(16)
        this.keys = k
        this.values = v
        this.length = 0
    }

    /// Destroys the map and frees all associated memory.
    pub func destroy(mut this) {
        this.keys.destroy()
        this.values.destroy()
    }

    /// Returns the smallest key, or panics if empty.
    pub func min_key(this) -> I64 {
        if this.length == 0 {
            panic("BTreeMap::min_key: empty map")
        }
        return this.keys.get(0)
    }

    /// Returns the largest key, or panics if empty.
    pub func max_key(this) -> I64 {
        if this.length == 0 {
            panic("BTreeMap::max_key: empty map")
        }
        return this.keys.get(this.length - 1)
    }

    /// Returns the key at the given index (for ordered iteration).
    pub func key_at(this, idx: I64) -> I64 {
        return this.keys.get(idx)
    }

    /// Returns the value at the given index (for ordered iteration).
    pub func value_at(this, idx: I64) -> I64 {
        return this.values.get(idx)
    }

    /// Returns the first index with key >= from_key (inclusive lower bound).
    pub func lower_bound(this, from_key: I64) -> I64 {
        var lo: I64 = 0
        var hi: I64 = this.length
        loop (lo < hi) {
            let mid: I64 = lo + (hi - lo) / 2
            if this.keys.get(mid) < from_key {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return lo
    }

    /// Returns the first index with key > to_key (exclusive upper bound).
    pub func upper_bound(this, to_key: I64) -> I64 {
        var lo: I64 = 0
        var hi: I64 = this.length
        loop (lo < hi) {
            let mid: I64 = lo + (hi - lo) / 2
            if this.keys.get(mid) <= to_key {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return lo
    }

    /// Count of entries with from_key <= key <= to_key.
    pub func range_count(this, from_key: I64, to_key: I64) -> I64 {
        let lo: I64 = this.lower_bound(from_key)
        let hi: I64 = this.upper_bound(to_key)
        if hi > lo { return hi - lo }
        return 0
    }

    /// Returns the key of the i-th entry in range [from_key, to_key].
    /// Use range_count() to know how many entries exist.
    pub func range_key_at(this, from_key: I64, to_key: I64, i: I64) -> I64 {
        let lo: I64 = this.lower_bound(from_key)
        return this.keys.get(lo + i)
    }

    /// Returns the value of the i-th entry in range [from_key, to_key].
    pub func range_value_at(this, from_key: I64, to_key: I64, i: I64) -> I64 {
        let lo: I64 = this.lower_bound(from_key)
        return this.values.get(lo + i)
    }

    // ========================================================================
    // Internal helpers
    // ========================================================================

    /// Binary search returning index if found, or -(insertion_point + 1) if not.
    pub func binary_search(this, key: I64) -> I64 {
        var lo: I64 = 0
        var hi: I64 = this.length - 1
        loop (lo <= hi) {
            let mid: I64 = lo + (hi - lo) / 2
            let mid_key: I64 = this.keys.get(mid)
            if mid_key == key {
                return mid
            } else if mid_key < key {
                lo = mid + 1
            } else {
                hi = mid - 1
            }
        }
        return 0 - lo - 1
    }

    /// Insert key and value at position, shifting elements right.
    pub func insert_at(mut this, pos: I64, key: I64, value: I64) {
        // Append at end to grow the lists
        this.keys.push(key)
        this.values.push(value)
        // Shift elements right from end to pos
        var i: I64 = this.length
        loop (i > pos) {
            this.keys.set(i, this.keys.get(i - 1))
            this.values.set(i, this.values.get(i - 1))
            i = i - 1
        }
        // Place at position
        this.keys.set(pos, key)
        this.values.set(pos, value)
    }

    /// Remove key and value at index, shifting elements left.
    pub func remove_at(mut this, idx: I64) {
        var i: I64 = idx
        loop (i < this.length - 1) {
            this.keys.set(i, this.keys.get(i + 1))
            this.values.set(i, this.values.get(i + 1))
            i = i + 1
        }
        let _k: I64 = this.keys.pop()
        let _v: I64 = this.values.pop()
    }
}

impl Drop for BTreeMap {
    func drop(mut this) {
        this.destroy()
    }
}

/// An iterator over BTreeMap entries in sorted key order.
///
/// Created by calling `iter()` on a BTreeMap.
/// Yields (key, value) pairs in ascending key order.
///
/// Stores raw data pointers extracted from the List headers at construction.
/// The BTreeMap must not be mutated while the iterator is alive.
///
/// # Example
///
/// ```tml
/// var m: BTreeMap = BTreeMap::create()
/// m.insert(1, 10)
/// m.insert(2, 20)
/// var it: BTreeMapIter = m.iter()
/// loop (it.has_next()) {
///     let k: I64 = it.key()
///     let v: I64 = it.value()
///     it.next()
/// }
/// ```
pub type BTreeMapIter {
    /// Raw pointer to the keys data buffer (I64 array).
    keys_data: I64,
    /// Raw pointer to the values data buffer (I64 array).
    values_data: I64,
    /// Total number of entries.
    length: I64,
    /// Current position.
    index: I64
}

impl BTreeMapIter {
    /// Returns `true` if there are more entries to iterate.
    pub func has_next(this) -> Bool {
        return this.index < this.length
    }

    /// Returns the key of the current entry.
    /// Panics if the iterator is exhausted.
    pub func key(this) -> I64 {
        if this.index >= this.length {
            panic("BTreeMapIter::key: iterator exhausted")
        }
        // keys are I64 (8 bytes each), stride = 8
        let stride: I64 = 8
        return lowlevel { ptr_read[I64]((this.keys_data + this.index * stride) as *I64) }
    }

    /// Returns the value of the current entry.
    /// Panics if the iterator is exhausted.
    pub func value(this) -> I64 {
        if this.index >= this.length {
            panic("BTreeMapIter::value: iterator exhausted")
        }
        // values are I64 (8 bytes each), stride = 8
        let stride: I64 = 8
        return lowlevel { ptr_read[I64]((this.values_data + this.index * stride) as *I64) }
    }

    /// Advances the iterator to the next entry.
    pub func next(mut this) {
        if this.index < this.length {
            this.index = this.index + 1
        }
    }
}

impl BTreeMap {
    /// Returns an iterator over entries in sorted key order.
    ///
    /// Extracts raw data pointers from the List[I64] headers.
    /// List header layout: offset 0 = data ptr (I64), offset 8 = len, offset 16 = cap, offset 24 = stride.
    /// The BTreeMap must not be mutated while the iterator is alive.
    pub func iter(this) -> BTreeMapIter {
        let keys_data: I64 = this.keys.data_ptr()
        let values_data: I64 = this.values.data_ptr()
        return BTreeMapIter {
            keys_data: keys_data,
            values_data: values_data,
            length: this.length,
            index: 0
        }
    }
}
