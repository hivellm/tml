//! Neural network layers, activations, and loss functions.
//!
//! # Modules
//!
//! | Module       | Description                                          |
//! |--------------|------------------------------------------------------|
//! | `module`     | [`Parameter`], weight initialisation helpers          |
//! | `activation` | ReLU, sigmoid, tanh, GELU, SiLU, softmax            |
//! | `linear`     | Fully-connected (dense) layer                        |
//! | `loss`       | MSE, cross-entropy, L1, BCE loss functions           |
//! | `dropout`    | Dropout regularisation layer                         |
//! | `norm`       | Layer normalisation, RMS normalisation               |
//! | `embedding`  | Lookup embedding for token indices                   |
//! | `attention`  | Scaled dot-product and multi-head attention           |

pub mod module
pub mod activation
pub mod linear
pub mod loss
pub mod dropout
pub mod norm
pub mod embedding
pub mod attention

// -- module (Parameter, init helpers) --
pub use std::ia::nn::module::*
pub use std::ia::nn::activation::*
pub use std::ia::nn::linear::Linear
pub use std::ia::nn::dropout::Dropout
pub use std::ia::nn::norm::{LayerNorm, RMSNorm}
pub use std::ia::nn::embedding::Embedding
pub use std::ia::nn::attention::{MultiHeadAttention, scaled_dot_product_attention}
pub use std::ia::nn::loss::*
