//! Tensor creation functions — zeros, ones, full, from_list, arange, linspace, rand, randn.

use std::collections::{List, Buffer}
use std::random::Rng
use std::math::{sqrt, ln, cos, PI}
use std::ia::tensor::dtype::DType
use std::ia::tensor::shape::{Shape, Layout}
use std::ia::tensor::tensor::Tensor

/// Writes `byte_count` zero bytes to `buf` sequentially, growing its length.
func write_zero_bytes(buf: ref Buffer, byte_count: I64) {
    let mut i = 0
    loop (i < byte_count) {
        buf.write_byte(0)
        i = i + 1
    }
}

/// Writes a typed scalar `value` (as F64) to every element of `buf` for `n` elements of `dtype`.
func fill_typed(buf: ref Buffer, n: I64, dtype: DType, value: F64) {
    let mut i = 0
    loop (i < n) {
        let offset = i * dtype.size_bytes()
        when dtype {
            DType::F32 => buf.write_f32_le(value as F32, offset),
            DType::F64 => buf.write_f64_le(value, offset),
            DType::I32 => buf.write_u32_le(value as I64, offset),
            DType::I64 => buf.write_u64_le(value as I64, offset),
            DType::Bool => buf.write_u8(value != 0.0 ? 1 : 0, offset),
            DType::U8 => buf.write_u8(value as I64 as I32, offset),
            DType::U32 => buf.write_u32_le(value as I64, offset),
        }
        i = i + 1
    }
}

/// Creates a tensor filled with zeros.
pub func zeros(dims: List[I64], dtype: DType) -> Tensor {
    let shape = Shape::new(dims)
    let n = shape.numel()
    let byte_size = n * dtype.size_bytes()
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, dtype)
}

/// Creates a tensor filled with ones.
pub func ones(dims: List[I64], dtype: DType) -> Tensor {
    let shape = Shape::new(dims)
    let n = shape.numel()
    let byte_size = n * dtype.size_bytes()
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    fill_typed(ref buf, n, dtype, 1.0)
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, dtype)
}

/// Creates a tensor filled with a constant value.
pub func full(dims: List[I64], value: F64, dtype: DType) -> Tensor {
    let shape = Shape::new(dims)
    let n = shape.numel()
    let byte_size = n * dtype.size_bytes()
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    fill_typed(ref buf, n, dtype, value)
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, dtype)
}

/// Creates an F64 tensor from a flat list of F64 values with the given shape.
///
/// The product of `dims` must equal `data.len()`.
pub func from_list_f64(data: List[F64], dims: List[I64]) -> Tensor {
    let shape = Shape::new(dims)
    let n = shape.numel()
    let byte_size = n * 8
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    let mut i = 0
    loop (i < n) {
        let offset = i * 8
        buf.write_f64_le(data.get(i), offset)
        i = i + 1
    }
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, DType::F64)
}

/// Creates an F32 tensor from a flat list of F32 values with the given shape.
///
/// The product of `dims` must equal `data.len()`.
pub func from_list_f32(data: List[F32], dims: List[I64]) -> Tensor {
    let shape = Shape::new(dims)
    let n = shape.numel()
    let byte_size = n * 4
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    let mut i = 0
    loop (i < n) {
        let offset = i * 4
        buf.write_f32_le(data.get(i), offset)
        i = i + 1
    }
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, DType::F32)
}

/// Creates an I64 tensor from a flat list of I64 values with the given shape.
///
/// The product of `dims` must equal `data.len()`.
pub func from_list_i64(data: List[I64], dims: List[I64]) -> Tensor {
    let shape = Shape::new(dims)
    let n = shape.numel()
    let byte_size = n * 8
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    let mut i = 0
    loop (i < n) {
        let offset = i * 8
        buf.write_u64_le(data.get(i), offset)
        i = i + 1
    }
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, DType::I64)
}

/// Creates a 1-D tensor of evenly spaced values in [start, end) with the given step.
///
/// The number of elements is `ceil((end - start) / step)`.
/// The dtype is applied to each computed value.
pub func arange(start: F64, end: F64, step: F64, dtype: DType) -> Tensor {
    // Count elements: how many steps fit in [start, end)?
    let range = end - start
    let n_f = range / step
    let n = n_f as I64
    let byte_size = n * dtype.size_bytes()
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    let mut i = 0
    loop (i < n) {
        let value = start + (i as F64) * step
        let offset = i * dtype.size_bytes()
        when dtype {
            DType::F32 => buf.write_f32_le(value as F32, offset),
            DType::F64 => buf.write_f64_le(value, offset),
            DType::I32 => buf.write_u32_le(value as I64, offset),
            DType::I64 => buf.write_u64_le(value as I64, offset),
            DType::Bool => buf.write_u8(value != 0.0 ? 1 : 0, offset),
            DType::U8 => buf.write_u8(value as I64 as I32, offset),
            DType::U32 => buf.write_u32_le(value as I64, offset),
        }
        i = i + 1
    }
    let mut dims = List[I64]::new(1)
    dims.push(n)
    let shape = Shape::new(dims)
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, dtype)
}

/// Creates a 1-D F64 tensor of `steps` linearly spaced values in [start, end].
pub func linspace(start: F64, end: F64, steps: I64) -> Tensor {
    let byte_size = steps * 8
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    let mut i = 0
    loop (i < steps) {
        let t: F64 = steps > 1 ? (i as F64) / ((steps - 1) as F64) : 0.0
        let value = start + t * (end - start)
        let offset = i * 8
        buf.write_f64_le(value, offset)
        i = i + 1
    }
    let mut dims = List[I64]::new(1)
    dims.push(steps)
    let shape = Shape::new(dims)
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, DType::F64)
}

/// Creates an F64 tensor with values drawn from a uniform distribution in [0, 1).
pub func rand(dims: List[I64]) -> Tensor {
    let shape = Shape::new(dims)
    let n = shape.numel()
    let byte_size = n * 8
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    let mut rng = Rng::new()
    let mut i = 0
    loop (i < n) {
        let offset = i * 8
        buf.write_f64_le(rng.next_f64(), offset)
        i = i + 1
    }
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, DType::F64)
}

/// Creates an F64 tensor with values drawn from a standard normal distribution N(0, 1).
///
/// Uses the Box-Muller transform with the Marsaglia polar method for numerical stability.
pub func randn(dims: List[I64]) -> Tensor {
    let shape = Shape::new(dims)
    let n = shape.numel()
    let byte_size = n * 8
    let mut buf = Buffer::new(byte_size)
    write_zero_bytes(ref buf, byte_size)
    let mut rng = Rng::new()
    // Box-Muller / Marsaglia polar method.
    // Each iteration produces two normal samples.  We generate them in pairs and
    // write both; if n is odd the last extra sample is simply not written.
    let mut i = 0
    loop (i < n) {
        // Marsaglia polar method: sample u,v in (-1,1) until s = u²+v² is in (0,1).
        let mut u = 0.0
        let mut v = 0.0
        let mut s = 0.0
        loop (s <= 0.0 or s >= 1.0) {
            u = rng.range_f64(-1.0, 1.0)
            v = rng.range_f64(-1.0, 1.0)
            s = u * u + v * v
        }
        let factor = sqrt(-2.0 * ln(s) / s)
        let z0 = u * factor
        let z1 = v * factor
        buf.write_f64_le(z0, i * 8)
        if i + 1 < n {
            buf.write_f64_le(z1, (i + 1) * 8)
        }
        i = i + 2
    }
    let layout = Layout::contiguous(shape)
    Tensor::from_raw(buf, layout, DType::F64)
}
