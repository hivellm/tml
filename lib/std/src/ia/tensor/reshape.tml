//! Tensor reshaping and dimension manipulation.
//!
//! Provides reshape, transpose, permute, squeeze, unsqueeze, expand, and
//! contiguous operations following NumPy/PyTorch semantics.

use std::collections::List
use std::ia::error::{IaError, IaResult}
use std::ia::tensor::dtype::DType
use std::ia::tensor::shape::{Shape, broadcast_shape}
use std::ia::tensor::tensor::Tensor
use std::ia::tensor::init::zeros

// ---------------------------------------------------------------------------
// Internal helpers (mirrored from ops.tml / reduce.tml)
// ---------------------------------------------------------------------------

/// Build a dims list by reading the shape of `t`.
func shape_dims(t: ref Tensor) -> List[I64] {
    let rank = t.rank()
    let mut dims = List[I64]::new(rank)
    let mut i = 0
    loop (i < rank) {
        dims.push(t.dim(i))
        i = i + 1
    }
    dims
}

/// Convert a flat row-major index into a list of per-dimension indices.
func flat_to_indices(flat: I64, shape: ref Shape) -> List[I64] {
    let rank = shape.rank()
    let mut indices = List[I64]::new(rank)
    let mut k = 0
    loop (k < rank) {
        indices.push(0)
        k = k + 1
    }
    let mut remaining = flat
    let mut j = 0
    loop (j < rank) {
        let mut stride = 1
        let mut s = j + 1
        loop (s < rank) {
            stride = stride * shape.dim(s)
            s = s + 1
        }
        let idx = remaining / stride
        indices.set(j, idx)
        remaining = remaining - idx * stride
        j = j + 1
    }
    indices
}

/// Convert multi-dimensional indices into a flat row-major index.
func indices_to_flat(indices: ref List[I64], shape: ref Shape) -> I64 {
    let rank = shape.rank()
    let mut flat = 0
    let mut stride = 1
    let mut i = rank - 1
    loop (i >= 0) {
        flat = flat + indices.get(i) * stride
        stride = stride * shape.dim(i)
        i = i - 1
    }
    flat
}

// ---------------------------------------------------------------------------
// Reshape
// ---------------------------------------------------------------------------

/// Reshape tensor `a` to the given dimensions.
///
/// The total number of elements must be preserved.  Data is copied in
/// row-major (C-contiguous) flat order, so the semantics match NumPy's
/// `reshape` with `order='C'`.
///
/// # Errors
/// Returns `IaError::ShapeMismatch` if `product(new_dims) != a.numel()`.
pub func reshape(a: ref Tensor, new_dims: List[I64]) -> IaResult[Tensor] {
    // Verify numel is preserved.
    let new_shape = Shape::new(new_dims)
    if new_shape.numel() != a.numel() {
        return Err(IaError::ShapeMismatch("reshape: product of new dims does not equal numel"))
    }
    let n = a.numel()
    // Build a second copy of new_dims for zeros() because new_dims was moved
    // into the Shape above.
    let new_rank = new_shape.rank()
    let mut out_dims = List[I64]::new(new_rank)
    let mut k = 0
    loop (k < new_rank) {
        out_dims.push(new_shape.dim(k))
        k = k + 1
    }
    let mut result = zeros(out_dims, a.dtype())
    let mut i = 0
    loop (i < n) {
        result.set_f64(i, a.get_f64(i))
        i = i + 1
    }
    Ok(result)
}

// ---------------------------------------------------------------------------
// Transpose (2-D only)
// ---------------------------------------------------------------------------

/// Transpose a 2-D tensor: shape [M, N] → [N, M].
///
/// Element `a[i, j]` maps to `result[j, i]`.
///
/// # Errors
/// Returns `IaError::InvalidAxis` if `a` is not exactly 2-D.
pub func transpose(a: ref Tensor) -> IaResult[Tensor] {
    if a.rank() != 2 {
        return Err(IaError::InvalidAxis("transpose: tensor must be 2-D"))
    }
    let m = a.dim(0)
    let n = a.dim(1)
    let mut out_dims = List[I64]::new(2)
    out_dims.push(n)
    out_dims.push(m)
    let mut result = zeros(out_dims, a.dtype())
    let mut i = 0
    loop (i < m) {
        let mut j = 0
        loop (j < n) {
            // Source: row-major index i*n + j
            // Dest:   row-major index j*m + i
            result.set_f64(j * m + i, a.get_f64(i * n + j))
            j = j + 1
        }
        i = i + 1
    }
    Ok(result)
}

// ---------------------------------------------------------------------------
// Permute (general axis reordering)
// ---------------------------------------------------------------------------

/// Permute the dimensions of tensor `a` according to `axes`.
///
/// `axes` must be a permutation of `[0, 1, ..., rank-1]`.  The output shape
/// is built by selecting `a.dim(axes[i])` for each output dimension `i`.
///
/// For each output element at multi-dimensional index `out_idx`, the
/// corresponding input index is obtained by `in_idx[axes[i]] = out_idx[i]`.
///
/// # Errors
/// - `IaError::InvalidAxis` if `axes.len() != a.rank()`.
/// - `IaError::InvalidAxis` if `axes` is not a valid permutation.
pub func permute(a: ref Tensor, axes: List[I64]) -> IaResult[Tensor] {
    let rank = a.rank()
    if axes.len() != rank {
        return Err(IaError::InvalidAxis("permute: axes length must equal tensor rank"))
    }
    // Validate that axes is a permutation: each value must appear exactly once
    // in the range [0, rank).
    let mut seen = List[I64]::new(rank)
    let mut k = 0
    loop (k < rank) {
        seen.push(0)
        k = k + 1
    }
    let mut v = 0
    loop (v < rank) {
        let ax = axes.get(v)
        if ax < 0 or ax >= rank {
            return Err(IaError::InvalidAxis("permute: axis value out of range"))
        }
        seen.set(ax, seen.get(ax) + 1)
        v = v + 1
    }
    let mut u = 0
    loop (u < rank) {
        if seen.get(u) != 1 {
            return Err(IaError::InvalidAxis("permute: axes must be a valid permutation"))
        }
        u = u + 1
    }
    // Build output shape: out_shape[i] = a.dim(axes[i])
    let mut out_dims = List[I64]::new(rank)
    let mut d = 0
    loop (d < rank) {
        out_dims.push(a.dim(axes.get(d)))
        d = d + 1
    }
    let out_shape = Shape::new(out_dims)
    let n = out_shape.numel()
    // Build a second dims list for zeros() since out_shape owns the first.
    let mut zeros_dims = List[I64]::new(rank)
    let mut zk = 0
    loop (zk < rank) {
        zeros_dims.push(out_shape.dim(zk))
        zk = zk + 1
    }
    let mut result = zeros(zeros_dims, a.dtype())
    // For each output flat index, find the corresponding input flat index.
    let mut out_flat = 0
    loop (out_flat < n) {
        // Convert output flat index → output multi-dim indices.
        let out_indices = flat_to_indices(out_flat, ref out_shape)
        // Build input multi-dim indices: in_indices[axes[i]] = out_indices[i]
        let mut in_indices = List[I64]::new(rank)
        let mut ki = 0
        loop (ki < rank) {
            in_indices.push(0)
            ki = ki + 1
        }
        let mut oi = 0
        loop (oi < rank) {
            let src_dim = axes.get(oi)
            in_indices.set(src_dim, out_indices.get(oi))
            oi = oi + 1
        }
        let in_flat = indices_to_flat(ref in_indices, a.shape())
        result.set_f64(out_flat, a.get_f64(in_flat))
        out_flat = out_flat + 1
    }
    Ok(result)
}

// ---------------------------------------------------------------------------
// Squeeze
// ---------------------------------------------------------------------------

/// Remove all dimensions of size 1 from tensor `a`.
///
/// The data is not modified; only the shape changes.  If no dimensions of
/// size 1 exist, the original data is returned in a tensor with the same
/// shape.  If all dimensions are 1 (e.g. shape [1, 1]), the result is a
/// rank-1 tensor with a single element.
pub func squeeze(a: ref Tensor) -> Tensor {
    let rank = a.rank()
    let mut new_dims = List[I64]::new(rank)
    let mut i = 0
    loop (i < rank) {
        if a.dim(i) != 1 {
            new_dims.push(a.dim(i))
        }
        i = i + 1
    }
    // If all dims were 1, keep a scalar-like rank-1 tensor with dim 1.
    if new_dims.len() == 0 {
        new_dims.push(1)
    }
    // Copy data (flat order is unchanged).
    let n = a.numel()
    let mut result = zeros(new_dims, a.dtype())
    let mut j = 0
    loop (j < n) {
        result.set_f64(j, a.get_f64(j))
        j = j + 1
    }
    result
}

// ---------------------------------------------------------------------------
// Unsqueeze
// ---------------------------------------------------------------------------

/// Insert a dimension of size 1 at position `dim`.
///
/// `dim` must be in the range `[0, rank]` (inclusive).
///
/// # Errors
/// Returns `IaError::InvalidAxis` if `dim` is out of range.
pub func unsqueeze(a: ref Tensor, dim: I64) -> IaResult[Tensor] {
    let rank = a.rank()
    if dim < 0 or dim > rank {
        return Err(IaError::InvalidAxis("unsqueeze: dim out of range [0, rank]"))
    }
    let mut new_dims = List[I64]::new(rank + 1)
    let mut i = 0
    loop (i <= rank) {
        if i == dim {
            new_dims.push(1)
        }
        if i < rank {
            new_dims.push(a.dim(i))
        }
        i = i + 1
    }
    // Copy data (flat order unchanged).
    let n = a.numel()
    let mut result = zeros(new_dims, a.dtype())
    let mut j = 0
    loop (j < n) {
        result.set_f64(j, a.get_f64(j))
        j = j + 1
    }
    Ok(result)
}

// ---------------------------------------------------------------------------
// Expand (broadcast-expand)
// ---------------------------------------------------------------------------

/// Expand tensor `a` to `new_dims` using broadcasting rules.
///
/// Each dimension of `a` must either match the corresponding new dimension or
/// be exactly 1 (in which case the data is repeated along that axis).  The
/// length of `new_dims` must equal `a.rank()`.
///
/// # Errors
/// - `IaError::ShapeMismatch` if `new_dims.len() != a.rank()`.
/// - `IaError::ShapeMismatch` if a non-1 dimension does not match.
pub func expand(a: ref Tensor, new_dims: List[I64]) -> IaResult[Tensor] {
    let rank = a.rank()
    if new_dims.len() != rank {
        return Err(IaError::ShapeMismatch("expand: new_dims length must equal tensor rank"))
    }
    // Validate: each dim must match or the source dim must be 1.
    let mut v = 0
    loop (v < rank) {
        let src_d = a.dim(v)
        let dst_d = new_dims.get(v)
        if src_d != 1 and src_d != dst_d {
            return Err(IaError::ShapeMismatch("expand: can only expand dimensions of size 1"))
        }
        v = v + 1
    }
    let out_shape = Shape::new(new_dims)
    let n = out_shape.numel()
    let mut zeros_dims = List[I64]::new(rank)
    let mut zk = 0
    loop (zk < rank) {
        zeros_dims.push(out_shape.dim(zk))
        zk = zk + 1
    }
    let mut result = zeros(zeros_dims, a.dtype())
    // For each output element, find the source element using broadcasting.
    let mut out_flat = 0
    loop (out_flat < n) {
        let out_indices = flat_to_indices(out_flat, ref out_shape)
        // Build source indices: clamp to 0 when source dim is 1.
        let mut src_indices = List[I64]::new(rank)
        let mut i = 0
        loop (i < rank) {
            let src_d = a.dim(i)
            let idx = src_d == 1 ? 0 : out_indices.get(i)
            src_indices.push(idx)
            i = i + 1
        }
        let src_flat = indices_to_flat(ref src_indices, a.shape())
        result.set_f64(out_flat, a.get_f64(src_flat))
        out_flat = out_flat + 1
    }
    Ok(result)
}

// ---------------------------------------------------------------------------
// Contiguous
// ---------------------------------------------------------------------------

/// Return a contiguous (row-major) copy of tensor `a`.
///
/// Copies all elements in flat order into a new tensor with the same shape
/// and dtype.  Always produces a fresh allocation regardless of whether the
/// input is already contiguous.
pub func contiguous(a: ref Tensor) -> Tensor {
    let dims = shape_dims(a)
    let n = a.numel()
    let mut result = zeros(dims, a.dtype())
    let mut i = 0
    loop (i < n) {
        result.set_f64(i, a.get_f64(i))
        i = i + 1
    }
    result
}
