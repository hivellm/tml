//! Training infrastructure for the TML AI Library.
//!
//! # Modules
//!
//! | Module       | Description                                               |
//! |--------------|-----------------------------------------------------------|
//! | `dataset`    | [`Dataset`] — in-memory (input, target) tensor pairs     |
//! | `dataloader` | [`DataLoader`] — batched, optionally-shuffled iteration  |
//! | `trainer`    | [`EpochResult`], [`LossAccumulator`], helpers            |
//! | `checkpoint` | [`Checkpoint`], [`CheckpointStore`] — parameter snapshots|

pub mod dataset
pub mod dataloader
pub mod trainer
pub mod checkpoint

pub use std::ia::train::dataset::Dataset
pub use std::ia::train::dataloader::DataLoader
pub use std::ia::train::trainer::TrainConfig
pub use std::ia::train::trainer::EpochResult
pub use std::ia::train::trainer::LossAccumulator
pub use std::ia::train::trainer::range_indices
pub use std::ia::train::trainer::shuffle_indices
pub use std::ia::train::checkpoint::Checkpoint
pub use std::ia::train::checkpoint::CheckpointStore
