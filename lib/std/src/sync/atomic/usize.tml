//! Atomic pointer-sized unsigned integer type.

pub use std::sync::ordering::Ordering

// ============================================================================
// AtomicUsize
// ============================================================================

/// A pointer-sized unsigned integer which can be safely shared between threads.
///
/// This type has the same size as `Usize`: 32 bits on 32-bit platforms,
/// 64 bits on 64-bit platforms.
@repr(transparent)
pub type AtomicUsize {
    value: Usize
}

impl AtomicUsize {
    /// A constant indicating whether this atomic type is always lock-free.
    pub const LOCK_FREE: Bool = true

    /// Creates a new AtomicUsize with the given initial value.
    pub func new(v: Usize) -> AtomicUsize {
        return AtomicUsize { value: v }
    }

    /// Loads the current value atomically.
    pub func load(this, order: Ordering) -> Usize {
        lowlevel { return this.value }
    }

    /// Stores a value atomically.
    pub func store(mut this, val: Usize, order: Ordering) -> Unit {
        lowlevel { this.value = val }
    }

    /// Atomically swaps the value, returning the previous value.
    pub func swap(mut this, val: Usize, order: Ordering) -> Usize {
        lowlevel {
            let old: Usize = this.value
            this.value = val
            return old
        }
    }

    /// Atomically compares and swaps if equal, returning the previous value.
    pub func compare_exchange(
        mut this,
        current: Usize,
        new: Usize,
        success: Ordering,
        failure: Ordering
    ) -> Outcome[Usize, Usize] {
        lowlevel {
            if this.value == current {
                this.value = new
                return Ok(current)
            }
            return Err(this.value)
        }
    }

    /// Atomically compares and swaps if equal, returning the previous value.
    pub func compare_exchange_weak(
        mut this,
        current: Usize,
        new: Usize,
        success: Ordering,
        failure: Ordering
    ) -> Outcome[Usize, Usize] {
        return this.compare_exchange(current, new, success, failure)
    }

    /// Stores a value if the current value equals `current`, returning the previous value.
    pub func compare_and_swap(mut this, current: Usize, new: Usize, order: Ordering) -> Usize {
        when this.compare_exchange(current, new, order, order) {
            Ok(prev) => prev,
            Err(actual) => actual,
        }
    }

    /// Atomically adds to the value, returning the previous value.
    pub func fetch_add(mut this, val: Usize, order: Ordering) -> Usize {
        lowlevel {
            let old: Usize = this.value
            this.value = this.value + val
            return old
        }
    }

    /// Atomically subtracts from the value, returning the previous value.
    pub func fetch_sub(mut this, val: Usize, order: Ordering) -> Usize {
        lowlevel {
            let old: Usize = this.value
            this.value = this.value - val
            return old
        }
    }

    /// Atomically performs bitwise AND, returning the previous value.
    pub func fetch_and(mut this, val: Usize, order: Ordering) -> Usize {
        lowlevel {
            let old: Usize = this.value
            this.value = this.value & val
            return old
        }
    }

    /// Atomically performs bitwise OR, returning the previous value.
    pub func fetch_or(mut this, val: Usize, order: Ordering) -> Usize {
        lowlevel {
            let old: Usize = this.value
            this.value = this.value | val
            return old
        }
    }

    /// Atomically performs bitwise XOR, returning the previous value.
    pub func fetch_xor(mut this, val: Usize, order: Ordering) -> Usize {
        lowlevel {
            let old: Usize = this.value
            this.value = this.value ^ val
            return old
        }
    }

    /// Atomically computes the maximum, returning the previous value.
    pub func fetch_max(mut this, val: Usize, order: Ordering) -> Usize {
        lowlevel {
            let old: Usize = this.value
            if val > this.value { this.value = val }
            return old
        }
    }

    /// Atomically computes the minimum, returning the previous value.
    pub func fetch_min(mut this, val: Usize, order: Ordering) -> Usize {
        lowlevel {
            let old: Usize = this.value
            if val < this.value { this.value = val }
            return old
        }
    }

    /// Returns `true` if operations on this type are lock-free.
    pub func is_lock_free(this) -> Bool {
        return true
    }

    /// Consumes the atomic and returns the contained value.
    pub func into_inner(this) -> Usize {
        return this.value
    }
}
