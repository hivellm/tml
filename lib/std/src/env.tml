//! Environment variable access and process information.
//!
//! This module provides a Rust-compatible API for accessing environment
//! variables, the current working directory, temporary directory, and
//! command-line arguments.
//!
//! It wraps `std::os` with naming conventions matching Rust's `std::env`.
//!
//! # Examples
//!
//! ```tml
//! use std::env
//!
//! // Get an environment variable
//! let path: Maybe[Str] = env::get_var("PATH")
//! if path.is_just() {
//!     print("PATH=" + path.unwrap() + "\n")
//! }
//!
//! // Set an environment variable
//! env::set_var("MY_VAR", "hello")
//!
//! // Get current directory
//! let cwd: Str = env::current_dir()
//! ```

use std::os

// ============================================================================
// Environment Variables
// ============================================================================

/// Returns the value of the environment variable `name`.
///
/// Returns `Just(value)` if the variable is set, `Nothing` otherwise.
///
/// # Example
///
/// ```tml
/// let path: Maybe[Str] = env::get_var("PATH")
/// ```
pub func get_var(name: Str) -> Maybe[Str] {
    return os::env_get(name)
}

/// Alias for `get_var` — returns the value of environment variable `name`.
///
/// Returns `Just(value)` if set, `Nothing` otherwise.
pub func lookup(name: Str) -> Maybe[Str] {
    return os::env_get(name)
}

/// Sets the environment variable `name` to `value`.
///
/// Returns `true` on success, `false` on failure.
///
/// # Example
///
/// ```tml
/// env::set_var("MY_VAR", "hello")
/// ```
pub func set_var(name: Str, value: Str) -> Bool {
    return os::env_set(name, value)
}

/// Removes the environment variable `name`.
///
/// Returns `true` on success, `false` on failure.
///
/// # Example
///
/// ```tml
/// env::remove_var("MY_VAR")
/// ```
pub func remove_var(name: Str) -> Bool {
    return os::env_unset(name)
}

// ============================================================================
// Filesystem Paths
// ============================================================================

/// Returns the current working directory.
///
/// Returns an empty string if the directory cannot be determined.
///
/// # Example
///
/// ```tml
/// let cwd: Str = env::current_dir()
/// ```
pub func current_dir() -> Str {
    return os::current_dir()
}

/// Returns the path of a temporary directory.
///
/// On Windows, returns the value of `TMP`, `TEMP`, or `C:\Windows\Temp`.
/// On Unix, returns the value of `TMPDIR`, `TMP`, `TEMP`, or `/tmp`.
///
/// # Example
///
/// ```tml
/// let tmp: Str = env::temp_dir()
/// ```
pub func temp_dir() -> Str {
    return os::tmpdir()
}

// ============================================================================
// Command-Line Arguments
// ============================================================================

/// An iterator over command-line arguments.
///
/// Created by [`args()`].
///
/// # Example
///
/// ```tml
/// var args: env::Args = env::args()
/// loop (args.has_next()) {
///     let arg: Str = args.next()
///     print(arg + "\n")
/// }
/// ```
pub type Args {
    _index: I32,
    _count: I32
}

impl Args {
    /// Returns `true` if there are more arguments to iterate.
    pub func has_next(this) -> Bool {
        return this._index < this._count
    }

    /// Returns the next argument and advances the iterator.
    pub func next(mut this) -> Str {
        let arg: Str = os::args_get(this._index)
        this._index = this._index + 1
        return arg
    }

    /// Resets the iterator to the beginning.
    pub func reset(mut this) {
        this._index = 0
    }

    /// Returns the total number of arguments.
    pub func len(this) -> I32 {
        return this._count
    }
}

/// Returns an iterator over the command-line arguments.
///
/// The first argument is conventionally the path to the program executable.
///
/// # Example
///
/// ```tml
/// var args: env::Args = env::args()
/// loop (args.has_next()) {
///     let arg: Str = args.next()
/// }
/// ```
pub func args() -> Args {
    return Args {
        _index: 0,
        _count: os::args_count()
    }
}
