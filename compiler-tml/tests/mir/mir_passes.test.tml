//! Unit tests for MIR optimization passes.
//! Tests the actual logic of each pass via main() to avoid @test framework
//! crash with large struct returns (PassResult = 24 bytes).

use test::assert
use test::assert_eq
use compiler::mir::types::MirType
use compiler::mir::types::MirPrimitive
use compiler::mir::types::ValueId
use compiler::mir::inst::MirInst
use compiler::mir::inst::InstructionData
use compiler::mir::inst::ConstantInst
use compiler::mir::inst::CallInst
use compiler::mir::inst::MirConstant
use compiler::mir::block::BasicBlock
use compiler::mir::block::Terminator
use compiler::mir::block::ReturnTerm
use compiler::mir::block::BranchTerm
use compiler::mir::block::CondBranchTerm
use compiler::mir::block::block_new
use compiler::mir::module::MirModule
use compiler::mir::module::MirFunc
use compiler::mir::module::MirFuncParam
use compiler::mir::module::mir_func_new
use compiler::mir::module::mir_module_new
use compiler::mir::passes::common::PassResult
use compiler::mir::passes::analysis::find_reachable_blocks
use compiler::mir::passes::analysis::compute_successors
use compiler::mir::passes::dce::run_dead_code_elimination
use compiler::mir::passes::dfe::run_dead_function_elimination
use compiler::mir::passes::uce::run_unreachable_code_elimination
use compiler::mir::passes::block_merge::run_block_merge
use compiler::mir::passes::const_fold::run_constant_folding
use compiler::hir::expr::HirBinOp
use compiler::source::loc_new
use compiler::source::span_new
use std::collections::list::List

func test_span() -> compiler::source::SourceSpan {
    let loc = loc_new("<test>", 0, 0, 0, 0)
    return span_new(loc, loc)
}

func emit(bb: BasicBlock, result: I64, ty: MirType, inst: MirInst) {
    bb.instructions.push(InstructionData {
        result: result as ValueId,
        result_type: ty,
        inst: inst,
        span: test_span()
    })
}

func set_terminator(blocks: List[BasicBlock], idx: I64, term: Terminator) {
    var bb: BasicBlock = blocks.get(idx)
    bb.terminator = Just(term)
    blocks.set(idx, bb)
}

func i64t() -> MirType { return MirType::Primitive(MirPrimitive::I64) }

// Single @test that exercises all passes — avoids the framework crash
// that occurs with multiple @test functions returning large structs.
@test func test_all_passes() {
    // 1. Reachable blocks
    let mf1 = mir_func_new("f1", i64t())
    set_terminator(mf1.blocks, 0, Terminator::Branch(BranchTerm { target: 1 }))
    mf1.blocks.push(block_new(1, "bb1"))
    set_terminator(mf1.blocks, 1, Terminator::Return(ReturnTerm { value: Nothing }))
    let reachable = find_reachable_blocks(mf1)
    assert(reachable.has("0"))
    assert(reachable.has("1"))

    // 2. Compute successors
    var bb_s: BasicBlock = block_new(0, "entry")
    bb_s.terminator = Just(Terminator::Branch(BranchTerm { target: 1 }))
    let succs = compute_successors(bb_s)
    assert_eq(succs.len() as I64, 1)

    // 3. DCE
    let mf2 = mir_func_new("f2", i64t())
    let bb2 = mf2.blocks.get(0)
    emit(bb2, 0, i64t(), MirInst::Constant(ConstantInst { value: MirConstant::ConstInt(42) }))
    emit(bb2, 1, i64t(), MirInst::Constant(ConstantInst { value: MirConstant::ConstInt(10) }))
    set_terminator(mf2.blocks, 0, Terminator::Return(ReturnTerm { value: Just(1 as ValueId) }))
    let dce = run_dead_code_elimination(mf2)
    assert(dce.changed > 0)

    // 4. UCE
    let mf3 = mir_func_new("f3", i64t())
    set_terminator(mf3.blocks, 0, Terminator::Return(ReturnTerm { value: Nothing }))
    mf3.blocks.push(block_new(1, "dead"))
    set_terminator(mf3.blocks, 1, Terminator::Return(ReturnTerm { value: Nothing }))
    let uce = run_unreachable_code_elimination(mf3)
    assert(uce.changed > 0)

    // 5. Block merge
    let mf4 = mir_func_new("f4", i64t())
    set_terminator(mf4.blocks, 0, Terminator::Branch(BranchTerm { target: 1 }))
    mf4.blocks.push(block_new(1, "bb1"))
    set_terminator(mf4.blocks, 1, Terminator::Return(ReturnTerm { value: Nothing }))
    let merge = run_block_merge(mf4)
    assert(merge.changed > 0)

    // 6. Constant folding
    let mf5 = mir_func_new("f5", i64t())
    let bb5 = mf5.blocks.get(0)
    emit(bb5, 0, i64t(), MirInst::Constant(ConstantInst { value: MirConstant::ConstInt(3) }))
    emit(bb5, 1, i64t(), MirInst::Constant(ConstantInst { value: MirConstant::ConstInt(4) }))
    emit(bb5, 2, i64t(), MirInst::Binary(compiler::mir::inst::BinaryInst {
        op: HirBinOp::Add, left: 0 as ValueId, right: 1 as ValueId
    }))
    set_terminator(mf5.blocks, 0, Terminator::Return(ReturnTerm { value: Just(2 as ValueId) }))
    let fold = run_constant_folding(mf5)
    assert(fold.changed > 0)
}
