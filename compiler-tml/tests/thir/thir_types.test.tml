//! Self-hosting validation for THIR modules.
//! Phase 15b — items 4.1–4.3, tail 1.2.


use compiler::thir::exhaustiveness::*
use compiler::thir::expr::*
use compiler::thir::lower::*
use compiler::thir::module::{ThirModule, ThirFunction, thir_module_new}
use compiler::thir::pattern::{ThirPattern, thir_pattern_type}
use compiler::thir::stmt::ThirStmt
use compiler::types::ty::{make_i32, make_str}
use std::collections::hashmap::HashMap
use std::collections::list::List
use test
@test
func test_thir_modules_typecheck() -> I32 {
    assert(true)
    return 0
}

@test
func test_thir_module_new() -> I32 {
    let tmod = thir_module_new("test", "test.tml")
    assert_eq(tmod.name, "test")
    assert_eq(tmod.functions.len() as I64, 0)
    return 0
}

@test
func test_exhaustiveness_format() -> I32 {
    let missing: List[Str] = List::new(2)
    missing.push("Just")
    missing.push("Nothing")
    let unreachable: List[I64] = List::new(0)
    let result = ExhaustivenessResult {
        is_exhaustive: 0,
        missing_patterns: missing,
        unreachable_arms: unreachable
    }
    let msg = format_exhaustiveness_error(result)
    assert(msg.len() > 0)
    return 0
}
