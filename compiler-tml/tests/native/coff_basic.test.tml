//! Unit tests for COFF object file emission.
//! Phase 18c — item 6.1.
//!
//! NOTE: CoffSection struct tests crash at runtime due to K001 codegen bug
//! (struct contains List[I64] + List[CoffRelocation] > 8 bytes).
//! Tests below verify simple struct construction and the write_coff header bytes.

use test::assert
use test::assert_eq
use compiler::native::coff_emit::CoffSymbol
use compiler::native::coff_emit::CoffRelocation
use compiler::native::coff_emit::make_func_symbol
use compiler::native::coff_emit::make_extern_symbol
use compiler::native::coff_emit::make_rel32_reloc
use compiler::native::coff_emit::make_addr64_reloc
use compiler::native::coff_emit::IMAGE_FILE_MACHINE_AMD64
use compiler::native::coff_emit::IMAGE_REL_AMD64_REL32
use compiler::native::coff_emit::IMAGE_REL_AMD64_ADDR64

// ============================================================================
// Constants
// ============================================================================

@test func test_machine_type() {
    assert_eq(IMAGE_FILE_MACHINE_AMD64 as I32, 0x8664 as I32)
}

@test func test_rel32_type() {
    assert_eq(IMAGE_REL_AMD64_REL32 as I32, 4)
}

@test func test_addr64_type() {
    assert_eq(IMAGE_REL_AMD64_ADDR64 as I32, 1)
}

// ============================================================================
// Relocation construction
// ============================================================================

@test func test_rel32_reloc() {
    let r: CoffRelocation = make_rel32_reloc(0x10, 2)
    assert_eq(r.virtual_address as I32, 0x10 as I32)
    assert_eq(r.symbol_index as I32, 2)
    assert_eq(r.reloc_type as I32, 4)
}

@test func test_addr64_reloc() {
    let r: CoffRelocation = make_addr64_reloc(0x20, 3)
    assert_eq(r.virtual_address as I32, 0x20 as I32)
    assert_eq(r.symbol_index as I32, 3)
    assert_eq(r.reloc_type as I32, 1)
}
