//! Integration test for ELF — generate ELF .o, parse back, verify data roundtrip.
//! Tests GOT/PLT allocation and ELF exe generation.

use test::{assert, assert_eq}
use compiler::native::elf_emit::*
// parse_elf skipped — crashes due to K001 large struct copy bug in List.set()
use compiler::link::elf::got_plt::*
use compiler::link::elf::elf_writer::*
use std::collections::list::List

@test func test_elf_full_roundtrip() {
    // === Step 1: Generate minimal ELF .o ===
    let text_data = List[I64]::new(8)
    text_data.push(0xB8)
    text_data.push(42)
    text_data.push(0)
    text_data.push(0)
    text_data.push(0)
    text_data.push(0xC3)
    text_data.push(0x90)
    text_data.push(0x90)

    let syms = List[ElfSymbol]::new(1)
    syms.push(ElfSymbol {
        name: "_start",
        value: 0 as I64,
        size: 6 as I64,
        binding: 1 as I64,
        sym_type: 2 as I64,
        section_idx: 1 as I64
    })

    let relocs = List[ElfRelocation]::new(0)
    let elf_bytes: List[I64] = write_elf64_obj(62 as I64, text_data, List[I64]::new(0), syms, relocs)

    // Verify ELF magic
    assert_eq(elf_bytes.get(0) as I32, 0x7F)
    assert_eq(elf_bytes.get(1) as I32, 0x45)
    assert_eq(elf_bytes.get(2) as I32, 0x4C)
    assert_eq(elf_bytes.get(3) as I32, 0x46)

    // Verify machine at offset 18
    let mach: I64 = (elf_bytes.get(18) & 0xFF) | ((elf_bytes.get(19) & 0xFF) << 8)
    assert_eq(mach as I32, 62)

    // Verify type at offset 16
    let etype: I64 = (elf_bytes.get(16) & 0xFF) | ((elf_bytes.get(17) & 0xFF) << 8)
    assert_eq(etype as I32, 1)

    // Verify shnum at offset 60
    let shnum: I64 = (elf_bytes.get(60) & 0xFF) | ((elf_bytes.get(61) & 0xFF) << 8)
    assert_eq(shnum as I32, 7)

    // Verify e_shstrndx at offset 62
    let shstrndx: I64 = (elf_bytes.get(62) & 0xFF) | ((elf_bytes.get(63) & 0xFF) << 8)
    assert_eq(shstrndx as I32, 5)

    // Verify total size is reasonable (header + text + sections + headers)
    assert(elf_bytes.len() as I64 > 500)

    // Verify e_shoff at offset 40 points somewhere reasonable
    let shoff: I64 = (elf_bytes.get(40) & 0xFF) | ((elf_bytes.get(41) & 0xFF) << 8) | ((elf_bytes.get(42) & 0xFF) << 16) | ((elf_bytes.get(43) & 0xFF) << 24)
    assert(shoff > 64)
    assert(shoff < (elf_bytes.len() as I64))

    // Verify total size is enough for 7 section headers (7 * 64 = 448 bytes at shoff)
    assert(elf_bytes.len() as I64 >= shoff + 7 * 64)

    // === Step 2: Parse the ELF header fields directly from bytes ===
    // (full parse_elf crashes due to K001 struct copy bug — verify bytes manually)
    // Verify section header at shoff: first entry should be NULL (all zeros)
    let null_shdr_type: I64 = (elf_bytes.get(shoff + 4) & 0xFF) | ((elf_bytes.get(shoff + 5) & 0xFF) << 8) | ((elf_bytes.get(shoff + 6) & 0xFF) << 16) | ((elf_bytes.get(shoff + 7) & 0xFF) << 24)
    assert_eq(null_shdr_type as I32, 0)  // SHT_NULL

    // Section 1 (.text) type = SHT_PROGBITS (1) at shoff + 64 + 4
    let text_shdr_type: I64 = (elf_bytes.get(shoff + 64 + 4) & 0xFF) | ((elf_bytes.get(shoff + 64 + 5) & 0xFF) << 8) | ((elf_bytes.get(shoff + 64 + 6) & 0xFF) << 16) | ((elf_bytes.get(shoff + 64 + 7) & 0xFF) << 24)
    assert_eq(text_shdr_type as I32, 1)  // SHT_PROGBITS

    // Section 4 (.symtab) type = SHT_SYMTAB (2) at shoff + 4*64 + 4
    let sym_shdr_type: I64 = (elf_bytes.get(shoff + 4 * 64 + 4) & 0xFF) | ((elf_bytes.get(shoff + 4 * 64 + 5) & 0xFF) << 8) | ((elf_bytes.get(shoff + 4 * 64 + 6) & 0xFF) << 16) | ((elf_bytes.get(shoff + 4 * 64 + 7) & 0xFF) << 24)
    assert_eq(sym_shdr_type as I32, 2)  // SHT_SYMTAB

    // === Step 3: GOT ===
    let got: Got = got_new()
    assert_eq(got_size(got) as I32, 24)
    let off1: I64 = got_alloc(got, "puts")
    assert_eq(off1 as I32, 24)
    let off2: I64 = got_alloc(got, "printf")
    assert_eq(off2 as I32, 32)
    assert_eq(got_alloc(got, "puts") as I32, 24)  // dedup

    let got_data: List[I64] = got_emit(got)
    assert_eq(got_data.len() as I32, 40)

    // === Step 4: PLT ===
    let plt: Plt = plt_new()
    let p1: I64 = plt_add(plt, "puts", off1)
    assert_eq(p1 as I32, 16)
    let plt_code: List[I64] = plt_emit(plt, 0x3000 as I64, 0x1000 as I64)
    assert_eq(plt_code.get(0) as I32, 0xFF)
    assert_eq(plt_code.get(1) as I32, 0x35)
    assert_eq(plt_code.get(16) as I32, 0xFF)
    assert_eq(plt_code.get(17) as I32, 0x25)

    // === Step 5: ELF exe writer ===
    let exe_sects = List[ElfOutputSection]::new(1)
    exe_sects.push(ElfOutputSection {
        name: ".text",
        sh_type: 1 as I64,
        flags: 6 as I64,
        data: text_data,
        addr: 0x401000 as I64,
        file_offset: 0x1000 as I64,
        align_val: 16 as I64
    })
    let opts: ElfExeOptions = elf_exe_options_default(0x401000 as I64)
    let exe: List[I64] = write_elf_exe(exe_sects, opts)
    assert_eq(exe.get(0) as I32, 0x7F)
    let exe_type: I64 = (exe.get(16) & 0xFF) | ((exe.get(17) & 0xFF) << 8)
    assert_eq(exe_type as I32, 2)  // ET_EXEC

    // === Step 6: .interp + .dynamic ===
    let interp: List[I64] = build_interp("/lib64/ld-linux-x86-64.so.2")
    assert_eq(interp.get(0) as I32, 0x2F)
    assert_eq(interp.get(interp.len() as I64 - 1) as I32, 0)

    let needed = List[Str]::new(1)
    needed.push("libc.so.6")
    let dyn_data: List[I64] = build_dynamic(needed, 0x402000 as I64, 0x402100 as I64, 0x403000 as I64)
    assert(dyn_data.len() as I64 > 16)
}
