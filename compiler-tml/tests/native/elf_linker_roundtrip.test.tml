//! Full integration test for ELF linker — generates ELF .o via elf_emit,
//! parses it back via elf_parser, tests GOT/PLT generation, writes ELF exe.

use test::{assert, assert_eq}
use compiler::native::elf_emit::*
use compiler::link::elf::elf_parser::*
use compiler::link::elf::got_plt::*
use compiler::link::elf::elf_writer::*
use std::collections::list::List

@test func test_elf_roundtrip_and_exe_generation() {
    // === Step 1: Generate ELF .o using elf_emit ===
    let text_data = List[I64]::new(8)
    text_data.push(0xB8)  // mov eax, 42
    text_data.push(42)
    text_data.push(0)
    text_data.push(0)
    text_data.push(0)
    text_data.push(0xC3)  // ret
    text_data.push(0x90)  // nop
    text_data.push(0x90)  // nop

    let syms = List[ElfSymbol]::new(1)
    syms.push(ElfSymbol {
        name: "_start",
        value: 0 as I64,
        size: 6 as I64,
        binding: 1 as I64,   // STB_GLOBAL
        sym_type: 2 as I64,  // STT_FUNC
        section_idx: 1 as I64
    })

    let relocs = List[ElfRelocation]::new(0)
    let elf_obj: List[I64] = write_elf64_obj(62 as I64, text_data, List[I64]::new(0), syms, relocs)

    // Verify ELF magic
    assert_eq(elf_obj.get(0) as I32, 0x7F)
    assert_eq(elf_obj.get(1) as I32, 0x45)  // 'E'
    assert_eq(elf_obj.get(2) as I32, 0x4C)  // 'L'
    assert_eq(elf_obj.get(3) as I32, 0x46)  // 'F'

    // Verify machine = x86_64 (62) at offset 18
    let machine: I64 = (elf_obj.get(18) & 0xFF) | ((elf_obj.get(19) & 0xFF) << 8)
    assert_eq(machine as I32, 62)

    // Verify type = ET_REL (1) at offset 16
    let elf_type: I64 = (elf_obj.get(16) & 0xFF) | ((elf_obj.get(17) & 0xFF) << 8)
    assert_eq(elf_type as I32, 1)

    // === Step 2: Parse the ELF back ===
    let parsed: ElfObject = parse_elf(elf_obj)
    assert_eq(parsed.machine as I32, 62)
    assert_eq(parsed.elf_type as I32, 1)
    // Should have sections (at least .text + null + strtab + symtab + shstrtab + rela.text)
    assert(parsed.shnum as I64 >= 2)

    // === Step 3: GOT allocation ===
    let got: Got = got_new()
    assert_eq(got.size as I32, 24)  // 3 reserved slots × 8

    let puts_off: I64 = got_alloc(got, "puts")
    assert_eq(puts_off as I32, 24)  // first user slot
    assert_eq(got.size as I32, 32)

    let printf_off: I64 = got_alloc(got, "printf")
    assert_eq(printf_off as I32, 32)
    assert_eq(got.size as I32, 40)

    // Duplicate returns same offset
    assert_eq(got_alloc(got, "puts") as I32, 24)
    assert_eq(got.size as I32, 40)  // no growth

    // GOT emit produces zero-filled buffer
    let got_data: List[I64] = got_emit(got)
    assert_eq(got_data.len() as I32, 40)
    assert_eq(got_data.get(0) as I32, 0)

    // === Step 4: PLT generation ===
    let plt: Plt = plt_new()
    assert_eq(plt.size as I32, 16)  // PLT[0] header

    let plt_puts: I64 = plt_add(plt, "puts", puts_off)
    assert_eq(plt_puts as I32, 16)  // after header
    assert_eq(plt.size as I32, 32)  // header + 1 stub

    let plt_printf: I64 = plt_add(plt, "printf", printf_off)
    assert_eq(plt_printf as I32, 32)
    assert_eq(plt.size as I32, 48)

    // Emit PLT code
    let plt_code: List[I64] = plt_emit(plt, 0x3000 as I64, 0x1000 as I64)
    assert_eq(plt_code.len() as I32, 48)
    // PLT[0] header: FF 35 (push GOT+8)
    assert_eq(plt_code.get(0) as I32, 0xFF)
    assert_eq(plt_code.get(1) as I32, 0x35)
    // PLT[0] cont: FF 25 (jmp GOT+16)
    assert_eq(plt_code.get(6) as I32, 0xFF)
    assert_eq(plt_code.get(7) as I32, 0x25)
    // PLT[1] stub at offset 16: FF 25 (jmp *GOT)
    assert_eq(plt_code.get(16) as I32, 0xFF)
    assert_eq(plt_code.get(17) as I32, 0x25)

    // === Step 5: Write ELF executable ===
    let exe_sects = List[ElfOutputSection]::new(1)
    exe_sects.push(ElfOutputSection {
        name: ".text",
        sh_type: 1 as I64,
        flags: 6 as I64,   // SHF_ALLOC | SHF_EXECINSTR
        data: text_data,
        addr: 0x401000 as I64,
        file_offset: 0x1000 as I64,
        align_val: 16 as I64
    })
    let exe_opts: ElfExeOptions = elf_exe_options_default(0x401000 as I64)
    let elf_exe: List[I64] = write_elf_exe(exe_sects, exe_opts)

    // ELF executable magic
    assert_eq(elf_exe.get(0) as I32, 0x7F)
    assert_eq(elf_exe.get(1) as I32, 0x45)
    // Type = ET_EXEC (2) at offset 16
    let exe_type: I64 = (elf_exe.get(16) & 0xFF) | ((elf_exe.get(17) & 0xFF) << 8)
    assert_eq(exe_type as I32, 2)
    // Machine = x86_64 at offset 18
    let exe_mach: I64 = (elf_exe.get(18) & 0xFF) | ((elf_exe.get(19) & 0xFF) << 8)
    assert_eq(exe_mach as I32, 62)

    // === Step 6: .interp and .dynamic ===
    let interp: List[I64] = build_interp("/lib64/ld-linux-x86-64.so.2")
    assert_eq(interp.get(0) as I32, 0x2F)  // '/'
    assert_eq(interp.get(interp.len() as I64 - 1) as I32, 0)  // null term

    let needed = List[Str]::new(1)
    needed.push("libc.so.6")
    let dyn_data: List[I64] = build_dynamic(needed, 0x402000 as I64, 0x402100 as I64, 0x403000 as I64)
    assert(dyn_data.len() as I64 > 16)
    // First entry: DT_NEEDED (1)
    assert_eq(dyn_data.get(0) as I32, 1)
}
