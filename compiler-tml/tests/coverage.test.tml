// ============================================================================
// Coverage stats — one @test per subsystem
// ============================================================================

@test
func test_coverage_source() -> I32 {
    let loc = loc_new("test.tml", 1, 0, 1, 5)
    let span = span_new(loc, loc)
    assert(true)
    return 0
}

@test
func test_coverage_types() -> I32 {
    assert(types_equal(make_i32(), make_i32()))
    assert(not types_equal(make_i32(), make_str()))
    assert_eq(type_to_str(make_bool()), "Bool")
    let env = env_new()
    register_all_builtins(env)
    return 0
}

@test
func test_coverage_inference() -> I32 {
    let ctx = infer_ctx_new()
    let span = dummy_span()
    let tv = fresh_var(ctx)
    assert(unify(ctx, tv, make_i32(), span))
    assert(types_equal(resolve(ctx, tv), make_i32()))
    assert(not has_errors(ctx))
    return 0
}

@test
func test_coverage_behaviors() -> I32 {
    assert(is_reserved_behavior("Add"))
    assert(is_reserved_behavior("Iterator"))
    assert(not is_reserved_behavior("MyTrait"))
    let env = env_new()
    let reg = registry_new(env)
    let coherence = check_coherence(reg)
    assert_eq(coherence.len() as I64, 0)
    return 0
}

@test
func test_coverage_coercion() -> I32 {
    // I32 → I64 = widen
    let c1 = find_coercion(make_i32(), make_i64())
    when c1 { IntegerWiden => assert(true), _ => assert(false) }
    // I64 → I32 = no coercion (no narrowing)
    let c2 = find_coercion(make_i64(), make_i32())
    when c2 { NoCoercion => assert(true), _ => assert(false) }
    // Same type = no coercion
    let c3 = find_coercion(make_str(), make_str())
    when c3 { NoCoercion => assert(true), _ => assert(false) }
    return 0
}

@test
func test_coverage_operator_desugar() -> I32 {
    let Just(add) = operator_behavior_name("+") else { assert(false); return 1 }
    assert_eq(add, "Add")
    let Just(sub) = operator_behavior_name("-") else { assert(false); return 1 }
    assert_eq(sub, "Sub")
    let none = operator_behavior_name("???")
    when none { Nothing => assert(true), _ => assert(false) }
    return 0
}

@test
func test_coverage_hir() -> I32 {
    let hmod = hir_module_new("test", "test.tml")
    assert_eq(hmod.name, "test")
    let args = List[Type]::new(1)
    args.push(make_i32())
    assert_eq(mangle_name("Vec", args), "Vec_I32")
    return 0
}

@test
func test_coverage_monomorph() -> I32 {
    let q = mono_queue_new()
    let args = List[Type]::new(1)
    args.push(make_i64())
    let mangled = request_mono(q, "List", args)
    assert_eq(mangled, "List_I64")
    return 0
}

@test
func test_coverage_thir() -> I32 {
    let tmod = thir_module_new("test", "test.tml")
    assert_eq(tmod.name, "test")
    assert_eq(tmod.functions.len() as I64, 0)
    return 0
}

@test
func test_coverage_mir() -> I32 {
    let mmod = mir_module_new("test")
    assert_eq(mmod.name, "test")
    let mf = mir_func_new("main", MirType::Primitive(MirPrimitive::I32))
    assert_eq(mf.blocks.len() as I64, 1)
    assert_eq(print_mir_type(MirType::Primitive(MirPrimitive::I64)), "i64")
    return 0
}

@test
func test_coverage_mir_builder() -> I32 {
    let b = mir_builder_new()
    let v1 = fresh_value(b)
    let v2 = fresh_value(b)
    assert_eq(v1, 0)
    assert_eq(v2, 1)
    return 0
}

@test
func test_coverage_mir_passes() -> I32 {
    let pm = pass_manager_new()
    assert_eq(pm.enable_tier0, 1)
    assert_eq(pm.stats.passes_run, 0)

    // Test analysis
    let mf = mir_func_new("f", MirType::Primitive(MirPrimitive::Unit))
    mf.blocks.get(0).terminator = Just(Terminator::Return(compiler::mir::block::ReturnTerm { value: Nothing }))
    let reachable = find_reachable_blocks(mf)
    assert(reachable.has("0"))
    return 0
}

@test
func test_coverage_pipeline() -> I32 {
    let env = env_new()
    let expr_ty = check_expression(env, compiler::ast::exprs::Expr::Literal(
        compiler::ast::exprs::LiteralExpr {
            value: LiteralKind::LitInt(42),
            span: dummy_span()
        }
    ))
    // Should return some type (I32 or Unit depending on resolution)
    assert(true)
    return 0
}
