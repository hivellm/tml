//! Unit tests for call emission, ABI classification, and method dispatch.
//! Consolidated into 3 @test functions to avoid framework crash.

use test::{assert, assert_eq}
use compiler::mir::types::*
use compiler::codegen::emit_call::*
use compiler::codegen::emit_method::*
use compiler::codegen::emit_generic::*
use std::collections::list::List
use core::alloc::heap::Heap

@test func test_abi_and_cc() {
    // ABI: I64 → Register
    let cls1 = abi_class(MirType::Primitive(MirPrimitive::I64), 0)
    when cls1 { Register => assert(true), _ => assert(false) }

    // ABI: F64 → Sse
    let cls2 = abi_class(MirType::Primitive(MirPrimitive::F64), 0)
    when cls2 { Sse => assert(true), _ => assert(false) }

    // CC
    assert_eq(cc_for_func(1), "ccc")
    assert_eq(cc_for_func(0), "fastcc")

    // Win64 detect
    assert_eq(is_win64_triple("x86_64-pc-windows-msvc") as I32, 1)
    assert_eq(is_win64_triple("x86_64-unknown-linux-gnu") as I32, 0)
}

@test func test_mangling() {
    assert_eq(mangle_type_name("Point"), "Point")
    assert_eq(mangle_type_name("List[I32]"), "List_I32")
    assert_eq(mangle_inherent("Point", "distance"), "Point__distance")
    assert_eq(mangle_behavior("I32", "Add", "add"), "I32__Add__add")

    let type_args = List[Str]::new(1)
    type_args.push("I64")
    assert_eq(mangle_generic_func("sort", type_args), "sort_I64")

    assert_eq(mir_type_to_mangle(MirType::Primitive(MirPrimitive::I64)), "I64")
    assert_eq(mir_type_to_mangle(MirType::Primitive(MirPrimitive::Str)), "Str")
}

@test func test_generic_tracking_and_dispatch() {
    let gi: GenericInstantiator = instantiator_new()
    assert_eq(is_instantiated(gi, "List_I64__push") as I32, 0)
    mark_instantiated(gi, "List_I64__push")
    assert_eq(is_instantiated(gi, "List_I64__push") as I32, 1)

    // Inherent call
    let args = List[I64]::new(1)
    args.push(5)
    let ir: Str = emit_inherent_call(10, "i64", "Point", "distance", 3, args, "fastcc")
    assert(ir.contains("@Point__distance"))

    // Try operator
    let ir2: Str = emit_try_operator(20, 15, "%struct.Outcome", "ok_bb", "err_bb")
    assert(ir2.contains("extractvalue %struct.Outcome %15, 0"))
}
