//! Tests for Mach-O linker — parser, code signing, fat binary.

use test::{assert, assert_eq}
use compiler::link::macho::macho_parser::*
use compiler::link::macho::codesign::*
use compiler::link::macho::fat::*
use std::collections::list::List

// --- Mach-O parser ---

@test func test_parse_macho_header() {
    // Build minimal mach_header_64 (32 bytes) + no load commands
    let bytes = List[I64]::new(32)
    // magic = MH_MAGIC_64 (0xFEEDFACF) little-endian
    bytes.push(0xCF)
    bytes.push(0xFA)
    bytes.push(0xED)
    bytes.push(0xFE)
    // cputype = CPU_TYPE_ARM64 (0x0100000C)
    bytes.push(0x0C)
    bytes.push(0x00)
    bytes.push(0x00)
    bytes.push(0x01)
    // cpusubtype = 0
    for _ in 0 to 4 { bytes.push(0) }
    // filetype = MH_OBJECT (1)
    bytes.push(1)
    bytes.push(0)
    bytes.push(0)
    bytes.push(0)
    // ncmds = 0
    for _ in 0 to 4 { bytes.push(0) }
    // sizeofcmds = 0
    for _ in 0 to 4 { bytes.push(0) }
    // flags = 0
    for _ in 0 to 4 { bytes.push(0) }
    // reserved = 0 — wait, mach_header_64 is 32 bytes but we wrote 32 already? Let me check.
    // mach_header_64 = magic(4) + cputype(4) + cpusubtype(4) + filetype(4) + ncmds(4) + sizeofcmds(4) + flags(4) + reserved(4) = 32 bytes

    let obj: MachoObject = parse_macho(bytes)
    assert_eq(obj.magic as I32, 0xFEEDFACF as I32)
    assert_eq(obj.cpu_type as I32, CPU_TYPE_ARM64 as I32)
    assert_eq(obj.file_type as I32, 1)
    assert_eq(obj.ncmds as I32, 0)
}

// --- Code signing ---

@test func test_code_directory() {
    // Create 8KB of fake text data (2 pages)
    let text = List[I64]::new(8192 as I64)
    for _ in 0 to 8192 { text.push(0x90) }  // NOP fill

    let cd: CodeDirectory = compute_code_directory(text, "hello")
    assert_eq(cd.n_code_slots as I32, 2)
    assert_eq(cd.code_limit as I32, 8192)
    assert_eq(cd.hash_type as I32, 2)  // SHA-256
    assert_eq(cd.page_hashes.len() as I32, 2)
    // Each hash is 32 bytes
    assert_eq(cd.page_hashes.get(0).len() as I32, 32)
}

@test func test_signature_blob() {
    let text = List[I64]::new(4096)
    for _ in 0 to 4096 { text.push(0xCC) }

    let cd: CodeDirectory = compute_code_directory(text, "test")
    let blob: List[I64] = build_signature_blob(cd)

    // SuperBlob magic (big-endian): 0xFADE0CC0
    assert_eq(blob.get(0) as I32, 0xFA)
    assert_eq(blob.get(1) as I32, 0xDE)
    assert_eq(blob.get(2) as I32, 0x0C)
    assert_eq(blob.get(3) as I32, 0xC0)
}

@test func test_signature_blob_size() {
    let sz: I64 = signature_blob_size(8192 as I64, 5 as I64)
    // 12 (SuperBlob) + 8 (BlobIndex) + 44 (CD header) + 6 (ident+null) + 2*32 (hashes)
    assert(sz > 100)
}

// --- Fat binary ---

@test func test_fat_binary() {
    let slices = List[FatSlice]::new(2)
    let arm_data = List[I64]::new(4)
    arm_data.push(0xCF)
    arm_data.push(0xFA)
    arm_data.push(0xED)
    arm_data.push(0xFE)
    slices.push(FatSlice { cpu_type: CPU_TYPE_ARM64, cpu_subtype: 0 as I64, data: arm_data })

    let x86_data = List[I64]::new(4)
    x86_data.push(0xCF)
    x86_data.push(0xFA)
    x86_data.push(0xED)
    x86_data.push(0xFE)
    slices.push(FatSlice { cpu_type: CPU_TYPE_X86_64, cpu_subtype: 3 as I64, data: x86_data })

    let fat: List[I64] = write_fat_binary(slices)
    // Fat magic (big-endian): 0xCAFEBABE
    assert_eq(fat.get(0) as I32, 0xCA)
    assert_eq(fat.get(1) as I32, 0xFE)
    assert_eq(fat.get(2) as I32, 0xBA)
    assert_eq(fat.get(3) as I32, 0xBE)
    // nfat_arch = 2
    assert_eq(fat.get(7) as I32, 2)
}
