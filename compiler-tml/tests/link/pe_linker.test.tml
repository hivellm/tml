//! Tests for PE/COFF linker — parser, symbol table, relocations, PE writer, imports.

use test::{assert, assert_eq}
use compiler::link::pe::coff_parser::*
use compiler::link::pe::symbol_table::*
use compiler::link::pe::relocations::*
use compiler::link::pe::pe_writer::*
use compiler::link::pe::import_lib::*
use std::collections::list::List
use std::collections::hashmap::HashMap

// --- Phase 1: COFF parser ---

@test func test_parse_coff_header() {
    // Build a minimal COFF: 20-byte header, 0 sections, 0 symbols
    let bytes = List[I64]::new(20)
    // Machine = AMD64 (0x8664)
    bytes.push(0x64)
    bytes.push(0x86)
    // NumberOfSections = 0
    bytes.push(0)
    bytes.push(0)
    // TimeDateStamp = 0
    for _ in 0 to 4 { bytes.push(0) }
    // PointerToSymbolTable = 20 (right after header)
    bytes.push(20)
    bytes.push(0)
    bytes.push(0)
    bytes.push(0)
    // NumberOfSymbols = 0
    for _ in 0 to 4 { bytes.push(0) }
    // SizeOfOptionalHeader = 0
    bytes.push(0)
    bytes.push(0)
    // Characteristics = 0
    bytes.push(0)
    bytes.push(0)

    let obj: CoffObject = parse_coff(bytes)
    assert_eq(obj.machine as I32, 0x8664 as I32)
    assert_eq(obj.num_sections as I32, 0)
    assert_eq(obj.sections.len() as I32, 0)
    assert_eq(obj.symbols.len() as I32, 0)
}

// --- Phase 2: Symbol table ---

@test func test_symtab_add_and_lookup() {
    let st: LinkerSymbolTable = symtab_new()
    let entry: SymbolEntry = SymbolEntry {
        name: "main",
        section_index: 1 as I64,
        offset: 0 as I64,
        size: 32 as I64,
        is_strong: 1 as I64,
        object_index: 0 as I64,
        is_defined: 1 as I64
    }
    st.symbols.set("main", entry)
    assert_eq(symtab_lookup(st, "main") as I32, 0)
    assert_eq(symtab_lookup(st, "missing") as I32, -1 as I32)
}

@test func test_symtab_duplicate_error() {
    let st: LinkerSymbolTable = symtab_new()
    let e1: SymbolEntry = SymbolEntry { name: "foo", section_index: 1 as I64, offset: 0 as I64, size: 0 as I64, is_strong: 1 as I64, object_index: 0 as I64, is_defined: 1 as I64 }
    let e2: SymbolEntry = SymbolEntry { name: "foo", section_index: 1 as I64, offset: 8 as I64, size: 0 as I64, is_strong: 1 as I64, object_index: 1 as I64, is_defined: 1 as I64 }
    st.symbols.set("foo", e1)
    // Simulate adding second strong definition
    let existing: SymbolEntry = st.symbols.get("foo")
    if existing.is_strong > 0 and e2.is_strong > 0 and existing.is_defined > 0 and e2.is_defined > 0 {
        st.errors.push("duplicate symbol: foo")
    }
    assert_eq(st.errors.len() as I32, 1)
    assert(st.errors.get(0).contains("duplicate"))
}

// --- Phase 3: Relocations ---

@test func test_rel32_write() {
    // Create a section with 8 bytes of data
    let data = List[I64]::new(8)
    for _ in 0 to 8 { data.push(0) }
    // Write a REL32 value manually
    let delta: I64 = -42 as I64
    data.set(4, delta & 0xFF)
    data.set(5, (delta >> 8) & 0xFF)
    data.set(6, (delta >> 16) & 0xFF)
    data.set(7, (delta >> 24) & 0xFF)
    // Verify the written value
    let readback: I64 = (data.get(4) & 0xFF) | ((data.get(5) & 0xFF) << 8) | ((data.get(6) & 0xFF) << 16) | ((data.get(7) & 0xFF) << 24)
    // Sign extend if negative
    assert(readback != 0)
}

// --- Phase 4: PE writer ---

@test func test_pe_dos_magic() {
    let sects = List[PeSection]::new(1)
    let text_data = List[I64]::new(4)
    text_data.push(0xCC)
    text_data.push(0xCC)
    text_data.push(0xCC)
    text_data.push(0xC3)
    sects.push(PeSection {
        name: ".text",
        data: text_data,
        characteristics: IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ,
        rva: 0x1000 as I64,
        file_offset: 0x200 as I64
    })
    let opts: PeOptions = pe_options_console(0x1000 as I64)
    let pe: List[I64] = write_pe(sects, opts)
    // DOS magic: MZ
    assert_eq(pe.get(0) as I32, 0x4D)
    assert_eq(pe.get(1) as I32, 0x5A)
    // PE signature at offset 0x40
    assert_eq(pe.get(0x40) as I32, 0x50)  // 'P'
    assert_eq(pe.get(0x41) as I32, 0x45)  // 'E'
    assert_eq(pe.get(0x42) as I32, 0)
    assert_eq(pe.get(0x43) as I32, 0)
}

@test func test_pe_machine_amd64() {
    let sects = List[PeSection]::new(0)
    let opts: PeOptions = pe_options_console(0 as I64)
    let pe: List[I64] = write_pe(sects, opts)
    // Machine at offset 0x44 (DOS_stub=64 + PE_sig=4 + offset 0)
    assert_eq(pe.get(0x44) as I32, 0x64)
    assert_eq(pe.get(0x45) as I32, 0x86)
}

@test func test_pe_checksum() {
    let sects = List[PeSection]::new(0)
    let opts: PeOptions = pe_options_console(0 as I64)
    let pe: List[I64] = write_pe(sects, opts)
    let cs: I64 = pe_compute_checksum(pe)
    assert(cs > 0)
}

// --- Phase 5: Import library ---

@test func test_import_table() {
    let tbl: ImportTable = import_table_new()
    import_add(tbl, "kernel32.dll", "ExitProcess", 0 as I64)
    import_add(tbl, "kernel32.dll", "GetStdHandle", 0 as I64)
    import_add(tbl, "msvcrt.dll", "puts", 0 as I64)
    assert_eq(tbl.dll_order.len() as I32, 2)
    let k32_entries: List[ImportEntry] = tbl.dlls.get("kernel32.dll")
    assert_eq(k32_entries.len() as I32, 2)
}

@test func test_import_thunk() {
    let thunk: List[I64] = emit_import_thunk(0x3000 as I64, 0x1000 as I64)
    assert_eq(thunk.len() as I32, 6)
    assert_eq(thunk.get(0) as I32, 0xFF)  // JMP opcode
    assert_eq(thunk.get(1) as I32, 0x25)  // ModRM [RIP+disp32]
}
