// ============================================================================
// Substitution tests (generic instantiation)
// ============================================================================

@test
func test_substitute_bare_type_param() -> I32 {
    let subs = HashMap[Str, Type]::new(4)
    subs.set("T", make_i32())
    // Generic("T") is mapped via Named("T", "", []) — bare name match
    let input = make_named_simple("T", "")
    let result = substitute_type(input, subs)
    assert(types_equal(result, make_i32()))
    return 0
}

@test
func test_substitute_nested_type_args() -> I32 {
    let subs = HashMap[Str, Type]::new(4)
    subs.set("T", make_i64())
    // List[T] → List[I64]
    let t_arg = List[Heap[Type]]::new(1)
    t_arg.push(Heap::new(make_named_simple("T", "")))
    let input = make_named("List", "", t_arg)
    let result = substitute_type(input, subs)
    // Result should be List[I64]
    assert_eq(type_to_str(result), "List[I64]")
    return 0
}

// ============================================================================
// Type parameter extraction
// ============================================================================

@test
func test_extract_type_params_simple() -> I32 {
    let type_params = List[Str]::new(1)
    type_params.push("T")
    let subs = HashMap[Str, Type]::new(4)
    // Parameter: T (bare name), Argument: I32
    extract_type_params(make_named_simple("T", ""), make_i32(), type_params, subs)
    assert(subs.has("T"))
    assert(types_equal(subs.get("T"), make_i32()))
    return 0
}

@test
func test_extract_type_params_nested() -> I32 {
    let type_params = List[Str]::new(1)
    type_params.push("T")
    let subs = HashMap[Str, Type]::new(4)
    // Parameter: List[T], Argument: List[Str]
    let param_args = List[Heap[Type]]::new(1)
    param_args.push(Heap::new(make_named_simple("T", "")))
    let param = make_named("List", "", param_args)
    let arg_args = List[Heap[Type]]::new(1)
    arg_args.push(Heap::new(make_str()))
    let arg = make_named("List", "", arg_args)
    extract_type_params(param, arg, type_params, subs)
    assert(subs.has("T"))
    assert(types_equal(subs.get("T"), make_str()))
    return 0
}

// ============================================================================
// Operator desugaring
// ============================================================================

@test
func test_operator_behavior_mapping() -> I32 {
    let Just(add) = operator_behavior_name("+") else { assert(false); return 1 }
    assert_eq(add, "Add")
    let Just(sub) = operator_behavior_name("-") else { assert(false); return 1 }
    assert_eq(sub, "Sub")
    let Just(mul) = operator_behavior_name("*") else { assert(false); return 1 }
    assert_eq(mul, "Mul")
    assert_eq(operator_method_name("+"), "add")
    assert_eq(operator_method_name("-"), "sub")
    return 0
}

// ============================================================================
// Exhaustiveness checking
// ============================================================================

@test
func test_exhaustiveness_with_wildcard() -> I32 {
    let ctx = infer_ctx_new()
    let env = env_new()
    let span = dummy_span()

    // A wildcard pattern always makes the match exhaustive
    let patterns = List[Pattern]::new(1)
    patterns.push(Pattern::Wildcard(span))
    let missing = check_exhaustiveness(ctx, env, make_i32(), patterns, span)
    assert_eq(missing.len() as I64, 0)
    return 0
}

@test
func test_exhaustiveness_with_ident() -> I32 {
    let ctx = infer_ctx_new()
    let env = env_new()
    let span = dummy_span()

    // An ident pattern is a catch-all
    let patterns = List[Pattern]::new(1)
    let ip = compiler::ast::nodes::IdentPattern { name: "x", subpat: Nothing, span: span }
    patterns.push(Pattern::Ident(ip))
    let missing = check_exhaustiveness(ctx, env, make_str(), patterns, span)
    assert_eq(missing.len() as I64, 0)
    return 0
}

// ============================================================================
// get_type_name helper
// ============================================================================

@test
func test_get_type_name() -> I32 {
    assert_eq(get_type_name(make_i32()), "I32")
    assert_eq(get_type_name(make_str()), "Str")
    assert_eq(get_type_name(make_named_simple("Point", "")), "Point")
    assert_eq(get_type_name(make_ref(make_i32(), 0)), "")
    return 0
}

// ============================================================================
// Integration: unify + resolve chain
// ============================================================================

@test
func test_infer_chain_resolution() -> I32 {
    let ctx = infer_ctx_new()
    let span = dummy_span()

    // Simulate: let x = 42 (I32), let y = x, then resolve y
    let tv_x = fresh_var(ctx)
    let tv_y = fresh_var(ctx)
    assert(unify(ctx, tv_x, make_i32(), span))
    assert(unify(ctx, tv_y, tv_x, span))
    let resolved = resolve(ctx, tv_y)
    assert(types_equal(resolved, make_i32()))
    return 0
}

@test
func test_generic_enum_instantiation() -> I32 {
    let ctx = infer_ctx_new()
    let env = env_new()
    let span = dummy_span()

    // Register Maybe[T] enum with Just(T) and Nothing variants
    let type_params = List[Str]::new(1)
    type_params.push("T")
    let just_payload = List[Heap[Type]]::new(1)
    just_payload.push(Heap::new(make_named_simple("T", "")))
    let just_variant = EnumVariantDef { name: "Just", payload_types: just_payload }
    let nothing_payload = List[Heap[Type]]::new(0)
    let nothing_variant = EnumVariantDef { name: "Nothing", payload_types: nothing_payload }
    let variants = List[EnumVariantDef]::new(2)
    variants.push(just_variant)
    variants.push(nothing_variant)
    let const_params = List[ConstGenericParam]::new(0)
    let edef = EnumDef {
        name: "Maybe",
        type_params: type_params,
        const_params: const_params,
        variants: variants,
        span: span,
        is_flags: 0
    }
    env_register_enum(env, "Maybe", edef)

    // Simulate calling Just(42): extract T=I32 from payload
    let subs = HashMap[Str, Type]::new(4)
    let tp = List[Str]::new(1)
    tp.push("T")
    extract_type_params(make_named_simple("T", ""), make_i32(), tp, subs)
    assert(subs.has("T"))
    assert(types_equal(subs.get("T"), make_i32()))

    // Build Maybe[I32]
    let type_args = List[Heap[Type]]::new(1)
    type_args.push(Heap::new(subs.get("T")))
    let maybe_i32 = make_named("Maybe", "", type_args)
    assert_eq(type_to_str(maybe_i32), "Maybe[I32]")
    return 0
}
