//! Simple TypeEnv test — just create and register primitives.


use compiler::types::env::*
use compiler::types::ty::*
use test
@test
func test_env_register_lookup() -> I32 {
    let env: TypeEnv = env_new()
    env_register_builtin(env, "I32", make_i32())
    env_register_builtin(env, "Str", make_str())
    let result: Maybe[Type] = env_lookup_type(env, "I32")
    when result {
        Just(t) => {
            assert(is_primitive(t))
            assert_eq(type_to_str(t), "I32")
            return 0
        },
        Nothing => return 1
    }
}
