//! Minimal test to isolate crash in unify tests.


use compiler::types::infer::unify::{InferCtx, infer_ctx_new}
use compiler::types::ty::*
use test
@test
func test_just_ctx_new() -> I32 {
    let ctx = infer_ctx_new()
    assert_eq(ctx.var_counter.get(0), 0)
    return 0
}

@test
func test_just_make_i32() -> I32 {
    let t = make_i32()
    when t {
        Type::Primitive(p) => {
            assert(prim_kind_eq(p.kind, PrimitiveKind::KindI32))
        },
        _ => assert_true(false)
    }
    return 0
}
