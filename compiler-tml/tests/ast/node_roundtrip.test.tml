// Phase 5 — Token tag roundtrip (full TokenKind reconstruction).
//
// Exercises `token_kind_to_tag` (forward) and `tag_to_token_kind` (reverse)
// for the 139-variant TokenKind enum. Previously limited to tag-only tests
// because the 139-arm `tag_to_token_kind` dispatch caused codegen timeouts
// (C1/C5); resolved by phase0p Phase 3 (switch codegen) and Phase 4
// (enum-as-I64 zext fix in AST codegen path).
//
// Note: full `write_token` / `read_token` binary serialization round-trip
// requires resolution of the SourceSpan vs TmlSourceSpan type alias issue
// (the serial C++ runtime defines TmlSourceSpan while compiler::source
// defines SourceSpan — nominally different types with identical layout).
// That is tracked separately; tag-level round-trip is sufficient to verify
// the C1/C2/C5 fixes.


use compiler::serial::reader::BinaryReader
use compiler::serial::writer::BinaryWriter
use compiler::token::{TokenKind, token_kind_to_tag, tag_to_token_kind}
use test
@test
func test_token_kind_tag_stable() -> I32 {
    assert_eq(token_kind_to_tag(TokenKind::Eof), 0)
    assert_eq(token_kind_to_tag(TokenKind::IntLiteral), 1)
    assert_eq(token_kind_to_tag(TokenKind::Identifier), 13)
    assert_eq(token_kind_to_tag(TokenKind::KwFunc), 14)
    assert_eq(token_kind_to_tag(TokenKind::ModuleDocComment), 138)
    return 0
}

@test
func test_tag_to_token_kind_roundtrip() -> I32 {
    // Verify roundtrip: tag → kind → tag produces the same value.
    when tag_to_token_kind(0) {
        Just(k) => assert_eq(token_kind_to_tag(k), 0),
        Nothing => assert_true(false)
    }
    when tag_to_token_kind(14) {
        Just(k) => assert_eq(token_kind_to_tag(k), 14),
        Nothing => assert_true(false)
    }
    when tag_to_token_kind(138) {
        Just(k) => assert_eq(token_kind_to_tag(k), 138),
        Nothing => assert_true(false)
    }

    // Boundary: tag 1 (IntLiteral) and tag 137 (DocComment).
    when tag_to_token_kind(1) {
        Just(k) => assert_eq(token_kind_to_tag(k), 1),
        Nothing => assert_true(false)
    }
    when tag_to_token_kind(137) {
        Just(k) => assert_eq(token_kind_to_tag(k), 137),
        Nothing => assert_true(false)
    }

    // Out-of-range: negative and too-large tags return Nothing.
    when tag_to_token_kind(999) {
        Just(_) => assert_true(false),
        Nothing => assert_true(true)
    }
    when tag_to_token_kind(-1) {
        Just(_) => assert_true(false),
        Nothing => assert_true(true)
    }

    return 0
}

@test
func test_token_tag_varint_roundtrip() -> I32 {
    let w = BinaryWriter::new(32)
    w.write_varint(token_kind_to_tag(TokenKind::KwFunc))
    w.write_varint(token_kind_to_tag(TokenKind::Identifier))
    w.write_varint(token_kind_to_tag(TokenKind::ModuleDocComment))
    let buf = w.finish()
    buf.reset_read()
    let r = BinaryReader::from_buf(buf)
    assert_eq(r.read_varint()!, 14)
    assert_eq(r.read_varint()!, 13)
    assert_eq(r.read_varint()!, 138)
    assert_true(r.is_exhausted())
    r.destroy()
    return 0
}

@test
func test_tag_to_token_kind_full_range() -> I32 {
    // Verify every valid tag (0..138) round-trips correctly.
    var tag: I64 = 0
    loop (tag <= 138) {
        when tag_to_token_kind(tag) {
            Just(k) => assert_eq(token_kind_to_tag(k), tag),
            Nothing => {
                // Every tag in 0..138 should be valid.
                assert_true(false)
            }
        }
        tag = tag + 1
    }
    // Tag 139 should be out of range.
    when tag_to_token_kind(139) {
        Just(_) => assert_true(false),
        Nothing => assert_true(true)
    }
    return 0
}
