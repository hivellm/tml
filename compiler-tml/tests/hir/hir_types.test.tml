use compiler::hir::builder::*
use compiler::hir::expr::*
use compiler::hir::lower_expr::{lower_full_expr, lower_binary, lower_closure}
use compiler::hir::module::*
use compiler::hir::monomorph::*
use compiler::hir::pattern::*
use compiler::hir::printer::{print_module, print_function, print_binop}
use compiler::hir::stmt::{HirStmt, HirLetStmt, HirExprStmt}
use compiler::types::env::env_new
use compiler::types::ty::*
use std::collections::list::List
use test
@test
func test_hir_modules_typecheck() -> I32 {
    // If we reach here, all 9 HIR modules type-check successfully.
    assert(true)
    return 0
}

@test
func test_mangle_name_no_args() -> I32 {
    let args = List[Type]::new(0)
    assert_eq(mangle_name("foo", args), "foo")
    return 0
}

@test
func test_mangle_name_with_args() -> I32 {
    let args = List[Type]::new(1)
    args.push(make_i32())
    assert_eq(mangle_name("List", args), "List_I32")
    return 0
}

@test
func test_mangle_method_name() -> I32 {
    assert_eq(mangle_method("Point", "distance"), "Point_distance")
    assert_eq(mangle_impl_method("I32", "Display", "fmt"), "I32_Display_fmt")
    return 0
}

@test
func test_hir_module_new() -> I32 {
    let hmod = hir_module_new("test", "test.tml")
    assert_eq(hmod.name, "test")
    assert_eq(hmod.source_path, "test.tml")
    assert_eq(hmod.functions.len() as I64, 0)
    assert_eq(hmod.structs.len() as I64, 0)
    return 0
}

@test
func test_mono_queue() -> I32 {
    let q = mono_queue_new()
    assert(not has_pending(q))
    let args = List[Type]::new(1)
    args.push(make_i32())
    let mangled = request_mono(q, "Vec", args)
    assert_eq(mangled, "Vec_I32")
    assert(has_pending(q))
    return 0
}

@test
func test_print_binop() -> I32 {
    assert_eq(print_binop(HirBinOp::Add), "+")
    assert_eq(print_binop(HirBinOp::Eq), "==")
    assert_eq(print_binop(HirBinOp::And), "and")
    return 0
}
