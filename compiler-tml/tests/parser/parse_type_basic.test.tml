//! Minimal parse_type test — check that parse_type compiles and runs.

use test
use compiler::lexer::lexer::tokenize
use compiler::parser::parse_type::parse_type

@test
func test_parse_type_simple() -> I32 {
    let tokens = tokenize("I32", "test.tml")
    let result = parse_type(tokens, 0)
    when result {
        Ok(_) => return 0,
        Err(_) => return 1
    }
}

@test
func test_parse_type_generic() -> I32 {
    let tokens = tokenize("List[I32]", "test.tml")
    let result = parse_type(tokens, 0)
    when result {
        Ok(_) => return 0,
        Err(_) => return 1
    }
}
