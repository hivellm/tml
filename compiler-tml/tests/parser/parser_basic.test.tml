//! Basic parser tests — parse TML source and verify AST structure.
//!
//! These tests tokenize source code using the lexer and then parse it
//! with `parse_module`. They verify that the parser returns `Ok` for
//! valid input and the correct number of top-level declarations.


// ============================================================================
// Empty / trivial inputs
// ============================================================================

use compiler::ast::decls::Decl
use compiler::lexer::lexer::tokenize
use compiler::parser::parse_module::parse_module
use test
@test
func test_parse_empty() -> I32 {
    let tokens = tokenize("", "test.tml")
    let result = parse_module(tokens, "test")
    let Ok(m) = result else { return 1 }
    assert_eq(m.decls.len() as I64, 0)
    return 0
}

@test
func test_parse_only_newlines() -> I32 {
    let tokens = tokenize("\n\n\n", "test.tml")
    let result = parse_module(tokens, "test")
    let Ok(m) = result else { return 1 }
    assert_eq(m.decls.len() as I64, 0)
    return 0
}

// ============================================================================
// Use declarations
// ============================================================================

@test
func test_parse_use_decl() -> I32 {
    let src = "use std::io::print"
    let tokens = tokenize(src, "test.tml")
    let result = parse_module(tokens, "test")
    let Ok(m) = result else { return 1 }
    assert_eq(m.decls.len() as I64, 1)
    return 0
}

@test
func test_parse_multiple_use_decls() -> I32 {
    let src = "use std::io::print\nuse core::alloc::heap::Heap\nuse std::collections::list::List"
    let tokens = tokenize(src, "test.tml")
    let result = parse_module(tokens, "test")
    let Ok(m) = result else { return 1 }
    assert_eq(m.decls.len() as I64, 3)
    return 0
}

@test
func test_parse_use_with_alias() -> I32 {
    let src = "use std::io::File as IoFile"
    let tokens = tokenize(src, "test.tml")
    let result = parse_module(tokens, "test")
    let Ok(m) = result else { return 1 }
    assert_eq(m.decls.len() as I64, 1)
    return 0
}

