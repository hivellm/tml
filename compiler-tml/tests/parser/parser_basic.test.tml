// ============================================================================
// Multiple declarations
// ============================================================================

@test
func test_parse_multiple_decls() -> I32 {
    let src = "use std::io::print\ntype Point { x: I32, y: I32 }\nfunc origin() -> Point { return Point { x: 0, y: 0 } }"
    let tokens = tokenize(src, "test.tml")
    let result = parse_module(tokens, "test")
    let Ok(m) = result else { return 1 }
    assert_eq(m.decls.len() as I64, 3)
    return 0
}

// ============================================================================
// Error cases
// ============================================================================

@test
func test_parse_error_unexpected_token() -> I32 {
    let src = "}"  // unexpected token at top level
    let tokens = tokenize(src, "test.tml")
    let result = parse_module(tokens, "test")
    when result {
        Err(_) => return 0,
        Ok(_) => return 1  // should have failed
    }
}

@test
func test_parse_error_incomplete_func() -> I32 {
    let src = "func"  // incomplete — no name
    let tokens = tokenize(src, "test.tml")
    let result = parse_module(tokens, "test")
    when result {
        Err(_) => return 0,
        Ok(_) => return 1
    }
}
