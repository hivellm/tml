//! Tests for parser/parse_decl, parse_expr, parse_pattern, parse_stmt —
//! tokenize real TML source and run each parser entry point.
//! Also covers codegen/runtime_decls.

use test::{assert, assert_eq}
use compiler::lexer::lexer::tokenize
use compiler::parser::parse_expr::parse_expr
use compiler::parser::parse_stmt::parse_stmt
use compiler::parser::parse_pattern::parse_pattern
use compiler::parser::parse_decl::parse_decl
use compiler::codegen::runtime_decls::*
use std::collections::hashmap::HashMap

@test func test_parse_int_literal() {
    let tokens = tokenize("42", "test.tml")
    let result = parse_expr(tokens, 0 as I64)
    when result { Ok(r) => assert(r.pos as I64 > 0), Err(_) => assert(false) }
}

@test func test_parse_string_literal() {
    let tokens = tokenize("\"hello\"", "test.tml")
    let result = parse_expr(tokens, 0 as I64)
    when result { Ok(_) => assert(true), Err(_) => assert(false) }
}

@test func test_parse_binary_expr() {
    let tokens = tokenize("1 + 2", "test.tml")
    let result = parse_expr(tokens, 0 as I64)
    when result { Ok(r) => assert(r.pos as I64 > 1), Err(_) => assert(false) }
}

@test func test_parse_let_stmt() {
    let tokens = tokenize("let x: I64 = 42", "test.tml")
    let result = parse_stmt(tokens, 0 as I64)
    when result { Ok(r) => assert(r.pos as I64 > 0), Err(_) => assert(false) }
}

@test func test_parse_var_stmt() {
    let tokens = tokenize("var count: I64 = 0", "test.tml")
    let result = parse_stmt(tokens, 0 as I64)
    when result { Ok(r) => assert(r.pos as I64 > 0), Err(_) => assert(false) }
}

@test func test_parse_wildcard_pattern() {
    let tokens = tokenize("_", "test.tml")
    let result = parse_pattern(tokens, 0 as I64)
    when result { Ok(_) => assert(true), Err(_) => assert(false) }
}

@test func test_parse_ident_pattern() {
    let tokens = tokenize("x", "test.tml")
    let result = parse_pattern(tokens, 0 as I64)
    when result { Ok(_) => assert(true), Err(_) => assert(false) }
}

@test func test_parse_func_decl() {
    let src: Str = "func add(a: I64, b: I64) -> I64 { return a + b }"
    let tokens = tokenize(src, "test.tml")
    let result = parse_decl(tokens, 0 as I64)
    when result { Ok(r) => assert(r.pos as I64 > 5), Err(_) => assert(false) }
}

@test func test_runtime_registry_has_entries() {
    let reg: HashMap[Str, RuntimeFunc] = build_runtime_registry()
    assert(reg.len() as I64 > 0)
}

@test func test_emit_runtime_decls_minimal() {
    let used = HashMap[Str, I64]::new(4)
    let ir: Str = emit_runtime_decls(used)
    assert(ir.len() as I64 >= 0)
}
