//! Minimal test to isolate parse_type_path codegen issue.

use test
use compiler::lexer::lexer::tokenize
use compiler::parser::parse_type::parse_type_path

@test
func test_parse_path_simple() -> I32 {
    let tokens = tokenize("I32", "test.tml")
    let result = parse_type_path(tokens, 0)
    when result {
        Ok(_) => return 0,
        Err(_) => return 1
    }
}
