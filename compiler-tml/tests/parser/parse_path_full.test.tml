//! Test parse_type_path_full (returns tuple).

use test
use compiler::lexer::lexer::tokenize
use compiler::ast::nodes::TypePath
use compiler::parser::parse_type::parse_type_path_full

@test
func test_parse_path_full() -> I32 {
    let tokens = tokenize("I32", "test.tml")
    let result = parse_type_path_full(tokens, 0)
    when result {
        Ok(_) => return 0,
        Err(_) => return 1
    }
}
