//! Let statement codegen — destructuring let and let-else patterns.
//!
//! Handles `let` statement forms that are lowered to MIR but require
//! specific codegen patterns:
//! - `let (a, b) = pair` → GEP to tuple elements
//! - `let Foo { x, y } = val` → GEP to named fields
//! - `let Just(x) = expr else { ... }` → discriminant check + conditional branch
//!
//! Phase 16d — items 5.1–5.3.

use compiler::codegen::emit_inst::{reg, block_label}
use std::collections::list::List
use core::alloc::heap::Heap

// ============================================================================
// Destructuring let (item 5.2)
// ============================================================================

/// Emit tuple destructuring: `let (a, b) = pair`.
/// Generates extractvalue for each element.
pub func emit_tuple_destruct(
    result_base: I64,
    tuple_val: I64,
    tuple_ty: Str,
    element_count: I64
) -> Str {
    var s: Str = ""
    for i in 0 to element_count {
        let r: Str = reg(result_base + i)
        s = s + "  " + r + " = extractvalue " + tuple_ty + " " + reg(tuple_val) + ", " + i.to_string() + "\n"
    }
    return s
}

/// Emit struct field destructuring: `let Foo { x, y } = val`.
/// Loads each named field from the struct pointer.
pub func emit_struct_destruct(
    result_base: I64,
    struct_ptr: I64,
    struct_ty: Str,
    field_count: I64,
    field_types: List[Str]
) -> Str {
    var s: Str = ""
    for i in 0 to field_count {
        let gep_reg: Str = reg(result_base + i * 2)
        let load_reg: Str = reg(result_base + i * 2 + 1)
        let ft: Str = field_types.get(i)
        s = s + "  " + gep_reg + " = getelementptr inbounds " + struct_ty + ", ptr " + reg(struct_ptr) + ", i32 0, i32 " + i.to_string() + "\n"
        s = s + "  " + load_reg + " = load " + ft + ", ptr " + gep_reg + "\n"
    }
    return s
}

// ============================================================================
// Let-else (item 5.3)
// ============================================================================

/// Emit let-else pattern: `let Just(x) = expr else { ... }`.
///
/// ```llvm
/// %disc = extractvalue %struct.Maybe %val, 0
/// %is_nothing = icmp eq i32 %disc, 1  ; Nothing variant
/// br i1 %is_nothing, label %else_bb, label %ok_bb
/// ok_bb:
///   %payload = extractvalue %struct.Maybe %val, 1
///   ; ... continue with x = payload
/// else_bb:
///   ; ... else block
/// ```
pub func emit_let_else(
    result_base: I64,
    enum_val: I64,
    enum_ty: Str,
    expected_variant: I64,
    ok_bb: Str,
    else_bb: Str
) -> Str {
    let disc_reg: Str = reg(result_base)
    let cmp_reg: Str = reg(result_base + 1)

    var s: Str = ""
    s = s + "  " + disc_reg + " = extractvalue " + enum_ty + " " + reg(enum_val) + ", 0\n"
    s = s + "  " + cmp_reg + " = icmp ne i32 " + disc_reg + ", " + expected_variant.to_string() + "\n"
    s = s + "  br i1 " + cmp_reg + ", label %" + else_bb + ", label %" + ok_bb + "\n"
    return s
}

/// Emit payload extraction after let-else succeeds.
pub func emit_let_else_payload(result: I64, enum_val: I64, enum_ty: Str) -> Str {
    return "  " + reg(result) + " = extractvalue " + enum_ty + " " + reg(enum_val) + ", 1\n"
}

// ============================================================================
// Nested enum pattern (phase 30f item 1.2)
// ============================================================================

/// Emit nested enum destructuring: `let Just(Just(x)) = v else { ... }`.
/// After outer let-else succeeds, extract inner payload and recurse.
pub func emit_nested_enum_destruct(
    result_base: I64,
    outer_payload: I64,
    inner_enum_ty: Str,
    inner_expected_variant: I64,
    ok_bb: Str,
    else_bb: Str
) -> Str {
    // Same as let-else but on the inner payload
    return emit_let_else(result_base, outer_payload, inner_enum_ty, inner_expected_variant, ok_bb, else_bb)
}

// ============================================================================
// Guard pattern (phase 30f item 1.3)
// ============================================================================

/// Emit guard condition after pattern bindings: `let x if x > 0 = expr else { ... }`.
/// The guard expression result (i1) determines whether to continue or branch to else.
pub func emit_guard_check(
    guard_val: I64,
    ok_bb: Str,
    else_bb: Str
) -> Str {
    return "  br i1 " + reg(guard_val) + ", label %" + ok_bb + ", label %" + else_bb + "\n"
}

// ============================================================================
// Or-pattern (phase 30f item 1.4)
// ============================================================================

/// Emit or-pattern: `let A | B = v else { ... }`.
/// Try first alternative; if discriminant doesn't match, try second.
pub func emit_or_pattern(
    result_base: I64,
    enum_val: I64,
    enum_ty: Str,
    variant_a: I64,
    variant_b: I64,
    ok_bb: Str,
    else_bb: Str
) -> Str {
    let disc_reg: Str = reg(result_base)
    let cmp_a: Str = reg(result_base + 1)
    let cmp_b: Str = reg(result_base + 2)
    let try_b_bb: Str = "try_b_" + result_base.to_string()

    var s: Str = ""
    s = s + "  " + disc_reg + " = extractvalue " + enum_ty + " " + reg(enum_val) + ", 0\n"
    // Try variant A
    s = s + "  " + cmp_a + " = icmp eq i32 " + disc_reg + ", " + variant_a.to_string() + "\n"
    s = s + "  br i1 " + cmp_a + ", label %" + ok_bb + ", label %" + try_b_bb + "\n"
    // Try variant B
    s = s + try_b_bb + ":\n"
    s = s + "  " + cmp_b + " = icmp eq i32 " + disc_reg + ", " + variant_b.to_string() + "\n"
    s = s + "  br i1 " + cmp_b + ", label %" + ok_bb + ", label %" + else_bb + "\n"
    return s
}

// ============================================================================
// Nested struct pattern (phase 30f item 1.5)
// ============================================================================

/// Emit nested struct destructuring from a pointer.
/// Each field sub-pattern loads the field value via GEP from the source pointer.
/// This is the recursive version that works on struct-within-struct patterns.
pub func emit_nested_struct_destruct(
    result_base: I64,
    src_ptr: I64,
    outer_struct_ty: Str,
    outer_field_index: I64,
    inner_struct_ty: Str,
    inner_field_count: I64,
    inner_field_types: List[Str]
) -> Str {
    var s: Str = ""
    // GEP to the outer field (which is the inner struct)
    let outer_gep: Str = reg(result_base)
    s = s + "  " + outer_gep + " = getelementptr inbounds " + outer_struct_ty + ", ptr " + reg(src_ptr) + ", i32 0, i32 " + outer_field_index.to_string() + "\n"

    // Now destructure the inner struct from the field pointer
    for i in 0 to inner_field_count {
        let gep_reg: Str = reg(result_base + 1 + i * 2)
        let load_reg: Str = reg(result_base + 1 + i * 2 + 1)
        let ft: Str = inner_field_types.get(i)
        s = s + "  " + gep_reg + " = getelementptr inbounds " + inner_struct_ty + ", ptr " + outer_gep + ", i32 0, i32 " + i.to_string() + "\n"
        s = s + "  " + load_reg + " = load " + ft + ", ptr " + gep_reg + "\n"
    }
    return s
}
