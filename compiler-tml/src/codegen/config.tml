//! Codegen configuration — target triple, data layout, optimization level.
//!
//! `CodegenConfig` carries all target-specific and build-specific settings
//! needed by the LLVM IR emitter. It is constructed once per compilation
//! unit and threaded through every emission function.
//!
//! Phase 16a — item 1.3.

/// Optimization level for codegen.
@repr(U8)
pub enum OptLevel {
    O0,
    O1,
    O2,
    O3
}

/// Codegen configuration for a single compilation unit.
pub type CodegenConfig {
    /// LLVM target triple, e.g. `"x86_64-pc-windows-msvc"`.
    target_triple: Str,

    /// LLVM data layout string, e.g. `"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-..."`.
    data_layout: Str,

    /// Optimization level.
    opt_level: OptLevel,

    /// Whether this is a release build (enables `dllexport`, strips debug).
    is_release: I64,

    /// Whether to emit `dllexport` on public functions (Windows DLL builds).
    dll_export: I64,

    /// Module source filename for the `source_filename` directive.
    source_filename: Str
}

/// Create a default x86_64 Windows MSVC config at O0.
pub func default_config(source_filename: Str) -> CodegenConfig {
    return CodegenConfig {
        target_triple: "x86_64-pc-windows-msvc",
        data_layout: "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
        opt_level: OptLevel::O0,
        is_release: 0,
        dll_export: 0,
        source_filename: source_filename
    }
}

/// Create a default x86_64 Linux config at O0.
pub func linux_config(source_filename: Str) -> CodegenConfig {
    return CodegenConfig {
        target_triple: "x86_64-unknown-linux-gnu",
        data_layout: "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
        opt_level: OptLevel::O0,
        is_release: 0,
        dll_export: 0,
        source_filename: source_filename
    }
}
