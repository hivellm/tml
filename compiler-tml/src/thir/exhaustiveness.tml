//! Pattern exhaustiveness checker for THIR.
//!
//! Verifies that `when` expressions cover all possible values.
//! Uses the same approach as the phase14c checker but operates on
//! ThirPattern nodes with fully-resolved types.
//!
//! Phase 15b — items 3.1–3.4.

use compiler::source::SourceSpan
use compiler::types::ty::{Type, type_to_str}
use compiler::types::env::{TypeEnv, EnumDef, env_lookup_enum}
use compiler::thir::expr::*
use compiler::thir::pattern::ThirPattern
use compiler::types::checker::check_call::get_type_name
use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

// ============================================================================
// Exhaustiveness result
// ============================================================================

/// Result of exhaustiveness checking for a when expression.
pub type ExhaustivenessResult {
    is_exhaustive: I64,
    missing_patterns: List[Str],
    unreachable_arms: List[I64]
}

// ============================================================================
// Main entry point (item 3.2)
// ============================================================================

/// Check exhaustiveness of a when expression.
pub func check_when_exhaustiveness(
    env: TypeEnv,
    scrutinee_ty: Type,
    arms: List[ThirWhenArm]
) -> ExhaustivenessResult {
    let missing: List[Str] = List::new(4)
    let unreachable: List[I64] = List::new(4)

    let arm_count: I64 = arms.len() as I64

    // Check for wildcard/binding catch-all (item 3.3)
    for i in 0 to arm_count {
        let arm = arms.get(i)
        if is_catchall_pattern(arm.pattern.get()) {
            // Everything after a catch-all is unreachable
            for j in (i + 1) to arm_count {
                unreachable.push(j)
            }
            return ExhaustivenessResult {
                is_exhaustive: 1,
                missing_patterns: missing,
                unreachable_arms: unreachable
            }
        }
    }

    // Check enum exhaustiveness (item 3.3)
    let type_name = get_type_name(scrutinee_ty)
    if type_name != "" {
        let enum_r = env_lookup_enum(env, type_name)
        when enum_r {
            Just(edef) => {
                let covered: HashMap[Str, I64] = HashMap::new(8)
                for i in 0 to arm_count {
                    let vname = extract_thir_variant_name(arms.get(i).pattern.get())
                    if vname != "" {
                        covered.set(vname, 1)
                    }
                }
                let vc: I64 = edef.variants.len() as I64
                for i in 0 to vc {
                    let variant = edef.variants.get(i)
                    if not covered.has(variant.name) {
                        missing.push(variant.name)
                    }
                }
            },
            Nothing => {
                // Not an enum — require wildcard for exhaustiveness
                missing.push("_")
            }
        }
    } else {
        missing.push("_")
    }

    return ExhaustivenessResult {
        is_exhaustive: if missing.len() as I64 == 0 { 1 } else { 0 },
        missing_patterns: missing,
        unreachable_arms: unreachable
    }
}

// ============================================================================
// Pattern analysis helpers
// ============================================================================

/// Check if a pattern is a catch-all (wildcard or binding).
func is_catchall_pattern(pat: ThirPattern) -> Bool {
    when pat {
        Wildcard(_) => return true,
        Binding(_) => return true,
        _ => return false
    }
}

/// Extract the variant name from an enum pattern.
func extract_thir_variant_name(pat: ThirPattern) -> Str {
    when pat {
        Enum(ep) => return ep.variant_name,
        Binding(bp) => return bp.name,
        _ => return ""
    }
}

// ============================================================================
// Emit diagnostics (item 3.4)
// ============================================================================

/// Format a non-exhaustive match error message.
pub func format_exhaustiveness_error(result: ExhaustivenessResult) -> Str {
    if result.is_exhaustive > 0 { return "" }

    var msg = "Non-exhaustive match: missing patterns: "
    let mc: I64 = result.missing_patterns.len() as I64
    for i in 0 to mc {
        if i > 0 { msg = msg + ", " }
        msg = msg + result.missing_patterns.get(i)
    }
    return msg
}

/// Format unreachable arm warnings.
pub func format_unreachable_warnings(result: ExhaustivenessResult) -> List[Str] {
    let warnings: List[Str] = List::new(result.unreachable_arms.len() as I64)
    let uc: I64 = result.unreachable_arms.len() as I64
    for i in 0 to uc {
        let arm_idx = result.unreachable_arms.get(i)
        warnings.push("Unreachable pattern in arm " + arm_idx.to_string())
    }
    return warnings
}
