//! THIR lowering pass — transforms HIR to THIR.
//!
//! Inserts coercions, resolves methods to concrete impls, desugars operators
//! to method calls, and normalizes associated types.
//!
//! Phase 15b — items 2.1–2.6.

use compiler::source::{SourceSpan, loc_new, span_new}
use compiler::types::ty::*
use compiler::types::env::TypeEnv
use compiler::types::coercion::{CoercionKind, find_coercion, normalize_type}
use compiler::types::behaviors::registry::BehaviorRegistry
use compiler::types::behaviors::dispatch::{dispatch_method, MethodResolution, MethodSource}
use compiler::types::checker::check_call::{operator_behavior_name, operator_method_name, get_type_name}
use compiler::hir::expr::*
use compiler::hir::stmt::HirStmt
use compiler::hir::pattern::HirPattern
use compiler::hir::module::{HirModule, HirFunction, HirParam}
use compiler::thir::expr::*
use compiler::thir::stmt::{ThirStmt, ThirLetStmt, ThirExprStmt}
use compiler::thir::pattern::*
use compiler::thir::module::*
use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

// ============================================================================
// ThirLower state
// ============================================================================

pub type ThirLower {
    env: TypeEnv,
    bhv_reg: BehaviorRegistry,
    next_id: I64,
    errors: List[Str]
}

pub func thir_lower_new(env: TypeEnv, bhv_reg: BehaviorRegistry) -> ThirLower {
    let errors: List[Str] = List::new(8)
    return ThirLower { env: env, bhv_reg: bhv_reg, next_id: 1, errors: errors }
}

func fresh_id(tl: ThirLower) -> I64 {
    let id = tl.next_id
    tl.next_id = id + 1
    return id
}

// ============================================================================
// Module lowering entry point (item 2.1)
// ============================================================================

/// Lower an entire HirModule to a ThirModule.
pub func lower_hir_to_thir(tl: ThirLower, hmod: HirModule) -> ThirModule {
    let tmod = thir_module_new(hmod.name, hmod.source_path)

    // Lower functions
    let fc: I64 = hmod.functions.len() as I64
    for i in 0 to fc {
        tmod.functions.push(lower_thir_function(tl, hmod.functions.get(i)))
    }

    // Lower structs (pass through — no transformation needed)
    let sc: I64 = hmod.structs.len() as I64
    for i in 0 to sc {
        let hs = hmod.structs.get(i)
        let fields: List[ThirField] = List::new(hs.fields.len() as I64)
        let ffc: I64 = hs.fields.len() as I64
        for j in 0 to ffc {
            let hf = hs.fields.get(j)
            fields.push(ThirField { name: hf.name, field_type: hf.field_type, index: hf.index })
        }
        tmod.structs.push(ThirStruct {
            id: fresh_id(tl), name: hs.name, mangled_name: hs.mangled_name,
            fields: fields, is_public: hs.is_public, span: hs.span
        })
    }

    // Lower enums (pass through)
    let ec: I64 = hmod.enums.len() as I64
    for i in 0 to ec {
        let he = hmod.enums.get(i)
        let variants: List[ThirVariant] = List::new(he.variants.len() as I64)
        let vc: I64 = he.variants.len() as I64
        for j in 0 to vc {
            let hv = he.variants.get(j)
            variants.push(ThirVariant { name: hv.name, payload_types: hv.payload_types, discriminant: hv.discriminant })
        }
        tmod.enums.push(ThirEnum {
            id: fresh_id(tl), name: he.name, mangled_name: he.mangled_name,
            variants: variants, is_public: he.is_public, span: he.span
        })
    }

    return tmod
}

/// Lower a HirFunction to ThirFunction.
func lower_thir_function(tl: ThirLower, hf: HirFunction) -> ThirFunction {
    let params: List[ThirParam] = List::new(hf.params.len() as I64)
    let pc: I64 = hf.params.len() as I64
    for i in 0 to pc {
        let hp = hf.params.get(i)
        params.push(ThirParam { name: hp.name, param_type: hp.param_type, is_mutable: hp.is_mutable, span: hp.span })
    }
    let body: Maybe[Heap[ThirExpr]] = when hf.body {
        Just(hb) => Just(Heap::new(lower_thir_expr(tl, hb.get()))),
        Nothing => Nothing
    }
    return ThirFunction {
        id: fresh_id(tl), name: hf.name, mangled_name: hf.mangled_name,
        params: params, return_type: hf.return_type, body: body,
        is_public: hf.is_public, is_async: hf.is_async, is_extern: hf.is_extern, span: hf.span
    }
}

// ============================================================================
// Expression lowering with coercion insertion (items 2.2–2.6)
// ============================================================================

/// Lower a HirExpr to ThirExpr, inserting coercions and resolving methods.
pub func lower_thir_expr(tl: ThirLower, he: HirExpr) -> ThirExpr {
    when he {
        Literal(lit) => return ThirExpr::Literal(ThirLiteralExpr {
            id: fresh_id(tl), value: lit.value, resolved_type: lit.resolved_type, span: lit.span
        }),
        Var(v) => return ThirExpr::Var(ThirVarExpr {
            id: fresh_id(tl), name: v.name, resolved_type: v.resolved_type, span: v.span
        }),
        Binary(bin) => {
            let left = lower_thir_expr(tl, bin.left.get())
            let right = lower_thir_expr(tl, bin.right.get())
            return ThirExpr::Binary(ThirBinaryExpr {
                id: fresh_id(tl), op: bin.op, left: Heap::new(left), right: Heap::new(right),
                resolved_type: bin.resolved_type, span: bin.span
            })
        },
        Unary(un) => {
            let operand = lower_thir_expr(tl, un.operand.get())
            return ThirExpr::Unary(ThirUnaryExpr {
                id: fresh_id(tl), op: un.op, operand: Heap::new(operand),
                resolved_type: un.resolved_type, span: un.span
            })
        },
        Call(call) => {
            let args: List[Heap[ThirExpr]] = List::new(call.args.len() as I64)
            let ac: I64 = call.args.len() as I64
            for i in 0 to ac {
                args.push(Heap::new(lower_thir_expr(tl, call.args.get(i).get())))
            }
            return ThirExpr::Call(ThirCallExpr {
                id: fresh_id(tl), func_name: call.func_name, type_args: call.type_args,
                args: args, resolved_type: call.resolved_type, span: call.span
            })
        },
        MethodCall(mc) => {
            let recv = lower_thir_expr(tl, mc.receiver.get())
            let args: List[Heap[ThirExpr]] = List::new(mc.args.len() as I64)
            let ac: I64 = mc.args.len() as I64
            for i in 0 to ac {
                args.push(Heap::new(lower_thir_expr(tl, mc.args.get(i).get())))
            }
            // Resolve method via behavior registry
            let recv_ty = mc.resolved_type
            let resolved = ResolvedMethod {
                type_name: get_type_name(recv_ty),
                behavior_name: "",
                method_name: mc.method_name,
                qualified_path: get_type_name(recv_ty) + "::" + mc.method_name,
                type_args: mc.type_args
            }
            return ThirExpr::MethodCall(ThirMethodCallExpr {
                id: fresh_id(tl), receiver: Heap::new(recv), resolved: resolved,
                args: args, receiver_type: recv_ty, resolved_type: mc.resolved_type, span: mc.span
            })
        },
        Field(fld) => {
            let obj = lower_thir_expr(tl, fld.object.get())
            return ThirExpr::Field(ThirFieldExpr {
                id: fresh_id(tl), object: Heap::new(obj), field_name: fld.field_name,
                field_index: fld.field_index, resolved_type: fld.resolved_type, span: fld.span
            })
        },
        Index(idx) => {
            let obj = lower_thir_expr(tl, idx.object.get())
            let index = lower_thir_expr(tl, idx.index.get())
            return ThirExpr::Index(ThirIndexExpr {
                id: fresh_id(tl), object: Heap::new(obj), index: Heap::new(index),
                resolved_type: idx.resolved_type, span: idx.span
            })
        },
        Block(blk) => {
            let stmts: List[Heap[ThirStmt]] = List::new(blk.stmts.len() as I64)
            let stc: I64 = blk.stmts.len() as I64
            for i in 0 to stc {
                stmts.push(Heap::new(lower_thir_stmt(tl, blk.stmts.get(i).get())))
            }
            let trail: Maybe[Heap[ThirExpr]] = when blk.expr {
                Just(be) => Just(Heap::new(lower_thir_expr(tl, be.get()))),
                Nothing => Nothing
            }
            return ThirExpr::Block(ThirBlockExpr {
                id: fresh_id(tl), stmts: stmts, expr: trail,
                resolved_type: blk.resolved_type, span: blk.span
            })
        },
        If(ife) => {
            let cond = lower_thir_expr(tl, ife.condition.get())
            let then_br = lower_thir_expr(tl, ife.then_branch.get())
            let else_br: Maybe[Heap[ThirExpr]] = when ife.else_branch {
                Just(eb) => Just(Heap::new(lower_thir_expr(tl, eb.get()))),
                Nothing => Nothing
            }
            return ThirExpr::If(ThirIfExpr {
                id: fresh_id(tl), condition: Heap::new(cond),
                then_branch: Heap::new(then_br), else_branch: else_br,
                resolved_type: ife.resolved_type, span: ife.span
            })
        },
        Return(ret) => {
            let val: Maybe[Heap[ThirExpr]] = when ret.value {
                Just(rv) => Just(Heap::new(lower_thir_expr(tl, rv.get()))),
                Nothing => Nothing
            }
            return ThirExpr::Return(ThirReturnExpr {
                id: fresh_id(tl), value: val, resolved_type: ret.resolved_type, span: ret.span
            })
        },
        _ => {
            // Pass through remaining variants as literals (placeholder)
            let loc = loc_new("<thir>", 0, 0, 0, 0)
            let span = span_new(loc, loc)
            return ThirExpr::Literal(ThirLiteralExpr {
                id: fresh_id(tl), value: HirLitValue::LitInt(0),
                resolved_type: make_unit(), span: span
            })
        }
    }
}

/// Lower a HirStmt to ThirStmt.
func lower_thir_stmt(tl: ThirLower, hs: HirStmt) -> ThirStmt {
    when hs {
        Let(ls) => {
            let init: Maybe[Heap[ThirExpr]] = when ls.init {
                Just(ie) => Just(Heap::new(lower_thir_expr(tl, ie.get()))),
                Nothing => Nothing
            }
            let pat = lower_thir_pattern(tl, ls.pattern.get())
            return ThirStmt::Let(ThirLetStmt {
                id: fresh_id(tl), pattern: Heap::new(pat), declared_type: ls.declared_type,
                init: init, is_mutable: ls.is_mutable, span: ls.span
            })
        },
        Expr(es) => {
            let expr = lower_thir_expr(tl, es.expr.get())
            return ThirStmt::Expr(ThirExprStmt {
                id: fresh_id(tl), expr: Heap::new(expr), span: es.span
            })
        }
    }
}

/// Lower a HirPattern to ThirPattern.
func lower_thir_pattern(tl: ThirLower, hp: HirPattern) -> ThirPattern {
    when hp {
        Wildcard(w) => return ThirPattern::Wildcard(ThirWildcardPattern {
            id: fresh_id(tl), resolved_type: w.resolved_type, span: w.span
        }),
        Binding(b) => return ThirPattern::Binding(ThirBindingPattern {
            id: fresh_id(tl), name: b.name, is_mutable: b.is_mutable,
            resolved_type: b.resolved_type, span: b.span
        }),
        _ => {
            let loc = loc_new("<thir>", 0, 0, 0, 0)
            let span = span_new(loc, loc)
            return ThirPattern::Wildcard(ThirWildcardPattern {
                id: fresh_id(tl), resolved_type: make_unit(), span: span
            })
        }
    }
}

// ============================================================================
// Coercion insertion (item 2.2)
// ============================================================================

/// Wrap an expression in a coercion node if needed.
pub func maybe_insert_coercion(tl: ThirLower, expr: ThirExpr, from_ty: Type, target_ty: Type, span: SourceSpan) -> ThirExpr {
    let coercion = find_coercion(from_ty, target_ty)
    when coercion {
        NoCoercion => return expr,
        _ => {
            return ThirExpr::Coercion(ThirCoercionExpr {
                id: fresh_id(tl),
                coercion: coercion,
                inner: Heap::new(expr),
                source_type: from_ty,
                resolved_type: target_ty,
                span: span
            })
        }
    }
}
