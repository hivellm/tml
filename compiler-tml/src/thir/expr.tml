//! THIR Expression types for the TML self-hosting compiler.
//!
//! THIR extends HIR expressions with:
//! - Explicit coercion nodes (ThirCoercionExpr)
//! - Resolved method calls (ResolvedMethod with fully-qualified path)
//! - Desugared operators (all ops become method calls)
//!
//! Phase 15b — item 1.2.

use compiler::source::SourceSpan
use compiler::types::ty::Type
use compiler::hir::expr::HirBinOp
use compiler::hir::expr::HirUnaryOp
use compiler::hir::expr::HirCompoundOp
use compiler::hir::expr::HirLitValue
use compiler::types::coercion::CoercionKind
use std::collections::list::List
use core::alloc::heap::Heap

// ============================================================================
// Resolved method dispatch info
// ============================================================================

/// Fully-resolved method dispatch information.
/// After THIR lowering, every method call has a concrete target.
pub type ResolvedMethod {
    type_name: Str,
    behavior_name: Str,
    method_name: Str,
    qualified_path: Str,
    type_args: List[Type]
}

// ============================================================================
// THIR-specific expression: Coercion
// ============================================================================

/// Explicit coercion node inserted by THIR lowering.
pub type ThirCoercionExpr {
    id: I64,
    coercion: CoercionKind,
    inner: Heap[ThirExpr],
    source_type: Type,
    resolved_type: Type,
    span: SourceSpan
}

// ============================================================================
// THIR expressions (mirror HIR but with THIR-specific additions)
// ============================================================================

pub type ThirLiteralExpr { id: I64, value: HirLitValue, resolved_type: Type, span: SourceSpan }
pub type ThirVarExpr { id: I64, name: Str, resolved_type: Type, span: SourceSpan }
pub type ThirBinaryExpr { id: I64, op: HirBinOp, left: Heap[ThirExpr], right: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirUnaryExpr { id: I64, op: HirUnaryOp, operand: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirCallExpr { id: I64, func_name: Str, type_args: List[Type], args: List[Heap[ThirExpr]], resolved_type: Type, span: SourceSpan }
pub type ThirMethodCallExpr { id: I64, receiver: Heap[ThirExpr], resolved: ResolvedMethod, args: List[Heap[ThirExpr]], receiver_type: Type, resolved_type: Type, span: SourceSpan }
pub type ThirFieldExpr { id: I64, object: Heap[ThirExpr], field_name: Str, field_index: I64, resolved_type: Type, span: SourceSpan }
pub type ThirIndexExpr { id: I64, object: Heap[ThirExpr], index: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirTupleExpr { id: I64, elements: List[Heap[ThirExpr]], resolved_type: Type, span: SourceSpan }
pub type ThirArrayExpr { id: I64, elements: List[Heap[ThirExpr]], resolved_type: Type, span: SourceSpan }
pub type ThirStructField { name: Str, value: Heap[ThirExpr] }
pub type ThirStructExpr { id: I64, struct_name: Str, type_args: List[Type], fields: List[ThirStructField], resolved_type: Type, span: SourceSpan }
pub type ThirEnumExpr { id: I64, enum_name: Str, variant_name: Str, variant_index: I64, type_args: List[Type], args: List[Heap[ThirExpr]], resolved_type: Type, span: SourceSpan }
pub type ThirBlockExpr { id: I64, stmts: List[Heap[ThirStmt]], expr: Maybe[Heap[ThirExpr]], resolved_type: Type, span: SourceSpan }
pub type ThirIfExpr { id: I64, condition: Heap[ThirExpr], then_branch: Heap[ThirExpr], else_branch: Maybe[Heap[ThirExpr]], resolved_type: Type, span: SourceSpan }

pub type ThirWhenArm { pattern: Heap[ThirPattern], guard: Maybe[Heap[ThirExpr]], body: Heap[ThirExpr], span: SourceSpan }
pub type ThirWhenExpr { id: I64, scrutinee: Heap[ThirExpr], arms: List[ThirWhenArm], resolved_type: Type, is_exhaustive: I64, span: SourceSpan }

pub type ThirLoopExpr { id: I64, condition: Heap[ThirExpr], body: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirWhileExpr { id: I64, condition: Heap[ThirExpr], body: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirForExpr { id: I64, binding: Str, iter: Heap[ThirExpr], body: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirReturnExpr { id: I64, value: Maybe[Heap[ThirExpr]], resolved_type: Type, span: SourceSpan }
pub type ThirBreakExpr { id: I64, value: Maybe[Heap[ThirExpr]], resolved_type: Type, span: SourceSpan }
pub type ThirContinueExpr { id: I64, resolved_type: Type, span: SourceSpan }
pub type ThirClosureExpr { id: I64, params: List[Str], param_types: List[Type], captures: List[ThirCapture], body: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirCapture { name: Str, captured_type: Type, is_by_ref: I64, is_by_move: I64 }
pub type ThirCastExpr { id: I64, expr: Heap[ThirExpr], target_type: Type, resolved_type: Type, span: SourceSpan }
pub type ThirTryExpr { id: I64, expr: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirAwaitExpr { id: I64, expr: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirAssignExpr { id: I64, target: Heap[ThirExpr], value: Heap[ThirExpr], resolved_type: Type, span: SourceSpan }
pub type ThirCompoundAssignExpr { id: I64, op: HirCompoundOp, target: Heap[ThirExpr], value: Heap[ThirExpr], resolved_method: Maybe[Str], resolved_type: Type, span: SourceSpan }
pub type ThirLowlevelExpr { id: I64, stmts: List[Heap[ThirStmt]], expr: Maybe[Heap[ThirExpr]], resolved_type: Type, span: SourceSpan }

// Forward declarations for mutual recursion
use compiler::thir::stmt::ThirStmt
use compiler::thir::pattern::ThirPattern

// ============================================================================
// ThirExpr — the unified expression enum (30 variants = 29 HIR + Coercion)
// ============================================================================

pub enum ThirExpr {
    Coercion(ThirCoercionExpr),
    Literal(ThirLiteralExpr),
    Var(ThirVarExpr),
    Binary(ThirBinaryExpr),
    Unary(ThirUnaryExpr),
    Call(ThirCallExpr),
    MethodCall(ThirMethodCallExpr),
    Field(ThirFieldExpr),
    Index(ThirIndexExpr),
    Tuple(ThirTupleExpr),
    Array(ThirArrayExpr),
    Struct(ThirStructExpr),
    Enum(ThirEnumExpr),
    Block(ThirBlockExpr),
    If(ThirIfExpr),
    When(ThirWhenExpr),
    Loop(ThirLoopExpr),
    While(ThirWhileExpr),
    For(ThirForExpr),
    Return(ThirReturnExpr),
    Break(ThirBreakExpr),
    Continue(ThirContinueExpr),
    Closure(ThirClosureExpr),
    Cast(ThirCastExpr),
    Try(ThirTryExpr),
    Await(ThirAwaitExpr),
    Assign(ThirAssignExpr),
    CompoundAssign(ThirCompoundAssignExpr),
    Lowlevel(ThirLowlevelExpr)
}

/// Get the resolved type from any ThirExpr variant.
pub func thir_expr_type(e: ThirExpr) -> Type {
    when e {
        Coercion(x) => return x.resolved_type,
        Literal(x) => return x.resolved_type,
        Var(x) => return x.resolved_type,
        Binary(x) => return x.resolved_type,
        Unary(x) => return x.resolved_type,
        Call(x) => return x.resolved_type,
        MethodCall(x) => return x.resolved_type,
        Field(x) => return x.resolved_type,
        Index(x) => return x.resolved_type,
        Tuple(x) => return x.resolved_type,
        Array(x) => return x.resolved_type,
        Struct(x) => return x.resolved_type,
        Enum(x) => return x.resolved_type,
        Block(x) => return x.resolved_type,
        If(x) => return x.resolved_type,
        When(x) => return x.resolved_type,
        Loop(x) => return x.resolved_type,
        While(x) => return x.resolved_type,
        For(x) => return x.resolved_type,
        Return(x) => return x.resolved_type,
        Break(x) => return x.resolved_type,
        Continue(x) => return x.resolved_type,
        Closure(x) => return x.resolved_type,
        Cast(x) => return x.resolved_type,
        Try(x) => return x.resolved_type,
        Await(x) => return x.resolved_type,
        Assign(x) => return x.resolved_type,
        CompoundAssign(x) => return x.resolved_type,
        Lowlevel(x) => return x.resolved_type
    }
}
