//! Expression parser (Pratt) for the TML self-hosting compiler frontend.
//!
//! Implements the Pratt (top-down operator precedence) algorithm for all
//! TML expression forms. Entry point: `parse_expr`.

use compiler::source::SourceSpan
use compiler::source::span_merge
use compiler::token::Token
use compiler::token::TokenKind
use compiler::ast::nodes::TypePath
use compiler::ast::nodes::TypeExpr
use compiler::ast::nodes::Pattern
use compiler::ast::nodes::IdentPattern
use compiler::ast::exprs::Expr
use compiler::ast::exprs::BinaryOp
use compiler::ast::exprs::UnaryOp
use compiler::ast::exprs::LiteralExpr
use compiler::ast::exprs::IdentExpr
use compiler::ast::exprs::UnaryExpr
use compiler::ast::exprs::BinaryExpr
use compiler::ast::exprs::CallExpr
use compiler::ast::exprs::MethodCallExpr
use compiler::ast::exprs::FieldExpr
use compiler::ast::exprs::IndexExpr
use compiler::ast::exprs::TupleExpr
use compiler::ast::exprs::ArrayExpr
use compiler::ast::exprs::ArrayKind
use compiler::ast::exprs::StructExpr
use compiler::ast::exprs::StructExprField
use compiler::ast::exprs::IfExpr
use compiler::ast::exprs::IfLetExpr
use compiler::ast::exprs::WhenExpr
use compiler::ast::exprs::WhenArm
use compiler::ast::exprs::LoopExpr
use compiler::ast::exprs::WhileExpr
use compiler::ast::exprs::ForExpr
use compiler::ast::exprs::BlockExpr
use compiler::ast::exprs::ReturnExpr
use compiler::ast::exprs::BreakExpr
use compiler::ast::exprs::ContinueExpr
use compiler::ast::exprs::ClosureExpr
use compiler::ast::exprs::ClosureParam
use compiler::ast::exprs::RangeExpr
use compiler::ast::exprs::CastExpr
use compiler::ast::exprs::IsExpr
use compiler::ast::exprs::TryExpr
use compiler::ast::exprs::AwaitExpr
use compiler::ast::exprs::PathExpr
use compiler::ast::exprs::LowlevelExpr
use compiler::ast::exprs::ThrowExpr
use compiler::ast::common::LiteralKind
use compiler::ast::stmts::Stmt
use compiler::parser::common::ParseFailure
use compiler::parser::common::ParsedExpr
use compiler::parser::common::ParsedExprs
use compiler::parser::common::ParsedTypeExpr
use compiler::parser::common::ParsedTypeExprs
use compiler::parser::common::ParsedPattern
use compiler::parser::common::ParsedStmt
use compiler::parser::common::ParsedToken
use compiler::parser::common::p_peek
use compiler::parser::common::p_peek_next
use compiler::parser::common::p_prev
use compiler::parser::common::p_check
use compiler::parser::common::p_check_next
use compiler::parser::common::p_is_eof
