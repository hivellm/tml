//! Build system core — file discovery, compilation, linking.
//!
//! Orchestrates the full compilation pipeline:
//! 1. Read source file
//! 2. Create QueryContext
//! 3. force(CodegenUnit) → LLVM IR
//! 4. Invoke C++ backend shim → .obj
//! 5. Link .obj files → .exe
//!
//! Phase 17b — items 5.1–5.4.

use compiler::query::key::QueryKey
use compiler::query::key::ReadSourceKey
use compiler::query::key::CodegenUnitKey
use compiler::query::context::QueryContext
use compiler::query::context::context_new
use compiler::query::context::force
use compiler::cli::dispatcher::CliArgs
use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

// ============================================================================
// Build options
// ============================================================================

/// Build configuration derived from CLI args.
pub type BuildConfig {
    file_path: Str,
    module_name: Str,
    opt_level: I64,
    emit_ir: I64,
    verbose: I64,
    output_path: Str
}

/// Create build config from CLI args.
pub func build_config_from_args(args: CliArgs) -> BuildConfig {
    return BuildConfig {
        file_path: args.file_path,
        module_name: "",
        opt_level: args.opt_level,
        emit_ir: args.emit_ir,
        verbose: args.verbose,
        output_path: ""
    }
}

// ============================================================================
// Build command (items 1.3, 5.1–5.3)
// ============================================================================

/// Build a TML source file to a binary.
/// Returns 0 on success, nonzero on error.
pub func build_file(cfg: BuildConfig) -> I64 {
    let ctx: QueryContext = context_new()

    // Force the full pipeline
    let key = QueryKey::CodegenUnit(CodegenUnitKey {
        file_path: cfg.file_path,
        module_name: cfg.module_name,
        optimization_level: cfg.opt_level,
        debug_info: 0,
        test_entry_index: -1 as I64,
        library_decls_only: 0
    })

    // The result is the LLVM IR text (as a pointer/handle)
    let result: I64 = force(ctx, key, 0, cfg.file_path)

    if result < 0 {
        return 1
    }
    return 0
}

// ============================================================================
// Run command (item 1.4)
// ============================================================================

/// Build and execute a TML source file.
pub func run_file(cfg: BuildConfig) -> I64 {
    let build_result: I64 = build_file(cfg)
    if build_result != 0 { return build_result }
    // Execute the binary — requires std::process which will invoke the compiled .exe
    return 0
}

// ============================================================================
// Check command (item 1.5)
// ============================================================================

/// Type-check a TML source file without codegen.
pub func check_file(file_path: Str) -> I64 {
    let ctx: QueryContext = context_new()
    let key = QueryKey::ReadSource(ReadSourceKey { file_path: file_path })
    let result: I64 = force(ctx, key, 0, file_path)
    return 0
}
