//! CLI dispatcher — argument parsing and subcommand routing.
//!
//! Parses command-line arguments and dispatches to the appropriate
//! subcommand handler (build, run, test, check, fmt, lint).
//!
//! Phase 17b — items 1.1–1.5.

use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

// ============================================================================
// Argument parsing
// ============================================================================

/// Parsed command-line arguments.
pub type CliArgs {
    /// The subcommand: "build", "run", "test", "check", "fmt", "lint".
    command: Str,
    /// The primary file or path argument.
    file_path: Str,
    /// Named options: --key=value pairs.
    options: HashMap[Str, Str],
    /// Positional arguments after the file path.
    positional: List[Str],
    /// Whether --verbose was specified.
    verbose: I64,
    /// Whether --release was specified.
    release: I64,
    /// Whether --emit-ir was specified.
    emit_ir: I64,
    /// Test suite filter (--suite=...).
    suite: Str,
    /// Optimization level (0-3).
    opt_level: I64
}

/// Parse command-line arguments from a list of strings.
/// Expected format: `tml <command> [file] [options...]`
pub func parse_args(args: List[Str]) -> CliArgs {
    let argc: I64 = args.len() as I64
    var result: CliArgs = CliArgs {
        command: "",
        file_path: "",
        options: HashMap[Str, Str]::new(16),
        positional: List[Str]::new(4),
        verbose: 0,
        release: 0,
        emit_ir: 0,
        suite: "",
        opt_level: 0
    }

    if argc < 2 { return result }

    // First arg after program name is the command
    result.command = args.get(1)

    // Parse remaining arguments
    for i in 2 to argc {
        let arg: Str = args.get(i)

        if arg == "--verbose" or arg == "-v" {
            result.verbose = 1
        } else if arg == "--release" {
            result.release = 1
            result.opt_level = 3
        } else if arg == "--emit-ir" {
            result.emit_ir = 1
        } else if arg == "-O0" {
            result.opt_level = 0
        } else if arg == "-O1" {
            result.opt_level = 1
        } else if arg == "-O2" {
            result.opt_level = 2
        } else if arg == "-O3" {
            result.opt_level = 3
        } else if arg.starts_with("--suite=") {
            result.suite = arg.slice(8, arg.len() as I64)
        } else if arg.starts_with("--") {
            // Named option: --key=value
            let eq_pos: I64 = find_char(arg, 61)  // '='
            if eq_pos > 0 {
                let key: Str = arg.slice(2, eq_pos)
                let val: Str = arg.slice(eq_pos + 1, arg.len() as I64)
                result.options.set(key, val)
            } else {
                result.options.set(arg.slice(2, arg.len() as I64), "true")
            }
        } else if result.file_path == "" {
            result.file_path = arg
        } else {
            result.positional.push(arg)
        }
    }

    return result
}

/// Find the position of a character in a string, or -1 if not found.
func find_char(s: Str, ch: I64) -> I64 {
    let n: I64 = s.len() as I64
    for i in 0 to n {
        if s.char_at(i) as I64 == ch { return i }
    }
    return -1 as I64
}

// ============================================================================
// Subcommand dispatch (item 1.2)
// ============================================================================

/// Dispatch to the appropriate subcommand handler.
/// Returns an exit code (0 = success, nonzero = error).
pub func dispatch(args: CliArgs) -> I64 {
    if args.command == "build" { return 0 }     // Handled by builder.tml
    if args.command == "run" { return 0 }       // Handled by builder.tml
    if args.command == "check" { return 0 }     // Handled by builder.tml
    if args.command == "test" { return 0 }      // Handled by testing/mod.tml
    if args.command == "fmt" { return 0 }       // Handled by format/mod.tml
    if args.command == "lint" { return 0 }      // Handled by format/mod.tml
    if args.command == "help" or args.command == "--help" {
        return 0
    }
    // Unknown command
    return 1
}

/// Format a help message.
pub func help_text() -> Str {
    var s: Str = "tml — The TML compiler\n\n"
    s = s + "Usage: tml <command> [file] [options]\n\n"
    s = s + "Commands:\n"
    s = s + "  build    Compile a TML file to binary\n"
    s = s + "  run      Compile and execute a TML file\n"
    s = s + "  check    Type-check without compiling\n"
    s = s + "  test     Run test suites\n"
    s = s + "  fmt      Format TML source files\n"
    s = s + "  lint     Lint TML source files\n"
    s = s + "\nOptions:\n"
    s = s + "  --verbose, -v    Verbose output\n"
    s = s + "  --release        Optimize for release (O3)\n"
    s = s + "  --emit-ir        Emit LLVM IR instead of binary\n"
    s = s + "  --suite=NAME     Filter test suite\n"
    s = s + "  -O0/-O1/-O2/-O3  Optimization level\n"
    return s
}
