//! AST module root for the TML self-hosting compiler frontend.
//!
//! The AST is split across four files with cyclic cross-imports:
//!
//! - `nodes`    — Type/Pattern/Module AST types (the core type graph)
//! - `exprs`    — Expression AST types (Expr enum + all expression nodes)
//! - `stmts`    — Statement AST types (Stmt enum + LetStmt/VarStmt/LetElseStmt)
//! - `decls`    — Declaration + OOP AST types (Decl enum + all decl/class nodes)
//!
//! Supporting files:
//! - `common`   — Visibility, Mutability, AstId, LiteralKind
//! - `serial`   — Binary serialization (Token/Module round-trip)
//!
//! Re-export shims (`types`, `patterns`, `oop`, `module`) provide
//! backwards-compatible import paths.

use compiler::ast::common::Visibility
use compiler::ast::common::Mutability
use compiler::ast::common::AstId
use compiler::ast::common::LiteralKind

use compiler::ast::nodes::TypeExpr
use compiler::ast::nodes::Pattern
use compiler::ast::exprs::Expr
use compiler::ast::stmts::Stmt
use compiler::ast::decls::Decl
use compiler::ast::nodes::Module
