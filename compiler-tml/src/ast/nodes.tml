//! Core AST node types for the TML self-hosting compiler frontend.
//!
//! Mirrors `compiler/include/parser/ast_*.hpp` (common, types, patterns,
//! module). Expression types live in `exprs.tml`, statement types in
//! `stmts.tml`, and declaration/OOP types in `decls.tml`. Each file
//! cross-imports the others through `Heap[T]`-wrapped pointers, forming
//! the natural cyclic dependency graph of a recursive AST.
//!
//! Recursive children are wrapped in `Heap[T]` to break cycles, matching
//! the C++ side which uses `Box<T>` (`unique_ptr`). Every node carries a
//! `SourceSpan` for diagnostics.

use compiler::source::SourceSpan
use compiler::ast::common::Visibility
use compiler::ast::common::LiteralKind
use compiler::ast::exprs::Expr
use compiler::ast::decls::Decl
use std::collections::list::List
use core::alloc::heap::Heap

// ============================================================================
// Type AST — mirrors ast_types.hpp
// ============================================================================

/// Qualified type path: `std::io::File`, `Vec`, `core::Option`.
pub type TypePath {
    segments: List[Str],
    span: SourceSpan
}

pub type NamedType {
    path: TypePath,
    args: List[Heap[TypeExpr]],
    span: SourceSpan
}

pub type RefType {
    inner: Heap[TypeExpr],
    is_mut: Bool,
    span: SourceSpan
}

pub type PtrType {
    inner: Heap[TypeExpr],
    is_mut: Bool,
    span: SourceSpan
}

pub type ArrayType {
    element: Heap[TypeExpr],
    size: Heap[Expr],
    span: SourceSpan
}

pub type SliceType {
    element: Heap[TypeExpr],
    span: SourceSpan
}

pub type TupleType {
    elements: List[Heap[TypeExpr]],
    span: SourceSpan
}

pub type FuncType {
    params: List[Heap[TypeExpr]],
    return_type: Maybe[Heap[TypeExpr]],
    span: SourceSpan
}

pub type DynType {
    bounds: List[TypePath],
    span: SourceSpan
}

pub type ImplBehaviorType {
    bounds: List[TypePath],
    span: SourceSpan
}

/// Sum of all type expression variants.
pub enum TypeExpr {
    Named(NamedType),
    Ref(RefType),
    Ptr(PtrType),
    Array(ArrayType),
    Slice(SliceType),
    Tuple(TupleType),
    Func(FuncType),
    Infer(SourceSpan),
    Dyn(DynType),
    ImplBehavior(ImplBehaviorType)
}

// ============================================================================
// Pattern AST — mirrors ast_patterns.hpp
// ============================================================================

pub type IdentPattern {
    name: Str,
    subpat: Maybe[Heap[Pattern]],
    span: SourceSpan
}

pub type LiteralPattern {
    value: LiteralKind,
    span: SourceSpan
}

pub type TuplePattern {
    patterns: List[Heap[Pattern]],
    span: SourceSpan
}

pub type FieldPattern {
    name: Str,
    pat: Heap[Pattern],
    span: SourceSpan
}

pub type StructPattern {
    path: TypePath,
    fields: List[FieldPattern],
    has_rest: Bool,
    span: SourceSpan
}

pub type EnumPattern {
    path: TypePath,
    args: List[Heap[Pattern]],
    span: SourceSpan
}

pub type OrPattern {
    alternatives: List[Heap[Pattern]],
    span: SourceSpan
}

pub type RangePattern {
    start: LiteralKind,
    end: LiteralKind,
    inclusive: Bool,
    span: SourceSpan
}

pub type ArrayPattern {
    patterns: List[Heap[Pattern]],
    rest: Maybe[Heap[Pattern]],
    span: SourceSpan
}

pub enum Pattern {
    Wildcard(SourceSpan),
    Ident(IdentPattern),
    Literal(LiteralPattern),
    Tuple(TuplePattern),
    Struct(StructPattern),
    Enum(EnumPattern),
    Or(OrPattern),
    Range(RangePattern),
    Array(ArrayPattern)
}

// ============================================================================
// Module AST — mirrors ast.hpp `Module`
// ============================================================================

/// Top-level compilation unit.
pub type Module {
    name: Str,
    docs: List[Str],
    decls: List[Heap[Decl]],
    span: SourceSpan
}

pub func module_new(name: Str, docs: List[Str], decls: List[Heap[Decl]], span: SourceSpan) -> Module {
    return Module { name: name, docs: docs, decls: decls, span: span }
}
