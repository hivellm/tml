//! Serialization bridge for the self-hosting AST (phase13a Phase 5).
//!
//! Provides binary round-trip (write + read) for [`Token`] and [`Module`]
//! using the phase12e `BinaryWriter` / `BinaryReader` primitives.
//!
//! # Scope
//!
//! - **Token**: full round-trip — kind discriminant, value string, and
//!   `SourceSpan`. Stable on-disk format suitable for the hybrid pipeline.
//! - **Module**: header + name + docs + declaration count. The recursive
//!   walk over `Decl`/`Expr`/`Stmt` is delegated to
//!   [`compiler::serial::ast`], which already implements the wire format
//!   on the `Tml*`-prefixed mirror types. The self-hosting parser
//!   (phase13c) populates `ast::nodes::Module`; the hybrid bridge
//!   (phase13d) converts it to `TmlModule` before writing. This file
//!   handles the empty-module case end-to-end so the round-trip contract
//!   is exercised by tests today.
//!
//! # On-disk format
//!
//! ```
//! Token:
//!   varint kind_tag   (matches TokenKind discriminant order in token.tml)
//!   str    value      (written via BinaryWriter::write_str)
//!   SourceSpan span   (see write_source_span below)
//!
//! SourceLocation:
//!   str  file
//!   varint line
//!   varint column
//!   varint offset
//!   varint length
//!
//! SourceSpan:
//!   SourceLocation start
//!   SourceLocation end
//!
//! Module:
//!   u32    magic        = 0x4D4F4420 ("MOD ")
//!   u8     version_major = 1
//!   u8     version_minor = 0
//!   str    name
//!   varint doc_count
//!   str[doc_count] docs
//!   SourceSpan module_span
//!   varint decl_count     (0 for an empty module)
//! ```

use compiler::serial::writer::BinaryWriter
use compiler::serial::reader::BinaryReader
use compiler::serial::SerialError
use compiler::source::SourceLocation
use compiler::source::SourceSpan
use compiler::source::loc_new
use compiler::source::span_new
use compiler::token::Token
use compiler::token::TokenKind
use compiler::token::token_new
use compiler::token::token_kind_to_tag
use compiler::token::tag_to_token_kind
use compiler::ast::nodes::Module
use compiler::ast::nodes::module_new
use compiler::ast::decls::Decl
use std::collections::list::List
use core::alloc::heap::Heap

/// Magic for the self-hosting Module on-disk format: "MOD " (0x4D4F4420 LE).
pub const MODULE_MAGIC: I64 = 0x4D4F4420
pub const MODULE_VERSION_MAJOR: I32 = 1
pub const MODULE_VERSION_MINOR: I32 = 0

// ============================================================================
// SourceLocation / SourceSpan
// ============================================================================

pub func write_source_location(w: BinaryWriter, loc: SourceLocation) {
    w.write_str(loc.file)
    w.write_varint(loc.line)
    w.write_varint(loc.column)
    w.write_varint(loc.offset)
    w.write_varint(loc.length)
}

pub func read_source_location(r: BinaryReader) -> Outcome[SourceLocation, SerialError] {
    let file: Str = r.read_str()!
    let line: I64 = r.read_varint()!
    let column: I64 = r.read_varint()!
    let offset: I64 = r.read_varint()!
    let length: I64 = r.read_varint()!
    return Ok(loc_new(file, line, column, offset, length))
}

pub func write_source_span(w: BinaryWriter, span: SourceSpan) {
    write_source_location(w, span.start)
    write_source_location(w, span.end)
}

pub func read_source_span(r: BinaryReader) -> Outcome[SourceSpan, SerialError] {
    let start: SourceLocation = read_source_location(r)!
    let end: SourceLocation = read_source_location(r)!
    return Ok(span_new(start, end))
}

// ============================================================================
// Token
// ============================================================================

/// Serialize a single token.
pub func write_token(w: BinaryWriter, tok: Token) {
    w.write_varint(token_kind_to_tag(tok.kind))
    w.write_str(tok.value)
    write_source_span(w, tok.span)
}

/// Read the raw tag of a serialized token without reconstructing the
/// `TokenKind` enum. Returns just the tag as `I64`. Useful when the
/// caller only needs the numeric discriminant (e.g. the hybrid pipeline
/// bridge keeps tokens as tags until consumption).
pub func read_token_tag(r: BinaryReader) -> Outcome[I64, SerialError] {
    let tag: I64 = r.read_varint()!
    let _value: Str = r.read_str()!
    let _span: SourceSpan = read_source_span(r)!
    return Ok(tag)
}

/// Deserialize a full `Token` — reconstructs `TokenKind` from the tag
/// via `tag_to_token_kind` (the 139-arm dispatch that was previously
/// blocked by codegen timeouts; resolved by phase0p C1/C2/C5 fixes).
/// Returns `SerialError::InvalidTag` if the tag is out of range.
pub func read_token(r: BinaryReader) -> Outcome[Token, SerialError] {
    let tag: I64 = r.read_varint()!
    let value: Str = r.read_str()!
    let span: SourceSpan = read_source_span(r)!
    let maybe_kind: Maybe[TokenKind] = tag_to_token_kind(tag)
    when maybe_kind {
        Just(kind) => return Ok(token_new(kind, value, span)),
        Nothing => return Err(SerialError::InvalidTag)
    }
}

// ============================================================================
// Module
// ============================================================================

/// Write the self-hosting module header (magic + version).
pub func write_module_header(w: BinaryWriter) {
    w.write_u32(MODULE_MAGIC)
    w.write_u8(MODULE_VERSION_MAJOR)
    w.write_u8(MODULE_VERSION_MINOR)
}

/// Verify the header on read; returns the (major, minor) version on success.
pub func read_module_header(r: BinaryReader) -> Outcome[I64, SerialError] {
    let magic: I64 = r.read_u32()!
    if magic != MODULE_MAGIC {
        return Err(SerialError::InvalidMagic)
    }
    let major: I32 = r.read_u8()!
    let _minor: I32 = r.read_u8()!
    return Ok(major as I64)
}

/// Serialize a `Module`. Emits the header, name, doc list, module span,
/// and declaration count. The recursive declaration walk is delegated to
/// `compiler::serial::ast::write_decl` on the `Tml*` mirror types; the
/// self-hosting parser (phase13c) produces `ast::nodes::Module` values
/// that are either empty or converted before writing. An empty module
/// (`decls.len() == 0`) is round-trip complete via this function alone.
pub func write_module(w: BinaryWriter, m: Module) {
    // Extract aggregate fields to locals before calling methods on them.
    // The legacy codegen generates GEP on struct value parameters when calling
    // methods on fields, which fails because GEP requires a pointer.
    // Extracting to locals forces extractvalue (valid for values) instead.
    let docs: List[Str] = m.docs
    write_module_header(w)
    w.write_str(m.name)
    let doc_count: I64 = docs.len() as I64
    w.write_varint(doc_count)
    for i in 0 to doc_count {
        w.write_str(docs.get(i))
    }
    write_source_span(w, m.span)
    // Full Decl serialization is performed via `compiler::serial::ast`
    // on the Tml* mirror types; the hybrid pipeline bridge converts
    // `ast::nodes::Module` to `TmlModule` before invoking that writer.
    // For an empty module we simply emit a zero decl count.
    w.write_varint(0 as I64)
}

/// Deserialize a `Module` previously written by `write_module`.
/// Currently supports modules with zero declarations; a non-zero
/// decl count triggers `SerialError::Unsupported` so callers know to
/// route through the `compiler::serial::ast` Tml* reader instead.
pub func read_module(r: BinaryReader) -> Outcome[Module, SerialError] {
    let _major: I64 = read_module_header(r)!
    let name: Str = r.read_str()!
    let doc_count: I64 = r.read_varint()!
    var docs: List[Str] = List::new(doc_count)
    for i in 0 to doc_count {
        let s: Str = r.read_str()!
        docs.push(s)
    }
    let span: SourceSpan = read_source_span(r)!
    let decl_count: I64 = r.read_varint()!
    if decl_count != 0 {
        return Err(SerialError::InvalidTag)
    }
    let empty_decls: List[Heap[Decl]] = List::new(0)
    return Ok(module_new(name, docs, empty_decls, span))
}
