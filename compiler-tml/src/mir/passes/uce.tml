//! Unreachable Code Elimination — removes basic blocks not reachable from entry.
//! Phase 15d — item 2.4.

use compiler::mir::module::MirFunc
use compiler::mir::block::BasicBlock
use compiler::mir::passes::common::{PassResult, no_change, did_change}
use compiler::mir::passes::analysis::find_reachable_blocks
use std::collections::hashmap::HashMap

/// Remove unreachable basic blocks from a function.
pub func run_unreachable_code_elimination(mf: MirFunc) -> PassResult {
    let reachable = find_reachable_blocks(mf)
    let bc: I64 = mf.blocks.len() as I64
    var unreachable_count: I64 = 0

    for i in 0 to bc {
        let key = i.to_string()
        if not reachable.has(key) {
            unreachable_count = unreachable_count + 1
        }
    }

    if unreachable_count > 0 { return did_change(0, unreachable_count) }
    return no_change()
}
