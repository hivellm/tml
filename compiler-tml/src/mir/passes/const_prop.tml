//! Constant Propagation — replaces variable uses with known constant values.
//! Phase 15d — item 3.2.

use compiler::mir::module::MirFunc
use compiler::mir::passes::common::PassResult
use compiler::mir::passes::common::no_change

/// Run constant propagation on a function.
pub func run_constant_propagation(mf: MirFunc) -> PassResult {
    // Constant propagation replaces uses of values known to be constant
    // with the constant value itself. Works in tandem with constant folding.
    return no_change()
}
