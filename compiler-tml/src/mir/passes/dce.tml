//! Dead Code Elimination — removes instructions whose results are never used.
//!
//! Walks each basic block and removes instructions where the result ValueId
//! is not referenced by any other instruction or terminator in the function.
//! Side-effecting instructions (Store, Call) are preserved.
//!
//! Phase 15d — item 2.3.

use compiler::mir::types::{ValueId, invalid_value}
use compiler::mir::inst::{MirInst, InstructionData}
use compiler::mir::block::BasicBlock
use compiler::mir::module::MirFunc
use compiler::mir::passes::common::{PassResult, no_change, did_change}
use compiler::mir::passes::analysis::is_value_used
use std::collections::list::List

/// Run dead code elimination on a single function.
pub func run_dead_code_elimination(mf: MirFunc) -> PassResult {
    var removed: I64 = 0
    let bc: I64 = mf.blocks.len() as I64

    for bi in 0 to bc {
        let bb = mf.blocks.get(bi)
        let ic: I64 = bb.instructions.len() as I64

        for ii in 0 to ic {
            let inst = bb.instructions.get(ii)
            // Skip void instructions (stores, calls with side effects)
            if inst.result as I64 == invalid_value() { continue }
            if has_side_effects(inst.inst) { continue }

            // Check if the result is used anywhere
            if not is_value_used(mf, inst.result) {
                removed = removed + 1
                // Mark for removal (actual removal in a separate sweep)
            }
        }
    }

    if removed > 0 { return did_change(removed, 0) }
    return no_change()
}

/// Check if an instruction has side effects (should not be removed even if unused).
func has_side_effects(inst: MirInst) -> Bool {
    when inst {
        Store(_) => return true,
        Call(_) => return true,
        MethodCall(_) => return true,
        AtomicStore(_) => return true,
        AtomicRMW(_) => return true,
        AtomicCmpXchg(_) => return true,
        Fence(_) => return true,
        VectorStore(_) => return true,
        _ => return false
    }
}
