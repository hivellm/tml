//! Code formatter module root — AST → canonical pretty-print.
//!
//! The formatter parses TML source into an AST, then pretty-prints it
//! with canonical indentation (4 spaces), spacing, and line breaks.
//!
//! Phase 17b — items 4.1–4.3.

use std::collections::list::List
use core::alloc::heap::Heap

// ============================================================================
// Formatter configuration
// ============================================================================

/// Formatter settings.
pub type FormatConfig {
    /// Indentation width (spaces per level). Default: 4.
    indent_width: I64,
    /// Maximum line width before wrapping. Default: 100.
    max_line_width: I64,
    /// Whether to use trailing commas in multi-line constructs. Default: 1.
    trailing_commas: I64
}

/// Default formatter configuration.
pub func default_format_config() -> FormatConfig {
    return FormatConfig {
        indent_width: 4,
        max_line_width: 100,
        trailing_commas: 1
    }
}

// ============================================================================
// Indentation helpers
// ============================================================================

/// Generate indentation string for a given depth.
pub func indent(depth: I64, width: I64) -> Str {
    let total: I64 = depth * width
    var s: Str = ""
    for i in 0 to total { s = s + " " }
    return s
}

/// Format a function signature.
pub func format_func_sig(name: Str, params: List[Str], return_type: Str, depth: I64, cfg: FormatConfig) -> Str {
    let ind: Str = indent(depth, cfg.indent_width)
    var s: Str = ind + "func " + name + "("
    let pc: I64 = params.len() as I64
    for i in 0 to pc {
        if i > 0 { s = s + ", " }
        s = s + params.get(i)
    }
    s = s + ")"
    if return_type != "" {
        s = s + " -> " + return_type
    }
    return s
}

/// Format a struct type definition.
pub func format_struct_def(name: Str, fields: List[Str], depth: I64, cfg: FormatConfig) -> Str {
    let ind: Str = indent(depth, cfg.indent_width)
    let field_ind: Str = indent(depth + 1, cfg.indent_width)
    var s: Str = ind + "type " + name + " {\n"
    let fc: I64 = fields.len() as I64
    for i in 0 to fc {
        s = s + field_ind + fields.get(i)
        if i < fc - 1 or cfg.trailing_commas > 0 {
            s = s + ","
        }
        s = s + "\n"
    }
    s = s + ind + "}"
    return s
}

/// Format a use statement.
pub func format_use(path: Str, depth: I64, cfg: FormatConfig) -> Str {
    return indent(depth, cfg.indent_width) + "use " + path
}

// ============================================================================
// Format check mode (item 4.3)
// ============================================================================

/// Compare formatted output with original source.
/// Returns 1 if they match (already formatted), 0 if reformatting needed.
pub func is_formatted(original: Str, formatted: Str) -> I64 {
    if original == formatted { return 1 }
    return 0
}
