// ============================================================================
// Serialization helpers
// ============================================================================

/// Write the file header: magic u32 + version major u8 + version minor u8.
pub func write_ast_header(w: BinaryWriter) {
    w.write_u32(AST_MAGIC)
    w.write_u8(AST_VERSION_MAJOR)
    w.write_u8(AST_VERSION_MINOR)
}

/// Write a SourceLocation: line, column, offset, length as u32 LE values.
pub func write_source_location(w: BinaryWriter, loc: TmlSourceLocation) {
    w.write_u32(loc.line)
    w.write_u32(loc.column)
    w.write_u32(loc.offset)
    w.write_u32(loc.length)
}

/// Write a SourceSpan: start location, then end location.
pub func write_source_span(w: BinaryWriter, span: TmlSourceSpan) {
    write_source_location(w, span.start)
    write_source_location(w, span.end)
}

/// Write a Visibility: u8 (0=Private, 1=Public, 2=PubCrate).
pub func write_visibility(w: BinaryWriter, vis: TmlVisibility) {
    when vis {
        Private => w.write_u8(0),
        Public  => w.write_u8(1),
        PubCrate => w.write_u8(2),
    }
}

/// Write a TypePath: varint segment count + each segment string + span.
pub func write_type_path(w: BinaryWriter, path: TmlTypePath) {
    w.write_varint(path.segments.len())
    for i in 0 to path.segments.len() {
        w.write_str(path.segments.get(i))
    }
    write_source_span(w, path.span)
}

/// Write a literal kind: u8 tag + payload.
pub func write_literal_kind(w: BinaryWriter, lit: TmlLiteralKind) {
    when lit {
        LitInt(v)    => { w.write_u8(0); w.write_u64(v) },
        LitFloat(b)  => { w.write_u8(1); w.write_u64(b) },
        LitStr(s)    => { w.write_u8(2); w.write_str(s) },
        LitBool(b)   => { w.write_u8(3); w.write_bool(b) },
        LitChar(c)   => { w.write_u8(4); w.write_u32(c as I64) },
        LitNull      => w.write_u8(5),
    }
}

func write_unary_op(w: BinaryWriter, op: TmlUnaryOp) {
    when op {
        OpNeg    => w.write_u8(0),
        OpNot    => w.write_u8(1),
        OpBitNot => w.write_u8(2),
        OpRef    => w.write_u8(3),
        OpRefMut => w.write_u8(4),
        OpDeref  => w.write_u8(5),
        OpInc    => w.write_u8(6),
        OpDec    => w.write_u8(7),
    }
}

func write_binary_op(w: BinaryWriter, op: TmlBinaryOp) {
    when op {
        OpAdd          => w.write_u8(0),
        OpSub          => w.write_u8(1),
        OpMul          => w.write_u8(2),
        OpDiv          => w.write_u8(3),
        OpMod          => w.write_u8(4),
        OpEq           => w.write_u8(5),
        OpNe           => w.write_u8(6),
        OpLt           => w.write_u8(7),
        OpGt           => w.write_u8(8),
        OpLe           => w.write_u8(9),
        OpGe           => w.write_u8(10),
        OpAnd          => w.write_u8(11),
        OpOr           => w.write_u8(12),
        OpBitAnd       => w.write_u8(13),
        OpBitOr        => w.write_u8(14),
        OpBitXor       => w.write_u8(15),
        OpShl          => w.write_u8(16),
        OpShr          => w.write_u8(17),
        OpAssign       => w.write_u8(18),
        OpAddAssign    => w.write_u8(19),
        OpSubAssign    => w.write_u8(20),
        OpMulAssign    => w.write_u8(21),
        OpDivAssign    => w.write_u8(22),
        OpModAssign    => w.write_u8(23),
        OpBitAndAssign => w.write_u8(24),
        OpBitOrAssign  => w.write_u8(25),
        OpBitXorAssign => w.write_u8(26),
        OpShlAssign    => w.write_u8(27),
        OpShrAssign    => w.write_u8(28),
    }
}

func write_opt_heap_type(w: BinaryWriter, mt: Maybe[Heap[TmlType]]) {
    when mt {
        Just(t) => { w.write_u8(1); write_type(w, t.get()) },
        Nothing => w.write_u8(0),
    }
}

func write_opt_heap_expr(w: BinaryWriter, me: Maybe[Heap[TmlExpr]], depth: I64) {
    when me {
        Just(e) => { w.write_u8(1); write_expr(w, e.get(), depth) },
        Nothing => w.write_u8(0),
    }
}

func write_heap_type_list(w: BinaryWriter, types: List[Heap[TmlType]]) {
    w.write_varint(types.len())
    for i in 0 to types.len() {
        write_type(w, types.get(i).get())
    }
}

func write_interpolated_segment(w: BinaryWriter, seg: TmlInterpolatedSegment, depth: I64) {
    when seg.kind {
        SegText(s) => { w.write_u8(0); w.write_str(s) },
        SegExpr(e) => { w.write_u8(1); write_expr(w, e.get(), depth + 1) },
    }
    write_source_span(w, seg.span)
}

// ============================================================================
// Type serialization
// ============================================================================

/// Write a TmlType. Tag u8 + variant fields + span.
pub func write_type(w: BinaryWriter, ty: TmlType) {
    when ty {
        Named(n) => {
            w.write_u8(0)
            write_type_path(w, n.path)
            write_heap_type_list(w, n.args)
            write_source_span(w, n.span)
        },
        Ref(r) => {
            w.write_u8(1)
            write_type(w, r.inner.get())
            w.write_bool(r.is_mut)
            write_source_span(w, r.span)
        },
        Ptr(p) => {
            w.write_u8(2)
            write_type(w, p.inner.get())
            w.write_bool(p.is_mut)
            write_source_span(w, p.span)
        },
        Array(a) => {
            w.write_u8(3)
            write_type(w, a.inner.get())
            write_expr(w, a.size.get(), 0)
            write_source_span(w, a.span)
        },
        Slice(s) => {
            w.write_u8(4)
            write_type(w, s.inner.get())
            write_source_span(w, s.span)
        },
        Tuple(t) => {
            w.write_u8(5)
            write_heap_type_list(w, t.types)
            write_source_span(w, t.span)
        },
        Func(f) => {
            w.write_u8(6)
            write_heap_type_list(w, f.params)
            write_opt_heap_type(w, f.return_type)
            write_source_span(w, f.span)
        },
        Infer(span) => {
            w.write_u8(7)
            write_source_span(w, span)
        },
        Dyn(d) => {
            w.write_u8(8)
            w.write_varint(d.bounds.len())
            for i in 0 to d.bounds.len() {
                write_type_path(w, d.bounds.get(i))
            }
            write_source_span(w, d.span)
        },
        ImplBehavior(ib) => {
            w.write_u8(9)
            w.write_varint(ib.bounds.len())
            for i in 0 to ib.bounds.len() {
                write_type_path(w, ib.bounds.get(i))
            }
            write_source_span(w, ib.span)
        },
    }
}

// ============================================================================
// Pattern serialization
// ============================================================================

/// Write a TmlPattern. Tag u8 + variant fields.
pub func write_pattern(w: BinaryWriter, pat: TmlPattern) {
    when pat {
        Wildcard(span) => {
            w.write_u8(0)
            write_source_span(w, span)
        },
        Ident(ip) => {
            w.write_u8(1)
            w.write_str(ip.name)
            when ip.subpat {
                Just(sp) => { w.write_u8(1); write_pattern(w, sp.get()) },
                Nothing  => w.write_u8(0),
            }
            write_source_span(w, ip.span)
        },
        Literal(lp) => {
            w.write_u8(2)
            write_literal_kind(w, lp.value)
            write_source_span(w, lp.span)
        },
        Tuple(tp) => {
            w.write_u8(3)
            w.write_varint(tp.patterns.len())
            for i in 0 to tp.patterns.len() {
                write_pattern(w, tp.patterns.get(i).get())
            }
            write_source_span(w, tp.span)
        },
        Struct(sp) => {
            w.write_u8(4)
            write_type_path(w, sp.path)
            w.write_varint(sp.fields.len())
            for i in 0 to sp.fields.len() {
                let f = sp.fields.get(i)
                w.write_str(f.name)
                write_pattern(w, f.pat.get())
                write_source_span(w, f.span)
            }
            write_source_span(w, sp.span)
        },
        Enum(ep) => {
            w.write_u8(5)
            write_type_path(w, ep.path)
            w.write_varint(ep.args.len())
            for i in 0 to ep.args.len() {
                write_pattern(w, ep.args.get(i).get())
            }
            write_source_span(w, ep.span)
        },
        Or(op) => {
            w.write_u8(6)
            w.write_varint(op.alternatives.len())
            for i in 0 to op.alternatives.len() {
                write_pattern(w, op.alternatives.get(i).get())
            }
            write_source_span(w, op.span)
        },
        Range(rp) => {
            w.write_u8(7)
            write_literal_kind(w, rp.start)
            write_literal_kind(w, rp.end)
            w.write_bool(rp.inclusive)
            write_source_span(w, rp.span)
        },
        Array(ap) => {
            w.write_u8(8)
            w.write_varint(ap.patterns.len())
            for i in 0 to ap.patterns.len() {
                write_pattern(w, ap.patterns.get(i).get())
            }
            write_source_span(w, ap.span)
        },
    }
}

// ============================================================================
// Expression serialization (task 2.5 — recursive tree walk with depth)
// ============================================================================

/// Write a TmlExpr. Tag u8 + variant fields.
///
/// `depth` tracks nesting level; incremented at each recursive call so
/// callers can detect unexpectedly deep trees during debugging.
pub func write_expr(w: BinaryWriter, expr: TmlExpr, depth: I64) {
    when expr {
        Literal(le) => {
            w.write_u8(0)
            write_literal_kind(w, le.value)
            write_source_span(w, le.span)
        },
        Ident(ie) => {
            w.write_u8(1)
            w.write_str(ie.name)
            write_source_span(w, ie.span)
        },
        Unary(ue) => {
            w.write_u8(2)
            write_unary_op(w, ue.op)
            write_expr(w, ue.operand.get(), depth + 1)
            write_source_span(w, ue.span)
        },
        Binary(be) => {
            w.write_u8(3)
            write_binary_op(w, be.op)
            write_expr(w, be.left.get(), depth + 1)
            write_expr(w, be.right.get(), depth + 1)
            write_source_span(w, be.span)
        },
        Call(ce) => {
            w.write_u8(4)
            write_expr(w, ce.callee.get(), depth + 1)
            w.write_varint(ce.args.len())
            for i in 0 to ce.args.len() {
                write_expr(w, ce.args.get(i).get(), depth + 1)
            }
            write_source_span(w, ce.span)
        },
        MethodCall(mc) => {
            w.write_u8(5)
            write_expr(w, mc.receiver.get(), depth + 1)
            w.write_str(mc.method)
            write_heap_type_list(w, mc.type_args)
            w.write_varint(mc.args.len())
            for i in 0 to mc.args.len() {
                write_expr(w, mc.args.get(i).get(), depth + 1)
            }
            w.write_bool(mc.optional_chain)
            write_source_span(w, mc.span)
        },
        Field(fe) => {
            w.write_u8(6)
            write_expr(w, fe.object.get(), depth + 1)
            w.write_str(fe.field)
            w.write_bool(fe.optional_chain)
            write_source_span(w, fe.span)
        },
        Index(ie) => {
            w.write_u8(7)
            write_expr(w, ie.object.get(), depth + 1)
            write_expr(w, ie.index.get(), depth + 1)
            write_source_span(w, ie.span)
        },
        Tuple(te) => {
            w.write_u8(8)
            w.write_varint(te.elements.len())
            for i in 0 to te.elements.len() {
                write_expr(w, te.elements.get(i).get(), depth + 1)
            }
            write_source_span(w, te.span)
        },
        Array(ae) => {
            w.write_u8(9)
            when ae.kind {
                Elements(elems) => {
                    w.write_u8(0)
                    w.write_varint(elems.len())
                    for i in 0 to elems.len() {
                        write_expr(w, elems.get(i).get(), depth + 1)
                    }
                },
                Repeat(val, cnt) => {
                    w.write_u8(1)
                    write_expr(w, val.get(), depth + 1)
                    write_expr(w, cnt.get(), depth + 1)
                },
            }
            write_source_span(w, ae.span)
        },
        Struct(se) => {
            w.write_u8(10)
            write_type_path(w, se.path)
            when se.type_args {
                Just(targs) => { w.write_u8(1); write_heap_type_list(w, targs) },
                Nothing     => w.write_u8(0),
            }
            w.write_varint(se.fields.len())
            for i in 0 to se.fields.len() {
                let f = se.fields.get(i)
                w.write_str(f.name)
                write_expr(w, f.value.get(), depth + 1)
            }
            write_opt_heap_expr(w, se.base_expr, depth + 1)
            write_source_span(w, se.span)
        },
        If(ie) => {
            w.write_u8(11)
            write_expr(w, ie.condition.get(), depth + 1)
            write_expr(w, ie.then_branch.get(), depth + 1)
            write_opt_heap_expr(w, ie.else_branch, depth + 1)
            write_source_span(w, ie.span)
        },
        Ternary(te) => {
            w.write_u8(12)
            write_expr(w, te.condition.get(), depth + 1)
            write_expr(w, te.true_value.get(), depth + 1)
            write_expr(w, te.false_value.get(), depth + 1)
            write_source_span(w, te.span)
        },
        IfLet(ile) => {
            w.write_u8(13)
            write_pattern(w, ile.pattern.get())
            write_expr(w, ile.scrutinee.get(), depth + 1)
            write_expr(w, ile.then_branch.get(), depth + 1)
            write_opt_heap_expr(w, ile.else_branch, depth + 1)
            write_source_span(w, ile.span)
        },
        When(we) => {
            w.write_u8(14)
            write_expr(w, we.scrutinee.get(), depth + 1)
            w.write_varint(we.arms.len())
            for i in 0 to we.arms.len() {
                let arm = we.arms.get(i)
                write_pattern(w, arm.pattern.get())
                when arm.guard {
                    Just(g) => { w.write_u8(1); write_expr(w, g.get(), depth + 1) },
                    Nothing => w.write_u8(0),
                }
                write_expr(w, arm.body.get(), depth + 1)
                write_source_span(w, arm.span)
            }
            write_source_span(w, we.span)
        },
        Loop(le) => {
            w.write_u8(15)
            w.write_opt_str(le.label)
            when le.loop_var {
                Just(lv) => {
                    w.write_u8(1)
                    w.write_str(lv.name)
                    write_type(w, lv.ty.get())
                    write_source_span(w, lv.span)
                },
                Nothing => w.write_u8(0),
            }
            write_expr(w, le.condition.get(), depth + 1)
            write_expr(w, le.body.get(), depth + 1)
            write_source_span(w, le.span)
        },
        While(we) => {
            w.write_u8(16)
            w.write_opt_str(we.label)
            write_expr(w, we.condition.get(), depth + 1)
            write_expr(w, we.body.get(), depth + 1)
            write_source_span(w, we.span)
        },
        For(fe) => {
            w.write_u8(17)
            w.write_opt_str(fe.label)
            write_pattern(w, fe.pattern.get())
            write_expr(w, fe.iter.get(), depth + 1)
            write_expr(w, fe.body.get(), depth + 1)
            write_source_span(w, fe.span)
        },
        Block(be) => {
            w.write_u8(18)
            w.write_varint(be.stmts.len())
            for i in 0 to be.stmts.len() {
                write_stmt(w, be.stmts.get(i).get(), depth + 1)
            }
            write_opt_heap_expr(w, be.expr, depth + 1)
            write_source_span(w, be.span)
        },
        Return(re) => {
            w.write_u8(19)
            write_opt_heap_expr(w, re.value, depth + 1)
            write_source_span(w, re.span)
        },
        Break(be) => {
            w.write_u8(20)
            w.write_opt_str(be.label)
            write_opt_heap_expr(w, be.value, depth + 1)
            write_source_span(w, be.span)
        },
        Continue(ce) => {
            w.write_u8(21)
            w.write_opt_str(ce.label)
            write_source_span(w, ce.span)
        },
        Closure(cle) => {
            w.write_u8(22)
            w.write_varint(cle.params.len())
            for i in 0 to cle.params.len() {
                let p = cle.params.get(i)
                write_pattern(w, p.pattern.get())
                write_opt_heap_type(w, p.ty)
            }
            write_opt_heap_type(w, cle.return_type)
            write_expr(w, cle.body.get(), depth + 1)
            w.write_bool(cle.is_move)
            write_source_span(w, cle.span)
        },
        Range(re) => {
            w.write_u8(23)
            write_opt_heap_expr(w, re.start, depth + 1)
            write_opt_heap_expr(w, re.end, depth + 1)
            w.write_bool(re.inclusive)
            write_source_span(w, re.span)
        },
        Cast(ce) => {
            w.write_u8(24)
            write_expr(w, ce.expr.get(), depth + 1)
            write_type(w, ce.target.get())
            write_source_span(w, ce.span)
        },
        Is(ie) => {
            w.write_u8(25)
            write_expr(w, ie.expr.get(), depth + 1)
            write_type(w, ie.target.get())
            write_source_span(w, ie.span)
        },
        Try(te) => {
            w.write_u8(26)
            write_expr(w, te.expr.get(), depth + 1)
            write_source_span(w, te.span)
        },
        Await(ae) => {
            w.write_u8(27)
            write_expr(w, ae.expr.get(), depth + 1)
            write_source_span(w, ae.span)
        },
        Throw(te) => {
            w.write_u8(28)
            write_expr(w, te.expr.get(), depth + 1)
            write_source_span(w, te.span)
        },
        Path(pe) => {
            w.write_u8(29)
            write_type_path(w, pe.path)
            when pe.type_args {
                Just(targs) => { w.write_u8(1); write_heap_type_list(w, targs) },
                Nothing     => w.write_u8(0),
            }
            write_source_span(w, pe.span)
        },
        Lowlevel(lle) => {
            w.write_u8(30)
            w.write_varint(lle.stmts.len())
            for i in 0 to lle.stmts.len() {
                write_stmt(w, lle.stmts.get(i).get(), depth + 1)
            }
            write_opt_heap_expr(w, lle.expr, depth + 1)
            write_source_span(w, lle.span)
        },
        InterpolatedString(ise) => {
            w.write_u8(31)
            w.write_varint(ise.segments.len())
            for i in 0 to ise.segments.len() {
                write_interpolated_segment(w, ise.segments.get(i), depth)
            }
            write_source_span(w, ise.span)
        },
        TemplateLiteral(tle) => {
            w.write_u8(32)
            w.write_varint(tle.segments.len())
            for i in 0 to tle.segments.len() {
                write_interpolated_segment(w, tle.segments.get(i), depth)
            }
            write_source_span(w, tle.span)
        },
        Base(be) => {
            w.write_u8(33)
            w.write_str(be.member)
            write_heap_type_list(w, be.type_args)
            w.write_varint(be.args.len())
            for i in 0 to be.args.len() {
                write_expr(w, be.args.get(i).get(), depth + 1)
            }
            w.write_bool(be.is_method_call)
            write_source_span(w, be.span)
        },
        New(ne) => {
            w.write_u8(34)
            write_type_path(w, ne.class_type)
            when ne.type_args {
                Just(targs) => { w.write_u8(1); write_heap_type_list(w, targs) },
                Nothing     => w.write_u8(0),
            }
            w.write_varint(ne.args.len())
            for i in 0 to ne.args.len() {
                write_expr(w, ne.args.get(i).get(), depth + 1)
            }
            write_source_span(w, ne.span)
        },
    }
}

// ============================================================================
// Statement serialization
// ============================================================================

/// Write a TmlStmt. Tag u8 + variant fields.
pub func write_stmt(w: BinaryWriter, stmt: TmlStmt, depth: I64) {
    when stmt {
        Let(ls) => {
            w.write_u8(0)
            write_pattern(w, ls.pattern.get())
            write_opt_heap_type(w, ls.ty)
            write_opt_heap_expr(w, ls.init, depth + 1)
            write_source_span(w, ls.span)
        },
        Var(vs) => {
            w.write_u8(1)
            w.write_str(vs.name)
            write_opt_heap_type(w, vs.ty)
            write_opt_heap_expr(w, vs.init, depth + 1)
            write_source_span(w, vs.span)
        },
        LetElse(les) => {
            w.write_u8(2)
            write_pattern(w, les.pattern.get())
            write_expr(w, les.init.get(), depth + 1)
            write_expr(w, les.else_body.get(), depth + 1)
            write_source_span(w, les.span)
        },
        Expr(e) => {
            w.write_u8(3)
            write_expr(w, e.get(), depth + 1)
        },
        Decl(d) => {
            w.write_u8(4)
            write_decl(w, d.get())
        },
    }
}

// ============================================================================
// Declaration serialization (task 2.4 — each decl with type tag)
// ============================================================================

func write_generic_param(w: BinaryWriter, gp: TmlGenericParam) {
    w.write_str(gp.name)
    w.write_varint(gp.bounds.len())
    for i in 0 to gp.bounds.len() {
        write_type_path(w, gp.bounds.get(i))
    }
    write_source_span(w, gp.span)
}

func write_generic_params(w: BinaryWriter, generics: List[TmlGenericParam]) {
    w.write_varint(generics.len())
    for i in 0 to generics.len() {
        write_generic_param(w, generics.get(i))
    }
}

func write_func_param(w: BinaryWriter, fp: TmlFuncParam) {
    w.write_str(fp.name)
    write_type(w, fp.ty.get())
    w.write_bool(fp.is_this)
    w.write_bool(fp.is_mut)
    write_source_span(w, fp.span)
}

func write_struct_field(w: BinaryWriter, sf: TmlStructField) {
    w.write_str(sf.name)
    write_type(w, sf.ty.get())
    write_visibility(w, sf.visibility)
    write_source_span(w, sf.span)
}

/// Write a TmlFuncDecl's fields (shared by standalone funcs and methods).
pub func write_func_decl(w: BinaryWriter, fd: TmlFuncDecl) {
    w.write_str(fd.name)
    write_visibility(w, fd.visibility)
    write_generic_params(w, fd.generics)
    w.write_varint(fd.params.len())
    for i in 0 to fd.params.len() {
        write_func_param(w, fd.params.get(i))
    }
    write_opt_heap_type(w, fd.return_type)
    when fd.body {
        Just(b) => { w.write_u8(1); write_expr(w, b.get(), 0) },
        Nothing => w.write_u8(0),
    }
    w.write_bool(fd.is_async)
    w.write_bool(fd.is_override)
    write_source_span(w, fd.span)
}

/// Write a TmlDecl. Tag u8 + variant fields.
///
/// Tag mapping (matches `Decl` variant order in `compiler/include/parser/ast.hpp`):
/// 0=Func 1=Struct 2=Union 3=Enum 4=Trait 5=Impl 6=TypeAlias
/// 7=Const 8=Use 9=Mod 10=Class 11=Interface 12=Namespace
pub func write_decl(w: BinaryWriter, decl: TmlDecl) {
    when decl {
        Func(fd) => {
            w.write_u8(0)
            write_func_decl(w, fd)
        },
        Struct(sd) => {
            w.write_u8(1)
            w.write_str(sd.name)
            write_visibility(w, sd.visibility)
            write_generic_params(w, sd.generics)
            w.write_varint(sd.fields.len())
            for i in 0 to sd.fields.len() {
                write_struct_field(w, sd.fields.get(i))
            }
            write_source_span(w, sd.span)
        },
        Union(ud) => {
            w.write_u8(2)
            w.write_str(ud.name)
            write_visibility(w, ud.visibility)
            write_generic_params(w, ud.generics)
            w.write_varint(ud.fields.len())
            for i in 0 to ud.fields.len() {
                write_struct_field(w, ud.fields.get(i))
            }
            write_source_span(w, ud.span)
        },
        Enum(ed) => {
            w.write_u8(3)
            w.write_str(ed.name)
            write_visibility(w, ed.visibility)
            write_generic_params(w, ed.generics)
            w.write_varint(ed.variants.len())
            for i in 0 to ed.variants.len() {
                let v = ed.variants.get(i)
                w.write_str(v.name)
                write_heap_type_list(w, v.fields)
                write_source_span(w, v.span)
            }
            write_source_span(w, ed.span)
        },
        Trait(td) => {
            w.write_u8(4)
            w.write_str(td.name)
            write_visibility(w, td.visibility)
            write_generic_params(w, td.generics)
            w.write_varint(td.supertraits.len())
            for i in 0 to td.supertraits.len() {
                write_type_path(w, td.supertraits.get(i))
            }
            w.write_varint(td.methods.len())
            for i in 0 to td.methods.len() {
                write_func_decl(w, td.methods.get(i))
            }
            write_source_span(w, td.span)
        },
        Impl(id) => {
            w.write_u8(5)
            write_type(w, id.ty.get())
            when id.behavior_path {
                Just(b) => { w.write_u8(1); write_type_path(w, b) },
                Nothing => w.write_u8(0),
            }
            write_generic_params(w, id.generics)
            w.write_varint(id.methods.len())
            for i in 0 to id.methods.len() {
                write_func_decl(w, id.methods.get(i))
            }
            write_source_span(w, id.span)
        },
        TypeAlias(ta) => {
            w.write_u8(6)
            w.write_str(ta.name)
            write_visibility(w, ta.visibility)
            write_generic_params(w, ta.generics)
            write_type(w, ta.ty.get())
            write_source_span(w, ta.span)
        },
        Const(cd) => {
            w.write_u8(7)
            w.write_str(cd.name)
            write_visibility(w, cd.visibility)
            write_type(w, cd.ty.get())
            write_expr(w, cd.value.get(), 0)
            write_source_span(w, cd.span)
        },
        Use(ud) => {
            w.write_u8(8)
            w.write_varint(ud.path.segments.len())
            for i in 0 to ud.path.segments.len() {
                w.write_str(ud.path.segments.get(i))
            }
            w.write_opt_str(ud.path.alias)
            write_visibility(w, ud.visibility)
            write_source_span(w, ud.span)
        },
        Mod(md) => {
            w.write_u8(9)
            w.write_str(md.name)
            write_visibility(w, md.visibility)
            w.write_varint(md.items.len())
            for i in 0 to md.items.len() {
                write_decl(w, md.items.get(i).get())
            }
            write_source_span(w, md.span)
        },
        Class(cd) => {
            w.write_u8(10)
            w.write_str(cd.name)
            write_visibility(w, cd.visibility)
            write_generic_params(w, cd.generics)
            when cd.parent {
                Just(p) => { w.write_u8(1); write_type_path(w, p) },
                Nothing => w.write_u8(0),
            }
            w.write_varint(cd.interfaces.len())
            for i in 0 to cd.interfaces.len() {
                write_type_path(w, cd.interfaces.get(i))
            }
            w.write_varint(cd.fields.len())
            for i in 0 to cd.fields.len() {
                let f = cd.fields.get(i)
                w.write_str(f.name)
                write_type(w, f.ty.get())
                write_visibility(w, f.visibility)
                write_source_span(w, f.span)
            }
            w.write_varint(cd.methods.len())
            for i in 0 to cd.methods.len() {
                write_func_decl(w, cd.methods.get(i))
            }
            write_source_span(w, cd.span)
        },
        Interface(ifd) => {
            w.write_u8(11)
            w.write_str(ifd.name)
            write_visibility(w, ifd.visibility)
            write_generic_params(w, ifd.generics)
            w.write_varint(ifd.methods.len())
            for i in 0 to ifd.methods.len() {
                write_func_decl(w, ifd.methods.get(i))
            }
            write_source_span(w, ifd.span)
        },
        Namespace(nd) => {
            w.write_u8(12)
            w.write_str(nd.name)
            write_visibility(w, nd.visibility)
            w.write_varint(nd.items.len())
            for i in 0 to nd.items.len() {
                write_decl(w, nd.items.get(i).get())
            }
            write_source_span(w, nd.span)
        },
    }
}

// ============================================================================
// Module serialization — top-level entry point
// ============================================================================

/// Serialize an entire TML module to binary.
///
/// Writes the AST header (magic + version), module name, doc comments,
/// module span, and all top-level declarations.
/// This is the top-level entry point for AST serialization.
///
/// # Example
///
/// ```tml
/// let w = BinaryWriter::new(4096)
/// write_module(w, my_module)
/// let buf = w.finish()
/// // buf now contains the full binary AST
/// ```
pub func write_module(w: BinaryWriter, module: TmlModule) {
    write_ast_header(w)
    w.write_str(module.name)
    w.write_varint(module.docs.len())
    for i in 0 to module.docs.len() {
        w.write_str(module.docs.get(i))
    }
    write_source_span(w, module.span)
    w.write_varint(module.decls.len())
    for i in 0 to module.decls.len() {
        write_decl(w, module.decls.get(i).get())
    }
}
