/// Mirrors `Expr` variant in `compiler/include/parser/ast_exprs.hpp`.
///
/// Recursive references use `Heap[TmlExpr]` to break the recursion cycle.
pub type TmlExpr {
    Literal(TmlLiteralExpr),
    Ident(TmlIdentExpr),
    Unary(TmlUnaryExpr),
    Binary(TmlBinaryExpr),
    Call(TmlCallExpr),
    MethodCall(TmlMethodCallExpr),
    Field(TmlFieldExpr),
    Index(TmlIndexExpr),
    Tuple(TmlTupleExpr),
    Array(TmlArrayExpr),
    Struct(TmlStructExpr),
    If(TmlIfExpr),
    Ternary(TmlTernaryExpr),
    IfLet(TmlIfLetExpr),
    When(TmlWhenExpr),
    Loop(TmlLoopExpr),
    While(TmlWhileExpr),
    For(TmlForExpr),
    Block(TmlBlockExpr),
    Return(TmlReturnExpr),
    Break(TmlBreakExpr),
    Continue(TmlContinueExpr),
    Closure(TmlClosureExpr),
    Range(TmlRangeExpr),
    Cast(TmlCastExpr),
    Is(TmlIsExpr),
    Try(TmlTryExpr),
    Await(TmlAwaitExpr),
    Throw(TmlThrowExpr),
    Path(TmlPathExpr),
    Lowlevel(TmlLowlevelExpr),
    InterpolatedString(TmlInterpolatedStringExpr),
    TemplateLiteral(TmlTemplateLiteralExpr),
    Base(TmlBaseExpr),
    New(TmlNewExpr),
}

