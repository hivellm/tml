//! AST binary serialization — TML mirror types and write functions.
//!
//! This module defines TML types that mirror the C++ parser AST
//! (`compiler/include/parser/`), along with serialization functions that
//! write them to a `BinaryWriter`.
//!
//! # File Layout
//!
//! ```
//! u32  magic         = 0x41535420  ("AST ")
//! u8   version_major = 1
//! u8   version_minor = 0
//! str  module_name
//! varint doc_count
//! str[doc_count]
//! SourceSpan module_span
//! varint decl_count
//! Decl[decl_count]
//! ```
//!
//! # Tag Tables
//!
//! **DeclTag**:  0=Func 1=Struct 2=Union 3=Enum 4=Trait 5=Impl
//!               6=TypeAlias 7=Const 8=Use 9=Mod 10=Class 11=Interface 12=Namespace
//!
//! **ExprTag**:  0=Literal 1=Ident 2=Unary 3=Binary 4=Call 5=MethodCall 6=Field
//!               7=Index 8=Tuple 9=Array 10=Struct 11=If 12=Ternary 13=IfLet
//!               14=When 15=Loop 16=While 17=For 18=Block 19=Return 20=Break
//!               21=Continue 22=Closure 23=Range 24=Cast 25=Is 26=Try 27=Await
//!               28=Throw 29=Path 30=Lowlevel 31=InterpolatedString
//!               32=TemplateLiteral 33=Base 34=New
//!
//! **StmtTag**:  0=Let 1=Var 2=LetElse 3=Expr 4=Decl
//!
//! **PatternTag**: 0=Wildcard 1=Ident 2=Literal 3=Tuple 4=Struct 5=Enum
//!                 6=Or 7=Range 8=Array
//!
//! **TypeTag**:  0=Named 1=Ref 2=Ptr 3=Array 4=Slice 5=Tuple 6=Func
//!               7=Infer 8=Dyn 9=ImplBehavior

use compiler::serial::writer::BinaryWriter
use std::collections::list::List
use core::alloc::heap::Heap
use core::str

// ============================================================================
// Constants
// ============================================================================

/// Magic bytes for the AST binary format: "AST " (0x41535420 LE).
pub const AST_MAGIC: I64 = 0x41535420
/// Current format major version.
pub const AST_VERSION_MAJOR: I32 = 1
/// Current format minor version.
pub const AST_VERSION_MINOR: I32 = 0

// ============================================================================
// Source Location
// ============================================================================

/// Mirrors `SourceLocation` in `compiler/include/common.hpp`.
pub type TmlSourceLocation {
    line: I64,
    column: I64,
    offset: I64,
    length: I64,
}

/// Mirrors `SourceSpan` in `compiler/include/common.hpp`.
pub type TmlSourceSpan {
    start: TmlSourceLocation,
    end: TmlSourceLocation,
}

// ============================================================================
// Visibility
// ============================================================================

/// Mirrors `Visibility` in `compiler/include/parser/ast_decls.hpp`.
pub type TmlVisibility {
    Private,
    Public,
    PubCrate,
}

// ============================================================================
// Literal kind
// ============================================================================

/// Represents the value carried by a `LiteralExpr`.
pub type TmlLiteralKind {
    LitInt(I64),
    LitFloat(I64),    // raw bit pattern of F64, reinterpreted as I64
    LitStr(Str),
    LitBool(Bool),
    LitChar(I32),
    LitNull,
}

// ============================================================================
// Type AST — mirrors ast_types.hpp
// ============================================================================

/// Mirrors `TypePath` in `compiler/include/parser/ast_types.hpp`.
pub type TmlTypePath {
    segments: List[Str],
    span: TmlSourceSpan,
}

pub type TmlNamedType {
    path: TmlTypePath,
    args: List[Heap[TmlType]],
    span: TmlSourceSpan,
}

pub type TmlRefType {
    inner: Heap[TmlType],
    is_mut: Bool,
    span: TmlSourceSpan,
}

pub type TmlPtrType {
    inner: Heap[TmlType],
    is_mut: Bool,
    span: TmlSourceSpan,
}

pub type TmlArrayType {
    inner: Heap[TmlType],
    size: Heap[TmlExpr],
    span: TmlSourceSpan,
}

pub type TmlSliceType {
    inner: Heap[TmlType],
    span: TmlSourceSpan,
}

pub type TmlTupleType {
    types: List[Heap[TmlType]],
    span: TmlSourceSpan,
}

pub type TmlFuncType {
    params: List[Heap[TmlType]],
    return_type: Maybe[Heap[TmlType]],
    span: TmlSourceSpan,
}

pub type TmlDynType {
    bounds: List[TmlTypePath],
    span: TmlSourceSpan,
}

pub type TmlImplBehaviorType {
    bounds: List[TmlTypePath],
    span: TmlSourceSpan,
}

/// Mirrors `Type` variant in `compiler/include/parser/ast_types.hpp`.
pub type TmlType {
    Named(TmlNamedType),
    Ref(TmlRefType),
    Ptr(TmlPtrType),
    Array(TmlArrayType),
    Slice(TmlSliceType),
    Tuple(TmlTupleType),
    Func(TmlFuncType),
    Infer(TmlSourceSpan),
    Dyn(TmlDynType),
    ImplBehavior(TmlImplBehaviorType),
}

// ============================================================================
// Pattern AST — mirrors ast_patterns.hpp
// ============================================================================

pub type TmlIdentPattern {
    name: Str,
    subpat: Maybe[Heap[TmlPattern]],
    span: TmlSourceSpan,
}

pub type TmlLiteralPattern {
    value: TmlLiteralKind,
    span: TmlSourceSpan,
}

pub type TmlTuplePattern {
    patterns: List[Heap[TmlPattern]],
    span: TmlSourceSpan,
}

pub type TmlFieldPattern {
    name: Str,
    pat: Heap[TmlPattern],
    span: TmlSourceSpan,
}

pub type TmlStructPattern {
    path: TmlTypePath,
    fields: List[TmlFieldPattern],
    span: TmlSourceSpan,
}

pub type TmlEnumPattern {
    path: TmlTypePath,
    args: List[Heap[TmlPattern]],
    span: TmlSourceSpan,
}

pub type TmlOrPattern {
    alternatives: List[Heap[TmlPattern]],
    span: TmlSourceSpan,
}

pub type TmlRangePattern {
    start: TmlLiteralKind,
    end: TmlLiteralKind,
    inclusive: Bool,
    span: TmlSourceSpan,
}

pub type TmlArrayPattern {
    patterns: List[Heap[TmlPattern]],
    span: TmlSourceSpan,
}

/// Mirrors `Pattern` variant in `compiler/include/parser/ast_patterns.hpp`.
pub type TmlPattern {
    Wildcard(TmlSourceSpan),
    Ident(TmlIdentPattern),
    Literal(TmlLiteralPattern),
    Tuple(TmlTuplePattern),
    Struct(TmlStructPattern),
    Enum(TmlEnumPattern),
    Or(TmlOrPattern),
    Range(TmlRangePattern),
    Array(TmlArrayPattern),
}

