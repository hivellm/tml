//! GOT (Global Offset Table) and PLT (Procedure Linkage Table) construction.
//!
//! GOT[0] = .dynamic address, GOT[1] = link_map (filled by ld.so), GOT[2] = _dl_runtime_resolve.
//! Dynamic symbols get one GOT slot each starting at index 3.
//!
//! PLT[0] = resolver header (push GOT+8, jmp GOT+16).
//! PLT[N] = per-symbol stub (jmp *GOT[N], push index, jmp PLT[0]).
//!
//! Phase 22b — items 4.1–4.2.

use std::collections::list::List
use std::collections::hashmap::HashMap

// ============================================================================
// GOT (item 4.1)
// ============================================================================

pub type Got {
    entries: List[Str],      // symbol name per slot (slots 0-2 are reserved)
    offsets: HashMap[Str, I64], // symbol name → byte offset in GOT
    size_box: List[I64]      // [0] = total GOT size (boxed for mutation through copies)
}

pub func got_new() -> Got {
    let sz = List[I64]::new(1 as I64)
    sz.push(24 as I64)  // 3 reserved slots × 8 bytes
    return Got { entries: List[Str]::new(32), offsets: HashMap[Str, I64]::new(32), size_box: sz }
}

/// Get current GOT size.
pub func got_size(got: Got) -> I64 { return got.size_box.get(0) }

/// Allocate a GOT slot for a dynamic symbol. Returns the byte offset.
pub func got_alloc(got: Got, sym: Str) -> I64 {
    if got.offsets.has(sym) { return got.offsets.get(sym) }
    let offset: I64 = got.size_box.get(0)
    got.offsets.set(sym, offset)
    got.entries.push(sym)
    got.size_box.set(0, offset + 8)
    return offset
}

/// Get the GOT offset for a symbol, or -1 if not allocated.
pub func got_offset_of(got: Got, sym: Str) -> I64 {
    if got.offsets.has(sym) { return got.offsets.get(sym) }
    return -1 as I64
}

/// Emit GOT bytes (all zeros initially — ld.so fills at runtime).
pub func got_emit(got: Got) -> List[I64] {
    let sz: I64 = got.size_box.get(0)
    let data = List[I64]::new(sz)
    for _ in 0 to sz { data.push(0) }
    return data
}

// ============================================================================
// PLT (item 4.2)
// ============================================================================

pub type Plt {
    stubs: List[PltStub],
    size_box: List[I64]    // [0] = total PLT size (boxed for mutation)
}

pub type PltStub {
    sym_name: Str,
    got_offset: I64,
    plt_index: I64
}

pub func plt_new() -> Plt {
    let sz = List[I64]::new(1 as I64)
    sz.push(16 as I64)  // PLT[0] header = 16 bytes
    return Plt { stubs: List[PltStub]::new(16), size_box: sz }
}

/// Get current PLT size.
pub func plt_size(plt: Plt) -> I64 { return plt.size_box.get(0) }

/// Add a PLT entry for a dynamic symbol. Returns the PLT offset.
pub func plt_add(plt: Plt, sym: Str, got_offset: I64) -> I64 {
    let offset: I64 = plt.size_box.get(0)
    plt.stubs.push(PltStub { sym_name: sym, got_offset: got_offset, plt_index: plt.stubs.len() as I64 })
    plt.size_box.set(0, offset + 16)
    return offset
}

/// Emit PLT bytes.
pub func plt_emit(plt: Plt, got_rva: I64, plt_rva: I64) -> List[I64] {
    let data = List[I64]::new(plt.size_box.get(0))

    // PLT[0] header: push [GOT+8], jmp [GOT+16]
    // FF 35 <disp32>  — push qword [rip + GOT+8 - (plt_rva + 6)]
    let got8_disp: I64 = (got_rva + 8) - (plt_rva + 6)
    data.push(0xFF)
    data.push(0x35)
    push_i32_le(data, got8_disp)
    // FF 25 <disp32>  — jmp [rip + GOT+16 - (plt_rva + 12)]
    let got16_disp: I64 = (got_rva + 16) - (plt_rva + 12)
    data.push(0xFF)
    data.push(0x25)
    push_i32_le(data, got16_disp)
    // 4 bytes NOP padding
    data.push(0x0F)
    data.push(0x1F)
    data.push(0x40)
    data.push(0x00)

    // PLT[N] stubs
    let sc: I64 = plt.stubs.len() as I64
    for i in 0 to sc {
        let stub: PltStub = plt.stubs.get(i)
        let stub_rva: I64 = plt_rva + 16 + i * 16

        // jmp *[rip + GOT_entry - (stub_rva + 6)]
        let jmp_disp: I64 = (got_rva + stub.got_offset) - (stub_rva + 6)
        data.push(0xFF)
        data.push(0x25)
        push_i32_le(data, jmp_disp)

        // push <index>
        data.push(0x68)
        push_i32_le(data, i)

        // jmp PLT[0] — E9 <disp32>
        let plt0_disp: I64 = plt_rva - (stub_rva + 16)
        data.push(0xE9)
        push_i32_le(data, plt0_disp)

        // 1 byte NOP (pad to 16)
        data.push(0x90)
    }

    return data
}

func push_i32_le(buf: List[I64], v: I64) {
    buf.push(v & 0xFF)
    buf.push((v >> 8) & 0xFF)
    buf.push((v >> 16) & 0xFF)
    buf.push((v >> 24) & 0xFF)
}
