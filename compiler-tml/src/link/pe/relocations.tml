//! COFF relocation processing — patches section data with resolved symbol addresses.
//!
//! Supports AMD64 relocation types: ADDR64, REL32, SECREL, SECTION.
//! Reference: Microsoft PE/COFF Specification §5.2.1.
//!
//! Phase 22a — items 3.1–3.4.

use compiler::link::pe::coff_parser::*
use compiler::link::pe::symbol_table::*
use std::collections::list::List

// ============================================================================
// Relocation application (items 3.1–3.4)
// ============================================================================

/// Apply all relocations in a section, patching the section's data buffer in place.
/// `section_rva` is the RVA assigned to this section in the PE image.
/// `symbol_rvas` maps symbol name → absolute RVA in the image.
pub func apply_relocations(
    section: CoffParsedSection,
    symbols: List[CoffParsedSymbol],
    section_rva: I64,
    symbol_rvas: LinkerSymbolTable,
    image_base_val: I64,
    errors: List[Str]
) {
    let rc: I64 = section.relocations.len() as I64
    for i in 0 to rc {
        let rel: CoffParsedReloc = section.relocations.get(i)
        let reloc_offset: I64 = rel.virtual_address

        // Look up target symbol
        if rel.symbol_index >= (symbols.len() as I64) {
            errors.push("relocation references invalid symbol index " + rel.symbol_index.to_string())
            continue
        }
        let target_sym: CoffParsedSymbol = symbols.get(rel.symbol_index)
        let target_name: Str = target_sym.name

        if not symbol_rvas.symbols.has(target_name) {
            errors.push("unresolved symbol in relocation: " + target_name)
            continue
        }
        let target_entry: SymbolEntry = symbol_rvas.symbols.get(target_name)
        let target_rva: I64 = target_entry.offset

        when rel.reloc_type {
            // (3.2) IMAGE_REL_AMD64_ADDR64 — absolute 64-bit address
            1 => {
                let abs_addr: I64 = image_base_val + target_rva
                write_u64_le(section.data, reloc_offset, abs_addr)
            },
            // IMAGE_REL_AMD64_ADDR32 — absolute 32-bit address
            2 => {
                let abs_addr: I64 = image_base_val + target_rva
                write_u32_le(section.data, reloc_offset, abs_addr)
            },
            // IMAGE_REL_AMD64_ADDR32NB — RVA (no base)
            3 => {
                write_u32_le(section.data, reloc_offset, target_rva)
            },
            // (3.3) IMAGE_REL_AMD64_REL32 — PC-relative 32-bit offset
            4 => {
                let reloc_rva: I64 = section_rva + reloc_offset
                let delta: I64 = target_rva - (reloc_rva + 4)
                // Verify fits in I32
                if delta > 2147483647 or delta < -2147483648 {
                    errors.push("REL32 relocation overflow for " + target_name + ": delta=" + delta.to_string())
                } else {
                    write_u32_le(section.data, reloc_offset, delta)
                }
            },
            // (3.4) IMAGE_REL_AMD64_SECTION — 16-bit section index
            10 => {
                write_u16_le(section.data, reloc_offset, target_entry.section_index)
            },
            // (3.4) IMAGE_REL_AMD64_SECREL — 32-bit section-relative offset
            11 => {
                write_u32_le(section.data, reloc_offset, target_entry.offset)
            },
            _ => {
                errors.push("unsupported relocation type " + rel.reloc_type.to_string() + " for " + target_name)
            }
        }
    }
}

// ============================================================================
// Little-endian write helpers
// ============================================================================

func write_u16_le(data: List[I64], offset: I64, val: I64) {
    data.set(offset, val & 0xFF)
    data.set(offset + 1, (val >> 8) & 0xFF)
}

func write_u32_le(data: List[I64], offset: I64, val: I64) {
    data.set(offset, val & 0xFF)
    data.set(offset + 1, (val >> 8) & 0xFF)
    data.set(offset + 2, (val >> 16) & 0xFF)
    data.set(offset + 3, (val >> 24) & 0xFF)
}

func write_u64_le(data: List[I64], offset: I64, val: I64) {
    write_u32_le(data, offset, val)
    write_u32_le(data, offset + 4, val >> 32)
}
