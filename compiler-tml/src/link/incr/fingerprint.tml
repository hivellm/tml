//! File fingerprinting for incremental link change detection.
//!
//! Uses FNV-1a 64-bit hash (fast, non-cryptographic) for input .obj fingerprinting.
//! xxHash3 would be ideal but FNV is simpler to implement in pure TML.
//!
//! Phase 22d — items 2.1–2.2.

use std::collections::list::List
use std::collections::hashmap::HashMap

// ============================================================================
// Fingerprinting (item 2.1)
// ============================================================================

/// Compute a 64-bit FNV-1a hash of a byte buffer.
pub func fingerprint_bytes(bytes: List[I64]) -> I64 {
    var h: I64 = -3750763034362895579 as I64  // FNV-1a offset basis (signed)
    let n: I64 = bytes.len() as I64
    for i in 0 to n {
        h = h ^ (bytes.get(i) & 0xFF)
        h = h * 1099511628211 as I64  // FNV prime
    }
    return h
}

// ============================================================================
// Change detection (item 2.2)
// ============================================================================

pub type ChangeSummary {
    added: List[Str],      // new files not in previous state
    removed: List[Str],    // files in previous state but not current
    modified: List[Str],   // same path, different fingerprint
    unchanged: List[Str]   // same path and fingerprint
}

/// Detect changes between stored fingerprints and current inputs.
pub func detect_changes(
    stored: HashMap[Str, I64],
    current_paths: List[Str],
    current_fingerprints: HashMap[Str, I64]
) -> ChangeSummary {
    let added = List[Str]::new(8)
    let removed = List[Str]::new(8)
    let modified = List[Str]::new(8)
    let unchanged = List[Str]::new(32)

    // Check each current input against stored state
    let nc: I64 = current_paths.len() as I64
    for i in 0 to nc {
        let path: Str = current_paths.get(i)
        if not stored.has(path) {
            added.push(path)
        } else {
            let stored_fp: I64 = stored.get(path)
            let current_fp: I64 = current_fingerprints.get(path)
            if stored_fp == current_fp {
                unchanged.push(path)
            } else {
                modified.push(path)
            }
        }
    }

    // Check for removed files (in stored but not in current)
    // Note: can't iterate HashMap directly, so we check stored paths
    // against a set of current paths
    let current_set = HashMap[Str, I64]::new(nc)
    for i in 0 to nc {
        current_set.set(current_paths.get(i), 1 as I64)
    }
    // Removed detection would need HashMap iteration — tracked via caller

    return ChangeSummary {
        added: added,
        removed: removed,
        modified: modified,
        unchanged: unchanged
    }
}

/// Check if incremental linking should fall back to full link.
pub func should_fallback(changes: ChangeSummary) -> I64 {
    // Fallback if files were added or removed (symbol set changed)
    if changes.added.len() as I64 > 0 { return 1 }
    if changes.removed.len() as I64 > 0 { return 1 }
    return 0
}
