//! Link state database — persists link results for incremental re-linking.
//!
//! Records input fingerprints, symbol table, section layout, and relocation log.
//! Saved as `.link-state` alongside the output binary.
//!
//! Phase 22d — items 1.1–1.4.

use std::collections::list::List
use std::collections::hashmap::HashMap

// ============================================================================
// Link state types (item 1.1)
// ============================================================================

pub const LINK_STATE_VERSION: I64 = 1

/// Record of an applied relocation — for delta recomputation.
pub type AppliedReloc {
    source_section: I64,   // index of section containing the relocation site
    source_offset: I64,    // byte offset within that section
    target_symbol: Str,    // name of symbol being referenced
    addend: I64,
    reloc_type: I64,
    file_offset: I64       // byte offset in the output binary where bytes were written
}

/// Section layout record from previous link.
pub type SectionRecord {
    name: Str,
    start_rva: I64,
    file_offset: I64,
    size: I64,
    flags: I64
}

/// Symbol entry stored in link state.
pub type LinkSymbol {
    name: Str,
    section_index: I64,
    offset: I64,
    size: I64,
    object_path: Str
}

/// Complete link state for incremental re-linking.
pub type LinkState {
    version: I64,
    input_fingerprints: HashMap[Str, I64],   // path → xxHash3 fingerprint
    symbols: HashMap[Str, LinkSymbol],
    sections: List[SectionRecord],
    relocation_log: List[AppliedReloc],
    output_path: Str
}

/// Create a new empty link state.
pub func link_state_new(output: Str) -> LinkState {
    return LinkState {
        version: LINK_STATE_VERSION,
        input_fingerprints: HashMap[Str, I64]::new(128),
        symbols: HashMap[Str, LinkSymbol]::new(256),
        sections: List[SectionRecord]::new(16),
        relocation_log: List[AppliedReloc]::new(256),
        output_path: output
    }
}

// ============================================================================
// Serialization (items 1.2–1.3)
// ============================================================================

/// Serialize link state to a binary buffer (tag-length-value format).
pub func link_state_save(st: LinkState) -> List[I64] {
    let buf = List[I64]::new(4096)
    // Magic: "TMLS" (TML Link State)
    buf.push(0x54)  // 'T'
    buf.push(0x4D)  // 'M'
    buf.push(0x4C)  // 'L'
    buf.push(0x53)  // 'S'
    // Version
    write_u32(buf, st.version)

    // Section count + section records
    let sc: I64 = st.sections.len() as I64
    write_u32(buf, sc)
    for i in 0 to sc {
        let sec: SectionRecord = st.sections.get(i)
        write_str(buf, sec.name)
        write_u64(buf, sec.start_rva)
        write_u64(buf, sec.file_offset)
        write_u64(buf, sec.size)
        write_u64(buf, sec.flags)
    }

    // Relocation log count + entries
    let rc: I64 = st.relocation_log.len() as I64
    write_u32(buf, rc)
    for i in 0 to rc {
        let rel: AppliedReloc = st.relocation_log.get(i)
        write_u32(buf, rel.source_section)
        write_u64(buf, rel.source_offset)
        write_str(buf, rel.target_symbol)
        write_u64(buf, rel.addend)
        write_u32(buf, rel.reloc_type)
        write_u64(buf, rel.file_offset)
    }

    return buf
}

/// Deserialize link state from binary buffer. Returns Nothing if corrupt.
pub func link_state_load(bytes: List[I64]) -> Maybe[LinkState] {
    let size: I64 = bytes.len() as I64
    if size < 8 { return Nothing }
    // Verify magic "TMLS"
    if bytes.get(0) != 0x54 or bytes.get(1) != 0x4D or bytes.get(2) != 0x4C or bytes.get(3) != 0x53 {
        return Nothing
    }
    let ver: I64 = read_u32(bytes, 4 as I64)
    if ver != LINK_STATE_VERSION { return Nothing }

    let st: LinkState = link_state_new("")
    st.version = ver

    // Parse sections
    var pos: I64 = 8
    if pos + 4 > size { return Nothing }
    let sc: I64 = read_u32(bytes, pos)
    pos = pos + 4
    for _ in 0 to sc {
        if pos + 4 > size { return Nothing }
        let name_len: I64 = read_u32(bytes, pos)
        pos = pos + 4
        // Skip name bytes (simplified — would need string reconstruction)
        pos = pos + name_len
        if pos + 32 > size { return Nothing }
        let rva: I64 = read_u64(bytes, pos)
        let foff: I64 = read_u64(bytes, pos + 8)
        let sz: I64 = read_u64(bytes, pos + 16)
        let fl: I64 = read_u64(bytes, pos + 24)
        pos = pos + 32
        st.sections.push(SectionRecord { name: "", start_rva: rva, file_offset: foff, size: sz, flags: fl })
    }

    return Just(st)
}

// ============================================================================
// Helpers
// ============================================================================

func write_u32(buf: List[I64], v: I64) {
    buf.push(v & 0xFF)
    buf.push((v >> 8) & 0xFF)
    buf.push((v >> 16) & 0xFF)
    buf.push((v >> 24) & 0xFF)
}

func write_u64(buf: List[I64], v: I64) {
    write_u32(buf, v)
    write_u32(buf, v >> 32)
}

func write_str(buf: List[I64], s: Str) {
    let n: I64 = s.len() as I64
    write_u32(buf, n)
    let ptr: I64 = s as I64
    for i in 0 to n {
        let b: I64 = lowlevel { ptr_read[I8]((ptr + i) as *I8) } as I64
        buf.push((b + 256) % 256)
    }
}

func read_u32(bytes: List[I64], off: I64) -> I64 {
    return (bytes.get(off) & 0xFF) | ((bytes.get(off + 1) & 0xFF) << 8) | ((bytes.get(off + 2) & 0xFF) << 16) | ((bytes.get(off + 3) & 0xFF) << 24)
}

func read_u64(bytes: List[I64], off: I64) -> I64 {
    return read_u32(bytes, off) | (read_u32(bytes, off + 4) << 32)
}
