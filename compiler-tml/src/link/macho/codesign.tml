//! Ad-hoc code signing for Mach-O binaries (macOS Monterey+).
//!
//! Produces an LC_CODE_SIGNATURE blob containing a SuperBlob with a CodeDirectory
//! that hashes each 4KB page of __TEXT using SHA-256.
//!
//! Phase 22c — items 4.1–4.3.

use std::collections::list::List

// ============================================================================
// Code signing constants
// ============================================================================

pub const CSMAGIC_EMBEDDED_SIGNATURE: I64 = 0xFADE0CC0
pub const CSMAGIC_CODEDIRECTORY: I64 = 0xFADE0C02
pub const CS_ADHOC: I64 = 0x00000002
pub const CS_HASHTYPE_SHA256: I64 = 2
pub const CS_SHA256_LEN: I64 = 32
pub const CS_PAGE_SIZE_LOG2: I64 = 12  // log2(4096)
pub const CS_PAGE_SIZE: I64 = 4096

pub const CSSLOT_CODEDIRECTORY: I64 = 0

// ============================================================================
// Code directory (item 4.2)
// ============================================================================

pub type CodeDirectory {
    version: I64,
    flags: I64,
    hash_type: I64,
    page_size_log2: I64,
    code_limit: I64,     // total bytes of code being signed
    n_code_slots: I64,   // number of page hashes
    ident: Str,          // identifier string (binary name)
    page_hashes: List[List[I64]]  // SHA-256 hash per page
}

/// Compute code directory for a Mach-O binary's __TEXT segment.
/// `text_data` = raw bytes of __TEXT segment, `ident` = binary name.
pub func compute_code_directory(text_data: List[I64], ident: Str) -> CodeDirectory {
    let code_limit: I64 = text_data.len() as I64
    let n_pages: I64 = (code_limit + CS_PAGE_SIZE - 1) / CS_PAGE_SIZE
    let hashes = List[List[I64]]::new(n_pages)

    // Hash each 4KB page with simplified hash (real impl uses SHA-256)
    for i in 0 to n_pages {
        let page_start: I64 = i * CS_PAGE_SIZE
        var page_end: I64 = page_start + CS_PAGE_SIZE
        if page_end > code_limit { page_end = code_limit }
        let page_hash: List[I64] = simple_hash_256(text_data, page_start, page_end)
        hashes.push(page_hash)
    }

    return CodeDirectory {
        version: 0x20400 as I64,
        flags: CS_ADHOC,
        hash_type: CS_HASHTYPE_SHA256,
        page_size_log2: CS_PAGE_SIZE_LOG2,
        code_limit: code_limit,
        n_code_slots: n_pages,
        ident: ident,
        page_hashes: hashes
    }
}

// ============================================================================
// Signature blob (items 4.1, 4.3)
// ============================================================================

/// Build the LC_CODE_SIGNATURE blob from a CodeDirectory.
/// Layout: SuperBlob header + BlobIndex[0] → CodeDirectory.
pub func build_signature_blob(cd: CodeDirectory) -> List[I64] {
    let buf = List[I64]::new(1024)

    // Compute CodeDirectory size
    let ident_len: I64 = cd.ident.len() as I64 + 1  // null-terminated
    let hash_offset: I64 = 44 + ident_len  // CodeDirectory header (44 bytes) + ident
    let cd_size: I64 = hash_offset + cd.n_code_slots * CS_SHA256_LEN

    // SuperBlob header (12 bytes)
    write_u32_be(buf, CSMAGIC_EMBEDDED_SIGNATURE)
    write_u32_be(buf, 12 + 8 + cd_size)  // total length: super(12) + blobindex(8) + cd
    write_u32_be(buf, 1 as I64)           // count = 1 blob

    // BlobIndex[0] (8 bytes)
    write_u32_be(buf, CSSLOT_CODEDIRECTORY)
    write_u32_be(buf, 20 as I64)          // offset from start of SuperBlob

    // CodeDirectory (variable size)
    write_u32_be(buf, CSMAGIC_CODEDIRECTORY)
    write_u32_be(buf, cd_size)
    write_u32_be(buf, cd.version)
    write_u32_be(buf, cd.flags)
    write_u32_be(buf, hash_offset)          // hashOffset
    write_u32_be(buf, 44 as I64)            // identOffset
    write_u32_be(buf, 0 as I64)             // nSpecialSlots
    write_u32_be(buf, cd.n_code_slots)      // nCodeSlots
    write_u32_be(buf, cd.code_limit)        // codeLimit
    buf.push(cd.hash_type & 0xFF)           // hashType
    buf.push(0)                              // platform
    buf.push(cd.page_size_log2 & 0xFF)      // pageSize
    buf.push(0)                              // spare2

    // Identifier string (null-terminated)
    let id_ptr: I64 = cd.ident as I64
    for i in 0 to (cd.ident.len() as I64) {
        let b: I64 = lowlevel { ptr_read[I8]((id_ptr + i) as *I8) } as I64
        buf.push((b + 256) % 256)
    }
    buf.push(0)

    // Page hashes
    for i in 0 to cd.n_code_slots {
        let hash: List[I64] = cd.page_hashes.get(i)
        let hc: I64 = hash.len() as I64
        for j in 0 to hc { buf.push(hash.get(j)) }
    }

    return buf
}

/// Compute the total size of the signature blob for pre-allocation.
pub func signature_blob_size(text_size: I64, ident_len: I64) -> I64 {
    let n_pages: I64 = (text_size + CS_PAGE_SIZE - 1) / CS_PAGE_SIZE
    let cd_size: I64 = 44 + ident_len + 1 + n_pages * CS_SHA256_LEN
    return 12 + 8 + cd_size  // SuperBlob(12) + BlobIndex(8) + CodeDirectory
}

// ============================================================================
// Simplified hash (placeholder for SHA-256)
// ============================================================================

/// Simple FNV-style hash producing 32 bytes (not cryptographic — placeholder).
/// Real implementation should use std::crypto::sha256.
func simple_hash_256(data: List[I64], start: I64, end: I64) -> List[I64] {
    let hash = List[I64]::new(32)
    var h: I64 = 0x6C62272E07BB0142  // FNV offset basis
    for i in start to end {
        h = h ^ (data.get(i) & 0xFF)
        h = h * 0x100000001B3  // FNV prime
    }
    // Spread into 32 bytes
    for i in 0 to 32 {
        hash.push((h >> ((i % 8) * 8)) & 0xFF)
        if i % 8 == 7 { h = h ^ (h >> 17) }
    }
    return hash
}

// ============================================================================
// Big-endian write helpers (Mach-O code signing uses big-endian!)
// ============================================================================

func write_u32_be(buf: List[I64], v: I64) {
    buf.push((v >> 24) & 0xFF)
    buf.push((v >> 16) & 0xFF)
    buf.push((v >> 8) & 0xFF)
    buf.push(v & 0xFF)
}
