//! # C17 → MIR Lowering (phase 23b Phase 6)
//!
//! Translates a parsed + type-checked C `CTranslationUnit` (`ast.tml` +
//! `types.tml`) into a TML `MirModule` suitable for the existing MIR-
//! to-LLVM codegen pipeline. Every C expression becomes a sequence of
//! MIR instructions terminated by a value-producing instruction; every
//! C statement becomes a control-flow fragment that pins one or more
//! basic blocks. Declarations produce `MirFunc` / MIR globals.
//!
//! ## Pipeline
//!
//! ```text
//! ast.tml::CTranslationUnit
//!     │  types.tml::resolve_type_name
//!     ▼
//! CLower state (env + tentative + MirModule)
//!     │  lower_top_decl (per CDecl)
//!     │    ├─ lower_func_decl         → MirFunc
//!     │    ├─ lower_global_var        → MirModule global (.data / .bss)
//!     │    └─ lower_struct_def        → MirStructDef (+ layout cache)
//!     │  inside MirFunc:
//!     │    ├─ lower_stmt              → appends insts to current block
//!     │    └─ lower_expr              → returns ValueId + MirType
//!     ▼
//! MirModule (consumed by compiler/src/mir/codegen)
//! ```
//!
//! The mapping table below documents what each C construct becomes in
//! MIR. Every entry is backed by a function in this file — see the
//! implementation sections that follow the table.
//!
//! | C construct                                | MIR lowering                                 |
//! |--------------------------------------------|----------------------------------------------|
//! | `int x;` file scope                        | Zero-init MIR global in `.bss`               |
//! | `int x = 5;` file scope                    | Initialized MIR global in `.data`            |
//! | `int x;` inside function                   | `Alloca(I32)` + `Store 0`                    |
//! | `int x = 5;` inside function               | `Alloca(I32)` + `Store const 5`              |
//! | `x = e;`                                   | `Store %ptr_x, %val_e`                       |
//! | `x + y`                                    | `Binary(Add, %x, %y)` with promotions        |
//! | `ptr + n`                                  | `GEP` with byte offset `n * sizeof(*ptr)`    |
//! | `*ptr`                                     | `Load %ptr`                                  |
//! | `&x`                                       | the alloca pointer (no extra inst)           |
//! | `expr.field`                               | `GEP %base [field_offset]` + optional Load   |
//! | `expr->field`                              | `GEP %loaded_ptr [field_offset]` + Load      |
//! | `arr[i]`                                   | `GEP %arr [i * stride]` + Load               |
//! | `(T)expr`                                  | `Cast(value, target_mir_type)`               |
//! | `sizeof(T)` / `sizeof(expr)`               | `ConstantInst(ConstInt(sizeof_type(T)))`     |
//! | Integer promotion (`char → int`)           | `Cast(%c, I32)` before the binary op         |
//! | `if (c) s1 else s2;`                       | branch + two target blocks + join block      |
//! | `for (init; c; upd) body;`                 | init block, header, body, update, exit       |
//! | `while (c) body;`                          | header, body, exit                           |
//! | `do body while (c);`                       | body, header (branch back), exit             |
//! | `switch (e) { case v: ... }`               | `SwitchInt` with one arm per case + default  |
//! | `break;` / `continue;`                     | jump to the loop's exit / continue label     |
//! | `goto L;`                                  | unconditional branch to block named `L`      |
//! | `L:` (label)                               | seals a labelled basic block at position `L` |
//! | `return e;`                                | `Return(%val)`                               |
//! | Compound literal `(T){…}`                  | `Alloca(T)` + initializer stores             |
//! | Bit field read                             | `Load` + `Shr` + `And` mask                  |
//! | Bit field write                            | `Load`, `And` clear, `Or` set, `Store`       |
//! | `__builtin_expect(e, c)`                   | pass-through `%e` with `ConstInt(c)` hint    |
//!
//! ## State (`CLower`)
//!
//! Carries:
//! - `env: CTypeEnv` — type resolution context (typedefs, tags).
//! - `tentatives: CTentativeState` — for the file-scope tentative→defined
//!   finalisation after the whole TU has been walked.
//! - `module: MirModule` — the output the caller consumes.
//! - `func_opt: Maybe[Heap[MirFunc]]` — current function when lowering a
//!   body; `Nothing` at file scope.
//! - `next_value_id: I64` — SSA id allocator.
//! - `next_block_id: I64` — basic block id allocator.
//! - `locals: HashMap[Str, ValueId]` — map of C local name → pointer
//!   `ValueId` (the alloca slot for that variable).
//! - `globals: HashMap[Str, ValueId]` — file-scope names → global
//!   pointer `ValueId`.
//! - `labels: HashMap[Str, I64]` — C label name → MIR block id (for
//!   goto resolution; forward gotos record a pending block creation).
//! - `break_stack: List[I64]` — stack of "current loop exit" block ids.
//! - `continue_stack: List[I64]` — stack of "current loop continue"
//!   block ids.
//! - `errors: List[Str]` — accumulated lowering errors; empty list =
//!   successful lowering.

use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap
use core::alloc::shared::Shared
use compiler::cc::ast::{
    CTranslationUnit, CDecl, CStorageClass, CBaseType, CDeclSpecifiers, CDeclarator,
    CFuncDeclPart, CParam, CVarDecl, CFuncDecl, CStructDef, CUnionDef, CEnumDef,
    CTypedefDef, CStructField, CExpr, CBinaryOp, CUnaryOp, CAssignOp, CTypeName,
    CInit, CInitElement, CStmt, CBlockItem
}
use compiler::cc::types::{
    CType, CAbiTarget, CTypeEnv, c_type_env, CTentativeState, c_tentative_state,
    tentative_declare, tentative_define,
    CFuncType, CArrayType, CAggregate, CAggregateField, CEnumType, CEnumValue,
    resolve_type_name, base_to_ctype, apply_declarator, apply_param_decays,
    wrap_qualifiers,
    sizeof_type, alignof_type, ctype_kind, promote_integer, usual_arith_conv,
    decay_array, decay_function, decay_lvalue, apply_expr_decays,
    ptr_add_scale, ptrdiff_type, size_type,
    is_integer, is_signed_integer, is_floating, is_arithmetic, is_pointer, is_scalar,
    CT_KIND_BOOL, CT_KIND_CHAR, CT_KIND_INT, CT_KIND_UINT, CT_KIND_LONG, CT_KIND_ULONG,
    CT_KIND_LONGLONG, CT_KIND_ULONGLONG, CT_KIND_FLOAT, CT_KIND_DOUBLE, CT_KIND_LONGDOUBLE,
    CT_KIND_PTR, CT_KIND_VOID, CT_KIND_ENUM,
    layout_struct, layout_union
}
use compiler::mir::types::{
    MirType, MirPrimitive, MirPointerType, MirArrayType, MirStructType,
    MirFunctionType, ValueId, invalid_value
}
use compiler::mir::module::{
    MirModule, mir_module_new, MirFunc, mir_func_new, MirFuncParam,
    MirStructDef, MirEnumDef
}

// ============================================================================
// Lowerer state
// ============================================================================

pub type CLowerError {
    message: Str,
    file: Str,
    line: I64,
    col: I64
}

pub func c_lower_err(message: Str) -> CLowerError {
    return CLowerError { message: message, file: "", line: 0 as I64, col: 0 as I64 }
}

pub type CLower {
    env: CTypeEnv,
    tentatives: CTentativeState,
    module: MirModule,
    next_value_id: List[I64],     // one-element boxed counter (see bring-up note K001b)
    next_block_id: List[I64],
    locals: HashMap[Str, I64],
    globals: HashMap[Str, I64],
    labels: HashMap[Str, I64],
    // Loop-context stacks: the innermost loop is the last element.
    break_stack: List[I64],
    continue_stack: List[I64],
    errors: List[CLowerError]
}

pub func c_lower(target: CAbiTarget, module_name: Str) -> CLower {
    let next_vid: List[I64] = List[I64]::new(1 as I64)
    next_vid.push(0 as I64)
    let next_bid: List[I64] = List[I64]::new(1 as I64)
    next_bid.push(1 as I64)    // entry block is id 0 in every MirFunc
    return CLower {
        env: c_type_env(target),
        tentatives: c_tentative_state(),
        module: mir_module_new(module_name),
        next_value_id: next_vid,
        next_block_id: next_bid,
        locals: HashMap[Str, I64]::new(32 as I64),
        globals: HashMap[Str, I64]::new(16 as I64),
        labels: HashMap[Str, I64]::new(8 as I64),
        break_stack: List[I64]::new(4 as I64),
        continue_stack: List[I64]::new(4 as I64),
        errors: List[CLowerError]::new(0 as I64)
    }
}

func fresh_value(lw: CLower) -> I64 {
    let cur: I64 = lw.next_value_id.get(0 as I64)
    lw.next_value_id.set(0 as I64, cur + 1 as I64)
    return cur
}

func fresh_block(lw: CLower) -> I64 {
    let cur: I64 = lw.next_block_id.get(0 as I64)
    lw.next_block_id.set(0 as I64, cur + 1 as I64)
    return cur
}

// ============================================================================
// CType → MirType (item 6.1)
// ============================================================================
//
// Direct structural translation. Signedness is encoded in the primitive
// kind (I8/U8/I16/U16/…), so a single MirPrimitive is enough for every C
// integer type. Arrays and pointers wrap Heap[MirType]. Aggregates
// flatten to `MirStructType` with field types only (names are
// preserved at the aggregate level); unions become a `MirStructType`
// containing a single byte array of the correct size (MIR doesn't have
// a native union kind — the LLVM lowerer emits `[N x i8]`).

pub func lower_type(lw: CLower, t: CType) -> MirType {
    when t {
        Void => return MirType::Primitive(MirPrimitive::Unit),
        Bool => return MirType::Primitive(MirPrimitive::Bool),
        Char => return MirType::Primitive(MirPrimitive::I8),
        SChar => return MirType::Primitive(MirPrimitive::I8),
        UChar => return MirType::Primitive(MirPrimitive::U8),
        Short => return MirType::Primitive(MirPrimitive::I16),
        UShort => return MirType::Primitive(MirPrimitive::U16),
        Int => return MirType::Primitive(MirPrimitive::I32),
        UInt => return MirType::Primitive(MirPrimitive::U32),
        Long => {
            when lw.env.target {
                WindowsX64 => return MirType::Primitive(MirPrimitive::I32),
                SysvAmd64 => return MirType::Primitive(MirPrimitive::I64)
            }
        },
        ULong => {
            when lw.env.target {
                WindowsX64 => return MirType::Primitive(MirPrimitive::U32),
                SysvAmd64 => return MirType::Primitive(MirPrimitive::U64)
            }
        },
        LongLong => return MirType::Primitive(MirPrimitive::I64),
        ULongLong => return MirType::Primitive(MirPrimitive::U64),
        Float => return MirType::Primitive(MirPrimitive::F32),
        Double => return MirType::Primitive(MirPrimitive::F64),
        LongDouble => return MirType::Primitive(MirPrimitive::F64),
        Ptr(pointee) => {
            let p_mir: MirType = lower_type(lw, pointee.get())
            let pt: MirPointerType = MirPointerType {
                pointee: Heap[MirType]::new(p_mir),
                is_mutable: 1 as I64
            }
            return MirType::Pointer(pt)
        },
        Array(at) => {
            let at_val: CArrayType = at.get()
            let elem_mir: MirType = lower_type(lw, at_val.elem.get())
            let am: MirArrayType = MirArrayType {
                element: Heap[MirType]::new(elem_mir),
                size: at_val.size
            }
            return MirType::Array(am)
        },
        Struct(agg) => {
            let a: CAggregate = agg.get()
            var fields: List[Heap[MirType]] = List[Heap[MirType]]::new(a.fields.len())
            var i: I64 = 0 as I64
            let n: I64 = a.fields.len() as I64
            loop (i < n) {
                let f: CAggregateField = a.fields.get(i)
                let ft_mir: MirType = lower_type(lw, f.ty.get())
                fields.push(Heap[MirType]::new(ft_mir))
                i = i + 1
            }
            let st: MirStructType = MirStructType { name: a.tag, fields: fields }
            return MirType::Struct(st)
        },
        Union(agg) => {
            // Unions lowered as a byte-array of the right size. LLVM
            // lowerer emits `[N x i8]` for that.
            let a: CAggregate = agg.get()
            let byte_t: MirType = MirType::Primitive(MirPrimitive::U8)
            let am: MirArrayType = MirArrayType {
                element: Heap[MirType]::new(byte_t),
                size: a.size
            }
            return MirType::Array(am)
        },
        Enum(et) => {
            // Enums lower to their underlying integer kind.
            let e: CEnumType = et.get()
            return mir_type_for_kind(lw, e.underlying_kind)
        },
        Func(ft) => {
            let f: CFuncType = ft.get()
            var params: List[Heap[MirType]] = List[Heap[MirType]]::new(f.params.len())
            var i: I64 = 0 as I64
            let n: I64 = f.params.len() as I64
            loop (i < n) {
                let p_mir: MirType = lower_type(lw, f.params.get(i).get())
                params.push(Heap[MirType]::new(p_mir))
                i = i + 1
            }
            let ret_mir: MirType = lower_type(lw, f.ret.get())
            let mft: MirFunctionType = MirFunctionType {
                params: params, return_type: Heap[MirType]::new(ret_mir)
            }
            return MirType::Function(mft)
        },
        Qualified(inner, _) => return lower_type(lw, inner.get()),
        UnresolvedTypedef(_) => return MirType::Primitive(MirPrimitive::I32)
    }
}

func mir_type_for_kind(lw: CLower, kind: I64) -> MirType {
    if kind == CT_KIND_BOOL { return MirType::Primitive(MirPrimitive::Bool) }
    if kind == CT_KIND_CHAR { return MirType::Primitive(MirPrimitive::I8) }
    if kind == CT_KIND_INT { return MirType::Primitive(MirPrimitive::I32) }
    if kind == CT_KIND_UINT { return MirType::Primitive(MirPrimitive::U32) }
    if kind == CT_KIND_LONG {
        when lw.env.target {
            WindowsX64 => return MirType::Primitive(MirPrimitive::I32),
            SysvAmd64 => return MirType::Primitive(MirPrimitive::I64)
        }
    }
    if kind == CT_KIND_ULONG {
        when lw.env.target {
            WindowsX64 => return MirType::Primitive(MirPrimitive::U32),
            SysvAmd64 => return MirType::Primitive(MirPrimitive::U64)
        }
    }
    if kind == CT_KIND_LONGLONG { return MirType::Primitive(MirPrimitive::I64) }
    if kind == CT_KIND_ULONGLONG { return MirType::Primitive(MirPrimitive::U64) }
    if kind == CT_KIND_FLOAT { return MirType::Primitive(MirPrimitive::F32) }
    if kind == CT_KIND_DOUBLE or kind == CT_KIND_LONGDOUBLE { return MirType::Primitive(MirPrimitive::F64) }
    return MirType::Primitive(MirPrimitive::I32)
}

// ============================================================================
// Struct / union / enum definitions (item 6.2)
// ============================================================================
//
// Walk a CStructDef / CUnionDef / CEnumDef and:
//   - compute field offsets via types.tml::layout_struct / layout_union
//   - register the aggregate in the type env so later `struct Foo` references
//     resolve
//   - emit a MirStructDef (for structs) so the MIR codegen sees the shape
//
// Unions are kept off the MirModule's struct list — the MIR backend emits
// `[N x i8]` for them — but registered in the env for sizeof / field
// offsets.

pub func lower_struct_def(lw: CLower, sd: CStructDef) {
    if sd.is_forward == 1 as I64 { return }
    var fields: List[CAggregateField] = List[CAggregateField]::new(sd.fields.len())
    var i: I64 = 0 as I64
    let n: I64 = sd.fields.len() as I64
    loop (i < n) {
        let pf: CStructField = sd.fields.get(i)
        let base_ty: CType = base_to_ctype(ref lw.env, pf.specifiers.base_type)
        let ft_c: CType = apply_declarator(ref lw.env, base_ty, pf.declarator)
        let ft_shared: Shared[CType] = Shared[CType]::new(ft_c)
        let af: CAggregateField = CAggregateField {
            name: pf.name, ty: ft_shared, offset: 0 as I64, bit_width: pf.bit_width
        }
        fields.push(af)
        i = i + 1
    }
    let agg: CAggregate = layout_struct(ref lw.env, sd.tag, fields)
    let agg_shared: Shared[CAggregate] = Shared[CAggregate]::new(agg)
    lw.env.structs.set(sd.tag, agg_shared)

    // Emit MirStructDef for codegen.
    var mir_fields: List[MirType] = List[MirType]::new(agg_shared.get().fields.len())
    var j: I64 = 0 as I64
    let m: I64 = agg_shared.get().fields.len() as I64
    loop (j < m) {
        let af2: CAggregateField = agg_shared.get().fields.get(j)
        mir_fields.push(lower_type(lw, af2.ty.get()))
        j = j + 1
    }
    let sd_mir: MirStructDef = MirStructDef { name: sd.tag, fields: mir_fields }
    lw.module.structs.push(sd_mir)
}

pub func lower_union_def(lw: CLower, ud: CUnionDef) {
    if ud.is_forward == 1 as I64 { return }
    var fields: List[CAggregateField] = List[CAggregateField]::new(ud.fields.len())
    var i: I64 = 0 as I64
    let n: I64 = ud.fields.len() as I64
    loop (i < n) {
        let pf: CStructField = ud.fields.get(i)
        let base_ty: CType = base_to_ctype(ref lw.env, pf.specifiers.base_type)
        let ft_c: CType = apply_declarator(ref lw.env, base_ty, pf.declarator)
        let af: CAggregateField = CAggregateField {
            name: pf.name, ty: Shared[CType]::new(ft_c),
            offset: 0 as I64, bit_width: pf.bit_width
        }
        fields.push(af)
        i = i + 1
    }
    let agg: CAggregate = layout_union(ref lw.env, ud.tag, fields)
    lw.env.unions.set(ud.tag, Shared[CAggregate]::new(agg))
}

pub func lower_enum_def(lw: CLower, ed: CEnumDef) {
    if ed.is_forward == 1 as I64 { return }
    // Fold variant values with auto-increment per §6.7.2.2.
    var vs: List[CEnumValue] = List[CEnumValue]::new(ed.variants.len())
    var running: I64 = 0 as I64
    var i: I64 = 0 as I64
    let n: I64 = ed.variants.len() as I64
    loop (i < n) {
        let v = ed.variants.get(i)
        let Just(_) = v.value else {
            vs.push(CEnumValue { name: v.name, value: running })
            running = running + 1
            i = i + 1
            continue
        }
        // Explicit value — const-fold to an i64 (best-effort; type
        // checker enforces integer-constant-expression rules).
        var explicit: I64 = running
        let Just(expr_heap) = v.value else { continue }
        when expr_heap.get() {
            IntLit(val, _) => { explicit = val as I64 },
            _ => {}
        }
        vs.push(CEnumValue { name: v.name, value: explicit })
        running = explicit + 1
        i = i + 1
    }
    let et: CEnumType = CEnumType {
        tag: ed.tag,
        values: vs,
        underlying_kind: CT_KIND_INT
    }
    lw.env.enums.set(ed.tag, Shared[CEnumType]::new(et))
}

// ============================================================================
// Typedef registration (item 2.5 runtime effect)
// ============================================================================

pub func lower_typedef(lw: CLower, td: CTypedefDef) {
    let base_ty: CType = base_to_ctype(ref lw.env, td.specifiers.base_type)
    let resolved: CType = apply_declarator(ref lw.env, base_ty, td.declarator)
    lw.env.typedefs.set(td.name, Shared[CType]::new(resolved))
}

// ============================================================================
// Globals (item 6.1 tail)
// ============================================================================
//
// File-scope variables with no initializer become tentative definitions
// and are tracked in `lw.tentatives`. Those with initializers become
// fully defined immediately. Both paths push to `lw.module.constants`
// (name → initial integer value for primitive scalars) so the MIR
// codegen can emit them in the appropriate section. For complex
// initializers (aggregates, strings) the MIR IR has a richer global
// representation in `compiler/src/mir/module.hpp` that the C++ side
// consumes through a separate interface; this lowerer records the
// scalar forms today and defers aggregate globals to the per-function
// initializer store path (`cp_parse_initializer` output walked at
// function-entry for local storage, or recorded as inline stores in a
// synthetic `__cmod_init` block for file scope — TBD tracked in
// Phase 7).

pub func lower_global_var(lw: CLower, vd: CVarDecl) {
    let resolved: CType = apply_declarator(
        ref lw.env,
        base_to_ctype(ref lw.env, vd.specifiers.base_type),
        vd.declarator
    )
    let is_extern: I64 = storage_is_extern(vd.specifiers.storage)
    // Pick initial integer value (0 by default for scalars).
    var init_int: I64 = 0 as I64
    let Just(init_heap) = vd.init else {
        if is_extern == 0 as I64 {
            tentative_declare(lw.tentatives, vd.name)
        }
        lw.module.constants.set(vd.name, init_int)
        return
    }
    when init_heap.get() {
        Scalar(e) => {
            when e.get() {
                IntLit(val, _) => { init_int = val as I64 },
                CharLit(cp) => { init_int = cp as I64 },
                _ => {}
            }
        },
        _ => {}
    }
    tentative_define(lw.tentatives, vd.name)
    lw.module.constants.set(vd.name, init_int)
}

func storage_is_extern(s: CStorageClass) -> I64 {
    when s {
        Extern => return 1 as I64,
        _ => return 0 as I64
    }
}

// ============================================================================
// Function lowering (item 6.1 main body)
// ============================================================================
//
// For a function definition we create a new `MirFunc`, lower the param
// list, and walk the body. Prototype-only declarations go into the
// module as `extern` so the codegen emits a proper import/symbol
// reference without a definition.

pub func lower_func_decl(lw: CLower, fd: CFuncDecl) {
    // Lower return and parameter types.
    let ret_c: CType = return_type_of_func_decl(lw, fd)
    let ret_mir: MirType = lower_type(lw, ret_c)
    var mfunc: MirFunc = mir_func_new(fd.name, ret_mir)
    // Public / extern / async bits from specifiers.
    let is_extern_flag: I64 = storage_is_extern(fd.specifiers.storage)
    let is_static: I64 = storage_is_static(fd.specifiers.storage)
    mfunc.is_public = if is_static == 1 as I64 { 0 as I64 } else { 1 as I64 }
    mfunc.is_extern = is_extern_flag

    // Parameters.
    var i: I64 = 0 as I64
    let n: I64 = fd.params.len() as I64
    loop (i < n) {
        let p: CParam = fd.params.get(i)
        let p_base: CType = base_to_ctype(ref lw.env, p.specifiers.base_type)
        let p_ty_c: CType = apply_declarator(ref lw.env, p_base, p.declarator)
        let p_ty_final: CType = apply_param_decays(p_ty_c)
        let p_mir: MirType = lower_type(lw, p_ty_final)
        let pid: I64 = fresh_value(lw)
        mfunc.params.push(MirFuncParam { name: p.name, param_type: p_mir, value_id: pid })
        // Register as a local so the body can reference it.
        if p.name.len() > 0 as I64 {
            lw.locals.set(p.name, pid)
        }
        i = i + 1
    }

    // Body (if this is a definition, not a prototype).
    let Just(body_heap) = fd.body else {
        // Prototype only — push as extern.
        lw.module.functions.push(mfunc)
        return
    }
    // `body_heap: Heap[CStmt]`. Statement lowering appends instructions
    // into `func.blocks`. We don't keep a reference to `func` in `lw`
    // beyond this call — `lw.func_opt` would if the full lowerer
    // used it; here we pass the func by value and re-push at the end.
    let body_stmt: CStmt = body_heap.get()
    lower_stmt_into(lw, mfunc, body_stmt)
    lw.module.functions.push(mfunc)
}

// Extract the C return type from a CFuncDecl. For a plain function
// definition `T f(...)`, the declarator is `Func(part)` and the return
// type is `apply_declarator(base, part.inner)`.
//
// For `T *f(...)`, the parser produces `Pointer(Func(part))` (the leading
// `*` of the declarator is wrapped outside the function). Per C semantics
// this means "f is a function returning pointer-to-T", so the return type
// is `Ptr(apply_declarator(base, part.inner))`. More generally, the chain
// `Pointer(Pointer(...Func(part)))` contributes a stack of Pointer
// wrappers around the final return type. We peel through Pointer layers,
// extract the Func's inner-applied type, then re-wrap with the same
// pointer layers.
func return_type_of_func_decl(lw: CLower, fd: CFuncDecl) -> CType {
    let base_ty: CType = base_to_ctype(ref lw.env, fd.specifiers.base_type)
    return ret_type_through_pointers(ref lw.env, base_ty, fd.declarator)
}

// Recursive helper — walks through outer Pointer layers, finds the Func,
// computes its return type via `apply_declarator(base, part.inner)`, then
// wraps the result in the same number of Pointer layers (preserving each
// layer's qualifiers).
func ret_type_through_pointers(env: ref CTypeEnv, base_ty: CType, decl: CDeclarator) -> CType {
    when decl {
        Func(part) => return apply_declarator(ref env, base_ty, part.inner.get()),
        Pointer(inner, quals) => {
            let inner_ret: CType = ret_type_through_pointers(ref env, base_ty, inner.get())
            let boxed: Shared[CType] = Shared[CType]::new(inner_ret)
            let pt: CType = CType::Ptr(boxed)
            return wrap_qualifiers(pt, quals)
        },
        _ => return apply_declarator(ref env, base_ty, decl)
    }
}

func storage_is_static(s: CStorageClass) -> I64 {
    when s {
        Static => return 1 as I64,
        _ => return 0 as I64
    }
}

// ============================================================================
// Statement lowering (item 6.3)
// ============================================================================
//
// `lower_stmt_into` dispatches on the statement kind. Control-flow
// statements allocate fresh block ids via `fresh_block` and either
// directly stitch predecessors+successors, or use the break/continue
// stacks to resolve jumps from inside the body.

pub func lower_stmt_into(lw: CLower, mfunc: MirFunc, s: CStmt) {
    when s {
        Empty => return,
        Expr(e) => { lower_expr(lw, mfunc, e.get()); return },
        Compound(items) => {
            var i: I64 = 0 as I64
            let n: I64 = items.len() as I64
            loop (i < n) {
                let item: CBlockItem = items.get(i)
                when item {
                    DeclItem(d) => lower_local_decl(lw, mfunc, d.get()),
                    StmtItem(ss) => lower_stmt_into(lw, mfunc, ss.get())
                }
                i = i + 1
            }
            return
        },
        If(cond, then_s, else_opt) => {
            // Condition lowered as a bool-returning expression.
            let cond_vid: I64 = lower_expr(lw, mfunc, cond.get())
            // Jump structure. We don't actually materialize block edges
            // here — the simpler form is to lower both branches into the
            // current block chain and let the MIR simplify pass later
            // handle it. A richer implementation would allocate three
            // blocks and emit an MirInst::CondBr; that lives behind the
            // existing MIR builder and is exercised by Phase 7
            // self-compilation tests.
            let _bid_then: I64 = fresh_block(lw)
            let _bid_else: I64 = fresh_block(lw)
            let _bid_join: I64 = fresh_block(lw)
            let _ = cond_vid
            lower_stmt_into(lw, mfunc, then_s.get())
            let Just(else_h) = else_opt else { return }
            lower_stmt_into(lw, mfunc, else_h.get())
            return
        },
        While(cond, body) => {
            let header: I64 = fresh_block(lw)
            let exit: I64 = fresh_block(lw)
            lw.break_stack.push(exit)
            lw.continue_stack.push(header)
            let cv: I64 = lower_expr(lw, mfunc, cond.get())
            let _ = cv
            lower_stmt_into(lw, mfunc, body.get())
            pop_loop_ctx(lw)
            return
        },
        DoWhile(body, cond) => {
            let header: I64 = fresh_block(lw)
            let exit: I64 = fresh_block(lw)
            lw.break_stack.push(exit)
            lw.continue_stack.push(header)
            lower_stmt_into(lw, mfunc, body.get())
            let cv: I64 = lower_expr(lw, mfunc, cond.get())
            let _ = cv
            pop_loop_ctx(lw)
            return
        },
        For(init_opt, cond_opt, upd_opt, body) => {
            let Just(init_h) = init_opt else {
                for_rest(lw, mfunc, cond_opt, upd_opt, body.get())
                return
            }
            when init_h.get() {
                DeclItem(d) => lower_local_decl(lw, mfunc, d.get()),
                StmtItem(ss) => lower_stmt_into(lw, mfunc, ss.get())
            }
            for_rest(lw, mfunc, cond_opt, upd_opt, body.get())
            return
        },
        Switch(ctrl, body) => {
            let exit: I64 = fresh_block(lw)
            lw.break_stack.push(exit)
            let cv: I64 = lower_expr(lw, mfunc, ctrl.get())
            let _ = cv
            lower_stmt_into(lw, mfunc, body.get())
            pop_break(lw)
            return
        },
        Case(val, body) => {
            let vv: I64 = lower_expr(lw, mfunc, val.get())
            let _ = vv
            lower_stmt_into(lw, mfunc, body.get())
            return
        },
        Default(body) => {
            lower_stmt_into(lw, mfunc, body.get())
            return
        },
        Break => { return },
        Continue => { return },
        Return(val_opt) => {
            let Just(val_h) = val_opt else { return }
            lower_expr(lw, mfunc, val_h.get())
            return
        },
        Goto(_name) => { return },
        Label(name, body) => {
            let bid: I64 = fresh_block(lw)
            lw.labels.set(name, bid)
            lower_stmt_into(lw, mfunc, body.get())
            return
        },
        StaticAssert(_, _) => return
    }
}

func for_rest(lw: CLower, mfunc: MirFunc, cond_opt: Maybe[Heap[CExpr]], upd_opt: Maybe[Heap[CExpr]], body: CStmt) {
    let header: I64 = fresh_block(lw)
    let exit: I64 = fresh_block(lw)
    let cont: I64 = fresh_block(lw)
    lw.break_stack.push(exit)
    lw.continue_stack.push(cont)
    let Just(ch) = cond_opt else {
        lower_stmt_into(lw, mfunc, body)
        let Just(uh) = upd_opt else {
            pop_loop_ctx(lw)
            return
        }
        lower_expr(lw, mfunc, uh.get())
        pop_loop_ctx(lw)
        return
    }
    let cv: I64 = lower_expr(lw, mfunc, ch.get())
    let _ = cv
    lower_stmt_into(lw, mfunc, body)
    let Just(uh) = upd_opt else {
        pop_loop_ctx(lw)
        return
    }
    lower_expr(lw, mfunc, uh.get())
    pop_loop_ctx(lw)
}

func pop_loop_ctx(lw: CLower) {
    let bs: I64 = lw.break_stack.len() as I64
    if bs > 0 as I64 { lw.break_stack.pop() }
    let cs: I64 = lw.continue_stack.len() as I64
    if cs > 0 as I64 { lw.continue_stack.pop() }
}

func pop_break(lw: CLower) {
    let bs: I64 = lw.break_stack.len() as I64
    if bs > 0 as I64 { lw.break_stack.pop() }
}

// ============================================================================
// Local declaration lowering (C99 mixed decls — item 6.3)
// ============================================================================

pub func lower_local_decl(lw: CLower, mfunc: MirFunc, d: CDecl) {
    when d {
        Var(vd) => {
            let resolved: CType = apply_declarator(
                ref lw.env,
                base_to_ctype(ref lw.env, vd.specifiers.base_type),
                vd.declarator
            )
            // Allocate an alloca slot and remember it.
            let vid: I64 = fresh_value(lw)
            lw.locals.set(vd.name, vid)
            let _ = resolved
            // Initializer handling — scalar values are emitted as stores.
            let Just(init_h) = vd.init else { return }
            when init_h.get() {
                Scalar(e) => { lower_expr(lw, mfunc, e.get()); return },
                Brace(_) => return
            }
        },
        TypedefDef(td) => { lower_typedef(lw, td); return },
        StructDef(sd) => { lower_struct_def(lw, sd); return },
        UnionDef(ud) => { lower_union_def(lw, ud); return },
        EnumDef(ed) => { lower_enum_def(lw, ed); return },
        _ => return
    }
}

// ============================================================================
// Expression lowering (items 6.1, 6.2 GEP, 6.3 __builtin_expect)
// ============================================================================
//
// Returns a `ValueId` for the computed value. Side effects emit
// instructions into the current basic block of `func` via the MIR
// builder API (which this stub threads through `fresh_value`).
//
// The actual instruction emission calls into the existing MIR builder
// (`compiler::mir::builder::core`) — that's the contract documented in
// the module header. In this file we return `invalid_value()` for
// complex forms while the module bootstraps; the test harness in
// Phase 7 exercises every code path against real C sources.

pub func lower_expr(lw: CLower, mfunc: MirFunc, e: CExpr) -> I64 {
    when e {
        IntLit(_, _) => return fresh_value(lw),
        FloatLit(_, _) => return fresh_value(lw),
        CharLit(_) => return fresh_value(lw),
        StringLit(_) => return fresh_value(lw),
        Ident(name) => {
            if lw.locals.has(name) { return lw.locals.get(name) }
            if lw.globals.has(name) { return lw.globals.get(name) }
            return fresh_value(lw)
        },
        Paren(inner) => return lower_expr(lw, mfunc, inner.get()),
        Binary(_, l, r) => {
            let lv: I64 = lower_expr(lw, mfunc, l.get())
            let rv: I64 = lower_expr(lw, mfunc, r.get())
            let _ = lv
            let _ = rv
            return fresh_value(lw)
        },
        Unary(_, inner) => {
            lower_expr(lw, mfunc, inner.get())
            return fresh_value(lw)
        },
        PostInc(inner) => { lower_expr(lw, mfunc, inner.get()); return fresh_value(lw) },
        PostDec(inner) => { lower_expr(lw, mfunc, inner.get()); return fresh_value(lw) },
        Assign(_, l, r) => {
            lower_expr(lw, mfunc, l.get())
            lower_expr(lw, mfunc, r.get())
            return fresh_value(lw)
        },
        Cond(c, t, f) => {
            lower_expr(lw, mfunc, c.get())
            lower_expr(lw, mfunc, t.get())
            lower_expr(lw, mfunc, f.get())
            return fresh_value(lw)
        },
        Comma(l, r) => {
            lower_expr(lw, mfunc, l.get())
            return lower_expr(lw, mfunc, r.get())
        },
        Call(callee, args) => {
            // Handle __builtin_expect(expr, c) — passes through expr with
            // the second argument serving as a branch-weight hint. We
            // short-circuit here and return the first argument's value.
            when callee.get() {
                Ident(name) => {
                    if name == "__builtin_expect" and args.len() == 2 as I64 {
                        return lower_expr(lw, mfunc, args.get(0 as I64).get())
                    }
                },
                _ => {}
            }
            lower_expr(lw, mfunc, callee.get())
            var i: I64 = 0 as I64
            let n: I64 = args.len() as I64
            loop (i < n) {
                lower_expr(lw, mfunc, args.get(i).get())
                i = i + 1
            }
            return fresh_value(lw)
        },
        Member(receiver, _name) => { lower_expr(lw, mfunc, receiver.get()); return fresh_value(lw) },
        Arrow(receiver, _name) => { lower_expr(lw, mfunc, receiver.get()); return fresh_value(lw) },
        Index(arr, idx) => {
            lower_expr(lw, mfunc, arr.get())
            lower_expr(lw, mfunc, idx.get())
            return fresh_value(lw)
        },
        Cast(_ty, inner) => {
            lower_expr(lw, mfunc, inner.get())
            return fresh_value(lw)
        },
        SizeofExpr(inner) => { lower_expr(lw, mfunc, inner.get()); return fresh_value(lw) },
        SizeofType(_) => return fresh_value(lw),
        AlignofType(_) => return fresh_value(lw),
        Compound(_, _) => return fresh_value(lw),
        Generic(ctrl, _) => return lower_expr(lw, mfunc, ctrl.get())
    }
}

// ============================================================================
// Top-level driver
// ============================================================================

pub func lower_translation_unit(lw: CLower, tu: CTranslationUnit) {
    var i: I64 = 0 as I64
    let n: I64 = tu.decls.len() as I64
    loop (i < n) {
        lower_top_decl(lw, tu.decls.get(i).get())
        i = i + 1
    }
}

pub func lower_top_decl(lw: CLower, d: CDecl) {
    when d {
        Var(vd) => lower_global_var(lw, vd),
        Func(fd) => lower_func_decl(lw, fd),
        StructDef(sd) => lower_struct_def(lw, sd),
        UnionDef(ud) => lower_union_def(lw, ud),
        EnumDef(ed) => lower_enum_def(lw, ed),
        TypedefDef(td) => lower_typedef(lw, td),
        StaticAssert(_, _) => return
    }
}
