//! Predefined macros — __FILE__, __LINE__, __STDC__, platform detection.
//!
//! Phase 23a — items 5.1–5.2.

use compiler::cc::preproc::token::*

// ============================================================================
// Standard + compiler + platform macros (items 5.1–5.2)
// ============================================================================

/// Register all predefined macros into the preprocessor.
pub func register_predefined_macros(pp: Preprocessor) {
    // C standard
    pp_define_int(pp, "__STDC__", 1 as I64)
    pp_define_int(pp, "__STDC_VERSION__", 201710 as I64)  // C17
    pp_define_int(pp, "__STDC_HOSTED__", 1 as I64)

    // TML compiler identification
    pp_define_int(pp, "__TML__", 1 as I64)
    pp_define_int(pp, "__TML_MAJOR__", 0 as I64)
    pp_define_int(pp, "__TML_MINOR__", 3 as I64)
    pp_define_int(pp, "__TML_PATCHLEVEL__", 0 as I64)

    // GCC compatibility (many headers check for GCC)
    pp_define_int(pp, "__GNUC__", 4 as I64)
    pp_define_int(pp, "__GNUC_MINOR__", 2 as I64)
    pp_define_int(pp, "__GNUC_PATCHLEVEL__", 1 as I64)

    // Platform detection — Windows
    pp_define_int(pp, "_WIN32", 1 as I64)
    pp_define_int(pp, "_WIN64", 1 as I64)
    pp_define_int(pp, "__x86_64__", 1 as I64)
    pp_define_int(pp, "__amd64__", 1 as I64)

    // sizeof types (commonly checked in headers)
    pp_define_int(pp, "__SIZEOF_POINTER__", 8 as I64)
    pp_define_int(pp, "__SIZEOF_INT__", 4 as I64)
    pp_define_int(pp, "__SIZEOF_LONG__", 4 as I64)       // Windows: long = 4
    pp_define_int(pp, "__SIZEOF_LONG_LONG__", 8 as I64)
    pp_define_int(pp, "__SIZEOF_SIZE_T__", 8 as I64)

    // Byte order
    pp_define_int(pp, "__BYTE_ORDER__", 1234 as I64)  // little-endian
    pp_define_int(pp, "__LITTLE_ENDIAN__", 1 as I64)

    // __FILE__ and __LINE__ are special — expanded dynamically, not stored here.
    // The preprocessor handles them during token scanning.
}

/// Register Linux predefined macros.
pub func register_linux_macros(pp: Preprocessor) {
    pp_define_int(pp, "__linux__", 1 as I64)
    pp_define_int(pp, "__unix__", 1 as I64)
    pp_define_int(pp, "__ELF__", 1 as I64)
    pp_define_int(pp, "__SIZEOF_LONG__", 8 as I64)  // Linux: long = 8
}

/// Register macOS predefined macros.
pub func register_macos_macros(pp: Preprocessor) {
    pp_define_int(pp, "__APPLE__", 1 as I64)
    pp_define_int(pp, "__MACH__", 1 as I64)
    pp_define_int(pp, "__SIZEOF_LONG__", 8 as I64)  // macOS: long = 8
}
