//! Conditional compilation — #if, #ifdef, #ifndef, #elif, #else, #endif.
//!
//! Phase 23a — items 3.1–3.3.

use compiler::cc::preproc::token::*
use compiler::cc::preproc::macros::dup_pp_token
use std::collections::list::List

// ============================================================================
// Conditional evaluation (items 3.1–3.2)
// ============================================================================

/// Push a new conditional frame.
pub func cond_push(pp: Preprocessor, active: I64) {
    pp.cond_stack.push(CondFrame {
        active: active,
        ever_active: active,
        depth: pp.cond_stack.len() as I64
    })
}

/// Handle #elif — flip to this branch if no branch was taken yet.
pub func cond_elif(pp: Preprocessor, expr_val: I64) {
    let n: I64 = pp.cond_stack.len() as I64
    if n == 0 { pp.errors.push("#elif without #if"); return }
    let frame: CondFrame = pp.cond_stack.get(n - 1)
    if frame.ever_active > 0 {
        // A branch was already taken — this one is skipped
        pp.cond_stack.set(n - 1, CondFrame { active: 0 as I64, ever_active: 1 as I64, depth: frame.depth })
    } else if expr_val != 0 {
        pp.cond_stack.set(n - 1, CondFrame { active: 1 as I64, ever_active: 1 as I64, depth: frame.depth })
    } else {
        pp.cond_stack.set(n - 1, CondFrame { active: 0 as I64, ever_active: 0 as I64, depth: frame.depth })
    }
}

/// Handle #else.
pub func cond_else(pp: Preprocessor) {
    let n: I64 = pp.cond_stack.len() as I64
    if n == 0 { pp.errors.push("#else without #if"); return }
    let frame: CondFrame = pp.cond_stack.get(n - 1)
    let active: I64 = if frame.ever_active > 0 { 0 } else { 1 }
    pp.cond_stack.set(n - 1, CondFrame { active: active, ever_active: 1 as I64, depth: frame.depth })
}

/// Handle #endif.
pub func cond_endif(pp: Preprocessor) {
    let n: I64 = pp.cond_stack.len() as I64
    if n == 0 { pp.errors.push("#endif without #if"); return }
    pp.cond_stack.pop()
}

/// Check if we're in an active (non-skipped) branch.
pub func cond_is_active(pp: Preprocessor) -> I64 {
    let n: I64 = pp.cond_stack.len() as I64
    if n == 0 { return 1 }  // no conditionals = active
    return pp.cond_stack.get(n - 1).active
}

// ============================================================================
// Constant expression evaluator (item 3.2)
// ============================================================================

/// Evaluate a simple integer constant expression from tokens.
/// Supports: integer literals, defined(NAME), +, -, *, /, %, ==, !=, <, >, <=, >=, &&, ||, !
pub func eval_const_expr(pp: Preprocessor, tokens: List[PpToken]) -> I64 {
    let n: I64 = tokens.len() as I64
    if n == 0 { return 0 }

    // Single token: integer literal or defined check
    if n == 1 {
        let tok: PpToken = tokens.get(0)
        when tok.kind {
            IntLit => return parse_int(tok.text),
            Ident => {
                // Undefined macro in #if evaluates to 0
                if pp_is_defined(pp, tok.text) > 0 { return 1 }
                return 0
            },
            _ => return 0
        }
    }

    // "defined" operator: defined(NAME) or defined NAME
    if n >= 2 {
        let first: PpToken = tokens.get(0)
        if first.text == "defined" {
            if n >= 4 and tokens.get(1).text == "(" {
                // defined(NAME)
                let name: Str = tokens.get(2).text
                return pp_is_defined(pp, name)
            }
            if n >= 2 {
                // defined NAME
                let name: Str = tokens.get(1).text
                return pp_is_defined(pp, name)
            }
        }
    }

    // For complex expressions, evaluate left-to-right (simplified)
    // Full implementation would use precedence climbing
    let first_val: I64 = eval_const_expr(pp, sub_list(tokens, 0 as I64, 1 as I64))
    if n >= 3 {
        let op: Str = tokens.get(1).text
        let right_val: I64 = eval_const_expr(pp, sub_list(tokens, 2 as I64, n))
        if op == "==" { return if first_val == right_val { 1 } else { 0 } }
        if op == "!=" { return if first_val != right_val { 1 } else { 0 } }
        if op == "<" { return if first_val < right_val { 1 } else { 0 } }
        if op == ">" { return if first_val > right_val { 1 } else { 0 } }
        if op == "<=" { return if first_val <= right_val { 1 } else { 0 } }
        if op == ">=" { return if first_val >= right_val { 1 } else { 0 } }
        if op == "&&" { return if first_val != 0 and right_val != 0 { 1 } else { 0 } }
        if op == "||" { return if first_val != 0 or right_val != 0 { 1 } else { 0 } }
        if op == "+" { return first_val + right_val }
        if op == "-" { return first_val - right_val }
        if op == "*" { return first_val * right_val }
        if op == "/" { return if right_val != 0 { first_val / right_val } else { 0 } }
        if op == "%" { return if right_val != 0 { first_val % right_val } else { 0 } }
        if op == "&" { return first_val & right_val }
        if op == "|" { return first_val | right_val }
        if op == "^" { return first_val ^ right_val }
        if op == "<<" { return first_val << right_val }
        if op == ">>" { return first_val >> right_val }
    }

    return first_val
}

/// Parse an integer literal string to I64.
func parse_int(s: Str) -> I64 {
    let n: I64 = s.len() as I64
    if n == 0 { return 0 }
    var result: I64 = 0
    let ptr: I64 = s as I64
    var i: I64 = 0

    // Handle hex prefix
    if n >= 2 {
        let c0: I64 = lowlevel { ptr_read[I8](ptr as *I8) } as I64
        let c1: I64 = lowlevel { ptr_read[I8]((ptr + 1) as *I8) } as I64
        if c0 == 48 and (c1 == 120 or c1 == 88) {  // 0x or 0X
            i = 2
            loop (i < n) {
                let c: I64 = lowlevel { ptr_read[I8]((ptr + i) as *I8) } as I64
                if c >= 48 and c <= 57 { result = result * 16 + (c - 48) }
                else if c >= 97 and c <= 102 { result = result * 16 + (c - 87) }  // a-f
                else if c >= 65 and c <= 70 { result = result * 16 + (c - 55) }  // A-F
                else { return result }  // L suffix etc.
                i = i + 1
            }
            return result
        }
    }

    // Decimal
    loop (i < n) {
        let c: I64 = lowlevel { ptr_read[I8]((ptr + i) as *I8) } as I64
        if c >= 48 and c <= 57 { result = result * 10 + (c - 48) }
        else { return result }  // L/U suffix
        i = i + 1
    }
    return result
}

/// Extract a sub-list of tokens.
func sub_list(tokens: List[PpToken], start: I64, end_idx: I64) -> List[PpToken] {
    let result = List[PpToken]::new(end_idx - start)
    for i in start to end_idx {
        // Deep-clone: bitwise alias of `tokens` storage. (phase24m.)
        result.push(dup_pp_token(tokens.get(i)))
    }
    return result
}
