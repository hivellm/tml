//! Method dispatch for the TML self-hosting type checker.
//!
//! Implements method lookup with strict priority ordering:
//! 1. Inherent methods (direct impl on the type)
//! 2. Behavior methods (from `impl Behavior for Type`)
//! 3. Auto-deref methods (through one level of ref/Heap)
//!
//! Phase 14d — items 3.1–3.4.

use compiler::source::SourceSpan
use compiler::types::ty::Type
use compiler::types::ty::NamedType
use compiler::types::ty::RefType
use compiler::types::ty::make_unit
use compiler::types::ty::type_to_str
use compiler::types::env::TypeEnv
use compiler::types::env::FuncSig
use compiler::types::env::BehaviorDef
use compiler::types::env::env_lookup_behavior
use compiler::types::env::env_type_implements
use compiler::types::env::env_get_behavior_impls
use compiler::types::env::env_lookup_function
use compiler::types::behaviors::registry::BehaviorRegistry
use compiler::types::behaviors::registry::ImplBlock
use compiler::types::behaviors::registry::find_impl
use compiler::types::behaviors::registry::find_method_in_impls
use compiler::types::behaviors::registry::get_impl_blocks
use compiler::types::checker::check_call::get_type_name
use compiler::types::checker::check_call::substitute_type
use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

// ============================================================================
// MethodResolution — result of method dispatch
// ============================================================================

/// The source of a resolved method.
@repr(U8)
pub enum MethodSource {
    Inherent,
    FromBehavior(Str),
    AutoDeref
}

/// A resolved method: its signature and how it was found.
pub type MethodResolution {
    sig: FuncSig,
    source: MethodSource,
    type_subs: HashMap[Str, Type]
}

// ============================================================================
// Main dispatch function (item 3.4)
// ============================================================================

/// Look up a method on a receiver type, following strict priority order:
/// inherent > behavior > auto-deref.
pub func dispatch_method(
    reg: BehaviorRegistry,
    recv_ty: Type,
    method_name: Str
) -> Maybe[MethodResolution] {
    let type_name = get_type_name(recv_ty)
    if type_name == "" { return try_deref_dispatch(reg, recv_ty, method_name) }

    // Priority 1: Inherent methods (item 3.2)
    let inherent = lookup_inherent_method(reg, type_name, method_name)
    when inherent {
        Just(sig) => {
            let subs = build_type_subs(recv_ty, sig)
            return Just(MethodResolution {
                sig: sig,
                source: MethodSource::Inherent,
                type_subs: subs
            })
        },
        Nothing => {}
    }

    // Priority 2: Behavior methods (item 3.3)
    let bhv_result = lookup_behavior_method(reg, type_name, method_name, recv_ty)
    when bhv_result {
        Just(res) => return Just(res),
        Nothing => {}
    }

    // Priority 3: Auto-deref (through Ref, Heap)
    return try_deref_dispatch(reg, recv_ty, method_name)
}

// ============================================================================
// Inherent method lookup (item 3.2)
// ============================================================================

/// Search the type's own impl blocks (inherent impls, behavior_name == "")
/// for a method with the given name.
func lookup_inherent_method(
    reg: BehaviorRegistry,
    type_name: Str,
    method_name: Str
) -> Maybe[FuncSig] {
    // First check inherent impl blocks (behavior_name == "")
    let blocks = get_impl_blocks(reg, type_name)
    let bc: I64 = blocks.len() as I64
    for i in 0 to bc {
        let block = blocks.get(i)
        if block.behavior_name == "" {
            let mc: I64 = block.methods.len() as I64
            for j in 0 to mc {
                let msig = block.methods.get(j)
                if msig.name == method_name {
                    return Just(msig)
                }
            }
        }
    }

    // Also check qualified function names registered in TypeEnv
    let qualified = type_name + "::" + method_name
    return env_lookup_function(reg.env, qualified)
}

// ============================================================================
// Behavior method lookup (item 3.3)
// ============================================================================

/// Search all behavior impls for the type to find a matching method.
func lookup_behavior_method(
    reg: BehaviorRegistry,
    type_name: Str,
    method_name: Str,
    recv_ty: Type
) -> Maybe[MethodResolution] {
    // Get all behaviors this type implements
    let impls = env_get_behavior_impls(reg.env, type_name)
    let ic: I64 = impls.len() as I64

    for i in 0 to ic {
        let bhv_name = impls.get(i)

        // Check the behavior definition for the method
        let bdef_r = env_lookup_behavior(reg.env, bhv_name)
        let Just(bdef) = bdef_r else { continue }

        let mc: I64 = bdef.methods.len() as I64
        for j in 0 to mc {
            let msig = bdef.methods.get(j)
            if msig.name == method_name {
                let subs = build_type_subs(recv_ty, msig)
                return Just(MethodResolution {
                    sig: msig,
                    source: MethodSource::FromBehavior(bhv_name),
                    type_subs: subs
                })
            }
        }
    }

    // Also check impl blocks in the registry
    let impl_method = find_method_in_impls(reg, type_name, method_name)
    when impl_method {
        Just(sig) => {
            let subs = build_type_subs(recv_ty, sig)
            return Just(MethodResolution {
                sig: sig,
                source: MethodSource::Inherent,
                type_subs: subs
            })
        },
        Nothing => {}
    }

    return Nothing
}

// ============================================================================
// Auto-deref dispatch
// ============================================================================

/// Try to dispatch through one level of auto-deref.
/// If recv_ty is Ref(T) or Named("Heap", [T]), try dispatching on T.
func try_deref_dispatch(
    reg: BehaviorRegistry,
    recv_ty: Type,
    method_name: Str
) -> Maybe[MethodResolution] {
    when recv_ty {
        Ref(r) => {
            let inner_name = get_type_name(r.inner.get())
            if inner_name != "" {
                let inherent = lookup_inherent_method(reg, inner_name, method_name)
                when inherent {
                    Just(sig) => {
                        let subs = build_type_subs(r.inner.get(), sig)
                        return Just(MethodResolution {
                            sig: sig,
                            source: MethodSource::AutoDeref,
                            type_subs: subs
                        })
                    },
                    Nothing => {}
                }
                let bhv_result = lookup_behavior_method(reg, inner_name, method_name, r.inner.get())
                when bhv_result {
                    Just(res) => return Just(MethodResolution {
                        sig: res.sig,
                        source: MethodSource::AutoDeref,
                        type_subs: res.type_subs
                    }),
                    Nothing => {}
                }
            }
        },
        Named(nt) => {
            // Auto-deref through Heap[T]
            if nt.name == "Heap" and nt.type_args.len() as I64 > 0 {
                let inner = nt.type_args.get(0).get()
                let inner_name = get_type_name(inner)
                if inner_name != "" {
                    let inherent = lookup_inherent_method(reg, inner_name, method_name)
                    when inherent {
                        Just(sig) => {
                            let subs = build_type_subs(inner, sig)
                            return Just(MethodResolution {
                                sig: sig,
                                source: MethodSource::AutoDeref,
                                type_subs: subs
                            })
                        },
                        Nothing => {}
                    }
                }
            }
        },
        _ => {}
    }
    return Nothing
}

// ============================================================================
// Type substitution builder
// ============================================================================

/// Build type parameter substitutions from a receiver type and method signature.
func build_type_subs(recv_ty: Type, sig: FuncSig) -> HashMap[Str, Type] {
    let subs = HashMap[Str, Type]::new(4)
    when recv_ty {
        Named(nt) => {
            let tp_count: I64 = sig.type_params.len() as I64
            let ta_count: I64 = nt.type_args.len() as I64
            var i: I64 = 0
            loop (i < tp_count and i < ta_count) {
                subs.set(sig.type_params.get(i), nt.type_args.get(i).get())
                i = i + 1
            }
        },
        _ => {}
    }
    return subs
}
