//! Import resolution for the TML self-hosting type checker.
//!
//! Resolves `use` declarations by looking up symbols in the ModuleRegistry
//! and registering them in the TypeEnv. Handles single imports, glob imports,
//! renamed imports, and re-export propagation.
//!
//! Phase 14b — items 2.1–2.5.

use compiler::types::ty::Type
use compiler::types::env::TypeEnv
use compiler::types::env::FuncSig
use compiler::types::env::StructDef
use compiler::types::env::EnumDef
use compiler::types::env::BehaviorDef
use compiler::types::env::env_register_function
use compiler::types::env::env_register_struct
use compiler::types::env::env_register_enum
use compiler::types::env::env_register_behavior
use compiler::types::env::env_register_type_alias
use compiler::types::env::env_register_impl
use compiler::types::module::Module
use compiler::types::module::ModuleRegistry
use compiler::types::module::ReExport
use compiler::types::module::ImportedSymbol
use compiler::types::module::registry_get
use compiler::types::module::registry_has
use compiler::types::module::module_lookup_func
use compiler::types::module::module_lookup_struct
use compiler::types::module::module_lookup_enum
use compiler::types::module::module_lookup_behavior
use compiler::types::module::module_lookup_alias
use compiler::ast::decls::UseDecl
use compiler::ast::decls::UsePath
use std::collections::list::List

// ============================================================================
// Use declaration resolution
// ============================================================================

/// Resolve a `use` declaration against the module registry.
/// Extracts the module path and symbol name from the UsePath segments,
/// then looks up and registers the symbol in the TypeEnv.
pub func resolve_use_decl(reg: ModuleRegistry, env: TypeEnv, decl: UseDecl) {
    let segs: List[Str] = decl.path.segments
    let count: I64 = segs.len() as I64
    if count < 2 { return }

    // Last segment is the symbol name; everything before is the module path
    let symbol: Str = segs.get(count - 1)

    // Build module path from segments 0..count-1
    var mod_path: Str = segs.get(0)
    var i: I64 = 1
    loop (i < count - 1) {
        mod_path = mod_path + "::" + segs.get(i)
        i = i + 1
    }

    // Check for alias
    let alias: Str = when decl.path.alias {
        Just(a) => a,
        Nothing => symbol
    }

    // Glob import: last segment is "*"
    if symbol == "*" {
        resolve_glob_import(reg, env, mod_path)
        return
    }

    // Single or renamed import
    resolve_single_import(reg, env, mod_path, symbol, alias)
}

// ============================================================================
// Single import resolution
// ============================================================================

/// Resolve `use module::path::Symbol` or `use module::path::Symbol as Alias`.
/// Looks up the symbol in the target module and registers it in the TypeEnv
/// under the local name (alias or original).
pub func resolve_single_import(reg: ModuleRegistry, env: TypeEnv, mod_path: Str, symbol: Str, local_name: Str) {
    let visited: List[Str] = List[Str]::new(4 as I64)
    resolve_single_import_impl(reg, env, mod_path, symbol, local_name, visited)
}

/// Internal implementation with cycle tracking.
func resolve_single_import_impl(reg: ModuleRegistry, env: TypeEnv, mod_path: Str, symbol: Str, local_name: Str, visited: List[Str]) {
    // Cycle check
    let vc: I64 = visited.len() as I64
    var vi: I64 = 0
    loop (vi < vc) {
        if visited.get(vi) == mod_path { return }
        vi = vi + 1
    }
    visited.push(mod_path)

    let maybe_mod: Maybe[Module] = registry_get(reg, mod_path)
    when maybe_mod {
        Nothing => {
            // Module not found — try shorter path (module might include the symbol)
            // e.g., "std::collections::list::List" → module "std::collections::list", symbol "List"
        },
        Just(m) => {
            // Try function
            let func_r: Maybe[FuncSig] = module_lookup_func(m, symbol)
            when func_r {
                Just(sig) => {
                    env_register_function(env, local_name, sig)
                    return
                },
                Nothing => {}
            }

            // Try struct
            let struct_r: Maybe[StructDef] = module_lookup_struct(m, symbol)
            when struct_r {
                Just(def) => {
                    env_register_struct(env, local_name, def)
                    return
                },
                Nothing => {}
            }

            // Try enum
            let enum_r: Maybe[EnumDef] = module_lookup_enum(m, symbol)
            when enum_r {
                Just(def) => {
                    env_register_enum(env, local_name, def)
                    return
                },
                Nothing => {}
            }

            // Try behavior
            let beh_r: Maybe[BehaviorDef] = module_lookup_behavior(m, symbol)
            when beh_r {
                Just(def) => {
                    env_register_behavior(env, local_name, def)
                    return
                },
                Nothing => {}
            }

            // Try type alias
            let alias_r: Maybe[Type] = module_lookup_alias(m, symbol)
            when alias_r {
                Just(ty) => {
                    env_register_type_alias(env, local_name, ty)
                    return
                },
                Nothing => {}
            }

            // Try re-exports
            let re_count: I64 = m.re_exports.len() as I64
            var ri: I64 = 0
            loop (ri < re_count) {
                let re: ReExport = m.re_exports.get(ri)
                if re.is_glob != 0 {
                    // Glob re-export: search in source module
                    resolve_single_import_impl(reg, env, re.source_path, symbol, local_name, visited)
                    return
                } else {
                    // Check if symbol is in the re-export's symbol list
                    let sc: I64 = re.symbols.len() as I64
                    var si: I64 = 0
                    loop (si < sc) {
                        if re.symbols.get(si) == symbol {
                            resolve_single_import_impl(reg, env, re.source_path, symbol, local_name, visited)
                            return
                        }
                        si = si + 1
                    }
                }
                ri = ri + 1
            }
        }
    }
}

// ============================================================================
// Glob import resolution
// ============================================================================

/// Resolve `use module::path::*` — register all public symbols from the module.
pub func resolve_glob_import(reg: ModuleRegistry, env: TypeEnv, mod_path: Str) {
    let maybe_mod: Maybe[Module] = registry_get(reg, mod_path)
    when maybe_mod {
        Nothing => {},
        Just(m) => {
            // Register all functions
            let fc: I64 = m.func_store.len() as I64
            var fi: I64 = 0
            loop (fi < fc) {
                let sig: FuncSig = m.func_store.get(fi)
                env_register_function(env, sig.name, sig)
                fi = fi + 1
            }

            // Register all structs
            let sc: I64 = m.struct_store.len() as I64
            var si: I64 = 0
            loop (si < sc) {
                let def: StructDef = m.struct_store.get(si)
                env_register_struct(env, def.name, def)
                si = si + 1
            }

            // Register all enums
            let ec: I64 = m.enum_store.len() as I64
            var ei: I64 = 0
            loop (ei < ec) {
                let def: EnumDef = m.enum_store.get(ei)
                env_register_enum(env, def.name, def)
                ei = ei + 1
            }

            // Register all behaviors
            let bc: I64 = m.behavior_store.len() as I64
            var bi: I64 = 0
            loop (bi < bc) {
                let def: BehaviorDef = m.behavior_store.get(bi)
                env_register_behavior(env, def.name, def)
                bi = bi + 1
            }

            // Propagate re-exports
            let rc: I64 = m.re_exports.len() as I64
            var ri: I64 = 0
            loop (ri < rc) {
                let re: ReExport = m.re_exports.get(ri)
                if re.is_glob != 0 {
                    resolve_glob_import(reg, env, re.source_path)
                } else {
                    let rsc: I64 = re.symbols.len() as I64
                    var rsi: I64 = 0
                    loop (rsi < rsc) {
                        let sym: Str = re.symbols.get(rsi)
                        resolve_single_import(reg, env, re.source_path, sym, sym)
                        rsi = rsi + 1
                    }
                }
                ri = ri + 1
            }
        }
    }
}

// ============================================================================
// Behavior impl propagation
// ============================================================================

/// Register all behavior implementations from a module into the TypeEnv.
/// Called after loading a module to make Drop/Send/Sync etc. visible.
pub func propagate_behavior_impls(reg: ModuleRegistry, env: TypeEnv, mod_path: Str) {
    let maybe_mod: Maybe[Module] = registry_get(reg, mod_path)
    when maybe_mod {
        Nothing => {},
        Just(m) => {
            // behavior_impls is HashMap[Str, List[Str]] — can't iterate directly
            // The impls are registered during module loading via register.tml
        }
    }
}
