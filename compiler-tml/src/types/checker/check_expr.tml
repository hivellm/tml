use std::collections::list::List
use core::alloc::heap::Heap

// ============================================================================
// Main dispatcher
// ============================================================================

/// Infer the type of an expression.
pub func infer_expr(ctx: InferCtx, env: TypeEnv, expr: Expr) -> Type {
    when expr {
        Literal(lit) => return infer_literal(lit),
        Ident(id) => return infer_ident(ctx, env, id),
        Binary(bin) => return infer_binary(ctx, env, bin),
        Unary(un) => return infer_unary(ctx, env, un),
        Call(call) => return check_call(ctx, env, call),
        MethodCall(mc) => return check_method_call(ctx, env, mc),
        Field(fld) => return infer_field(ctx, env, fld),
        Index(idx) => return infer_index(ctx, env, idx),
        Tuple(tup) => return infer_tuple(ctx, env, tup),
        Array(arr) => return infer_array(ctx, env, arr),
        If(ife) => return infer_if(ctx, env, ife),
        When(w) => return infer_when(ctx, env, w),
        Loop(lp) => return infer_loop(ctx, env, lp),
        While(wh) => return infer_while(ctx, env, wh),
        For(fr) => return infer_for(ctx, env, fr),
        Block(blk) => return infer_block(ctx, env, blk),
        Return(ret) => return infer_return(ctx, env, ret),
        Break(brk) => return make_never(),
        Continue(_) => return make_never(),
        Range(rng) => return infer_range(ctx, env, rng),
        Ternary(ter) => return infer_ternary(ctx, env, ter),
        IfLet(ile) => return infer_if_let(ctx, env, ile),
        Closure(cls) => return infer_closure(ctx, env, cls),
        Path(path) => return infer_path(ctx, env, path),
        Cast(cast) => return infer_cast(ctx, env, cast),
        Is(_) => return make_bool(),
        Try(tr) => return infer_try(ctx, env, tr),
        Await(aw) => return infer_expr(ctx, env, aw.expr.get()),
        Lowlevel(ll) => return infer_lowlevel(ctx, env, ll),
        InterpolatedString(is_) => return infer_interp_string(ctx, env, is_),
        TemplateLiteral(tl) => return infer_template_literal(ctx, env, tl),
        Struct(st) => return infer_struct(ctx, env, st),
        // Remaining variants: Base, New, Throw — return fresh type variable
        _ => return fresh_var(ctx)
    }
    // Unreachable — all when arms return
    return make_unit()
}

// ============================================================================
// Literal inference
// ============================================================================

/// Integer → I32, Float → F64, String → Str, Bool → Bool, Char → I32, Null → Unit.
func infer_literal(lit: LiteralExpr) -> Type {
    when lit.value {
        LitInt(_) => return make_i32(),
        LitFloat(_) => return make_f64(),
        LitStr(_) => return make_str(),
        LitBool(_) => return make_bool(),
        LitChar(_) => return make_i32(),
        LitNull => return make_unit()
    }
    return make_unit()
}

// ============================================================================
// Identifier lookup
// ============================================================================

/// Look up a name in the scope chain, then builtins/aliases.
func infer_ident(ctx: InferCtx, env: TypeEnv, id: IdentExpr) -> Type {
    // Check scope chain
    let scope_count: I64 = env.scopes.len() as I64
    if scope_count > 0 {
        let top = env.scopes.get(scope_count - 1)
        let sym: Maybe[Symbol] = scope_lookup(top, id.name)
        when sym {
            Just(s) => return s.ty.get(),
            Nothing => {}
        }
    }

    // Check functions
    let func_r = env_lookup_function(env, id.name)
    when func_r {
        Just(sig) => return sig.return_type.get(),
        Nothing => {}
    }

    // Check builtins
    let type_r = env_lookup_type(env, id.name)
    when type_r {
        Just(t) => return t,
        Nothing => {}
    }

    ctx.errors.push(undefined_variable(id.name, id.span))
    return fresh_var(ctx)
}

// ============================================================================
// Binary expression
// ============================================================================

/// Infer both operands and return the result type based on the operator.
func infer_binary(ctx: InferCtx, env: TypeEnv, bin: BinaryExpr) -> Type {
    let left: Type = infer_expr(ctx, env, bin.left.get())
    let right: Type = infer_expr(ctx, env, bin.right.get())

    when bin.op {
        // Comparison operators always return Bool
        OpEq => return make_bool(),
        OpNe => return make_bool(),
        OpLt => return make_bool(),
        OpGt => return make_bool(),
        OpLe => return make_bool(),
        OpGe => return make_bool(),
        // Logical operators: both sides Bool, result Bool
        OpAnd => {
            unify(ctx, left, make_bool(), bin.span)
            unify(ctx, right, make_bool(), bin.span)
            return make_bool()
        },
        OpOr => {
            unify(ctx, left, make_bool(), bin.span)
            unify(ctx, right, make_bool(), bin.span)
            return make_bool()
        },
        // Arithmetic: unify operands, return same type
        _ => {
            unify(ctx, left, right, bin.span)
            return resolve(ctx, left)
        }
    }
    return make_unit()
}

// ============================================================================
// Unary expression
// ============================================================================

func infer_unary(ctx: InferCtx, env: TypeEnv, un: UnaryExpr) -> Type {
    let operand: Type = infer_expr(ctx, env, un.operand.get())
    when un.op {
        OpNot => return make_bool(),
        OpNeg => return operand,
        OpRef => return make_ref(operand, 0),
        OpRefMut => return make_ref(operand, 1),
        _ => return operand
    }
    return operand
}

// ============================================================================
// Field access
// ============================================================================

func infer_field(ctx: InferCtx, env: TypeEnv, fld: FieldExpr) -> Type {
    let recv_ty: Type = infer_expr(ctx, env, fld.object.get())
    let resolved: Type = resolve(ctx, recv_ty)

    when resolved {
        Named(nt) => {
            // Look up struct definition
            let struct_r = env_lookup_struct(env, nt.name)
            let Just(def) = struct_r else { return fresh_var(ctx) }
            // Find field by name
            let fc: I64 = def.fields.len() as I64
            for i in 0 to fc {
                let f: StructFieldDef = def.fields.get(i)
                if f.name == fld.field {
                    return f.ty.get()
                }
            }
            ctx.errors.push(unknown_field(nt.name, fld.field, fld.span))
            return fresh_var(ctx)
        },
        _ => return fresh_var(ctx)
    }
    return fresh_var(ctx)
}

// ============================================================================
// Index access
// ============================================================================

/// Infer type for `obj[index]`. For arrays/slices, returns the element type.
func infer_index(ctx: InferCtx, env: TypeEnv, idx: IndexExpr) -> Type {
    let obj_ty: Type = infer_expr(ctx, env, idx.object.get())
    let _ = infer_expr(ctx, env, idx.index.get())
    let resolved: Type = resolve(ctx, obj_ty)

    when resolved {
        Array(arr) => return arr.element.get(),
        Slice(sl) => return sl.element.get(),
        _ => return fresh_var(ctx)
    }
}

// ============================================================================
// Tuple expression
// ============================================================================

func infer_tuple(ctx: InferCtx, env: TypeEnv, tup: TupleExpr) -> Type {
    let count: I64 = tup.elements.len() as I64
    let elements: List[Heap[Type]] = List[Heap[Type]]::new(count)
    for i in 0 to count {
        let elem_ty: Type = infer_expr(ctx, env, tup.elements.get(i).get())
        elements.push(Heap::new(elem_ty))
    }
    return make_tuple(elements)
}

// ============================================================================
// Array expression
// ============================================================================

func infer_array(ctx: InferCtx, env: TypeEnv, arr: ArrayExpr) -> Type {
    when arr.kind {
        Elements(elems) => {
            let count: I64 = elems.len() as I64
            if count == 0 { return fresh_var(ctx) }
            let first: Type = infer_expr(ctx, env, elems.get(0).get())
            for i in 1 to count {
                let elem_ty: Type = infer_expr(ctx, env, elems.get(i).get())
                unify(ctx, first, elem_ty, arr.span)
            }
            return resolve(ctx, first)
        },
        Repeat(val, _count) => {
            return infer_expr(ctx, env, val.get())
        }
    }
    return fresh_var(ctx)
}

// ============================================================================
// If expression
// ============================================================================

func infer_if(ctx: InferCtx, env: TypeEnv, ife: IfExpr) -> Type {
    // Check condition is Bool
    let cond_ty: Type = infer_expr(ctx, env, ife.condition.get())
    unify(ctx, cond_ty, make_bool(), ife.span)

    // Infer then branch
    let then_ty: Type = infer_expr(ctx, env, ife.then_branch.get())

    // Infer else branch if present
    let Just(else_expr) = ife.else_branch else { return make_unit() }
    let else_ty: Type = infer_expr(ctx, env, else_expr.get())
    // If neither branch is Never, unify them
    if not is_never(then_ty) and not is_never(else_ty) {
        unify(ctx, then_ty, else_ty, ife.span)
    }
    return resolve(ctx, then_ty)
}

// ============================================================================
// Block expression
// ============================================================================

func infer_block(ctx: InferCtx, env: TypeEnv, blk: BlockExpr) -> Type {
    env_push_scope(env, ScopeKind::BlockScope)
    let count: I64 = blk.stmts.len() as I64
    for i in 0 to count {
        check_stmt_inline(ctx, env, blk.stmts.get(i).get())
    }
    // Block type is the type of the trailing expression if present
    let result: Type = when blk.expr {
        Just(e) => infer_expr(ctx, env, e.get()),
        Nothing => make_unit()
    }
    env_pop_scope(env)
    return result
}

// ============================================================================
// Return expression
// ============================================================================

func infer_return(ctx: InferCtx, env: TypeEnv, ret: ReturnExpr) -> Type {
    when ret.value {
        Just(val) => { let _ = infer_expr(ctx, env, val.get()) },
        Nothing => {}
    }
    return make_never()
}

// ============================================================================
// Struct literal
// ============================================================================

func infer_struct(ctx: InferCtx, env: TypeEnv, st: StructExpr) -> Type {
    // Extract name from path (last segment)
    let segs = st.path.segments
    let seg_count: I64 = segs.len() as I64
    let name: Str = if seg_count > 0 { segs.get(seg_count - 1) } else { "<unknown>" }
    let struct_r = env_lookup_struct(env, name)
    when struct_r {
        Just(def) => {
            // Check each field in the literal
            let fc: I64 = st.fields.len() as I64
            for i in 0 to fc {
                let field_expr = st.fields.get(i)
                let _ = infer_expr(ctx, env, field_expr.value.get())
            }
            return make_named_simple(name, "")
        },
        Nothing => {
            ctx.errors.push(type_error("Unknown struct: " + name, st.span))
            return fresh_var(ctx)
        }
    }
    return fresh_var(ctx)
}

// ============================================================================
// When (pattern match) expression
// ============================================================================

func infer_when(ctx: InferCtx, env: TypeEnv, w: WhenExpr) -> Type {
    let scrutinee_ty: Type = infer_expr(ctx, env, w.scrutinee.get())
    var result_ty: Type = make_unit()
    var has_result: I64 = 0

    let arm_count: I64 = w.arms.len() as I64
    for i in 0 to arm_count {
        let arm: WhenArm = w.arms.get(i)
        env_push_scope(env, ScopeKind::BlockScope)

        // Bind pattern variables (simplified — full impl in check_pattern)
        bind_pattern_simple(ctx, env, arm.pattern.get(), scrutinee_ty)

        // Check guard if present
        when arm.guard {
            Just(g) => { let _ = infer_expr(ctx, env, g.get()) },
            Nothing => {}
        }

        let arm_ty: Type = infer_expr(ctx, env, arm.body.get())
        env_pop_scope(env)

        // Unify arm types (with Never coercion)
        if has_result == 0 {
            result_ty = arm_ty
            has_result = 1
        } else if is_never(result_ty) {
            result_ty = arm_ty
        } else if not is_never(arm_ty) {
            unify(ctx, result_ty, arm_ty, w.span)
        }
    }
    return result_ty
}

/// Simplified pattern binding — binds ident patterns in scope.
pub func bind_pattern_simple(ctx: InferCtx, env: TypeEnv, pat: Pattern, ty: Type) {
    let scope_count: I64 = env.scopes.len() as I64
    if scope_count == 0 { return }
    let top = env.scopes.get(scope_count - 1)
    when pat {
        Ident(ip) => {
            let span = ip.span
            scope_define(top, ip.name, ty, 0, span)
        },
        Enum(ep) => {
            // For enum patterns like Just(x), bind inner patterns
            // with the payload type. Simplified: bind first arg as fresh var.
            let pc: I64 = ep.args.len() as I64
            for i in 0 to pc {
                bind_pattern_simple(ctx, env, ep.args.get(i).get(), fresh_var(ctx))
            }
        },
        Tuple(tp) => {
            // Bind tuple sub-patterns
            let pc: I64 = tp.patterns.len() as I64
            for i in 0 to pc {
                bind_pattern_simple(ctx, env, tp.patterns.get(i).get(), fresh_var(ctx))
            }
        },
        _ => {}
    }
}

// ============================================================================
// Loop expression
// ============================================================================

func infer_loop(ctx: InferCtx, env: TypeEnv, lp: LoopExpr) -> Type {
    env_push_scope(env, ScopeKind::BlockScope)
    let _ = infer_expr(ctx, env, lp.condition.get())
    let _ = infer_expr(ctx, env, lp.body.get())
    env_pop_scope(env)
    return make_unit()
}

// ============================================================================
// While expression
// ============================================================================

func infer_while(ctx: InferCtx, env: TypeEnv, wh: WhileExpr) -> Type {
    let cond_ty: Type = infer_expr(ctx, env, wh.condition.get())
    unify(ctx, cond_ty, make_bool(), wh.span)
    env_push_scope(env, ScopeKind::BlockScope)
    let _ = infer_expr(ctx, env, wh.body.get())
    env_pop_scope(env)
    return make_unit()
}

// ============================================================================
// For-in expression
// ============================================================================

func infer_for(ctx: InferCtx, env: TypeEnv, fr: ForExpr) -> Type {
    env_push_scope(env, ScopeKind::BlockScope)
    let iter_ty: Type = infer_expr(ctx, env, fr.iter.get())

    // Extract element type from the iterator
    let elem_ty: Type = extract_iterator_element(iter_ty)

    // Bind the loop variable
    bind_pattern_simple(ctx, env, fr.pattern.get(), elem_ty)

    let _ = infer_expr(ctx, env, fr.body.get())
    env_pop_scope(env)
    return make_unit()
}

/// Extract the element type from an iterator/collection type.
func extract_iterator_element(ty: Type) -> Type {
    when ty {
        Named(nt) => {
            // Range[T], RangeInclusive[T] → T
            if (nt.name == "Range" or nt.name == "RangeInclusive") and nt.type_args.len() as I64 > 0 {
                return nt.type_args.get(0).get()
            }
            // Slice[T], List[T], Vec[T], Buffer → element type
            if (nt.name == "List" or nt.name == "Vec") and nt.type_args.len() as I64 > 0 {
                return nt.type_args.get(0).get()
            }
            return make_i64()
        },
        Slice(s) => return s.element.get(),
        Array(a) => return a.element.get(),
        Primitive(_) => return ty,
        _ => return make_i64()
    }
}

// ============================================================================
// Range expression
// ============================================================================

func infer_range(ctx: InferCtx, env: TypeEnv, rng: RangeExpr) -> Type {
    var elem_ty: Type = make_i64()
    when rng.start {
        Just(s) => { elem_ty = infer_expr(ctx, env, s.get()) },
        Nothing => {}
    }
    let has_end = rng.end
    when has_end {
        Just(e) => {
            let end_ty = infer_expr(ctx, env, e.get())
            let _ = unify(ctx, elem_ty, end_ty, rng.span)
        },
        Nothing => {}
    }
    // Return Range[T] or RangeInclusive[T]
    let args = List[Heap[Type]]::new(1)
    args.push(Heap::new(resolve(ctx, elem_ty)))
    let range_name: Str = if rng.inclusive == 1 { "RangeInclusive" } else { "Range" }
    return make_named(range_name, "", args)
}

// ============================================================================
// Ternary expression (condition ? true_val : false_val)
// ============================================================================

func infer_ternary(ctx: InferCtx, env: TypeEnv, ter: TernaryExpr) -> Type {
    let cond_ty = infer_expr(ctx, env, ter.condition.get())
    unify(ctx, cond_ty, make_bool(), ter.span)

    let true_ty = infer_expr(ctx, env, ter.true_value.get())
    let false_ty = infer_expr(ctx, env, ter.false_value.get())

    if is_never(true_ty) { return false_ty }
    if is_never(false_ty) { return true_ty }

    unify(ctx, true_ty, false_ty, ter.span)
    return resolve(ctx, true_ty)
}

// ============================================================================
// If-let expression
// ============================================================================

func infer_if_let(ctx: InferCtx, env: TypeEnv, ile: IfLetExpr) -> Type {
    let scrutinee_ty = infer_expr(ctx, env, ile.scrutinee.get())

    // Type check then branch with pattern bindings in scope
    env_push_scope(env, ScopeKind::BlockScope)
    bind_pattern_simple(ctx, env, ile.pattern.get(), scrutinee_ty)
    let then_ty = infer_expr(ctx, env, ile.then_branch.get())
    env_pop_scope(env)

    // Type check else branch if present
    let Just(else_expr) = ile.else_branch else { return make_unit() }
    let else_ty = infer_expr(ctx, env, else_expr.get())

    if is_never(then_ty) { return else_ty }
    if is_never(else_ty) { return then_ty }

    unify(ctx, then_ty, else_ty, ile.span)
    return resolve(ctx, then_ty)
}

// ============================================================================
// Closure expression
// ============================================================================

func infer_closure(ctx: InferCtx, env: TypeEnv, cls: ClosureExpr) -> Type {
    env_push_scope(env, ScopeKind::FunctionScope)

    // Define parameters in closure scope
    let param_types = List[Heap[Type]]::new(cls.params.len() as I64)
    let pc: I64 = cls.params.len() as I64
    for i in 0 to pc {
        let p: ClosureParam = cls.params.get(i)
        // If type annotation present, use it; otherwise fresh type var
        let param_ty: Type = fresh_var(ctx)
        param_types.push(Heap::new(param_ty))
        // Bind the parameter name in scope
        bind_pattern_simple(ctx, env, p.pattern.get(), param_ty)
    }

    // Infer body type
    let body_ty = infer_expr(ctx, env, cls.body.get())
    env_pop_scope(env)

    // Build closure type
    let captures = List[CapturedVar]::new(0)
    return make_closure(param_types, body_ty, captures)
}

// ============================================================================
// Path expression (qualified name lookup)
// ============================================================================

func infer_path(ctx: InferCtx, env: TypeEnv, path: PathExpr) -> Type {
    let segs = path.path.segments
    let seg_count: I64 = segs.len() as I64

    if seg_count == 0 { return fresh_var(ctx) }

    // Single segment: same as ident lookup
    if seg_count == 1 {
        let name = segs.get(0)
        // Check scope chain
        let scope_count: I64 = env.scopes.len() as I64
        if scope_count > 0 {
            let top = env.scopes.get(scope_count - 1)
            let sym = scope_lookup(top, name)
            when sym {
                Just(s) => return s.ty.get(),
                Nothing => {}
            }
        }
        // Check functions
        let func_r = env_lookup_function(env, name)
        when func_r {
            Just(sig) => return sig.return_type.get(),
            Nothing => {}
        }
        // Check types
        let type_r = env_lookup_type(env, name)
        when type_r {
            Just(t) => return t,
            Nothing => {}
        }
        return fresh_var(ctx)
    }

    // Multi-segment path: Type::variant, Module::func, etc.
    if seg_count == 2 {
        let type_name = segs.get(0)
        let member = segs.get(1)
        // Try qualified function lookup
        let qualified = type_name + "::" + member
        let func_r = env_lookup_function(env, qualified)
        when func_r {
            Just(sig) => return sig.return_type.get(),
            Nothing => {}
        }
        // Try enum variant (no args = unit variant)
        let enum_r = env_lookup_enum(env, type_name)
        when enum_r {
            Just(edef) => {
                let vc: I64 = edef.variants.len() as I64
                for i in 0 to vc {
                    if edef.variants.get(i).name == member {
                        return make_named_simple(type_name, "")
                    }
                }
            },
            Nothing => {}
        }
    }

    return fresh_var(ctx)
}

// ============================================================================
// Cast expression
// ============================================================================

func infer_cast(ctx: InferCtx, env: TypeEnv, cast: CastExpr) -> Type {
    // Type check the inner expression (side effect: unifies type vars)
    let _ = infer_expr(ctx, env, cast.expr.get())
    // The result type is the target type, but we can't resolve TypeExpr here
    // without importing it (name collision). Return Unit as approximation.
    return make_unit()
}

// ============================================================================
// Try expression (expr?)
// ============================================================================

func infer_try(ctx: InferCtx, env: TypeEnv, tr: TryExpr) -> Type {
    let inner_ty = infer_expr(ctx, env, tr.expr.get())
    let resolved = resolve(ctx, inner_ty)
    // If inner is Outcome[T, E], result is T
    when resolved {
        Named(nt) => {
            if nt.name == "Outcome" and nt.type_args.len() as I64 > 0 {
                return nt.type_args.get(0).get()
            }
            // If inner is Maybe[T], result is T
            if nt.name == "Maybe" and nt.type_args.len() as I64 > 0 {
                return nt.type_args.get(0).get()
            }
        },
        _ => {}
    }
    return fresh_var(ctx)
}

// ============================================================================
// Lowlevel block
// ============================================================================

func infer_lowlevel(ctx: InferCtx, env: TypeEnv, ll: LowlevelExpr) -> Type {
    // Type check all statements in the lowlevel block
    let sc: I64 = ll.stmts.len() as I64
    for i in 0 to sc {
        check_stmt_inline(ctx, env, ll.stmts.get(i).get())
    }
    // Check trailing expression if present
    when ll.expr {
        Just(e) => return infer_expr(ctx, env, e.get()),
        Nothing => return make_unit()
    }
}

// ============================================================================
// Interpolated string / template literal
// ============================================================================

func infer_interp_string(ctx: InferCtx, env: TypeEnv, is_: InterpolatedStringExpr) -> Type {
    // Type check each expression segment
    let sc: I64 = is_.segments.len() as I64
    for i in 0 to sc {
        let seg: InterpolatedSegment = is_.segments.get(i)
        when seg.kind {
            SegExpr(e) => { let _ = infer_expr(ctx, env, e.get()) },
            _ => {}
        }
    }
    return make_str()
}

func infer_template_literal(ctx: InferCtx, env: TypeEnv, tl: TemplateLiteralExpr) -> Type {
    let sc: I64 = tl.segments.len() as I64
    for i in 0 to sc {
        let seg: InterpolatedSegment = tl.segments.get(i)
        when seg.kind {
            SegExpr(e) => { let _ = infer_expr(ctx, env, e.get()) },
            _ => {}
        }
    }
    // Template literals return Text
    return make_named_simple("Text", "")
}

// ============================================================================
// Inline statement checker (avoids circular import with check_stmt.tml)
// ============================================================================

/// Check a statement — simplified inline version to avoid circular deps.
pub func check_stmt_inline(ctx: InferCtx, env: TypeEnv, stmt: Stmt) {
    when stmt {
        Let(ls) => {
            // Infer init if present
            when ls.init {
                Just(init_expr) => {
                    let init_ty: Type = infer_expr(ctx, env, init_expr.get())
                    // Extract name from IdentPattern (simplified — full pattern matching in check_pattern)
                    let scope_count: I64 = env.scopes.len() as I64
                    if scope_count > 0 {
                        let top = env.scopes.get(scope_count - 1)
                        // Try to get variable name from pattern
                        let pat = ls.pattern.get()
                        when pat {
                            Ident(ip) => scope_define(top, ip.name, init_ty, 0, ls.span),
                            _ => {}
                        }
                    }
                },
                Nothing => {}
            }
        },
        Var(vs) => {
            when vs.init {
                Just(init_expr) => {
                    let init_ty: Type = infer_expr(ctx, env, init_expr.get())
                    let scope_count: I64 = env.scopes.len() as I64
                    if scope_count > 0 {
                        let top = env.scopes.get(scope_count - 1)
                        scope_define(top, vs.name, init_ty, 1, vs.span)
                    }
                },
                Nothing => {}
            }
        },
        Expr(e) => {
            let _ = infer_expr(ctx, env, e.get())
        },
        _ => {}
    }
}
