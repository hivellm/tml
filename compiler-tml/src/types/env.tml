//! Type environment for the TML self-hosting type checker.
//!
//! Mirrors `compiler/include/types/env.hpp`. Holds all type definitions,
//! function signatures, behavior definitions, and scope chain. HashMap-backed
//! with O(1) average lookup.
//!
//! Phase 14a — items 2.1–2.5.

use compiler::source::SourceSpan
use compiler::types::ty::Type
use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

// ============================================================================
// Supporting types — mirrors env.hpp structs
// ============================================================================

/// Constraint on a generic parameter: must implement a behavior.
pub type BoundConstraint {
    behavior_name: Str,
    type_args: List[Heap[Type]]
}

/// Where clause constraint on a type parameter.
pub type WhereConstraint {
    type_param: Str,
    required_behaviors: List[Str],
    parameterized_bounds: List[BoundConstraint]
}

/// Const generic parameter declaration.
pub type ConstGenericParam {
    name: Str,
    value_type: Heap[Type]
}

/// Function signature — mirrors `FuncSig` in `env.hpp`.
pub type FuncSig {
    name: Str,
    params: List[Heap[Type]],
    return_type: Heap[Type],
    type_params: List[Str],
    is_async: I64,
    span: SourceSpan,
    where_constraints: List[WhereConstraint],
    is_lowlevel: I64,
    is_intrinsic: I64,
    extern_abi: Maybe[Str],
    extern_name: Maybe[Str],
    const_params: List[ConstGenericParam]
}

/// Struct field definition.
pub type StructFieldDef {
    name: Str,
    ty: Heap[Type],
    has_default: I64
}

/// Struct definition — mirrors `StructDef` in `env.hpp`.
pub type StructDef {
    name: Str,
    type_params: List[Str],
    const_params: List[ConstGenericParam],
    fields: List[StructFieldDef],
    span: SourceSpan,
    is_interior_mutable: I64,
    is_union: I64,
    is_simd: I64
}

/// Enum definition — mirrors `EnumDef` in `env.hpp`.
/// Each variant is a name + list of payload types.
pub type EnumVariantDef {
    name: Str,
    payload_types: List[Heap[Type]]
}

pub type EnumDef {
    name: Str,
    type_params: List[Str],
    const_params: List[ConstGenericParam],
    variants: List[EnumVariantDef],
    span: SourceSpan,
    is_flags: I64
}

/// Associated type in a behavior.
pub type AssociatedTypeDef {
    name: Str,
    bounds: List[Str],
    default_type: Maybe[Heap[Type]]
}

/// Behavior (trait) definition — mirrors `BehaviorDef` in `env.hpp`.
pub type BehaviorDef {
    name: Str,
    type_params: List[Str],
    const_params: List[ConstGenericParam],
    associated_types: List[AssociatedTypeDef],
    methods: List[FuncSig],
    super_behaviors: List[Str],
    methods_with_defaults: List[Str],
    span: SourceSpan
}

// ============================================================================
// Scope — lexical scope chain (item 2.2)
// ============================================================================

/// A variable binding in a scope.
pub type Symbol {
    name: Str,
    ty: Heap[Type],
    is_mutable: I64,
    span: SourceSpan
}

/// Scope kind — what introduced this scope.
@repr(U8)
pub enum ScopeKind {
    ModuleScope,
    FunctionScope,
    BlockScope
}

/// A lexical scope with local bindings and a parent link.
pub type Scope {
    kind: ScopeKind,
    symbols: HashMap[Str, Symbol],
    parent: Maybe[Heap[Scope]]
}

/// Create a new root scope (no parent).
pub func scope_new(kind: ScopeKind) -> Scope {
    return Scope {
        kind: kind,
        symbols: HashMap::new(16),
        parent: Nothing
    }
}

/// Create a child scope with a parent.
pub func scope_child(parent: Scope, kind: ScopeKind) -> Scope {
    return Scope {
        kind: kind,
        symbols: HashMap::new(8),
        parent: Just(Heap::new(parent))
    }
}

/// Define a symbol in this scope.
pub func scope_define(scope: Scope, name: Str, ty: Type, is_mutable: I64, span: SourceSpan) {
    let sym: Symbol = Symbol { name: name, ty: Heap::new(ty), is_mutable: is_mutable, span: span }
    scope.symbols.set(name, sym)
}

/// Lookup a symbol in this scope only (no parent chain).
pub func scope_lookup_local(scope: Scope, name: Str) -> Maybe[Symbol] {
    if scope.symbols.has(name) {
        return Just(scope.symbols.get(name))
    }
    return Nothing
}

/// Lookup a symbol walking the parent chain.
pub func scope_lookup(scope: Scope, name: Str) -> Maybe[Symbol] {
    if scope.symbols.has(name) {
        return Just(scope.symbols.get(name))
    }
    when scope.parent {
        Just(p) => return scope_lookup(p.get(), name),
        Nothing => return Nothing
    }
}

// ============================================================================
// TypeEnv — the central type registry (items 2.1, 2.3, 2.4, 2.5)
// ============================================================================

/// The type environment holding all registered types, functions, behaviors,
/// and the scope chain. Mirrors `TypeEnv` from `env.hpp`.
pub type TypeEnv {
    // All definition stores use List + HashMap[Str, I64] index pattern.
    // Direct HashMap[Str, ComplexType] triggers "Unknown method: duplicate"
    // codegen bug when the value type transitively contains Heap[Type].

    // Type stores (append-only, looked up by index)
    type_store: List[Type],
    struct_store: List[StructDef],
    enum_store: List[EnumDef],
    behavior_store: List[BehaviorDef],
    func_store: List[FuncSig],

    // Name → index maps (all HashMap[Str, I64])
    builtin_index: HashMap[Str, I64],
    alias_index: HashMap[Str, I64],
    struct_index: HashMap[Str, I64],
    enum_index: HashMap[Str, I64],
    behavior_index: HashMap[Str, I64],
    func_index: HashMap[Str, I64],

    // Behavior implementation tracking
    behavior_impls: HashMap[Str, List[Str]],

    // Scope chain
    scopes: List[Scope],

    // Type variable counter for inference
    type_var_counter: I64,

    // Module context
    current_module_path: Str
}

/// Create a new empty TypeEnv.
pub func env_new() -> TypeEnv {
    let root_scope: Scope = scope_new(ScopeKind::ModuleScope)
    let scopes: List[Scope] = List::new(8)
    scopes.push(root_scope)
    return TypeEnv {
        type_store: List::new(64),
        struct_store: List::new(32),
        enum_store: List::new(16),
        behavior_store: List::new(16),
        func_store: List::new(64),
        builtin_index: HashMap::new(32),
        alias_index: HashMap::new(16),
        struct_index: HashMap::new(64),
        enum_index: HashMap::new(32),
        behavior_index: HashMap::new(32),
        func_index: HashMap::new(128),
        behavior_impls: HashMap::new(64),
        scopes: scopes,
        type_var_counter: 0,
        current_module_path: ""
    }
}

// ============================================================================
// Type registration (item 2.3)
// ============================================================================

/// Register a struct definition. Returns false if name already registered.
pub func env_register_struct(env: TypeEnv, name: Str, def: StructDef) -> Bool {
    if env.struct_index.has(name) { return false }
    let idx: I64 = env.struct_store.len() as I64
    env.struct_store.push(def)
    env.struct_index.set(name, idx)
    return true
}

/// Register an enum definition. Returns false if name already registered.
pub func env_register_enum(env: TypeEnv, name: Str, def: EnumDef) -> Bool {
    if env.enum_index.has(name) { return false }
    let idx: I64 = env.enum_store.len() as I64
    env.enum_store.push(def)
    env.enum_index.set(name, idx)
    return true
}

/// Register a behavior definition. Returns false if name already registered.
pub func env_register_behavior(env: TypeEnv, name: Str, def: BehaviorDef) -> Bool {
    if env.behavior_index.has(name) { return false }
    let idx: I64 = env.behavior_store.len() as I64
    env.behavior_store.push(def)
    env.behavior_index.set(name, idx)
    return true
}

/// Register a type alias.
pub func env_register_type_alias(env: TypeEnv, name: Str, ty: Type) {
    let idx: I64 = env.type_store.len() as I64
    env.type_store.push(ty)
    env.alias_index.set(name, idx)
}

/// Register a builtin type.
pub func env_register_builtin(env: TypeEnv, name: Str, ty: Type) {
    let idx: I64 = env.type_store.len() as I64
    env.type_store.push(ty)
    env.builtin_index.set(name, idx)
}

// ============================================================================
// Function registration (item 2.4)
// ============================================================================

/// Register a function signature. Overwrites if name already exists
/// (first overload wins; overloading support deferred to phase14b).
pub func env_register_function(env: TypeEnv, name: Str, sig: FuncSig) {
    let idx: I64 = env.func_store.len() as I64
    env.func_store.push(sig)
    env.func_index.set(name, idx)
}

// ============================================================================
// Behavior implementation registration
// ============================================================================

/// Record that `type_name` implements `behavior_name`.
pub func env_register_impl(env: TypeEnv, type_name: Str, behavior_name: Str) {
    if env.behavior_impls.has(type_name) {
        let impls: List[Str] = env.behavior_impls.get(type_name)
        impls.push(behavior_name)
    } else {
        let impls: List[Str] = List::new(4)
        impls.push(behavior_name)
        env.behavior_impls.set(type_name, impls)
    }
}

/// Check if `type_name` implements `behavior_name`.
pub func env_type_implements(env: TypeEnv, type_name: Str, behavior_name: Str) -> Bool {
    if not env.behavior_impls.has(type_name) { return false }
    let impls: List[Str] = env.behavior_impls.get(type_name)
    let count: I64 = impls.len() as I64
    for i in 0 to count {
        if impls.get(i) == behavior_name { return true }
    }
    return false
}

/// Get all behaviors implemented by a type.
pub func env_get_behavior_impls(env: TypeEnv, type_name: Str) -> List[Str] {
    if env.behavior_impls.has(type_name) {
        return env.behavior_impls.get(type_name)
    }
    return List::new(0)
}

// ============================================================================
// Scope management (item 2.5)
// ============================================================================

/// Push a new scope onto the scope stack.
pub func env_push_scope(env: TypeEnv, kind: ScopeKind) {
    let new_scope: Scope = scope_new(kind)
    env.scopes.push(new_scope)
}

/// Pop the top scope. Does nothing if only the root scope remains.
pub func env_pop_scope(env: TypeEnv) {
    let count: I64 = env.scopes.len() as I64
    if count > 1 {
        env.scopes.pop()
    }
}

/// Lookup a name in the type environment.
/// Searches: current scope chain → builtins → type aliases → structs → enums.
pub func env_lookup_type(env: TypeEnv, name: Str) -> Maybe[Type] {
    // Check scope chain (local variables)
    let scope_count: I64 = env.scopes.len() as I64
    if scope_count > 0 {
        let top: Scope = env.scopes.get(scope_count - 1)
        let sym: Maybe[Symbol] = scope_lookup(top, name)
        when sym {
            Just(s) => return Just(s.ty.get()),
            Nothing => {}
        }
    }

    // Check builtins
    if env.builtin_index.has(name) {
        let idx: I64 = env.builtin_index.get(name)
        return Just(env.type_store.get(idx))
    }

    // Check type aliases
    if env.alias_index.has(name) {
        let idx: I64 = env.alias_index.get(name)
        return Just(env.type_store.get(idx))
    }

    return Nothing
}

/// Lookup a struct definition by name.
pub func env_lookup_struct(env: TypeEnv, name: Str) -> Maybe[StructDef] {
    if env.struct_index.has(name) {
        let idx: I64 = env.struct_index.get(name)
        return Just(env.struct_store.get(idx))
    }
    return Nothing
}

/// Lookup an enum definition by name.
pub func env_lookup_enum(env: TypeEnv, name: Str) -> Maybe[EnumDef] {
    if env.enum_index.has(name) {
        let idx: I64 = env.enum_index.get(name)
        return Just(env.enum_store.get(idx))
    }
    return Nothing
}

/// Lookup a behavior definition by name.
pub func env_lookup_behavior(env: TypeEnv, name: Str) -> Maybe[BehaviorDef] {
    if env.behavior_index.has(name) {
        let idx: I64 = env.behavior_index.get(name)
        return Just(env.behavior_store.get(idx))
    }
    return Nothing
}

/// Lookup a function signature by name.
pub func env_lookup_function(env: TypeEnv, name: Str) -> Maybe[FuncSig] {
    if env.func_index.has(name) {
        let idx: I64 = env.func_index.get(name)
        return Just(env.func_store.get(idx))
    }
    return Nothing
}

/// Generate a fresh type variable for inference.
pub func env_fresh_type_var(env: TypeEnv) -> Type {
    let id: I64 = env.type_var_counter
    env.type_var_counter = id + 1
    return Type::TypeVar(compiler::types::ty::TypeVarType { id: id, bound: Nothing })
}

/// Set the current module path.
pub func env_set_module(env: TypeEnv, path: Str) {
    env.current_module_path = path
}
