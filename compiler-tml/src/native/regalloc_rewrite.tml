//! Post-regalloc rewrite — replace VirtualReg operands with PhysReg.
//!
//! After linear_scan assigns physical registers, this pass walks all
//! instructions and replaces Operand::Reg(vreg) with Operand::PhysReg(phys).

use compiler::native::machir::MachFunc
use compiler::native::machir::MachBlock
use compiler::native::machir::MachInst
use compiler::native::machir::MachMov
use compiler::native::machir::MachBinOp
use compiler::native::machir::MachUnaryOp
use compiler::native::machir::MachCmp
use compiler::native::machir::Operand
use compiler::native::machir::VirtualReg
use compiler::native::linear_scan::RegAllocResult
use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

/// Rewrite all VirtualReg operands to PhysReg based on regalloc assignments.
pub func rewrite_vregs(mf: MachFunc, ra: RegAllocResult) {
    let bc: I64 = mf.blocks.len() as I64
    for bi in 0 to bc {
        let block: MachBlock = mf.blocks.get(bi)
        let ic: I64 = block.insts.len() as I64
        for ii in 0 to ic {
            let inst: MachInst = block.insts.get(ii)
            let rewritten: MachInst = rewrite_inst(inst, ra.assignments)
            block.insts.set(ii, rewritten)
        }
    }
}

/// Rewrite a single instruction's operands.
func rewrite_inst(inst: MachInst, assignments: HashMap[I64, I64]) -> MachInst {
    when inst {
        Mov(m) => return MachInst::Mov(MachMov {
            dst: rewrite_op(m.dst, assignments),
            src: rewrite_op(m.src, assignments),
            size: m.size
        }),
        Add(b) => return MachInst::Add(MachBinOp {
            dst: rewrite_op(b.dst, assignments),
            src: rewrite_op(b.src, assignments),
            size: b.size
        }),
        Sub(b) => return MachInst::Sub(MachBinOp {
            dst: rewrite_op(b.dst, assignments),
            src: rewrite_op(b.src, assignments),
            size: b.size
        }),
        Imul(b) => return MachInst::Imul(MachBinOp {
            dst: rewrite_op(b.dst, assignments),
            src: rewrite_op(b.src, assignments),
            size: b.size
        }),
        Cmp(c) => return MachInst::Cmp(MachCmp {
            lhs: rewrite_op(c.lhs, assignments),
            rhs: rewrite_op(c.rhs, assignments),
            size: c.size
        }),
        And(b) => return MachInst::And(MachBinOp {
            dst: rewrite_op(b.dst, assignments),
            src: rewrite_op(b.src, assignments),
            size: b.size
        }),
        Or(b) => return MachInst::Or(MachBinOp {
            dst: rewrite_op(b.dst, assignments),
            src: rewrite_op(b.src, assignments),
            size: b.size
        }),
        Xor(b) => return MachInst::Xor(MachBinOp {
            dst: rewrite_op(b.dst, assignments),
            src: rewrite_op(b.src, assignments),
            size: b.size
        }),
        Shl(b) => return MachInst::Shl(MachBinOp {
            dst: rewrite_op(b.dst, assignments),
            src: rewrite_op(b.src, assignments),
            size: b.size
        }),
        Sar(b) => return MachInst::Sar(MachBinOp {
            dst: rewrite_op(b.dst, assignments),
            src: rewrite_op(b.src, assignments),
            size: b.size
        }),
        Neg(u) => return MachInst::Neg(MachUnaryOp {
            operand: rewrite_op(u.operand, assignments),
            size: u.size
        }),
        Push(u) => return MachInst::Push(MachUnaryOp {
            operand: rewrite_op(u.operand, assignments),
            size: u.size
        }),
        Pop(u) => return MachInst::Pop(MachUnaryOp {
            operand: rewrite_op(u.operand, assignments),
            size: u.size
        }),
        _ => return inst
    }
}

/// Rewrite a single operand: Reg(vreg) → PhysReg(assigned).
func rewrite_op(op: Operand, assignments: HashMap[I64, I64]) -> Operand {
    when op {
        Reg(vr) => {
            if assignments.has(vr.id) {
                return Operand::PhysReg(assignments.get(vr.id))
            }
            // Fallback: use vreg id mod 16 as phys reg (wrong but won't crash)
            return Operand::PhysReg(vr.id % 7)
        },
        _ => return op
    }
}
