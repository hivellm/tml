//! AArch64 register file definitions.
//!
//! AArch64 has 31 general-purpose registers (X0-X30) in 64-bit mode,
//! with 32-bit aliases (W0-W30). X31 is context-dependent: XZR (zero
//! register) or SP (stack pointer) depending on the instruction.
//! X29 = FP (frame pointer), X30 = LR (link register).
//!
//! Phase 20b — item 1.1.

// ============================================================================
// 64-bit general-purpose registers (X0-X30)
// ============================================================================

pub const X0:  I64 = 0
pub const X1:  I64 = 1
pub const X2:  I64 = 2
pub const X3:  I64 = 3
pub const X4:  I64 = 4
pub const X5:  I64 = 5
pub const X6:  I64 = 6
pub const X7:  I64 = 7
pub const X8:  I64 = 8
pub const X9:  I64 = 9
pub const X10: I64 = 10
pub const X11: I64 = 11
pub const X12: I64 = 12
pub const X13: I64 = 13
pub const X14: I64 = 14
pub const X15: I64 = 15
pub const X16: I64 = 16
pub const X17: I64 = 17
pub const X18: I64 = 18
pub const X19: I64 = 19
pub const X20: I64 = 20
pub const X21: I64 = 21
pub const X22: I64 = 22
pub const X23: I64 = 23
pub const X24: I64 = 24
pub const X25: I64 = 25
pub const X26: I64 = 26
pub const X27: I64 = 27
pub const X28: I64 = 28
pub const X29: I64 = 29  // FP (frame pointer)
pub const X30: I64 = 30  // LR (link register)

/// XZR / SP share encoding 31. Context determines which:
/// - Data processing: XZR (zero register)
/// - Load/store base: SP (stack pointer)
pub const XZR: I64 = 31
pub const SP:  I64 = 31

// ============================================================================
// AAPCS64 argument registers
// ============================================================================

/// Integer argument registers: X0-X7 (8 args, vs Win64's 4).
pub const ARG_REG_COUNT: I64 = 8

/// Indirect result location register (sret pointer).
pub const X8_SRET: I64 = 8

/// Callee-saved registers: X19-X28, X29(FP), X30(LR).
/// Caller-saved: X0-X18, X29, X30 (link register saved/restored by callee).

// ============================================================================
// Register name helpers
// ============================================================================

/// Return the 64-bit register name for a register number (0-30, 31=SP/XZR).
pub func x_reg_name(r: I64) -> Str {
    if r == 31 { return "SP" }
    return "X" + r.to_string()
}

/// Return the 32-bit register name (W0-W30, WZR).
pub func w_reg_name(r: I64) -> Str {
    if r == 31 { return "WZR" }
    return "W" + r.to_string()
}

/// Check if a register is callee-saved (X19-X28).
pub func is_callee_saved(r: I64) -> Bool {
    return r >= 19 and r <= 28
}

/// Check if a register is an argument register (X0-X7).
pub func is_arg_reg(r: I64) -> Bool {
    return r >= 0 and r <= 7
}
