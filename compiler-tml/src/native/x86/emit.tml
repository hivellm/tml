//! MachIR → x86_64 bytes — top-level emitter with two-pass branch patching.
//!
//! `emit_func` takes a MachFunc (with stack allocation applied) and produces
//! a buffer of x86_64 machine code bytes. Branches use placeholder displacements
//! in pass 1, which are back-patched in pass 2 once all block offsets are known.
//!
//! Phase 18b — items 5.1–5.3.

use compiler::native::machir::*
use compiler::native::x86::encode::*
use compiler::native::stack_alloc::{StackAllocation, get_slot_offset}
use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

// ============================================================================
// Branch patch record
// ============================================================================

/// A branch instruction that needs its displacement patched.
pub type BranchPatch {
    /// Byte offset in the buffer where the rel32 displacement starts.
    offset: I64,
    /// Target block ID.
    target_block: I64
}

// ============================================================================
// Emit result
// ============================================================================

/// A relocation entry for the linker.
pub type RelocEntry {
    /// Byte offset in .text where the rel32 displacement starts.
    offset: I64,
    /// Symbol name to relocate to.
    symbol_name: Str,
    /// Relocation type: 0 = REL32 (call/branch), 1 = REL32 (data reference from LEA)
    reloc_kind: I64
}

/// Result of emitting a function: the byte buffer, block offsets, and relocations.
pub type EmitResult {
    bytes: List[I64],
    block_offsets: HashMap[I64, I64],
    patches: List[BranchPatch],
    relocations: List[RelocEntry],
    size: I64
}

// ============================================================================
// Top-level emitter (item 5.1)
// ============================================================================

/// Emit an entire MachFunc to x86_64 bytes with two-pass branch patching.
pub func emit_func(mf: MachFunc, alloc: StackAllocation) -> EmitResult {
    let buf = List[I64]::new(256)
    let block_offsets = HashMap[I64, I64]::new(16)
    let patches = List[BranchPatch]::new(16)
    let relocs = List[RelocEntry]::new(8)

    // Detect if function has any CALL instructions (is_leaf might not propagate through value copies)
    var has_calls: I64 = 0
    let bc_check: I64 = mf.blocks.len() as I64
    for bi_check in 0 to bc_check {
        let blk: MachBlock = mf.blocks.get(bi_check)
        let ic_check: I64 = blk.insts.len() as I64
        for ii_check in 0 to ic_check {
            when blk.insts.get(ii_check) {
                Call(_) => { has_calls = 1 },
                _ => {}
            }
        }
    }

    // Emit prologue for non-leaf functions (need stack alignment for calls)
    if has_calls > 0 {
        // push rbp
        encode_push(buf, 5)  // RBP
        // sub rsp, 32 (shadow space for Win64 ABI)
        emit_byte(buf, 0x48)  // REX.W
        emit_byte(buf, 0x83)  // SUB r64, imm8
        emit_byte(buf, modrm(3, 5, 4))  // /5 = SUB, rm = RSP
        emit_byte(buf, 32)   // 32 bytes shadow space
    }

    // Pass 1: emit all instructions with placeholder branch displacements
    let bc: I64 = mf.blocks.len() as I64
    for bi in 0 to bc {
        let block: MachBlock = mf.blocks.get(bi)
        block_offsets.set(block.id, buf.len() as I64)

        let ic: I64 = block.insts.len() as I64
        for ii in 0 to ic {
            let inst: MachInst = block.insts.get(ii)
            let leaf_flag: I64 = if has_calls > 0 { 0 } else { 1 }
            emit_mach_inst_with_relocs(buf, inst, alloc, patches, relocs, leaf_flag)
        }
    }

    // Pass 2: patch branch displacements (item 5.2)
    let pc: I64 = patches.len() as I64
    for pi in 0 to pc {
        let patch: BranchPatch = patches.get(pi)
        if block_offsets.has(patch.target_block) {
            let target_offset: I64 = block_offsets.get(patch.target_block)
            // rel32 = target - (patch_offset + 4) — displacement is relative to end of instruction
            let displacement: I64 = target_offset - (patch.offset + 4)
            // Patch the 4 bytes at patch.offset
            patch_imm32(buf, patch.offset, displacement)
        }
    }

    return EmitResult {
        bytes: buf,
        block_offsets: block_offsets,
        patches: patches,
        relocations: relocs,
        size: buf.len() as I64
    }
}

/// Patch a 32-bit value at a specific offset in the buffer.
func patch_imm32(buf: List[I64], offset: I64, val: I64) {
    buf.set(offset, val % 256)
    buf.set(offset + 1, (val / 256) % 256)
    buf.set(offset + 2, (val / 65536) % 256)
    buf.set(offset + 3, (val / 16777216) % 256)
}

// ============================================================================
// Single instruction emission
// ============================================================================

/// Emit a single MachInst to the byte buffer, tracking relocations.
func emit_mach_inst_with_relocs(buf: List[I64], inst: MachInst, alloc: StackAllocation, patches: List[BranchPatch], relocs: List[RelocEntry], is_leaf: I64) {
    when inst {
        Mov(m) => emit_mov_with_reloc(buf, m, alloc, relocs),
        Add(b) => emit_binop_add(buf, b, alloc),
        Sub(b) => emit_binop_sub(buf, b, alloc),
        Imul(b) => emit_binop_imul(buf, b, alloc),
        Idiv(u) => emit_idiv(buf, u, alloc),
        Cmp(c) => emit_cmp(buf, c, alloc),
        Jcc(j) => emit_jcc(buf, j, patches),
        Jmp(j) => emit_jmp(buf, j, patches),
        Call(c) => emit_call_with_reloc(buf, c, patches, relocs),
        Ret(_) => {
            // Emit epilogue before ret for non-leaf functions
            if is_leaf == 0 {
                // add rsp, 32
                emit_byte(buf, 0x48)
                emit_byte(buf, 0x83)
                emit_byte(buf, modrm(3, 0, 4))  // /0 = ADD, rm = RSP
                emit_byte(buf, 32)
                // pop rbp
                encode_pop(buf, 5)  // RBP
            }
            encode_ret(buf)
        },
        Push(u) => emit_push(buf, u),
        Pop(u) => emit_pop(buf, u),
        Lea(l) => emit_lea_inst(buf, l, alloc),
        Neg(u) => emit_neg(buf, u, alloc),
        And(b) => emit_binop_and(buf, b, alloc),
        Or(b) => emit_binop_or(buf, b, alloc),
        Xor(b) => emit_binop_xor(buf, b, alloc),
        Shl(b) => emit_shift_shl(buf, b, alloc),
        Sar(b) => emit_shift_sar(buf, b, alloc),
        Nop => encode_nop(buf),
        _ => encode_nop(buf)
    }
}

// ============================================================================
// Per-instruction emission helpers
// ============================================================================

func operand_to_reg(op: Operand) -> I64 {
    when op {
        PhysReg(r) => return r,
        Reg(vr) => return vr.id % 16,
        _ => return 0
    }
}

func operand_to_imm(op: Operand) -> I64 {
    when op {
        Imm(v) => return v,
        _ => return 0
    }
}

func is_imm(op: Operand) -> I64 {
    when op {
        Imm(_) => return 1,
        _ => return 0
    }
}

func emit_mov_with_reloc(buf: List[I64], m: MachMov, alloc: StackAllocation, relocs: List[RelocEntry]) {
    let dst_reg: I64 = operand_to_reg(m.dst)
    // Check for Label operand (string constants → LEA reg, [rip + disp32])
    when m.src {
        Label(name) => {
            // Emit LEA dst, [rip + 0x00000000] — relocation to be patched by linker
            let rex_byte: I64 = 0x48 + (if dst_reg >= 8 { 4 } else { 0 })
            emit_byte(buf, rex_byte)
            emit_byte(buf, 0x8D)  // LEA
            emit_byte(buf, modrm(0, dst_reg % 8, 5))  // mod=00, rm=101 = RIP-relative
            // Record relocation: the disp32 starts at current buf position
            relocs.push(RelocEntry {
                offset: buf.len() as I64,
                symbol_name: name,
                reloc_kind: 1  // REL32 data reference
            })
            emit_imm32(buf, 0)  // placeholder displacement
            return
        },
        _ => {}
    }
    if is_imm(m.src) > 0 {
        let imm: I64 = operand_to_imm(m.src)
        if fits_imm32(imm) > 0 {
            encode_mov_ri32(buf, dst_reg, imm)
        } else {
            encode_mov_ri64(buf, dst_reg, imm)
        }
    } else {
        let src_reg: I64 = operand_to_reg(m.src)
        encode_mov_rr(buf, dst_reg, src_reg)
    }
}

func emit_call_with_reloc(buf: List[I64], c: MachCall, patches: List[BranchPatch], relocs: List[RelocEntry]) {
    encode_call_rel32(buf, 0)  // placeholder displacement
    // Record relocation for the call target
    relocs.push(RelocEntry {
        offset: buf.len() as I64 - 4,  // disp32 starts 4 bytes before end
        symbol_name: c.target,
        reloc_kind: 0  // REL32 call
    })
}

func emit_binop_add(buf: List[I64], b: MachBinOp, alloc: StackAllocation) {
    let dst: I64 = operand_to_reg(b.dst)
    if is_imm(b.src) > 0 {
        encode_add_ri(buf, dst, operand_to_imm(b.src))
    } else {
        encode_add_rr(buf, dst, operand_to_reg(b.src))
    }
}

func emit_binop_sub(buf: List[I64], b: MachBinOp, alloc: StackAllocation) {
    let dst: I64 = operand_to_reg(b.dst)
    if is_imm(b.src) > 0 {
        encode_sub_ri(buf, dst, operand_to_imm(b.src))
    } else {
        encode_sub_rr(buf, dst, operand_to_reg(b.src))
    }
}

func emit_binop_imul(buf: List[I64], b: MachBinOp, alloc: StackAllocation) {
    encode_imul_rr(buf, operand_to_reg(b.dst), operand_to_reg(b.src))
}

func emit_idiv(buf: List[I64], u: MachUnaryOp, alloc: StackAllocation) {
    encode_idiv(buf, operand_to_reg(u.operand))
}

func emit_cmp(buf: List[I64], c: MachCmp, alloc: StackAllocation) {
    if is_imm(c.rhs) > 0 {
        encode_cmp_ri(buf, operand_to_reg(c.lhs), operand_to_imm(c.rhs))
    } else {
        encode_cmp_rr(buf, operand_to_reg(c.lhs), operand_to_reg(c.rhs))
    }
}

func emit_jcc(buf: List[I64], j: MachJcc, patches: List[BranchPatch]) {
    let cc_val: I64 = 0
    when j.cond {
        Eq => { encode_jcc_rel32(buf, 0x84, 0) },
        Ne => { encode_jcc_rel32(buf, 0x85, 0) },
        Lt => { encode_jcc_rel32(buf, 0x8C, 0) },
        Le => { encode_jcc_rel32(buf, 0x8E, 0) },
        Gt => { encode_jcc_rel32(buf, 0x8F, 0) },
        Ge => { encode_jcc_rel32(buf, 0x8D, 0) },
        Below => { encode_jcc_rel32(buf, 0x82, 0) },
        Above => { encode_jcc_rel32(buf, 0x87, 0) }
    }
    // Record patch: displacement starts 4 bytes before current position
    patches.push(BranchPatch { offset: buf.len() as I64 - 4, target_block: j.target })
}

func emit_jmp(buf: List[I64], j: MachJmp, patches: List[BranchPatch]) {
    encode_jmp_rel32(buf, 0)
    patches.push(BranchPatch { offset: buf.len() as I64 - 4, target_block: j.target })
}

// emit_call replaced by emit_call_with_reloc above

func emit_push(buf: List[I64], u: MachUnaryOp) {
    encode_push(buf, operand_to_reg(u.operand))
}

func emit_pop(buf: List[I64], u: MachUnaryOp) {
    encode_pop(buf, operand_to_reg(u.operand))
}

func emit_lea_inst(buf: List[I64], l: MachLea, alloc: StackAllocation) {
    encode_lea(buf, operand_to_reg(l.dst), l.disp)
}

func emit_neg(buf: List[I64], u: MachUnaryOp, alloc: StackAllocation) {
    encode_neg(buf, operand_to_reg(u.operand))
}

func emit_binop_and(buf: List[I64], b: MachBinOp, alloc: StackAllocation) {
    encode_and_rr(buf, operand_to_reg(b.dst), operand_to_reg(b.src))
}

func emit_binop_or(buf: List[I64], b: MachBinOp, alloc: StackAllocation) {
    encode_or_rr(buf, operand_to_reg(b.dst), operand_to_reg(b.src))
}

func emit_binop_xor(buf: List[I64], b: MachBinOp, alloc: StackAllocation) {
    encode_xor_rr(buf, operand_to_reg(b.dst), operand_to_reg(b.src))
}

func emit_shift_shl(buf: List[I64], b: MachBinOp, alloc: StackAllocation) {
    if is_imm(b.src) > 0 {
        encode_shl_ri(buf, operand_to_reg(b.dst), operand_to_imm(b.src))
    } else {
        encode_shl_ri(buf, operand_to_reg(b.dst), 1)
    }
}

func emit_shift_sar(buf: List[I64], b: MachBinOp, alloc: StackAllocation) {
    if is_imm(b.src) > 0 {
        encode_sar_ri(buf, operand_to_reg(b.dst), operand_to_imm(b.src))
    } else {
        encode_sar_ri(buf, operand_to_reg(b.dst), 1)
    }
}
