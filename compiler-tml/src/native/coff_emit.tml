//! PE/COFF object file emission — COFF data structures and section builders.
//!
//! Generates .obj files compatible with LLD and MSVC link.exe.
//! The COFF format consists of:
//! 1. File header (20 bytes)
//! 2. Section headers (40 bytes each)
//! 3. Raw section data (.text, .data, .rdata)
//! 4. Relocations (10 bytes each)
//! 5. Symbol table (18 bytes per symbol)
//! 6. String table (4-byte size prefix + null-terminated strings)
//!
//! Phase 18c — items 1.1–4.3.

use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

// ============================================================================
// Constants
// ============================================================================

/// Machine type: x86_64 (AMD64).
const IMAGE_FILE_MACHINE_AMD64: I64 = 0x8664

/// Section characteristics.
const SCN_TEXT: I64 = 0x60500020    // .text: code, execute, read, align(16)
const SCN_DATA: I64 = 0xC0300040    // .data: initialized, read, write
const SCN_RDATA: I64 = 0x40300040   // .rdata: initialized, read-only
const SCN_PDATA: I64 = 0x40300040   // .pdata: same as rdata

/// Symbol storage classes.
const IMAGE_SYM_CLASS_EXTERNAL: I64 = 2
const IMAGE_SYM_CLASS_STATIC: I64 = 3
const IMAGE_SYM_CLASS_LABEL: I64 = 6

/// Relocation types.
const IMAGE_REL_AMD64_ADDR64: I64 = 0x0001
const IMAGE_REL_AMD64_REL32: I64 = 0x0004

// ============================================================================
// Phase 1: COFF Data Structures (items 1.1–1.4)
// ============================================================================

/// COFF file header (20 bytes).
pub type CoffFileHeader {
    machine: I64,
    num_sections: I64,
    timestamp: I64,
    symbol_table_ptr: I64,
    num_symbols: I64,
    optional_header_size: I64,
    characteristics: I64
}

/// COFF section header (40 bytes).
pub type CoffSectionHeader {
    name: Str,
    virtual_size: I64,
    virtual_address: I64,
    raw_data_size: I64,
    raw_data_ptr: I64,
    reloc_ptr: I64,
    num_relocs: I64,
    characteristics: I64
}

/// COFF symbol (18 bytes).
pub type CoffSymbol {
    name: Str,
    value: I64,
    section_number: I64,
    sym_type: I64,
    storage_class: I64
}

/// COFF relocation (10 bytes).
pub type CoffRelocation {
    virtual_address: I64,
    symbol_index: I64,
    reloc_type: I64
}

// ============================================================================
// Phase 2: Section Management (items 2.1–2.4)
// ============================================================================

/// A section being built.
pub type CoffSection {
    header: CoffSectionHeader,
    data: List[I64],
    relocations: List[CoffRelocation]
}

/// Create a .text section from encoded bytes.
pub func make_text_section(code: List[I64]) -> CoffSection {
    return CoffSection {
        header: CoffSectionHeader {
            name: ".text",
            virtual_size: 0,
            virtual_address: 0,
            raw_data_size: code.len() as I64,
            raw_data_ptr: 0,
            reloc_ptr: 0,
            num_relocs: 0,
            characteristics: SCN_TEXT
        },
        data: code,
        relocations: List[CoffRelocation]::new(8)
    }
}

/// Create a .data section from initialized data bytes.
pub func make_data_section(data: List[I64]) -> CoffSection {
    return CoffSection {
        header: CoffSectionHeader {
            name: ".data",
            virtual_size: 0,
            virtual_address: 0,
            raw_data_size: data.len() as I64,
            raw_data_ptr: 0,
            reloc_ptr: 0,
            num_relocs: 0,
            characteristics: SCN_DATA
        },
        data: data,
        relocations: List[CoffRelocation]::new(4)
    }
}

/// Create a .rdata section for read-only data.
pub func make_rdata_section(data: List[I64]) -> CoffSection {
    return CoffSection {
        header: CoffSectionHeader {
            name: ".rdata",
            virtual_size: 0,
            virtual_address: 0,
            raw_data_size: data.len() as I64,
            raw_data_ptr: 0,
            reloc_ptr: 0,
            num_relocs: 0,
            characteristics: SCN_RDATA
        },
        data: data,
        relocations: List[CoffRelocation]::new(0)
    }
}

// ============================================================================
// Phase 3: Symbol Table (items 3.1–3.3)
// ============================================================================

/// Add a function symbol (defined in .text section).
pub func make_func_symbol(name: Str, offset: I64, section: I64) -> CoffSymbol {
    return CoffSymbol {
        name: name,
        value: offset,
        section_number: section,
        sym_type: 0x20,  // function type
        storage_class: IMAGE_SYM_CLASS_EXTERNAL
    }
}

/// Add a static (internal) symbol.
pub func make_static_symbol(name: Str, offset: I64, section: I64) -> CoffSymbol {
    return CoffSymbol {
        name: name,
        value: offset,
        section_number: section,
        sym_type: 0,
        storage_class: IMAGE_SYM_CLASS_STATIC
    }
}

/// Add an external reference symbol (undefined, to be resolved by linker).
pub func make_extern_symbol(name: Str) -> CoffSymbol {
    return CoffSymbol {
        name: name,
        value: 0,
        section_number: 0,  // IMAGE_SYM_UNDEFINED
        sym_type: 0x20,
        storage_class: IMAGE_SYM_CLASS_EXTERNAL
    }
}

// ============================================================================
// Phase 4: Relocations (items 4.1–4.3)
// ============================================================================

/// Create a REL32 relocation (for CALL/JMP instructions).
pub func make_rel32_reloc(offset: I64, symbol_index: I64) -> CoffRelocation {
    return CoffRelocation {
        virtual_address: offset,
        symbol_index: symbol_index,
        reloc_type: IMAGE_REL_AMD64_REL32
    }
}

/// Create an ADDR64 relocation (for absolute 64-bit data references).
pub func make_addr64_reloc(offset: I64, symbol_index: I64) -> CoffRelocation {
    return CoffRelocation {
        virtual_address: offset,
        symbol_index: symbol_index,
        reloc_type: IMAGE_REL_AMD64_ADDR64
    }
}

/// Add a relocation to a section.
pub func section_add_reloc(section: CoffSection, reloc: CoffRelocation) {
    section.relocations.push(reloc)
    section.header.num_relocs = section.relocations.len() as I64
}
