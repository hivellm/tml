//! MIR → MachIR lowering pass.
//!
//! Translates each MIR instruction into one or more MachIR instructions
//! using unlimited virtual registers. No register allocation happens here —
//! that's the allocator's job (stack_alloc.tml or linear_scan.tml).
//!
//! Phase 18a — items 2.1–2.6.

use compiler::mir::types::*
use compiler::mir::inst::*
use compiler::mir::block::*
use compiler::mir::module::MirFunc
use compiler::hir::expr::{HirBinOp, HirUnaryOp}
use compiler::native::machir::*
use std::collections::list::List
use std::collections::hashmap::HashMap
use core::alloc::heap::Heap

// ============================================================================
// Lowering context
// ============================================================================

/// Tracks MIR ValueId → MachIR VirtualReg mapping.
pub type LowerCtx {
    func_out: MachFunc,
    value_map: HashMap[I64, I64],
    current_block: I64
}

/// Create a lowering context for a MIR function.
pub func lower_ctx_new(name: Str) -> LowerCtx {
    return LowerCtx {
        func_out: mach_func_new(name),
        value_map: HashMap[I64, I64]::new(64),
        current_block: 0
    }
}

/// Map a MIR ValueId to a physical register directly.
/// Uses allocatable registers: RAX(0), RCX(1), RDX(2), RBX(3), RSI(6), RDI(7), R8-R11.
/// Simple sequential assignment — no virtual registers needed for small functions.
func get_phys_reg(ctx: LowerCtx, val: I64) -> I64 {
    if ctx.value_map.has(val) {
        return ctx.value_map.get(val)
    }
    // Allocatable registers in order (skip RSP=4, RBP=5)
    let alloc_regs = List[I64]::new(10)
    alloc_regs.push(0)   // RAX
    alloc_regs.push(3)   // RBX
    alloc_regs.push(6)   // RSI
    alloc_regs.push(7)   // RDI
    alloc_regs.push(10)  // R10
    alloc_regs.push(11)  // R11
    alloc_regs.push(12)  // R12
    alloc_regs.push(13)  // R13
    alloc_regs.push(14)  // R14
    alloc_regs.push(15)  // R15
    let next_id: I64 = ctx.func_out.vreg_count
    ctx.func_out.vreg_count = next_id + 1
    let reg: I64 = alloc_regs.get(next_id % 10)
    ctx.value_map.set(val, reg)
    return reg
}

/// Emit a MachInst to the current block.
func emit(ctx: LowerCtx, inst: MachInst) {
    let block: MachBlock = ctx.func_out.blocks.get(ctx.current_block)
    block.insts.push(inst)
}

// ============================================================================
// Full function lowering
// ============================================================================

/// Lower an entire MIR function to MachIR.
pub func lower_function(mir_func: MirFunc) -> MachFunc {
    let ctx: LowerCtx = lower_ctx_new(mir_func.name)

    // Create MachBlocks for each MIR basic block
    let bc: I64 = mir_func.blocks.len() as I64
    // Block 0 already exists (entry)
    for i in 1 to bc {
        let mir_bb: BasicBlock = mir_func.blocks.get(i)
        ctx.func_out.blocks.push(mach_block_new(i, mir_bb.name))
    }

    // Load parameters from physical registers into virtual registers (Win64 ABI)
    // RCX(1), RDX(2), R8(8), R9(9) for first 4 integer args
    let param_regs = List[I64]::new(4)
    param_regs.push(1)   // RCX
    param_regs.push(2)   // RDX
    param_regs.push(8)   // R8
    param_regs.push(9)   // R9
    let pc: I64 = mir_func.params.len() as I64
    if pc > 0 {
        ctx.current_block = 0
        for pi in 0 to pc {
            if pi < 4 {
                let param: MirFuncParam = mir_func.params.get(pi)
                let dst_reg: I64 = get_phys_reg(ctx, param.value_id as I64)
                emit(ctx, MachInst::Mov(MachMov {
                    dst: Operand::PhysReg(dst_reg),
                    src: Operand::PhysReg(param_regs.get(pi)),
                    size: 8
                }))
            }
        }
    }

    // Lower each block's instructions
    for bi in 0 to bc {
        ctx.current_block = bi
        let mir_bb: BasicBlock = mir_func.blocks.get(bi)
        let ic: I64 = mir_bb.instructions.len() as I64
        for ii in 0 to ic {
            let inst_data: InstructionData = mir_bb.instructions.get(ii)
            lower_instruction(ctx, inst_data)
        }
        // Lower terminator
        when mir_bb.terminator {
            Just(term) => lower_terminator(ctx, term),
            _ => {}
        }
    }

    return ctx.func_out
}

// ============================================================================
// Instruction lowering (items 2.1–2.5)
// ============================================================================

/// Lower a single MIR instruction to MachIR.
func lower_instruction(ctx: LowerCtx, data: InstructionData) {
    let result_id: I64 = data.result as I64
    when data.inst {
        Binary(b) => lower_binary(ctx, result_id, b),
        Unary(u) => lower_unary(ctx, result_id, u),
        Load(l) => lower_load(ctx, result_id, l),
        Store(s) => lower_store(ctx, s),
        Alloca(a) => lower_alloca(ctx, result_id, a),
        Call(c) => lower_call(ctx, result_id, c),
        Constant(c) => lower_constant(ctx, result_id, c),
        Select(s) => lower_select(ctx, result_id, s),
        _ => {}
    }
}

/// Lower binary arithmetic (item 2.1).
func lower_binary(ctx: LowerCtx, result_id: I64, b: BinaryInst) {
    let dst_reg: I64 = get_phys_reg(ctx, result_id)
    let lhs_reg: I64 = get_phys_reg(ctx, b.left as I64)
    let rhs_reg: I64 = get_phys_reg(ctx, b.right as I64)

    // MOV dst, lhs (copy lhs to dst)
    emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(lhs_reg), size: 8 }))

    when b.op {
        Add => emit(ctx, MachInst::Add(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(rhs_reg), size: 8 })),
        Sub => emit(ctx, MachInst::Sub(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(rhs_reg), size: 8 })),
        Mul => emit(ctx, MachInst::Imul(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(rhs_reg), size: 8 })),
        BitAnd => emit(ctx, MachInst::And(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(rhs_reg), size: 8 })),
        BitOr => emit(ctx, MachInst::Or(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(rhs_reg), size: 8 })),
        BitXor => emit(ctx, MachInst::Xor(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(rhs_reg), size: 8 })),
        Shl => emit(ctx, MachInst::Shl(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(rhs_reg), size: 8 })),
        Shr => emit(ctx, MachInst::Sar(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(rhs_reg), size: 8 })),
        Eq => {
            emit(ctx, MachInst::Cmp(MachCmp { lhs: Operand::PhysReg(lhs_reg), rhs: Operand::PhysReg(rhs_reg), size: 8 }))
            // Result is in flags — set via SETcc (simplified: just record the compare)
        },
        Ne => emit(ctx, MachInst::Cmp(MachCmp { lhs: Operand::PhysReg(lhs_reg), rhs: Operand::PhysReg(rhs_reg), size: 8 })),
        Lt => emit(ctx, MachInst::Cmp(MachCmp { lhs: Operand::PhysReg(lhs_reg), rhs: Operand::PhysReg(rhs_reg), size: 8 })),
        Le => emit(ctx, MachInst::Cmp(MachCmp { lhs: Operand::PhysReg(lhs_reg), rhs: Operand::PhysReg(rhs_reg), size: 8 })),
        Gt => emit(ctx, MachInst::Cmp(MachCmp { lhs: Operand::PhysReg(lhs_reg), rhs: Operand::PhysReg(rhs_reg), size: 8 })),
        Ge => emit(ctx, MachInst::Cmp(MachCmp { lhs: Operand::PhysReg(lhs_reg), rhs: Operand::PhysReg(rhs_reg), size: 8 })),
        _ => {}
    }
}

/// Lower unary operations.
func lower_unary(ctx: LowerCtx, result_id: I64, u: UnaryInst) {
    let dst_reg: I64 = get_phys_reg(ctx, result_id)
    let src_reg: I64 = get_phys_reg(ctx, u.operand as I64)
    emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(src_reg), size: 8 }))
    when u.op {
        Neg => emit(ctx, MachInst::Neg(MachUnaryOp { operand: Operand::PhysReg(dst_reg), size: 8 })),
        Not => emit(ctx, MachInst::Xor(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::Imm(1), size: 8 })),
        BitNot => emit(ctx, MachInst::Xor(MachBinOp { dst: Operand::PhysReg(dst_reg), src: Operand::Imm(-1 as I64), size: 8 })),
        _ => {}
    }
}

/// Lower memory load (item 2.2).
func lower_load(ctx: LowerCtx, result_id: I64, l: LoadInst) {
    let dst_reg: I64 = get_phys_reg(ctx, result_id)
    let ptr_reg: I64 = get_phys_reg(ctx, l.ptr as I64)
    emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(ptr_reg), size: 8 }))
}

/// Lower memory store (item 2.2).
func lower_store(ctx: LowerCtx, s: StoreInst) {
    let val_reg: I64 = get_phys_reg(ctx, s.value as I64)
    let ptr_reg: I64 = get_phys_reg(ctx, s.ptr as I64)
    emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(ptr_reg), src: Operand::PhysReg(val_reg), size: 8 }))
}

/// Lower alloca (item 2.2).
func lower_alloca(ctx: LowerCtx, result_id: I64, a: AllocaInst) {
    let dst_reg: I64 = get_phys_reg(ctx, result_id)
    // Alloca is resolved to a stack slot by the allocator
    emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::Imm(0), size: 8 }))
}

/// Lower function call (item 2.4).
/// Win64 ABI: first 4 integer args in RCX(1), RDX(2), R8(8), R9(9).
func lower_call(ctx: LowerCtx, result_id: I64, c: CallInst) {
    ctx.func_out.is_leaf = 0
    // Move arguments into physical registers (Win64 convention)
    let arg_regs = List[I64]::new(4)
    arg_regs.push(1)   // RCX
    arg_regs.push(2)   // RDX
    arg_regs.push(8)   // R8
    arg_regs.push(9)   // R9
    let ac: I64 = c.args.len() as I64
    for i in 0 to ac {
        if i < 4 {
            let src_reg: I64 = get_phys_reg(ctx, c.args.get(i) as I64)
            emit(ctx, MachInst::Mov(MachMov {
                dst: Operand::PhysReg(arg_regs.get(i)),
                src: Operand::PhysReg(src_reg),
                size: 8
            }))
        }
    }
    emit(ctx, MachInst::Call(MachCall { target: c.callee, arg_count: ac }))
    // Move return value from RAX to result vreg
    let dst_reg: I64 = get_phys_reg(ctx, result_id)
    emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(0), size: 8 }))
}

/// Lower constant.
func lower_constant(ctx: LowerCtx, result_id: I64, c: ConstantInst) {
    let dst_reg: I64 = get_phys_reg(ctx, result_id)
    when c.value {
        ConstInt(v) => emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::Imm(v), size: 8 })),
        ConstBool(v) => {
            let imm: I64 = if v { 1 } else { 0 }
            emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::Imm(imm), size: 8 }))
        },
        ConstStr(s) => {
            // String constants use a Label operand — resolved to .rdata offset at link time
            emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::Label(s), size: 8 }))
        },
        _ => emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::Imm(0), size: 8 }))
    }
}

/// Lower select.
func lower_select(ctx: LowerCtx, result_id: I64, s: SelectInst) {
    let dst_reg: I64 = get_phys_reg(ctx, result_id)
    let cond_reg: I64 = get_phys_reg(ctx, s.condition as I64)
    let tv_reg: I64 = get_phys_reg(ctx, s.true_val as I64)
    let fv_reg: I64 = get_phys_reg(ctx, s.false_val as I64)
    // CMOVne: move true_val if cond != 0, else false_val
    emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(dst_reg), src: Operand::PhysReg(fv_reg), size: 8 }))
    emit(ctx, MachInst::Cmp(MachCmp { lhs: Operand::PhysReg(cond_reg), rhs: Operand::Imm(0), size: 8 }))
    // Simplified: use conditional move via branching (CMOVne not yet in MachInst)
}

// ============================================================================
// Terminator lowering (item 2.3)
// ============================================================================

func lower_terminator(ctx: LowerCtx, term: Terminator) {
    when term {
        Return(r) => {
            when r.value {
                Just(v) => {
                    let src_reg: I64 = get_phys_reg(ctx, v as I64)
                    emit(ctx, MachInst::Mov(MachMov { dst: Operand::PhysReg(0), src: Operand::PhysReg(src_reg), size: 8 }))
                },
                _ => {}
            }
            emit(ctx, MachInst::Ret(MachRet { has_value: 1 }))
        },
        Branch(b) => {
            emit(ctx, MachInst::Jmp(MachJmp { target: b.target }))
            let block: MachBlock = ctx.func_out.blocks.get(ctx.current_block)
            block.successors.push(b.target)
        },
        CondBranch(cb) => {
            let cond_reg: I64 = get_phys_reg(ctx, cb.condition as I64)
            emit(ctx, MachInst::Cmp(MachCmp { lhs: Operand::PhysReg(cond_reg), rhs: Operand::Imm(0), size: 8 }))
            emit(ctx, MachInst::Jcc(MachJcc { cond: CondCode::Ne, target: cb.true_target }))
            emit(ctx, MachInst::Jmp(MachJmp { target: cb.false_target }))
            let block: MachBlock = ctx.func_out.blocks.get(ctx.current_block)
            block.successors.push(cb.true_target)
            block.successors.push(cb.false_target)
        },
        Switch(sw) => {
            let disc_reg: I64 = get_phys_reg(ctx, sw.discriminant as I64)
            let ac: I64 = sw.arms.len() as I64
            for i in 0 to ac {
                let arm: SwitchArm = sw.arms.get(i)
                emit(ctx, MachInst::Cmp(MachCmp { lhs: Operand::PhysReg(disc_reg), rhs: Operand::Imm(arm.value), size: 8 }))
                emit(ctx, MachInst::Jcc(MachJcc { cond: CondCode::Eq, target: arm.target }))
            }
            emit(ctx, MachInst::Jmp(MachJmp { target: sw.default_target }))
        },
        Unreachable(_) => {}
    }
}
