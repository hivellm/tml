// ============================================================================
// HirBuilder state
// ============================================================================

/// The HIR builder state. Holds a TypeEnv reference, ID generator,
/// and monomorphization cache.
pub type HirBuilder {
    env: TypeEnv,
    next_id: I64,
    errors: List[Str],
    mono_cache: HashMap[Str, Str]
}

/// Create a new HirBuilder.
pub func builder_new(env: TypeEnv) -> HirBuilder {
    return HirBuilder {
        env: env,
        next_id: 1,
        errors: List[Str]::new(8),
        mono_cache: HashMap[Str, Str]::new(64)
    }
}

/// Generate a fresh HirId.
func fresh_id(b: HirBuilder) -> I64 {
    let id = b.next_id
    b.next_id = id + 1
    return id
}

// ============================================================================
// Module lowering — entry point (item 2.2)
// ============================================================================

/// Lower an AST module to a HirModule.
/// This is the main entry point for the HIR builder.
pub func lower_module(b: HirBuilder, ast: AstModule) -> HirModule {
    let hmod = hir_module_new(ast.name, "")

    // Process all top-level declarations
    let dc: I64 = ast.decls.len() as I64
    for i in 0 to dc {
        let decl = ast.decls.get(i).get()
        lower_decl(b, hmod, decl)
    }

    return hmod
}

/// Lower a single top-level declaration into the HirModule.
func lower_decl(b: HirBuilder, hmod: HirModule, decl: Decl) {
    when decl {
        Func(fd) => {
            let hfunc = lower_function(b, fd)
            hmod.functions.push(hfunc)
        },
        Struct(sd) => {
            // Skip generic structs — they need monomorphization
            if sd.generics.len() as I64 == 0 {
                let hstruct = lower_struct(b, sd)
                hmod.structs.push(hstruct)
            }
        },
        Enum(ed) => {
            if ed.generics.len() as I64 == 0 {
                let henum = lower_enum(b, ed)
                hmod.enums.push(henum)
            }
        },
        Impl(id) => {
            if id.generics.len() as I64 == 0 {
                let himpl = lower_impl(b, id)
                hmod.impls.push(himpl)
            }
        },
        Const(cd) => {
            let hconst = lower_const(b, cd)
            hmod.constants.push(hconst)
        },
        _ => {}
    }
}

// ============================================================================
// Function lowering (item 2.3)
// ============================================================================

/// Lower a function declaration to HirFunction.
pub func lower_function(b: HirBuilder, fd: FuncDecl) -> HirFunction {
    let params = List[HirParam]::new(fd.params.len() as I64)
    let pc: I64 = fd.params.len() as I64
    for i in 0 to pc {
        let p: FuncParam = fd.params.get(i)
        let param_ty = resolve_param_type(b, p)
        params.push(HirParam {
            name: p.name,
            param_type: param_ty,
            is_mutable: p.is_mut as I64,
            span: p.span
        })
    }

    // Resolve return type
    let ret_ty = resolve_return_type(b, fd)

    // Lower body if present
    let body: Maybe[Heap[HirExpr]] = when fd.body {
        Just(body_expr) => Just(Heap::new(lower_expr_dispatch(b, body_expr.get()))),
        Nothing => Nothing
    }

    return HirFunction {
        id: fresh_id(b),
        name: fd.name,
        mangled_name: fd.name,
        params: params,
        return_type: ret_ty,
        body: body,
        is_public: 0,
        is_async: fd.is_async,
        is_extern: 0,
        extern_abi: Nothing,
        span: fd.span
    }
}

/// Resolve a parameter type from AST to concrete Type.
func resolve_param_type(b: HirBuilder, p: FuncParam) -> Type {
    // If type annotation exists, use TypeEnv to resolve it
    // For now, use a fresh type variable as placeholder
    return make_unit()
}

/// Resolve the return type of a function.
func resolve_return_type(b: HirBuilder, fd: FuncDecl) -> Type {
    return make_unit()
}

// ============================================================================
// Struct lowering (item 2.4)
// ============================================================================

/// Lower a struct declaration to HirStruct.
pub func lower_struct(b: HirBuilder, sd: StructDecl) -> HirStruct {
    let fields = List[HirField]::new(sd.fields.len() as I64)
    let fc: I64 = sd.fields.len() as I64
    for i in 0 to fc {
        let f = sd.fields.get(i)
        fields.push(HirField {
            name: f.name,
            field_type: make_unit(),
            index: i,
            has_default: 0
        })
    }

    return HirStruct {
        id: fresh_id(b),
        name: sd.name,
        mangled_name: sd.name,
        fields: fields,
        is_public: 0,
        is_union: 0,
        span: sd.span
    }
}

// ============================================================================
// Enum lowering (item 2.4)
// ============================================================================

/// Lower an enum declaration to HirEnum.
pub func lower_enum(b: HirBuilder, ed: EnumDecl) -> HirEnum {
    let variants = List[HirVariant]::new(ed.variants.len() as I64)
    let vc: I64 = ed.variants.len() as I64
    for i in 0 to vc {
        let v = ed.variants.get(i)
        let payloads = List[Type]::new(v.fields.len() as I64)
        let tc: I64 = v.fields.len() as I64
        for j in 0 to tc {
            payloads.push(make_unit())
        }
        variants.push(HirVariant {
            name: v.name,
            payload_types: payloads,
            discriminant: i
        })
    }

    return HirEnum {
        id: fresh_id(b),
        name: ed.name,
        mangled_name: ed.name,
        variants: variants,
        is_public: 0,
        span: ed.span
    }
}

// ============================================================================
// Impl lowering
// ============================================================================

/// Lower an impl block to HirImpl.
pub func lower_impl(b: HirBuilder, id: ImplDecl) -> HirImpl {
    let methods = List[HirFunction]::new(id.methods.len() as I64)
    let mc: I64 = id.methods.len() as I64
    for i in 0 to mc {
        let m = id.methods.get(i)
        methods.push(lower_function(b, m))
    }

    let type_name = "" // TODO: extract from self_type
    let bhv_name = "" // TODO: extract from behavior

    return HirImpl {
        id: fresh_id(b),
        type_name: type_name,
        behavior_name: bhv_name,
        methods: methods,
        span: id.span
    }
}

// ============================================================================
// Const lowering
// ============================================================================

/// Lower a const declaration to HirConst.
pub func lower_const(b: HirBuilder, cd: ConstDecl) -> HirConst {
    let value_expr = lower_expr_dispatch(b, cd.value.get())
    return HirConst {
        id: fresh_id(b),
        name: cd.name,
        const_type: make_unit(),
        value: Heap::new(value_expr),
        is_public: 0,
        span: cd.span
    }
}

// ============================================================================
// Expression lowering dispatcher (item 3.1 preview)
// ============================================================================

/// Lower an AST expression to a HirExpr.
/// Dispatches to type-specific lowering functions.
pub func lower_expr_dispatch(b: HirBuilder, expr: Expr) -> HirExpr {
    when expr {
        Literal(lit) => {
            let hir_val: HirLitValue = when lit.value {
                LitInt(v) => HirLitValue::LitInt(v),
                LitFloat(v) => HirLitValue::LitFloat(v),
                LitStr(v) => HirLitValue::LitStr(v),
                LitBool(v) => HirLitValue::LitBool(v),
                LitChar(v) => HirLitValue::LitChar(v),
                LitNull => HirLitValue::LitInt(0)
            }
            return HirExpr::Literal(HirLiteralExpr {
                id: fresh_id(b),
                value: hir_val,
                resolved_type: make_unit(),
                span: lit.span
            })
        },
        Ident(id) => {
            return HirExpr::Var(HirVarExpr {
                id: fresh_id(b),
                name: id.name,
                resolved_type: make_unit(),
                span: id.span
            })
        },
        Block(blk) => {
            let stmts = List[Heap[HirStmt]]::new(blk.stmts.len() as I64)
            let sc: I64 = blk.stmts.len() as I64
            for i in 0 to sc {
                stmts.push(Heap::new(lower_stmt(b, blk.stmts.get(i).get())))
            }
            let trail: Maybe[Heap[HirExpr]] = when blk.expr {
                Just(e) => Just(Heap::new(lower_expr_dispatch(b, e.get()))),
                Nothing => Nothing
            }
            return HirExpr::Block(HirBlockExpr {
                id: fresh_id(b),
                stmts: stmts,
                expr: trail,
                resolved_type: make_unit(),
                span: blk.span
            })
        },
        Call(call) => {
            let args = List[Heap[HirExpr]]::new(call.args.len() as I64)
            let ac: I64 = call.args.len() as I64
            for i in 0 to ac {
                args.push(Heap::new(lower_expr_dispatch(b, call.args.get(i).get())))
            }
            // Extract callee name
            let callee_name = extract_callee_name(call.callee.get())
            return HirExpr::Call(HirCallExpr {
                id: fresh_id(b),
                func_name: callee_name,
                type_args: List[Type]::new(0),
                args: args,
                resolved_type: make_unit(),
                span: call.span
            })
        },
        Return(ret) => {
            let val: Maybe[Heap[HirExpr]] = when ret.value {
                Just(v) => Just(Heap::new(lower_expr_dispatch(b, v.get()))),
                Nothing => Nothing
            }
            return HirExpr::Return(compiler::hir::expr::HirReturnExpr {
                id: fresh_id(b),
                value: val,
                resolved_type: make_never(),
                span: ret.span
            })
        },
        // For unhandled expression types, create a placeholder literal
        _ => {
            let loc = loc_new("<hir>", 0, 0, 0, 0)
            let span = span_new(loc, loc)
            return HirExpr::Literal(HirLiteralExpr {
                id: fresh_id(b),
                value: HirLitValue::LitInt(0),
                resolved_type: make_unit(),
                span: span
            })
        }
    }
}

/// Extract function name from a callee expression.
func extract_callee_name(callee: Expr) -> Str {
    when callee {
        Ident(id) => return id.name,
        Path(p) => {
            let segs = p.path.segments
            let sc: I64 = segs.len() as I64
            if sc == 0 { return "<unknown>" }
            var result = segs.get(0)
            for i in 1 to sc {
                result = result + "::" + segs.get(i)
            }
            return result
        },
        _ => return "<expr>"
    }
}

// ============================================================================
// Statement lowering
// ============================================================================

/// Lower an AST statement to a HirStmt.
pub func lower_stmt(b: HirBuilder, stmt: Stmt) -> HirStmt {
    when stmt {
        Let(ls) => {
            let init: Maybe[Heap[HirExpr]] = when ls.init {
                Just(e) => Just(Heap::new(lower_expr_dispatch(b, e.get()))),
                Nothing => Nothing
            }
            let pat = lower_pattern(b, ls.pattern.get())
            return HirStmt::Let(HirLetStmt {
                id: fresh_id(b),
                pattern: Heap::new(pat),
                declared_type: make_unit(),
                init: init,
                is_mutable: 0,
                span: ls.span
            })
        },
        Var(vs) => {
            let init: Maybe[Heap[HirExpr]] = when vs.init {
                Just(e) => Just(Heap::new(lower_expr_dispatch(b, e.get()))),
                Nothing => Nothing
            }
            let loc = loc_new("<hir>", 0, 0, 0, 0)
            let span = span_new(loc, loc)
            let pat = HirPattern::Binding(HirBindingPattern {
                id: fresh_id(b),
                name: vs.name,
                is_mutable: 1,
                resolved_type: make_unit(),
                span: span
            })
            return HirStmt::Let(HirLetStmt {
                id: fresh_id(b),
                pattern: Heap::new(pat),
                declared_type: make_unit(),
                init: init,
                is_mutable: 1,
                span: vs.span
            })
        },
        Expr(e) => {
            let hexpr = lower_expr_dispatch(b, e.get())
            let loc = loc_new("<hir>", 0, 0, 0, 0)
            let span = span_new(loc, loc)
            return HirStmt::Expr(HirExprStmt {
                id: fresh_id(b),
                expr: Heap::new(hexpr),
                span: span
            })
        },
        _ => {
            let loc = loc_new("<hir>", 0, 0, 0, 0)
            let span = span_new(loc, loc)
            return HirStmt::Expr(HirExprStmt {
                id: fresh_id(b),
                expr: Heap::new(HirExpr::Literal(HirLiteralExpr {
                    id: fresh_id(b),
                    value: HirLitValue::LitInt(0),
                    resolved_type: make_unit(),
                    span: span
                })),
                span: span
            })
        }
    }
}

// ============================================================================
// Pattern lowering
// ============================================================================

/// Lower an AST pattern to a HirPattern.
pub func lower_pattern(b: HirBuilder, pat: AstPattern) -> HirPattern {
    when pat {
        Wildcard(span) => {
            return HirPattern::Wildcard(HirWildcardPattern {
                id: fresh_id(b),
                resolved_type: make_unit(),
                span: span
            })
        },
        Ident(ip) => {
            return HirPattern::Binding(HirBindingPattern {
                id: fresh_id(b),
                name: ip.name,
                is_mutable: 0,
                resolved_type: make_unit(),
                span: ip.span
            })
        },
        _ => {
            let loc = loc_new("<hir>", 0, 0, 0, 0)
            let span = span_new(loc, loc)
            return HirPattern::Wildcard(HirWildcardPattern {
                id: fresh_id(b),
                resolved_type: make_unit(),
                span: span
            })
        }
    }
}

// ============================================================================
// Monomorphization cache (item 4.4 — name mangling)
// ============================================================================

/// Mangle a generic name with concrete type arguments.
/// `List` + `[I32]` → `List_I32`
pub func mangle_name(base_name: Str, type_args: List[Type]) -> Str {
    let ac: I64 = type_args.len() as I64
    if ac == 0 { return base_name }

    var result = base_name
    for i in 0 to ac {
        result = result + "_" + type_to_str(type_args.get(i))
    }
    return result
}
