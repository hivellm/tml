/// HTTP Server — Express/CMMV-style with auto header resolution
///
/// Run:   tml run samples/11-http-server/server.tml
/// Test:  curl http://localhost:3000/
///        curl http://localhost:3000/api/users
///        curl http://localhost:3000/api/users/42
///        curl -X POST http://localhost:3000/api/users -d '{"name":"alice"}'
///        curl -I http://localhost:3000/api/health

use core::str
use std::http::app::App
use std::http::dispatch::app_get_param
use std::http::incoming::IncomingMessage
use std::http::framework::response_builder::Res

// ════════════════════════════════════════════════════════════════
// Handlers — Express-style, one-liners
// Headers are auto-resolved: CORS, Security, ETag, Cache-Control
// ════════════════════════════════════════════════════════════════

func handle_root(req: IncomingMessage) -> Str {
    return Res::ok("{\"service\":\"TML HTTP Server\",\"version\":\"0.2.9\"}")
}

func handle_health(req: IncomingMessage) -> Str {
    return Res::ok("{\"status\":\"healthy\"}")
}

func handle_users_list(req: IncomingMessage) -> Str {
    return Res::ok("[{\"id\":1,\"name\":\"alice\"},{\"id\":2,\"name\":\"bob\"}]")
}

func handle_user_by_id(req: IncomingMessage) -> Str {
    let id: Str = app_get_param(req, "id")
    return Res::ok("{\"id\":" + id + ",\"name\":\"user_" + id + "\"}")
}

func handle_user_create(req: IncomingMessage) -> Str {
    let body: Str = req.body()
    if str::len(body) == 0 {
        return Res::bad_request("body required")
    }
    return Res::created("{\"created\":true}")
}

func handle_user_update(req: IncomingMessage) -> Str {
    let id: Str = app_get_param(req, "id")
    return Res::ok("{\"id\":" + id + ",\"updated\":true}")
}

func handle_user_delete(req: IncomingMessage) -> Str {
    let id: Str = app_get_param(req, "id")
    return Res::ok("{\"id\":" + id + ",\"deleted\":true}")
}

func handle_not_found(req: IncomingMessage) -> Str {
    return Res::not_found("route not found")
}

// ════════════════════════════════════════════════════════════════
// Bootstrap
// ════════════════════════════════════════════════════════════════

pub func main() -> I32 {
    var app: App = App::new()

    app.get("/", handle_root as I64)
    app.get("/api/health", handle_health as I64)
    app.get("/api/users", handle_users_list as I64)
    app.get("/api/users/:id", handle_user_by_id as I64)
    app.post("/api/users", handle_user_create as I64)
    app.put("/api/users/:id", handle_user_update as I64)
    app.delete("/api/users/:id", handle_user_delete as I64)
    app.get("/*", handle_not_found as I64)

    println("TML HTTP Server on http://localhost:3000")
    println("  CORS + ETag + Cache-Control + Security — auto-resolved")
    app.listen(3000)
    return 0
}
