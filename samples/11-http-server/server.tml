/// HTTP Server — Express/CMMV-style with (req, res) handlers
///
/// Run:   tml run samples/11-http-server/server.tml
/// Test:  curl http://localhost:3000/
///        curl http://localhost:3000/api/users
///        curl http://localhost:3000/api/users/42
///        curl -X POST http://localhost:3000/api/users -d '{"name":"alice"}'

use core::str
use std::http::app::App
use std::http::server::dispatch::app_get_param
use std::http::server::incoming::IncomingMessage
use std::http::framework::response_builder::Response

// Handlers — Express-style: func(req, res) -> Str
// res comes pre-configured with CORS, Security, ETag, Cache

func handle_root(req: IncomingMessage, res: Response) -> Str {
    return res.json(`{"service":"TML HTTP Server","version":"0.2.9"}` as Str)
}

func handle_health(req: IncomingMessage, res: Response) -> Str {
    return res.json(`{"status":"healthy"}` as Str)
}

func handle_users_list(req: IncomingMessage, res: Response) -> Str {
    return res.json(`[{"id":1,"name":"alice"},{"id":2,"name":"bob"}]` as Str)
}

func handle_user_by_id(req: IncomingMessage, res: Response) -> Str {
    let id = app_get_param(req, "id")
    return res.json(`{"id":{id},"name":"user_{id}"}` as Str)
}

func handle_user_create(req: IncomingMessage, res: Response) -> Str {
    let body = req.body()
    if str::len(body) == 0 {
        return res.status(400).json(`{"error":"body required"}` as Str)
    }
    return res.status(201).json(`{"created":true}` as Str)
}

func handle_user_update(req: IncomingMessage, res: Response) -> Str {
    let id = app_get_param(req, "id")
    return res.json(`{"id":{id},"updated":true}` as Str)
}

func handle_user_delete(req: IncomingMessage, res: Response) -> Str {
    let id = app_get_param(req, "id")
    return res.json(`{"id":{id},"deleted":true}` as Str)
}

func handle_not_found(req: IncomingMessage, res: Response) -> Str {
    return res.status(404).json(`{"error":"route not found"}` as Str)
}

pub func main() -> I32 {
    var app: App = App::new()

    app.get("/", handle_root as I64)
    app.get("/api/health", handle_health as I64)
    app.get("/api/users", handle_users_list as I64)
    app.get("/api/users/:id", handle_user_by_id as I64)
    app.post("/api/users", handle_user_create as I64)
    app.put("/api/users/:id", handle_user_update as I64)
    app.delete("/api/users/:id", handle_user_delete as I64)
    app.get("/*", handle_not_found as I64)

    println("TML HTTP Server on http://localhost:3000")
    app.listen(3000)
    return 0
}
