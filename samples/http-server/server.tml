// TML HTTP Server — cmmv-server style framework demo
//
// Build:  tml build samples/http-server/server.tml
// Run:    build/debug/server.exe
// Test:   curl http://localhost:3000/
//         curl http://localhost:3000/users/42
//         curl -X POST http://localhost:3000/api/echo -d '{"hello":"world"}'
//         curl http://localhost:3000/old-page
// Bench:  npx autocannon -c 100 -d 10 http://localhost:3000/
//
// Handler signature: func(req: IncomingMessage, res: Response) -> Str
//   Use res.json(data).send() for JSON, res.html(data).send() for HTML.
//   Headers (CORS, Security, ETag, Cache-Control) are auto-resolved by the Response builder.

mod http_server

use core::str
use std::http::app::App
use std::http::dispatch::app_get_param
use std::http::incoming::IncomingMessage
use std::http::framework::response_builder::Response

// ── Handlers ───────────────────────────────────────────────────

func handle_root(req: IncomingMessage, res: Response) -> Str {
    return res.json("{\"status\":\"ok\",\"message\":\"TML HTTP Server\"}").send()
}

func handle_health(req: IncomingMessage, res: Response) -> Str {
    return res.json("{\"status\":\"ok\"}").send()
}

func handle_user(req: IncomingMessage, res: Response) -> Str {
    let id: Str = app_get_param(req, "id")
    return res.json("{\"user_id\":\"" + id + "\"}").send()
}

func handle_echo(req: IncomingMessage, res: Response) -> Str {
    let body: Str = req.body()
    if str::len(body) == 0 {
        return res.json("{}").send()
    }
    return res.json(body).send()
}

func handle_redirect(req: IncomingMessage, res: Response) -> Str {
    return "HTTP/1.1 302 Found\r\nLocation: /\r\nContent-Length: 0\r\nServer: TML\r\nConnection: keep-alive\r\n\r\n"
}

func handle_html(req: IncomingMessage, res: Response) -> Str {
    return res.html("<html><body><h1>Hello from TML</h1><p>This is an HTML page.</p></body></html>").send()
}

func handle_text(req: IncomingMessage, res: Response) -> Str {
    return res.text("Hello, plain text world!").send()
}

// ── Main ───────────────────────────────────────────────────────

pub func main() -> I32 {
    var app: App = App::new()

    // Settings
    app.set_body_limit(2097152)     // 2MB body limit
    app.set_read_timeout(60000)     // 60s read timeout
    app.set_idle_timeout(120000)    // 120s idle timeout

    // Routes
    app.get("/", handle_root as I64)
    app.get("/health", handle_health as I64)
    app.get("/users/:id", handle_user as I64)
    app.post("/api/echo", handle_echo as I64)
    app.get("/old-page", handle_redirect as I64)
    app.get("/page", handle_html as I64)
    app.get("/text", handle_text as I64)

    // app.listen_iocp(3000)   // IOCP mode (Windows, async I/O — 60K req/s)
    app.listen(3000)            // Thread pool mode (default — 169K req/s with pipelining)
    return 0
}
