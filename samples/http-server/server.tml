// TML HTTP Server — Express-like API
//
// Build:  tml build samples/http-server/server.tml
// Run:    build/debug/server.exe
// Bench:  npx autocannon -c 100 -d 10 http://localhost:3000/

mod server

use core::str
use std::http::app::{App, AppContext}

func handle_root(ctx: AppContext) -> Str {
    ctx.json(200, "{" + "\"status\":\"ok\",\"message\":\"TML HTTP Server\"" + "}")
}

func handle_health(ctx: AppContext) -> Str {
    ctx.json(200, "{" + "\"status\":\"ok\"" + "}")
}

func handle_echo(ctx: AppContext) -> Str {
    let body: Str = ctx.body()
    if str::len(body) == 0 {
        return ctx.json(200, "{}")
    }
    ctx.json(200, body)
}

pub func main() -> I32 {
    var app: App = App::new()
    app.get("/", handle_root)
    app.get("/health", handle_health)
    app.post("/api/echo", handle_echo)
    app.listen(3000)
    return 0
}
