/// NestJS-style REST API — @Controller auto-registration
///
/// Routes auto-register from @Controller + @Get/@Post/@Put/@Delete decorators.
/// No manual app.get()/app.post() calls needed.
///
/// Run:   tml run samples/12-api/main.tml
/// Test:
///   curl http://localhost:15200/api/health
///   curl http://localhost:15200/api/users
///   curl http://localhost:15200/api/users/42
///   curl -X POST http://localhost:15200/api/users
///   curl -X PUT http://localhost:15200/api/users/1
///   curl -X DELETE http://localhost:15200/api/users/1

use std::http::app::App
use std::http::server::dispatch::app_get_param
use std::http::server::incoming::IncomingMessage
use std::http::framework::response_builder::Response

// ============================================================================
// User Controller — CRUD endpoints under /api/users
// ============================================================================

@Controller("/api/users")
type UserController {}

impl UserController {
    @Get("/")
    pub func list(req: IncomingMessage, res: Response) -> Str {
        return res.json("[{\"id\":1,\"name\":\"alice\"},{\"id\":2,\"name\":\"bob\"}]")
    }

    @Get("/:id")
    pub func get_by_id(req: IncomingMessage, res: Response) -> Str {
        let id = app_get_param(req, "id")
        return res.json("{\"id\":\"" + id + "\",\"name\":\"user_" + id + "\"}")
    }

    @Post("/")
    pub func create(req: IncomingMessage, res: Response) -> Str {
        return res.set_status(201).json("{\"created\":true}")
    }

    @Put("/:id")
    pub func update(req: IncomingMessage, res: Response) -> Str {
        let id = app_get_param(req, "id")
        return res.json("{\"id\":\"" + id + "\",\"updated\":true}")
    }

    @Delete("/:id")
    pub func delete(req: IncomingMessage, res: Response) -> Str {
        let id = app_get_param(req, "id")
        return res.json("{\"id\":\"" + id + "\",\"deleted\":true}")
    }
}

// ============================================================================
// Health Controller — status endpoints under /api
// ============================================================================

@Controller("/api")
type HealthController {}

impl HealthController {
    @Get("/health")
    pub func health(req: IncomingMessage, res: Response) -> Str {
        return res.json("{\"status\":\"healthy\",\"version\":\"0.2.9\"}")
    }

    @Get("/info")
    pub func info(req: IncomingMessage, res: Response) -> Str {
        return res.json("{\"name\":\"TML REST API\",\"runtime\":\"TML v0.2.9\",\"language\":\"TML\"}")
    }
}

// ============================================================================
// Application Bootstrap
// ============================================================================

pub func main() -> I32 {
    var app: App = App::new()
    println("NestJS-style REST API on http://localhost:15200")
    app.listen(15200)
    return 0
}
