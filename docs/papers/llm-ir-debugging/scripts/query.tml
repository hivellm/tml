/// MCP Call Log Query Tool
///
/// Reads mcp-call-log.jsonl and computes research metrics.
///
/// Usage:
///     tml run query.tml tool-distribution
///     tml run query.tml error-rate
///     tml run query.tml check-adoption
///     tml run query.tml session-summary
///     tml run query.tml hotspots
///     tml run query.tml all

use std::file::bufio::{BufReader}
use std::json::{parse}
use std::collections::{HashMap, List}
use std::os::{args_count, args_get}

// ---------------------------------------------------------------------------
// Tool classification (mirrors analyze_logs.py taxonomy)
// ---------------------------------------------------------------------------

func classify_tool(tool: Str) -> Str {
    // Diagnosis tools
    if tool == "emit-ir" or tool == "emit-mir" or tool == "check" or tool == "explain" {
        return "diagnosis"
    }
    // Execution tools
    if tool == "test" or tool == "run" or tool == "build" or tool == "compile" {
        return "execution"
    }
    // Documentation tools
    if tool == "docs/search" or tool == "docs/get" or tool == "docs/list" or tool == "docs/resolve" {
        return "documentation"
    }
    // Maintenance tools
    if tool == "format" or tool == "lint" or tool == "cache/invalidate" {
        return "maintenance"
    }
    // Project tools
    if tool == "project/build" or tool == "project/coverage" or tool == "project/structure" {
        return "project"
    }
    if tool == "project/affected-tests" or tool == "project/artifacts" or tool == "project/slow-tests" {
        return "project"
    }
    return "other"
}

// ---------------------------------------------------------------------------
// JSON field helpers
// ---------------------------------------------------------------------------

/// Check if a JSON tool_call event has is_error == true.
/// Handles both boolean and integer representations.
func is_error_event(json: Json) -> Bool {
    let field = json.get("is_error")
    when field {
        Just(v) => {
            let maybe_bool = v.as_bool()
            when maybe_bool {
                Just(b) => { return b },
                Nothing => {}
            }
            // Fall back to integer check (1 = error)
            let maybe_int = v.as_i64()
            when maybe_int {
                Just(n) => { return n == 1 },
                Nothing => {}
            }
        },
        Nothing => {}
    }
    return false
}

// ---------------------------------------------------------------------------
// Metric: tool-distribution
// ---------------------------------------------------------------------------

func metric_tool_distribution(log_path: Str) {
    println("=== Tool Distribution ===")
    println("")

    var reader = BufReader::open(log_path)
    if not reader.is_open() {
        println("ERROR: Cannot open log file: " + log_path)
        return
    }

    let tool_counts = HashMap[Str, I64]::new()
    let category_counts = HashMap[Str, I64]::new()
    var total: I64 = 0

    var line = reader.read_line()
    loop (line.len() > 0) {
        let maybe_json = parse(line)
        when maybe_json {
            Just(json) => {
                let maybe_event = json.get_string("event")
                when maybe_event {
                    Just(ev) => {
                        if ev == "tool_call" {
                            total = total + 1
                            let maybe_tool = json.get_string("tool")
                            when maybe_tool {
                                Just(tool) => {
                                    let cur = tool_counts.get_or_set(tool, 0)
                                    tool_counts.set(tool, cur + 1)

                                    let cat = classify_tool(tool)
                                    let cur_cat = category_counts.get_or_set(cat, 0)
                                    category_counts.set(cat, cur_cat + 1)
                                },
                                Nothing => {}
                            }
                        }
                    },
                    Nothing => {}
                }
            },
            Nothing => {}
        }
        line = reader.read_line()
    }
    reader.close()

    println("Total calls: " + total.to_string())
    println("")

    // Print tool counts
    println("--- By Tool ---")
    let keys = tool_counts.keys()
    var i: I64 = 0
    loop (i < keys.len()) {
        let k = keys.get(i)
        let count = tool_counts.get(k)
        let pct = (count * 100) / total
        println("  " + k + ": " + count.to_string() + " (" + pct.to_string() + "%)")
        i = i + 1
    }

    println("")
    println("--- By Category ---")
    let cat_keys = category_counts.keys()
    var j: I64 = 0
    loop (j < cat_keys.len()) {
        let k = cat_keys.get(j)
        let count = category_counts.get(k)
        let pct = (count * 100) / total
        println("  " + k + ": " + count.to_string() + " (" + pct.to_string() + "%)")
        j = j + 1
    }
}

// ---------------------------------------------------------------------------
// Metric: error-rate
// ---------------------------------------------------------------------------

func metric_error_rate(log_path: Str) {
    println("=== Error Rate by Tool ===")
    println("")

    var reader = BufReader::open(log_path)
    if not reader.is_open() {
        println("ERROR: Cannot open log file: " + log_path)
        return
    }

    let tool_total = HashMap[Str, I64]::new()
    let tool_errors = HashMap[Str, I64]::new()
    var total: I64 = 0
    var total_errors: I64 = 0

    var line = reader.read_line()
    loop (line.len() > 0) {
        let maybe_json = parse(line)
        when maybe_json {
            Just(json) => {
                let maybe_event = json.get_string("event")
                when maybe_event {
                    Just(ev) => {
                        if ev == "tool_call" {
                            total = total + 1
                            let maybe_tool = json.get_string("tool")
                            when maybe_tool {
                                Just(tool) => {
                                    let cur = tool_total.get_or_set(tool, 0)
                                    tool_total.set(tool, cur + 1)

                                    if is_error_event(json) {
                                        total_errors = total_errors + 1
                                        let cur_err = tool_errors.get_or_set(tool, 0)
                                        tool_errors.set(tool, cur_err + 1)
                                    }
                                },
                                Nothing => {}
                            }
                        }
                    },
                    Nothing => {}
                }
            },
            Nothing => {}
        }
        line = reader.read_line()
    }
    reader.close()

    println("Total calls: " + total.to_string())
    println("Total errors: " + total_errors.to_string())
    if total > 0 {
        let pct = (total_errors * 100) / total
        println("Overall error rate: " + pct.to_string() + "%")
    }
    println("")

    let keys = tool_total.keys()
    var i: I64 = 0
    loop (i < keys.len()) {
        let tool = keys.get(i)
        let t = tool_total.get(tool)
        let e = tool_errors.get_or_set(tool, 0)
        if t > 0 {
            let pct = (e * 100) / t
            println("  " + tool + ": " + e.to_string() + "/" + t.to_string() + " (" + pct.to_string() + "%)")
        }
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// Metric: check-adoption
// ---------------------------------------------------------------------------

func metric_check_adoption(log_path: Str) {
    println("=== Check Adoption (check before test) ===")
    println("")

    var reader = BufReader::open(log_path)
    if not reader.is_open() {
        println("ERROR: Cannot open log file: " + log_path)
        return
    }

    // Use HashMaps for all counters (var mutation in nested when blocks has codegen issues)
    let counters = HashMap[Str, I64]::new()
    let session_last_tool = HashMap[Str, Str]::new()

    var line = reader.read_line()
    loop (line.len() > 0) {
        let maybe_json = parse(line)
        when maybe_json {
            Just(json) => {
                let maybe_event = json.get_string("event")
                when maybe_event {
                    Just(ev) => {
                        if ev == "tool_call" {
                            let maybe_tool = json.get_string("tool")
                            when maybe_tool {
                                Just(tool) => {
                                    // Count check and test calls
                                    if tool == "check" {
                                        let c = counters.get_or_set("check", 0)
                                        counters.set("check", c + 1)
                                    }
                                    if tool == "test" {
                                        let c = counters.get_or_set("test", 0)
                                        counters.set("test", c + 1)
                                    }

                                    // Track preceded-by-check using session_last_tool
                                    let maybe_sid = json.get_string("session")
                                    when maybe_sid {
                                        Just(sid) => {
                                            if tool == "test" and session_last_tool.has(sid) {
                                                let last = session_last_tool.get(sid)
                                                if last == "check" {
                                                    let p = counters.get_or_set("preceded", 0)
                                                    counters.set("preceded", p + 1)
                                                }
                                            }
                                            session_last_tool.set(sid, tool)
                                        },
                                        Nothing => {}
                                    }
                                },
                                Nothing => {}
                            }
                        }
                    },
                    Nothing => {}
                }
            },
            Nothing => {}
        }
        line = reader.read_line()
    }
    reader.close()

    let total_check = counters.get_or_set("check", 0)
    let total_test = counters.get_or_set("test", 0)
    let preceded_count = counters.get_or_set("preceded", 0)

    println("Total check calls: " + total_check.to_string())
    println("Total test calls: " + total_test.to_string())

    let check_plus_test = total_check + total_test
    if check_plus_test > 0 {
        let adoption = (total_check * 100) / check_plus_test
        println("Check adoption rate: " + adoption.to_string() + "% (check / (check + test))")
    }

    if total_test > 0 {
        let preceded_pct = (preceded_count * 100) / total_test
        println("Tests preceded by check: " + preceded_count.to_string() + "/" + total_test.to_string() + " (" + preceded_pct.to_string() + "%)")
    }
}

// ---------------------------------------------------------------------------
// Metric: session-summary
// ---------------------------------------------------------------------------

func metric_session_summary(log_path: Str) {
    println("=== Session Summary ===")
    println("")

    var reader = BufReader::open(log_path)
    if not reader.is_open() {
        println("ERROR: Cannot open log file: " + log_path)
        return
    }

    let session_calls = HashMap[Str, I64]::new()
    let session_errors = HashMap[Str, I64]::new()
    var total_sessions: I64 = 0

    var line = reader.read_line()
    loop (line.len() > 0) {
        let maybe_json = parse(line)
        when maybe_json {
            Just(json) => {
                let maybe_event = json.get_string("event")
                when maybe_event {
                    Just(ev) => {
                        if ev == "session_start" {
                            total_sessions = total_sessions + 1
                        }
                        if ev == "tool_call" {
                            let maybe_session = json.get_string("session")
                            when maybe_session {
                                Just(sid) => {
                                    let cur = session_calls.get_or_set(sid, 0)
                                    session_calls.set(sid, cur + 1)

                                    if is_error_event(json) {
                                        let cur_err = session_errors.get_or_set(sid, 0)
                                        session_errors.set(sid, cur_err + 1)
                                    }
                                },
                                Nothing => {}
                            }
                        }
                    },
                    Nothing => {}
                }
            },
            Nothing => {}
        }
        line = reader.read_line()
    }
    reader.close()

    println("Total sessions: " + total_sessions.to_string())
    println("")

    let keys = session_calls.keys()
    var i: I64 = 0
    loop (i < keys.len()) {
        let sid = keys.get(i)
        let calls = session_calls.get(sid)
        let errors = session_errors.get_or_set(sid, 0)
        println("  " + sid + ": " + calls.to_string() + " calls, " + errors.to_string() + " errors")
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// Metric: hotspots (test failures per module)
// ---------------------------------------------------------------------------

/// Extract the test target from a JSON tool_call event.
/// Checks params.suite, then params.path, then params.filter.
func extract_test_target(json: Json) -> Str {
    let maybe_suite = json.get_path_string("params.suite")
    when maybe_suite {
        Just(s) => { return s },
        Nothing => {}
    }
    let maybe_path = json.get_path_string("params.path")
    when maybe_path {
        Just(p) => { return p },
        Nothing => {}
    }
    let maybe_filter = json.get_path_string("params.filter")
    when maybe_filter {
        Just(f) => { return f },
        Nothing => {}
    }
    return "(default)"
}

func metric_hotspots(log_path: Str) {
    println("=== Test Target Hotspots ===")
    println("")

    var reader = BufReader::open(log_path)
    if not reader.is_open() {
        println("ERROR: Cannot open log file: " + log_path)
        return
    }

    let target_counts = HashMap[Str, I64]::new()
    let target_errors = HashMap[Str, I64]::new()

    var line = reader.read_line()
    loop (line.len() > 0) {
        let maybe_json = parse(line)
        when maybe_json {
            Just(json) => {
                let maybe_event = json.get_string("event")
                when maybe_event {
                    Just(ev) => {
                        if ev == "tool_call" {
                            let maybe_tool = json.get_string("tool")
                            when maybe_tool {
                                Just(tool) => {
                                    if tool == "test" {
                                        let target = extract_test_target(json)
                                        let cur = target_counts.get_or_set(target, 0)
                                        target_counts.set(target, cur + 1)

                                        if is_error_event(json) {
                                            let cur_err = target_errors.get_or_set(target, 0)
                                            target_errors.set(target, cur_err + 1)
                                        }
                                    }
                                },
                                Nothing => {}
                            }
                        }
                    },
                    Nothing => {}
                }
            },
            Nothing => {}
        }
        line = reader.read_line()
    }
    reader.close()

    let keys = target_counts.keys()
    var i: I64 = 0
    loop (i < keys.len()) {
        let target = keys.get(i)
        let count = target_counts.get(target)
        let errors = target_errors.get_or_set(target, 0)
        println("  " + target + ": " + count.to_string() + " calls, " + errors.to_string() + " errors")
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

func main() {
    let argc = args_count()

    if argc < 2 {
        println("Usage: query.tml <metric>")
        println("")
        println("Metrics:")
        println("  tool-distribution   Count calls per tool with percentages")
        println("  error-rate          Error count per tool")
        println("  check-adoption      Percentage of test calls preceded by check")
        println("  session-summary     Calls per session")
        println("  hotspots            Test failures per module")
        println("  all                 Run all metrics")
        return
    }

    let metric = args_get(1)
    let log_path = "mcp-call-log.jsonl"

    if metric == "tool-distribution" {
        metric_tool_distribution(log_path)
    } else if metric == "error-rate" {
        metric_error_rate(log_path)
    } else if metric == "check-adoption" {
        metric_check_adoption(log_path)
    } else if metric == "session-summary" {
        metric_session_summary(log_path)
    } else if metric == "hotspots" {
        metric_hotspots(log_path)
    } else if metric == "all" {
        metric_tool_distribution(log_path)
        println("")
        println("========================================")
        println("")
        metric_error_rate(log_path)
        println("")
        println("========================================")
        println("")
        metric_check_adoption(log_path)
        println("")
        println("========================================")
        println("")
        metric_session_summary(log_path)
        println("")
        println("========================================")
        println("")
        metric_hotspots(log_path)
    } else {
        println("Unknown metric: " + metric)
        println("Valid metrics: tool-distribution, error-rate, check-adoption, session-summary, hotspots, all")
    }
}
