/// A/B Testing Framework
///
/// Compares metrics between two conditions from MCP call logs.
///
/// Usage:
///     tml run ab_testing.tml                          # compare all conditions
///     tml run ab_testing.tml baseline debug-layers    # compare two specific conditions

use std::file::bufio::BufReader
use std::json::parse
use std::collections::HashMap
use std::os::{args_count, args_get}

func main() {
    var cond_a = "baseline"
    var cond_b = "debug-layers"

    if args_count() > 2 {
        cond_a = args_get(1)
        cond_b = args_get(2)
    }

    let reader = BufReader::from_path("mcp-call-log.jsonl")
    if not reader.is_open() {
        println("ERROR: mcp-call-log.jsonl not found")
        return
    }

    // Map session → condition
    let session_cond = HashMap[Str, Str]::new()

    // Per-condition counters
    var a_calls: I64 = 0
    var a_errors: I64 = 0
    var a_tests: I64 = 0
    var a_checks_before_test: I64 = 0
    var a_duration: I64 = 0

    var b_calls: I64 = 0
    var b_errors: I64 = 0
    var b_tests: I64 = 0
    var b_checks_before_test: I64 = 0
    var b_duration: I64 = 0

    var line = reader.read_line()
    loop (line.len() > 0) {
        let Just(json) = parse(line) else {
            line = reader.read_line()
            continue
        }
        let Just(event) = json.get_string("event") else {
            line = reader.read_line()
            continue
        }

        if event == "session_start" {
            let Just(sid) = json.get_string("session") else {
                line = reader.read_line()
                continue
            }
            let cond = json.get_string("condition").unwrap_or("unknown")
            session_cond.insert(sid, cond)
        }

        if event == "tool_call" {
            let Just(sid) = json.get_string("session") else {
                line = reader.read_line()
                continue
            }
            let cond = session_cond.get(sid).unwrap_or("unknown")
            let tool = json.get_string("tool").unwrap_or("")
            let error_type = json.get_string("error_type").unwrap_or("none")
            let is_error = error_type != "none"
            let duration = json.get_i64("duration_ms").unwrap_or(0)
            let preceded = json.get_string("preceded_by").unwrap_or("")

            if cond == cond_a {
                a_calls = a_calls + 1
                a_duration = a_duration + duration
                if is_error { a_errors = a_errors + 1 }
                if tool == "test" {
                    a_tests = a_tests + 1
                    if preceded == "check" { a_checks_before_test = a_checks_before_test + 1 }
                }
            }

            if cond == cond_b {
                b_calls = b_calls + 1
                b_duration = b_duration + duration
                if is_error { b_errors = b_errors + 1 }
                if tool == "test" {
                    b_tests = b_tests + 1
                    if preceded == "check" { b_checks_before_test = b_checks_before_test + 1 }
                }
            }
        }

        line = reader.read_line()
    }

    println("# A/B Comparison: " + cond_a + " vs " + cond_b)
    println("")

    // Error rate
    let a_err_rate = if a_calls > 0 { (a_errors * 100) / a_calls } else { 0 }
    let b_err_rate = if b_calls > 0 { (b_errors * 100) / b_calls } else { 0 }

    // Check adoption
    let a_check_rate = if a_tests > 0 { (a_checks_before_test * 100) / a_tests } else { 0 }
    let b_check_rate = if b_tests > 0 { (b_checks_before_test * 100) / b_tests } else { 0 }

    // Mean duration
    let a_mean_dur = if a_calls > 0 { a_duration / a_calls } else { 0 }
    let b_mean_dur = if b_calls > 0 { b_duration / b_calls } else { 0 }

    println("| Metric              | " + cond_a + " | " + cond_b + " | Delta |")
    println("|---------------------|---------|---------|-------|")
    println("| Calls               | " + a_calls.to_string() + " | " + b_calls.to_string() + " | " + (b_calls - a_calls).to_string() + " |")
    println("| Error rate          | " + a_err_rate.to_string() + "% | " + b_err_rate.to_string() + "% | " + (b_err_rate - a_err_rate).to_string() + "% |")
    println("| Check adoption      | " + a_check_rate.to_string() + "% | " + b_check_rate.to_string() + "% | " + (b_check_rate - a_check_rate).to_string() + "% |")
    println("| Mean duration (ms)  | " + a_mean_dur.to_string() + " | " + b_mean_dur.to_string() + " | " + (b_mean_dur - a_mean_dur).to_string() + " |")

    if a_calls == 0 or b_calls == 0 {
        println("")
        println("WARNING: one condition has 0 calls — comparison not meaningful")
    }
}
