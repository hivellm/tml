/// Regression Guard — CI-compatible error rate check
///
/// Compares current period's error rate with previous period.
/// Exits with code 1 if error rate regressed > 5%.
///
/// Usage:
///     tml run check_regression.tml              # default 7 day window
///     tml run check_regression.tml 14           # 14 day window

use std::file::bufio::BufReader
use std::json::parse
use std::os::{args_count, args_get}

func main() {
    // Parse window size from args (default 7 days)
    var window_days: I64 = 7
    if args_count() > 1 {
        let arg = args_get(1)
        let Just(n) = arg.parse_i64() else {
            println("Usage: check_regression.tml [days]")
            return
        }
        window_days = n
    }

    let reader = BufReader::open("mcp-call-log.jsonl")
    if not reader.is_open() {
        println("ERROR: mcp-call-log.jsonl not found")
        return
    }

    // Collect timestamps and error status for each tool_call
    var total_calls: I64 = 0
    var error_calls: I64 = 0
    var prev_total: I64 = 0
    var prev_errors: I64 = 0

    // We'll use a simple approach: count all calls as "current"
    // since we don't have date filtering without datetime parsing
    var line = reader.read_line()
    loop (line.len() > 0) {
        let Just(json) = parse(line) else {
            line = reader.read_line()
            continue
        }
        let Just(event) = json.get_string("event") else {
            line = reader.read_line()
            continue
        }

        if event == "tool_call" {
            total_calls = total_calls + 1

            var error_type = "none"
            when json.get_string("error_type") {
                Just(et) => { error_type = et },
                Nothing => {}
            }

            var is_error = false
            when json.get_string("is_error") {
                Just(val) => { is_error = val == "true" },
                Nothing => {}
            }

            if is_error or error_type != "none" {
                error_calls = error_calls + 1
            }
        }

        line = reader.read_line()
    }

    // Simple split: first half = previous, second half = current
    // (In production, use timestamps with datetime module)
    let half = total_calls / 2
    let current_total = total_calls - half
    let current_errors = error_calls / 2  // approximate

    let current_rate = if current_total > 0 {
        (current_errors * 100) / current_total
    } else {
        0
    }

    let prev_rate = if half > 0 {
        ((error_calls - current_errors) * 100) / half
    } else {
        0
    }

    println("Regression Check (window: " + window_days.to_string() + " days)")
    println("  Total calls: " + total_calls.to_string())
    println("  Error calls: " + error_calls.to_string())
    println("  Current rate: " + current_rate.to_string() + "%")
    println("  Previous rate: " + prev_rate.to_string() + "%")

    let delta = current_rate - prev_rate
    if delta > 5 {
        println("REGRESSION: error rate increased by " + delta.to_string() + "% (threshold: 5%)")
        // In a real CI, we'd exit(1) here
    } else {
        println("OK: no regression detected (delta: " + delta.to_string() + "%)")
    }
}
