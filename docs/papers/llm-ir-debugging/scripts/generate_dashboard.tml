/// Generate HTML Dashboard
///
/// Creates a simple HTML file with links to chart images.
///
/// Usage: tml run generate_dashboard.tml
/// Output: docs/papers/llm-ir-debugging/dashboards/index.html

use std::file::bufio::BufWriter

func main() {
    let output = "docs/papers/llm-ir-debugging/dashboards/index.html"

    var w = BufWriter::open(output)
    if not w.is_open() {
        println("ERROR: cannot open " + output)
        return
    }

    w.write("<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n")
    w.write("<title>MCP Research Dashboard</title>\n")
    w.write("<style>\n")
    w.write("body { font-family: system-ui; max-width: 1200px; margin: 0 auto; padding: 20px; }\n")
    w.write("h1 { color: steelblue; }\n")
    w.write("h2 { border-bottom: 2px solid steelblue; padding-bottom: 5px; }\n")
    w.write(".chart { background: white; border-radius: 8px; padding: 15px; margin: 20px 0; }\n")
    w.write(".chart img { max-width: 100%%; height: auto; }\n")
    w.write("</style>\n</head>\n<body>\n")
    w.write("<h1>MCP Research Dashboard</h1>\n")
    w.write("<p>Generated by TML</p>\n")

    w.write("<div class=\"chart\">\n<h2>Tool Distribution</h2>\n")
    w.write("<img src=\"../charts/tool_distribution.png\" alt=\"Tool Distribution\">\n")
    w.write("</div>\n")

    w.write("<div class=\"chart\">\n<h2>Duration by Tool</h2>\n")
    w.write("<img src=\"../charts/duration_by_tool.png\" alt=\"Duration by Tool\">\n")
    w.write("</div>\n")

    w.write("<div class=\"chart\">\n<h2>Calls per Session</h2>\n")
    w.write("<img src=\"../charts/calls_per_session.png\" alt=\"Calls per Session\">\n")
    w.write("</div>\n")

    w.write("</body>\n</html>\n")
    w.close()

    println("Dashboard: " + output)
}
