// TML PEG Grammar v0.2.0
// Synchronized with compiler-tml/src/parser/ (2026-04-11)
//
// Usage: This grammar is for PEG parser generators like:
//   - pest (Rust)
//   - peggy/peg.js (JavaScript)
//   - go-peg (Go)
//
// Every rule produces an AST node with source span.

// =============================================================================
// TOP LEVEL
// =============================================================================

Module = SOI ~ ModuleHeader? ~ Item* ~ EOI

ModuleHeader = "mod" ~ ModulePath ~ ";"?

ModulePath = Ident ~ ("::" ~ Ident)*

Item = Decorator* ~ Visibility? ~ ItemKind

ItemKind = FuncDef
         / TypeDef
         / UnionDef
         / ConstDef
         / BehaviorDef
         / ImplBlock
         / ClassDef
         / InterfaceDef
         / NamespaceDef
         / ModDef
         / DecoratorDef
         / Use

// =============================================================================
// DECLARATIONS
// =============================================================================

FuncDef = FuncModifiers? ~ "func" ~ Ident ~ GenericParams? ~ "(" ~ Params? ~ ")"
        ~ ("->" ~ Type)? ~ WhereClause? ~ (Block / ";")

FuncModifiers = ("async" / "lowlevel")*

TypeDef = ("type" / "enum") ~ Ident ~ GenericParams? ~ TypeBody

TypeBody = "=" ~ Type               // type alias: type Foo = Bar
         / "{" ~ StructFields ~ "}"  // struct body
         / "{" ~ EnumVariants ~ "}"  // enum body

EnumVariants = Variant ~ ("," ~ Variant)* ~ ","?

Variant = Ident ~ VariantFields?

VariantFields = "(" ~ TypeList ~ ")"

UnionDef = "union" ~ Ident ~ "{" ~ StructFields ~ "}"

ConstDef = "const" ~ Ident ~ ":" ~ Type ~ "=" ~ Expr ~ ";"?

BehaviorDef = "behavior" ~ Ident ~ GenericParams?
            ~ "=" ~ TypeBound ("+" ~ TypeBound)*       // Behavior alias
            / "behavior" ~ Ident ~ GenericParams?
            ~ (":" ~ TypeBound)? ~ "{" ~ BehaviorItem* ~ "}"

BehaviorItem = AssociatedType / BehaviorFunc

BehaviorFunc = Decorator* ~ Visibility? ~ "func" ~ Ident ~ GenericParams?
             ~ "(" ~ Params? ~ ")" ~ ("->" ~ Type)?
             ~ (Block / ";")

AssociatedType = "type" ~ Ident ~ (":" ~ TypeBound)? ~ ("=" ~ Type)? ~ ";"?

ImplBlock = "impl" ~ GenericParams? ~ Type ~ ("for" ~ Type)?
          ~ WhereClause? ~ "{" ~ ImplItem* ~ "}"

ImplItem = AssociatedType / Decorator* ~ Visibility? ~ FuncDef

// =============================================================================
// OOP - CLASSES AND INTERFACES (C#-style)
// =============================================================================

ClassDef = ClassModifiers? ~ "class" ~ Ident ~ GenericParams?
         ~ ClassInheritance? ~ "{" ~ ClassMember* ~ "}"

ClassModifiers = ("abstract" / "sealed")*

ClassInheritance = "extends" ~ Type ~ ("implements" ~ TypeList)?
                 / "implements" ~ TypeList

ClassMember = Decorator* ~ MemberVisibility? ~ ClassMemberKind

MemberVisibility = "pub" / "protected" / "private"

ClassMemberKind = FieldDef
                / MethodDef
                / PropertyDef
                / ConstructorDef

FieldDef = "static"? ~ Ident ~ ":" ~ Type ~ ("=" ~ Expr)? ~ ";"?

MethodDef = MethodModifiers? ~ "func" ~ Ident ~ GenericParams?
          ~ "(" ~ Params? ~ ")" ~ ("->" ~ Type)? ~ (Block / ";")

MethodModifiers = ("static" / "virtual" / "override" / "abstract")*

PropertyDef = "prop" ~ Ident ~ ":" ~ Type ~ PropertyAccessors

PropertyAccessors = "{" ~ PropertyGetter? ~ PropertySetter? ~ "}"

PropertyGetter = "get" ~ (Block / ";")

PropertySetter = "set" ~ (Block / ";")

ConstructorDef = "new" ~ "(" ~ Params? ~ ")" ~ (":" ~ "base" ~ "(" ~ Args? ~ ")")? ~ Block

InterfaceDef = "interface" ~ Ident ~ GenericParams?
             ~ InterfaceInheritance? ~ "{" ~ InterfaceMember* ~ "}"

InterfaceInheritance = "extends" ~ TypeList

InterfaceMember = Decorator* ~ InterfaceMemberKind

InterfaceMemberKind = InterfaceMethodDef
                    / InterfacePropertyDef

InterfaceMethodDef = "func" ~ Ident ~ GenericParams?
                   ~ "(" ~ Params? ~ ")" ~ ("->" ~ Type)? ~ ";"

InterfacePropertyDef = "prop" ~ Ident ~ ":" ~ Type ~ ";"

NamespaceDef = "namespace" ~ NamespacePath ~ "{" ~ Item* ~ "}"

NamespacePath = Ident ~ ("::" ~ Ident)*

// =============================================================================
// MODULES
// =============================================================================

ModDef = "mod" ~ Ident ~ ("{" ~ Item* ~ "}" / ";")

DecoratorDef = "decorator" ~ Ident ~ DecoratorParams? ~ "{" ~ DecoratorBody ~ "}"

DecoratorParams = "(" ~ (DecoratorParam ~ ("," ~ DecoratorParam)*)? ~ ")"

DecoratorParam = Ident ~ ":" ~ Type ~ ("=" ~ Expr)?

DecoratorBody = FuncDef+

Use = "use" ~ UsePath ~ ("as" ~ Ident)? ~ ";"?

UsePath = PathSegment ~ ("::" ~ (UseTree / PathSegment))*

UseTree = "{" ~ (UsePath ~ ("," ~ UsePath)*)? ~ "}"
        / "*"

// =============================================================================
// VISIBILITY
// =============================================================================

Visibility = "pub" ~ ("(" ~ VisScope ~ ")")?

VisScope = "crate" / "super" / "self" / Path

// =============================================================================
// GENERICS & PARAMS
// =============================================================================

GenericParams = "[" ~ (GenericParam ~ ("," ~ GenericParam)*)? ~ "]"

GenericParam = Ident ~ (":" ~ TypeBound)?

TypeBound = Path ~ ("+" ~ Path)*

WhereClause = "where" ~ WhereConstraint ~ ("," ~ WhereConstraint)*

WhereConstraint = Type ~ ":" ~ TypeBound

Params = Param ~ ("," ~ Param)* ~ ","?

Param = "mut"? ~ Ident ~ ":" ~ Type

// =============================================================================
// TYPES
// =============================================================================

Type = FuncType / ReferenceType / BaseType

FuncType = "func" ~ "(" ~ TypeList? ~ ")" ~ "->" ~ Type

ReferenceType = "mut"? ~ "ref" ~ Type

BaseType = PointerType / ArrayType / TupleType / PathType / NeverType

PointerType = "*" ~ "mut"? ~ Type

ArrayType = "[" ~ Type ~ ";" ~ Expr ~ "]"

TupleType = "(" ~ TypeList? ~ ")"

PathType = Path ~ GenericArgs?

NeverType = "Never"

GenericArgs = "[" ~ TypeList ~ "]"

TypeList = Type ~ ("," ~ Type)* ~ ","?

StructFields = (StructField ~ ("," ~ StructField)*)? ~ ","?

StructField = Decorator* ~ Visibility? ~ Ident ~ ":" ~ Type ~ ("=" ~ Expr)?

// =============================================================================
// DECORATORS
// =============================================================================

Decorator = "@" ~ DecoratorExpr

DecoratorExpr = Path ~ DecoratorArgs?

DecoratorArgs = "(" ~ (DecoratorArg ~ ("," ~ DecoratorArg)*)? ~ ")"
              / "[" ~ (DecoratorArg ~ ("," ~ DecoratorArg)*)? ~ "]"

DecoratorArg = (Ident ~ ":")? ~ Expr

// =============================================================================
// EXPRESSIONS
// =============================================================================

Expr = Assignment

Assignment = Pipe ~ (AssignOp ~ Assignment)?

AssignOp = "=" / "+=" / "-=" / "*=" / "/=" / "%="
         / "&=" / "|=" / "^=" / "<<=" / ">>="

Pipe = LogicalOr ~ ("|>" ~ LogicalOr)*

LogicalOr = LogicalAnd ~ ("or" ~ LogicalAnd)*

LogicalAnd = LogicalNot ~ ("and" ~ LogicalNot)*

LogicalNot = "not" ~ LogicalNot / Comparison

Comparison = BitwiseOr ~ (CompareOp ~ BitwiseOr)?

CompareOp = "==" / "!=" / "<=" / ">=" / "<" / ">"

BitwiseOr = BitwiseXor ~ ("|" ~ BitwiseXor)*

BitwiseXor = BitwiseAnd ~ ("^" ~ BitwiseAnd)*

BitwiseAnd = Shift ~ ("&" ~ Shift)*

Shift = Additive ~ (ShiftOp ~ Additive)*

ShiftOp = "<<" / ">>"

Additive = Multiplicative ~ (AddOp ~ Multiplicative)*

AddOp = "+" / "-"

Multiplicative = Power ~ (MulOp ~ Power)*

MulOp = "*" / "/" / "%"

Power = Cast ~ ("**" ~ Power)?

Cast = Unary ~ (("as" / "is") ~ Type)*

Unary = UnaryOp* ~ Postfix

UnaryOp = "-" / "not" / "~" / "ref" / "mut" ~ "ref" / "*"

Postfix = Primary ~ PostfixOp*

PostfixOp = Call / Index / FieldAccess / MethodCall
          / OptionalFieldAccess / OptionalMethodCall
          / Propagate / Increment / Decrement / Await

Call = "(" ~ ArgList? ~ ")"

ArgList = Arg ~ ("," ~ Arg)* ~ ","?

Arg = (Ident ~ ":")? ~ Expr

Index = "[" ~ Expr ~ "]"

FieldAccess = "." ~ Ident

MethodCall = "." ~ Ident ~ GenericArgs? ~ "(" ~ ArgList? ~ ")"

OptionalFieldAccess = "?." ~ Ident

OptionalMethodCall = "?." ~ Ident ~ "(" ~ ArgList? ~ ")"

Propagate = "!"

Increment = "++"

Decrement = "--"

Await = "." ~ "await"

// =============================================================================
// PRIMARY EXPRESSIONS
// =============================================================================

Primary = Literal
        / "this"
        / "This"
        / "await" ~ Expr                // prefix await
        / "throw" ~ Expr                // throw expression
        / "lowlevel" ~ Block            // lowlevel block
        / "(" ~ Expr ~ ")"             // Parenthesized / Tuple
        / Block
        / IfExpr
        / WhenExpr
        / LoopExpr
        / WhileExpr
        / ForExpr
        / ReturnExpr
        / BreakExpr
        / ContinueExpr
        / Closure
        / StructInit
        / ArrayInit
        / Quote
        / Path

// =============================================================================
// CONTROL FLOW
// =============================================================================

IfExpr = "if" ~ "let" ~ Pattern ~ "=" ~ Expr ~ IfBody ~ ("else" ~ ElseBody)?
       / "if" ~ Expr ~ IfBody ~ ("else" ~ ElseBody)?

IfBody = "then" ~ Expr / Block

ElseBody = IfExpr / "then" ~ Expr / Block

WhenExpr = "when" ~ Expr ~ "{" ~ MatchArm* ~ "}"

MatchArm = Pattern ~ Guard? ~ "=>" ~ (Expr / Block) ~ ","?

Guard = "if" ~ Expr

LoopExpr = "loop" ~ "(" ~ Expr ~ ")" ~ Block
         / "loop" ~ Block

WhileExpr = "while" ~ Expr ~ Block

ForExpr = "for" ~ Pattern ~ "in" ~ Expr ~ Block

ReturnExpr = "return" ~ Expr?

BreakExpr = "break" ~ Ident? ~ Expr?

ContinueExpr = "continue" ~ Ident?

// =============================================================================
// BLOCKS & STATEMENTS
// =============================================================================

Block = "{" ~ Statement* ~ Expr? ~ "}"

Statement = LetStmt / VarStmt / ExprStmt / Item / ";"

LetStmt = "let" ~ Pattern ~ (":" ~ Type)? ~ "=" ~ Expr ~ ("else" ~ Block)? ~ ";"?

VarStmt = "var" ~ Ident ~ ":" ~ Type ~ "=" ~ Expr ~ ";"?

ExprStmt = Expr ~ ";"

// =============================================================================
// PATTERNS
// =============================================================================

Pattern = OrPattern

OrPattern = PatternNoOr ~ ("|" ~ PatternNoOr)*

PatternNoOr = GuardPattern

GuardPattern = PrimaryPattern ~ ("if" ~ Expr)?

PrimaryPattern = LiteralPattern
               / WildcardPattern
               / RangePattern
               / IdentPattern
               / TuplePattern
               / StructPattern
               / VariantPattern
               / RefPattern

LiteralPattern = Literal

WildcardPattern = "_"

RangePattern = Literal ~ ("to" / "through") ~ Literal

IdentPattern = "mut"? ~ Ident ~ ("@" ~ Pattern)?

TuplePattern = "(" ~ (Pattern ~ ("," ~ Pattern)*)? ~ ")"

StructPattern = Path ~ "{" ~ FieldPatterns? ~ ".."? ~ "}"

FieldPatterns = FieldPattern ~ ("," ~ FieldPattern)* ~ ","?

FieldPattern = Ident ~ (":" ~ Pattern)?

VariantPattern = Path ~ ("(" ~ (Pattern ~ ("," ~ Pattern)*)? ~ ")")?

RefPattern = "ref" ~ "mut"? ~ Pattern

// =============================================================================
// CLOSURES
// =============================================================================

Closure = "move"? ~ "do" ~ ClosureParams? ~ ("->" ~ Type)? ~ ClosureBody

ClosureParams = "(" ~ ClosureParamList? ~ ")" / Ident

ClosureParamList = ClosureParam ~ ("," ~ ClosureParam)* ~ ","?

ClosureParam = "mut"? ~ Ident ~ (":" ~ Type)?  // Type optional — inferred from context

ClosureBody = Block / Expr

// =============================================================================
// STRUCT & ARRAY INIT
// =============================================================================

StructInit = Path ~ "{" ~ FieldInits? ~ (".." ~ Expr)? ~ "}"

FieldInits = FieldInit ~ ("," ~ FieldInit)* ~ ","?

FieldInit = Ident ~ (":" ~ Expr)?

ArrayInit = "[" ~ ArrayElements? ~ "]"

ArrayElements = Expr ~ ("," ~ Expr)* ~ ","?
              / Expr ~ ";" ~ Expr  // [value; count]

// =============================================================================
// QUOTE (METAPROGRAMMING)
// =============================================================================

Quote = "quote" ~ "{" ~ QuoteContent* ~ "}"

QuoteContent = Splice / QuoteToken

Splice = "${" ~ Expr ~ "}" / "$" ~ Ident

QuoteToken = ~(!("${" / "$" ~ Ident / "}") ~ ANY)+

// =============================================================================
// LITERALS
// =============================================================================

Literal = TemplateLiteral
        / StringLiteral
        / CharLiteral
        / NumberLiteral
        / BoolLiteral
        / NullLiteral
        / UnitLiteral

// Template Literals (backticks) - produce Text type
TemplateLiteral = "`" ~ TemplateContent* ~ "`"

TemplateContent = TemplateChar
                / TemplateInterpolation

TemplateChar = !("`" / "\\" / "{") ~ ANY
             / "\\" ~ TemplateEscapeSeq

TemplateInterpolation = "{" ~ Expr ~ "}"

TemplateEscapeSeq = EscapeSeq / "{" / "}" / "`"

// String Literals (double quotes) - produce Str type
StringLiteral = RawString / InterpString / BasicString

BasicString = "\"" ~ StringChar* ~ "\""

InterpString = "\"" ~ InterpStringContent* ~ "\""

InterpStringContent = InterpStringChar
                    / "{" ~ Expr ~ "}"

InterpStringChar = !("\"" / "\\" / "{") ~ ANY
                 / "\\" ~ EscapeSeq

StringChar = !("\"" / "\\") ~ ANY
           / "\\" ~ EscapeSeq

RawString = "\"\"\"" ~ (!("\"\"\"") ~ ANY)* ~ "\"\"\""

EscapeSeq = "n" / "r" / "t" / "\\" / "\"" / "'" / "0" / "{" / "}"
          / "x" ~ HexDigit ~ HexDigit
          / "u" ~ "{" ~ HexDigit+ ~ "}"

CharLiteral = "'" ~ CharContent ~ "'"

CharContent = !("'" / "\\") ~ ANY
            / "\\" ~ EscapeSeq

NullLiteral = "null"

NumberLiteral = FloatLiteral / IntLiteral

FloatLiteral = Digits ~ "." ~ Digits ~ Exponent? ~ FloatSuffix?
             / Digits ~ Exponent ~ FloatSuffix?

FloatSuffix = "_"? ~ ("f32" / "f64")

IntLiteral = HexInt / OctalInt / BinaryInt / DecimalInt

DecimalInt = Digits ~ IntSuffix?

HexInt = "0x" ~ HexDigits ~ IntSuffix?

OctalInt = "0o" ~ OctalDigits ~ IntSuffix?

BinaryInt = "0b" ~ BinaryDigits ~ IntSuffix?

IntSuffix = "_"? ~ ("i8" / "i16" / "i32" / "i64" / "i128"
                  / "u8" / "u16" / "u32" / "u64" / "u128")

Digits = Digit ~ ("_"? ~ Digit)*

HexDigits = HexDigit ~ ("_"? ~ HexDigit)*

OctalDigits = OctalDigit ~ ("_"? ~ OctalDigit)*

BinaryDigits = BinaryDigit ~ ("_"? ~ BinaryDigit)*

Digit = '0'..'9'

HexDigit = '0'..'9' / 'a'..'f' / 'A'..'F'

OctalDigit = '0'..'7'

BinaryDigit = '0' / '1'

Exponent = ("e" / "E") ~ ("+" / "-")? ~ Digits

BoolLiteral = "true" / "false"

UnitLiteral = "(" ~ ")"

// =============================================================================
// IDENTIFIERS & PATHS
// =============================================================================

Path = PathSegment ~ ("::" ~ PathSegment)*

PathSegment = Ident / "crate" / "super" / "self" / "This"

Ident = !Keyword ~ IdentStart ~ IdentContinue*

IdentStart = 'a'..'z' / 'A'..'Z' / '_'

IdentContinue = IdentStart / '0'..'9'

// =============================================================================
// KEYWORDS (70 reserved words)
// =============================================================================

Keyword = "abstract" / "and" / "as" / "async" / "await" / "base" / "behavior"
        / "break" / "class" / "const" / "continue" / "crate" / "decorator"
        / "do" / "dyn" / "else" / "enum" / "extends" / "false" / "for" / "func"
        / "if" / "impl" / "implements" / "in" / "interface" / "is"
        / "let" / "life" / "loop" / "lowlevel" / "mod" / "move" / "mut"
        / "namespace" / "new" / "not" / "null" / "or"
        / "override" / "private" / "prop" / "protected" / "pub"
        / "quote" / "ref" / "return" / "sealed" / "shl" / "shr"
        / "static" / "super" / "then" / "this" / "This" / "through"
        / "throw" / "to" / "true" / "type" / "union" / "use" / "var"
        / "virtual" / "volatile" / "when" / "where" / "while" / "with" / "xor"

// =============================================================================
// WHITESPACE & COMMENTS
// =============================================================================

WHITESPACE = " " / "\t" / "\r" / "\n"

COMMENT = LineComment / BlockComment / DocComment / ModuleDocComment

LineComment = "//" ~ (!"\n" ~ ANY)*

BlockComment = "/*" ~ (!"*/" ~ ANY)* ~ "*/"

DocComment = "///" ~ (!"\n" ~ ANY)*

ModuleDocComment = "//!" ~ (!"\n" ~ ANY)*

// =============================================================================
// SOI/EOI (Start/End of Input)
// =============================================================================

SOI = &ANY / !ANY  // Start of input
EOI = !ANY          // End of input
ANY = '\x00'..'\xFF' // Any byte (adjust for Unicode)
