// NEGATIVE: two live `mut ref` interior references to the same container.
// `arr.get_mut` returns `mut ref T` (mut this); holding two at once aliases the
// same mutable interior storage → B009-class conflict.
use std::collections::list::List
func use_i(x: I64) -> I64 { return x }
func main() -> I32 {
    var arr: List[I64] = List::new(4)
    arr.push(1 as I64)
    arr.push(2 as I64)
    let r1: mut ref I64 = arr.get_mut(0)
    let r2: mut ref I64 = arr.get_mut(1)
    let z: I64 = use_i(*r1) + use_i(*r2)
    return z as I32
}
