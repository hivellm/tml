//! Regression test for codegen bug #6 (phase0v):
//! `let Just(v) = "3.14".parse_f64() else { return }` previously looped
//! forever at runtime. Observed during phase23b float decoder bring-up
//! — the minimal C float literal parser fell back to inlining the decimal
//! parser rather than using stdlib.

use test::{assert, assert_eq}

@test func test_parse_f64_valid() {
    let s: Str = "3.14"
    let parsed: Maybe[F64] = s.parse_f64()
    let Just(v) = parsed else {
        assert(false)
        return
    }
    assert(v > 3.13)
    assert(v < 3.15)
}

@test func test_parse_f64_integer() {
    let s: Str = "42"
    let parsed: Maybe[F64] = s.parse_f64()
    let Just(v) = parsed else {
        assert(false)
        return
    }
    assert(v > 41.9)
    assert(v < 42.1)
}

@test func test_parse_f64_negative() {
    let s: Str = "-0.5"
    let parsed: Maybe[F64] = s.parse_f64()
    let Just(v) = parsed else {
        assert(false)
        return
    }
    assert(v < -0.49)
    assert(v > -0.51)
}

@test func test_parse_f64_invalid_is_nothing() {
    let s: Str = "not a number"
    let parsed: Maybe[F64] = s.parse_f64()
    when parsed {
        Just(_) => assert(false),
        Nothing => {}
    }
}
