use test

func apply(f: func(I32) -> I32, x: I32) -> I32 {
    return f(x)
}

@test
func test_closure_annotated() -> I32 {
    let result = apply(do(x: I32) -> I32 { return x + 1 }, 41)
    assert_eq(result, 42, "annotated closure")
    return 0
}

@test
func test_closure_inferred_param() -> I32 {
    let result = apply(do(x) -> I32 { return x + 10 }, 5)
    assert_eq(result, 15, "inferred param type")
    return 0
}

@test
func test_closure_inferred_return() -> I32 {
    let result = apply(do(x: I32) { x * 2 }, 7)
    assert_eq(result, 14, "inferred return type")
    return 0
}

@test
func test_closure_fully_inferred() -> I32 {
    let result = apply(do(x) { x + 100 }, 5)
    assert_eq(result, 105, "fully inferred closure")
    return 0
}
