// Test Maybe/Outcome type inference scenarios
// Consolidated into single @test to avoid framework crash with
// multiple @test functions using large generic enum instantiations.
use test

func unwrap_or[T](opt: Maybe[T], default_val: T) -> T {
    when opt {
        Just(v) => return v,
        Nothing => return default_val
    }
}

func outcome_unwrap_or[T, E](res: Outcome[T, E], default_val: T) -> T {
    when res {
        Ok(v) => return v,
        Err(_) => return default_val
    }
}

@test
func test_maybe_outcome_inference() {
    // 1. Explicit type
    let m1: Maybe[I32] = Just(42)
    when m1 {
        Just(v) => assert_eq(v, 42),
        Nothing => assert(false)
    }

    // 2. Generic function inference
    let m2: Maybe[I32] = Just(10)
    let val: I32 = unwrap_or(m2, 0)
    assert_eq(val, 10)

    // 3. Outcome inference
    let r: Outcome[I32, Str] = Ok(100)
    let val2: I32 = outcome_unwrap_or(r, 0)
    assert_eq(val2, 100)

    // 4. Maybe[I64]
    let m3: Maybe[I64] = Just(123456789012)
    when m3 {
        Just(v) => assert(v == 123456789012),
        Nothing => assert(false)
    }

    // 5. Outcome error
    let r2: Outcome[I64, I32] = Err(404)
    when r2 {
        Ok(_) => assert(false),
        Err(code) => assert_eq(code, 404)
    }
}
