//! Regression test for codegen bug #9 (phase0v):
//! Large enums with by-value struct payloads crashed on duplicate
//! during the phase23b C-frontend bring-up. Reproducer:
//! a CDecl-sized enum with 7 variants each carrying a large struct by
//! value, pushed into a List[Heap[Enum]].

use test::{assert, assert_eq}
use core::alloc::heap::Heap
use std::collections::list::List

pub type BigStruct {
    s1: Str, s2: Str, s3: Str,
    i1: I64, i2: I64, i3: I64, i4: I64
}

pub enum BigEnum {
    V1(BigStruct),
    V2(BigStruct),
    V3(BigStruct),
    V4(BigStruct),
    V5(BigStruct),
    V6(BigStruct),
    V7(Str)
}

@test func test_bug9_large_enum_by_value_push() {
    let list: List[Heap[BigEnum]] = List[Heap[BigEnum]]::new(4 as I64)
    let bs: BigStruct = BigStruct {
        s1: "a", s2: "b", s3: "c",
        i1: 1 as I64, i2: 2 as I64, i3: 3 as I64, i4: 4 as I64
    }
    list.push(Heap[BigEnum]::new(BigEnum::V1(bs)))
    assert_eq(list.len() as I32, 1)
}
