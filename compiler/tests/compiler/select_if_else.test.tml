// Regression tests for if-else select optimization (phase0h).
//
// When an if-else expression returns the same scalar type from both branches
// and neither branch has side effects, AST codegen emits `select i1 %cond,
// T %then, T %else` instead of br+phi. Chained if-else-if produces nested
// selects.
//
// These tests verify correctness of the select path, not IR structure.

use test::assert_eq

// Simple 2-arm if-else returning integer literals
func pick_int(flag: Bool) -> I64 {
    if flag { 10 } else { 20 }
}

// Chained 4-arm if-else-if returning literals (generates 3 nested selects)
func classify_range(x: I64) -> I64 {
    if x < 25 { 1 } else if x < 50 { 2 } else if x < 75 { 3 } else { 4 }
}

// 2-arm if-else returning bool literals
func bool_select(x: I64) -> Bool {
    if x > 0 { true } else { false }
}

// Deeply chained 5-arm if-else-if
func classify_5(x: I64) -> I64 {
    if x < 10 { 1 }
    else if x < 20 { 2 }
    else if x < 30 { 3 }
    else if x < 40 { 4 }
    else { 5 }
}

@test
func test_simple_if_else_true() {
    assert_eq(pick_int(true), 10)
}

@test
func test_simple_if_else_false() {
    assert_eq(pick_int(false), 20)
}

@test
func test_classify_arm1() {
    assert_eq(classify_range(0), 1)
    assert_eq(classify_range(24), 1)
}

@test
func test_classify_arm2() {
    assert_eq(classify_range(25), 2)
    assert_eq(classify_range(49), 2)
}

@test
func test_classify_arm3() {
    assert_eq(classify_range(50), 3)
    assert_eq(classify_range(74), 3)
}

@test
func test_classify_arm4() {
    assert_eq(classify_range(75), 4)
    assert_eq(classify_range(100), 4)
    assert_eq(classify_range(-1), 1)
}

@test
func test_bool_select_positive() {
    assert_eq(bool_select(1), true)
    assert_eq(bool_select(100), true)
}

@test
func test_bool_select_nonpositive() {
    assert_eq(bool_select(0), false)
    assert_eq(bool_select(-5), false)
}

@test
func test_classify_5() {
    assert_eq(classify_5(5), 1)
    assert_eq(classify_5(15), 2)
    assert_eq(classify_5(25), 3)
    assert_eq(classify_5(35), 4)
    assert_eq(classify_5(50), 5)
}
