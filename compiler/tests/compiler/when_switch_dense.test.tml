// Regression tests for the `when` integer switch optimization (phase0d).
//
// When a `when` expression has ≥4 integer literal arms and no guards,
// AST codegen should emit a single LLVM `switch` instead of icmp chains.
//
// These tests verify correctness of the switch path, not IR structure.

use test::assert_eq

// Dense integer switch (10 cases, values 0-9 -> returns 100*v)
func dispatch_dense(x: I64) -> I64 {
    when x {
        0 => 0,
        1 => 100,
        2 => 200,
        3 => 300,
        4 => 400,
        5 => 500,
        6 => 600,
        7 => 700,
        8 => 800,
        9 => 900,
        _ => -1,
    }
}

// Sparse integer switch (10 cases with stride 100)
func dispatch_sparse(x: I64) -> I64 {
    when x {
        0   => 0,
        100 => 1,
        200 => 2,
        300 => 3,
        400 => 4,
        500 => 5,
        600 => 6,
        700 => 7,
        800 => 8,
        900 => 9,
        _   => -1,
    }
}

// Minimal switch (exactly 4 arms — at threshold)
func dispatch_minimal(x: I32) -> I32 {
    when x {
        10 => 1,
        20 => 2,
        30 => 3,
        40 => 4,
        _  => 0,
    }
}

// Bool scrutinee (i1 — 2 arms, below threshold, but still valid icmp path)
func dispatch_bool(x: Bool) -> I64 {
    when x {
        true  => 1,
        false => 0,
    }
}

// Switch with explicit default arm (non-wildcard default)
func dispatch_with_default(x: I64) -> Str {
    when x {
        1 => "one",
        2 => "two",
        3 => "three",
        4 => "four",
        _ => "other",
    }
}

// Wildcard-as-default collects all unmatched values
func dispatch_wildcard_default(x: I64) -> I64 {
    when x {
        1 => 10,
        2 => 20,
        3 => 30,
        4 => 40,
        _ => 99,
    }
}

@test
func test_dense_all_arms() {
    assert_eq(dispatch_dense(0), 0)
    assert_eq(dispatch_dense(1), 100)
    assert_eq(dispatch_dense(5), 500)
    assert_eq(dispatch_dense(9), 900)
}

@test
func test_dense_default_arm() {
    assert_eq(dispatch_dense(10), -1)
    assert_eq(dispatch_dense(-1), -1)
    assert_eq(dispatch_dense(100), -1)
}

@test
func test_sparse_all_arms() {
    assert_eq(dispatch_sparse(0), 0)
    assert_eq(dispatch_sparse(100), 1)
    assert_eq(dispatch_sparse(500), 5)
    assert_eq(dispatch_sparse(900), 9)
}

@test
func test_sparse_default_arm() {
    assert_eq(dispatch_sparse(50), -1)
    assert_eq(dispatch_sparse(999), -1)
}

@test
func test_minimal_threshold() {
    assert_eq(dispatch_minimal(10), 1)
    assert_eq(dispatch_minimal(20), 2)
    assert_eq(dispatch_minimal(30), 3)
    assert_eq(dispatch_minimal(40), 4)
    assert_eq(dispatch_minimal(99), 0)
}

@test
func test_string_default_arm() {
    assert_eq(dispatch_with_default(1), "one")
    assert_eq(dispatch_with_default(4), "four")
    assert_eq(dispatch_with_default(99), "other")
}
