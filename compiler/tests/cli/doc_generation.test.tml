@test
@slow_test
func test_doc_exits_zero_on_success() -> I32 {
    let result = Command::new(tml_exe()).current_dir(tml_bin_dir())
        .arg("doc")
        .arg("Mutex")
        .output()
    when result {
        Ok(out) => {
            assert_eq(out.exit_code, 0, "tml doc exits with 0 on success")
        }
        Err(e) => assert(false, e)
    }
    0
}

// ============================================================================
// Help / error handling
// ============================================================================

@test
@slow_test
func test_doc_help_flag() -> I32 {
    let result = Command::new(tml_exe()).current_dir(tml_bin_dir())
        .arg("doc")
        .arg("--help")
        .output()
    when result {
        Ok(out) => {
            // --help exits with 0 and prints usage
            assert(str::contains(out.stdout, "doc") or str::contains(out.stderr, "doc"),
                "doc help output should contain 'doc'")
        }
        Err(e) => assert(false, e)
    }
    0
}
