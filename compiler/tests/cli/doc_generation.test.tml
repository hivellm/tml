//! Tests for `tml doc` command — documentation generation and symbol lookup.
//!
//! Verifies that the `tml doc <symbol>` command outputs meaningful
//! documentation for standard library types and methods.

use test::{assert, assert_eq}
use std::os
use std::os::subprocess::Command
use core::str

// ============================================================================
// Helper
// ============================================================================

/// Returns the path to `tml.exe` in the debug build directory.
func tml_exe() -> Str {
    let root: Str = os::current_dir()
    return root + "/build/debug/bin/tml.exe"
}

/// Returns the bin directory containing tml.exe and its DLLs.
func tml_bin_dir() -> Str {
    let root: Str = os::current_dir()
    return root + "/build/debug/bin"
}

// ============================================================================
// Symbol lookup tests
// ============================================================================

@test
@slow_test
func test_doc_list_type() -> I32 {
    let result = Command::new(tml_exe()).current_dir(tml_bin_dir())
        .arg("doc")
        .arg("List")
        .output()
    when result {
        Ok(out) => {
            assert(out.success(), "tml doc List should succeed")
            assert(str::contains(out.stdout, "List"), "output should mention 'List'")
        }
        Err(e) => assert(false, e)
    }
    0
}

