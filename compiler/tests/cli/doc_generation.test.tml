@test
@slow_test
func test_doc_method_lookup() -> I32 {
    let result = Command::new(tml_exe()).current_dir(tml_bin_dir())
        .arg("doc")
        .arg("HashMap::get")
        .output()
    when result {
        Ok(out) => {
            assert(out.success(), "tml doc HashMap::get should succeed")
            assert(str::contains(out.stdout, "get"), "output should mention 'get'")
        }
        Err(e) => assert(false, e)
    }
    0
