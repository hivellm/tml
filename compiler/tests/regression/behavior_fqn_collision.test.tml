// Regression test: behavior FQN keying prevents short-name collision.
//
// core::io::Write and core::fmt::Write have the same short name "Write".
// Before this fix, importing both would cause last-write-wins collision in
// the type checker/codegen, leading to wrong default method generation.
//
// This test imports both, implements core::io::Write on a type, and verifies
// correct method dispatch — core::fmt::Write methods must NOT be generated
// for FakeWriter.
use test
use core::io::IoError
use core::io::Write
use core::fmt::Write as FmtWrite
use core::fmt::FmtError

type FakeWriter {
    written: I64,
}

impl Write for FakeWriter {
    func write_bytes(mut this, data: Str) -> Outcome[I64, IoError] {
        let n: I64 = data.len() as I64
        this.written = this.written + n
        return Ok(n)
    }

    func flush(mut this) -> Outcome[Unit, IoError] {
        return Ok(())
    }
}

type FakeFormatter {
    buf: I64,
}

impl FmtWrite for FakeFormatter {
    func write_str(mut this, s: Str) -> Outcome[Unit, FmtError] {
        this.buf = this.buf + (s.len() as I64)
        return Ok(())
    }
}

@test
func test_io_write_not_confused_with_fmt_write() -> Outcome[Unit, Str] {
    var w: FakeWriter = FakeWriter { written: 0 }
    let result = w.write_bytes("hello world")
    when result {
        Ok(n) => assert_eq(n, 11 as I64, "io::Write.write_bytes should write 11 bytes"),
        Err(_) => assert_true(false, "io::Write.write_bytes should not error"),
    }
    Ok(())
}

@test
func test_fmt_write_not_confused_with_io_write() -> Outcome[Unit, Str] {
    var f: FakeFormatter = FakeFormatter { buf: 0 }
    let result = f.write_str("hello")
    when result {
        Ok(_) => assert_eq(f.buf, 5 as I64, "fmt::Write.write_str should accumulate 5"),
        Err(e) => assert_true(false, "fmt::Write.write_str should not error"),
    }
    Ok(())
}

@test
func test_both_behaviors_coexist() -> Outcome[Unit, Str] {
    var w: FakeWriter = FakeWriter { written: 0 }
    let _ = w.write_bytes("abc")
    let _ = w.write_bytes("de")
    assert_eq(w.written, 5 as I64, "io::Write accumulates correctly")

    var f: FakeFormatter = FakeFormatter { buf: 0 }
    let _ = f.write_str("xyz")
    assert_eq(f.buf, 3 as I64, "fmt::Write accumulates correctly")

    Ok(())
}
